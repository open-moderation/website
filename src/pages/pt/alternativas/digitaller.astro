---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';
import { bookingUrl } from '../../../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pt/alternativas/digitaller",
  "name": "Alternativa ao Digitaller: comparativo com o OpenModeration",
  "description": "Digitaller ou OpenModeration? Um serviço de moderação terceirizado ou um software comandado pela sua redação: preços públicos e explicação de cada decisão.",
  "inLanguage": "pt",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Tipo de oferta", digitaller: "Serviço de moderação gerenciado, além de community management (agência do Grupo Raíz Digital)", openmod: "Você conecta as suas páginas: a IA aplica as suas regras e a nossa equipe trata os casos duvidosos" },
  { feature: "Como se decide", digitaller: "Um filtro semântico com IA e, quando necessário, uma equipe humana da Digitaller", openmod: "A IA aplica as suas regras com um limite por categoria; a nossa equipe trata a zona cinzenta e você vê tudo em tempo real" },
  { feature: "Regras", digitaller: "Adaptadas a cada cliente, em pré-moderação ou pós-moderação", openmod: "Suas regras em linguagem natural, editáveis quando você quiser, com sugestões de ajuste tiradas das decisões tomadas" },
  { feature: "Onde modera", digitaller: "Jornais digitais, blogs, sites corporativos, classificados e «redes sociais» (sem dizer quais)", openmod: "Facebook, Instagram, YouTube e WordPress de forma nativa; API REST e webhooks para o resto" },
  { feature: "Preço", digitaller: "Não publica tarifas", openmod: "Públicos: grátis até 1.000 requisições/mês, Pro a 99 €/mês para 10 mil requisições, ofertas sob medida para grandes volumes" },
  { feature: "Modelos de IA", digitaller: "Não especificado (fala em «filtro semântico com IA»)", openmod: "IA de moderação própria, verificada por outros modelos de IA; novos modelos integrados assim que são lançados" },
  { feature: "Contexto", digitaller: "Não especificado", openmod: "A IA lê cada comentário com a manchete e o fio da conversa" },
  { feature: "Explicação de cada decisão", digitaller: "Não mencionada", openmod: "Uma explicação por escrito para cada decisão, no idioma que você escolher, devolvida pela API" },
  { feature: "Registro para o DSA", digitaller: "Não mencionado", openmod: "Registro de atividade: cada decisão indica se foi automática ou qual moderador a tomou" },
  { feature: "Hospedagem", digitaller: "Não especificada (o site cita o RGPD e a LOPD no aviso de cookies)", openmod: "Projetado e hospedado na UE; on-premise possível sob consulta" },
  { feature: "Referências", digitaller: "Os jornais regionais da Prensa Ibérica (La Nueva España, Levante, Faro de Vigo, Diario de Mallorca e outros), El Español e classificados da Schibsted", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "Qual é a melhor alternativa ao Digitaller?",
    answer: "Depende de quem você quer que modere. Se você procura um serviço gerenciado com moderadores externos e community management, a Digitaller oferece isso. Se você quer conectar as suas páginas sem ter trabalho de moderação, definir as regras, ver a explicação de cada decisão e pagar um preço publicado, o OpenModeration foi pensado para isso.",
  },
  {
    question: "Quanto custa a Digitaller?",
    answer: "A Digitaller não publica tarifas no seu site. O OpenModeration publica as suas: grátis até 1.000 requisições por mês, plano Pro a 99 €/mês para 10 mil requisições e ofertas sob medida para grandes volumes.",
  },
  {
    question: "Digitaller ou OpenModeration: qual é a diferença?",
    answer: "A Digitaller é um serviço: a sua equipe e o seu filtro moderam por você. Com o OpenModeration, a sua redação define as regras, a IA as aplica com o contexto de cada artigo, a nossa equipe trata os casos duvidosos e cada decisão vem com uma explicação por escrito, visível em tempo real.",
  },
  {
    question: "Posso testar o OpenModeration sem sair da Digitaller?",
    answer: "Sim. Em modo sandbox, o OpenModeration analisa os comentários reais do seu site ou das suas páginas nas redes sociais e mostra o que teria decidido, sem ocultar nem apagar nada. Você compara em paralelo com o seu serviço atual e decide depois.",
  },
  {
    question: "Quais opções um jornal regional tem para moderar os comentários dos leitores?",
    answer: "Dois caminhos. Terceirizar a moderação para uma empresa como a Digitaller, que diz moderar há 20 anos os principais jornais digitais locais da Espanha. Ou conectar as suas páginas a um serviço como o OpenModeration: a IA aplica as regras do jornal, a nossa equipe trata os casos duvidosos e a redação vê tudo em tempo real, podendo intervir quando quiser.",
  },
  {
    question: "O OpenModeration oferece moderadores humanos?",
    answer: "Sim, para o que a IA não decide sozinha. A automação do OpenModeration cuida da maior parte, e a nossa equipe trata os casos duvidosos, as denúncias de usuários e as decisões contestadas. A nossa equipe também escreve com você as regras de moderação a partir dos seus casos de uso e de comentários reais. Você não tem nada a fazer, a menos que queira: vê cada decisão em tempo real e pode intervir quando quiser.",
  },
];
---

<BaseLayout title="Alternativa ao Digitaller: comparativo com o OpenModeration" description="Digitaller ou OpenModeration? Um serviço de moderação terceirizado ou um software comandado pela sua redação: preços públicos e explicação de cada decisão." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Alternativas", href: L('/alternatives') }, { label: "Digitaller" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativo
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa ao Digitaller: modere os comentários a partir da sua redação</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        A Digitaller, agência do Grupo Raíz Digital, modera comentários para muitos jornais regionais espanhóis com um filtro de IA e uma equipe humana. Com o OpenModeration, a sua redação define as regras, a IA as aplica com o contexto de cada artigo, a nossa equipe trata os casos duvidosos e cada decisão vem com uma explicação por escrito.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Escolha o OpenModeration se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>você quer que a sua redação controle as regras e as mude sem passar por um fornecedor;</li>
          <li>você quer saber o preço antes de pedir um orçamento;</li>
          <li>você precisa explicar cada comentário removido, como exige o DSA;</li>
          <li>você quer saber quais redes são moderadas: Facebook, Instagram, YouTube e WordPress;</li>
          <li>você quer um registro de auditoria completo e poder exportar os seus dados.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">A Digitaller pode ser melhor para você se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>você quer que uma equipe humana externa revise todos os comentários, um por um;</li>
          <li>você também procura um serviço de community management;</li>
          <li>você quer um fornecedor que já trabalha com muitos jornais regionais espanhóis.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Digitaller e OpenModeration, ponto a ponto</h2>
      <p class="mt-4 text-surface-500">Informações sobre a Digitaller extraídas do seu site, raiz.es, consultado em 20 de outubro de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Critério</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Digitaller</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.digitaller}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O que muda de verdade no dia a dia</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">O contexto do artigo conta</h3>
          <p class="mt-2 text-sm text-surface-600">Um mesmo comentário não pesa igual sob uma crônica esportiva e sob uma notícia policial. O OpenModeration passa à IA a manchete e o fio da conversa para detectar a ironia e os ataques disfarçados.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Você sabe por que cada comentário foi ocultado</h3>
          <p class="mt-2 text-sm text-surface-600">Cada decisão vem com uma explicação por escrito, e o registro de atividade indica se foi a IA ou qual moderador a tomou. É a base da exposição de motivos exigida pelo regulamento europeu de serviços digitais (DSA).</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Um preço publicado</h3>
          <p class="mt-2 text-sm text-surface-600">Você começa grátis e sabe quanto vai pagar quando o volume crescer. Se precisar de uma implantação on-premise, é possível sob consulta: <a href={bookingUrl(locale)} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:text-brand-500">vamos conversar</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Uma IA que acompanha o progresso dos modelos</h3>
          <p class="mt-2 text-sm text-surface-600">O OpenModeration usa a sua própria IA de moderação, e as decisões nos casos delicados são verificadas por outros modelos de IA. Quando sai um modelo melhor ou mais barato, a nossa equipe o integra rapidamente, sem nada a mudar do seu lado. E em modo sandbox você testa tudo com os seus comentários reais, sem aplicar nenhuma ação.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Perguntas frequentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Digitaller é uma marca da sua empresa titular. As informações sobre ela vêm de <a href="https://raiz.es/es/servicios/moderacion-de-los-contenidos/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">raiz.es</a> (consultado em 20 de outubro de 2026). Viu algum erro? Escreva para <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber mais</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Agende uma reunião com a nossa equipe &rarr;</a></li>
        <li><a href={L('/use-cases/news-publishers')} class="font-medium text-brand-600 hover:text-brand-500">A moderação de comentários para veículos de mídia &rarr;</a></li>
        <li><a href={L('/alternatives/interactora')} class="font-medium text-brand-600 hover:text-brand-500">OpenModeration ou Interactora: o comparativo &rarr;</a></li>
        <li><a href={L('/integrations/wordpress')} class="font-medium text-brand-600 hover:text-brand-500">Moderar os comentários do WordPress &rarr;</a></li>
        <li><a href={L('/pricing')} class="font-medium text-brand-600 hover:text-brand-500">Os preços do OpenModeration &rarr;</a></li>
        <li><a href={L('/alternatives')} class="font-medium text-brand-600 hover:text-brand-500">Todos os comparativos &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Teste o OpenModeration junto com o seu serviço de moderação atual." subtitle="Conecte o seu site ou as suas páginas em modo sandbox e compare as decisões durante algumas semanas, sem mexer na sua moderação." />
</BaseLayout>
