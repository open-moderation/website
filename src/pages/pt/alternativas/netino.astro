---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pt/alternativas/netino",
  "url": "https://www.openmoderation.com/pt/alternativas/netino",
  "name": "Alternativa à Netino: retome o controle da sua moderação",
  "description": "Netino ou OpenModeration? Uma agência terceirizada ou uma moderação automática que você só conecta: suas regras, preços públicos, motor de IA, DSA e UE.",
  "inLanguage": "pt",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Tipo de oferta", them: "Serviço terceirizado: a Netino faz a moderação por você, junto com gestão de comunidade, social listening e atendimento nas redes", openmod: "Moderação automática: você conecta as suas páginas e a equipe da Logora cuida do resto, conforme as suas regras" },
  { feature: "Quem decide", them: "IA combinada com especialistas humanos da Netino, 24 horas por dia", openmod: "Violações claras ocultadas automaticamente, críticas legítimas mantidas visíveis, casos duvidosos tratados pela nossa equipe; você vê tudo em tempo real em um único console" },
  { feature: "Canais", them: "\"Todos os canais\" e redes sociais multiplataforma; as redes não são listadas na página inicial", openmod: "Sites (API), páginas do Facebook, contas profissionais do Instagram, canais do YouTube e WordPress" },
  { feature: "Preço", them: "Não divulgado; auditoria ou contato sob consulta", openmod: "Público: grátis até 1.000 requisições/mês, Pro a 99 €/mês para 10 mil requisições, Enterprise sob consulta" },
  { feature: "Modelos de IA", them: "Não especificado no seu site", openmod: "IA de moderação própria, verificada por outros modelos de IA; novos modelos integrados assim que são lançados" },
  { feature: "Explicação por escrito de cada decisão", them: "Não especificado no seu site", openmod: "Sim, uma explicação por escrito para cada decisão" },
  { feature: "DSA", them: "Moderação apresentada como apoio à conformidade regulatória, com relatórios de volume; detalhes não especificados", openmod: "Notificação e ação, declaração de motivos, revisão humana de decisões contestadas, números exportáveis e registro de atividade completo" },
  { feature: "Hospedagem dos dados", them: "Não especificado na página inicial (empresa sediada em Paris)", openmod: "Hospedado na União Europeia, em conformidade com o RGPD" },
  { feature: "Outros serviços", them: "Gestão de comunidade, social listening, atendimento nas redes, gestão de conteúdo, martech", openmod: "Só moderação" },
];

const faqItems = [
  {
    question: "Qual é a melhor alternativa à Netino?",
    answer: "Depende de quem você quer que faça a moderação. Se você quer que uma agência cuide disso por você, junto com gestão de comunidade e atendimento ao cliente, a Netino cobre isso. Se você quer apenas conectar as suas páginas e ver a moderação aplicar as suas regras sozinha, com uma explicação por escrito para cada decisão e um preço publicado, o OpenModeration foi feito para isso.",
  },
  {
    question: "Quanto custa a Netino?",
    answer: "A Netino não divulga os seus preços no site. O OpenModeration é grátis até 1.000 requisições por mês, depois custa 99 € por mês para 10 mil requisições no plano Pro, com Enterprise sob consulta.",
  },
  {
    question: "Netino ou OpenModeration: qual a diferença?",
    answer: "A Netino é um serviço: as suas equipes, apoiadas pela IA, moderam por você. O OpenModeration é uma moderação automática: a IA oculta as violações claras, mantém as críticas legítimas visíveis e a nossa equipe trata os casos duvidosos, com uma explicação por escrito para cada decisão e recursos para a DSA. Você vê tudo em tempo real e pode intervir quando quiser.",
  },
  {
    question: "Posso testar o OpenModeration sem interromper a Netino?",
    answer: "Sim. No modo sandbox, o OpenModeration analisa os seus comentários reais sem ocultar nem apagar nada. A Netino continua trabalhando e você compara as decisões nos mesmos comentários antes de mudar qualquer coisa.",
  },
  {
    question: "Quais modelos de IA o OpenModeration usa?",
    answer: "O OpenModeration funciona com a sua própria IA de moderação, cujas decisões são verificadas por outros modelos de IA nos casos delicados. Quando sai um modelo melhor ou mais econômico, a nossa equipe o integra rapidamente, sem que você precise mudar nada.",
  },
  {
    question: "O OpenModeration oferece moderadores humanos?",
    answer: "A automação do OpenModeration cuida de quase tudo. Os casos duvidosos, as denúncias de usuários e as decisões contestadas são tratados pela equipe da Logora, que também pode moderar manualmente quando necessário e configura a moderação a partir das suas regras e dos seus casos de uso. A sua equipe não tem nada a fazer: vê cada decisão em tempo real e pode intervir quando quiser.",
  },
];
---

<BaseLayout title="Alternativa à Netino: comparativo com o OpenModeration" description="Netino ou OpenModeration? Uma agência terceirizada ou uma moderação automática que você só conecta: suas regras, preços públicos, motor de IA, DSA e UE." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Alternativas", href: L('/alternatives') }, { label: "Netino" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativo
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa à Netino: retome o controle da sua moderação</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Se você procura uma alternativa à Netino em que você só conecta as suas páginas, o OpenModeration aplica as suas regras automaticamente: a IA oculta as violações claras, a nossa equipe trata os casos duvidosos e cada decisão vem com uma explicação por escrito. Se você prefere entregar a moderação, a gestão de comunidade e o atendimento ao cliente a uma agência externa, a Netino oferece isso.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={L('/book-a-call')} class="rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-500">Agende uma reunião</a>
        <a href="https://app.openmoderation.com/signup" class="rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 hover:bg-surface-50">Teste grátis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Para quem é a Netino?</h2>
      <p class="mt-4 text-surface-600">A Netino é uma agência sediada em Paris que se apresenta como "Marketing Process Outsourcer". Segundo o seu site, ela faz moderação de conteúdo 24 horas por dia combinando IA com especialistas humanos selecionados, além de serviços de gestão de comunidade, social listening, atendimento nas redes, gestão de conteúdo e martech.</p>
      <p class="mt-4 text-surface-600">A Netino afirma trabalhar com mais de 200 empresas; entre os logos do seu site estão L'Oréal, Air France, Castorama, Lagardère, E.Leclerc e Société Générale. Um estudo acadêmico de 2021 também cita o grupo espanhol Unidad Editorial entre os grupos de mídia que trabalharam com a Netino. Ela é indicada para organizações que querem terceirizar o conjunto das suas operações nas redes sociais.</p>
    </div>
  </section>

  <section id="comparison" class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Netino vs OpenModeration, lado a lado</h2>
      <p class="mt-4 text-surface-500">Informações sobre a Netino retiradas do seu site, netino.com, consultado em 30 de outubro de 2026. Quando algo não é informado ali, dizemos isso.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Critério</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Netino</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.them}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Escolha a Netino se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>você quer que uma equipe externa cuide da moderação, da gestão de comunidade e das respostas aos clientes;</li>
          <li>você prefere que moderadores humanos leiam todos os comentários, e não só os casos duvidosos;</li>
          <li>você procura um único fornecedor para todas as suas operações nas redes sociais.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Escolha o OpenModeration se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>você quer apenas conectar as suas páginas, com as suas regras aplicadas na hora e cada decisão visível em tempo real;</li>
          <li>você quer saber o preço antes de pedir um orçamento;</li>
          <li>você precisa de uma explicação por escrito para cada comentário ocultado e de recursos para a DSA;</li>
          <li>você também modera os comentários do seu site ou do WordPress;</li>
          <li>você quer uma moderação que se beneficia do progresso dos modelos de IA.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Um motor de IA que acompanha o mercado</h2>
      <p class="mt-4 text-surface-600">O OpenModeration funciona com a sua própria IA de moderação e, nos casos delicados, as suas decisões são verificadas por outros modelos de IA. O motor não depende de um único modelo: quando sai um modelo de IA melhor ou mais econômico, a nossa equipe o integra rapidamente, sem que você precise mudar nada. A sua moderação se beneficia do progresso dos modelos de IA em vez de ficar presa a um único algoritmo. O site da Netino não especifica quais modelos de IA ela usa.</p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Preços: Netino e OpenModeration</h2>
      <p class="mt-4 text-surface-600">A Netino não divulga os seus preços; o seu site convida a pedir uma auditoria ou a entrar em contato com a equipe. Um serviço de moderação terceirizado costuma ser orçado caso a caso.</p>
      <p class="mt-4 text-surface-600">O OpenModeration divulga os seus preços: grátis até 1.000 requisições por mês, Pro a 99 € por mês para 10 mil requisições e Enterprise sob consulta para grandes volumes. A implantação on-premise é possível sob consulta. Você paga pelo volume de comentários, não pelo tempo gasto.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Migrar da Netino para o OpenModeration em 3 etapas</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-2 font-semibold text-surface-900">Teste no modo sandbox</h3>
          <p class="mt-2 text-sm text-surface-600">Conecte uma página do Facebook, uma conta profissional do Instagram, um canal do YouTube, o WordPress ou o seu site via API. O OpenModeration analisa os seus comentários reais sem ocultar nada, enquanto a Netino continua trabalhando.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-2 font-semibold text-surface-900">Adapte a moderação com a nossa equipe</h3>
          <p class="mt-2 text-sm text-surface-600">A equipe da Logora parte das suas regras e dos seus casos de uso, compara as decisões do OpenModeration com as da Netino nos mesmos comentários e ajusta o que for preciso.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-2 font-semibold text-surface-900">Ative a moderação automática</h3>
          <p class="mt-2 text-sm text-surface-600">As violações claras são ocultadas, os casos duvidosos são tratados pela nossa equipe, você vê tudo no console e cada decisão mantém a sua explicação por escrito. Você encerra a Netino quando estiver pronto.</p>
        </li>
      </ol>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Perguntas frequentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Fontes: <a href="https://netino.com/fr/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">netino.com</a>, <a href="https://revista.profesionaldelainformacion.com/index.php/EPI/article/download/86568/63065/290349" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Paz-Rebollo et al., El Profesional de la Información (2021)</a> (consultados em 30 de outubro de 2026). Netino é uma marca da sua empresa titular. Viu algum erro? Escreva para <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber mais</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={L('/alternatives')} class="font-medium text-brand-600 hover:text-brand-500">Todos os comparativos &rarr;</a></li>
        <li><a href={L('/moderation-software')} class="font-medium text-brand-600 hover:text-brand-500">O software de moderação OpenModeration &rarr;</a></li>
        <li><a href={L('/blog/comment-moderation-guide')} class="font-medium text-brand-600 hover:text-brand-500">Guia de moderação de comentários &rarr;</a></li>
        <li><a href={L('/blog/social-media-moderation-guide')} class="font-medium text-brand-600 hover:text-brand-500">Guia de moderação de redes sociais &rarr;</a></li>
        <li><a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Agende uma reunião com a nossa equipe &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Conecte as suas páginas: nós cuidamos do resto." subtitle="Adaptamos o OpenModeration às suas regras e aos seus casos de uso; depois você o testa no modo sandbox junto com o seu fornecedor atual." buttonText="Agende uma reunião" buttonHref={L('/book-a-call')} />
</BaseLayout>
