---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pt/alternativas/mistral-moderation",
  "name": "Alternativa ao Mistral Moderation: comparativo e preços",
  "description": "Mistral Moderation ou OpenModeration? Uma API de moderação multilíngue ou uma moderação de comentários pronta, com revisão humana, motivo escrito e DSA.",
  "inLanguage": "pt",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  { feature: "O que é", mistral: "Uma API de moderação de texto da Mistral", openmod: "Uma moderação de comentários com IA, adaptada às suas regras e aos seus casos de uso, configurada com você pela equipe da Logora" },
  { feature: "Categorias", mistral: "11 categorias fixas no modelo atual, entre elas dados pessoais e jailbreak", openmod: "Definidas com você a partir das suas regras e dos seus casos de uso" },
  { feature: "Idiomas", mistral: "Muito bom multilinguismo (francês, alemão, espanhol, italiano, português etc.)", openmod: "Definidos com você durante a configuração; explicações no idioma que você escolher" },
  { feature: "Modelos de IA", mistral: "O modelo de moderação da Mistral", openmod: "IA de moderação própria, verificada por outros modelos de IA; novos modelos integrados assim que são lançados" },
  { feature: "Decisão", mistral: "Só pontuações brutas", openmod: "Violações claras ocultadas automaticamente, crítica legítima visível, casos duvidosos tratados pela nossa equipe" },
  { feature: "Entrada máxima", mistral: "32.000 caracteres", openmod: "Comentários, com o contexto do artigo e do fio da conversa" },
  { feature: "Console", mistral: "Só API, sem interface de revisão", openmod: "Console de moderação: você vê cada decisão e o seu motivo em tempo real e pode intervir quando quiser" },
  { feature: "Conectores", mistral: "API", openmod: "Sites (API), páginas do Facebook, contas profissionais do Instagram, canais do YouTube, WordPress" },
  { feature: "Explicação de cada decisão", mistral: "Pontuações, sem explicação por escrito", openmod: "Um motivo por escrito para cada decisão, no console e via API" },
  { feature: "DSA", mistral: "Logs básicos da API", openmod: "Notificação e ação, exposição de motivos, revisão humana de decisões contestadas, números exportáveis, registro de atividade completo" },
  { feature: "Hospedagem", mistral: "API na nuvem", openmod: "Hospedado na UE, RGPD; on-premise possível sob consulta" },
  { feature: "Preço", mistral: "Definido pela Mistral na sua API", openmod: "Grátis até 1.000 requisições/mês; Pro a 99 €/mês para 10 mil requisições; Enterprise sob consulta" },
];

const faqItems = [
  {
    question: "Qual é a melhor alternativa ao Mistral Moderation?",
    answer: "Para moderar os comentários de um veículo de mídia, de uma marca ou de uma instituição pública, o OpenModeration é uma alternativa direta: em vez de pontuações para interpretar, ele aplica as decisões nas suas plataformas, deixa os casos duvidosos com a nossa equipe e explica cada decisão por escrito. Você só conecta as suas páginas. Se a sua equipe técnica quer integrar uma API de classificação multilíngue no próprio produto, a API da Mistral foi pensada para isso.",
  },
  {
    question: "Quanto custa o Mistral Moderation?",
    answer: "A Mistral define o preço do seu modelo de moderação na própria API. O OpenModeration publica os seus preços: grátis até 1.000 requisições por mês, Pro a 99 €/mês para 10 mil requisições e Enterprise sob consulta.",
  },
  {
    question: "Mistral Moderation vs OpenModeration: qual é a diferença?",
    answer: "A Mistral oferece uma API: ela devolve pontuações em 11 categorias fixas e a sua equipe constrói o resto (console, ações, fila de revisão, registro). O OpenModeration é uma ferramenta de moderação de comentários completa, com conectores, decisões automáticas, revisão humana, um motivo por escrito para cada decisão e os elementos do DSA.",
  },
  {
    question: "E se as minhas regras não cabem em categorias fixas?",
    answer: "Com o OpenModeration, a moderação é adaptada às suas regras e aos seus casos de uso: a nossa equipe as configura com você a partir de comentários reais e as ajusta nas primeiras semanas, em vez de você depender de uma lista fixa de categorias.",
  },
  {
    question: "Posso testar o OpenModeration sem desligar o Mistral Moderation?",
    answer: "Sim. Em modo sandbox, o OpenModeration analisa os seus comentários reais sem ocultar nada. A sua integração atual continua funcionando e você compara as decisões comentário por comentário.",
  },
  {
    question: "Cada decisão fica registrada para as auditorias do DSA?",
    answer: "Sim. Cada decisão, automática ou humana, fica no registro de atividade com o seu motivo por escrito e quem a tomou, e os números são exportáveis para os seus relatórios de transparência do DSA.",
  },
];
---

<BaseLayout title="Alternativa ao Mistral Moderation: comparativo e preços" description="Mistral Moderation ou OpenModeration? Uma API de moderação multilíngue ou uma moderação de comentários pronta, com revisão humana, motivo escrito e DSA." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Alternativas", href: L('/alternatives') }, { label: "Mistral Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativo
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa ao Mistral Moderation: comparativo com o OpenModeration</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        A API de moderação da Mistral trata muito bem as línguas europeias, mas devolve pontuações: a moderação em si ainda precisa ser construída. Para os comentários de um veículo de mídia, de uma marca ou de uma instituição pública, o OpenModeration é a alternativa mais direta, com decisões aplicadas, casos duvidosos tratados pela nossa equipe, um console onde você vê tudo em tempo real, um motivo por escrito para cada decisão e os elementos do DSA.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={L('/book-a-call')} class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Agendar uma reunião</a>
        <a href="#comparativo" class="inline-flex items-center gap-2 rounded-lg border border-surface-200 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Ver o comparativo</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Para quem é o Mistral Moderation?</h2>
      <p class="mt-4 text-surface-600">O Mistral Moderation é o modelo de moderação de texto da Mistral, acessível pela sua API. Ele classifica o conteúdo em 11 categorias fixas, entre elas dados pessoais e jailbreak, aceita até 32.000 caracteres por entrada e se sai muito bem em francês, alemão, espanhol, italiano e português. É uma ferramenta para equipes técnicas que integram a moderação no próprio produto.</p>
      <p class="mt-4 text-surface-600">A API devolve pontuações. A sua equipe ainda precisa de um console de revisão, de um motor de ações (ocultar, apagar, sinalizar), de controle de acesso por papéis e de um registro das decisões para o DSA. O OpenModeration traz tudo isso pronto: ele modera com IA os comentários de veículos de mídia, marcas e instituições públicas, no site e nas páginas do Facebook, contas do Instagram e canais do YouTube, e a equipe da Logora, em Paris desde 2019, o configura com você conforme as suas regras e os seus casos de uso.</p>
    </div>
  </section>

  <section id="comparativo" class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Mistral Moderation e OpenModeration, ponto a ponto</h2>
      <p class="mt-4 text-surface-500">Informações sobre o Mistral Moderation extraídas da documentação pública da Mistral. Quando algo não é especificado, indicamos.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Critério</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Mistral Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.mistral}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Escolha o OpenModeration se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>você modera os comentários de um veículo de mídia, de uma marca ou de uma instituição pública;</li>
          <li>as suas regras não cabem numa lista fixa de categorias;</li>
          <li>você quer que os casos duvidosos sejam tratados por humanos, sem trabalho para a sua equipe, e um motivo por escrito para cada decisão;</li>
          <li>você quer conectores prontos para Facebook, Instagram, YouTube e WordPress;</li>
          <li>você quer preços públicos e os seus dados hospedados na UE.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">O Mistral Moderation pode ser melhor para você se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>a sua equipe técnica quer pontuações brutas para construir a própria lógica;</li>
          <li>você precisa detectar categorias como jailbreak em textos longos, até 32.000 caracteres;</li>
          <li>a moderação faz parte do seu produto, e não de uma redação ou de uma equipe de comunidade.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O motor de IA: acompanhar o progresso dos modelos</h2>
      <p class="mt-4 text-surface-600">Com o Mistral Moderation, a sua moderação depende de um único modelo. O OpenModeration usa a sua própria IA de moderação, e as decisões nos casos delicados são verificadas por outros modelos de IA. O motor não depende de nenhum modelo: quando sai um melhor ou mais barato, a nossa equipe o integra rapidamente, sem que você precise mudar nada. Assim, a sua moderação acompanha o progresso do mercado de IA em vez de ficar congelada num único algoritmo.</p>
      <h2 class="mt-16 text-3xl font-bold tracking-tight text-surface-900">Preço: Mistral Moderation vs OpenModeration</h2>
      <p class="mt-4 text-surface-600">A Mistral define o preço do seu modelo de moderação na própria API, e cada comentário enviado conta no seu consumo, sem contar o custo de construir as ferramentas em volta. Os preços do OpenModeration são públicos e incluem o console: grátis até 1.000 requisições por mês, Pro a 99 €/mês para 10 mil requisições, Enterprise sob consulta, e implantação on-premise disponível sob consulta. <a href={L('/pricing')} class="font-medium text-brand-600 hover:text-brand-500">Os preços do OpenModeration &rarr;</a></p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Do Mistral Moderation ao OpenModeration em 3 etapas</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-1 font-semibold text-surface-900">Conecte as suas fontes e compartilhe as suas regras</h3>
          <p class="mt-2 text-sm text-surface-600">Conecte o seu site via API, as suas páginas do Facebook, contas profissionais do Instagram, canais do YouTube ou o WordPress. A nossa equipe adapta com você a moderação às suas regras e aos seus casos de uso.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-1 font-semibold text-surface-900">Teste em modo sandbox com comentários reais</h3>
          <p class="mt-2 text-sm text-surface-600">O OpenModeration analisa os seus comentários reais sem ocultar nada. A sua integração atual continua funcionando enquanto você compara as decisões, cada uma com o seu motivo por escrito.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-1 font-semibold text-surface-900">Ative a moderação automática</h3>
          <p class="mt-2 text-sm text-surface-600">As violações claras são ocultadas automaticamente, os casos duvidosos são tratados pela nossa equipe, você acompanha tudo no console, e o registro de atividade e os números exportáveis ficam prontos para o DSA.</p>
        </li>
      </ol>
      <p class="mt-8 text-surface-600">Quer ver antes com os seus próprios comentários? <a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Agende uma reunião com a nossa equipe &rarr;</a></p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Perguntas frequentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Mistral é uma marca do seu titular. As informações vêm da documentação pública da Mistral; o que não consta é indicado como não especificado. Viu algum erro? Escreva para <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-surface-400">
        Fontes: <a href="https://docs.mistral.ai/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">docs.mistral.ai</a>
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber mais</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Agende uma reunião com a equipe do OpenModeration &rarr;</a></li>
        <li><a href={L('/moderation-software')} class="font-medium text-brand-600 hover:text-brand-500">O software de moderação OpenModeration &rarr;</a></li>
        <li><a href={L('/text-moderation-api')} class="font-medium text-brand-600 hover:text-brand-500">A API de moderação de texto &rarr;</a></li>
        <li><a href={L('/blog/ai-content-moderation-developer-guide')} class="font-medium text-brand-600 hover:text-brand-500">Moderação de conteúdo com IA: o guia para desenvolvedores &rarr;</a></li>
        <li><a href={L('/alternatives')} class="font-medium text-brand-600 hover:text-brand-500">Todos os comparativos &rarr;</a></li>
        <li><a href={L('/pricing')} class="font-medium text-brand-600 hover:text-brand-500">Os preços do OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Uma moderação completa, não só uma API de pontuações." subtitle="O OpenModeration já traz as regras automáticas, a revisão humana e o registro para o DSA. Teste com os seus próprios comentários, grátis para começar." />
</BaseLayout>
