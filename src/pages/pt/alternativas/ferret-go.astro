---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import SwitchProvider from '../../../components/SwitchProvider.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pt/alternativas/ferret-go",
  "name": "Alternativa ao Ferret Go: o OpenModeration comparado",
  "description": "Procurando uma alternativa ao Ferret Go? Comparativo com fontes com o OpenModeration: preços públicos, motivo de cada decisão, hospedagem na UE e muito mais.",
  "inLanguage": "pt",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  {
    "feature": "Empresa e oferta",
    "competitor": "ferret go GmbH, com sede em Berlim segundo o seu aviso legal. Dois produtos: Conversario (moderação de comentários com IA, análises, ferramentas de diálogo) e Engagently (plataforma de engajamento para os sites das editoras)",
    "openmod": "Logora (Paris, desde 2019, pertencente aos seus funcionários). OpenModeration: moderação com IA que a nossa equipe adapta com você às suas regras e aos seus casos de uso"
  },
  {
    "feature": "Canais",
    "competitor": "Facebook, Instagram, YouTube, LinkedIn, TikTok e Threads segundo a sua linha do tempo, além de sistemas onsite, apps de diálogo e fóruns",
    "openmod": "Páginas do Facebook, contas profissionais do Instagram, canais do YouTube e WordPress de forma nativa; qualquer site ou app via API"
  },
  {
    "feature": "Preços",
    "competitor": "Não publicados no site. O formulário pede o seu volume mensal de comentários; teste grátis de 30 dias",
    "openmod": "Públicos: grátis até 1.000 requisições/mês, Pro a 99 €/mês (10 mil requisições), Enterprise sob consulta"
  },
  {
    "feature": "Configuração",
    "competitor": "Ajustes de severidade individuais, léxico e regras próprias (mascaramento, lista branca)",
    "openmod": "Adaptada às suas regras e aos seus casos de uso, um limite por categoria, casos duvidosos tratados pela nossa equipe"
  },
  {
    "feature": "Modelos de IA",
    "competitor": "Modelos próprios de IA de moderação desde 2016, com IA generativa acrescentada em 2024 (segundo o seu site)",
    "openmod": "IA de moderação própria, verificada por outros modelos de IA; novos modelos integrados assim que são lançados"
  },
  {
    "feature": "Motivo por escrito de cada decisão",
    "competitor": "Não especificado no site",
    "openmod": "Sim, para cada decisão, no console e via API"
  },
  {
    "feature": "Teste antes de migrar",
    "competitor": "Um modo «dry-run» que analisa os canais sem agir",
    "openmod": "Modo sandbox com comentários reais, sem ocultar nada"
  },
  {
    "feature": "DSA",
    "competitor": "Linha do tempo de cada ação de moderação ao segundo, área própria para denúncias de usuários, API de reporting",
    "openmod": "Notificação e ação, exposição de motivos, revisão humana de decisões contestadas, números exportáveis, registro completo"
  },
  {
    "feature": "Hospedagem e RGPD",
    "competitor": "Declara cumprir o RGPD; local de hospedagem não especificado no site",
    "openmod": "Hospedagem na UE, RGPD"
  },
  {
    "feature": "Referências",
    "competitor": "Mais de 100 clientes do Conversario segundo o fornecedor; cita FAZ e ntv, e os seus primeiros modelos criados em 2016 para WELT e Bild",
    "openmod": "Entre eles L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier e Egora"
  },
  {
    "feature": "Equipe",
    "competitor": "Região de Berlim, mercado de língua alemã",
    "openmod": "Paris, Madri e Berlim, com uma falante nativa de alemão em Berlim para a região DACH"
  }
];

const faqItems = [
  {
    "question": "Qual é a melhor alternativa ao Ferret Go?",
    "answer": "Depende do que você precisa. Se você quer preços públicos, um motivo por escrito para cada decisão, hospedagem na UE e conectores para Facebook, Instagram, YouTube e WordPress, o OpenModeration atende a esses critérios. Se você precisa de LinkedIn, TikTok ou Threads, o Conversario da Ferret Go os cobre segundo o seu site, e o OpenModeration não."
  },
  {
    "question": "Qual é o preço do Ferret Go?",
    "answer": "A Ferret Go não publica os preços do Conversario. O formulário pede o seu volume mensal de comentários e oferece um teste grátis de 30 dias. O OpenModeration é grátis até 1.000 requisições por mês, o Pro custa 99 €/mês para 10 mil requisições e o Enterprise é sob consulta."
  },
  {
    "question": "Ferret Go e Conversario são a mesma coisa?",
    "answer": "Pertencem à mesma empresa. A ferret go GmbH é a editora, o Conversario é o seu produto de moderação de comentários com IA e o Engagently a sua plataforma de engajamento. A nossa página «Ferret Go e Conversario: a diferença» explica isso em detalhe."
  },
  {
    "question": "Ferret Go vs OpenModeration: qual é a principal diferença?",
    "answer": "O OpenModeration publica os seus preços, justifica cada decisão por escrito, hospeda na UE e usa a sua própria IA, verificada por outros modelos e atualizada assim que sai um modelo novo. A Ferret Go cobre mais redes sociais com o Conversario e acrescenta uma plataforma de engajamento com o Engagently."
  },
  {
    "question": "Posso testar o OpenModeration sem desligar o Conversario?",
    "answer": "Sim. Em modo sandbox, o OpenModeration avalia os seus comentários reais sem ocultar nada. O Conversario continua moderando e você compara as decisões comentário por comentário."
  },
  {
    "question": "O OpenModeration atende clientes no Brasil?",
    "answer": "Sim. O OpenModeration é desenvolvido pela equipe da Logora, em Paris, Madri e Berlim, e funciona como serviço online a partir de qualquer país. O Estadão, no Brasil, está entre os nossos clientes."
  }
];
---

<BaseLayout title="Alternativa ao Ferret Go: comparativo com o OpenModeration" description="Procurando uma alternativa ao Ferret Go? Comparativo com fontes com o OpenModeration: preços públicos, motivo de cada decisão, hospedagem na UE e muito mais." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Alternativas", href: L('/alternatives') }, { label: "Ferret Go" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativo
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa ao Ferret Go: o OpenModeration comparado</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        A melhor alternativa ao Ferret Go depende do que você precisa. Se você quer preços públicos, um motivo por escrito para cada comentário ocultado, hospedagem na UE e uma IA que integra os novos modelos assim que eles são lançados, o OpenModeration é uma ótima opção.
      </p>
      <p class="mx-auto mt-6 max-w-2xl rounded-xl border border-surface-200 bg-white px-5 py-4 text-sm text-surface-600">
        Vale saber: Ferret Go é a empresa (ferret go GmbH) e Conversario é o seu produto de moderação de comentários. <a href={L('/alternatives/ferret-go-vs-conversario')} class="text-brand-600 hover:text-brand-500">Ferret Go e Conversario: a diferença</a> · <a href={L('/alternatives/conversario')} class="text-brand-600 hover:text-brand-500">Alternativa ao Conversario</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Para quem é o Ferret Go?</h2>
      <p class="mt-4 text-surface-600">A ferret go GmbH, empresa alemã, se apresenta como fornecedora de soluções para comunidades digitais. Ela vende dois produtos: o Conversario, uma moderação automática de comentários que aplica as regras de cada comunidade e se conecta a redes sociais, apps e chats, e o Engagently, uma plataforma de comentários, votações e diálogo nos sites de editoras e marcas.</p>
      <p class="mt-4 text-surface-600">Segundo o seu site, a empresa trabalha na sua plataforma desde 2015 e criou os seus primeiros modelos de moderação para WELT e Bild em 2016. Ela se dirige sobretudo a editoras, emissoras e marcas do mercado de língua alemã.</p>
    </div>
  </section>
  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Escolha o OpenModeration se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>você quer saber o preço antes de falar com o comercial;</li>
          <li>a sua equipe precisa de um motivo por escrito para cada comentário ocultado;</li>
          <li>você quer conectores prontos para Facebook, Instagram, YouTube e WordPress;</li>
          <li>você precisa de hospedagem na UE e dos elementos do DSA sem projeto adicional;</li>
          <li>você quer que a sua moderação aproveite o progresso dos novos modelos de IA.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">A Ferret Go pode ser melhor para você se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>você precisa moderar LinkedIn, TikTok ou Threads;</li>
          <li>você quer moderação, análises e uma plataforma de engajamento do mesmo fornecedor;</li>
          <li>para você pesa sobretudo uma longa lista de referências de veículos de língua alemã.</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Ferret Go (Conversario) e OpenModeration, ponto a ponto</h2>
      <p class="mt-4 text-surface-500">Informações sobre a Ferret Go e o Conversario tiradas de ferret-go.com e conversar.io, consultados em 30 de outubro de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Critério</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Ferret Go (Conversario)</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O motor de IA, e por que ele importa</h2>
      <p class="mt-4 text-surface-600">O OpenModeration usa a sua própria IA de moderação. Nos casos delicados, outros modelos de IA verificam a decisão antes de ocultar um comentário ou deixá-lo com a nossa equipe.</p>
      <p class="mt-4 text-surface-600">A plataforma não depende de um único modelo: quando sai um modelo de IA melhor ou mais barato, a nossa equipe o integra rapidamente, sem que você precise mudar nada. A sua moderação acompanha o progresso do mercado de IA em vez de ficar congelada num único algoritmo próprio.</p>
    </div>
  </section>
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O que muda de verdade no dia a dia</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Um motivo por escrito para cada decisão</h3>
          <p class="mt-2 text-sm text-surface-600">O OpenModeration explica por que cada comentário ocultado viola as suas regras. A sua equipe vê isso no console, a API o devolve, e ele serve para a exposição de motivos exigida pelo artigo 17 do DSA.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Fora os abusos, a crítica fica</h3>
          <p class="mt-2 text-sm text-surface-600">As violações claras são ocultadas automaticamente. A crítica legítima, mesmo dura, continua visível. A nossa equipe trata os casos duvidosos; você vê cada decisão em tempo real num único console, com registro completo.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Conectores, não um projeto de TI</h3>
          <p class="mt-2 text-sm text-surface-600">Páginas do Facebook, contas profissionais do Instagram, canais do YouTube e WordPress se conectam em poucos cliques. O seu sistema de comentários ou o seu app, via API.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Teste sem desligar nada</h3>
          <p class="mt-2 text-sm text-surface-600">Em modo sandbox, o OpenModeration avalia os seus comentários reais sem ocultar nada, enquanto a sua ferramenta atual continua moderando. Para ser justo, o Conversario também oferece um modo «dry-run» segundo o seu site; com o OpenModeration você lê o motivo de cada decisão.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Elementos do DSA incluídos</h3>
          <p class="mt-2 text-sm text-surface-600">Notificação e ação, exposição de motivos, revisão humana de decisões contestadas e números exportáveis para os seus relatórios de transparência. RGPD, hospedagem na UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Uma equipe em Paris, Madri e Berlim</h3>
          <p class="mt-2 text-sm text-surface-600">O OpenModeration é desenvolvido pela Logora. Jesús, em Madri, atende clientes da Espanha e da América Latina, e Sylvia, em Berlim, os de língua alemã na sua língua materna. <a href={L('/book-a-call')} class="text-brand-600 hover:text-brand-500">Agende uma reunião</a>.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Preço da Ferret Go e preço do OpenModeration</h2>
      <p class="mt-4 text-surface-600">A Ferret Go não publica os preços do Conversario. O formulário de conversar.io pede o seu volume mensal de comentários, e o site menciona um teste grátis de 30 dias.</p>
      <p class="mt-4 text-surface-600">O OpenModeration publica os seus preços: grátis até 1.000 requisições por mês, Pro a 99 €/mês com 10 mil requisições, Enterprise sob consulta. A implantação on-premise só é possível sob consulta. <a href={L('/pricing')} class="text-brand-600 hover:text-brand-500">Ver os preços</a>.</p>
    </div>
  </section>
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Migrar em três etapas</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-2 font-semibold text-surface-900">Conecte os seus canais</h3>
          <p class="mt-2 text-sm text-surface-600">Facebook, Instagram, YouTube ou WordPress em poucos cliques, ou o seu sistema de comentários via API.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-2 font-semibold text-surface-900">Compare em sandbox</h3>
          <p class="mt-2 text-sm text-surface-600">O OpenModeration avalia os seus comentários reais sem agir, enquanto a sua ferramenta atual continua moderando. A nossa equipe adapta com você a moderação às suas regras.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-2 font-semibold text-surface-900">Ative</h3>
          <p class="mt-2 text-sm text-surface-600">Quando os resultados convencerem você, ative a moderação automática e encerre o contrato anterior quando for conveniente.</p>
        </li>
      </ol>
    </div>
  </section>
  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Perguntas frequentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Ferret Go, Conversario e Engagently são marcas da sua editora, a ferret go GmbH. Fontes (consultadas em 30 de outubro de 2026): <a href="https://www.ferret-go.com" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">ferret-go.com</a>, <a href="https://www.ferret-go.com/impressum" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">ferret-go.com/impressum</a>, <a href="https://www.conversar.io/en/about" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">conversar.io/en/about</a>, <a href="https://www.conversar.io/en/product" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">conversar.io/en/product</a>, <a href="https://www.conversar.io/en/dsa-comment-moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">conversar.io/en/dsa-comment-moderation</a>, <a href="https://conversar.io/en/demo" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">conversar.io/en/demo</a>, <a href="https://www.engagently.com/en" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">engagently.com</a>, <a href="https://www.horizont.net/medien/nachrichten/ki-basierte-community-loesungen-dfv-mediengruppe-uebernimmt-mehrheit-an-ferret-go-197573" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Horizont, 2 de fevereiro de 2022</a>. Viu algum erro? Escreva para <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber mais</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={L('/alternatives/ferret-go-vs-conversario')} class="font-medium text-brand-600 hover:text-brand-500">Ferret Go e Conversario: a diferença e a alternativa &rarr;</a></li>
        <li><a href={L('/alternatives/conversario')} class="font-medium text-brand-600 hover:text-brand-500">Alternativa ao Conversario &rarr;</a></li>
        <li><a href={L('/moderation-software')} class="font-medium text-brand-600 hover:text-brand-500">O software de moderação OpenModeration &rarr;</a></li>
        <li><a href={L('/blog/comment-moderation-guide')} class="font-medium text-brand-600 hover:text-brand-500">Guia de moderação de comentários &rarr;</a></li>
        <li><a href={L('/dsa-compliance/statement-of-reasons')} class="font-medium text-brand-600 hover:text-brand-500">A exposição de motivos exigida pelo DSA &rarr;</a></li>
        <li><a href={L('/alternatives')} class="font-medium text-brand-600 hover:text-brand-500">Todos os comparativos &rarr;</a></li>
        <li><a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Agende uma reunião com a nossa equipe &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Compare o OpenModeration e a Ferret Go com os seus próprios comentários." subtitle="Comece em modo sandbox: o OpenModeration avalia os seus comentários reais e explica cada decisão, sem mexer na sua moderação atual." />
</BaseLayout>
