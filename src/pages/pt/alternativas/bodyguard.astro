---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import SwitchProvider from '../../../components/SwitchProvider.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';
import { bookingUrl } from '../../../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pt/alternativas/bodyguard",
  "name": "Alternativa ao Bodyguard: comparativo com o OpenModeration",
  "description": "Bodyguard ou OpenModeration? Comparativo com fontes: redes cobertas, preços, hospedagem na UE, modelos de IA e explicação por escrito de cada decisão.",
  "inLanguage": "pt",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Ofertas", bodyguard: "Uma API de moderação para plataformas e uma oferta de moderação de redes sociais para marcas, agências e órgãos públicos", openmod: "Uma única plataforma: conectores para redes sociais e WordPress, API REST e webhooks para todo o resto" },
  { feature: "Redes sociais cobertas", bodyguard: "Facebook, Instagram, TikTok, X, LinkedIn, YouTube, Twitch, Discord", openmod: "Facebook, Instagram, YouTube e WordPress de forma nativa; os sites, via API" },
  { feature: "Preço", bodyguard: "Guardian a partir de 1.000 €/mês, Sentinel a partir de 3.000 €/mês, Commander sob orçamento; preço conforme o tamanho da audiência", openmod: "Públicos: grátis até 1.000 requisições/mês, Pro a 99 €/mês para 10 mil requisições, Enterprise sob consulta" },
  { feature: "Hospedagem dos dados", bodyguard: "Não especificado na página inicial", openmod: "Desenvolvido e hospedado na União Europeia" },
  { feature: "Modelos de IA", bodyguard: "Tecnologia desenvolvida pela Bodyguard", openmod: "IA de moderação própria, verificada por outros modelos de IA; novos modelos integrados assim que são lançados" },
  { feature: "Explicação por escrito de cada decisão", bodyguard: "Não mencionado", openmod: "Sim, para cada decisão, no idioma que você escolher" },
  { feature: "DSA", bodyguard: "Não mencionado na página inicial", openmod: "Registro de auditoria de todas as decisões, automáticas ou humanas" },
  { feature: "Conformidade declarada", bodyguard: "RGPD, SOC 2 Type 2", openmod: "RGPD; registro de auditoria completo de cada decisão" },
  { feature: "Idiomas", bodyguard: "46 idiomas, segundo a empresa", openmod: "Explicações no idioma que você escolher" },
];

const faqItems = [
  {
    question: "Qual é a melhor alternativa ao Bodyguard?",
    answer: "Depende do que você procura. Se você quer um plano gratuito para começar, dados hospedados na UE e uma explicação por escrito para cada comentário ocultado, o OpenModeration atende a esses critérios. Se você precisa moderar TikTok, X, LinkedIn, Twitch ou Discord de forma nativa, o Bodyguard cobre essas redes e o OpenModeration não.",
  },
  {
    question: "Quanto custa o Bodyguard em comparação com o OpenModeration?",
    answer: "Segundo a sua página de preços, o Bodyguard oferece um plano Guardian a partir de 1.000 € por mês e um plano Sentinel a partir de 3.000 € por mês, com preço que depende do tamanho da audiência. O OpenModeration oferece um plano gratuito de até 1.000 requisições por mês e um plano Pro a 99 € por mês para 10 mil requisições.",
  },
  {
    question: "Bodyguard vs OpenModeration: qual é a diferença?",
    answer: "O Bodyguard cobre mais redes sociais de forma nativa e se baseia em uma tecnologia própria. O OpenModeration modera os comentários do seu site, do Facebook, do Instagram, do YouTube e do WordPress, com preços públicos, dados hospedados na UE e uma explicação por escrito para cada decisão, e a sua IA acompanha o progresso dos modelos de IA.",
  },
  {
    question: "O OpenModeration está em conformidade com o DSA?",
    answer: "O OpenModeration redige uma explicação por escrito para cada decisão e mantém um registro de auditoria de todas elas, sejam tomadas pela IA ou por um moderador. Esses dois elementos servem diretamente para a declaração de motivos exigida pelo artigo 17 do DSA.",
  },
  {
    question: "Dá para migrar do Bodyguard para o OpenModeration sem começar do zero?",
    answer: "No Facebook, Instagram, YouTube e WordPress, basta conectar as suas contas e escrever as suas regras em linguagem natural, sem código. Para uma plataforma própria, a API REST do OpenModeration substitui a chamada à API anterior.",
  },
];
---

<BaseLayout title="Alternativa ao Bodyguard: comparativo com o OpenModeration" description="Bodyguard ou OpenModeration? Comparativo com fontes: redes cobertas, preços, hospedagem na UE, modelos de IA e explicação por escrito de cada decisão." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Alternativas", href: L('/alternatives') }, { label: "Bodyguard" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativo
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa ao Bodyguard: o OpenModeration frente a frente</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        O Bodyguard é uma empresa francesa reconhecida na moderação com IA. O OpenModeration faz outras escolhas: um plano gratuito e depois o Pro a 99 € por mês, dados hospedados na UE e uma explicação por escrito para cada decisão. Veja as diferenças, com fontes, para escolher com conhecimento de causa.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Escolha o OpenModeration se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>você quer começar grátis e depois pagar menos de 100 € por mês;</li>
          <li>você valoriza um registro de auditoria completo e a possibilidade de exportar os seus dados;</li>
          <li>os seus dados precisam ficar na União Europeia;</li>
          <li>você precisa explicar cada remoção de comentário, como exige o DSA;</li>
          <li>você quer uma moderação que acompanhe o progresso dos modelos de IA, sem nada a mudar do seu lado.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">O Bodyguard pode ser mais indicado se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>você precisa moderar TikTok, X, LinkedIn, Twitch ou Discord de forma nativa;</li>
          <li>o seu departamento de compras exige uma certificação SOC 2 Type 2;</li>
          <li>você prefere uma solução totalmente gerenciada por um único fornecedor.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Bodyguard vs OpenModeration, ponto a ponto</h2>
      <p class="mt-4 text-surface-500">Informações sobre o Bodyguard extraídas do seu site, bodyguard.ai, consultado em 20 de outubro de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Critério</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Bodyguard</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.bodyguard}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O que muda de verdade no dia a dia</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Você sabe por que um comentário foi ocultado</h3>
          <p class="mt-2 text-sm text-surface-600">O OpenModeration acompanha cada decisão com uma explicação por escrito, visível para a sua equipe e retornada pela API. Você pode responder a um leitor que conteste a decisão, e o DSA exige justamente que cada remoção seja explicada.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">As suas regras, escritas do jeito que você pensa</h3>
          <p class="mt-2 text-sm text-surface-600">Você redige as suas regras em linguagem natural, adiciona palavras proibidas e ajusta um limite por categoria. A nossa equipe trata os casos-limite; você vê cada decisão em tempo real e pode intervir quando quiser.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Um preço de entrada muito mais baixo</h3>
          <p class="mt-2 text-sm text-surface-600">O Bodyguard começa em 1.000 € por mês. O OpenModeration é grátis até 1.000 requisições por mês e o plano Pro custa 99 € por mês para 10 mil requisições; o Enterprise é sob consulta. Se você precisar de uma implantação on-premise, ela é possível sob consulta: <a href={bookingUrl(locale)} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:text-brand-500">vamos conversar</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Um motor de IA que acompanha o progresso dos modelos</h3>
          <p class="mt-2 text-sm text-surface-600">O OpenModeration usa a sua própria IA de moderação e, nos casos delicados, outros modelos de IA verificam as suas decisões. Quando sai um modelo melhor ou mais barato, a nossa equipe o integra rapidamente, sem que você precise mudar nada. A sua moderação acompanha o progresso do mercado de IA em vez de ficar congelada em um único algoritmo.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Perguntas frequentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bodyguard é uma marca da sua empresa titular. As informações sobre ela vêm de <a href="https://bodyguard.ai/fr" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">bodyguard.ai</a> e da sua <a href="https://www.bodyguard.ai/en/social-media/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">página de preços</a> (consultadas em 20 de outubro de 2026). Viu algum erro? Escreva para <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber mais</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Agende uma reunião com a nossa equipe &rarr;</a></li>
        <li><a href={L('/moderation-software')} class="font-medium text-brand-600 hover:text-brand-500">O software de moderação OpenModeration &rarr;</a></li>
        <li><a href={L('/social-media-moderation')} class="font-medium text-brand-600 hover:text-brand-500">Moderação de redes sociais com o OpenModeration &rarr;</a></li>
        <li><a href={L('/dsa-compliance/statement-of-reasons')} class="font-medium text-brand-600 hover:text-brand-500">A declaração de motivos exigida pelo DSA &rarr;</a></li>
        <li><a href={L('/alternatives')} class="font-medium text-brand-600 hover:text-brand-500">Todos os comparativos &rarr;</a></li>
        <li><a href={L('/pricing')} class="font-medium text-brand-600 hover:text-brand-500">Os preços do OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Teste a alternativa ao Bodyguard." subtitle="Conecte as suas páginas, escreva as suas regras e consulte a explicação por escrito de cada comentário ocultado. Grátis para começar." />
</BaseLayout>
