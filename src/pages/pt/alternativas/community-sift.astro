---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pt/alternativas/community-sift",
  "name": "Alternativa ao Community Sift: comparativo e preços",
  "description": "Procurando uma alternativa ao Community Sift? Situação, oferta, preços e modelos de IA comparados ao OpenModeration, moderação de comentários hospedada na UE.",
  "inLanguage": "pt",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  { feature: "Situação", competitor: "Página do produto ainda no ar, sem aviso de fim de vida (30 de outubro de 2026); um concorrente afirma que os contratos não serão renovados em 2026, sem confirmação pública da Microsoft", openmod: "Em desenvolvimento ativo pela Logora (Paris, desde 2019)" },
  { feature: "Oferta", competitor: "IA e expertise humana para classificar, filtrar e escalar conteúdo de usuários em tempo real, sobretudo para jogos e comunidades online", openmod: "Moderação de comentários com IA para veículos de mídia, marcas e instituições públicas, configurada com você pela equipe da Logora" },
  { feature: "Integrações", competitor: "Não detalhadas na página; plug-in para Discord e OCR como opções", openmod: "Sites (API), páginas do Facebook, contas profissionais do Instagram, canais do YouTube, WordPress" },
  { feature: "Tipos de conteúdo", competitor: "Texto, imagens e vídeo", openmod: "Comentários" },
  { feature: "Modelos de IA", competitor: "Não especificado: IA combinada com expertise humana, segundo a página da Microsoft", openmod: "IA de moderação própria, verificada por outros modelos de IA; novos modelos integrados assim que são lançados" },
  { feature: "Regras", competitor: "Guias de políticas personalizados conforme as normas da sua comunidade", openmod: "Adaptadas às suas regras e aos seus casos de uso: violações claras ocultadas, críticas legítimas visíveis, casos duvidosos tratados pela nossa equipe" },
  { feature: "Idiomas", competitor: "22 idiomas premium indicados", openmod: "Multilíngue, incluindo os idiomas do seu público: cada comentário é analisado no próprio idioma" },
  { feature: "DSA e transparência", competitor: "Não especificado na página", openmod: "Motivo por escrito para cada decisão, registro de atividade, notificação e ação, exposição de motivos, revisão humana de decisões contestadas, números exportáveis" },
  { feature: "Hospedagem", competitor: "Não especificada na página", openmod: "Hospedado na UE, RGPD" },
  { feature: "Preço", competitor: "Vários níveis, sob consulta", openmod: "Grátis até 1.000 comentários analisados/mês; Pro a 99 €/mês para 10 mil comentários analisados; Enterprise sob consulta" },
  { feature: "Referências", competitor: "Xbox, Electronic Arts, Supercell, Kabam, Flip, MSN", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "Qual é a melhor alternativa ao Community Sift?",
    answer: "Para moderar comentários de veículos de mídia, páginas de marca e canais de instituições públicas, o OpenModeration é uma opção sólida: conectores para sites, Facebook, Instagram, YouTube e WordPress, preços públicos, um motivo por escrito para cada decisão, ferramentas para o DSA e hospedagem na UE. Para o chat em tempo real de grandes jogos, procure uma ferramenta pensada para games.",
  },
  {
    question: "Quanto custa o Community Sift?",
    answer: "A Microsoft não publica preços: a sua página menciona vários níveis e opções, sob consulta. O OpenModeration é grátis até 1.000 comentários analisados por mês, depois 99 €/mês para 10 mil comentários analisados, com Enterprise sob consulta.",
  },
  {
    question: "O Community Sift vai acabar?",
    answer: "Em 30 de outubro de 2026, a página do produto na Microsoft continuava no ar, sem aviso de fim de vida. Um fornecedor concorrente escreveu em fevereiro de 2026 que a Microsoft havia avisado os clientes de que os contratos não seriam renovados no vencimento. Não encontramos confirmação pública da Microsoft: peça o cronograma ao seu contato na Microsoft.",
  },
  {
    question: "Community Sift vs OpenModeration: o que muda?",
    answer: "O Community Sift, hoje na Microsoft, é voltado para jogos e grandes comunidades online, com moderação de texto, imagens e vídeo. O OpenModeration foi pensado para comentários de veículos de mídia, marcas e instituições públicas, publica os seus preços, é hospedado na UE e dá um motivo por escrito e um registro de cada decisão.",
  },
  {
    question: "Posso testar o OpenModeration enquanto o Community Sift continua funcionando?",
    answer: "Sim. Em modo sandbox, o OpenModeration analisa o seu conteúdo real sem ocultar nada, então você compara as decisões antes de migrar.",
  },
  {
    question: "Quem configura o OpenModeration?",
    answer: "A equipe da Logora, em Paris desde 2019 e pertencente aos seus funcionários. Adaptamos com você a moderação às suas regras e aos seus casos de uso e fazemos os ajustes nas primeiras semanas.",
  },
];
---

<BaseLayout title="Alternativa ao Community Sift: comparativo e preços" description="Procurando uma alternativa ao Community Sift? Situação, oferta, preços e modelos de IA comparados ao OpenModeration, moderação de comentários hospedada na UE." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Alternativas", href: L('/alternatives') }, { label: "Community Sift" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativo
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa ao Community Sift: comparativo com o OpenModeration</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Se você modera comentários de um veículo de mídia, de páginas de marca ou dos canais de uma instituição pública, o OpenModeration é uma alternativa sólida ao Community Sift: conectores para sites, Facebook, Instagram, YouTube e WordPress, preços públicos, ferramentas para o DSA e hospedagem na UE. Se você cuida do chat em tempo real de grandes jogos online, o Community Sift foi criado para isso; veja em que pé ele está, com as fontes.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={L('/book-a-call')} class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Agendar uma reunião</a>
        <a href={L('/pricing')} class="inline-flex items-center gap-2 rounded-lg border border-surface-200 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Ver os preços</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Para quem é o Community Sift?</h2>
      <p class="mt-4 text-surface-600">O Community Sift foi criado pela Two Hat, empresa canadense comprada pela Microsoft em 2021; twohat.com agora redireciona para uma página da Microsoft. Essa página descreve uma plataforma de moderação que "combina o melhor dos dois mundos", IA e expertise humana, para classificar, filtrar e escalar conteúdo de usuários em tempo real, incluindo gírias, l33t speak, emojis e truques com Unicode, além de moderação de imagens e vídeo. Ela indica 22 idiomas premium e exibe Xbox, Electronic Arts, Supercell, Kabam, Flip e MSN.</p>
      <p class="mt-4 text-surface-600">A situação: em 30 de outubro de 2026, a página do produto na Microsoft continuava no ar, sem aviso de fim de vida. Um fornecedor concorrente escreveu em fevereiro de 2026 que a Microsoft havia comunicado aos clientes que os contratos seriam respeitados até o vencimento e não seriam renovados. Não encontramos nenhum anúncio público da Microsoft que confirme isso: confira com o seu contato na Microsoft.</p>
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Escolha o OpenModeration se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>você modera comentários de um veículo de mídia, de páginas de marca ou dos canais de uma instituição pública;</li>
          <li>você quer conectores prontos para Facebook, Instagram, YouTube e WordPress, e uma API para o seu site;</li>
          <li>você quer testar grátis com os seus próprios comentários antes de se comprometer;</li>
          <li>você precisa de um motivo por escrito para cada decisão e de ferramentas para o DSA;</li>
          <li>os seus dados precisam ficar hospedados na UE e você quer uma equipe que configure a moderação com você.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">O Community Sift pode ser melhor para você se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>você filtra o chat em tempo real de grandes jogos online, onde Xbox, EA e Supercell o utilizam;</li>
          <li>você precisa moderar imagens e vídeo com controles de risco e desfoque que protege os moderadores;</li>
          <li>você depende do plug-in para Discord ou da opção de OCR;</li>
          <li>o seu contrato com a Microsoft continua em vigor e cobre o que você precisa por enquanto.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Community Sift e OpenModeration, ponto a ponto</h2>
      <p class="mt-4 text-surface-500">Informações sobre o Community Sift extraídas da página da Microsoft, developer.microsoft.com, consultada em 30 de outubro de 2026. Quando o site não diz nada, indicamos.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Critério</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Community Sift</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Um motor de IA que acompanha a evolução do mercado</h2>
      <p class="mt-4 text-surface-600">O OpenModeration usa a sua própria IA de moderação e, nos casos delicados, outros modelos de IA verificam as suas decisões. O motor não depende de um único modelo: quando sai um melhor ou mais barato, a nossa equipe o integra rapidamente, sem que você precise mudar nada.</p>
      <p class="mt-4 text-surface-600">A página da Microsoft diz que o Community Sift combina IA e expertise humana, sem citar os modelos que usa. Com o OpenModeration, a sua moderação acompanha o progresso dos modelos de IA em vez de ficar congelada num único algoritmo, o que importa quando você escolhe uma ferramenta para vários anos.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Preços do Community Sift e do OpenModeration</h2>
      <p class="mt-4 text-surface-600">A Microsoft não publica os preços do Community Sift: a sua página fala em "vários níveis de preço" e em opções como OCR e um plug-in para Discord, e remete à equipe comercial.</p>
      <p class="mt-4 text-surface-600">O OpenModeration publica os seus preços: grátis até 1.000 comentários analisados por mês, Pro a 99 €/mês para 10 mil comentários analisados e Enterprise sob consulta para grandes volumes. A implantação nos seus próprios servidores é possível sob consulta.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Sair do Community Sift em 3 etapas</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-1 font-semibold text-surface-900">Traduza a sua política</h3>
          <p class="mt-2 text-sm text-surface-600">Com a nossa equipe, transforme a sua política do Community Sift, com os seus temas e níveis de risco, em regras para os seus casos de uso: o que é ocultado, o que fica e o que vai para um moderador.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-1 font-semibold text-surface-900">Rode os dois em paralelo</h3>
          <p class="mt-2 text-sm text-surface-600">Conecte o seu site via API, ou as suas contas do Facebook, Instagram, YouTube e WordPress, em modo sandbox. Nada é ocultado enquanto você compara as decisões sobre o mesmo conteúdo.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-1 font-semibold text-surface-900">Migre antes do vencimento</h3>
          <p class="mt-2 text-sm text-surface-600">Ative a moderação automática no OpenModeration e pare de enviar conteúdo ao Community Sift, de preferência bem antes do fim do seu contrato.</p>
        </li>
      </ol>
      <p class="mt-8 text-surface-600">Quer ver antes com os seus próprios comentários? <a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Agende uma reunião com a equipe da Logora</a> e configuramos o sandbox com você.</p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Perguntas frequentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Community Sift e Two Hat são marcas do seu titular, a Microsoft. Fontes: <a href="https://developer.microsoft.com/en-us/games/products/community-sift/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">developer.microsoft.com/en-us/games/products/community-sift</a>, <a href="https://www.twohat.com" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">twohat.com</a>, <a href="https://www.lassomoderation.com/blog/what-is-community-sift/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">lassomoderation.com/blog/what-is-community-sift</a> (consultadas em 30 de outubro de 2026). Viu algum erro? Escreva para <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber mais</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={L('/blog/comment-moderation-guide')} class="font-medium text-brand-600 hover:text-brand-500">Moderação de comentários: o guia completo &rarr;</a></li>
        <li><a href={L('/use-cases/gaming')} class="font-medium text-brand-600 hover:text-brand-500">Moderação para comunidades de games &rarr;</a></li>
        <li><a href={L('/moderation-software')} class="font-medium text-brand-600 hover:text-brand-500">O software de moderação OpenModeration &rarr;</a></li>
        <li><a href={L('/pricing')} class="font-medium text-brand-600 hover:text-brand-500">Os preços do OpenModeration &rarr;</a></li>
        <li><a href={L('/alternatives')} class="font-medium text-brand-600 hover:text-brand-500">Todos os comparativos &rarr;</a></li>
        <li><a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Agende uma reunião com a nossa equipe &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Prepare a sua saída do Community Sift com a equipe da Logora." subtitle="Traduzimos a sua política, lançamos o sandbox com o seu conteúdo real e migramos quando você estiver pronto. Grátis até 1.000 comentários analisados por mês." />
</BaseLayout>
