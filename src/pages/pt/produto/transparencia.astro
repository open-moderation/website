---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import BrowserFrame from '../../../components/BrowserFrame.astro';
import ModerationVerdict from '../../../components/ModerationVerdict.astro';
import FAQ from '../../../components/FAQ.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);
const pageUrl = `https://www.openmoderation.com${L('/product/transparency')}`;

const faqItems = [
  {
    question: "Por que o meu comentário foi ocultado?",
    answer: "Porque violou uma das suas regras. O console mostra o motivo exato em linguagem simples, por exemplo \"Este comentário contém um insulto\" ou \"Este comentário promove um golpe\", junto com o histórico completo da decisão.",
  },
  {
    question: "Posso ver o raciocínio da IA em cada decisão?",
    answer: "Sim. Cada decisão automática traz uma justificativa por escrito. Os comentários na zona cinzenta são revisados pela nossa equipe com todo o contexto, e as decisões humanas são registradas da mesma forma: quem decidiu, quando e por quê.",
  },
  {
    question: "Onde os meus dados ficam armazenados?",
    answer: "Na União Europeia, sob as regras do RGPD. Nenhum cookie de rastreamento neste site, nenhuma revenda de dados. Você pode exportar os seus dados a qualquer momento. A implantação on-premise é possível sob consulta.",
  },
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "inLanguage": "pt",
      "name": "Transparência: veja exatamente por que cada comentário foi ocultado",
      "description": "Cada decisão de moderação vem com um motivo por escrito, um registro de auditoria completo das ações da IA e humanas, exportação de dados e hospedagem na UE.",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "inLanguage": "pt",
      "mainEntity": faqItems.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": { "@type": "Answer", "text": item.answer }
      }))
    }
  ]
};

const steps = [
  {
    title: "A IA oculta um comentário",
    description: "Ele viola uma das suas regras: insultos, spam, golpes ou qualquer outra coisa que as suas regras proíbam.",
  },
  {
    title: "Um motivo por escrito é anexado",
    description: "Ele diz em linguagem simples o que o comentário fez e qual regra violou: nada de pontuações para decifrar.",
  },
  {
    title: "Tudo vai para o registro",
    description: "Cada decisão, da IA ou humana, tem data e hora e pode ser pesquisada, com quem decidiu, quando e por quê.",
  },
];

const proofs = [
  {
    title: "Motivos por escrito",
    description: "Cada comentário ocultado traz a sua explicação, em linguagem simples, direto no console.",
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
    href: null,
    hrefLabel: null,
  },
  {
    title: "Registro de auditoria completo",
    description: "As decisões da IA e humanas ficam em um só lugar, com data e hora e todo o contexto, prontas para uma auditoria do DSA.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    href: L('/dsa-compliance'),
    hrefLabel: "Ver as trilhas de auditoria DSA",
  },
  {
    title: "Seus dados, exportáveis",
    description: "Exporte os seus dados de moderação e o histórico de decisões a qualquer momento, para os seus próprios arquivos ou para um regulador.",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  },
  {
    title: "Hospedado na UE e RGPD",
    description: "Os seus dados ficam na União Europeia. A implantação on-premise é possível sob consulta.",
    icon: "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    href: L('/faq'),
    hrefLabel: "Dúvidas sobre dados nas perguntas frequentes",
  },
];
---

<BaseLayout
  title="Transparência: por que cada comentário foi ocultado"
  description="Cada decisão de moderação vem com um motivo por escrito, um registro de auditoria completo das ações da IA e humanas, exportação de dados e hospedagem na UE."
  jsonLd={pageJsonLd}
>
  <Breadcrumb items={[{ label: 'Início', href: L('/') }, { label: 'Produto' }, { label: 'Transparência' }]} />

  <!-- Destaque -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-surface-50" />
    <div class="relative mx-auto max-w-7xl px-4 pb-12 pt-10 sm:px-6 lg:px-8 lg:pt-14">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Nosso compromisso · Transparência
        </div>
        <h1 class="animate-fade-in-up text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
          Cada comentário ocultado vem com um <em class="italic text-brand-800">motivo</em> por escrito.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-500 sm:text-xl">
          Se você não consegue explicar uma decisão de moderação, não consegue defendê-la. O OpenModeration diz
          em linguagem simples por que cada comentário foi ocultado, todas as vezes.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/pt/agendar-reuniao" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Agende uma reunião</a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Experimente grátis
          </a>
          <a href={L('/how-it-works')} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Veja como funciona
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400">Sem cartão de crédito</p>
      </div>
    </div>
  </section>

  <!-- Captura de prova -->
  <section class="bg-white pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-xl">
        <BrowserFrame
          caption="Workspace de demonstração: um comentário de golpe rejeitado, o motivo por escrito e o histórico completo."
        >
          <ModerationVerdict slot="content" />
          <div slot="annotation" class="absolute bottom-3 right-3 rounded-full border border-brand-200 bg-white/95 px-3 py-1 text-xs font-semibold text-brand-800 shadow-sm">
            &#x270D; O motivo por escrito
          </div>
        </BrowserFrame>
      </div>
    </div>
  </section>

  <!-- Caixa-preta vs transparência -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          Um comentário ocultado que você não consegue explicar é um risco
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          No dia em que um cliente, o seu chefe ou um regulador perguntar &ldquo;por que isso foi ocultado?&rdquo;,
          &ldquo;foi o algoritmo que decidiu&rdquo; não é uma resposta.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            Moderação caixa-preta
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Pontuações brutas, sem contexto nem explicação</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Nenhuma justificativa por escrito para os comentários ocultados</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Nada para mostrar em uma auditoria ou em uma contestação</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Você descobre os erros quando já é tarde</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Com o OpenModeration
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Um motivo por escrito para cada comentário ocultado</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Ações da IA e humanas em um único registro</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Explicável a clientes, chefes e reguladores</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> As suas próprias regras, configuradas com a nossa equipe</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Como funciona -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        title="Como a transparência funciona"
        subtitle="Três etapas levam do comentário sinalizado a um motivo que você pode mostrar a qualquer pessoa."
      />
      <div class="grid gap-6 md:grid-cols-3">
        {steps.map((step, i) => (
          <div class="relative rounded-xl border border-surface-200 bg-white p-8">
            <span class="text-4xl font-bold text-brand-100">0{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-surface-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Provas -->
  <section class="border-t border-surface-100 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        title="Como você pode verificar"
        subtitle="Quatro coisas que você mesmo pode conferir, em vez de confiar apenas na nossa palavra."
      />
      <div class="stagger-fade-in grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {proofs.map((p) => (
          <div class="flex flex-col rounded-xl border border-surface-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={p.icon}/></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-surface-900">{p.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-surface-500">{p.description}</p>
            {p.href && (
              <a href={p.href} class="mt-4 text-sm font-medium text-brand-600 hover:text-brand-500">
                {p.hrefLabel} &rarr;
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Número -->
  <section class="border-t border-surface-100 bg-white py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-5xl font-bold tracking-tight text-brand-900 sm:text-6xl">68%</p>
      <p class="mt-4 text-lg text-surface-600 sm:text-xl">
        dos consumidores leem os seus comentários antes de comprar.
      </p>
      <p class="mt-2 text-sm text-surface-400">Fonte: pesquisa com consumidores citada pela Respondology</p>
      <p class="mx-auto mt-6 max-w-2xl text-surface-500">
        O que eles encontram ali decide se vão confiar em você. É por isso que cada decisão de moderação
        deve vir acompanhada do motivo, por escrito.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-surface-100 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle title="Perguntas frequentes" />
      <FAQ items={faqItems} disableJsonLd />
    </div>
  </section>

  <!-- CTA final -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Cada decisão de moderação vem com a sua explicação.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-300">
        Conecte a sua página em poucos cliques e veja o motivo por escrito por trás de cada comentário ocultado.
      </p>
      <div class="mt-8">
        <a href="/pt/agendar-reuniao" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm transition hover:bg-surface-100">Agende uma reunião</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-white/40 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
          Experimente grátis
        </a>
        <p class="mt-4 text-sm text-surface-400">Sem cartão de crédito</p>
      </div>
      <p class="mt-12 text-xs text-surface-500">Sem cookies de rastreamento. Hospedado na UE. Cada decisão explicada.</p>
    </div>
  </section>
</BaseLayout>
