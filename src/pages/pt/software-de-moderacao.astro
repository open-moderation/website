---
import SectorPage from '../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Software de moderação de conteúdo pronto para o DSA"
  description="Software de moderação adaptado às suas regras para comentários do seu site e redes sociais: análise por IA, revisão humana, motivos escritos e registro DSA."
  crumb="Software de moderação"
  parent={null}
  eyebrow="Software de moderação de conteúdo"
  h1="Um software de moderação completo, não apenas um filtro"
  intro="Um sistema de moderação de verdade faz mais do que bloquear palavras. O OpenModeration lê cada comentário à luz das suas regras, oculta o que as viola, deixa os casos duvidosos com a nossa equipe e guarda um registro escrito de cada decisão para o DSA."
  problem="Os filtros de palavras-chave bloqueiam críticas legítimas e deixam passar ironia, insultos disfarçados e golpes. As APIs de moderação puras devolvem pontuações, mas ainda falta construir a interface, as regras, a revisão humana e o registro de auditoria."
  approach="O OpenModeration reúne todo o sistema: coleta de comentários (seu site, Facebook, Instagram, YouTube, API), análise por IA, regras em linguagem natural, um console de revisão e um registro de auditoria. Adaptamos tudo com você às suas regras e aos seus casos de uso."
  result="Uma moderação que funciona sozinha, dia e noite, com uma equipe que só intervém nos casos que precisam de uma pessoa, e um histórico pronto para apresentar se uma decisão for contestada ou auditada."
  featuresTitle="O que a ferramenta de moderação inclui"
  featuresIntro="As peças de um sistema de moderação, já montadas e prontas para conectar aos seus espaços de comentários."
  features={[
    { title: "Análise por IA, em contexto", text: "Cada comentário é lido junto com o tema do artigo ou da publicação, no próprio idioma, para detectar ironia, insultos codificados e mensagens fora do assunto." },
    { title: "Suas regras em linguagem natural", text: "Você escreve as regras como as explicaria a um moderador. Sem listas de palavras para manter, sem código." },
    { title: "Um console transparente", text: "Você vê cada decisão em tempo real, com a regra em questão e a explicação da IA. Os casos limítrofes ficam com a nossa equipe, e você pode intervir com um clique." },
    { title: "Registro de auditoria e exposição de motivos", text: "Cada decisão, automática ou humana, é registrada com o motivo por escrito, como exige o artigo 17 do DSA." },
  ]}
  why={[
    { title: "Implantado com você", text: "Transformamos suas regras e seus casos de uso em instruções claras e as testamos nos seus comentários reais antes de ativá-las." },
    { title: "Conforme o DSA", text: "Denúncias de usuários, exposição de motivos, revisão humana e números para o relatório de transparência estão incluídos desde o início." },
    { title: "Mais barato que uma equipe dedicada", text: "A moderação automática custa uma fração da moderação manual, interna ou terceirizada." },
  ]}
  faq={[
    { question: "Qual é a diferença entre um software de moderação e uma API de moderação?", answer: "Uma API devolve uma pontuação para um texto. Um software de moderação cuida de toda a cadeia: coleta, regras, decisão, revisão humana, explicação e histórico. O OpenModeration oferece os dois: a plataforma completa e uma API para equipes técnicas." },
    { question: "Preciso de desenvolvedores para implantar?", answer: "Não para Facebook, Instagram, YouTube ou WordPress: os conectores funcionam sem código. Para um site ou aplicativo sob medida, basta uma integração via API." },
    { question: "Posso testar antes de me comprometer?", answer: "Sim. Você pode testar um comentário agora mesmo na demo online, criar uma conta gratuita ou agendar uma reunião para ver a moderação funcionando nos seus próprios comentários." },
    { question: "O software está em conformidade com o RGPD?", answer: "Sim. O OpenModeration é desenvolvido e hospedado na União Europeia, e você escolhe por quanto tempo os dados são mantidos." },
  ]}
  related={[
    { eyebrow: "Demo", title: "Testar a moderação", text: "Cole um comentário e veja a decisão e a explicação em segundos.", href: localizePath('/demo', locale) },
    { eyebrow: "Plataforma", title: "O console de moderação", text: "Uma única fila para todas as suas plataformas.", href: localizePath('/dashboard', locale) },
    { eyebrow: "Regulação", title: "Conformidade com o DSA", text: "O que o DSA exige dos sites que hospedam comentários.", href: localizePath('/dsa-compliance', locale) },
  ]}
  ctaTitle="Veja o sistema funcionando nos seus comentários."
  ctaSubtitle="Agende uma reunião: partimos das suas regras e dos seus casos de uso e mostramos as decisões nos seus comentários reais."
/>
