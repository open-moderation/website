---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderação para prefeituras e instituições públicas"
  description="Modere consultas públicas, plataformas de participação cidadã e as páginas da sua instituição com regras públicas e um motivo por escrito para cada decisão."
  crumb="Setor público"
  h1="Moderação para prefeituras e instituições públicas"
  intro="Consultas públicas, plataformas de participação, a página da prefeitura no Facebook: o debate público precisa de espaços abertos e também seguros. O OpenModeration aplica as suas regras de participação a cada contribuição e explica cada decisão por escrito, para que ninguém possa chamá-la de censura arbitrária."
  problem="Uma consulta sobre um projeto local pode reunir centenas de contribuições em poucos dias, com ofensas dirigidas a autoridades eleitas ou servidores, discurso de ódio e mensagens fora do tema. Moderar à mão consome o tempo da equipe, e cada remoção pode ser contestada."
  approach="Adaptamos a moderação às suas regras de participação e aos seus casos de uso. Cada contribuição é lida no contexto: ofensas e ódio são ocultados, críticas, mesmo duras, continuam publicadas, e os casos-limite são tratados pela nossa equipe, com um motivo por escrito que você vê em tempo real."
  result="O debate continua aberto e respeitoso, as suas equipes ganham tempo e você pode mostrar a qualquer momento por que uma contribuição foi ocultada. Cada decisão fica guardada em um histórico completo."
  featuresTitle="Feito para o debate público"
  featuresIntro="Em um espaço público, a forma de moderar importa tanto quanto o resultado. Construímos as regras com você."
  features={[
    { title: "Regras públicas, aplicadas como escritas", text: "As regras que você publica para os cidadãos são as regras que a IA aplica. Nenhuma regra oculta." },
    { title: "A crítica continua possível", text: "A oposição a um projeto ou a uma decisão continua visível. Só o conteúdo ofensivo, de ódio ou que viola as regras é ocultado." },
    { title: "Um motivo para cada decisão", text: "Cada contribuição ocultada vem acompanhada da regra em questão e de um motivo por escrito que você pode compartilhar com o autor." },
    { title: "Plataforma e redes sociais juntas", text: "A sua ferramenta de participação pela API e as suas páginas no Facebook, Instagram e YouTube no mesmo console." },
  ]}
  why={[
    { title: "Transparência", text: "Cada decisão é explicada e registrada: útil para responder a um cidadão, a uma autoridade eleita ou a uma auditoria." },
    { title: "Acompanhamento humano", text: "Nossa equipe ajuda você a definir as suas regras e a lidar com os casos sensíveis, junto com os seus departamentos." },
    { title: "Hospedado na UE", text: "Desenvolvido e hospedado na União Europeia, em conformidade com o RGPD." },
  ]}
  faq={[
    { question: "A moderação automática não é uma forma de censura?", answer: "Ela aplica apenas as regras que você tornou públicas e explica cada decisão por escrito. Os casos duvidosos são decididos pela nossa equipe, não pela IA, e você pode intervir quando quiser." },
    { question: "Dá para moderar uma plataforma de participação já existente?", answer: "Sim. As contribuições podem ser enviadas ao OpenModeration pela API a partir da sua ferramenta, junto com as suas páginas nas redes sociais." },
    { question: "Os dados dos cidadãos ficam na Europa?", answer: "Sim. O OpenModeration é desenvolvido e hospedado na União Europeia e está em conformidade com o RGPD." },
    { question: "Como começamos?", answer: "Agende uma conversa: partimos das suas regras de participação e dos seus casos de uso e as testamos em contribuições reais antes de ativá-las." },
  ]}
  related={[
    { eyebrow: "Guia", title: "Como escrever uma política de moderação", text: "As regras a definir antes de automatizar, com exemplos.", href: localizePath('/content-moderation-policy', locale) },
    { eyebrow: "Plataforma", title: "Cada decisão explicada", text: "Como o OpenModeration escreve um motivo para cada decisão de moderação.", href: localizePath('/product/transparency', locale) },
    { eyebrow: "Integração", title: "Moderação de comentários no Facebook", text: "Comentários nos posts da sua instituição.", href: localizePath('/integrations/facebook', locale) },
  ]}
  ctaTitle="Um debate aberto, sem as agressões."
  ctaSubtitle="Agende uma conversa: partimos das suas regras de participação e mostramos a moderação nas suas contribuições reais."
/>
