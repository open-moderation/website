---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderação de comentários para marcas de luxo e moda"
  description="Proteja a imagem da sua maison no Instagram, Facebook e YouTube: falsificações, golpes e ódio ocultos com as suas regras, em todos os idiomas dos clientes."
  crumb="Luxo e moda"
  h1="Moderação de comentários para luxo e moda"
  intro="Uma maison de luxo também é julgada pelos comentários nos seus posts. O OpenModeration oculta falsificações, perfis falsos, golpes e ódio de acordo com as suas regras, em todos os idiomas que os seus clientes falam, e preserva as conversas que dão vida à sua comunidade."
  problem="As contas de luxo atraem vendedores de falsificações, perfis falsos que se passam pela maison, golpes de sorteios falsos e ondas de ódio em torno de desfiles ou anúncios de embaixadores. Tudo isso em uma dúzia de idiomas, 24 horas por dia."
  approach="Adaptamos a moderação às suas regras, aos seus casos de uso e ao tom da sua marca. A IA lê cada comentário no contexto e no idioma original: falsificações, links de golpe e ataques são ocultados na hora, e os casos delicados são tratados pela nossa equipe, com um motivo por escrito."
  result="Os seus posts continuam à altura da maison, no mundo inteiro, sem uma equipe vigiando as threads dia e noite. Cada decisão fica registrada, o que facilita o trabalho com as suas equipes jurídica e de comunicação."
  featuresTitle="Feito para maisons internacionais"
  featuresIntro="Não se protege uma imagem de marca com uma lista de palavras proibidas. Construímos a moderação com você."
  features={[
    { title: "Falsificações e perfis falsos", text: "Mensagens que levam a réplicas, lojas falsas ou perfis que se passam pela maison são detectadas e ocultadas." },
    { title: "Todos os idiomas dos seus clientes", text: "Um único conjunto de regras, aplicado a comentários em inglês, francês, chinês, árabe, italiano ou japonês." },
    { title: "Momentos sensíveis sob controle", text: "Um desfile, um lançamento, um embaixador exposto: endureça as regras por um tempo e depois volte ao normal." },
    { title: "Um console para todas as regiões", text: "Cada equipe local vê os casos que lhe dizem respeito, com a regra em questão e o motivo por escrito." },
  ]}
  why={[
    { title: "Sua voz, suas regras", text: "A moderação segue as suas regras e a sua imagem, não uma grade genérica. Nós a ajustamos com você." },
    { title: "Acompanhamento dedicado", text: "Nossa equipe trabalha com as suas equipes de redes sociais para resolver os casos-limite e acompanhar os resultados." },
    { title: "Hospedado na UE", text: "Desenvolvido e hospedado na União Europeia, em conformidade com o RGPD, com o histórico completo de cada decisão." },
  ]}
  faq={[
    { question: "A moderação funciona em todos os idiomas?", answer: "Sim. A IA lê os comentários no idioma original e aplica as mesmas regras, então você nunca precisa escrever regras idioma por idioma." },
    { question: "Mercados diferentes podem ter regras diferentes?", answer: "Sim. Cada conta ou página pode ter as próprias regras, por exemplo mais rígidas em um mercado sensível ou durante um lançamento." },
    { question: "O que acontece com um comentário duvidoso?", answer: "Ele não é ocultado nem publicado automaticamente: é tratado pela nossa equipe. Você vê a decisão e o raciocínio da IA em tempo real e pode intervir quando quiser." },
    { question: "Como funciona a implantação?", answer: "Começamos com uma conversa para entender as suas regras, casos de uso e casos sensíveis, e depois testamos as regras nos seus comentários reais antes de ativá-las." },
  ]}
  related={[
    { eyebrow: "Integração", title: "Moderação de comentários no Instagram", text: "Comentários nos seus posts e Reels, moderados de acordo com as suas regras.", href: localizePath('/integrations/instagram', locale) },
    { eyebrow: "Integração", title: "Moderação de comentários no YouTube", text: "Comentários nos vídeos dos seus desfiles e campanhas.", href: localizePath('/integrations/youtube', locale) },
    { eyebrow: "Plataforma", title: "Cada decisão explicada", text: "Como o OpenModeration escreve um motivo para cada decisão de moderação.", href: localizePath('/product/transparency', locale) },
  ]}
  ctaTitle="Comentários à altura da sua maison."
  ctaSubtitle="Agende uma conversa: analisamos juntos os comentários dos seus últimos posts e mostramos o que a moderação teria feito."
/>
