---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderação de comentários para marcas e varejo"
  description="Modere os comentários da sua marca no Facebook, Instagram e YouTube com suas regras: spam, golpes e ofensas ocultos, clientes insatisfeitos visíveis."
  crumb="Marcas e varejo"
  h1="Moderação de comentários para marcas e varejo"
  intro="Em cada post de uma marca, clientes reais dividem espaço com spam, perfis falsos, golpes e ofensas. O OpenModeration oculta o que prejudica a sua imagem de acordo com as suas regras, mantém visíveis as críticas legítimas e sinaliza as mensagens que a sua equipe precisa responder."
  problem="Uma campanha que dá certo atrai centenas de comentários em poucas horas, muitas vezes à noite e no fim de semana. Os filtros nativos da Meta e do YouTube bloqueiam palavras, não intenções: sorteios falsos e links de golpe passam, e clientes com um problema real às vezes acabam ocultos."
  approach="Uma IA que entende o contexto lê cada comentário à luz das regras da sua marca. Spam, golpes, ódio e ataques pessoais são ocultados na hora. Reclamações, dúvidas sobre pedidos e críticas continuam visíveis e chegam à sua equipe."
  result="O seu social media deixa de passar as noites limpando threads. Os clientes veem uma marca que responde, não uma página tomada pelo spam, e cada comentário oculto tem um motivo por escrito, caso alguém pergunte."
  featuresTitle="Feito para equipes de redes sociais"
  featuresIntro="Configuramos a moderação com você, a partir das suas regras e das situações que a sua marca enfrenta de verdade."
  features={[
    { title: "Crítica não é ofensa", text: "Um cliente insatisfeito continua visível e pode receber resposta. Só são ocultados os comentários ofensivos, de ódio ou fraudulentos." },
    { title: "Sorteios falsos e links de golpe", text: "Perfis que se passam pela sua marca para prometer prêmios ou levar as pessoas a sites fraudulentos são detectados e ocultados automaticamente." },
    { title: "Todas as suas páginas em um só lugar", text: "Facebook, Instagram, YouTube e o seu site WordPress chegam ao mesmo console, com as mesmas regras, seja uma página ou cinquenta." },
    { title: "Regras por campanha", text: "Um lançamento, uma crise ou uma parceria podem pedir regras mais rígidas. Você as altera em linguagem natural, sem código." },
  ]}
  why={[
    { title: "Suas regras, aplicadas como escritas", text: "Nada de lista genérica de palavras-chave: a moderação segue o que você escreveu, e nós a ajustamos com você campanha após campanha." },
    { title: "Pessoas por trás da ferramenta", text: "Nossa equipe ajuda você a redigir as suas regras e a resolver os casos-limite. Você nunca fica sozinho com uma ferramenta." },
    { title: "Muito mais barato que uma agência", text: "A moderação funciona dia e noite automaticamente, por uma fração do custo de uma moderação terceirizada." },
  ]}
  faq={[
    { question: "Os comentários negativos são removidos?", answer: "Não. Uma crítica, mesmo dura, continua visível se respeitar as suas regras. O que é ocultado são ofensas, ódio, spam e golpes. Você decide onde fica o limite." },
    { question: "Os comentários são excluídos ou ocultados?", answer: "No Facebook e no Instagram, os comentários são ocultados: o autor e os amigos dele continuam vendo, o resto do seu público não. Você pode reexibi-los com um clique no console." },
    { question: "Quanto tempo leva para começar?", answer: "Conectar uma página leva poucos minutos. Depois marcamos uma conversa para adaptar a moderação às suas regras e casos de uso e testá-la nos seus comentários reais." },
    { question: "Onde os dados ficam hospedados?", answer: "O OpenModeration é desenvolvido e hospedado na União Europeia e está em conformidade com o RGPD." },
  ]}
  related={[
    { eyebrow: "Integração", title: "Moderação de comentários no Facebook", text: "Conecte as suas Páginas do Facebook e oculte automaticamente os comentários que violam as suas regras.", href: localizePath('/integrations/facebook', locale) },
    { eyebrow: "Integração", title: "Moderação de comentários no Instagram", text: "Comentários nos seus posts e Reels, moderados com as mesmas regras.", href: localizePath('/integrations/instagram', locale) },
    { eyebrow: "Guia", title: "Como escrever uma política de moderação", text: "As regras a definir antes de automatizar, com exemplos.", href: localizePath('/content-moderation-policy', locale) },
  ]}
  ctaTitle="Uma página de marca limpa, sem abrir mão das suas noites."
  ctaSubtitle="Agende uma conversa: analisamos juntos os seus comentários e mostramos o que a moderação teria feito."
/>
