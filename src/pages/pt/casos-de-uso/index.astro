---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import KpiBand from '../../../components/KpiBand.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const useCasesJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Casos de uso da moderação de conteúdo | OpenModeration",
  "description": "Como plataformas de todos os tipos usam o OpenModeration: redes sociais, aplicações de IA, marketplaces, games e SaaS corporativo.",
  "inLanguage": "pt",
  "url": "https://www.openmoderation.com/pt/casos-de-uso"
};

const kpis = [
  { value: "4", label: "conectores nativos" },
  { value: "300ms", prefix: "<", label: "latência mediana P50" },
  { value: "10K", label: "itens por requisição em lote" },
  { value: "100%", label: "das decisões explicadas por escrito" },
];

const useCases = [
  {
    title: "Mídia e veículos de notícias",
    tagline: "Comentários em matérias, redações",
    description: "Aplique as suas regras editoriais a cada comentário de leitor, explique cada remoção por escrito e deixe a redação decidir os casos-limite.",
    href: localizePath("/use-cases/news-publishers", locale),
    iconPath: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
  },
  {
    title: "Plataformas sociais",
    tagline: "Fóruns, comunidades, UGC",
    description: "Proteja a sua comunidade contra discurso de ódio, spam e golpes. Automatize a aplicação das regras e deixe os moderadores humanos nos casos-limite.",
    href: localizePath("/use-cases/social-platforms", locale),
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Aplicações de IA",
    tagline: "Filtragem de entrada e saída de LLMs",
    description: "Filtre prompts e respostas do modelo com uma única integração, com os casos delicados verificados por outros modelos de IA.",
    href: localizePath("/use-cases/ai-applications", locale),
    iconPath: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Marketplaces",
    tagline: "Anúncios, avaliações, classificados",
    description: "Modere anúncios de produtos, avaliações e mensagens de vendedores em escala. Detecte golpes e itens proibidos antes que entrem no ar.",
    href: localizePath("/use-cases/marketplaces", locale),
    iconPath: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z",
  },
  {
    title: "Games",
    tagline: "Chat, MMOs, live ops",
    description: "Moderação de chat em tempo real e em vários idiomas, abaixo de 500 ms. Exclua as violações automaticamente antes que outros jogadores as vejam.",
    href: localizePath("/use-cases/gaming", locale),
    iconPath: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "SaaS corporativo",
    tagline: "Conformidade, SOC 2, auditoria",
    description: "Hospedagem na UE com trilhas de auditoria completas, controle de retenção de dados e preparo comprovável para o DSA e o SOC 2.",
    href: localizePath("/use-cases/enterprise-saas", locale),
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
  {
    title: "Marcas e varejo",
    tagline: "Páginas de marca, campanhas, comentários de clientes",
    description: "Oculte spam, golpes e ofensas nos posts da sua marca, enquanto clientes insatisfeitos continuam visíveis e recebem resposta.",
    href: localizePath("/use-cases/brands-retail", locale),
    iconPath: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z",
  },
  {
    title: "Luxo e moda",
    tagline: "Instagram, falsificações, vários idiomas",
    description: "Mantenha falsificações, perfis falsos e ódio longe dos seus posts, em todos os idiomas que os seus clientes falam.",
    href: localizePath("/use-cases/luxury-fashion", locale),
    iconPath: "M5 3l3.057 4.583L12 3l3.943 4.583L19 3l2 7-9 11-9-11 2-7z",
  },
  {
    title: "Setor público",
    tagline: "Consultas públicas, participação cidadã",
    description: "Modere consultas públicas e as páginas da sua instituição com regras públicas e um motivo por escrito para cada decisão.",
    href: localizePath("/use-cases/public-sector", locale),
    iconPath: "M3 21h18M5 21V10m14 11V10M12 3l9 7H3l9-7zM9 21v-6h6v6",
  },
];
---

<BaseLayout title="Casos de uso de moderação: redes sociais, IA, games e mais" description="Veja como plataformas sociais, aplicações de IA, marketplaces, games e empresas usam o OpenModeration para uma moderação transparente e conforme o DSA." jsonLd={useCasesJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: localizePath("/", locale) }, { label: "Casos de uso" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
        <span class="flex h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        Casos de uso
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Uma plataforma de moderação para todo tipo de plataforma</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Fóruns, aplicativos com LLM, marketplaces e games usam o OpenModeration. Nós o adaptamos ao seu conteúdo, às suas regras, aos seus casos de uso e à sua infraestrutura.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/pt/agendar-reuniao" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Agende uma reunião</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Teste grátis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <KpiBand items={kpis} />
  </section>

  <section class="bg-white pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {useCases.map((useCase) => (
          <a href={useCase.href} class="group rounded-xl border border-surface-200 bg-surface-50 p-8 transition hover:border-brand-300 hover:shadow-md">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={useCase.iconPath}/></svg>
            </div>
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">{useCase.title}</h2>
            <p class="mt-1 text-xs font-medium uppercase tracking-wide text-surface-400">{useCase.tagline}</p>
            <p class="mt-3 text-sm text-surface-500">{useCase.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Saiba mais
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
        <a href={localizePath("/features", locale)} class="group rounded-xl border-2 border-dashed border-surface-300 bg-white p-8 transition hover:border-brand-400">
          <div class="flex h-full flex-col items-start justify-center">
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">Conheça todas as funcionalidades</h2>
            <p class="mt-3 text-sm text-surface-500">API unificada, Action Engine, painel de revisão, conectores e trilhas de auditoria do DSA.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Ver a plataforma
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">A mesma plataforma, regras diferentes</h2>
        <p class="mt-4 text-lg text-surface-500">Todo caso de uso conta com os mesmos blocos. Só as regras mudam.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">1. Receber o conteúdo</h3>
          <p class="mt-2 text-sm text-surface-500">API REST, endpoint em lote para acervos acumulados, webhooks ou conectores nativos para Facebook, Instagram, YouTube e WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">2. Moderar com IA</h3>
          <p class="mt-2 text-sm text-surface-500">A nossa própria IA de moderação analisa cada item, outros modelos de IA verificam os casos delicados, e o formato da resposta nunca muda.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">3. Aplicar automaticamente</h3>
          <p class="mt-2 text-sm text-surface-500">Palavras proibidas, limites por categoria e as suas próprias regras acionam as ações de ocultar, excluir, sinalizar e revisar.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Conteúdos relacionados</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href={localizePath("/blog/dsa-compliance-sme-guide", locale)} class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guia</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Conformidade com o DSA para pequenas e médias plataformas</h3>
          <p class="mt-2 text-sm text-surface-500">Passos práticos para cumprir as exigências do DSA em 2026.</p>
        </a>
        <a href={localizePath("/blog/ai-content-moderation-developer-guide", locale)} class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guia</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Moderação de conteúdo para aplicações de IA</h3>
          <p class="mt-2 text-sm text-surface-500">Boas práticas para filtrar entradas e saídas em aplicativos com LLM.</p>
        </a>
        <a href={localizePath("/dashboard", locale)} class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Produto</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">O console de moderação</h3>
          <p class="mt-2 text-sm text-surface-500">Filas de revisão, trilhas de auditoria e análise de uso.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Encontre a solução certa em minutos."
    subtitle="Escolha um caso de uso, comece pela nuvem gerenciada e modere o seu primeiro conteúdo hoje mesmo."
    buttonText="Teste grátis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
