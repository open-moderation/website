---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'pt';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Console de moderação: cada decisão e o motivo, ao vivo",
  "description": "Veja cada comentário, a decisão e o motivo por escrito em tempo real, no seu site e nas redes. Nossa equipe cuida dos casos duvidosos; você corrige se quiser.",
  "crumb": "Console de moderação",
  "badge": "O que você vê em tempo real",
  "h1": "Cada decisão e o seu motivo, em tempo real",
  "lead": "O console não é uma ferramenta que você precisa operar. Nossa IA e nossa equipe moderam; você vê cada comentário, a decisão, o motivo por escrito e quem a tomou, e pode corrigir quando quiser.",
  "feedTitle": "Sua moderação, ao vivo",
  "feedLead": "Os comentários do seu site e das suas páginas, lado a lado, cada um com a sua decisão e o motivo que a justifica.",
  "quote": [
    "“",
    "”"
  ],
  "reasonLabel": "Motivo:",
  "overrideLabel": "Corrigir",
  "feed": [
    {
      "platform": "Site",
      "kind": "published",
      "decision": "Publicado",
      "by": "Nossa IA",
      "text": "Boa matéria, mas os números do segundo parágrafo parecem desatualizados.",
      "reason": "Crítica construtiva, nenhuma regra violada."
    },
    {
      "platform": "Facebook",
      "kind": "refused",
      "decision": "Ocultado",
      "by": "Nossa IA, conferida",
      "text": "Vocês são todos corruptos, alguém devia calar vocês de vez.",
      "reason": "Ameaça e ataque pessoal."
    },
    {
      "platform": "Instagram",
      "kind": "refused",
      "decision": "Ocultado",
      "by": "Nossa IA",
      "text": "Seguidores baratos aqui, vejam meu perfil!!!",
      "reason": "Spam."
    },
    {
      "platform": "YouTube",
      "kind": "team",
      "decision": "Recusado após revisão",
      "by": "Nossa equipe",
      "text": "Típico dessa gente, nunca vão mudar.",
      "reason": "Generalização contra um grupo, contrária às suas regras."
    }
  ],
  "shotAlt": "Console da OpenModeration: comentários, decisões e motivos por escrito, plataforma por plataforma",
  "shotCaption": "O console: comentários, decisões e motivos, plataforma por plataforma.",
  "illustrative": "Exemplos e números ilustrativos, de um espaço de demonstração.",
  "kpis": [
    {
      "label": "Comentários analisados hoje",
      "value": "84,2 mil"
    },
    {
      "label": "Ocultados, cada um com motivo por escrito",
      "value": "4,7%"
    },
    {
      "label": "Casos duvidosos tratados pela nossa equipe",
      "value": "2%"
    }
  ],
  "cardsTitle": "O que você vê e o que você pode fazer",
  "cardsLead": "Transparência total, nada para operar. Você só intervém se quiser.",
  "cards": [
    {
      "title": "Cada decisão, com o motivo",
      "text": "Cada comentário, a decisão tomada e o motivo por escrito, no seu site e em cada página conectada."
    },
    {
      "title": "Casos duvidosos com a nossa equipe",
      "text": "Quando a IA fica em dúvida, nossa equipe decide segundo as suas regras. Você vê o que ela tratou e por quê."
    },
    {
      "title": "Corrija a qualquer momento",
      "text": "Publique, oculte ou restaure um comentário com um clique. Cada mudança fica registrada com o autor."
    },
    {
      "title": "Denúncias e recursos acompanhados",
      "text": "As denúncias dos usuários e as decisões contestadas são acompanhadas até a resposta, como exige o DSA."
    },
    {
      "title": "Números exportáveis",
      "text": "Volumes e decisões por categoria, plataforma por plataforma. Exporte-os para os seus relatórios do DSA e balanços internos."
    },
    {
      "title": "Suas regras à vista",
      "text": "Veja as regras aplicadas aos seus espaços. Para mudá-las, fale com a gente ou ajuste você mesmo: nossa equipe ajuda."
    }
  ],
  "devTitle": "Para equipes técnicas",
  "devLead": "O console também dá aos seus desenvolvedores o necessário para integrar e monitorar a OpenModeration.",
  "devPoints": [
    "Chaves de acesso, com limites de uso e permissões por chave",
    "Histórico de atividade pesquisável por comentário: notas, regra aplicada e resultado",
    "Status dos serviços, com latência e taxa de erros",
    "Retenção de dados, origens autorizadas e webhooks"
  ]
};

const decisionStyles: Record<string, string> = {
  published: 'bg-green-100 text-green-700',
  refused: 'bg-red-100 text-red-700',
  team: 'bg-amber-100 text-amber-700',
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pt/console-de-moderacao",
  "url": "https://www.openmoderation.com/pt/console-de-moderacao",
  "name": "Console de moderação: cada decisão e o motivo, ao vivo",
  "description": "Veja cada comentário, a decisão e o motivo por escrito em tempo real, no seu site e nas redes. Nossa equipe cuida dos casos duvidosos; você corrige se quiser.",
  "inLanguage": "pt",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Início", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-accent-500"></span> {c.badge}
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- What you see: live feed -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.feedTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.feedLead}</p>
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <ul class="divide-y divide-surface-100 overflow-hidden rounded-2xl border border-surface-200 bg-white shadow-sm">
          {c.feed.map((f) => (
            <li class="p-5">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-surface-600">{f.platform}</span>
                <span class={`rounded-full px-2.5 py-0.5 font-semibold ${decisionStyles[f.kind]}`}>{f.decision}</span>
                <span class="text-surface-400">{f.by}</span>
              </div>
              <p class="mt-3 text-surface-800">{c.quote[0]}{f.text}{c.quote[1]}</p>
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
                <p class="text-surface-500"><span class="font-medium text-surface-700">{c.reasonLabel}</span> {f.reason}</p>
                <span class="rounded-md border border-surface-300 px-3 py-1 text-xs font-semibold text-surface-700">{c.overrideLabel}</span>
              </div>
            </li>
          ))}
        </ul>
        <div>
          <BrowserFrame src="/images/dashboard.png" video="om-triage" alt={c.shotAlt} caption={c.shotCaption} eager={false} />
          <p class="mt-6 text-center text-xs text-surface-400">{c.illustrative}</p>
        </div>
      </div>
      <dl class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {c.kpis.map((k) => (
          <div class="flex flex-col-reverse rounded-xl border border-surface-200 bg-surface-50 p-6">
            <dt class="mt-1 text-sm text-surface-500">{k.label}</dt>
            <dd class="text-3xl font-bold text-surface-900">{k.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- What you see and what you can do -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.cardsTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.cardsLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {c.cards.map((card) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{card.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.devTitle}</h2>
      <p class="mt-3 text-surface-500">{c.devLead}</p>
      <ul class="mt-6 space-y-2 text-sm text-surface-600">
        {c.devPoints.map((p) => (
          <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
