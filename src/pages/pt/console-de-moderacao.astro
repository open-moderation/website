---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const pageUrl = `https://www.openmoderation.com${localizePath('/dashboard', locale)}`;

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": pageUrl,
  "url": pageUrl,
  "inLanguage": "pt",
  "name": "Console de moderação de conteúdo | OpenModeration",
  "description": "Revise os comentários sinalizados, aprove ou rejeite os casos limítrofes e acompanhe cada decisão com um motivo por escrito.",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};
---

<BaseLayout title="Console de moderação: uma fila para todas as plataformas" description="Um painel de moderação para revisar os comentários sinalizados do seu site, Facebook, Instagram e YouTube, com motivo escrito e registro de cada decisão." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Início", href: localizePath('/', locale) }, { label: "Console de moderação" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        Workspace de demonstração
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">O painel de moderação de conteúdo para toda a sua equipe</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Aprove ou rejeite comentários sinalizados com um clique. Cada decisão traz um motivo por escrito que você pode mostrar a quem pedir.
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-sm text-surface-400">
        Números ilustrativos de um workspace de demonstração.
      </p>
    </div>
  </section>

  <!-- Prévia do painel -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-4 grid-cols-2 md:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <p class="text-sm text-surface-500">Requisições hoje</p>
          <p class="mt-1 text-3xl font-bold text-surface-900">84,2 mil</p>
          <p class="mt-1 text-xs text-accent-600">+12% em relação a ontem</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <p class="text-sm text-surface-500">Taxa de sinalização</p>
          <p class="mt-1 text-3xl font-bold text-surface-900">4,7%</p>
          <p class="mt-1 text-xs text-surface-500">3.957 itens sinalizados</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <p class="text-sm text-surface-500">Latência média</p>
          <p class="mt-1 text-3xl font-bold text-surface-900">267ms</p>
          <p class="mt-1 text-xs text-accent-600">P99: 890ms</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <p class="text-sm text-surface-500">Status do serviço</p>
          <p class="mt-1 text-3xl font-bold text-surface-900">No ar</p>
          <p class="mt-1 text-xs text-surface-500">Todos operacionais</p>
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="mb-4 font-semibold text-surface-900">Uso ao longo do tempo</h3>
          <div class="flex items-end gap-2" style="height: 160px;">
            <div class="flex-1 rounded-t bg-brand-200" style="height: 60%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 45%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 75%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 55%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 80%"></div>
            <div class="flex-1 rounded-t bg-brand-300" style="height: 70%"></div>
            <div class="flex-1 rounded-t bg-brand-400" style="height: 90%"></div>
            <div class="flex-1 rounded-t bg-brand-300" style="height: 65%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 85%"></div>
            <div class="flex-1 rounded-t bg-brand-300" style="height: 95%"></div>
            <div class="flex-1 rounded-t bg-brand-400" style="height: 78%"></div>
            <div class="flex-1 rounded-t bg-brand-500" style="height: 88%"></div>
            <div class="flex-1 rounded-t bg-brand-400" style="height: 72%"></div>
            <div class="flex-1 rounded-t bg-brand-300" style="height: 82%"></div>
          </div>
          <div class="mt-2 flex justify-between text-xs text-surface-400">
            <span>1º jun</span>
            <span>15 jun</span>
            <span>30 jun</span>
          </div>
        </div>

        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="mb-4 font-semibold text-surface-900">Volume por canal</h3>
          <div class="space-y-4">
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="text-surface-600">Site</span><span class="text-surface-500">12,4 mil &middot; 3,1% sinalizados</span></div>
              <div class="h-2 rounded-full bg-surface-200"><div class="h-2 w-4/5 rounded-full bg-brand-500"></div></div>
            </div>
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="text-surface-600">Facebook</span><span class="text-surface-500">8,7 mil &middot; 5,4% sinalizados</span></div>
              <div class="h-2 rounded-full bg-surface-200"><div class="h-2 w-3/5 rounded-full bg-brand-400"></div></div>
            </div>
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="text-surface-600">Instagram</span><span class="text-surface-500">5,2 mil &middot; 4,2% sinalizados</span></div>
              <div class="h-2 rounded-full bg-surface-200"><div class="h-2 w-2/5 rounded-full bg-brand-300"></div></div>
            </div>
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="text-surface-600">YouTube</span><span class="text-surface-500">2,9 mil &middot; 6,8% sinalizados</span></div>
              <div class="h-2 rounded-full bg-surface-200"><div class="h-2 w-1/3 rounded-full bg-brand-300"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Funcionalidades do painel -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Todo o seu console de moderação em um só lugar</h2>
        <p class="mt-4 text-lg text-surface-500">Conduza a sua moderação a partir de um único console, hospedado na UE.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7h3a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h3m0-4h6v4H9V3z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Gestão de acessos</h3>
          <p class="mt-1 text-sm text-surface-500">Controle quem pode fazer o quê. Crie e revogue chaves de acesso e defina limites de requisições.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Histórico de atividade</h3>
          <p class="mt-1 text-sm text-surface-500">Acompanhe cada decisão de moderação. Pesquise e inspecione todas as requisições, com as pontuações e o resultado em detalhe.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Status dos serviços</h3>
          <p class="mt-1 text-sm text-surface-500">Veja quais serviços estão no ar, com latência e taxas de erro em tempo real.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Relatórios de desempenho</h3>
          <p class="mt-1 text-sm text-surface-500">Entenda o volume e as tendências da sua moderação. Acompanhe as taxas de sinalização, as ações tomadas e os custos. Exportável para auditorias.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Políticas e integrações</h3>
          <p class="mt-1 text-sm text-surface-500">Gerencie as configurações de moderação e as conexões com as plataformas. Configure ações automáticas e limites pelo console.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Configuração</h3>
          <p class="mt-1 text-sm text-surface-500">Configurações da instância: limites de requisições, retenção de dados, e origens permitidas.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>