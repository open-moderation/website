---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { bookingUrl } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);
const BOOKING_URL = bookingUrl(locale);
const pageUrl = `https://www.openmoderation.com${L('/dsa-compliance')}`;

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": pageUrl,
  "url": pageUrl,
  "inLanguage": "pt",
  "name": "Conformidade com o DSA: auditoria e transparência",
  "description": "Cumpra as exigências do DSA e do Online Safety Act com o OpenModeration: trilhas de auditoria, relatórios de transparência e controle sobre os seus dados.",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const dsaExportExample = `{
  "period": {
    "from": "2026-01-01",
    "to": "2026-06-30"
  },
  "total_requests": 145230,
  "total_flagged": 12450,
  "by_category": [{
    "category": "hate",
    "count": 4200,
    "avg_score": 0.72
  }]
}`;
---

<BaseLayout title="Conformidade com o DSA: auditoria e transparência" description="Cumpra as exigências do DSA e do Online Safety Act com o OpenModeration: trilhas de auditoria, relatórios de transparência e controle sobre os seus dados." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Conformidade com o DSA" }]} />
<section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-700">
        <span class="flex items-center gap-1.5">
          
          Feito e hospedado na UE
        </span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Conformidade com o DSA</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Cumpra as suas obrigações regulatórias com uma plataforma de moderação transparente.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O DSA já se aplica a você</h2>
          <p class="mt-4 text-lg text-surface-500">
            O Regulamento dos Serviços Digitais da UE (DSA) entrou plenamente em vigor em 2024. Ele obriga
            os serviços que hospedam conteúdo de usuários na UE a agir diante de notificações de conteúdo ilegal, explicar
            cada decisão de moderação e permitir que os usuários a contestem.
            As multas podem chegar a <strong>6% do faturamento anual mundial</strong>.
          </p>
          <p class="mt-4 text-lg text-surface-500">
            O Online Safety Act do Reino Unido impõe obrigações semelhantes. As plataformas precisam <strong>provar</strong>
            que moderam, e as penalidades para quem não o faz são pesadas.
          </p>
          <div class="mt-8 rounded-lg border border-surface-200 bg-amber-50 p-4">
            <p class="text-sm text-amber-800">
              <strong>Atenção:</strong> equipes de moderação manual têm dificuldade para acompanhar as exigências do DSA.
              Para a maioria das plataformas, o caminho realista é a moderação automatizada com uma trilha de auditoria completa.
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Trilha de auditoria completa</h3>
                <p class="mt-1 text-sm text-surface-500">Cada ação de moderação é registrada com o conteúdo, as pontuações e a decisão. Você pode exportá-la para os relatórios de transparência do DSA.</p>
              </div>
            </div>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Soberania dos dados</h3>
                <p class="mt-1 text-sm text-surface-500">Os seus dados ficam hospedados na União Europeia e você pode exportá-los a qualquer momento, o que é importante para a conformidade com o RGPD. A implantação on-premise é possível sob consulta: <a href={BOOKING_URL} class="text-brand-600 hover:text-brand-500" target="_blank" rel="noopener">vamos conversar</a>.</p>
              </div>
            </div>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Cobertura multilíngue</h3>
                <p class="mt-1 text-sm text-surface-500">Modere comentários nos principais idiomas da UE. Os casos delicados são validados por outros modelos de IA antes de qualquer decisão ser aplicada.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Como o OpenModeration ajuda na conformidade com o DSA</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artigo 16: notificação e ação</h3>
          <p class="mt-2 text-sm text-surface-500">O conteúdo é sinalizado automaticamente e cada sinalização fica registrada na trilha de auditoria. Os usuários podem ser notificados quando o seu conteúdo é moderado.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artigo 15: relatórios de transparência</h3>
          <p class="mt-2 text-sm text-surface-500">Você pode exportar o total de itens moderados, as ações tomadas e a parcela de decisões revisadas por moderadores, que é o que os relatórios de transparência do DSA exigem.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artigo 17: exposição de motivos</h3>
           <p class="mt-2 text-sm text-surface-500">Cada decisão de moderação vem com um motivo por escrito, e o registro de auditoria indica se ela foi tomada automaticamente ou por um moderador.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artigo 20: sistema de reclamações</h3>
          <p class="mt-2 text-sm text-surface-500">Os casos limítrofes são revisados pela nossa equipe, e você vê cada decisão em tempo real e pode intervir quando quiser. Cada decisão fica registrada para auditoria.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artigo 34: avaliação de riscos</h3>
          <p class="mt-2 text-sm text-surface-500">As análises de uso e os dados de revisão ajudam a avaliar a eficácia da moderação e a identificar lacunas de cobertura.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Retenção de dados</h3>
          <p class="mt-2 text-sm text-surface-500">Você escolhe por quanto tempo manter os textos recebidos e os logs. O conteúdo sensível é armazenado criptografado.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-8">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <h2 class="text-2xl font-bold text-surface-900">Motivos por escrito tornam a conformidade comprovável</h2>
            <p class="mt-4 text-surface-600">
              Muitas ferramentas de moderação são caixas-pretas. Se você não consegue ver por que uma decisão foi tomada,
              fica difícil provar a um regulador que o seu sistema de moderação funciona.
            </p>
            <p class="mt-4 text-surface-600">
              Com o OpenModeration, cada decisão vem com um motivo por escrito e fica guardada em uma trilha
              de auditoria completa das ações da IA e humanas. A sua equipe de compliance pode verificar exatamente como o conteúdo
              é moderado, à luz das suas próprias regras.
            </p>
            <div class="mt-6 flex items-center gap-2 text-sm text-brand-700">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Nada escondido, e os seus dados podem ser exportados a qualquer momento.
            </div>
          </div>
          <div class="rounded-lg border border-brand-200 bg-white p-6">
            <h4 class="mb-2 text-sm font-semibold text-surface-900">Exportação dos dados relevantes para o DSA</h4>
            <CodeBlock code={dsaExportExample} lang="json" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber mais</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={L('/dsa-compliance/statement-of-reasons')} class="font-medium text-brand-600 hover:text-brand-500">A exposição de motivos (artigo 17): obrigações e um exemplo &rarr;</a></li>
        <li><a href={L('/dsa-compliance/notice-and-action')} class="font-medium text-brand-600 hover:text-brand-500">Denúncias de usuários segundo o artigo 16: o mecanismo de notificação e ação &rarr;</a></li>
        <li><a href={L('/blog/dsa-compliance-sme-guide')} class="font-medium text-brand-600 hover:text-brand-500">Guia prático do DSA para plataformas pequenas e médias &rarr;</a></li>
        <li><a href={L('/product/transparency')} class="font-medium text-brand-600 hover:text-brand-500">Cada comentário ocultado vem com um motivo por escrito &rarr;</a></li>
        <li><a href={L('/pricing')} class="font-medium text-brand-600 hover:text-brand-500">Comece grátis e mude de plano quando crescer &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>