---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com"+L('/integrations/wordpress'),
  "url": "https://www.openmoderation.com"+L('/integrations/wordpress'),
  "inLanguage": "pt",
  "name": "Moderação de comentários no WordPress com IA: aprovar, reter ou marcar como spam",
  "description": "Modere automaticamente os comentários do WordPress com IA. Conecte o seu site com uma senha de aplicativo (Application Password), sem plugin para desenvolver e sem código. Aprove, retenha ou marque como spam os comentários que violam as suas regras, com trilha de auditoria DSA incluída."
};

const faqItems = [
  {
    question: "Como funciona a moderação de comentários no WordPress?",
    answer: "Conecte o seu site WordPress com uma senha de aplicativo (Application Password). Os comentários são coletados automaticamente pela API REST do WordPress e analisados pelo nosso motor de IA. De acordo com as suas regras, cada comentário é aprovado, retido para revisão ou marcado como spam, sem necessidade de fila manual."
  },
  {
    question: "Preciso escrever código para configurar?",
    answer: "Não. Crie uma senha de aplicativo no painel do WordPress (Usuários → Perfil) e depois informe a URL do site, o nome de usuário e a senha no painel do OpenModeration. O seu site é verificado em segundos e a moderação começa."
  },
  {
    question: "Que tipos de conteúdo do WordPress podem ser moderados?",
    answer: "Posts e comentários do seu site WordPress. A plataforma detecta discurso de ódio, assédio, spam, conteúdo NSFW, dados pessoais, golpes e muito mais, e cada comentário é analisado no próprio idioma."
  },
  {
    question: "O que acontece com um comentário que viola as regras no meu site WordPress?",
    answer: "De acordo com as suas regras de moderação, o comentário é aprovado, retido para moderação ou marcado como spam diretamente pela API REST do WordPress. Cada ação fica registrada com a regra, as pontuações da IA e um motivo por escrito."
  },
  {
    question: "Quais permissões o meu usuário do WordPress precisa ter?",
    answer: "O seu usuário do WordPress precisa ter direitos de moderação de comentários, ou seja, a função de administrador ou de editor. O conector verifica isso quando você conecta o seu site."
  },
  {
    question: "Cada decisão de moderação fica registrada para as auditorias do DSA?",
    answer: "Sim. Cada comentário aprovado, retido ou marcado como spam guarda a regra, as pontuações da IA e o motivo por escrito em uma trilha de auditoria completa. Exporte-a com um clique para os relatórios de transparência do DSA."
  },
];
---

<BaseLayout title="Moderação de comentários no WordPress com IA" description="Modere os comentários do WordPress com IA. Conecte o site com uma senha de aplicativo, sem código. Aprove, retenha ou marque como spam, com auditoria DSA." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Integrações", href: L('/connectors') }, { label: "Moderação no WordPress" }]} />
  <section class="bg-gradient-to-b from-sky-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.026-.78-.07-1.11m-7.981.105c.647-.03 1.232-.105 1.232-.105.582-.075.514-.93-.067-.899 0 0-1.755.135-2.88.135-1.064 0-2.85-.15-2.85-.15-.585-.03-.661.855-.075.885 0 0 .54.061 1.125.09l1.68 4.605-2.37 7.08L5.354 6.9c.649-.03 1.234-.1 1.234-.1.585-.075.516-.93-.065-.896 0 0-1.746.138-2.874.138-.2 0-.438-.008-.69-.015C4.911 3.15 8.235 1.215 12 1.215c2.809 0 5.365 1.072 7.286 2.833-.046-.003-.091-.009-.141-.009-1.06 0-1.812.923-1.812 1.914 0 .89.513 1.643 1.06 2.531.411.72.89 1.643.89 2.977 0 .915-.354 1.994-.821 3.479l-1.075 3.585-3.9-11.61.001.014zM12 22.784c-1.059 0-2.081-.153-3.048-.437l3.237-9.406 3.315 9.087c.024.053.05.101.078.149-1.12.393-2.325.609-3.582.609M1.211 12c0-1.564.336-3.05.935-4.39L7.29 21.709C3.694 19.96 1.212 16.271 1.211 12M12 0C5.385 0 0 5.385 0 12s5.385 12 12 12 12-5.385 12-12S18.615 0 12 0"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderação de comentários no WordPress</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Proteja o seu site WordPress com moderação por IA. A conexão é feita com uma senha de aplicativo, e tudo fica pronto em minutos, sem código.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/pt/agendar-reuniao" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Agende uma reunião</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Experimente grátis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderação simples em 3 etapas</h2>
        <p class="mt-4 text-lg text-surface-500">O seu site fica protegido em minutos, sem precisar de uma equipe de engenharia.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Crie a sua conta</h3>
          <p class="mt-2 text-sm text-surface-500">Cadastre-se grátis no OpenModeration, sem cartão de crédito e sem compromisso. Os seus dados ficam hospedados na UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Conecte o seu site WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Crie uma senha de aplicativo no painel do WordPress e depois informe a URL do site, o nome de usuário e a senha. O seu site é verificado automaticamente. É preciso ter a função de administrador ou de editor.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Definimos as regras com você</h3>
          <p class="mt-2 text-sm text-surface-500">Definimos juntos as suas regras em linguagem natural. A IA aprova ou marca como spam os casos claros e a nossa equipe cuida dos casos duvidosos; você vê cada decisão e o seu motivo em tempo real.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O que você pode detectar</h2>
        <p class="mt-4 text-lg text-surface-500">Mais de 20 modelos de detecção prontos, treinados com bilhões de rótulos.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicidade</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discurso de ódio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Assédio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Golpes e phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dados pessoais</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Automutilação</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Palavrões</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentimento</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temas sensíveis</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Links de risco</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por que moderar o WordPress é simples com o OpenModeration</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sem código</h3>
          <p class="mt-2 text-sm text-surface-500">Configure tudo pelo painel. Gere uma senha de aplicativo, conecte o seu site e escreva as regras em linguagem natural. A IA faz o resto.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Suas credenciais, seu controle</h3>
          <p class="mt-2 text-sm text-surface-500">Conecte-se com a sua própria senha de aplicativo. As credenciais são criptografadas, nunca armazenadas em texto puro, e você pode revogar o acesso a qualquer momento pelo painel do WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aplicação automática no WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Cada comentário é aprovado, retido para revisão ou marcado como spam diretamente pela API REST do WordPress, sem necessidade de fila de moderação manual.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Multilíngue, incluindo os idiomas do seu público</h3>
          <p class="mt-2 text-sm text-surface-500">Cada comentário é analisado no próprio idioma. A nossa IA, verificada por outros modelos nos casos delicados, aplica as suas regras em todos os idiomas dos seus leitores.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Regras personalizadas em linguagem natural</h3>
          <p class="mt-2 text-sm text-surface-500">Escreva a sua política de moderação como a explicaria a um colega. Sem engenharia de prompt nem regex.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Explicado e hospedado na UE</h3>
          <p class="mt-2 text-sm text-surface-500">Cada decisão vem com um motivo por escrito. Os seus dados ficam hospedados na União Europeia e podem ser exportados a qualquer momento.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Perguntas frequentes sobre a moderação no WordPress" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
