---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com"+L('/integrations/instagram'),
  "url": "https://www.openmoderation.com"+L('/integrations/instagram'),
  "inLanguage": "pt",
  "name": "Moderação automática no Instagram: oculte comentários tóxicos sem código",
  "description": "Modere automaticamente os comentários do Instagram com IA. Regras sem código, ocultação automática de conteúdo tóxico, mais de 120 idiomas, trilha de auditoria DSA. Comece grátis, no ar em minutos."
};

const faqItems = [
  {
    question: "Como funciona a moderação de comentários no Instagram?",
    answer: "Conecte a sua conta do Instagram ao OpenModeration. Comentários e respostas são analisados automaticamente pela IA. Os comentários tóxicos são ocultados ou excluídos de acordo com as suas regras, sem nenhum trabalho manual."
  },
  {
    question: "É complicado de configurar?",
    answer: "Não. Você configura tudo pelo painel, sem escrever código. Conecte a sua conta do Instagram, escolha as suas regras de moderação e a plataforma faz o resto. Leva alguns minutos."
  },
  {
    question: "O que a moderação no Instagram detecta?",
    answer: "A plataforma detecta discurso de ódio, assédio, spam, conteúdo NSFW, dados pessoais, golpes, phishing, palavrões, automutilação e muito mais. Mais de 20 modelos de detecção prontos cobrem mais de 120 idiomas."
  },
  {
    question: "Preciso saber programar para usar o OpenModeration no Instagram?",
    answer: "Não. A plataforma foi pensada para usuários sem perfil técnico. As regras são definidas em linguagem natural e com botões de ativação. O painel é fácil de usar e não exige nenhum desenvolvimento."
  },
  {
    question: "É melhor do que a moderação nativa do Instagram?",
    answer: "Sim. Os filtros nativos do Instagram se limitam ao bloqueio por palavras-chave. O OpenModeration usa uma IA sensível ao contexto, que entende nuances, sarcasmo e o histórico da conversa. Você também conta com regras personalizadas, filas de revisão para a equipe e trilhas de auditoria completas."
  },
  {
    question: "Quanto custa a moderação automática no Instagram?",
    answer: "O plano gratuito cobre até 1.000 requisições por mês. O plano Pro começa em 99 €/mês para 10 mil requisições. Não há cobrança por usuário e você pode cancelar quando quiser."
  },
  {
    question: "Cada decisão fica registrada para auditorias?",
    answer: "Sim. Cada comentário ocultado automaticamente ou sinalizado guarda a regra, as pontuações da IA e o motivo por escrito. Exporte a trilha de auditoria completa com um clique para revisões de brand safety ou do DSA."
  },
];
---

<BaseLayout title="Moderação automática no Instagram com IA, sem código" description="Modere os comentários do Instagram com IA: regras sem código, ocultação automática do conteúdo tóxico, mais de 120 idiomas. Comece grátis, no ar em minutos." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Integrações", href: L('/connectors') }, { label: "Moderação no Instagram" }]} />
  <section class="bg-gradient-to-b from-pink-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-pink-100 text-pink-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderação de conteúdo no Instagram</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Mantenha os comentários tóxicos longe do seu perfil do Instagram. A moderação por IA leva poucos minutos para configurar e não exige código.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Experimente grátis</a>
        <a href={L('/how-it-works')} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Como funciona</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Uma moderação simples de usar</h2>
        <p class="mt-4 text-lg text-surface-500">Três etapas para um perfil do Instagram mais seguro.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Cadastre-se</h3>
          <p class="mt-2 text-sm text-surface-500">Crie uma conta gratuita no OpenModeration. Os seus dados ficam hospedados na UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Conecte o Instagram</h3>
          <p class="mt-2 text-sm text-surface-500">Vincule a sua conta do Instagram à plataforma em poucos cliques, com as suas próprias credenciais.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">No ar em minutos</h3>
          <p class="mt-2 text-sm text-surface-500">Defina as suas regras de moderação e deixe a IA proteger o seu perfil. Oculte, exclua ou sinalize conteúdo automaticamente.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Uma detecção que vai além das palavras-chave</h2>
        <p class="mt-4 text-lg text-surface-500">A IA lê o contexto e por isso capta nuances, sarcasmo e intenção.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicidade</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discurso de ódio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Assédio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Golpes e phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dados pessoais</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Automutilação</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Palavrões</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentimento</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temas sensíveis</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Links de risco</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por que é a ferramenta de moderação mais simples para o Instagram</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Configuração em minutos, zero código</h3>
          <p class="mt-2 text-sm text-surface-500">Você conecta a sua conta do Instagram pelo painel. Não precisa conhecer a API nem chamar um desenvolvedor.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">IA sensível ao contexto</h3>
          <p class="mt-2 text-sm text-surface-500">A IA acompanha a conversa. Como um moderador humano, ela julga a mesma frase de forma diferente conforme o que veio antes.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aplicação automática</h3>
          <p class="mt-2 text-sm text-surface-500">Oculte ou exclua automaticamente os comentários que violam as regras. O seu perfil do Instagram fica limpo sem que você precise intervir.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Mais de 120 idiomas</h3>
          <p class="mt-2 text-sm text-surface-500">O seu público escreve em muitos idiomas, e uma única plataforma modera todos eles com a mesma precisão.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Regras personalizadas em linguagem natural</h3>
          <p class="mt-2 text-sm text-surface-500">Escreva as regras como as explicaria a uma pessoa. A nossa IA entende as suas regras e as aplica de forma consistente.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Explicado e privado</h3>
          <p class="mt-2 text-sm text-surface-500">Cada decisão vem com um motivo por escrito e uma trilha de auditoria completa. Os seus dados ficam hospedados na União Europeia e podem ser exportados a qualquer momento.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Perguntas frequentes sobre a moderação no Instagram" />
    <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-violet-100 bg-violet-50 p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Guia</p>
      <a href={L('/blog/instagram-comment-moderation')} class="mt-1 block text-lg font-bold text-surface-900 hover:text-violet-700">Moderação de comentários no Instagram: o guia da moderação automática &rarr;</a>
    </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
