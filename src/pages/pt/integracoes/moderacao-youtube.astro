---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com"+L('/integrations/youtube'),
  "url": "https://www.openmoderation.com"+L('/integrations/youtube'),
  "inLanguage": "pt",
  "name": "Plataforma de moderação de comentários no YouTube | OpenModeration",
  "description": "Modere em escala os comentários do YouTube com IA. Cada comentário é publicado, retido para revisão ou rejeitado automaticamente, de acordo com as suas regras."
};

const faqItems = [
  {
    question: "Como funciona a moderação de comentários no YouTube?",
    answer: "Conecte o seu canal do YouTube via YouTube Data API. Os comentários são coletados e analisados pela IA. De acordo com as suas regras, cada comentário é publicado, retido para revisão ou rejeitado."
  },
  {
    question: "É fácil de configurar?",
    answer: "Sim. Toda a configuração é feita no painel. Conecte o seu canal do YouTube, configure as suas regras com botões de ativação e linguagem natural, e a moderação começa nos seus vídeos na hora."
  },
  {
    question: "O que a moderação no YouTube consegue detectar?",
    answer: "Discurso de ódio, assédio, spam, conteúdo NSFW, dados pessoais, golpes, phishing, palavrões, automutilação, sentimento, temas sensíveis e links de risco. Mais de 20 modelos, e cada comentário é analisado no próprio idioma."
  },
  {
    question: "Preciso de conhecimentos técnicos para usar?",
    answer: "Não. O OpenModeration foi pensado para criadores de conteúdo e community managers. Você escreve as regras em linguagem natural no painel, sem nenhum código."
  },
  {
    question: "Posso revisar os comentários sinalizados antes de removê-los?",
    answer: "Sim. Os casos limítrofes são tratados pela nossa equipe. Você vê cada decisão em tempo real e pode intervir quando quiser. Cada ação fica registrada."
  },
];
---

<BaseLayout title="Moderação de comentários no YouTube | OpenModeration" description="Modere os comentários do YouTube com IA: rejeite os tóxicos, retenha os limítrofes para revisão, no idioma de cada comentário. Para criadores e marcas." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Integrações", href: L('/connectors') }, { label: "Moderação no YouTube" }]} />
  <section class="bg-gradient-to-b from-red-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 text-red-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderação de comentários no YouTube</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Modere em escala os comentários do YouTube com IA. A configuração não exige código e leva minutos.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/pt/agendar-reuniao" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Agende uma reunião</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Experimente grátis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Comece a moderar em 3 etapas</h2>
        <p class="mt-4 text-lg text-surface-500">Você pode estar funcionando em minutos, sem nenhum desenvolvimento.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Crie a sua conta</h3>
          <p class="mt-2 text-sm text-surface-500">Cadastre-se grátis. Sem cartão de crédito. Os seus dados ficam hospedados na UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Conecte o YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Vincule o seu canal do YouTube com as suas próprias credenciais da Data API. O conector coleta os comentários automaticamente.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Definimos as regras com você</h3>
          <p class="mt-2 text-sm text-surface-500">Definimos juntos as suas regras em linguagem natural. A IA rejeita os comentários tóxicos e retém os casos duvidosos, que a nossa equipe revisa; você vê cada decisão e o seu motivo em tempo real.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O que a IA detecta nos seus comentários</h2>
        <p class="mt-4 text-lg text-surface-500">Mais de 20 modelos prontos, treinados com bilhões de rótulos de conteúdo.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicidade</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discurso de ódio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Assédio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Golpes e phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dados pessoais</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Automutilação</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Palavrões</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentimento</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temas sensíveis</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Links de risco</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por que moderar o YouTube é simples com o OpenModeration</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sem código</h3>
          <p class="mt-2 text-sm text-surface-500">Tudo é configurado pelo painel. Você não precisa desenvolver nada com a API nem pedir tempo à equipe de engenharia.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Ações nativas do YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Publique, retenha para revisão ou rejeite comentários diretamente pela YouTube Data API. Funciona como o YouTube Studio, só que automatizado.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Para qualquer volume</h3>
          <p class="mt-2 text-sm text-surface-500">O OpenModeration acompanha o seu canal, receba ele 100 ou 100.000 comentários por dia.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Multilíngue, incluindo os idiomas do seu público</h3>
          <p class="mt-2 text-sm text-surface-500">O seu público comenta em muitos idiomas, e uma única plataforma detecta a toxicidade em todos eles.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Regras personalizadas em linguagem natural</h3>
          <p class="mt-2 text-sm text-surface-500">Escreva a sua política de moderação em linguagem natural. A IA lê a intenção de um comentário, e não apenas as palavras.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Auditável e transparente</h3>
          <p class="mt-2 text-sm text-surface-500">Cada decisão de moderação fica registrada com o seu contexto. Os seus dados ficam hospedados na União Europeia e podem ser exportados a qualquer momento.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Perguntas frequentes sobre a moderação no YouTube" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
