---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com"+L('/integrations/facebook'),
  "url": "https://www.openmoderation.com"+L('/integrations/facebook'),
  "inLanguage": "pt",
  "name": "Moderação de comentários no Facebook: oculte comentários tóxicos sem código",
  "description": "Oculte automaticamente com IA os comentários tóxicos da sua Página do Facebook. Regras sem código, mais de 120 idiomas, ocultação/exclusão imediata via Graph API. Comece grátis, trilha de auditoria DSA incluída."
};

const faqItems = [
  {
    question: "Como funciona a moderação de comentários no Facebook?",
    answer: "Conecte a sua Página do Facebook via Graph API. Os comentários são coletados e analisados pela IA assim que chegam. De acordo com as suas regras, os comentários tóxicos são ocultados ou excluídos sem que ninguém precise revisá-los."
  },
  {
    question: "Preciso escrever código para configurar?",
    answer: "Não. Tudo é configurado no painel. Conecte a sua Página do Facebook, defina as suas regras de moderação em linguagem natural ou com botões de ativação, e a moderação começa em poucos minutos."
  },
  {
    question: "Que tipos de conteúdo do Facebook podem ser moderados?",
    answer: "Comentários, respostas e publicações da sua Página do Facebook. A plataforma detecta discurso de ódio, assédio, spam, conteúdo NSFW, dados pessoais, golpes e muito mais, em mais de 120 idiomas."
  },
  {
    question: "Quanto custa a moderação de comentários no Facebook?",
    answer: "A nuvem gerenciada tem um plano gratuito de até 1.000 requisições por mês e um plano Pro a 99 € por mês, sem taxas ocultas."
  },
  {
    question: "Quanto tempo leva a configuração?",
    answer: "Alguns minutos. Conecte a sua Página do Facebook e escreva as suas regras em linguagem natural. A moderação automática entra no ar no mesmo dia, sem código nem desenvolvedor."
  },
  {
    question: "Cada decisão de moderação fica registrada para as auditorias do DSA?",
    answer: "Sim. Cada comentário ocultado, excluído ou sinalizado guarda a regra, as pontuações da IA e o motivo por escrito em uma trilha de auditoria completa. Exporte-a com um clique para os relatórios de transparência do DSA."
  },
];
---

<BaseLayout title="Moderação de comentários no Facebook com IA, sem código" description="Oculte automaticamente comentários tóxicos no Facebook. Regras sem código, mais de 120 idiomas, ocultação via Graph API. Comece grátis, decisões explicadas." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Início", href: L('/') }, { label: "Integrações", href: L('/connectors') }, { label: "Moderação no Facebook" }]} />
  <section class="bg-gradient-to-b from-blue-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-blue-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderação de comentários no Facebook</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Modere com IA os comentários da sua Página do Facebook. A configuração leva minutos e não exige código.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Experimente grátis</a>
        <a href={L('/how-it-works')} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Como funciona</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderação simples em 3 etapas</h2>
        <p class="mt-4 text-lg text-surface-500">Você pode estar funcionando em minutos, sem uma equipe de engenharia.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Crie a sua conta</h3>
          <p class="mt-2 text-sm text-surface-500">Cadastre-se grátis no OpenModeration, sem cartão de crédito e sem compromisso. Os seus dados ficam hospedados na UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Conecte a sua Página do Facebook</h3>
          <p class="mt-2 text-sm text-surface-500">Vincule a sua Página do Facebook com as suas próprias credenciais. O conector coleta comentários e publicações automaticamente.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Defina as suas regras</h3>
          <p class="mt-2 text-sm text-surface-500">Escreva as suas regras de moderação em linguagem natural. A IA as aplica automaticamente e oculta, exclui ou sinaliza os comentários.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">O que você pode detectar</h2>
        <p class="mt-4 text-lg text-surface-500">Mais de 20 modelos de detecção prontos, treinados com bilhões de rótulos.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicidade</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discurso de ódio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Assédio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Golpes e phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dados pessoais</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Automutilação</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Palavrões</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentimento</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temas sensíveis</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Links de risco</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por que moderar o Facebook é simples com o OpenModeration</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sem código</h3>
          <p class="mt-2 text-sm text-surface-500">Tudo é configurado pelo painel. Conecte a sua Página, escreva as regras em linguagem natural e a IA as aplica.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Suas credenciais, seu controle</h3>
          <p class="mt-2 text-sm text-surface-500">Use o seu próprio token de acesso da Página do Facebook. Nunca armazenamos credenciais em texto puro, e você mantém a propriedade total.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aplicação automática no Facebook</h3>
          <p class="mt-2 text-sm text-surface-500">Oculte ou exclua os comentários que violam as regras diretamente via Facebook Graph API. Sem necessidade de fila de moderação manual.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Mais de 120 idiomas</h3>
          <p class="mt-2 text-sm text-surface-500">Modere comentários nos idiomas que a sua comunidade usa. O roteamento escolhe o melhor provedor de IA para cada idioma.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Regras personalizadas em linguagem natural</h3>
          <p class="mt-2 text-sm text-surface-500">Escreva a sua política de moderação como a explicaria a um colega. Sem engenharia de prompt nem regex.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Explicado e hospedado na UE</h3>
          <p class="mt-2 text-sm text-surface-500">Cada decisão vem com um motivo por escrito. Os seus dados ficam hospedados na União Europeia e podem ser exportados a qualquer momento.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Perguntas frequentes sobre a moderação no Facebook" />
    <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-violet-100 bg-violet-50 p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Guia</p>
      <a href={L('/blog/hide-facebook-comments-automatically')} class="mt-1 block text-lg font-bold text-surface-900 hover:text-violet-700">Como ocultar comentários do Facebook automaticamente &rarr;</a>
    </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
