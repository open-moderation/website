---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlossaryAutoLink from '../../../components/GlossaryAutoLink.astro';
import BlogArticleExtras from '../../../components/BlogArticleExtras.astro';
import CTASection from '../../../components/CTASection.astro';
import GuideComparisons from '../../../components/GuideComparisons.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Como ocultar comentários no Facebook automaticamente";
const description = "Como moderar e ocultar comentários de uma Página do Facebook: ocultar, excluir ou banir, os filtros nativos e os seus limites e como escolher uma ferramenta.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Como ocultar comentários no Facebook automaticamente: guia de moderação de comentários no Facebook",
  "description": description,
  "inLanguage": "pt",
  "datePublished": "2026-10-30",
  "dateModified": "2026-10-30",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/pt/blog/ocultar-comentarios-facebook-automaticamente" }
