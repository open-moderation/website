---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.openmoderation.com/pt/blog",
  "url": "https://www.openmoderation.com/pt/blog",
  "name": "Blog de moderação de conteúdo: DSA, IA e guias práticos",
  "description": "Artigos sobre moderação de conteúdo, conformidade com o DSA, segurança da IA e infraestrutura de moderação.",
  "inLanguage": "pt",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const posts = [
  {
    title: "Moderação de comentários no TikTok: filtros, regras e dicas",
    description: "Como moderar comentários no TikTok: filtros de comentários, palavras-chave filtradas, aprovação manual, moderadores da LIVE, os seus limites para marcas e um plano de crise.",
    href: localizePath("/blog/tiktok-comment-moderation", locale),
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guia"],
  },
  {
    title: "Moderação de redes sociais: o guia completo (2026)",
    description: "Como moderar redes sociais: métodos, regras, o que muda no Facebook, Instagram, YouTube, TikTok, LinkedIn e X, organização da equipe, crises, métricas e ferramentas.",
    href: localizePath("/blog/social-media-moderation-guide", locale),
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guia"],
  },
  {
    title: "Moderação de comentários no YouTube: ferramentas do Studio e limites",
    description: "Como moderar comentários no YouTube: retidos para revisão, palavras e links bloqueados, usuários aprovados e ocultos, moderadores, chat ao vivo e quando automatizar.",
    href: localizePath("/blog/youtube-comment-moderation", locale),
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guia"],
  },
  {
    title: "Como lidar com comentários negativos e trolls (guia 2026)",
    description: "Como lidar com comentários negativos e trolls: crítica ou ofensa, quando responder, ocultar, excluir ou banir, modelos de resposta, ataques em massa, crises e bem-estar da equipe.",
    href: localizePath("/blog/handle-negative-comments-trolls", locale),
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guia"],
  },
  {
    title: "O que é moderação de conteúdo? Definição e tipos",
    description: "O que significa moderação de conteúdo: o que é moderado, os 6 tipos, o trabalho do moderador de conteúdo, como funciona a moderação por IA, o DSA e como escolher uma abordagem.",
    href: localizePath("/blog/what-is-content-moderation", locale),
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guia"],
  },
  {
    title: "Moderação de comentários: o guia completo",
    description: "Como moderar comentários: os métodos comparados, o que as suas regras devem cobrir, zonas cinzentas, o DSA, como escolher uma ferramenta e 10 boas práticas.",
    href: localizePath("/blog/comment-moderation-guide", locale),
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guia", "comentários", "DSA"],
  },
  {
    title: "Como ocultar comentários no Facebook automaticamente",
    description: "Ocultar, excluir ou banir, os filtros nativos do Facebook e os seus limites, e como escolher uma ferramenta de moderação de comentários para o Facebook.",
    href: localizePath("/blog/hide-facebook-comments-automatically", locale),
    date: "2026-10-30",
    readTime: "8 min",
    tags: ["facebook", "guia"],
  },
  {
    title: "Moderação de comentários no Instagram: guia de moderação automática",
    description: "Palavras ocultas, Limites e Restringir, o que eles deixam passar, o que você precisa para conectar uma ferramenta e como configurar a moderação automática.",
    href: localizePath("/blog/instagram-comment-moderation", locale),
    date: "2026-10-30",
    readTime: "8 min",
    tags: ["instagram", "guia"],
  },
  {
    title: "OpenAI Moderation API: omni-moderation-latest, categorias, preço e limites",
    description: "O que a OpenAI Moderation API detecta, as 13 categorias, o formato da resposta, se ela é gratuita e o que fica para você construir.",
    href: localizePath("/blog/openai-moderation-api-guide", locale),
    date: "2026-10-20",
    readTime: "6 min",
    tags: ["openai", "API", "guia"],
  },
  {
    title: "Conformidade com o DSA para pequenas e médias plataformas: guia prático",
    description: "Um guia prático de conformidade com o Regulamento dos Serviços Digitais (DSA) para plataformas menores: moderação automatizada, trilhas de auditoria e passos concretos.",
    href: localizePath("/blog/dsa-compliance-sme-guide", locale),
    date: "2026-06-16",
    readTime: "8 min",
    tags: ["DSA", "conformidade", "guia"],
  },
  {
    title: "O custo de construir a moderação de conteúdo internamente: análise detalhada 2026",
    description: "Custo linha a linha de um sistema de moderação próprio em três anos: engenharia, manutenção, modelos de IA, infraestrutura e conformidade com o DSA.",
    href: localizePath("/blog/build-vs-buy-moderation", locale),
    date: "2026-06-14",
    readTime: "9 min",
    tags: ["comparativo", "construir ou comprar"],
  },
  {
    title: "Fim da Perspective API do Google: guia de migração para fóruns",
    description: "A Perspective API do Google será desativada no fim de 2026. Como migrar o seu fórum ou a sua comunidade antes do prazo.",
    href: localizePath("/blog/perspective-api-migration-guide", locale),
    date: "2026-06-12",
    readTime: "7 min",
    tags: ["perspective", "migração", "guia"],
  },
  {
    title: "OpenAI Moderation vs Azure vs Llama Guard: comparativo 2026",
    description: "Um comparativo imparcial dos principais provedores de moderação por IA: desempenho, preços, cobertura de idiomas e quando usar cada um.",
    href: localizePath("/blog/openai-vs-azure-vs-llama-guard-comparison", locale),
    date: "2026-06-10",
    readTime: "8 min",
    tags: ["comparativo", "provedores"],
  },
  {
    title: "Conformidade com o DSA na moderação de comentários, sem complicação",
    description: "Como cumprir as exigências do DSA na moderação de comentários: motivos por escrito, trilha de auditoria completa, relatórios de transparência e hospedagem na UE.",
    href: localizePath("/blog/dsa-compliance-open-source-moderation", locale),
    date: "2026-06-08",
    readTime: "6 min",
    tags: ["DSA", "conformidade", "transparência"],
  },
  {
    title: "Moderação de conteúdo para aplicações de IA: guia para desenvolvedores",
    description: "Como implementar a filtragem de entrada e de saída em aplicações com LLM. Boas práticas para prevenir prompt injection e garantir a segurança do conteúdo.",
    href: localizePath("/blog/ai-content-moderation-developer-guide", locale),
    date: "2026-06-05",
    readTime: "10 min",
    tags: ["IA", "LLM", "guia"],
  },
  {
    title: "Apresentando o OpenModeration: a plataforma de moderação unificada",
    description: "Estamos construindo uma plataforma de moderação: a nossa própria IA, com verificação por outros modelos, e um motivo por escrito para cada decisão.",
    href: localizePath("/blog/introducing-open-moderation", locale),
    date: "2026-06-01",
    readTime: "5 min",
    tags: ["anúncio"],
  },
];
---

<BaseLayout title="Blog de moderação de conteúdo: DSA, IA e guias práticos" description="Artigos e guias sobre moderação de conteúdo e de comentários, conformidade com o DSA, segurança da IA e infraestrutura de moderação para plataformas e marcas." jsonLd={blogJsonLd}>
<Breadcrumb items={[{ label: "Início", href: localizePath("/", locale) }, { label: "Blog" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Notas sobre moderação de conteúdo, segurança da IA, conformidade com o DSA e construção de infraestrutura de moderação.
      </p>
    </div>
  </section>

  <section class="bg-white pb-16 pt-4 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a href={post.href} class="group lift om-card flex min-w-0 flex-col bg-white md:first:col-span-2 lg:first:col-span-3 first:bg-gradient-to-br first:from-violet-50 first:via-white first:to-brand-50">
            <div class="flex items-center gap-3 text-xs text-surface-400">
              <time datetime={post.date}>{new Date(post.date + "T00:00:00").toLocaleDateString("pt-BR", { year: "numeric", month: "long", day: "numeric" })}</time>
              <span>&middot;</span>
              <span>{post.readTime} de leitura</span>
              <span>&middot;</span>
              {post.tags.map((tag) => (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-500">{tag}</span>
              ))}
            </div>
            <h2 class="mt-3 text-lg font-bold leading-snug text-surface-900 group-hover:text-brand-600 sm:text-xl">{post.title}</h2>
            <p class="mt-2 text-sm text-surface-500">{post.description}</p>
            <div class="mt-auto flex items-center gap-1 pt-4 text-sm font-medium text-brand-600">
              Ler mais
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
