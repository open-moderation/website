---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlossaryAutoLink from '../../../components/GlossaryAutoLink.astro';
import BlogArticleExtras from '../../../components/BlogArticleExtras.astro';
import CTASection from '../../../components/CTASection.astro';
import GuideComparisons from '../../../components/GuideComparisons.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "OpenAI Moderation API: omni-moderation-latest, categorias, preço e limites",
  "description": "Um guia prático da OpenAI Moderation API: o que o omni-moderation-latest detecta, as 13 categorias, o formato da resposta, se é gratuita e o que fica por sua conta.",
  "inLanguage": "pt",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/pt/blog/guia-api-openai-moderation" }
};

const categories = [
  { id: "harassment", desc: "Linguagem de assédio dirigida a qualquer alvo.", inputs: "Texto" },
  { id: "harassment/threatening", desc: "Assédio que também inclui violência ou dano grave contra qualquer alvo.", inputs: "Texto" },
  { id: "hate", desc: "Ódio baseado em raça, gênero, etnia, religião, nacionalidade, orientação sexual, deficiência ou casta. O conteúdo de ódio dirigido a grupos não protegidos conta como assédio.", inputs: "Texto" },
  { id: "hate/threatening", desc: "Conteúdo de ódio que também inclui violência ou dano grave contra o grupo visado.", inputs: "Texto" },
  { id: "illicit", desc: "Conselhos ou instruções sobre como cometer atos ilícitos.", inputs: "Texto" },
  { id: "illicit/violent", desc: "Conteúdo ilícito que também menciona violência ou a obtenção de uma arma.", inputs: "Texto" },
  { id: "self-harm", desc: "Conteúdo que promove, incentiva ou retrata atos de automutilação.", inputs: "Texto e imagens" },
  { id: "self-harm/intent", desc: "A pessoa diz que está se automutilando ou que pretende fazê-lo.", inputs: "Texto e imagens" },
  { id: "self-harm/instructions", desc: "Conteúdo que incentiva a automutilação ou dá instruções de como praticá-la.", inputs: "Texto e imagens" },
  { id: "sexual", desc: "Conteúdo feito para provocar excitação sexual ou que promove serviços sexuais (educação sexual e bem-estar excluídos).", inputs: "Texto e imagens" },
  { id: "sexual/minors", desc: "Conteúdo sexual que envolve uma pessoa com menos de 18 anos.", inputs: "Texto" },
  { id: "violence", desc: "Conteúdo que retrata morte, violência ou lesão física.", inputs: "Texto e imagens" },
  { id: "violence/graphic", desc: "Conteúdo que retrata morte, violência ou lesão física com detalhes gráficos.", inputs: "Texto e imagens" },
];

const curlExample = `curl https://api.openai.com/v1/moderations \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer \$OPENAI_API_KEY" \
  -d '{
    "model": "omni-moderation-latest",
    "input": "The comment you want to check"
  }'`;

const faqItems = [
  {
    question: "A OpenAI Moderation API é gratuita?",
    answer: "Sim. A OpenAI informa que o endpoint de moderação é de uso gratuito. As imagens enviadas podem ter até 20 MB.",
  },
  {
    question: "O que é o omni-moderation-latest?",
    answer: "O omni-moderation-latest é o modelo de moderação atual da OpenAI. Ele aceita entradas de texto e de imagem, mas não classifica áudio.",
  },
  {
    question: "Quais categorias a OpenAI Moderation API detecta?",
    answer: "Treze: harassment, harassment/threatening, hate, hate/threatening, illicit, illicit/violent, self-harm, self-harm/intent, self-harm/instructions, sexual, sexual/minors, violence e violence/graphic. Seis delas também se aplicam a imagens.",
  },
  {
    question: "O que a OpenAI Moderation API não faz?",
    answer: "Ela devolve scores e sinalizações, nada mais. Decidir o que ocultar, escrever as regras da sua comunidade, revisar os casos limítrofes, explicar cada decisão ao autor e manter uma trilha de auditoria para o DSA fica por sua conta. O OpenModeration cuida de tudo isso: a nossa própria IA de moderação, verificada por outros modelos de IA nos casos delicados, e a nossa equipe trata os casos duvidosos.",
  },
];
---

<BaseLayout title="OpenAI Moderation API (omni-moderation): categorias e preço" description="Como funciona a OpenAI Moderation API: o que o omni-moderation-latest detecta, as 13 categorias, a resposta, se é gratuita e o que fica por sua conta." ogType="article" jsonLd={articleJsonLd}>
<Breadcrumb items={[{ label: "Início", href: localizePath("/", locale) }, { label: "Blog", href: localizePath("/blog", locale) }, { label: "Guia da OpenAI Moderation API" }]} />
  <GlossaryAutoLink>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">20 de outubro de 2026</time>
        <span>&middot;</span>
        <span>6 min de leitura</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">OpenAI Moderation API: omni-moderation-latest, categorias, preço e limites</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        A OpenAI Moderation API diz se um texto ou uma imagem é potencialmente nocivo,
        e em qual categoria. Ela é gratuita, rápida de chamar e costuma ser o primeiro passo das equipes que precisam
        moderar conteúdo de usuários. Este guia resume o que ela detecta, o que devolve e o que
        fica para você construir.
      </p>

      <h2 class="text-xl font-bold text-surface-900">A resposta curta</h2>
      <ul>
        <li><strong>Modelo:</strong> <code>omni-moderation-latest</code>, que aceita entradas de texto e de imagem. Ele não classifica áudio.</li>
        <li><strong>Preço:</strong> gratuito. A OpenAI informa que "o endpoint de moderação é de uso gratuito", e os arquivos de imagem podem ter até 20 MB.</li>
        <li><strong>Saída:</strong> um booleano <code>flagged</code> e, para cada categoria, um booleano e um score de confiança entre 0 e 1.</li>
        <li><strong>Categorias:</strong> 13, seis das quais também se aplicam a imagens.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">Como chamar a API</h2>
      <p>
        Envie uma requisição POST para o endpoint <code>/v1/moderations</code> com o nome do modelo e a sua entrada.
      </p>
      <pre class="overflow-x-auto rounded-lg bg-ink-900 p-4 text-sm text-surface-100"><code set:text={curlExample} /></pre>
      <p>
        Você também pode ativar a moderação embutida pelo parâmetro <code>moderation</code> da
        Responses API. Nesse caso, o resultado traz seções separadas de <code>input</code> e
        <code>output</code>, e qualquer uma delas pode ser um objeto de erro em vez de scores.
      </p>

      <h2 class="text-xl font-bold text-surface-900">O que a resposta contém</h2>
      <ul>
        <li><code>flagged</code>: <code>true</code> se o modelo classificar o conteúdo como potencialmente nocivo, <code>false</code> caso contrário.</li>
        <li><code>categories</code>: um booleano por categoria, que indica se aquela categoria foi violada.</li>
        <li><code>category_scores</code>: um score de confiança por categoria, de 0 a 1. Quanto mais alto, maior a confiança.</li>
        <li><code>category_applied_input_types</code>: para cada categoria, a quais tipos de entrada (texto, imagem) o score se aplica.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">As 13 categorias</h2>
      <p>
        Quando você envia só uma imagem, as categorias exclusivas de texto devolvem score 0.
      </p>
    </div>

    <div class="mt-6 overflow-x-auto rounded-xl border border-surface-200">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="bg-surface-100">
            <th class="px-4 py-3 font-semibold text-surface-900">Categoria</th>
            <th class="px-4 py-3 font-semibold text-surface-900">O que cobre</th>
            <th class="px-4 py-3 font-semibold text-surface-900">Entradas</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-200 bg-white">
          {categories.map((c) => (
            <tr>
              <td class="px-4 py-3 font-mono text-xs text-surface-900">{c.id}</td>
              <td class="px-4 py-3 text-surface-600">{c.desc}</td>
              <td class="px-4 py-3 text-surface-500">{c.inputs}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Pontos de atenção</h2>
      <ul>
        <li>A OpenAI avisa que políticas personalizadas baseadas em <code>category_scores</code> podem precisar de recalibração ao longo do tempo, à medida que o modelo evolui.</li>
        <li>Os scores não vêm nos deltas parciais da saída transmitida em streaming quando você usa a moderação embutida.</li>
        <li>Nas chamadas de ferramentas, os argumentos e as saídas das ferramentas são moderados, mas os nomes, as descrições e os schemas das ferramentas não.</li>
        <li>Não envie à Moderation API material de abuso sexual infantil conhecido ou suspeito.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">O que a Moderation API deixa por sua conta</h2>
      <p>
        Um score não é uma decisão de moderação. Depois de recebê-lo, você ainda precisa decidir onde colocar
        o limite de cada categoria, o que fazer com os comentários que ficam no meio, como aplicar regras
        específicas da sua comunidade e como explicar cada remoção ao autor. Segundo o
        Regulamento dos Serviços Digitais (DSA), os serviços de hospedagem precisam apresentar uma exposição de motivos para cada remoção e
        dizer se foram usados meios automatizados.
      </p>
      <p>
        O OpenModeration traz essa camada que falta com a sua própria IA de moderação, verificada por outros modelos
        de IA nos casos delicados: regras escritas em linguagem natural, os casos duvidosos tratados pela nossa equipe,
        um console em que você vê cada decisão em tempo real e pode intervir quando quiser, um motivo por escrito para
        cada decisão e um log de auditoria completo. Quando sai um modelo de IA melhor ou mais barato, nós o conectamos
        rapidamente. Nada muda do seu lado.
      </p>
      <p class="text-sm text-surface-400">
        Fonte: <a href="https://developers.openai.com/api/docs/guides/moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">guia de moderação da OpenAI</a>, consultado em 20 de outubro de 2026.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="Perguntas frequentes" items={faqItems} />
    </div>
  </article>
  </GlossaryAutoLink>

  <BlogArticleExtras />

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Continue explorando</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath("/alternatives/openai-moderation", locale)} class="font-medium text-brand-600 hover:text-brand-500">OpenAI Moderation API vs OpenModeration &rarr;</a></li>
        <li><a href={localizePath("/blog/openai-vs-azure-vs-llama-guard-comparison", locale)} class="font-medium text-brand-600 hover:text-brand-500">OpenAI vs Azure vs Llama Guard: o comparativo &rarr;</a></li>
        <li><a href={localizePath("/content-moderation-api", locale)} class="font-medium text-brand-600 hover:text-brand-500">Uma API de moderação de conteúdo com motivo por escrito &rarr;</a></li>
        <li><a href={localizePath("/dsa-compliance", locale)} class="font-medium text-brand-600 hover:text-brand-500">O que o DSA exige das decisões de moderação &rarr;</a></li>
      </ul>
    </div>
  </section>

  <GuideComparisons />

  <CTASection />
</BaseLayout>
