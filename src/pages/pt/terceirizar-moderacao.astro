---
import SectorPage from '../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderação de conteúdo terceirizada: alternativa à agência"
  description="Procura uma agência ou um serviço de moderação terceirizada? Compare com moderação por IA e uma equipe dedicada: suas regras aplicadas 24/7, por muito menos."
  crumb="Moderação terceirizada"
  parent={null}
  eyebrow="Serviços de moderação"
  h1="Terceirize a sua moderação, sem o custo de uma agência"
  intro="Entregar seus comentários a uma agência de moderação custa caro e depende de pessoas que não conhecem a sua linha editorial. O OpenModeration combina uma IA que aplica as suas regras dia e noite com uma equipe que acompanha você: o conforto de um serviço terceirizado, por uma fração do preço."
  problem="Os serviços de moderação humana são cobrados por volume ou por tempo gasto, com atrasos à noite e nos fins de semana. Treinar moderadores externos nas suas regras leva tempo, e a qualidade varia de uma pessoa para outra."
  approach="Adaptamos a moderação às suas regras e aos seus casos de uso. A IA trata cada comentário em segundos, sempre da mesma forma. Os casos limítrofes, as denúncias e as contestações são tratados pela nossa equipe. Você vê tudo em tempo real e pode intervir quando quiser."
  result="Uma moderação mais rápida e mais consistente do que uma equipe externa, disponível 24/7, com um registro escrito de cada decisão e um custo previsível."
  featuresTitle="O que fazemos por você"
  featuresIntro="Você não está comprando uma ferramenta para configurar sozinho: implantamos a moderação com você e continuamos por perto."
  features={[
    { title: "Transformar suas regras em instruções", text: "Traduzimos as suas regras em instruções claras e as testamos nos seus comentários reais antes de ativá-las." },
    { title: "Acompanhamento e ajustes", text: "Revisamos os casos duvidosos com você e ajustamos as regras quando o seu público ou o noticiário muda." },
    { title: "Moderação 24/7", text: "À noite, nos fins de semana e nos picos de tráfego, os comentários são tratados em segundos." },
    { title: "Você mantém o controle", text: "As decisões sensíveis continuam humanas e ficam a cargo da nossa equipe. No console, você vê cada decisão e pode revertê-la a qualquer momento." },
  ]}
  why={[
    { title: "Muito mais barato", text: "A moderação automática com acompanhamento custa uma fração da moderação humana terceirizada." },
    { title: "Consistente e explicável", text: "A mesma regra gera a mesma decisão, sempre com uma explicação por escrito." },
    { title: "Conforme o DSA", text: "Exposição de motivos, denúncias de usuários e histórico completo, sem depender dos processos de um fornecedor." },
  ]}
  faq={[
    { question: "Isso pode substituir totalmente uma agência de moderação?", answer: "Para a maioria dos espaços de comentários, sim: a IA cuida da maior parte do volume e a nossa equipe trata os casos limítrofes. Você só conecta as suas páginas. Para volumes muito grandes ou temas muito sensíveis, o OpenModeration também pode trabalhar ao lado de uma equipe humana já existente." },
    { question: "Quem cuida da configuração?", answer: "Nós fazemos com você. Uma primeira reunião nos ajuda a entender suas regras, seus casos de uso e seus casos sensíveis; depois testamos as regras nos seus comentários." },
    { question: "Como comparo os custos?", answer: "Agende uma reunião com o seu volume mensal de comentários: enviaremos uma proposta com preços para você comparar com o seu fornecedor atual." },
    { question: "Os dados ficam na Europa?", answer: "Sim. O OpenModeration é desenvolvido e hospedado na União Europeia e está em conformidade com o RGPD." },
  ]}
  related={[
    { eyebrow: "Comparativo", title: "Compare alternativas de moderação", text: "Como o OpenModeration se compara a agências e a outras ferramentas de moderação.", href: localizePath('/alternatives', locale) },
    { eyebrow: "Análise", title: "Desenvolver ou comprar?", text: "O custo real de construir a moderação internamente.", href: localizePath('/build-vs-buy', locale) },
    { eyebrow: "Caso de uso", title: "Veículos de mídia", text: "Como as redações moderam seus comentários.", href: localizePath('/use-cases/news-publishers', locale) },
  ]}
  ctaTitle="Compare com o seu fornecedor atual."
  ctaSubtitle="Agende uma reunião com o seu volume de comentários: mostramos a moderação e enviamos uma proposta com preços."
/>
