---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const pageUrl = `https://www.openmoderation.com${localizePath('/how-it-works', locale)}`;

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": pageUrl,
  "url": pageUrl,
  "inLanguage": "pt",
  "name": "Como funciona a moderação de conteúdo com IA",
  "description": "Entenda o pipeline completo de moderação: coleta do conteúdo, moderação por IA validada por outros modelos, regras e ações automáticas e revisão manual dos casos.",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const facebookWebhookExample = `// O Facebook envia o comentário via webhook
{
  "source": "facebook",
  "content_id": "comment_123",
  "author_id": "user_456",
  "text": "Texto do comentário aqui...",
  "metadata": {"post_url": "..."}
}`;

const moderationResponseExample = `{
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const ruleConfigExample = `// Configure os seus limites de moderação
PUT /v1/settings

{
  "thresholds": {
    "hate":       { "accepted": 0.3, "rejected": 0.7 },
    "harassment": { "accepted": 0.3, "rejected": 0.7 },
    "sexual":     { "accepted": 0.2, "rejected": 0.8 },
    "violence":   { "accepted": 0.3, "rejected": 0.7 },
    "self-harm":  { "accepted": 0.2, "rejected": 0.8 },
    "spam":       { "accepted": 0.4, "rejected": 0.8 }
  },
  "actions": {
    "on_reject": ["hide", "flag_for_review"]
  }
}`;

const auditTrailExample = `// Trilha de auditoria completa para cada conteúdo
{
  "content_id": "...",
  "source": "webhook",
  "platform": "facebook",
  "status": "actioned",
  "moderation": {
    "flagged": true,
    "results": [...]
  },
  "actions": [{
    "rule": "Ocultar discurso de ódio",
    "type": "hide",
    "status": "executed"
  }]
}`;
---

<BaseLayout title="Como funciona a moderação de conteúdo com IA" description="Entenda o pipeline completo de moderação: coleta do conteúdo, moderação por IA validada por outros modelos, regras e ações automáticas e revisão manual dos casos." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Início", href: localizePath('/', locale) }, { label: "Como funciona" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Como funciona</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Um único pipeline leva cada comentário da coleta até a ação automática.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Visão geral do pipeline -->
      <div class="mb-20">
        <div class="relative rounded-2xl border border-surface-200 bg-surface-50 p-8">
          <div class="grid gap-6 grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-brand-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">1. Coleta</h3>
              <p class="mt-2 text-sm text-surface-500">O conteúdo chega via API, webhook ou conector de rede social.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">POST /v1/moderation</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Webhooks</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Facebook</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Instagram</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">YouTube</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-brand-400 bg-white p-6 text-center shadow-md">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">2. Moderação por IA</h3>
              <p class="mt-2 text-sm text-surface-500">A nossa IA de moderação analisa o conteúdo, outras IAs validam os casos delicados, e você recebe um resultado padronizado.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">IA da OpenModeration</span>
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">Arbitragem por outras IAs</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-surface-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">3. Regras e ações</h3>
              <p class="mt-2 text-sm text-surface-500">O motor de regras avalia os resultados e as ações são executadas automaticamente.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Ocultar</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Reter</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Publicar</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Webhook</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-surface-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">4. Revisão manual</h3>
              <p class="mt-2 text-sm text-surface-500">Os casos limítrofes são tratados pela nossa equipe, que os aprova ou rejeita.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Nossa equipe</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Aprovar</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Rejeitar</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Etapas em detalhe -->
      <div class="space-y-16">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Etapa 1</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">O conteúdo chega de qualquer lugar</h2>
            <p class="mt-4 text-surface-500">
              O conteúdo pode chegar por vários canais. Chame a API diretamente,
              configure webhooks para receber conteúdo de plataformas externas ou ative os conectores nativos
              de redes sociais, que trazem comentários e publicações automaticamente.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>API:</strong> POST /v1/moderation para moderação unitária ou em lote</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Webhooks:</strong> um endpoint genérico recebe e normaliza payloads externos</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Conectores:</strong> integração nativa com Facebook, Instagram, YouTube e WordPress</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Exemplo: comentário do Facebook</h4>
            <CodeBlock code={facebookWebhookExample} lang="json" />
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div class="lg:order-2">
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Etapa 2</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">A IA modera o conteúdo</h2>
            <p class="mt-4 text-surface-500">
              A nossa própria IA de moderação, configurada de acordo com as suas regras e os seus casos de uso, analisa cada item.
              Nos casos delicados, outros modelos de IA arbitram a decisão antes de ela ser aplicada. Os resultados são
              padronizados, com pontuações de 0.0 a 1.0 em 10 categorias de conteúdo.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Validação cruzada:</strong> outros modelos de IA arbitram os casos delicados</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Independente de modelo:</strong> modelos melhores ou mais baratos são conectados assim que surgem</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Saída padronizada:</strong> o mesmo formato, seja qual for o modelo nos bastidores</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 lg:order-1">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Resposta padronizada</h4>
            <CodeBlock code={moderationResponseExample} lang="json" />
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Etapa 3</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Uma moderação adaptada às suas regras</h2>
            <p class="mt-4 text-surface-500">
              Defina as suas regras de moderação com três ferramentas simples: <strong>palavras proibidas</strong> para bloqueio imediato, <strong>limites por categoria</strong> para decisões automáticas e <strong>as suas próprias regras</strong>, escritas em linguagem natural, para uma moderação por IA que leva o contexto em conta.
            </p>
            <div class="mt-6 space-y-3">
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>As palavras proibidas</strong> bloqueiam o conteúdo na hora, antes de qualquer chamada à IA, e por isso não custam nada</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Os limites por categoria</strong> disparam ações automáticas quando as pontuações ultrapassam os seus limites</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>As suas regras em linguagem natural</strong> orientam as decisões da IA de acordo com o contexto e dão o tom da sua plataforma</p>
              </div>
            </div>
          </div>
          <div>
            <BrowserFrame
              src="/images/rules.png"
              video="om-rules"
              alt="Configuração de regras do OpenModeration com palavras proibidas, limites por categoria e regras em linguagem natural"
              caption="Defina os seus limites uma vez e eles valem em todo lugar."
              eager={false}
            />
            <details class="mt-4 rounded-xl border border-surface-200 bg-surface-50 p-4">
              <summary class="cursor-pointer text-sm font-semibold text-surface-700">Para desenvolvedores: configuração via API</summary>
              <div class="mt-3">
                <CodeBlock code={ruleConfigExample} lang="json" />
              </div>
            </details>
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div class="lg:order-2">
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Etapa 4</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Casos limítrofes revisados pela nossa equipe</h2>
            <p class="mt-4 text-surface-500">
              A nossa equipe revisa o conteúdo sinalizado, trata as denúncias dos usuários e as contestações, e cada etapa continua auditável.
              Do seu lado, não há nada a fazer: você vê cada decisão em tempo real e pode intervir ou reverter quando quiser.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Aprove ou rejeite com um clique.</strong> Cada reversão fica registrada com quem decidiu e por quê.</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Acompanhe tudo no console de moderação e aprove ou rejeite você mesmo, se quiser</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Notificações por webhook para novos itens em revisão</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 lg:order-1">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Tudo fica registrado</h4>
            <CodeBlock code={auditTrailExample} lang="json" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Motor de ações -->
  <section id="action-engine" class="scroll-mt-24 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Action Engine</h2>
        <p class="mt-4 text-lg text-surface-500">Quando as suas regras são acionadas, o Action Engine aplica a sua decisão na própria plataforma, automaticamente. Cada ação fica registrada.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-100 text-red-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Ocultar automaticamente</h3>
          <p class="mt-1 text-sm text-surface-500">O conteúdo rejeitado é ocultado no Facebook e no Instagram e rejeitado no YouTube. A sua comunidade nunca chega a vê-lo.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Reter para revisão</h3>
          <p class="mt-1 text-sm text-surface-500">O conteúdo limítrofe fica retido até ser revisado pela nossa equipe. Nada é publicado e nada se perde.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-green-100 text-green-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Publicar e restaurar</h3>
          <p class="mt-1 text-sm text-surface-500">O conteúdo sem problemas é publicado normalmente. Quando um moderador aprova um comentário retido, ele é publicado.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Notificar as suas ferramentas</h3>
          <p class="mt-1 text-sm text-surface-500">Cada decisão pode chegar às suas próprias ferramentas via webhook, para fluxos de trabalho e integrações sob medida.</p>
        </div>
      </div>
      <div class="mx-auto mt-12 max-w-xl">
        <BrowserFrame
          src="/images/rules.png"
          video="om-rules"
          alt="Painel do OpenModeration: configuração de regras com limites por categoria e ações automáticas"
          caption="Defina os seus limites uma vez e eles valem em todas as plataformas conectadas."
        />
      </div>
      <div class="mt-10 text-center">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Experimente grátis
        </a>
        <p class="mt-3 text-sm text-surface-400">Sem cartão de crédito</p>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>