---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'pt';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "FAQ moderação de comentários: IA, equipe, DSA e preço",
  "description": "Quem modera, como a IA segue suas regras, teste com seus comentários, DSA, plataformas, dados e preço: respostas para veículos, marcas e órgãos públicos.",
  "crumb": "Perguntas frequentes",
  "h1": "Suas perguntas sobre moderação de comentários",
  "intro": "As perguntas que veículos, marcas e órgãos públicos mais nos fazem antes de escolher. Não encontrou a sua? Agende uma conversa e pergunte direto.",
  "buyerTitle": "Antes de escolher",
  "techTitle": "Para equipes técnicas",
  "techIntro": "Detalhes mais técnicos para seus desenvolvedores e sua equipe de TI.",
  "ctaTitle": "Ainda tem alguma dúvida?",
  "ctaSubtitle": "Agende uma conversa: respondemos às suas perguntas e mostramos o que nossa moderação faria com os seus próprios comentários.",
  "buyer": [
    {
      "question": "A IA modera sozinha?",
      "answer": "Não. Nossa IA é configurada com as suas regras e só decide sozinha quando tem certeza. Os casos delicados são conferidos por outros modelos de IA, e os duvidosos vão para a nossa equipe, que decide segundo as suas regras e presta contas a você. Você não precisa fazer nada, a não ser que queira intervir."
    },
    {
      "question": "Como a IA conhece a nossa linha editorial?",
      "answer": "Partimos das suas regras e casos de uso: o que você aceita, o que recusa, os casos-limite. Quando você corrige uma decisão, ajustamos as regras com você. Não é uma lista de palavras proibidas: a IA lê cada comentário no seu contexto."
    },
    {
      "question": "Podemos testar antes de assinar?",
      "answer": "Sim. No modo sandbox, a OpenModeration analisa seus comentários reais sem publicar nem ocultar nada. Você vê o que teríamos aceitado ou recusado, com o motivo, e compara com a sua moderação atual. Nada fica escondido."
    },
    {
      "question": "Podemos testar sem sair do nosso fornecedor atual?",
      "answer": "Sim. O teste roda em silêncio, em paralelo à sua moderação atual, sem mexer na sua produção. Você compara decisão por decisão e escolhe com conhecimento de causa, no momento que preferir."
    },
    {
      "question": "O que vemos do nosso lado?",
      "answer": "Tudo, em tempo real: cada comentário, a decisão tomada, o motivo por escrito e o histórico. Você pode corrigir qualquer decisão a qualquer momento pelo console."
    },
    {
      "question": "Por que um comentário foi recusado?",
      "answer": "Cada decisão traz um motivo por escrito (insulto, ataque pessoal, spam…), que você pode repassar ao autor. Fica mais claro para seus leitores e mais fácil de justificar em caso de contestação."
    },
    {
      "question": "A OpenModeration ajuda a cumprir o DSA?",
      "answer": "Ela foi pensada para o DSA: um motivo por escrito para cada decisão, um histórico rastreável, acompanhamento de denúncias e recursos, números exportáveis. Você continua sendo o editor responsável e tem como justificar cada decisão."
    },
    {
      "question": "O que acontece quando a IA fica em dúvida?",
      "answer": "O comentário fica separado e a nossa equipe o trata segundo as suas regras. Você recebe um relatório dos casos tratados e dos pontos das suas regras que vale a pena esclarecer."
    },
    {
      "question": "E à noite, no fim de semana ou nos picos?",
      "answer": "A IA modera dia e noite com as mesmas regras, seja qual for o volume, inclusive durante um jogo ou uma noite de eleição. Os comentários duvidosos ficam separados em vez de publicados, até que a nossa equipe os trate."
    },
    {
      "question": "Em quais plataformas a OpenModeration funciona?",
      "answer": "No seu site (pela nossa API ou WordPress), Facebook, Instagram e YouTube, com conectores prontos. TikTok, X, LinkedIn e outras redes são adicionados sob demanda, rapidamente. Nossa equipe conecta suas páginas com você."
    },
    {
      "question": "Quais idiomas são moderados?",
      "answer": "A OpenModeration é multilíngue: cada comentário é analisado no seu idioma, incluindo os idiomas do seu público. Diga quais importam para você e mostramos os resultados com os seus próprios comentários."
    },
    {
      "question": "Onde ficam hospedados os nossos dados?",
      "answer": "Na União Europeia, em conformidade com o RGPD. Seus comentários servem apenas para moderar os seus espaços."
    },
    {
      "question": "Precisamos mobilizar a nossa equipe técnica?",
      "answer": "Muito pouco. Para redes sociais e WordPress, basta conectar suas contas. Para um site ou uma ferramenta própria, uma API nos envia seus comentários e devolve cada decisão com o motivo. Nossa equipe cuida da implantação com você."
    },
    {
      "question": "Quanto custa?",
      "answer": "O preço depende do volume de comentários a moderar. Um plano gratuito permite experimentar; depois propomos um pacote previsível, dimensionado para os seus volumes, após um teste com os seus próprios comentários: você avalia a qualidade antes de falar de orçamento."
    }
  ],
  "tech": [
    {
      "question": "Existe uma API?",
      "answer": "Sim. Uma API REST recebe cada comentário e devolve a decisão, a categoria e o motivo por escrito. Webhooks avisam suas ferramentas a cada decisão, e as chaves de acesso são gerenciadas pelo console."
    },
    {
      "question": "Em qual IA a OpenModeration se baseia?",
      "answer": "Na nossa própria IA de moderação, desenvolvida internamente e treinada com milhões de mensagens ao longo de sete anos. Nos casos delicados, outros modelos de IA conferem a decisão antes de aplicá-la. Quando sai um modelo melhor, nós o conectamos, sem mudança do seu lado."
    },
    {
      "question": "Podemos adicionar categorias próprias?",
      "answer": "Sim. Além das categorias padrão (ódio, assédio, spam…), suas regras são escritas em linguagem comum: qualquer categoria específica da sua política pode ser adicionada. A IA as aplica levando em conta o contexto."
    },
    {
      "question": "E imagens ou vídeos?",
      "answer": "A versão atual se concentra em texto. A moderação de imagens e vídeos está no roadmap e vai aproveitar os modelos de IA multimodais à medida que evoluírem."
    },
    {
      "question": "Dá para instalar em nossos próprios servidores?",
      "answer": "Por padrão, a OpenModeration é hospedada na União Europeia e seus dados continuam exportáveis. A implantação on-premise é possível sob demanda: vamos conversar."
    }
  ]
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pt/perguntas-frequentes",
  "url": "https://www.openmoderation.com/pt/perguntas-frequentes",
  "name": "FAQ moderação de comentários: IA, equipe, DSA e preço",
  "description": "Quem modera, como a IA segue suas regras, teste com seus comentários, DSA, plataformas, dados e preço: respostas para veículos, marcas e órgãos públicos.",
  "inLanguage": "pt",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Início", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.intro}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={c.buyer} title={c.buyerTitle} />
    </div>
  </section>
  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mx-auto mb-6 max-w-3xl text-center text-sm text-surface-500">{c.techIntro}</p>
      <FAQ items={c.tech} title={c.techTitle} disableJsonLd />
    </div>
  </section>

  <CTASection title={c.ctaTitle} subtitle={c.ctaSubtitle} />
</BaseLayout>
