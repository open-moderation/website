---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import FAQ from '../../components/FAQ.astro';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Statement of reasons (DSA Article 17): who must provide one and what it must contain",
  "description": "What Article 17 of the Digital Services Act (DSA) requires for every content removal: who must provide a statement of reasons, when, with what information, and an example.",
  "inLanguage": "en",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/dsa-compliance/statement-of-reasons" }
};

const contents = [
  { letter: "a", title: "The measure taken", text: "Removal, disabling of access, demotion or restriction of visibility, suspension of monetary payments or another measure, and where relevant its territorial scope and duration." },
  { letter: "b", title: "The facts and circumstances", text: "What the decision relies on, including whether it follows a notice (Article 16) or a voluntary own-initiative investigation. The identity of the notifier is given only where strictly necessary." },
  { letter: "c", title: "The use of automated means", text: "Where applicable, the fact that the decision was taken using automated means, or concerns content detected or identified using such means." },
  { letter: "d", title: "The legal ground", text: "If the content is considered illegal: the legal ground relied on and explanations as to why the content is considered illegal on that ground." },
  { letter: "e", title: "The terms and conditions clause", text: "If the content is considered incompatible with your terms and conditions: the contractual ground relied on and explanations as to why the content is incompatible with it." },
  { letter: "f", title: "The possibilities for redress", text: "Clear and user-friendly information on the redress available: internal complaint handling, out-of-court dispute settlement, judicial redress." },
];

const faqItems = [
  {
    question: "What is a DSA statement of reasons?",
    answer: "It is the explanation that Article 17 of Regulation (EU) 2022/2065, the Digital Services Act, requires you to give a user whose content is removed, has access to it disabled, is demoted or has its visibility restricted, and also when an account, the service or monetary payments are suspended.",
  },
  {
    question: "Does a news site that moderates its comments have to comply?",
    answer: "Yes. As soon as it stores comments posted by its readers, it acts as a provider of hosting services for that content. Article 17 applies to all providers of hosting services, including small businesses.",
  },
  {
    question: "Do I need a statement of reasons for every removed comment?",
    answer: "Yes, for every restriction imposed because the content is illegal or incompatible with your terms and conditions, provided you know the author's electronic contact details. The obligation does not apply to deceptive high-volume commercial content, nor to orders from authorities under Article 9.",
  },
  {
    question: "Do statements of reasons have to be sent to the European Commission?",
    answer: "Providers of online platforms must submit their decisions and statements of reasons to the Commission, without undue delay, for inclusion in a publicly accessible database, without any personal data (Article 24(5)). Micro and small enterprises are exempted by Article 19, unless they are designated as very large online platforms.",
  },
  {
    question: "What are the penalties for non-compliance?",
    answer: "The DSA leaves penalties to the Member States, but caps fines for failing to comply with an obligation at 6% of the provider's annual worldwide turnover (Article 52).",
  },
];
---

<BaseLayout title="DSA Statement of Reasons (Article 17): Rules and Example" description="What Article 17 of the DSA requires for every content or comment removal: who must comply, when to inform the author, the six required elements and an example." ogType="article" jsonLd={articleJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "DSA compliance", href: "/dsa-compliance" }, { label: "Statement of reasons" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">October 20, 2026</time>
        <span>&middot;</span>
        <span>7 min read</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">The DSA statement of reasons: what Article 17 requires for every content removal</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        Since the Digital Services Act (DSA) started to apply, removing a comment is no longer enough:
        you have to tell its author why. Article 17 calls this explanation a "statement of reasons" and sets out its minimum
        content. Here is who is concerned, when it applies, what the statement must contain and what it can look like.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Who must provide a statement of reasons?</h2>
      <p>
        The obligation falls on <strong>providers of hosting services</strong>, meaning any service that stores
        information provided by its users: social networks, forums, marketplaces, but also news sites or blogs
        that host reader comments. Unlike some other DSA obligations, Article 17 contains no exemption for micro
        and small enterprises.
      </p>

      <h2 class="text-xl font-bold text-surface-900">In which cases?</h2>
      <p>
        A statement of reasons is owed to every user affected by a restriction imposed because their content is illegal
        or incompatible with your terms and conditions. The text covers four types of restrictions:
      </p>
      <ul>
        <li>any restriction of the visibility of content: removal, disabling of access or demotion;</li>
        <li>suspension, termination or other restriction of monetary payments;</li>
        <li>suspension or termination of the service, in whole or in part;</li>
        <li>suspension or termination of the user's account.</li>
      </ul>
      <p>
        The obligation applies where you know the user's electronic contact details, at the latest from the moment
        the restriction is imposed. It does not cover deceptive high-volume commercial content, nor
        orders from authorities under Article 9.
      </p>

      <h2 class="text-xl font-bold text-surface-900">The six required elements</h2>
      <p>Paragraph 3 of Article 17 lists the information the statement must contain at a minimum:</p>
    </div>

    <div class="mt-6 space-y-3">
      {contents.map((c) => (
        <div class="flex items-start gap-4 rounded-lg border border-surface-200 bg-surface-50 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-mono text-sm font-semibold text-brand-700">{c.letter}</span>
          <div>
            <p class="text-sm font-medium text-surface-900">{c.title}</p>
            <p class="mt-1 text-sm text-surface-500">{c.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <p>
        This information must be "clear and easily comprehensible", as precise and specific as reasonably possible, and
        allow the user to effectively exercise the possibilities for redress (paragraph 4).
      </p>

      <h2 class="text-xl font-bold text-surface-900">What about online platforms?</h2>
      <p>
        Providers of online platforms have one more obligation: to submit their decisions and statements of
        reasons to the European Commission, without undue delay, for inclusion in a publicly accessible database. These submissions
        must not contain any personal data (Article 24(5)). Micro and small enterprises are
        exempted by Article 19, unless they are designated as very large online platforms.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Example statement of reasons for a removed comment</h2>
      <p>Fictitious example, to adapt to your service and your terms and conditions:</p>
    </div>

    <div class="mt-6 rounded-xl border border-surface-200 bg-white p-6 text-sm leading-relaxed text-surface-700 shadow-sm">
      <p>Hello,</p>
      <p class="mt-3"><strong>Measure:</strong> your comment posted on October 14, 2026 under the article "…" has been removed. Your account is not affected.</p>
      <p class="mt-3"><strong>Reason:</strong> the comment contains an insult aimed at another reader, which breaches section 4 of our community guidelines ("Respect for other participants").</p>
      <p class="mt-3"><strong>How the decision was made:</strong> the comment was detected by an automated analysis tool, and the decision was then confirmed by a moderator.</p>
      <p class="mt-3"><strong>Your options for redress:</strong> if you believe this decision is unjustified, you can challenge it by replying to this message within six months. You can also turn to a certified out-of-court dispute settlement body or go to court.</p>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">How OpenModeration helps you produce your statements of reasons</h2>
      <ul>
        <li><strong>A written reason for every decision.</strong> Every rejected comment gets a written explanation, in the language of your choice, which serves as the basis for the ground (point e or d).</li>
        <li><strong>The role of automation, on record.</strong> The activity log shows whether the decision came from the AI or from a moderator, and which one (points b and c).</li>
        <li><strong>Data ready to send.</strong> The API and webhooks return the verdict, category and reason for every item: you can include them in the message sent to the author.</li>
        <li><strong>A complete history.</strong> Every decision, automated or human, stays in the audit trail for your reports and audits.</li>
      </ul>
      <p>
        Information on redress and the precise legal ground remain your responsibility: they depend on your
        service, your terms and conditions and the applicable law.
      </p>
      <p class="text-sm text-surface-400">
        Source: <a href="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022R2065" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Regulation (EU) 2022/2065 of October 19, 2022 on a Single Market For Digital Services</a>, OJ L 277, October 27, 2022, Articles 17, 19, 24 and 52. This page is for information only and does not constitute legal advice.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="Frequently asked questions" items={faqItems} />
    </div>
  </article>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Further reading</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/content-moderation-policy" class="font-medium text-brand-600 hover:text-brand-500">Content moderation policy: guide and template &rarr;</a></li>
        <li><a href="/dsa-compliance" class="font-medium text-brand-600 hover:text-brand-500">DSA compliance with OpenModeration &rarr;</a></li>
        <li><a href="/product/transparency" class="font-medium text-brand-600 hover:text-brand-500">Every decision explained in writing &rarr;</a></li>
        <li><a href="/use-cases/news-publishers" class="font-medium text-brand-600 hover:text-brand-500">Comment moderation for news publishers &rarr;</a></li>
        <li><a href="/blog/dsa-compliance-sme-guide" class="font-medium text-brand-600 hover:text-brand-500">The DSA for SMEs: a practical guide &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="A statement of reasons for every removed comment." subtitle="OpenModeration writes the reason for every decision and keeps track of who decided what. Free to start." />
</BaseLayout>
