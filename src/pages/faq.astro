---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const faqItems = [
  {
    question: "Do I need to know how to code to set up moderation rules?",
    answer: "No. OpenModeration uses three simple tools: forbidden words for instant blocking, category thresholds for automated decisions, and your own rules written in plain language. The Action Engine then applies them automatically, with no code required.",
  },
  {
    question: "Can I manually override an AI decision?",
    answer: "Yes. The moderation console provides a dedicated review queue for your Trust & Safety team. Human moderators can review flagged comments, see the AI's reasoning, and approve, reject or override decisions. Every action is logged for audit.",
  },
  {
    question: "Is there a free plan?",
    answer: "OpenModeration has a free plan, up to 1,000 requests a month, with no credit card required. The Pro plan costs €99 a month for 10K requests. See the pricing page for full details.",
  },
  {
    question: "How is this different from OpenAI Moderation API?",
    answer: "OpenAI Moderation API ties you to a single provider and shows little of how moderation works. OpenModeration works with several providers (OpenAI, Azure, HuggingFace, Mistral, custom LLMs) and supports bring-your-own-keys (BYOK). Every decision comes with a written reason, and it includes a review dashboard and an action engine for automated workflows.",
  },
  {
    question: "How is this different from Nima (Tremau)?",
    answer: "OpenModeration explains every decision in writing, keeps a full audit trail, lets you bring your own API keys and hosts your data in the European Union. On-premise deployment is possible on request.",
  },
  {
    question: "How is this different from Checkstep?",
    answer: "OpenModeration is API-first and works with several AI providers, with bring-your-own-keys. Every decision comes with a written reason, the data is hosted in the EU, and our team sets the moderation up with you, around your own rules.",
  },
  {
    question: "What does DSA-compliant mean?",
    answer: "OpenModeration keeps a complete audit trail of every moderation decision, with configurable data retention and exportable reports. This helps platforms meet the transparency and accountability requirements of the EU Digital Services Act (DSA).",
  },
  {
    question: "Can I use my own API keys?",
    answer: "Yes, BYOK (bring your own keys) is a core feature. You can configure API keys at three levels: global (shared across all workspaces), per-workspace (set by the admin for their organization), and per-API-key (overrides all other key settings).",
  },
  {
    question: "Can I deploy OpenModeration on my own infrastructure?",
    answer: "On-premise deployment is possible on request. Book a call with us to discuss your needs. By default, OpenModeration runs in our managed cloud, hosted in the European Union.",
  },
  {
    question: "Do you offer a managed cloud?",
    answer: "Yes, our managed cloud SaaS starts at €99/month. It includes 10K requests/month, no infrastructure to manage, platform-managed provider keys, EU-hosted infrastructure, priority support, and SLA. See the pricing page for full details.",
  },
  {
    question: "How long does it take to get operational value?",
    answer: "Minutes if you are using the REST API for basic moderation. A few hours to deploy the full platform with the dashboard, action engine, and connectors if you follow the quick-start guide. Your moderators can start reviewing comments right after.",
  },
  {
    question: "What providers are supported?",
    answer: "We support OpenAI (including GPT-4o), Azure OpenAI Service, HuggingFace inference endpoints, Mistral AI, and any OpenAI-compatible LLM provider (including Claude via Anthropic's API). Each provider can be configured with custom models and parameters.",
  },
  {
    question: "Can I add custom categories?",
    answer: "Yes, by using LLM-based moderation with custom prompts. Unlike traditional category-based classifiers, you can define arbitrary moderation categories through natural language prompts, letting you tailor moderation to your specific content policies.",
  },
  {
    question: "What about images/video?",
    answer: "The current release focuses on text moderation. Image and video moderation is on the roadmap and will use multi-modal LLM providers as they become available.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/faq",
      "url": "https://www.openmoderation.com/faq",
      "name": "Content Moderation FAQ: Pricing, Hosting & DSA",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.openmoderation.com/faq#faq",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer.replace(/&mdash;/g, '—')
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Content Moderation FAQ: Pricing, Hosting & DSA"
  description="Find answers to common questions about OpenModeration: pricing, hosting, BYOK, DSA compliance, supported providers, and integration."
  jsonLd={faqJsonLd}
>
<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "FAQ" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Frequently Asked Questions</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Answers to the questions we hear most about OpenModeration. If yours isn't here, <a href="https://calendly.com/jesuslogora/1h" class="text-brand-600 hover:text-brand-500" target="_blank" rel="noopener">let's talk</a>.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Try it for free
        </a>
        <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          See pricing
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">No credit card required</p>
    </div>
  </section>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} disableJsonLd />
    </div>
  </section>
</BaseLayout>