---
import { bookingUrl } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const faqItems = [
  {
    question: "Do I need to know how to code to set up moderation rules?",
    answer: "No. OpenModeration uses three simple tools: forbidden words for instant blocking, category thresholds for automated decisions, and your own rules written in plain language. The Action Engine then applies them automatically, with no code required.",
  },
  {
    question: "Can I manually override an AI decision?",
    answer: "Yes. Doubtful cases are handled by our team, so you have nothing to do. But you see every decision in real time in the console, with the AI's reasoning, and you can approve, reject or override it at any moment. Every action is logged for audit.",
  },
  {
    question: "Is there a free plan?",
    answer: "OpenModeration has a free plan, up to 1,000 requests a month, with no credit card required. The Pro plan costs €99 a month for 10K requests. See the pricing page for full details.",
  },
  {
    question: "How is this different from OpenAI Moderation API?",
    answer: "OpenAI Moderation API is a single classifier that shows little of how moderation works. OpenModeration runs its own moderation AI, set up on your rules and your use cases, and has delicate cases cross-checked by other AI models. Every decision comes with a written reason, doubtful cases are handled by our team, and you get a real-time dashboard and an action engine for automated workflows.",
  },
  {
    question: "How is this different from Nima (Tremau)?",
    answer: "OpenModeration explains every decision in writing, keeps a full audit trail, has delicate cases cross-checked by other AI models and hosts your data in the European Union. On-premise deployment is possible on request.",
  },
  {
    question: "How is this different from Checkstep?",
    answer: "OpenModeration is API-first and runs its own moderation AI, cross-checked by other AI models on delicate cases. Every decision comes with a written reason, the data is hosted in the EU, and our team sets the moderation up with you, around your own rules.",
  },
  {
    question: "What does DSA-compliant mean?",
    answer: "OpenModeration keeps a complete audit trail of every moderation decision, with configurable data retention and exportable reports. This helps platforms meet the transparency and accountability requirements of the EU Digital Services Act (DSA).",
  },
  {
    question: "Which AI does OpenModeration use?",
    answer: "OpenModeration runs its own moderation AI, trained for comment moderation and set up on your rules and your use cases. On delicate cases, other AI models arbitrate the decision before it is applied, which means fewer mistakes and fewer wrongly hidden comments.",
  },
  {
    question: "Can I deploy OpenModeration on my own infrastructure?",
    answer: "On-premise deployment is possible on request. Book a call with us to discuss your needs. By default, OpenModeration runs in our managed cloud, hosted in the European Union.",
  },
  {
    question: "Do you offer a managed cloud?",
    answer: "Yes, our managed cloud SaaS starts at €99/month. It includes 10K requests/month, no infrastructure to manage, AI models included, EU-hosted infrastructure, priority support, and SLA. See the pricing page for full details.",
  },
  {
    question: "How long does it take to get operational value?",
    answer: "Minutes if you are using the REST API for basic moderation. A few hours to deploy the full platform with the dashboard, action engine, and connectors if you follow the quick-start guide. Moderation then runs on its own, and you see every decision in real time.",
  },
  {
    question: "What happens when a better AI model comes out?",
    answer: "Our engine is model-agnostic. When a better or cheaper AI model comes out, our team plugs it in quickly, and nothing changes on your side. AI models get better every year, and you benefit from that progress instead of staying stuck on yesterday's model.",
  },
  {
    question: "Can I add custom categories?",
    answer: "Yes. Unlike traditional category-based classifiers, you can define arbitrary moderation categories through natural language prompts, letting you tailor moderation to your specific content policies.",
  },
  {
    question: "What about images/video?",
    answer: "The current release focuses on text moderation. Image and video moderation is on the roadmap and will use multi-modal AI models as they become available.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/faq",
      "url": "https://www.openmoderation.com/faq",
      "name": "Content Moderation FAQ: Pricing, Hosting & DSA",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.openmoderation.com/faq#faq",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer.replace(/&mdash;/g, '—')
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Content Moderation FAQ: Pricing, Hosting & DSA"
  description="Find answers to common questions about OpenModeration: pricing, hosting, DSA compliance, our AI engine, and integration."
  jsonLd={faqJsonLd}
>
<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "FAQ" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Frequently Asked Questions</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Answers to the questions we hear most about OpenModeration. If yours isn't here, <a href={bookingUrl('en')} class="text-brand-600 hover:text-brand-500" target="_blank" rel="noopener">let's talk</a>.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Try it for free
        </a>
        <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          See pricing
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">No credit card required</p>
    </div>
  </section>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} disableJsonLd />
    </div>
  </section>
</BaseLayout>