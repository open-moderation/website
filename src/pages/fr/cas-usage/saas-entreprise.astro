---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import { bookingUrl } from '../../../i18n/ui';

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Modération de contenu pour SaaS d'entreprise | OpenModeration",
  "description": "Répondez aux exigences de conformité des grands comptes avec une modération de contenu hébergée dans l'UE, qui explique chaque décision. Prête pour le DSA et SOC 2, avec journaux d'audit complets et console de gestion d'équipe.",
  "inLanguage": "fr"
};

---

<BaseLayout title="Modération de contenu entreprise, hébergée en UE et conforme DSA" description="Modération de contenu pour les SaaS B2B : hébergée dans l'UE, conforme au DSA, prête pour SOC 2, avec audit complet et souveraineté des données." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Cas d'usage", href: "/fr/cas-usage" }, { label: "SaaS d'entreprise" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Cas d'usage</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">La modération de contenu pour les SaaS d'entreprise</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">Répondez aux exigences de conformité les plus strictes des grands comptes avec une plateforme de modération par IA complète, hébergée dans l'UE, qui explique chaque décision.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Le problème</h3>
          <p class="mt-2 text-sm text-surface-600">Les plateformes SaaS B2B qui hébergent des contenus générés par leurs utilisateurs font face à des exigences strictes, de la part des régulateurs comme de leurs clients grands comptes. La modération manuelle n'est pas auditable, et les outils hébergés hors d'Europe compliquent la souveraineté des données.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">La réponse d'OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">Un dispositif de modération hébergé dans l'UE, mis en place avec vous. Vos règles de conformité s'appliquent automatiquement, notre équipe traite les cas douteux et les signalements, et votre équipe Trust &amp; Safety voit tout en temps réel dans une console dotée d'un journal d'audit complet.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Le résultat</h3>
          <p class="mt-2 text-sm text-surface-600">Vous abordez les appels d'offres grands comptes avec des preuves. Démontrez votre préparation au DSA et à SOC 2 grâce à des journaux inaltérables, conservez une souveraineté totale sur vos données et augmentez les volumes modérés sans transiger sur la sécurité.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">La conformité ne se négocie pas en entreprise</h2>
          <p class="mt-4 text-lg text-surface-500">Les grands comptes exigent une modération démontrable et auditable, et les régulateurs l'imposent. OpenModeration a été conçu dès l'origine pour répondre à ces exigences.</p>
          <div class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">UE</p>
              <p class="text-xs text-surface-500">Hébergement des données</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">100 %</p>
              <p class="text-xs text-surface-500">Des décisions journalisées et expliquées</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">&lt;300 ms</p>
              <p class="text-xs text-surface-500">Latence P50 par requête</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">10 000</p>
              <p class="text-xs text-surface-500">Contenus par requête batch</p>
            </div>
          </div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
              <h3 class="font-semibold text-surface-900">Console de modération</h3>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-700"><span class="flex h-1.5 w-1.5 rounded-full bg-accent-500"></span> Tous les services sont opérationnels</span>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Requêtes du jour</p>
                <p class="mt-1 text-xl font-bold text-surface-900">84,2 k</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Taux de signalement</p>
                <p class="mt-1 text-xl font-bold text-surface-900">4,7 %</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Latence P50</p>
                <p class="mt-1 text-xl font-bold text-surface-900">267 ms</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Exports d'audit</p>
                <p class="mt-1 text-xl font-bold text-surface-900">12</p>
              </div>
            </div>
            <div class="mt-4 rounded-lg border border-surface-200 bg-white">
              <div class="flex items-center justify-between border-b border-surface-200 px-4 py-2 text-xs font-semibold text-surface-500">
                <span>JOURNAL D'AUDIT</span>
                <span class="text-accent-600">Export DSA prêt</span>
              </div>
              <ul class="divide-y divide-surface-100 text-xs">
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXK4&hellip;</span>
                  <span class="text-surface-600">haine <strong class="text-surface-900">0,91</strong> &rarr; supprimé</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">IA OpenModeration</span>
                </li>
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXJ9&hellip;</span>
                  <span class="text-surface-600">harcèlement <strong class="text-surface-900">0,58</strong> &rarr; en revue</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">notre équipe</span>
                </li>
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXH2&hellip;</span>
                  <span class="text-surface-600">flagged: false</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">arbitrage IA</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
              <h3 class="font-semibold text-surface-900">Maîtrise de la conservation des données</h3>
              <p class="mt-2 text-sm text-surface-500">Vous choisissez une durée de conservation de 0, 7, 30 ou 90 jours. Les contenus sensibles sont stockés chiffrés et entièrement supprimés sur demande.</p>
            </div>
            <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
              <h3 class="font-semibold text-surface-900">Prêt pour SOC 2</h3>
              <p class="mt-2 text-sm text-surface-500">Journaux d'audit, contrôle des accès et chiffrement au repos comme en transit sont pensés pour les démarches de certification SOC 2.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 text-center">Questions fréquentes sur la modération en entreprise</h2>
        <div class="mt-8 divide-y divide-surface-200">
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Pouvons-nous faire tourner OpenModeration entièrement sur site, IA comprise ?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">C'est possible sur demande : <a href={bookingUrl('fr')} class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">parlons-en</a>. Nous étudions avec vous comment faire tourner les modèles d'IA dans votre périmètre, pour que rien n'ait besoin d'en sortir.</p>
          </details>
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Comment OpenModeration facilite-t-il les audits SOC 2 et DSA ?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Chaque décision de modération, qu'elle vienne de l'IA ou d'un humain, est journalisée avec le modèle utilisé, les scores, la règle déclenchée, l'action et l'horodatage. Les endpoints d'analytics fournissent les agrégats nécessaires aux rapports de transparence DSA, et les durées de conservation se configurent selon vos obligations.</p>
          </details>
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Comment gérer les accès entre équipes et entre clients ?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Les espaces de travail isolent les contenus et la configuration par équipe ou par client. Les administrateurs émettent des clés d'API à périmètre restreint, avec limites de débit, et la console gère les rôles et les permissions des membres de votre équipe qui veulent suivre les décisions ou intervenir.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Ressources associées</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/fr/blog/guide-dsa-pme" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guide</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Conformité DSA pour les petites et moyennes plateformes</h3>
          <p class="mt-2 text-sm text-surface-500">Les étapes concrètes pour que les plateformes SaaS répondent aux exigences du DSA en 2026.</p>
        </a>
        <a href="/fr/alternatives/azure-content-safety" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Comparatif</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">OpenModeration ou Azure AI Content Safety</h3>
          <p class="mt-2 text-sm text-surface-500">Pourquoi une plateforme complète, hébergée dans l'UE, l'emporte sur une simple API pour la conformité en entreprise.</p>
        </a>
        <a href="/fr/fonctionnalites" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Plateforme</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Découvrir toutes les fonctionnalités</h3>
          <p class="mt-2 text-sm text-surface-500">Le moteur d'actions, la gestion d'équipe et les workflows automatisés.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Remportez vos contrats grands comptes avec une modération démontrable."
    subtitle="Gardez vos données dans l'UE, exportez-les quand vous le voulez et abordez vos audits avec des journaux inaltérables. Parlez-nous ou essayez gratuitement."
    buttonText="Essayer gratuitement"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
