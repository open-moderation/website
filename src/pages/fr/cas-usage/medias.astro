---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import BrowserFrame from '../../../components/BrowserFrame.astro';
import ClientLogos from '../../../components/ClientLogos.astro';
import FAQ from '../../../components/FAQ.astro';

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Modération des commentaires pour les médias et les sites de presse",
  "description": "Modération des commentaires par IA pour les sites d'information et les rédactions : une modération adaptée à vos règles éditoriales et à vos cas d'usage sur chaque article, une explication écrite pour chaque commentaire supprimé, les cas douteux traités par notre équipe et un journal d'audit DSA.",
  "inLanguage": "fr",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const faqItems = [
  {
    question: "Les sites d'information doivent-ils respecter le DSA pour leurs espaces de commentaires ?",
    answer: "Les espaces de commentaires hébergent des contenus publiés par les lecteurs : un site d'information qui en propose agit donc comme un service d'hébergement au sens du règlement sur les services numériques (DSA). L'article 17 impose un exposé des motifs clair et spécifique chaque fois qu'un commentaire est supprimé ou restreint, en précisant notamment si des moyens automatisés ont été utilisés. OpenModeration rédige cet exposé des motifs pour chaque décision et le conserve dans le journal d'audit.",
  },
  {
    question: "Pouvons-nous modérer selon nos propres règles éditoriales ?",
    answer: "Oui. Vous rédigez vos règles en langage courant et OpenModeration les applique à chaque commentaire. La rubrique sport et la rubrique politique peuvent avoir des règles différentes, et vous pouvez durcir ou assouplir une règle à tout moment, sans code.",
  },
  {
    question: "Que deviennent les commentaires en zone grise ?",
    answer: "Chaque catégorie dispose de deux seuils. Les infractions manifestes sont masquées automatiquement, les commentaires clairement acceptables sont publiés, et tout ce qui se situe entre les deux est tranché par notre équipe. Votre rédaction n'a rien à faire, mais voit chaque décision en temps réel et peut intervenir quand elle veut.",
  },
  {
    question: "Les journalistes peuvent-ils continuer à modérer depuis la page de l'article ?",
    answer: "Oui. Les décisions prises par votre rédaction sont enregistrées dans le même historique d'activité que les décisions automatiques. Vous gardez ainsi un registre unique et complet de qui a décidé quoi, et pourquoi.",
  },
  {
    question: "Où les données sont-elles hébergées ?",
    answer: "OpenModeration est développé et hébergé dans l'Union européenne et conforme au RGPD. Un déploiement sur votre propre infrastructure est possible sur demande.",
  },
];
---

<BaseLayout title="Modération des commentaires pour les médias et la presse" description="Modérez les commentaires avec une IA qui suit vos règles éditoriales. Une explication écrite par suppression, les cas douteux traités par notre équipe." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Cas d'usage", href: "/fr/cas-usage" }, { label: "Médias" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Cas d'usage
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">La modération des commentaires pour les médias</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Les commentaires des lecteurs font vivre un article, jusqu'à ce que les insultes et le spam envahissent le fil. OpenModeration applique vos règles éditoriales à chaque commentaire, explique chaque suppression par écrit et notre équipe tranche les cas douteux. Votre rédaction voit tout et garde la main.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/fr/rendez-vous" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Prendre rendez-vous</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Essayer gratuitement</a>
      </div>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Le problème</h3>
          <p class="mt-2 text-sm text-surface-600">Un site d'information à forte audience reçoit des commentaires jour et nuit, avec des pics à chaque actualité chaude. Les journalistes ne peuvent pas tout lire, et les filtres de mots-clés passent à côté du sarcasme, des insultes codées et des attaques hors sujet, tout en bloquant des critiques légitimes.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">L'approche d'OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">Une IA attentive au contexte lit chaque commentaire à la lumière de vos règles. Les infractions manifestes sont masquées immédiatement, les commentaires acceptables sont publiés, et les cas limites sont traités par notre équipe, avec la règle en jeu et une explication écrite.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Le résultat</h3>
          <p class="mt-2 text-sm text-surface-600">Votre rédaction n'a plus à relire les commentaires : notre équipe s'occupe des cas qui demandent un jugement humain, et des signalements. Chaque décision, automatique ou éditoriale, est journalisée avec son motif, prête à répondre à la contestation d'un lecteur ou à la demande d'un régulateur.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pensé pour le fonctionnement des rédactions</h2>
          <p class="mt-4 text-lg text-surface-500">
            Modérer un espace de commentaires est une décision éditoriale. OpenModeration prend tout en charge, et votre rédaction garde la main : elle voit chaque décision en temps réel et peut intervenir quand elle veut.
          </p>
          <div class="mt-8 space-y-3">
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Vos règles, en langage courant</p>
              <p class="mt-1 text-xs text-surface-500">Rédigez les règles que vos lecteurs connaissent déjà. Aucune liste de mots-clés à entretenir, aucun code à modifier quand la ligne évolue.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Une zone grise réservée au jugement humain</p>
              <p class="mt-1 text-xs text-surface-500">Deux seuils par catégorie séparent ce qui est masqué automatiquement de ce que notre équipe examine. C'est vous qui fixez la largeur de la zone grise.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Un seul historique pour l'IA et la rédaction</p>
              <p class="mt-1 text-xs text-surface-500">Les suppressions faites par les journalistes figurent à côté des suppressions automatiques dans le journal d'activité, avec le modérateur concerné et le motif.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Commentaires d'articles et réseaux sociaux réunis</p>
              <p class="mt-1 text-xs text-surface-500">Modérez votre site via l'API ou le connecteur WordPress, et les commentaires sous vos publications Facebook, Instagram et YouTube depuis la même console.</p>
            </div>
          </div>
        </div>
        <BrowserFrame
          src="/images/dashboard.png"
          video="om-triage"
          alt="File de modération OpenModeration avec les commentaires des lecteurs, leur statut et l'action appliquée"
          caption="La file de modération : chaque commentaire avec son statut, la règle concernée et l'explication écrite."
        />
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pourquoi les médias choisissent OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Un exposé des motifs pour chaque suppression</h3>
          <p class="mt-2 text-sm text-surface-500">Le DSA impose aux services d'hébergement d'expliquer chaque suppression. OpenModeration rédige automatiquement cette explication : vos lecteurs savent quelle règle ils ont enfreinte.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Développé et hébergé dans l'UE</h3>
          <p class="mt-2 text-sm text-surface-500">Les données de vos lecteurs restent en Europe et la plateforme est conforme au RGPD. Un déploiement sur site est possible sur demande si votre service juridique l'exige.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Sans boîte noire</h3>
          <p class="mt-2 text-sm text-surface-500">Chaque décision est expliquée par écrit et consignée dans le journal d'audit. Quand un meilleur modèle d'IA sort, nous le branchons : rien ne change de votre côté.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Questions fréquentes" items={faqItems} />
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Ressources associées</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/fr/conformite-dsa" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Réglementation</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Conformité DSA</h3>
          <p class="mt-2 text-sm text-surface-500">Ce que le règlement sur les services numériques exige des sites qui hébergent des commentaires, et comment y répondre.</p>
        </a>
        <a href="/fr/produit/transparence" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Plateforme</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Chaque décision expliquée</h3>
          <p class="mt-2 text-sm text-surface-500">Comment OpenModeration rédige un motif pour chaque décision de modération.</p>
        </a>
        <a href="/fr/integrations/moderation-wordpress" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Intégration</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Modération des commentaires WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Modérez les commentaires d'un site d'information sous WordPress sans écrire de code.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection title="Rendez l'espace de commentaires à vos lecteurs." subtitle="Donnez-nous vos règles et connectez votre site : notre IA et notre équipe s'occupent du reste, votre rédaction voit chaque décision en temps réel." />
</BaseLayout>
