---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import KpiBand from '../../../components/KpiBand.astro';

const useCasesJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Cas d'usage de la modération de contenu | OpenModeration",
  "description": "Comment des plateformes de tous types utilisent OpenModeration : plateformes sociales, applications d'IA, marketplaces, jeux vidéo et SaaS d'entreprise.",
  "inLanguage": "fr"
};

const kpis = [
  { value: "10", label: "fournisseurs d'IA derrière une seule API" },
  { value: "300 ms", prefix: "<", label: "latence médiane (P50)" },
  { value: "10 000", label: "contenus par requête batch" },
  { value: "100 %", label: "open source (AGPL v3)" },
];

const useCases = [
  {
    title: "Médias et éditeurs de presse",
    tagline: "Commentaires d'articles, rédactions",
    description: "Adaptez la modération à vos règles éditoriales, expliquez chaque suppression par écrit et laissez votre rédaction trancher les cas limites.",
    href: "/fr/cas-usage/medias",
    iconPath: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
  },
  {
    title: "Plateformes sociales",
    tagline: "Forums, communautés, UGC",
    description: "Protégez votre communauté contre les discours de haine, le spam et les arnaques. Automatisez l'application de vos règles et laissez vos modérateurs se concentrer sur les cas limites.",
    href: "/fr/cas-usage/plateformes-sociales",
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Applications d'IA",
    tagline: "Filtrage des entrées et sorties de LLM",
    description: "Filtrez les prompts et les réponses du modèle dans un même dispositif. Combinez plusieurs fournisseurs pour multiplier les protections contre l'injection de prompts et les sorties nuisibles.",
    href: "/fr/cas-usage/applications-ia",
    iconPath: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Marketplaces",
    tagline: "Annonces, avis, petites annonces",
    description: "Modérez à grande échelle les fiches produits, les avis et les messages des vendeurs. Interceptez les arnaques et les articles interdits avant leur mise en ligne.",
    href: "/fr/cas-usage/marketplaces",
    iconPath: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z",
  },
  {
    title: "Jeux vidéo",
    tagline: "Chat, MMO, live ops",
    description: "Le chat est modéré en temps réel, dans plusieurs langues, en moins de 500 ms. Les infractions sont supprimées automatiquement avant que les autres joueurs ne les voient.",
    href: "/fr/cas-usage/jeux-video",
    iconPath: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "SaaS d'entreprise",
    tagline: "Conformité, SOC 2, audit",
    description: "Auto-hébergez la plateforme sur votre propre infrastructure, avec des journaux d'audit complets, la maîtrise de la conservation des données et une préparation DSA et SOC 2 démontrable.",
    href: "/fr/cas-usage/saas-entreprise",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
  {
    title: "Marques et retail",
    tagline: "Pages de marque, campagnes, avis clients",
    description: "Masquez le spam, les arnaques et les insultes sous vos publications, tout en laissant visibles les clients mécontents à qui répondre.",
    href: "/fr/cas-usage/marques-retail",
    iconPath: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z",
  },
  {
    title: "Luxe et mode",
    tagline: "Instagram, contrefaçons, multilingue",
    description: "Écartez contrefaçons, faux comptes et propos haineux de vos publications, dans toutes les langues de vos clients.",
    href: "/fr/cas-usage/luxe-mode",
    iconPath: "M5 3l3.057 4.583L12 3l3.943 4.583L19 3l2 7-9 11-9-11 2-7z",
  },
  {
    title: "Collectivités et institutions",
    tagline: "Concertations, participation citoyenne",
    description: "Modérez vos consultations et vos pages selon vos règles publiques, avec une explication écrite pour chaque décision.",
    href: "/fr/cas-usage/collectivites",
    iconPath: "M3 21h18M5 21V10m14 11V10M12 3l9 7H3l9-7zM9 21v-6h6v6",
  },
];
---

<BaseLayout title="Cas d'usage de la modération de contenu | OpenModeration" description="Plateformes sociales, applications d'IA, marketplaces, jeux vidéo et entreprises : comment elles modèrent leurs contenus avec OpenModeration, conforme au DSA." jsonLd={useCasesJsonLd}>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Cas d'usage" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
        <span class="flex h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        Cas d'usage
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Une seule plateforme de modération, pour tous les types de plateformes</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Que vous gériez un forum, une application de LLM, une marketplace ou un jeu, OpenModeration s'adapte à vos contenus, à vos règles et à votre infrastructure.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <KpiBand items={kpis} />
  </section>

  <section class="bg-white pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {useCases.map((useCase) => (
          <a href={useCase.href} class="group rounded-xl border border-surface-200 bg-surface-50 p-8 transition hover:border-brand-300 hover:shadow-md">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={useCase.iconPath}/></svg>
            </div>
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">{useCase.title}</h2>
            <p class="mt-1 text-xs font-medium uppercase tracking-wide text-surface-400">{useCase.tagline}</p>
            <p class="mt-3 text-sm text-surface-500">{useCase.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              En savoir plus
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
        <a href="/fr/fonctionnalites" class="group rounded-xl border-2 border-dashed border-surface-300 bg-white p-8 transition hover:border-brand-400">
          <div class="flex h-full flex-col items-start justify-center">
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">Découvrir toutes les fonctionnalités</h2>
            <p class="mt-3 text-sm text-surface-500">API unifiée, moteur d'actions, console de modération, connecteurs et journaux d'audit DSA.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Voir la plateforme
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Une même plateforme, des règles différentes</h2>
        <p class="mt-4 text-lg text-surface-500">Chaque cas d'usage s'appuie sur les mêmes briques. Seules les règles changent.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">1. Collecter les contenus</h3>
          <p class="mt-2 text-sm text-surface-500">API REST, endpoint batch pour traiter un historique, webhooks, ou connecteurs natifs pour Facebook, Instagram, YouTube et WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">2. Modérer par IA</h3>
          <p class="mt-2 text-sm text-surface-500">Chaque requête est orientée vers le fournisseur le plus adapté à sa langue, à son type de contenu et à votre budget. Le schéma de réponse reste toujours le même.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">3. Agir automatiquement</h3>
          <p class="mt-2 text-sm text-surface-500">Mots interdits, seuils par catégorie et règles en langage courant déclenchent les actions : masquer, supprimer, signaler ou envoyer en revue.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Ressources associées</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/fr/blog/guide-dsa-pme" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guide</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Conformité DSA pour les petites et moyennes plateformes</h3>
          <p class="mt-2 text-sm text-surface-500">Les étapes concrètes pour répondre aux exigences du DSA en 2026 avec des outils open source.</p>
        </a>
        <a href="/fr/blog/guide-moderation-contenu-ia-developpeurs" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guide</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">La modération de contenu pour les applications d'IA</h3>
          <p class="mt-2 text-sm text-surface-500">Les bonnes pratiques pour filtrer les entrées et les sorties des applications fondées sur des LLM.</p>
        </a>
        <a href="/fr/console-de-moderation" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Produit</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">La console de modération</h3>
          <p class="mt-2 text-sm text-surface-500">Files de modération, journaux d'audit, état des fournisseurs et statistiques d'utilisation.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Trouvez la bonne configuration en quelques minutes."
    subtitle="Choisissez votre cas d'usage, déployez avec Docker ou passez par le cloud managé, et modérez vos premiers contenus dès aujourd'hui."
    buttonText="Essayer gratuitement"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
