---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'fr';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "FAQ modération des commentaires : IA, équipe, DSA, prix",
  "description": "Qui modère, comment l’IA suit vos règles, test sur vos commentaires, DSA, plateformes, données et prix : nos réponses aux médias, marques et institutions.",
  "crumb": "FAQ",
  "h1": "Vos questions sur la modération des commentaires",
  "intro": "Les questions que nous posent le plus souvent les médias, les marques et les institutions avant de choisir. Vous ne trouvez pas la vôtre ? Prenez rendez-vous et posez-la-nous.",
  "buyerTitle": "Avant de choisir",
  "techTitle": "Pour les équipes techniques",
  "techIntro": "Des précisions plus techniques pour vos développeurs et votre DSI.",
  "ctaTitle": "Une question encore ?",
  "ctaSubtitle": "Prenez rendez-vous : nous répondons à vos questions et vous montrons ce que notre modération ferait sur vos propres commentaires.",
  "buyer": [
    {
      "question": "L’IA modère-t-elle seule ?",
      "answer": "Non. Notre IA est paramétrée sur vos règles et ne décide seule que lorsqu’elle est sûre. Les cas délicats sont recoupés par d’autres modèles d’IA, et les cas douteux partent à notre équipe, qui tranche selon vos règles et vous rend compte. Vous n’avez rien à faire, sauf si vous voulez intervenir."
    },
    {
      "question": "Comment l’IA connaît-elle notre ligne éditoriale ?",
      "answer": "Nous partons de votre charte et de vos cas d’usage : ce que vous acceptez, ce que vous refusez, les cas limites. Quand vous corrigez une décision, nous ajustons les règles avec vous. Ce n’est pas une liste de mots interdits : l’IA lit chaque commentaire dans son contexte."
    },
    {
      "question": "Peut-on tester avant de s’engager ?",
      "answer": "Oui. En bac à sable, OpenModeration analyse vos vrais commentaires sans rien publier ni masquer. Vous voyez ce que nous aurions accepté ou refusé, avec la raison, et vous comparez avec votre modération actuelle. Rien ne vous est caché."
    },
    {
      "question": "Peut-on tester sans quitter notre prestataire actuel ?",
      "answer": "Oui. Le test tourne en silence, en parallèle de votre modération actuelle, sans toucher à votre production. Vous comparez décision par décision, puis vous choisissez en connaissance de cause, au moment qui vous convient."
    },
    {
      "question": "Que voit-on de notre côté ?",
      "answer": "Tout, en temps réel : chaque commentaire, la décision prise, sa raison écrite et l’historique. Vous pouvez corriger une décision à tout moment depuis la console."
    },
    {
      "question": "Pourquoi un commentaire a-t-il été refusé ?",
      "answer": "Chaque décision porte une raison écrite (insulte, attaque personnelle, spam…), que vous pouvez transmettre à l’auteur. C’est plus clair pour vos lecteurs et plus simple à justifier en cas de contestation."
    },
    {
      "question": "OpenModeration aide-t-il à respecter le DSA ?",
      "answer": "Il est conçu pour le DSA : une raison écrite pour chaque décision, un historique traçable, le suivi des signalements et des contestations, des chiffres exportables. Vous restez l’éditeur responsable, et vous avez de quoi justifier chaque décision."
    },
    {
      "question": "Que se passe-t-il quand l’IA hésite ?",
      "answer": "Le commentaire est mis de côté et notre équipe le traite selon vos règles. Vous recevez un compte rendu des cas traités et des points à clarifier dans votre charte."
    },
    {
      "question": "Et la nuit, le week-end ou pendant les pics ?",
      "answer": "L’IA modère jour et nuit avec les mêmes règles, quel que soit le volume, y compris pendant un match ou une soirée électorale. Les commentaires douteux sont mis de côté plutôt que publiés, jusqu’à ce que notre équipe les ait traités."
    },
    {
      "question": "Sur quelles plateformes fonctionne OpenModeration ?",
      "answer": "Votre site (par notre API ou WordPress), Facebook, Instagram et YouTube, grâce à des connecteurs prêts à l’emploi. TikTok, X, LinkedIn et les autres réseaux sont ajoutés sur demande, rapidement. Notre équipe connecte vos pages avec vous."
    },
    {
      "question": "Quelles langues sont modérées ?",
      "answer": "OpenModeration est multilingue : chaque commentaire est analysé dans sa langue, y compris les langues de vos publics. Dites-nous lesquelles comptent pour vous, nous vous montrerons les résultats sur vos propres commentaires."
    },
    {
      "question": "Où sont hébergées nos données ?",
      "answer": "Dans l’Union européenne, dans le respect du RGPD. Vos commentaires ne servent qu’à la modération de vos espaces."
    },
    {
      "question": "Faut-il mobiliser notre équipe technique ?",
      "answer": "Très peu. Pour les réseaux sociaux et WordPress, il suffit de connecter vos comptes. Pour un site ou un outil maison, une API nous envoie vos commentaires et renvoie chaque décision avec sa raison. Notre équipe s’occupe de la mise en place avec vous."
    },
    {
      "question": "Combien ça coûte ?",
      "answer": "Le prix dépend du volume de commentaires à modérer. Une offre gratuite permet d’essayer ; nous vous proposons ensuite un forfait prévisible, dimensionné à vos volumes, après un test sur vos propres commentaires : vous jugez la qualité avant de parler budget."
    }
  ],
  "tech": [
    {
      "question": "Existe-t-il une API ?",
      "answer": "Oui. Une API REST reçoit chaque commentaire et renvoie la décision, la catégorie et la raison écrite. Des webhooks préviennent vos outils à chaque décision, et les clés d’accès se gèrent depuis la console."
    },
    {
      "question": "Sur quelle IA repose OpenModeration ?",
      "answer": "Sur notre propre IA de modération, développée en interne et entraînée sur des millions de messages depuis sept ans. Sur les cas délicats, d’autres modèles d’IA recoupent la décision avant qu’elle soit appliquée. Quand un meilleur modèle sort, nous le branchons, sans changement de votre côté."
    },
    {
      "question": "Peut-on ajouter des catégories sur mesure ?",
      "answer": "Oui. Au-delà des catégories standard (haine, harcèlement, spam…), vos règles sont rédigées en langage courant : toute catégorie propre à votre politique peut être ajoutée. L’IA les applique en tenant compte du contexte."
    },
    {
      "question": "Et les images ou la vidéo ?",
      "answer": "La version actuelle se concentre sur le texte. La modération des images et des vidéos figure sur la feuille de route et profitera des modèles d’IA multimodaux à mesure qu’ils progressent."
    },
    {
      "question": "Peut-on l’installer sur nos propres serveurs ?",
      "answer": "Par défaut, OpenModeration est hébergé dans l’Union européenne et vos données restent exportables. Un déploiement sur site est possible sur demande : parlons-en."
    }
  ]
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/fr/faq",
  "url": "https://www.openmoderation.com/fr/faq",
  "name": "FAQ modération des commentaires : IA, équipe, DSA, prix",
  "description": "Qui modère, comment l’IA suit vos règles, test sur vos commentaires, DSA, plateformes, données et prix : nos réponses aux médias, marques et institutions.",
  "inLanguage": "fr",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Accueil", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.intro}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={c.buyer} title={c.buyerTitle} />
    </div>
  </section>
  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mx-auto mb-6 max-w-3xl text-center text-sm text-surface-500">{c.techIntro}</p>
      <FAQ items={c.tech} title={c.techTitle} disableJsonLd />
    </div>
  </section>

  <CTASection title={c.ctaTitle} subtitle={c.ctaSubtitle} />
</BaseLayout>
