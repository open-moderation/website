const methods = [
  { name: "Pré-modération", how: "Chaque commentaire est relu avant d'être publié.", speed: "Lente : la publication attend un modérateur", cost: "Élevé", risk: "Faible pour l'illicite, fort pour la conversation", scale: "Mauvais" },
  { name: "Post-modération", how: "Le commentaire est publié, puis relu par un modérateur.", speed: "Immédiate", cost: "Élevé", risk: "Moyen : un contenu illicite reste visible jusqu'à la relecture", scale: "Moyen" },
  { name: "Modération réactive", how: "On n'intervient que sur les signalements des utilisateurs.", speed: "Immédiate", cost: "Faible", risk: "Fort : rien n'est vu tant que personne ne signale", scale: "Bon, mais subi" },
  { name: "Filtres automatiques", how: "Listes de mots interdits, liens, règles fixes.", speed: "Immédiate", cost: "Faible", risk: "Fort : faux positifs sur les critiques, ironie et insultes codées qui passent", scale: "Bon" },
  { name: "Hybride IA + humain", how: "Une IA applique vos règles, les cas douteux vont à une équipe.", speed: "Quelques secondes", cost: "Modéré", risk: "Faible si les règles et les seuils sont bien réglés", scale: "Très bon" },
];

const actions = [
  { action: "Masquer", what: "Le commentaire n'est plus visible du public. Sur Facebook, son auteur et ses amis peuvent encore le voir.", when: "Insultes, spam, hors sujet agressif : le cas courant, réversible." },
  { action: "Supprimer ou rejeter", what: "Le commentaire est retiré définitivement (ou refusé avant publication).", when: "Contenus manifestement illicites, arnaques, données personnelles d'un tiers." },
  { action: "Bannir ou restreindre", what: "L'auteur ne peut plus commenter, pour une durée limitée ou définitivement.", when: "Récidive, harcèlement ciblé, comptes de spam, raids coordonnés." },
];

const faqItems = [
  {
    question: "Qu'est-ce que la modération des commentaires ?",
    answer: "C'est l'ensemble des règles et des actions qui décident quels commentaires restent visibles sous vos articles, vos vidéos et vos publications : publier, masquer, supprimer, envoyer en revue ou restreindre un auteur, puis expliquer la décision.",
  },
  {
    question: "Comment modérer les commentaires efficacement ?",
    answer: "Écrivez des règles claires avec des exemples, automatisez les cas évidents, envoyez les cas douteux à un humain, expliquez chaque décision à son auteur, gardez une trace de tout et relisez régulièrement vos règles à partir des erreurs constatées.",
  },
  {
    question: "Vaut-il mieux masquer ou supprimer un commentaire ?",
    answer: "Masquer est le choix par défaut : c'est réversible et cela suffit à protéger la conversation. La suppression se réserve aux contenus manifestement illicites ou dangereux. Dans tous les cas, conservez une trace de la décision et de son motif.",
  },
  {
    question: "Le DSA s'applique-t-il aux commentaires d'un site ?",
    answer: "Oui, dès lors que vous hébergez des contenus publiés par vos utilisateurs, comme des commentaires : vous agissez alors comme un service d'hébergement au sens du DSA. Les obligations exactes dépendent de la nature et de la taille de votre service. Ce n'est pas un avis juridique.",
  },
  {
    question: "Peut-on modérer les commentaires automatiquement ?",
    answer: "Oui. Une IA peut lire chaque commentaire dans son contexte, appliquer vos règles en quelques secondes et masquer ce qui les enfreint. Les cas douteux doivent rester tranchés par un humain, et l'auteur doit savoir si des moyens automatisés ont été utilisés.",
  },
  {
    question: "Faut-il supprimer les commentaires négatifs ?",
    answer: "Non. Une critique, même dure, envers votre marque, votre rédaction ou un produit n'est pas un motif de retrait. Supprimer les avis négatifs abîme la confiance plus sûrement que le commentaire lui-même. Ce qui se retire, c'est l'insulte, la haine, la menace, le spam ou l'illicite.",
  },
  {
    question: "Quel outil de modération des commentaires choisir ?",
    answer: "Un outil qui se connecte à toutes vos plateformes, applique vos propres règles et pas une grille générique, envoie les cas douteux à une file de revue unique, explique chaque décision par écrit, garde un journal d'audit et héberge les données dans l'UE si vous êtes soumis au RGPD.",
  },
  {
    question: "Combien coûte la modération des commentaires ?",
    answer: "Une équipe interne ou une agence se paie au temps passé ou au volume. Un outil automatique coûte une fraction de ce prix. OpenModeration propose une offre gratuite pour démarrer, une offre Pro, et une proposition sur mesure pour les gros volumes.",
