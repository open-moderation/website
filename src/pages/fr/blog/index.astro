---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.openmoderation.com/fr/blog",
  "url": "https://www.openmoderation.com/fr/blog",
  "name": "Blog modération de contenu : DSA, sécurité de l'IA et guides techniques",
  "description": "Articles sur la modération de contenu, la conformité DSA, la sécurité de l'IA et l'infrastructure open source.",
  "inLanguage": "fr",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const posts = [
  {
    title: "Modération des commentaires : le guide complet",
    description: "Méthodes comparées, règles à écrire, zones grises, DSA, choix d'un outil de modération et 10 bonnes pratiques.",
    href: "/fr/blog/moderation-des-commentaires-guide",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guide", "commentaires", "DSA"],
  },
  {
    title: "Masquer les commentaires Facebook automatiquement",
    description: "Masquer, supprimer ou bannir, les outils intégrés de Facebook et leurs limites, et comment choisir un outil de modération.",
    href: "/fr/blog/masquer-commentaires-facebook-automatiquement",
    date: "2026-10-30",
    readTime: "9 min",
    tags: ["facebook", "guide"],
  },
  {
    title: "Modération des commentaires Instagram : le guide",
    description: "Mots masqués, limites, restriction, ce qu'il faut pour connecter un outil et mettre en place la modération automatique.",
    href: "/fr/blog/moderation-commentaires-instagram",
    date: "2026-10-30",
    readTime: "8 min",
    tags: ["instagram", "guide"],
  },
  {
    title: "API OpenAI Moderation : omni-moderation-latest, catégories, prix et limites",
    description: "Ce que détecte l'API OpenAI Moderation, les 13 catégories, le format de réponse, sa gratuité et ce qu'il vous reste à construire.",
    href: "/fr/blog/guide-api-openai-moderation",
    date: "2026-10-20",
    readTime: "6 min",
    tags: ["openai", "API", "guide"],
  },
  {
    title: "Conformité DSA pour les petites et moyennes plateformes : guide pratique",
    description: "Comment les petites et moyennes plateformes peuvent respecter les obligations du DSA avec des outils open source. Les étapes concrètes de la mise en conformité.",
    href: "/fr/blog/guide-dsa-pme",
    date: "2026-06-16",
    readTime: "8 min",
    tags: ["DSA", "conformité", "guide"],
  },
  {
    title: "Construire ou acheter : le coût d'une infrastructure de modération en 2026",
    description: "Le vrai coût d'une modération développée en interne face à OpenModeration. Temps d'ingénierie, maintenance et coûts cachés passés au crible.",
    href: "/fr/blog/moderation-construire-ou-acheter",
    date: "2026-06-14",
    readTime: "9 min",
    tags: ["comparatif", "construire-ou-acheter"],
  },
  {
    title: "Fin de Google Perspective API : guide de migration pour les forums",
    description: "Google arrête Perspective API fin 2026. Comment migrer votre forum ou votre communauté vers une alternative open source.",
    href: "/fr/blog/migration-perspective-api",
    date: "2026-06-12",
    readTime: "7 min",
    tags: ["perspective", "migration", "guide"],
  },
  {
    title: "OpenAI Moderation, Azure ou Llama Guard : le comparatif 2026",
    description: "Un comparatif objectif des principaux fournisseurs de modération par IA : performances, prix, couverture linguistique et cas d'usage de chacun.",
    href: "/fr/blog/comparatif-openai-azure-llama-guard",
    date: "2026-06-10",
    readTime: "8 min",
    tags: ["comparatif", "fournisseurs"],
  },
  {
    title: "La conformité DSA simplifiée grâce à la modération open source",
    description: "Comment respecter le règlement européen sur les services numériques avec des outils open source : journal d'audit, rapports de transparence et souveraineté des données.",
    href: "/fr/blog/conformite-dsa-moderation-open-source",
    date: "2026-06-08",
    readTime: "6 min",
    tags: ["DSA", "conformité", "open source"],
  },
  {
    title: "Modération de contenu pour les applications d'IA : le guide du développeur",
    description: "Comment filtrer les entrées et les sorties d'une application basée sur un LLM. Bonnes pratiques contre l'injection de prompt et pour la sécurité des contenus.",
    href: "/fr/blog/guide-moderation-contenu-ia-developpeurs",
    date: "2026-06-05",
    readTime: "10 min",
    tags: ["IA", "LLM", "guide"],
  },
  {
    title: "Présentation d'OpenModeration, la plateforme de modération unifiée",
    description: "Nous construisons la couche d'infrastructure open source de la modération de contenu. Une seule API, tous les fournisseurs, un contrôle total.",
    href: "/fr/blog/presentation-openmoderation",
    date: "2026-06-01",
    readTime: "5 min",
    tags: ["annonce", "open source"],
  },
];
---

<BaseLayout title="Blog modération de contenu | DSA, IA et guides techniques" description="Articles sur la modération de contenu, la conformité DSA, la sécurité de l'IA et l'infrastructure de modération open source." jsonLd={blogJsonLd}>
<Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Blog" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Nos réflexions sur la modération de contenu, la sécurité de l'IA, la conformité DSA et la construction d'une infrastructure open source.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8">
        {posts.map((post) => (
          <a href={post.href} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
            <div class="flex items-center gap-3 text-xs text-surface-400">
              <time datetime={post.date}>{new Date(post.date + "T00:00:00").toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" })}</time>
              <span>&middot;</span>
              <span>{post.readTime} de lecture</span>
              <span>&middot;</span>
              {post.tags.map((tag) => (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-500">{tag}</span>
              ))}
            </div>
            <h2 class="mt-3 text-xl font-bold text-surface-900 group-hover:text-brand-600">{post.title}</h2>
            <p class="mt-2 text-sm text-surface-500">{post.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-medium text-brand-600">
              Lire l'article
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
