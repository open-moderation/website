---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQ from '../../../components/FAQ.astro';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "API OpenAI Moderation : omni-moderation-latest, catégories, prix et limites",
  "description": "Guide pratique de l'API OpenAI Moderation : ce que détecte omni-moderation-latest, les 13 catégories, le format de réponse, sa gratuité et ce qu'elle vous laisse à faire.",
  "inLanguage": "fr",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/fr/blog/guide-api-openai-moderation" }
};

const categories = [
  { id: "harassment", desc: "Propos harcelants envers une cible quelle qu'elle soit.", inputs: "Texte" },
  { id: "harassment/threatening", desc: "Harcèlement comportant en plus de la violence ou un préjudice grave envers une cible quelle qu'elle soit.", inputs: "Texte" },
  { id: "hate", desc: "Haine fondée sur l'origine raciale, le genre, l'origine ethnique, la religion, la nationalité, l'orientation sexuelle, le handicap ou la caste. Les contenus haineux visant des groupes non protégés relèvent du harcèlement.", inputs: "Texte" },
  { id: "hate/threatening", desc: "Contenu haineux comportant en plus de la violence ou un préjudice grave envers le groupe visé.", inputs: "Texte" },
  { id: "illicit", desc: "Conseils ou instructions pour commettre des actes illicites.", inputs: "Texte" },
  { id: "illicit/violent", desc: "Contenu illicite qui évoque aussi la violence ou l'obtention d'une arme.", inputs: "Texte" },
  { id: "self-harm", desc: "Contenu qui promeut, encourage ou représente des actes d'automutilation.", inputs: "Texte et images" },
  { id: "self-harm/intent", desc: "L'auteur exprime qu'il s'automutile ou a l'intention de le faire.", inputs: "Texte et images" },
  { id: "self-harm/instructions", desc: "Contenu qui encourage l'automutilation ou explique comment la pratiquer.", inputs: "Texte et images" },
  { id: "sexual", desc: "Contenu destiné à susciter l'excitation sexuelle ou qui fait la promotion de services sexuels (hors éducation sexuelle et bien-être).", inputs: "Texte et images" },
  { id: "sexual/minors", desc: "Contenu sexuel impliquant une personne de moins de 18 ans.", inputs: "Texte" },
  { id: "violence", desc: "Contenu qui représente la mort, la violence ou des blessures physiques.", inputs: "Texte et images" },
  { id: "violence/graphic", desc: "Contenu qui représente la mort, la violence ou des blessures physiques de manière crue et détaillée.", inputs: "Texte et images" },
];

const curlExample = `curl https://api.openai.com/v1/moderations \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer \$OPENAI_API_KEY" \
  -d '{
    "model": "omni-moderation-latest",
    "input": "Le commentaire à vérifier"
  }'`;

const faqItems = [
  {
    question: "L'API OpenAI Moderation est-elle gratuite ?",
    answer: "Oui. OpenAI indique que l'endpoint de modération est gratuit. Les images envoyées peuvent peser jusqu'à 20 Mo.",
  },
  {
    question: "Qu'est-ce que omni-moderation-latest ?",
    answer: "omni-moderation-latest est le modèle de modération actuel d'OpenAI. Il accepte du texte et des images, mais ne classe pas l'audio.",
  },
  {
    question: "Quelles catégories l'API OpenAI Moderation détecte-t-elle ?",
    answer: "Treize : harassment, harassment/threatening, hate, hate/threatening, illicit, illicit/violent, self-harm, self-harm/intent, self-harm/instructions, sexual, sexual/minors, violence et violence/graphic. Six d'entre elles s'appliquent aussi aux images.",
  },
  {
    question: "Que ne fait pas l'API OpenAI Moderation ?",
    answer: "Elle renvoie des scores et des indicateurs, rien de plus. Décider quoi masquer, rédiger les règles de votre communauté, examiner les cas limites, expliquer chaque décision à son auteur et tenir un journal d'audit pour le DSA restent à votre charge. OpenModeration ajoute cette couche par-dessus omni-moderation-latest et d'autres modèles.",
  },
];
---

<BaseLayout title="API OpenAI Moderation (omni-moderation-latest) : catégories, prix" description="Comment fonctionne l'API OpenAI Moderation : ce que détecte omni-moderation-latest, les 13 catégories, la réponse, la gratuité et ce qu'il vous reste à faire." ogType="article" jsonLd={articleJsonLd}>
<Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Blog", href: "/fr/blog" }, { label: "Guide de l'API OpenAI Moderation" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">20 octobre 2026</time>
        <span>&middot;</span>
        <span>6 min de lecture</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">API OpenAI Moderation : omni-moderation-latest, catégories, prix et limites</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        L'API OpenAI Moderation vous indique si un texte ou une image est potentiellement préjudiciable,
        et dans quelle catégorie. Elle est gratuite, rapide à appeler et constitue souvent la première étape
        des équipes qui doivent modérer des contenus d'utilisateurs. Ce guide résume ce qu'elle détecte,
        ce qu'elle renvoie et ce qu'il vous reste à construire.
      </p>

      <h2 class="text-xl font-bold text-surface-900">L'essentiel en bref</h2>
      <ul>
        <li><strong>Modèle :</strong> <code>omni-moderation-latest</code>, qui accepte du texte et des images. Il ne classe pas l'audio.</li>
        <li><strong>Prix :</strong> gratuit. OpenAI précise que « l'endpoint de modération est gratuit », et les fichiers image peuvent peser jusqu'à 20 Mo.</li>
        <li><strong>Sortie :</strong> un booléen <code>flagged</code> et, pour chaque catégorie, un booléen et un score de confiance compris entre 0 et 1.</li>
        <li><strong>Catégories :</strong> 13, dont six s'appliquent aussi aux images.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">Comment l'appeler</h2>
      <p>
        Envoyez une requête POST à l'endpoint <code>/v1/moderations</code> avec le nom du modèle et votre contenu.
      </p>
      <pre class="overflow-x-auto rounded-lg bg-ink-900 p-4 text-sm text-surface-100"><code set:text={curlExample} /></pre>
      <p>
        Vous pouvez aussi activer la modération en ligne grâce au paramètre <code>moderation</code> de
        l'API Responses. Le résultat contient alors deux sections distinctes, <code>input</code> et
        <code>output</code>, et chacune peut être un objet d'erreur au lieu de scores.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Ce que contient la réponse</h2>
      <ul>
        <li><code>flagged</code> : <code>true</code> si le modèle classe le contenu comme potentiellement préjudiciable, <code>false</code> sinon.</li>
        <li><code>categories</code> : un booléen par catégorie, qui indique si cette catégorie est enfreinte.</li>
        <li><code>category_scores</code> : un score de confiance par catégorie, de 0 à 1. Plus il est élevé, plus le modèle est confiant.</li>
        <li><code>category_applied_input_types</code> : pour chaque catégorie, les types d'entrée (texte, image) auxquels le score s'applique.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">Les 13 catégories</h2>
      <p>
        Si vous n'envoyez qu'une image, les catégories réservées au texte renvoient un score de 0.
      </p>
    </div>

    <div class="mt-6 overflow-x-auto rounded-xl border border-surface-200">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="bg-surface-100">
            <th class="px-4 py-3 font-semibold text-surface-900">Catégorie</th>
            <th class="px-4 py-3 font-semibold text-surface-900">Ce qu'elle couvre</th>
            <th class="px-4 py-3 font-semibold text-surface-900">Entrées</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-200 bg-white">
          {categories.map((c) => (
            <tr>
              <td class="px-4 py-3 font-mono text-xs text-surface-900">{c.id}</td>
              <td class="px-4 py-3 text-surface-600">{c.desc}</td>
              <td class="px-4 py-3 text-surface-500">{c.inputs}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Points d'attention</h2>
      <ul>
        <li>OpenAI prévient que les règles personnalisées fondées sur <code>category_scores</code> peuvent devoir être recalibrées au fil du temps, à mesure que le modèle évolue.</li>
        <li>Avec la modération en ligne, les scores ne figurent pas dans les deltas partiels de la sortie en streaming.</li>
        <li>Avec les appels d'outils, les arguments et les sorties des outils sont modérés, mais pas les noms, descriptions et schémas des outils.</li>
        <li>N'envoyez pas de contenus pédocriminels avérés ou suspectés à l'API Moderation.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">Ce que l'API Moderation vous laisse à faire</h2>
      <p>
        Un score n'est pas une décision de modération. Une fois que vous l'avez, il vous reste à fixer
        le seuil de chaque catégorie, à décider du sort des commentaires situés entre les deux, à appliquer
        les règles propres à votre communauté et à expliquer chaque suppression à son auteur. En vertu du
        règlement sur les services numériques (DSA), les services d'hébergement doivent fournir un exposé
        des motifs pour chaque suppression et préciser si des moyens automatisés ont été utilisés.
      </p>
      <p>
        OpenModeration conserve <code>omni-moderation-latest</code> parmi ses modèles et ajoute la couche
        manquante : des règles rédigées en langage courant, deux seuils par catégorie avec une zone grise
        pour la revue humaine, une console de modération pour votre équipe, une explication écrite pour
        chaque décision et un journal d'audit complet. Si vous voulez plus tard ajouter Mistral, Azure ou
        un autre fournisseur, ou basculer vers l'un d'eux, vous le faites sans réécrire votre intégration.
      </p>
      <p class="text-sm text-surface-400">
        Source : <a href="https://developers.openai.com/api/docs/guides/moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">guide OpenAI sur la modération</a> (en anglais), consulté le 20 octobre 2026.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="FAQ" items={faqItems} />
    </div>
  </article>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Pour aller plus loin</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/fr/alternatives/openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">API OpenAI Moderation ou OpenModeration &rarr;</a></li>
        <li><a href="/fr/blog/comparatif-openai-azure-llama-guard" class="font-medium text-brand-600 hover:text-brand-500">OpenAI, Azure et Llama Guard comparés &rarr;</a></li>
        <li><a href="/fr/api-moderation-contenu" class="font-medium text-brand-600 hover:text-brand-500">Une seule API de modération de contenu pour tous les fournisseurs &rarr;</a></li>
        <li><a href="/fr/conformite-dsa" class="font-medium text-brand-600 hover:text-brand-500">Ce que le DSA exige des décisions de modération &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
