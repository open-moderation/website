        <li><a href="/fr/tarifs" class="font-medium text-brand-600 hover:text-brand-500">Des tarifs simples et transparents &rarr;</a></li>
        <li><a href="/fr/fonctionnalites" class="font-medium text-brand-600 hover:text-brand-500">Tout ce que la plateforme fait pour vous &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
