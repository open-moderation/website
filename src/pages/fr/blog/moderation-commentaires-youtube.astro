const title = "Modération des commentaires YouTube : le guide complet";
const description = "Modérer les commentaires YouTube : commentaires retenus, mots et liens bloqués, utilisateurs approuvés ou masqués, chat en direct et outil automatique.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Modération des commentaires YouTube : les outils de YouTube Studio, leurs limites et l'automatisation",
  "description": description,
  "inLanguage": "fr",
  "datePublished": "2026-10-30",
  "dateModified": "2026-10-30",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
