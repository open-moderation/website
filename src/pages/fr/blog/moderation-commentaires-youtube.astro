  { level: "Rétention plus stricte", effect: "YouTube retient un éventail plus large : plus de spam et d'insultes bloqués, mais aussi plus de commentaires légitimes.", fit: "Chaînes ciblées par des trolls ou par un raid" },
  { level: "Retenir tous les commentaires", effect: "Rien n'est publié sans validation manuelle.", fit: "Vidéos sensibles, périodes courtes, petits volumes" },
];

const comparison = [
  { need: "Bloquer une insulte ou un mot interdit connu", builtin: "Oui, avec les mots bloqués, si l'orthographe est assez proche", tool: "Oui, variantes et contournements compris" },
  { need: "Comprendre l'ironie, le contexte, les sous-entendus", builtin: "En partie : le filtre de YouTube est générique et non réglable", tool: "Oui, chaque commentaire est lu dans son contexte" },
