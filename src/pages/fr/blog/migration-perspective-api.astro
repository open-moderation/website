  "description": "Perspective API s'arrête fin 2026. Ce que cela change pour votre forum et comment migrer vers OpenModeration avant l'échéance.",
  "inLanguage": "fr",
  "datePublished": "2026-06-12",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
