---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Modération des commentaires WordPress : approbation, mise en attente ou spam par IA (2026, sans code)",
  "description": "Modérez automatiquement les commentaires WordPress grâce à l'IA. Connectez votre site avec un mot de passe d'application, sans développer de plugin ni écrire de code. Approuvez, mettez en attente ou classez en spam les commentaires non conformes, journal d'audit DSA inclus.",
  "inLanguage": "fr"
};

const faqItems = [
  {
    question: "Comment fonctionne la modération des commentaires WordPress ?",
    answer: "Connectez votre site WordPress avec un mot de passe d'application. Les commentaires sont récupérés automatiquement via l'API REST de WordPress et analysés par notre moteur d'IA. Selon vos règles, chaque commentaire est approuvé, mis en attente de modération ou marqué comme spam, sans file manuelle."
  },
  {
    question: "Faut-il écrire du code pour la mise en place ?",
    answer: "Non. Créez un mot de passe d'application dans l'administration WordPress (Comptes → Profil), puis renseignez l'URL de votre site, votre identifiant et ce mot de passe dans la console OpenModeration. Votre site est vérifié en quelques secondes et la modération démarre."
  },
  {
    question: "Quels types de contenus peut-on modérer sur WordPress ?",
    answer: "Les articles et les commentaires de votre site WordPress. La plateforme détecte les discours de haine, le harcèlement, le spam, les contenus NSFW, les données personnelles, les arnaques et bien plus, dans plus de 120 langues."
  },
  {
    question: "Que devient un commentaire non conforme sur mon site WordPress ?",
    answer: "Selon vos règles de modération, le commentaire est approuvé, mis en attente de modération ou marqué comme spam, directement via l'API REST de WordPress. Chaque action est enregistrée avec sa règle, ses scores d'IA et une explication écrite."
  },
  {
    question: "De quelles permissions mon compte WordPress a-t-il besoin ?",
    answer: "Votre compte WordPress doit avoir le droit de modérer les commentaires, c'est-à-dire un rôle d'administrateur ou d'éditeur. Le connecteur le vérifie lorsque vous connectez votre site."
  },
  {
    question: "Chaque décision de modération est-elle enregistrée pour les audits DSA ?",
    answer: "Oui. Chaque commentaire approuvé, mis en attente ou classé en spam conserve sa règle, ses scores d'IA et son explication écrite dans un journal d'audit complet. Exportez-le en un clic pour vos rapports de transparence DSA."
  },
];
---

<BaseLayout title="Modération des commentaires WordPress par IA, sans code (2026)" description="Modérez automatiquement les commentaires WordPress par IA. Connexion par mot de passe d'application, sans code. Approbation, attente ou spam, journal d'audit DSA inclus." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Intégrations", href: "/fr/integrations" }, { label: "Modération WordPress" }]} />
  <section class="bg-gradient-to-b from-sky-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.026-.78-.07-1.11m-7.981.105c.647-.03 1.232-.105 1.232-.105.582-.075.514-.93-.067-.899 0 0-1.755.135-2.88.135-1.064 0-2.85-.15-2.85-.15-.585-.03-.661.855-.075.885 0 0 .54.061 1.125.09l1.68 4.605-2.37 7.08L5.354 6.9c.649-.03 1.234-.1 1.234-.1.585-.075.516-.93-.065-.896 0 0-1.746.138-2.874.138-.2 0-.438-.008-.69-.015C4.911 3.15 8.235 1.215 12 1.215c2.809 0 5.365 1.072 7.286 2.833-.046-.003-.091-.009-.141-.009-1.06 0-1.812.923-1.812 1.914 0 .89.513 1.643 1.06 2.531.411.72.89 1.643.89 2.977 0 .915-.354 1.994-.821 3.479l-1.075 3.585-3.9-11.61.001.014zM12 22.784c-1.059 0-2.081-.153-3.048-.437l3.237-9.406 3.315 9.087c.024.053.05.101.078.149-1.12.393-2.325.609-3.582.609M1.211 12c0-1.564.336-3.05.935-4.39L7.29 21.709C3.694 19.96 1.212 16.271 1.211 12M12 0C5.385 0 0 5.385 0 12s5.385 12 12 12 12-5.385 12-12S18.615 0 12 0"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Modération des commentaires WordPress</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        L'IA modère les commentaires de votre site WordPress. Un mot de passe d'application suffit pour le connecter, et la mise en place prend quelques minutes, sans code.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Essayer gratuitement</a>
        <a href="/fr/comment-ca-marche" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Comment ça marche</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Une modération simple, en 3 étapes</h2>
        <p class="mt-4 text-lg text-surface-500">Comptez quelques minutes, sans équipe technique.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Créez votre compte</h3>
          <p class="mt-2 text-sm text-surface-500">Inscrivez-vous gratuitement sur OpenModeration, sans carte bancaire ni engagement. Vos données sont hébergées dans l'UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Connectez votre site WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Créez un mot de passe d'application dans votre administration WordPress, puis renseignez l'URL du site, votre identifiant et ce mot de passe. Votre site est vérifié automatiquement ; il vous faut un rôle d'administrateur ou d'éditeur.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Fixez vos règles, l'IA s'occupe du reste</h3>
          <p class="mt-2 text-sm text-surface-500">Définissez vos règles de modération en langage courant. Notre IA les applique automatiquement : elle approuve les commentaires, les met en attente ou les marque comme spam.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Ce que vous pouvez détecter</h2>
        <p class="mt-4 text-lg text-surface-500">Plus de 20 modèles de détection prêts à l'emploi, entraînés sur des milliards d'annotations.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicité</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discours de haine</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Harcèlement</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Arnaques et hameçonnage</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Données personnelles</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Automutilation</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Grossièretés</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sujets sensibles</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Liens à risque</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pourquoi la modération WordPress est plus simple avec OpenModeration</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aucun code requis</h3>
          <p class="mt-2 text-sm text-surface-500">Tout se règle depuis la console. Générez un mot de passe d'application, connectez votre site, rédigez vos règles en langage courant et laissez l'IA faire le reste.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Vos identifiants, sous votre contrôle</h3>
          <p class="mt-2 text-sm text-surface-500">Connectez-vous avec votre propre mot de passe d'application. Les identifiants sont chiffrés, jamais stockés en clair, et vous pouvez révoquer l'accès à tout moment depuis votre administration WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Application automatique sur WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Chaque commentaire est approuvé, mis en attente ou marqué comme spam directement via l'API REST de WordPress, sans file de modération manuelle.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Plus de 120 langues</h3>
          <p class="mt-2 text-sm text-surface-500">Modérez les commentaires dans toutes les langues de vos lecteurs. Notre IA lit chaque commentaire dans sa langue, et d'autres modèles d'IA arbitrent les cas délicats.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Des règles sur mesure en langage courant</h3>
          <p class="mt-2 text-sm text-surface-500">Rédigez votre politique de modération comme vous l'expliqueriez à un collègue. Aucun prompt à concevoir, aucune expression régulière à écrire.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Hébergé dans l'UE</h3>
          <p class="mt-2 text-sm text-surface-500">Vos données restent en Europe et s'exportent quand vous le voulez. Déploiement sur site possible sur demande.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Questions fréquentes sur la modération WordPress" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
