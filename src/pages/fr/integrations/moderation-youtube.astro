---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Plateforme de modération des commentaires YouTube | OpenModeration",
  "description": "Modérez les commentaires YouTube à grande échelle grâce à l'IA. Chaque commentaire est publié, retenu pour examen ou rejeté automatiquement. La solution de modération des commentaires YouTube la plus simple.",
  "inLanguage": "fr"
};

const faqItems = [
  {
    question: "Comment fonctionne la modération des commentaires YouTube ?",
    answer: "Connectez votre chaîne YouTube via l'API YouTube Data. Les commentaires sont récupérés et analysés par l'IA. Selon vos règles, chaque commentaire est publié, retenu pour examen ou rejeté."
  },
  {
    question: "La mise en place est-elle simple ?",
    answer: "Oui. Tout se configure depuis la console. Connectez votre chaîne YouTube, réglez vos règles de modération avec de simples interrupteurs et en langage courant, et la plateforme protège vos vidéos immédiatement."
  },
  {
    question: "Que peut détecter la modération YouTube ?",
    answer: "Les discours de haine, le harcèlement, le spam, les contenus NSFW, les données personnelles, les arnaques, l'hameçonnage, les grossièretés, l'automutilation, le sentiment, les sujets sensibles et les liens à risque. Plus de 20 modèles couvrent plus de 120 langues."
  },
  {
    question: "Faut-il des compétences techniques pour l'utiliser ?",
    answer: "Non. OpenModeration est pensé pour les créateurs et les community managers. Les règles se rédigent en langage courant depuis une console intuitive, sans aucun code."
  },
  {
    question: "Puis-je examiner les commentaires signalés avant de les retirer ?",
    answer: "Oui. Les cas limites sont relus par notre équipe, qui les approuve ou les rejette. Vous n'avez rien à faire, mais vous voyez chaque décision en temps réel et pouvez intervenir quand vous voulez. Chaque action est enregistrée."
  },
];
---

<BaseLayout title="Modération des commentaires YouTube par IA | OpenModeration" description="Modérez les commentaires YouTube par IA : commentaires toxiques rejetés, cas limites retenus pour examen, plus de 120 langues. Pour créateurs et marques." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Intégrations", href: "/fr/integrations" }, { label: "Modération YouTube" }]} />
  <section class="bg-gradient-to-b from-red-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 text-red-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Modération des commentaires YouTube</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        L'IA modère les commentaires de votre chaîne YouTube, même en grand nombre. La mise en place prend quelques minutes et ne demande aucun code.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Essayer gratuitement</a>
        <a href="/fr/comment-ca-marche" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Comment ça marche</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Commencez à modérer en 3 étapes simples</h2>
        <p class="mt-4 text-lg text-surface-500">Quelques minutes suffisent, sans aucun développement.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Créez votre compte</h3>
          <p class="mt-2 text-sm text-surface-500">Inscrivez-vous gratuitement, sans carte bancaire.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Connectez YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Reliez votre chaîne YouTube avec vos propres identifiants de l'API Data. Le connecteur récupère automatiquement les commentaires.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Fixez vos règles, l'IA s'occupe du reste</h3>
          <p class="mt-2 text-sm text-surface-500">Définissez vos règles en langage courant. L'IA rejette les commentaires toxiques et retient automatiquement les cas limites pour examen.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Ce que l'IA détecte dans vos commentaires</h2>
        <p class="mt-4 text-lg text-surface-500">Plus de 20 modèles prêts à l'emploi, entraînés sur des milliards d'annotations de contenus.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicité</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discours de haine</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Harcèlement</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Arnaques et hameçonnage</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Données personnelles</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Automutilation</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Grossièretés</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sujets sensibles</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Liens à risque</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pourquoi la modération YouTube est plus simple avec OpenModeration</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aucun code nécessaire</h3>
          <p class="mt-2 text-sm text-surface-500">Tout se configure depuis la console. Vous n'avez rien à développer et rien à faire configurer par un ingénieur.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Des actions natives YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Publiez, retenez pour examen ou rejetez les commentaires directement via l'API YouTube Data. Ce sont les mêmes actions que dans YouTube Studio, appliquées automatiquement.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">À n'importe quelle échelle</h3>
          <p class="mt-2 text-sm text-surface-500">Que votre chaîne reçoive 100 ou 100 000 commentaires par jour, OpenModeration suit le rythme.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Plus de 120 langues</h3>
          <p class="mt-2 text-sm text-surface-500">Votre audience internationale commente dans de nombreuses langues. Une seule plateforme détecte automatiquement la toxicité dans chacune d'elles.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Des règles sur mesure en langage courant</h3>
          <p class="mt-2 text-sm text-surface-500">Rédigez votre politique de modération en langage courant. L'IA tient compte de l'intention, et pas uniquement des mots employés.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Auditable et transparent</h3>
          <p class="mt-2 text-sm text-surface-500">Chaque décision de modération est enregistrée avec tout son contexte. Vos données sont hébergées dans l'UE et restent exportables.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Questions fréquentes sur la modération YouTube" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
