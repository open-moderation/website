<SectorPage
  title="Signalements DSA (article 16) : obligations et mise en place"
  description="Article 16 du DSA : ce qu'un mécanisme de signalement doit permettre, ce que doit contenir une notification, et comment traiter et tracer chaque signalement."
  crumb="Signalements (article 16)"
  parent={{ label: "Conformité DSA", href: "/fr/conformite-dsa" }}
