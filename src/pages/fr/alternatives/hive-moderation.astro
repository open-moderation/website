---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';

const migrationCode = `# Avant : Hive Moderation (appel direct)
const response = await fetch('https://api.thehive.ai/api/v2/task/sync', {
  method: 'POST',
  headers: { 'Authorization': 'Token YOUR_HIVE_KEY' },
  body: JSON.stringify({ url: '...', text: { text: content } })
});

# Après : OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// Verdict, scores par catégorie et explication écrite, toujours au même format`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative à Hive Moderation | OpenModeration",
  "description": "Hive Moderation offre une modération visuelle et textuelle solide, mais repose sur ses seuls modèles propriétaires. OpenModeration s'appuie sur sa propre IA de modération, arbitrée par d'autres modèles d'IA sur les cas délicats, avec des workflows automatisés et la conformité DSA intégrée.",
  "inLanguage": "fr",
};

const comparisonPoints = [
  { feature: "Moteur d'IA", hive: "Modèles propriétaires Hive uniquement", openmod: "Notre propre IA de modération, arbitrée par d'autres modèles d'IA sur les cas délicats" },
  { feature: "Types de contenus", hive: "Texte, image, vidéo (modération visuelle solide)", openmod: "Modération de texte sur 10 catégories, paramétrée selon vos règles et vos cas d'usage." },
  { feature: "Pré-filtrage", hive: "Non disponible", openmod: "Filtre de mots intégré qui bloque le spam évident et les mots interdits avant tout appel d'API" },
  { feature: "Moteur de décision", hive: "Scores de classification bruts", openmod: "Double seuil : les cas douteux sont traités par notre équipe, vous n'avez rien à faire" },
  { feature: "Actions automatiques", hive: "Intégration à développer vous-même", openmod: "Le moteur d'actions intégré masque, supprime, signale ou notifie dès qu'un seuil est dépassé." },
  { feature: "Console", hive: "Console d'API basique", openmod: "Console complète : vous voyez chaque décision et son explication en temps réel, et intervenez quand vous voulez" },
  { feature: "Format d'API", hive: "Format Hive propriétaire", openmod: "Format standardisé et stable : verdict, scores par catégorie et explication écrite." },
  { feature: "Évolution des modèles", hive: "Liée aux modèles propriétaires de Hive", openmod: "Indépendante des modèles : un modèle plus performant ou moins cher sort, on le branche. Rien ne change pour vous." },
  { feature: "Déploiement", hive: "API cloud uniquement", openmod: "Cloud managé dans l'UE ; déploiement sur site possible sur demande" },
  { feature: "Journal d'audit", hive: "Logs des requêtes d'API", openmod: "Journal d'audit DSA complet : chaque décision de l'IA et des humains est consignée, rapports exportables" },
  { feature: "Prix", hive: "À l'usage, sur devis", openmod: "Gratuit jusqu'à 1 000 requêtes par mois. Cloud managé à partir de 99 €/mois (10 000 requêtes incluses)." },
];

const reasons = [
  {
    title: "Hive excelle sur le visuel, alors que l'IA génère surtout du texte",
    description: "Hive est réputé pour la modération d'images et de vidéos. Or les LLM et les chatbots produisent désormais du texte en très grand volume, et il vous faut une plateforme aussi solide sur le texte que sur le visuel. OpenModeration est conçu pour le texte : sa propre IA de modération, entraînée sur les commentaires, est arbitrée par d'autres modèles d'IA sur les cas délicats."
  },
  {
    title: "Un seul modèle maison, c'est un modèle qui vieillit",
    description: "Avec Hive, vous dépendez du rythme de mise à jour de ses modèles propriétaires. OpenModeration est indépendant des modèles : quand un modèle d'IA plus performant ou moins cher sort, l'équipe le branche rapidement. Rien ne change de votre côté, et vous profitez des progrès de l'IA."
  },
  {
    title: "Des modèles propriétaires impossibles à auditer",
    description: "Les modèles de Hive sont des boîtes noires : impossible de les auditer, de les affiner ou d'examiner leurs données d'entraînement. Avec OpenModeration, chaque décision est accompagnée d'une explication écrite, et les cas délicats sont arbitrés par d'autres modèles d'IA avant d'être appliqués."
  },
  {
    title: "Des scores d'API ne suffisent pas pour le DSA",
    description: "Le règlement européen sur les services numériques (DSA) impose des décisions de modération documentées, des mécanismes de revue humaine et des rapports de transparence. OpenModeration fournit toute la chaîne de conformité (journaux d'audit, revue humaine des cas douteux et des signalements par notre équipe, rapports exportables), là où une API se limite à ses logs."
  },
];
---

<BaseLayout
  title="Alternative à Hive Moderation pour modérer vos commentaires"
  description="Hive excelle sur le visuel. OpenModeration modère le texte avec sa propre IA arbitrée par d'autres modèles, des règles automatiques et un audit DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Alternatives", href: "/fr/alternatives" }, { label: "Alternative à Hive Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1.5 text-sm font-medium text-amber-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Alternative à Hive Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Hive excelle sur les contenus visuels.<br/>Pour modérer du texte, il vous faut une plateforme.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Hive Moderation excelle dans la classification d'images et de vidéos. Mais les besoins en modération de texte
        explosent : LLM, chatbots, forums, commentaires. OpenModeration modère le texte avec sa propre IA, arbitrée
        par d'autres modèles d'IA sur les cas délicats, avec des règles automatiques, une revue humaine assurée par notre équipe et la conformité DSA intégrée.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Essayer OpenModeration gratuitement</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Voir le comparatif</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pourquoi les équipes ne s'en tiennent pas à Hive seul</h2>
        <p class="mt-4 text-lg text-surface-500">Hive est un moteur de modération puissant. Pour modérer du texte en production et à grande échelle, un seul modèle et des scores bruts ne suffisent pourtant pas.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Une API stable
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Une IA qui suit le marché, une API qui ne bouge pas</h2>
          <p class="mt-4 text-lg text-surface-500">
            Un seul appel d'API, un format de réponse standardisé. Derrière, OpenModeration fait évoluer
            son moteur d'IA au rythme du marché, sans que vous ayez à modifier votre intégration.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Arbitrée par d'autres IA.</strong> Sur les cas délicats, d'autres modèles d'IA vérifient la décision avant qu'elle soit appliquée.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Branchée sur le meilleur du marché.</strong> Quand un modèle plus performant ou moins cher sort, on le branche rapidement. Rien ne change de votre côté.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Des décisions explicables.</strong> Chaque décision est accompagnée d'une explication écrite et consignée dans le journal d'audit.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Hive Moderation ou OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Hive est un fournisseur de modération solide. OpenModeration est une plateforme complète de modération des commentaires, avec sa propre IA.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Fonctionnalité</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Hive Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.hive}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Comparer d'autres solutions</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/fr/alternatives/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/fr/alternatives/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/fr/alternatives/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/fr/alternatives/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/fr/alternatives/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection
    title="Une IA de modération qui profite des progrès du marché."
    subtitle="Notre propre IA, arbitrée par d'autres modèles d'IA sur les cas délicats, via une seule API standardisée. La plateforme est hébergée dans l'UE et prête pour le DSA."
    buttonText="Essayer OpenModeration gratuitement"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
