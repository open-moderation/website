---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';

const migrationCode = `# Avant : Perspective API
const result = await fetch('https://commentanalyzer.googleapis.com/v1alpha1/comments:analyze', ...)

# Après : OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
})`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative à Perspective API : migrer avant l'arrêt de 2026",
  "description": "Perspective API, de Google, s'arrête fin 2026. Migrez vers OpenModeration : sa propre IA de modération, arbitrée par d'autres modèles, hébergée dans l'UE.",
  "inLanguage": "fr",
  "about": {
    "@type": "SoftwareApplication",
    "name": "OpenModeration",
    "applicationCategory": "ContentModeration",
    "operatingSystem": "Cross-platform"
  }
};
---

<BaseLayout title="Alternative à Perspective API : migrer avant l'arrêt de 2026" description="Perspective API, de Google, s'arrête fin 2026. Migrez vers OpenModeration : sa propre IA de modération, arbitrée par d'autres modèles, hébergée dans l'UE." {jsonLd}>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Alternatives", href: "/fr/alternatives" }, { label: "Alternative à Perspective API" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-4 py-1.5 text-sm font-medium text-red-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Perspective API s'arrête fin 2026
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Perspective API, de Google, s'arrête en 2026 : l'alternative prête pour le DSA</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Google a annoncé la fin de vie de Perspective API pour fin 2026. Des milliers de forums et de communautés doivent la remplacer.
        OpenModeration est l'alternative prête à prendre le relais, avec une IA qui suit les progrès du marché au lieu de vieillir.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Ce que l'arrêt change pour vous</h2>
          <p class="mt-4 text-lg text-surface-500">
            Perspective API assurait la détection de la toxicité pour des milliers d'éditeurs, de forums et d'espaces de commentaires de sites d'information.
            Avec l'annonce par Google de sa fin de vie pour fin 2026, chaque plateforme qui l'utilise doit trouver une solution de remplacement.
          </p>
          <div class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Les forums qui dépendent de Perspective doivent migrer</h3>
                <p class="mt-1 text-sm text-surface-500">Après 2026, plus aucun appel à Perspective API ne sera possible. Votre chaîne de modération cessera de fonctionner si vous n'avez pas de remplaçant prêt.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Le DSA rend la migration plus urgente</h3>
                <p class="mt-1 text-sm text-surface-500">Le règlement européen sur les services numériques (DSA) exige que vous motiviez chaque décision de modération et que vous traitiez les réclamations. Vous ne pouvez pas vous permettre d'attendre 2026.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h4 class="mb-2 text-sm font-semibold text-surface-900">Migration express : avant et après</h4>
          <CodeBlock code={migrationCode} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Comment OpenModeration peut remplacer Perspective API</h2>
        <p class="mt-4 text-lg text-surface-500">Une seule API, une IA de modération qui évolue avec le marché, sans que vous ayez à modifier votre intégration.</p>
      </div>
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Notre propre IA de modération</h3>
          <p class="mt-2 text-sm text-surface-500">Entraînée pour la modération des commentaires et paramétrée selon vos règles et vos cas d'usage : haine, harcèlement, insultes, spam, contenu sexuel, violence.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-100 text-accent-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Arbitrée par d'autres IA</h3>
          <p class="mt-2 text-sm text-surface-500">Sur les cas délicats, d'autres modèles d'IA arbitrent la décision avant qu'elle soit appliquée. Moins d'erreurs, moins de commentaires masqués à tort.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-100 text-purple-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Branchée sur le meilleur du marché</h3>
          <p class="mt-2 text-sm text-surface-500">Quand un modèle d'IA plus performant ou moins cher sort, on le branche rapidement. Vous profitez des progrès de l'IA, au lieu de rester bloqué sur le modèle d'hier.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 text-cyan-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Une API simple et stable</h3>
          <p class="mt-2 text-sm text-surface-500">Un seul endpoint POST /v1/moderation, un format de réponse standardisé. Quand le moteur d'IA évolue, rien ne change dans votre code.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perspective API ou OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Les deux outils comparés sur les fonctionnalités qui comptent en production.</p>
      </div>
      <div class="overflow-hidden rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Fonctionnalité</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Perspective API</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Prix</td>
              <td class="px-6 py-4 text-surface-500">Gratuit, avec des quotas de requêtes</td>
              <td class="px-6 py-4 text-surface-900">Offre gratuite pour démarrer, puis SaaS facturé à l'usage</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Hébergement</td>
              <td class="px-6 py-4 text-surface-500">Cloud Google</td>
              <td class="px-6 py-4 text-surface-900">Hébergé dans l'UE ; déploiement sur site possible sur demande</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Langues</td>
              <td class="px-6 py-4 text-surface-500">Une vingtaine de langues, avec une précision variable</td>
              <td class="px-6 py-4 text-surface-900">Multilingue, avec la même API pour toutes les langues</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Catégories de modération</td>
              <td class="px-6 py-4 text-surface-500">9 catégories fixes</td>
              <td class="px-6 py-4 text-surface-900">10 catégories, entièrement personnalisables</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Évolution du modèle</td>
              <td class="px-6 py-4 text-surface-500">Un seul modèle Google, bientôt arrêté</td>
              <td class="px-6 py-4 text-surface-900">Indépendante des modèles : les nouveaux modèles d'IA sont branchés au fil du marché</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Journal d'audit DSA</td>
              <td class="px-6 py-4 text-surface-500">Non disponible</td>
              <td class="px-6 py-4 text-surface-900">Journalisation et export intégrés</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Statut</td>
              <td class="px-6 py-4 text-surface-500">Arrêt prévu fin 2026</td>
              <td class="px-6 py-4 text-surface-900">Activement maintenu et amélioré</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="N'attendez pas l'arrêt du service" subtitle="Quittez Perspective API dès maintenant. Commencez gratuitement." buttonText="Essayer gratuitement" buttonHref="https://app.openmoderation.com/signup" />

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Comparer d'autres solutions</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/fr/alternatives/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/fr/alternatives/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/fr/alternatives/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/fr/alternatives/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/fr/alternatives/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>
</BaseLayout>
