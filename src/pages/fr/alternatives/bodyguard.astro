---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative à Bodyguard : le comparatif avec OpenModeration",
  "description": "Bodyguard ou OpenModeration ? Comparatif sourcé des deux outils de modération : réseaux couverts, prix, hébergement des données et explication écrite des décisions.",
  "inLanguage": "fr",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Offres", bodyguard: "Une API de modération pour les plateformes et une offre de modération des réseaux sociaux pour les marques, agences et organisations publiques", openmod: "Une plateforme unique : connecteurs réseaux sociaux et WordPress, API REST et webhooks pour tout le reste" },
  { feature: "Réseaux sociaux couverts", bodyguard: "Facebook, Instagram, TikTok, X, LinkedIn, YouTube, Twitch, Discord", openmod: "Facebook, Instagram, YouTube et WordPress en natif ; le reste via l'API" },
  { feature: "Prix", bodyguard: "Guardian à partir de 1 000 € par mois, Sentinel à partir de 3 000 € par mois, Commander sur devis ; prix selon la taille de l'audience", openmod: "Publics : gratuit jusqu'à 1 000 requêtes par mois, Pro à 99 € par mois" },
  { feature: "Hébergement des données", bodyguard: "Non précisé sur la page d'accueil", openmod: "Conçu et hébergé dans l'Union européenne" },
  { feature: "Modèles d'IA", bodyguard: "Technologie développée par Bodyguard", openmod: "Sa propre IA de modération, arbitrée par d'autres modèles d'IA sur les cas délicats ; un nouveau modèle plus performant est branché rapidement" },
  { feature: "Explication écrite de chaque décision", bodyguard: "Non mentionnée", openmod: "Oui, pour chaque décision, dans la langue de votre choix" },
  { feature: "DSA", bodyguard: "Non mentionné sur la page d'accueil", openmod: "Journal d'audit de toutes les décisions, automatiques ou humaines" },
  { feature: "Conformité affichée", bodyguard: "RGPD, SOC 2 Type 2", openmod: "RGPD ; journal d'activité pour chaque décision" },
  { feature: "Langues", bodyguard: "46 langues revendiquées", openmod: "Définies avec vous lors de la mise en place" },
];

const faqItems = [
  {
    question: "Quelle est la meilleure alternative à Bodyguard ?",
    answer: "Tout dépend de ce que vous cherchez. Si vous voulez une offre gratuite pour démarrer, des données hébergées dans l'UE et une explication écrite pour chaque commentaire masqué, OpenModeration répond à ces critères. Si vous devez modérer TikTok, X, LinkedIn, Twitch ou Discord en natif, Bodyguard couvre ces réseaux et OpenModeration non.",
  },
  {
    question: "Combien coûte Bodyguard par rapport à OpenModeration ?",
    answer: "Sur sa page tarifs, Bodyguard indique une offre Guardian à partir de 1 000 € par mois et une offre Sentinel à partir de 3 000 € par mois, avec un prix qui dépend de la taille de l'audience. OpenModeration propose une offre gratuite jusqu'à 1 000 requêtes par mois et une offre Pro à 99 € par mois pour 10 000 requêtes.",
  },
  {
    question: "OpenModeration est-il conforme au DSA ?",
    answer: "OpenModeration rédige une explication écrite pour chaque décision et conserve un journal d'audit de toutes les décisions, qu'elles soient prises par l'IA ou par un modérateur. Ces deux briques servent directement l'exposé des motifs exigé par l'article 17 du DSA.",
  },
  {
    question: "Peut-on passer de Bodyguard à OpenModeration sans tout refaire ?",
    answer: "Sur Facebook, Instagram, YouTube et WordPress, il suffit de connecter vos comptes et d'écrire vos règles en langage courant, sans code. Pour une plateforme maison, l'API REST d'OpenModeration remplace l'appel à l'API précédente.",
  },
];
---

<BaseLayout title="Alternative à Bodyguard : comparatif avec OpenModeration (2026)" description="Bodyguard ou OpenModeration ? Comparatif sourcé : réseaux couverts, prix, hébergement UE et explication écrite de chaque décision." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Alternatives", href: "/fr/alternatives" }, { label: "Bodyguard" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparatif
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternative à Bodyguard : OpenModeration comparé</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bodyguard est un acteur français reconnu de la modération par IA. OpenModeration fait d'autres choix : une offre gratuite puis un Pro à 99 € par mois, des données hébergées dans l'UE et une explication écrite pour chaque décision. Voici les différences, sources à l'appui, pour choisir en connaissance de cause.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Choisissez OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>vous voulez démarrer gratuitement, puis payer moins de 100 € par mois ;</li>
          <li>vous voulez un journal d'activité complet de chaque décision ;</li>
          <li>vos données doivent rester dans l'Union européenne ;</li>
          <li>vous devez expliquer chaque retrait de commentaire, comme le demande le DSA ;</li>
          <li>vous voulez une IA qui profite des progrès des modèles d'IA, au lieu de rester figée sur un seul algorithme.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Bodyguard peut mieux vous convenir si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>vous devez modérer TikTok, X, LinkedIn, Twitch ou Discord en natif ;</li>
          <li>une certification SOC 2 Type 2 est exigée par vos achats ;</li>
          <li>vous préférez une solution entièrement gérée par un fournisseur unique.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Bodyguard et OpenModeration, point par point</h2>
      <p class="mt-4 text-surface-500">Informations sur Bodyguard tirées de son site, bodyguard.ai, consulté le 20 octobre 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Critère</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Bodyguard</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.bodyguard}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Ce qui change vraiment au quotidien</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Vous savez pourquoi un commentaire a été masqué</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration accompagne chaque décision d'une explication écrite, visible par votre équipe et renvoyée par l'API. Vous pouvez répondre à un lecteur qui conteste, et le DSA impose justement d'expliquer chaque retrait.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Vos règles, écrites comme vous les pensez</h3>
          <p class="mt-2 text-sm text-surface-600">Vous rédigez vos règles en langage courant, vous ajoutez des mots interdits et vous réglez un seuil par catégorie. Les cas limites sont traités par notre équipe ; vous voyez chaque décision en temps réel et pouvez la corriger en un clic.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Un ticket d'entrée bien plus bas</h3>
          <p class="mt-2 text-sm text-surface-600">Bodyguard démarre à 1 000 € par mois. OpenModeration est gratuit jusqu'à 1 000 requêtes par mois et l'offre Pro coûte 99 € par mois.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aucune dépendance à un modèle unique</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration fait tourner sa propre IA de modération, arbitrée par d'autres modèles d'IA sur les cas délicats. Quand un modèle plus performant ou moins cher sort, nous le branchons rapidement : rien ne change de votre côté.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Questions fréquentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bodyguard est une marque de son éditeur. Les informations la concernant proviennent de <a href="https://bodyguard.ai/fr" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">bodyguard.ai</a> et de sa <a href="https://www.bodyguard.ai/en/social-media/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">page tarifs</a> (consulté le 20 octobre 2026). Une erreur ? Écrivez-nous à <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Pour aller plus loin</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/fr/moderation-reseaux-sociaux" class="font-medium text-brand-600 hover:text-brand-500">Modération des réseaux sociaux avec OpenModeration &rarr;</a></li>
        <li><a href="/fr/conformite-dsa/expose-des-motifs" class="font-medium text-brand-600 hover:text-brand-500">L'exposé des motifs exigé par le DSA &rarr;</a></li>
        <li><a href="/fr/alternatives" class="font-medium text-brand-600 hover:text-brand-500">Tous les comparatifs &rarr;</a></li>
        <li><a href="/fr/tarifs" class="font-medium text-brand-600 hover:text-brand-500">Les tarifs d'OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Essayez l'alternative à Bodyguard qui explique chaque décision." subtitle="Connectez vos pages, écrivez vos règles et voyez l'explication écrite de chaque commentaire masqué. Gratuit pour commencer." />
</BaseLayout>
