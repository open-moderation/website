---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/fr/alternatives/coral",
  "name": "Alternative à Coral : le comparatif avec OpenModeration",
  "description": "Coral by Vox Media ou OpenModeration ? Deux projets open source comparés, sources à l'appui : un système de commentaires que vous exploitez, et une couche de modération qui couvre aussi les réseaux sociaux.",
  "inLanguage": "fr",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Nature de l'outil", coral: "Une plateforme de commentaires open source pour les rédactions, avec des outils de modération", openmod: "Une couche de modération : elle décide sur les commentaires là où ils se trouvent déjà, sans les afficher elle-même" },
  { feature: "Où il modère", coral: "Les commentaires de votre site. Réseaux sociaux : non précisé", openmod: "Facebook, Instagram, YouTube et WordPress en natif, plus une API REST et des webhooks" },
  { feature: "Code source", coral: "Open source sous licence Apache 2.0, publié sur GitHub", openmod: "Open source sous licence AGPL v3, publié sur GitHub" },
  { feature: "Auto-hébergement", coral: "Oui (Docker, MongoDB, Redis, Node)", openmod: "Oui, avec Docker" },
  { feature: "Offre hébergée et prix", coral: "Offre hébergée sur devis. Prix non indiqués", openmod: "Publics : gratuit jusqu'à 1 000 requêtes par mois, Pro à 99 € par mois pour 10 000, sur mesure pour les gros volumes" },
  { feature: "Lieu d'hébergement de l'offre hébergée", coral: "Non précisé", openmod: "Conçu et hébergé dans l'Union européenne" },
  { feature: "Rôle de l'IA", coral: "Des outils pour les modérateurs humains, avec une assistance par IA", openmod: "Décisions automatiques selon des règles en langage courant, un seuil par catégorie, une zone grise envoyée à vos modérateurs" },
  { feature: "Explication écrite de chaque décision", coral: "Non précisé", openmod: "Oui, dans la langue de votre choix, renvoyée par l'API" },
  { feature: "DSA", coral: "Non précisé", openmod: "Journal d'activité qui indique si chaque décision est automatique ou prise par quel modérateur" },
  { feature: "Langues", coral: "Utilisé dans 23 langues et 30 pays, selon son site", openmod: "Selon les modèles d'IA choisis" },
  { feature: "Références médias", coral: "The Intercept, The Washington Post, Fairfax Media (témoignages)", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier" },
];

const faqItems = [
  {
    question: "Quelle est la meilleure alternative à Coral ?",
    answer: "Tout dépend de ce que vous remplacez. Si vous avez besoin d'un système de commentaires complet, hébergé et exploité par vos soins, Coral est un bon choix open source et OpenModeration ne le remplace pas. Si vous avez déjà des commentaires (sur WordPress, Facebook, Instagram ou YouTube) et voulez les modérer automatiquement, avec une explication écrite pour chaque décision, OpenModeration est conçu pour cela.",
  },
  {
    question: "Combien coûte Coral par rapport à OpenModeration ?",
    answer: "Le code de Coral s'auto-héberge gratuitement. Son offre hébergée est vendue sur devis et aucun prix n'apparaît sur coralproject.net. OpenModeration publie ses tarifs : gratuit jusqu'à 1 000 requêtes par mois, Pro à 99 € par mois pour 10 000 requêtes, offre sur mesure pour les gros volumes, et auto-hébergement gratuit avec Docker.",
  },
  {
    question: "Coral et OpenModeration sont-ils tous les deux open source ?",
    answer: "Oui. Coral est publié sous licence Apache 2.0, OpenModeration sous AGPL v3. Les deux s'auto-hébergent. La différence tient au périmètre : Coral est l'espace de commentaires que voient vos lecteurs, OpenModeration est la couche qui décide de ce qui est publié, sur votre site comme sur vos pages de réseaux sociaux.",
  },
  {
    question: "Peut-on tester OpenModeration sans quitter Coral ?",
    answer: "Oui. En mode bac à sable, OpenModeration analyse de vrais commentaires sans appliquer aucune action. Vous envoyez un échantillon de vos commentaires à l'API et vous comparez ses décisions avec celles de vos modérateurs, commentaire par commentaire, avant de toucher à la production.",
  },
  {
    question: "Un média français doit-il justifier la suppression d'un commentaire de lecteur ?",
    answer: "Le DSA impose aux hébergeurs d'expliquer leurs décisions de modération (article 17). OpenModeration rédige une explication pour chaque décision et tient un journal d'activité qui indique si la décision est automatique ou prise par un modérateur nommé. Votre rédaction a ainsi une réponse à donner au lecteur qui conteste.",
  },
];
---

<BaseLayout title="Alternative à Coral : comparatif avec OpenModeration (2026)" description="Coral ou OpenModeration ? Deux outils open source comparés : système de commentaires ou couche de modération, réseaux sociaux, prix, DSA." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Alternatives", href: "/fr/alternatives" }, { label: "Coral" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparatif
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternative à Coral : OpenModeration comparé</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Coral by Vox Media et OpenModeration sont tous deux open source, mais ils ne font pas le même travail. Coral est une plateforme de commentaires qu'une rédaction installe et exploite sur son site. OpenModeration est une couche de modération qui décide sur les commentaires là où ils se trouvent déjà, sur votre site comme sur vos pages Facebook, Instagram et YouTube. Voici les différences, sources à l'appui.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Choisissez OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>vous voulez garder votre espace de commentaires actuel et y ajouter une modération automatique ;</li>
          <li>vous modérez aussi les commentaires sur Facebook, Instagram ou YouTube ;</li>
          <li>vous voulez une explication écrite pour chaque commentaire masqué et un journal d'activité pour le DSA ;</li>
          <li>vous préférez un service hébergé dans l'UE, à prix publics, plutôt que de gérer des serveurs ;</li>
          <li>vous voulez que nous adaptions la modération à vos règles et à vos cas d'usage, à partir de vos vrais commentaires.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Coral peut mieux vous convenir si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>vous avez besoin de l'espace de commentaires lui-même : affichage, notifications, badges journalistes ;</li>
          <li>vous avez l'équipe technique pour l'héberger et l'exploiter (Docker, MongoDB, Redis, Node) ;</li>
          <li>vous préférez la licence permissive Apache 2.0 à l'AGPL v3 ;</li>
          <li>vos modérateurs relisent à la main et veulent des outils intégrés au fil des commentaires.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Coral et OpenModeration, point par point</h2>
      <p class="mt-4 text-surface-500">Informations sur Coral tirées de coralproject.net, de sa documentation et de son dépôt GitHub, consultés le 20 octobre 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Critère</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Coral</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.coral}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Ce qui change vraiment au quotidien</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Votre site et vos réseaux au même endroit</h3>
          <p class="mt-2 text-sm text-surface-600">Les mêmes règles s'appliquent aux commentaires sur WordPress, Facebook, Instagram et YouTube. Toutes les décisions, quel que soit l'endroit où le commentaire a été posté, arrivent dans le même journal d'activité.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Des décisions prises pour vous, et expliquées</h3>
          <p class="mt-2 text-sm text-surface-600">L'IA lit chaque commentaire avec le titre de l'article et le fil de discussion, puis le publie ou le masque selon vos règles. Chaque décision porte une explication écrite, et seule la zone grise arrive à votre équipe.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Une modération adaptée à vos règles</h3>
          <p class="mt-2 text-sm text-surface-600">Notre équipe adapte la modération à vos règles actuelles et à vos cas d'usage, à partir de vrais commentaires, puis l'ajuste pendant les premières semaines. Le système apprend des décisions de vos modérateurs et propose des ajustements qu'un administrateur applique en un clic.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Un test en parallèle avant de changer quoi que ce soit</h3>
          <p class="mt-2 text-sm text-surface-600">Le mode bac à sable analyse de vrais commentaires sans rien masquer. Vous comparez ses décisions avec celles de votre modération actuelle, puis vous décidez.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Questions fréquentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Coral est une marque de Vox Media. Les informations la concernant proviennent de <a href="https://coralproject.net" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">coralproject.net</a>, <a href="https://docs.coralproject.net/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">docs.coralproject.net</a> et <a href="https://github.com/coralproject/talk" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">github.com/coralproject/talk</a> (consultés le 20 octobre 2026). Une erreur ? Écrivez-nous à <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Pour aller plus loin</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/fr/cas-usage/medias" class="font-medium text-brand-600 hover:text-brand-500">La modération des commentaires pour les médias &rarr;</a></li>
        <li><a href="/fr/integrations/moderation-wordpress" class="font-medium text-brand-600 hover:text-brand-500">Modérer les commentaires WordPress &rarr;</a></li>
        <li><a href="/fr/conformite-dsa/expose-des-motifs" class="font-medium text-brand-600 hover:text-brand-500">L'exposé des motifs exigé par le DSA &rarr;</a></li>
        <li><a href="/fr/alternatives" class="font-medium text-brand-600 hover:text-brand-500">Tous les comparatifs &rarr;</a></li>
        <li><a href="/fr/tarifs" class="font-medium text-brand-600 hover:text-brand-500">Les tarifs d'OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Ajoutez une modération open source aux commentaires que vous avez déjà." subtitle="Connectez votre site et vos pages, écrivez vos règles en langage courant et lisez l'explication de chaque décision. Gratuit pour commencer." />
</BaseLayout>
