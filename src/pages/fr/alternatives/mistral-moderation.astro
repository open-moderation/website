---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# Avant : Mistral Moderation (appel direct)
import { Mistral } from '@mistralai/mistralai';
const mistral = new Mistral({ apiKey: '...' });
const result = await mistral.moderations.create({ input: text });

# Après : OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// Verdict, scores par catégorie et explication écrite, selon vos règles`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative à Mistral Moderation | OpenModeration",
  "description": "Mistral Moderation est une API multilingue solide, mais ce n'est qu'un modèle. OpenModeration s'appuie sur sa propre IA de modération, arbitrée par d'autres modèles d'IA sur les cas délicats, avec pré-filtrage, règles automatiques et journal d'audit prêt pour le DSA.",
  "inLanguage": "fr",
};

const comparisonPoints = [
  { feature: "Moteur d'IA", mistral: "Le modèle de modération de Mistral uniquement", openmod: "Notre propre IA de modération, arbitrée par d'autres modèles d'IA sur les cas délicats" },
  { feature: "Catégories", mistral: "11 catégories fixes dans le modèle actuel, dont les données personnelles et le jailbreak", openmod: "10 catégories standardisées, entièrement personnalisables grâce à des consignes en langage courant" },
  { feature: "Langues", mistral: "Très bon en multilingue (français, allemand, espagnol, italien, portugais, etc.)", openmod: "Modération multilingue, dont le français, l'anglais, l'allemand, l'espagnol et l'italien" },
  { feature: "Pré-filtrage", mistral: "Non disponible", openmod: "Filtre de mots intégré qui bloque les contenus évidents avant toute analyse par l'IA" },
  { feature: "Moteur de décision", mistral: "Scores bruts uniquement", openmod: "Double seuil : approbation automatique / zone grise → traitée par notre équipe / rejet automatique" },
  { feature: "Taille d'entrée maximale", mistral: "32 000 caractères", openmod: "Jusqu'à 32 000 caractères + traitement en batch pour les gros volumes" },
  { feature: "Console", mistral: "API uniquement, sans interface de revue.", openmod: "Console complète : chaque décision et son explication en temps réel, statistiques, intervention possible à tout moment" },
  { feature: "Évolution du modèle", mistral: "Lié au rythme de Mistral", openmod: "Quand un modèle d'IA plus performant ou moins cher sort, nous le branchons rapidement. Rien ne change de votre côté." },
  { feature: "Déploiement", mistral: "API cloud uniquement", openmod: "Cloud managé dans l'UE ; déploiement sur site possible sur demande" },
  { feature: "Conformité", mistral: "Logs d'API basiques", openmod: "Journal d'audit DSA complet avec rapports exportables" },
  { feature: "Prix", mistral: "Fixé par Mistral sur son API", openmod: "Gratuit jusqu'à 1 000 requêtes par mois. Cloud managé à partir de 99 €/mois (10 000 requêtes incluses)." },
];

const reasons = [
  {
    title: "Mistral brille sur les langues européennes, moins sur l'anglais",
    description: "L'API de modération de Mistral excelle sur les contenus en français, en allemand, en espagnol et en italien. Aucun modèle n'est le meilleur partout. OpenModeration s'appuie sur sa propre IA de modération et fait arbitrer les cas délicats par d'autres modèles d'IA, quelle que soit la langue."
  },
  {
    title: "Catégories figées ou catégories configurables",
    description: "Mistral couvre un ensemble figé de catégories. Votre communauté peut pourtant avoir besoin de détecter la désinformation, le pédopiégeage (grooming) ou des infractions à des règles qui lui sont propres. OpenModeration ajoute des catégories entièrement configurables : décrivez-les en langage courant, selon vos règles et vos cas d'usage, et l'IA classe les contenus."
  },
  {
    title: "Une API a besoin d'une couche opérationnelle",
    description: "Mistral vous donne des scores. Votre équipe a encore besoin d'une console de revue, d'un moteur d'actions (masquer, supprimer, signaler), d'une gestion des accès par rôle, de journaux d'audit pour le DSA et d'un suivi des coûts. OpenModeration fournit tout cela, et notre équipe traite les cas douteux à votre place."
  },
  {
    title: "Sans pré-filtre, vous payez pour du spam évident",
    description: "Chaque commentaire envoyé à l'endpoint de modération de Mistral compte dans votre consommation d'API. Avec le pré-filtre d'OpenModeration, le spam évident, les mots interdits et les motifs regex sont bloqués avant même l'analyse par l'IA."
  },
];

const faqItems = [
  {
    question: "Combien coûte Mistral Moderation par rapport à OpenModeration ?",
    answer: "Mistral fixe le prix de son modèle de modération sur sa propre API. OpenModeration est gratuit jusqu'à 1 000 requêtes par mois, puis le cloud managé démarre à 99 €/mois pour 10 000 requêtes, pré-filtrage, règles, revue humaine et journal d'audit inclus."
  },
  {
    question: "Quelle IA OpenModeration utilise-t-il ?",
    answer: "OpenModeration utilise sa propre IA de modération, paramétrée selon vos règles et vos cas d'usage. Sur les cas délicats, d'autres modèles d'IA arbitrent la décision. Quand un modèle plus performant ou moins cher sort, nous le branchons rapidement : rien ne change de votre côté."
  },
  {
    question: "Combien de temps prend la migration ?",
    answer: "Moins d'une heure pour remplacer l'API : un seul appel POST /v1/moderation remplace le client Mistral. La console, les règles et les journaux d'audit fonctionnent immédiatement après."
  },
  {
    question: "Le français et les autres langues européennes sont-ils pris en charge ?",
    answer: "Oui. OpenModeration modère le français, l'allemand, l'espagnol, l'italien, l'anglais et de nombreuses autres langues. Plus de 120 langues sont couvertes."
  },
  {
    question: "Chaque décision est-elle journalisée pour les audits DSA ?",
    answer: "Oui. Chaque décision, de l'IA comme d'un humain, conserve les scores de l'IA, les seuils, le modérateur et l'horodatage. Exportez le journal d'audit complet en un clic pour vos rapports de transparence DSA."
  },
];
---

<BaseLayout
  title="Alternative à Mistral Moderation : prix, comparatif, migration"
  description="Mistral Moderation donne les scores d'un seul modèle. OpenModeration ajoute son IA arbitrée par d'autres modèles, des règles, la revue humaine et l'audit DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Alternatives", href: "/fr/alternatives" }, { label: "Alternative à Mistral Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-sm font-medium text-blue-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Alternative à Mistral Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Mistral excelle pour la modération en Europe.<br/>OpenModeration en fait des décisions.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        L'API de modération de Mistral gère très bien les langues européennes. Rien ne vous oblige pourtant à dépendre d'un seul modèle.
        OpenModeration s'appuie sur sa propre IA, arbitrée par d'autres modèles sur les cas délicats,
        avec des règles automatiques, une revue humaine assurée par notre équipe et un journal d'audit conforme au DSA.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Essayer OpenModeration gratuitement</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Voir le comparatif</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pourquoi aller au-delà de Mistral seul</h2>
        <p class="mt-4 text-lg text-surface-500">Mistral est l'une des meilleures API de modération pensées pour l'Europe. Une API ne règle pourtant pas tout le travail de modération.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Une API, toute la plateforme
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Passez des scores aux décisions, avec toute la plateforme.</h2>
          <p class="mt-4 text-lg text-surface-500">
            OpenModeration analyse chaque contenu avec sa propre IA et l'entoure de pré-filtrage,
            de doubles seuils, d'actions automatiques et d'un journal d'audit complet, avec le même appel d'API.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Arbitrée par d'autres IA.</strong> Sur les cas délicats, d'autres modèles d'IA arbitrent la décision avant qu'elle soit appliquée.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Vous profitez des progrès de l'IA.</strong> Quand un modèle plus performant ou moins cher sort, nous le branchons rapidement. Rien ne change de votre côté.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Deux outils européens.</strong> Mistral comme OpenModeration sont conçus par des équipes européennes, pour les développeurs.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Mistral Moderation ou OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">L'API de Mistral donne des scores. OpenModeration fournit une plateforme complète.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Fonctionnalité</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Mistral Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.mistral}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Alternative à Mistral Moderation : questions fréquentes" />
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Comparer d'autres solutions</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/fr/alternatives/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/fr/alternatives/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/fr/alternatives/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/fr/alternatives/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/fr/alternatives/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection
    title="Une IA de modération qui suit le marché."
    subtitle="Notre propre IA, arbitrée par d'autres modèles sur les cas délicats, avec des règles automatiques et des cas douteux traités par notre équipe. Chaque décision est expliquée par écrit."
    buttonText="Essayer OpenModeration gratuitement"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
