---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';

const alternativesJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Alternatives de modération de contenu | OpenModeration",
  "description": "Comparez OpenModeration avec OpenAI, Azure AI Content Safety, Mistral, Perspective API, Hive et Checkstep.",
  "inLanguage": "fr"
};

const comparisons = [
  {
    title: "OpenAI Moderation",
    tagline: "Plateforme ou API isolée",
