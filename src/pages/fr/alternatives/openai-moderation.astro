---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# OpenAI Moderation API (appel direct)
const openai = new OpenAI({ apiKey: 'sk-...' });
const mod = await openai.moderations.create({ input: text });
// Résultat : format propre à OpenAI, 11 catégories, pas de seuils

# OpenModeration (unifié)
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({
    input: text,
    categories: ['hate', 'harassment', 'sexual', 'violence', 'self-harm', 'spam'],
    threshold: 0.5
  })
});
// En plus : pré-filtre, double seuil, actions automatiques, journal d'audit, console d'équipe`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative à l'API OpenAI Moderation : prix et comparatif",
  "description": "Vous cherchez une alternative à l'API OpenAI Moderation ? OpenModeration vous offre une modération multi-fournisseurs via une seule API, ainsi qu'une couche complète de conformité pour l'entreprise : règles automatiques, revue humaine et journal d'audit DSA.",
  "inLanguage": "fr",
};

const comparisonPoints = [
  { feature: "Fournisseurs", openai: "OpenAI uniquement (un seul fournisseur)", openmod: "10 fournisseurs : OpenAI, Azure, Mistral, HuggingFace, LLM (GPT-4o, Claude), Cohere, et d'autres" },
  { feature: "Format d'API", openai: "Format OpenAI propriétaire", openmod: "Format standardisé pour tous les fournisseurs. Changement de fournisseur sans toucher au code." },
  { feature: "Pré-filtrage", openai: "Non disponible : chaque requête passe par l'API", openmod: "Filtre de mots intégré qui bloque les contenus évidents avant tout appel d'API, pour réduire les coûts" },
  { feature: "Logique de décision", openai: "Binaire, signalé ou non, par catégorie", openmod: "Double seuil : approbation automatique / zone grise → revue humaine / rejet automatique" },
  { feature: "Console de modération", openai: "API uniquement, sans console ni interface de revue.", openmod: "Console complète : file de modération, rôles d'équipe, statistiques, état des fournisseurs" },
  { feature: "Règles automatiques", openai: "Intégration à développer vous-même", openmod: "Prêtes à l'emploi : définissez vos règles une fois, le moteur d'actions les applique automatiquement" },
  { feature: "Revue humaine", openai: "Interface de revue à développer vous-même", openmod: "File de modération intégrée, avec contexte, attribution, validation ou rejet" },
  { feature: "Journal d'audit", openai: "Limité aux logs de l'API", openmod: "Journal d'audit complet : chaque décision de l'IA et des humains est consignée et exportable pour le DSA" },
  { feature: "Dépendance fournisseur", openai: "Enfermement total dans l'écosystème OpenAI", openmod: "Aucune. BYOK, 10 fournisseurs interchangeables, export de vos données" },
  { feature: "Souveraineté des données", openai: "Données traitées sur les serveurs d'OpenAI", openmod: "Hébergé dans l'UE. Déploiement sur site possible sur demande." },
  { feature: "Prix", openai: "Endpoint gratuit (scores uniquement)", openmod: "Gratuit jusqu'à 1 000 requêtes par mois. Cloud managé à partir de 99 €/mois (10 000 requêtes incluses)." },
  { feature: "Taille d'entrée maximale", openai: "32 000 caractères", openmod: "Jusqu'à 32 000 caractères (selon le fournisseur) + traitement en batch pour les gros volumes" },
];

const reasons = [
  {
    title: "Vous dépendez de la précision d'un seul fournisseur",
    icon: "lock",
    description: "OpenAI Moderation est excellent pour les contenus en anglais, mais moins adapté aux autres langues, aux catégories de niche ou aux situations qui exigent de la redondance. Avec OpenModeration, chaque requête part vers le meilleur fournisseur : OpenAI pour la toxicité en anglais, Mistral pour le spam multilingue, des LLM pour les catégories personnalisées."
  },
  {
    title: "Un appel d'API n'est pas un workflow de modération",
    icon: "api",
    description: "Obtenir un score de toxicité d'OpenAI n'est qu'un début. Il vous reste à décider quel score déclenche quelle action, à développer une interface de revue pour les cas en zone grise, à journaliser chaque décision pour les audits et à gérer les accès de votre équipe. OpenModeration fournit tout cela d'emblée."
  },
  {
    title: "Sans pré-filtrage, chaque commentaire part vers l'API",
    icon: "cost",
    description: "L'endpoint d'OpenAI est gratuit, mais chaque commentaire y fait quand même un aller-retour, même le spam évident ou les mots interdits. Le pré-filtre d'OpenModeration les bloque avant qu'ils n'atteignent un fournisseur, ce qui réduit aussi les coûts sur les fournisseurs payants que vous ajoutez."
  },
  {
    title: "Une API seule ne suffit pas pour le DSA",
    icon: "compliance",
    description: "Le règlement européen sur les services numériques (DSA) impose des décisions de modération documentées, des mécanismes de recours et des rapports de transparence. Une réponse d'API brute ne suffit pas. OpenModeration fournit toute la couche de conformité : journaux d'audit, traçabilité des revues et rapports exportables."
  },
];

const verticals = [
  { name: "Plateformes sociales", desc: "Modérez les commentaires et publications de vos utilisateurs avec une IA attentive au contexte et des règles propres à votre communauté." },
  { name: "Applications d'IA", desc: "Filtrez à la fois les entrées des utilisateurs et les sorties du LLM. Utilisez la modération par LLM pour des catégories personnalisées et évolutives." },
  { name: "Jeux vidéo", desc: "Une modération du chat en temps réel dans plusieurs langues, avec une latence inférieure à 250 ms et des actions automatiques." },
  { name: "Marketplaces", desc: "Signalez les annonces de spam, les discours de haine dans les avis et les fuites de données personnelles avant leur mise en ligne." },
];

const faqItems = [
  {
    question: "Combien coûte l'API OpenAI Moderation par rapport à OpenModeration ?",
    answer: "L'endpoint de modération d'OpenAI est gratuit, mais il ne renvoie que des scores : pas de console, pas de règles, pas de revue humaine et pas de journal d'audit. OpenModeration est gratuit jusqu'à 1 000 requêtes par mois et continue d'utiliser omni-moderation-latest en arrière-plan ; le cloud managé démarre à 99 €/mois pour 10 000 requêtes."
  },
  {
    question: "Puis-je continuer à utiliser OpenAI comme fournisseur ?",
    answer: "Oui. Utilisez votre propre clé OpenAI (BYOK) et gardez omni-moderation-latest. Ajoutez Mistral, Azure ou Llama Guard en secours par simple configuration, sans réécrire de code."
  },
  {
    question: "Combien de temps prend la migration ?",
    answer: "Moins d'une heure : un seul appel POST /v1/moderation remplace openai.moderations.create. Les scores sont convertis dans un format standardisé, et les seuils comme les règles s'appliquent immédiatement."
  },
  {
    question: "Qu'est-ce que j'obtiens de plus que des scores bruts ?",
    answer: "Une plateforme complète : pré-filtre, double seuil (approbation automatique, revue humaine, rejet automatique), console de modération, rôles d'équipe et journal d'audit prêt pour le DSA, avec rapports exportables."
  },
  {
    question: "Quelle API de modération choisir pour la conformité en entreprise ?",
    answer: "Pour la conformité en entreprise, des scores bruts ne suffisent pas : il faut des décisions documentées, une gestion des accès par rôle, des journaux d'audit et des rapports exportables. OpenModeration fournit tout cela : chaque décision de l'IA et des humains est journalisée, les règles s'appliquent automatiquement et le journal d'audit complet s'exporte en un clic pour vos rapports de transparence DSA. L'hébergement européen et l'export de vos données vous en laissent la maîtrise."
  },
  {
    question: "OpenModeration fonctionne-t-il avec le modèle omni-moderation-latest d'OpenAI ?",
    answer: "Oui. Utilisez votre propre clé OpenAI et envoyez toutes vos requêtes vers omni-moderation-latest comme modèle principal. Les réponses sont standardisées entre fournisseurs, et vous pouvez ajouter Mistral, Azure ou HuggingFace en secours par simple configuration, sans réécrire de code."
  },
];
---

<BaseLayout
  title="Alternative à l'API OpenAI Moderation : prix et comparatif"
  description="L'endpoint gratuit d'OpenAI ne renvoie que des scores. OpenModeration ajoute 10 fournisseurs, le pré-filtrage, les règles, la revue humaine et l'audit DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "Alternatives", href: "/fr/alternatives" }, { label: "Alternative à OpenAI Moderation" }]} />
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-50 px-4 py-1.5 text-sm font-medium text-green-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Alternative à l'API OpenAI Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        OpenAI Moderation vous donne des scores.<br/>OpenModeration en tire des décisions.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        L'API Moderation d'OpenAI vous donne des scores de toxicité. OpenModeration vous donne tout un
        dispositif Trust &amp; Safety : 10 fournisseurs via une seule API, pré-filtrage, règles automatiques,
        revue humaine et journal d'audit conforme au DSA. Vous pouvez changer de fournisseur quand vous le souhaitez.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Essayer OpenModeration gratuitement</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Voir le comparatif complet</a>
      </div>
    </div>
  </section>

  <!-- Why switch section -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pourquoi les équipes quittent OpenAI Moderation</h2>
        <p class="mt-4 text-lg text-surface-500">L'API d'OpenAI est un excellent moteur de modération. Il vous reste pourtant à construire tout ce qui l'entoure.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
              {r.icon === 'lock' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>}
              {r.icon === 'api' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>}
              {r.icon === 'cost' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
              {r.icon === 'compliance' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>}
            </div>
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Une intégration, autant de fournisseurs que vous voulez
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            La même modération de texte, avec plus de contrôle
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Avec l'API d'OpenAI, vous obtenez des scores. Avec OpenModeration, vous obtenez des scores
            <strong>et</strong> du pré-filtrage, des seuils configurables, des actions automatiques
            et un journal d'audit complet, avec un seul appel d'API.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Continuez d'utiliser OpenAI</strong> comme fournisseur via OpenModeration, avec vos propres clés d'API (BYOK).</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Ajoutez de la redondance</strong> en basculant vers Mistral, Azure ou HuggingFace quand OpenAI ralentit ou tombe en panne.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Comparez les fournisseurs</strong> objectivement grâce à des statistiques unifiées sur tout votre trafic de modération.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">API OpenAI Moderation ou OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Le comparatif point par point des fonctionnalités qui comptent pour une modération en production.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Fonctionnalité</th>
              <th class="px-6 py-4 font-semibold text-surface-500">API OpenAI Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.openai}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Hidden cost vs advantage -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            L'API OpenAI Moderation seule
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Chaque commentaire part vers l'API, même le spam évident ou les mots interdits</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Signalé ou non, sans nuance : pas de zone grise pour les contenus ambigus</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Une console à développer vous-même pour que les modérateurs examinent les cas limites</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Un moteur de règles à développer vous-même pour traduire les scores en actions</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Un système de journalisation à développer vous-même pour la conformité DSA</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Aucune solution de secours si OpenAI ralentit ou est indisponible</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Une dépendance à l'écosystème OpenAI</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            OpenModeration (avec OpenAI comme fournisseur)
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Le pré-filtre bloque le spam évident et les mots interdits avant tout appel d'API, soit 10 à 30 % d'économies</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Deux seuils configurables décident si un contenu est approuvé, rejeté ou envoyé en revue humaine</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Votre équipe Trust &amp; Safety examine les contenus dès le premier jour, dans une console déjà prête</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Vos règles tiennent en trois outils (mots interdits, seuils par catégorie et consignes en langage courant) et se règlent sans code.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Le journal d'audit est complet, les rapports s'exportent et la durée de conservation des données se configure</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Si OpenAI ralentit, les requêtes partent automatiquement vers Mistral, Azure ou HuggingFace</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> La plateforme fonctionne avec vos propres clés (BYOK), est hébergée dans l'UE et vous pouvez exporter vos données. Vos données et vos règles restent les vôtres.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pensé pour tous les cas d'usage de la modération de contenu</h2>
        <p class="mt-4 text-lg text-surface-500">Que vous remplaciez l'API d'OpenAI ou que vous la complétiez, OpenModeration s'intègre à votre stack.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{v.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- omni-moderation-latest compatibility -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Compatible avec omni-moderation-latest d'OpenAI, et 9 autres modèles</h2>
        <p class="mt-4 text-lg text-surface-500">Gardez le modèle de modération OpenAI en qui vous avez déjà confiance comme moteur principal, et entourez-le d'une plateforme.</p>
        <p class="mt-2 text-sm"><a href="/fr/blog/guide-api-openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">Comment fonctionne l'API OpenAI Moderation : catégories, prix et limites &rarr;</a></p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Gardez omni-moderation-latest</h3>
          <p class="mt-2 text-sm text-surface-500">Utilisez votre propre clé OpenAI (BYOK) et envoyez chaque requête vers omni-moderation-latest : même modèle, format de réponse standardisé.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
