    { eyebrow: "Réglementation", title: "Conformité DSA", text: "Ce que le DSA exige des sites qui hébergent des commentaires.", href: "/fr/conformite-dsa" },
  ]}
  ctaTitle="Voyez le système tourner sur vos commentaires."
