---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModerationDemo from '../../components/ModerationDemo.astro';
import { bookingUrl, useTranslations } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import ValueCards from '../../components/ValueCards.astro';
import AppVideo from '../../components/AppVideo.astro';
import AIEngine from '../../components/AIEngine.astro';
import SwitchProvider from '../../components/SwitchProvider.astro';
import CostCalculator from '../../components/CostCalculator.astro';
import TeamSection from '../../components/TeamSection.astro';
import PricingTeaser from '../../components/PricingTeaser.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "description": "AI comment moderation adapted to each client's rules and use cases, with a team that sets it up. DSA-compliant, hosted in the EU.",
      "email": "contact@openmoderation.com",
      "areaServed": "EU",
      "knowsAbout": ["Comment moderation", "Content moderation", "Social media moderation", "Digital Services Act compliance", "Trust and safety"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "contact@openmoderation.com",
        "url": "https://www.openmoderation.com/book-a-call",
        "availableLanguage": ["English", "French", "Spanish", "German", "Italian"]
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/fr#software",
      "name": "OpenModeration",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Modération des commentaires par IA pour les médias, les marques et les réseaux sociaux, adaptée à vos règles et à vos cas d'usage. Fonctionne sur votre site, Facebook, Instagram, YouTube et WordPress, confie les cas douteux à notre équipe, explique chaque décision par écrit et vous la montre en temps réel, et est conforme au DSA. Vous branchez vos pages, on s'occupe du reste.",
      "inLanguage": "fr",
      "url": "https://www.openmoderation.com/fr",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Commentaires modérés chaque jour", value: "10 M+" },
  { label: "Opérationnel en", value: "5 min" },
  { label: "Modération automatique", value: "24 h/24" },
  { label: "Décisions expliquées par écrit", value: "100 %" },
];

const valueItems = [
  { title: "Vos règles, vos cas d'usage", text: "Pas une liste de mots : vos règles, lues dans leur contexte. On adapte la modération à ce qui compte pour vous : ironie, politique, concurrents, expressions locales. Rien de générique." },
  { title: "Une équipe derrière l'outil", text: "On vous aide à écrire et à affiner vos règles, on traite nous-mêmes les cas douteux et on ajuste quand votre communauté évolue. Vous avez toujours quelqu'un à qui parler." },
  { title: "Tout tourne en automatique", text: "Vous branchez vos pages : chaque commentaire est traité en quelques secondes, jour et nuit, et notre équipe s'occupe des cas douteux. Vous n'avez rien à faire, mais vous voyez chaque décision en temps réel et pouvez intervenir quand vous voulez." },
  { title: "Bien moins cher qu'à la main", text: "La modération automatique coûte une fraction d'une équipe de modération interne ou externalisée." },
];


const faqItems = [
  {
    question: "L'IA modère-t-elle seule ?",
    answer: "Non. Notre IA est paramétrée sur vos règles. Elle décide seule quand elle est sûre, et chaque décision est recoupée par d'autres modèles d'IA. Quand il y a un doute, le contenu part à notre équipe, qui tranche et vous rend compte de ce qu'elle a traité.",
  },
  {
    question: "Comment l'IA connaît-elle notre ligne éditoriale ?",
    answer: "Nous partons de votre charte et de vos cas d'usage : ce que vous acceptez, ce que vous refusez, les cas limites. Quand vous corrigez une décision, nous ajustons les règles avec vous. Ce n'est pas une liste de mots interdits : l'IA lit chaque commentaire dans son contexte.",
  },
  {
    question: "Peut-on tester avant de s'engager ?",
    answer: "Oui. En bac à sable, OpenModeration analyse vos vrais commentaires sans rien publier ni masquer. Vous voyez ce que nous aurions accepté ou refusé, avec la raison, et vous comparez avec votre modération actuelle.",
  },
  {
    question: "Peut-on tester sans quitter notre prestataire actuel ?",
    answer: "Oui. Le bac à sable tourne en parallèle, sans toucher à votre production. Vous comparez décision par décision, puis vous choisissez en connaissance de cause, au moment qui vous convient.",
  },
  {
    question: "Que voit-on de notre côté ?",
    answer: "Tout, en temps réel : chaque commentaire, la décision prise, la raison écrite et l'historique. Vous n'avez rien à faire, mais vous pouvez corriger une décision ou intervenir à tout moment.",
  },
  {
    question: "Pourquoi un commentaire a-t-il été refusé ?",
    answer: "Chaque décision porte une raison écrite (insulte, attaque personnelle, spam…), que vous pouvez transmettre à l'auteur. C'est plus clair pour vos lecteurs et plus simple à justifier en cas de contestation.",
  },
  {
    question: "OpenModeration aide-t-il à respecter le DSA ?",
    answer: "OpenModeration est conçu pour le DSA : une raison écrite pour chaque décision, un historique traçable, les signalements suivis et les contestations traitées. Vous restez l'éditeur responsable, et vous avez les éléments pour justifier chaque décision.",
  },
  {
    question: "Que se passe-t-il quand l'IA hésite ?",
    answer: "Le contenu est mis de côté et notre équipe le traite selon vos règles. Vous recevez un compte rendu des cas traités et des points à clarifier dans votre charte.",
  },
  {
    question: "Sur quelles plateformes fonctionne OpenModeration ?",
    answer: "Votre site web, Facebook, Instagram, YouTube et WordPress en natif, avec des connecteurs prêts à l'emploi que vous branchez en quelques minutes. TikTok, X, LinkedIn et les autres réseaux sont ajoutés sur demande, facilement.",
  },
  {
    question: "Où sont hébergées nos données ?",
    answer: "Dans l'Union européenne. Les commentaires ne servent qu'à la modération de vos espaces.",
  },
  {
    question: "Faut-il mobiliser notre équipe technique ?",
    answer: "Très peu. Pour les réseaux sociaux et WordPress, il suffit de connecter vos comptes. Pour un site ou un outil maison, une API permet d'envoyer vos commentaires et de recevoir chaque décision avec sa raison.",
  },
  {
    question: "Combien ça coûte ?",
    answer: "Le prix dépend du volume de commentaires à modérer. Nous vous proposons un forfait prévisible après un test sur vos propres commentaires, pour que vous jugiez la qualité avant de parler budget.",
  },
];
---

<BaseLayout
  title="Modération IA des commentaires, conforme DSA | OpenModeration"
  description="Modération IA des commentaires adaptée à vos règles et cas d'usage, sur votre site et vos réseaux. Conforme DSA, hébergée dans l'UE, avec accompagnement humain."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-violet-50" />
    <div class="joy-blob pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-300/40 blur-3xl" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute -right-24 top-10 h-[28rem] w-[28rem] rounded-full bg-violet-300/40 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-sun-300/30 blur-3xl" style="animation-delay:-12s" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16">
      <div class="text-center lg:text-left">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Pour les médias, les marques et les réseaux sociaux
        </div>
        <h1 class="animate-fade-in-up text-4xl font-extrabold leading-[1.05] tracking-tight text-surface-900 sm:text-5xl lg:text-[3.7rem]">
          Une modération qui s'adapte à <em>vos</em> règles.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-600 sm:text-xl">
          Vous branchez vos pages, on s'occupe du reste : l'IA est configurée selon vos règles et vos cas d'usage, notre équipe traite les cas douteux,
          et vous voyez chaque décision en temps réel, pour bien moins cher qu'une modération manuelle.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Prendre rendez-vous
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Essayer gratuitement
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">Ou testez un commentaire tout de suite, sans inscription</a></p>
        <div class="animate-fade-in-up delay-2 mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-surface-500 lg:justify-start">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            Conçu et hébergé dans l'UE
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Conforme au RGPD
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Accompagnement humain inclus
          </span>
        </div>
      </div>
      <HeroAnimation />
    </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Une modération mise en place avec vous, pas un outil à comprendre seul</h2>
      </div>
      <ValueCards items={valueItems} />
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Prendre rendez-vous pour le voir sur vos commentaires</a>
      </div>
    </div>
  </section>

  <AppVideo />

  <AIEngine />

  <SwitchProvider />

  <section id="demo" class="bg-gradient-to-br from-violet-50 via-white to-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Dark Contrast Section: DSA Compliance -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800 px-4 py-1.5 text-sm text-surface-300">
          <svg class="h-4 w-4 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Prêt pour le DSA
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Conçu pour la conformité réglementaire
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-surface-400">
          Chaque décision de modération est enregistrée dans un journal d'audit complet. La durée de conservation
          des données est configurable, les rapports de transparence sont exportables,
          et vos données restent hébergées dans l'UE.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm">
            Essayer gratuitement
          </a>
          <a href="/fr/conformite-dsa" class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
            En savoir plus sur la conformité DSA
          </a>
        </div>
        <p class="mt-4 text-sm text-surface-400">Sans carte bancaire</p>
      </div>
    </div>
  </section>

  <CostCalculator />

  <PricingTeaser />



  <TeamSection />

  <section class="bg-white pb-6 pt-2">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/fr/integrations/moderation-facebook" class="text-sm font-medium text-brand-600 hover:text-brand-500">Outil de modération des commentaires Facebook &rarr;</a>
        <a href="/fr/integrations/moderation-instagram" class="text-sm font-medium text-brand-600 hover:text-brand-500">Modération automatique sur Instagram &rarr;</a>
        <a href="/fr/console-de-moderation" class="text-sm font-medium text-brand-600 hover:text-brand-500">Console de modération unifiée &rarr;</a>
        <a href="/fr/cas-usage/medias" class="text-sm font-medium text-brand-600 hover:text-brand-500">Modération de commentaires pour les médias &rarr;</a>
        <a href="/fr/cas-usage/marques-retail" class="text-sm font-medium text-brand-600 hover:text-brand-500">Modération des commentaires pour les marques &rarr;</a>
        <a href="/fr/blog/moderation-des-commentaires-guide" class="text-sm font-medium text-brand-600 hover:text-brand-500">Le guide de la modération des commentaires &rarr;</a>
        <a href="/fr/alternatives/openai-moderation" class="text-sm font-medium text-surface-500 hover:text-surface-700">Comparer avec les alternatives &rarr;</a>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Les questions que se posent les équipes avant de choisir une plateforme de modération" items={faqItems} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
