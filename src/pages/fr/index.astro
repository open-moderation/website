---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModerationDemo from '../../components/ModerationDemo.astro';
import { BOOKING_URL, useTranslations } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';
import CharterSupport from '../../components/CharterSupport.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/fr#software",
      "name": "OpenModeration",
      "applicationCategory": "SecurityApplication",
      "operatingSystem": "Linux, Docker",
      "description": "Plateforme de modération open source pour les commentaires et les réseaux sociaux. Une API sur plusieurs fournisseurs d'IA, des règles en langage courant, une explication écrite pour chaque décision et un journal d'audit DSA.",
      "inLanguage": "fr",
      "url": "https://www.openmoderation.com/fr",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Commentaires modérés chaque jour", value: "10 M+" },
  { label: "Opérationnel en", value: "5 min" },
  { label: "Modération automatique", value: "24 h/24" },
  { label: "Décisions expliquées par écrit", value: "100 %" },
];

const valueItems = [
  { title: "Votre charte, vos cas limites", text: "On paramètre la modération à partir de votre charte et des cas qui comptent pour vous : ironie, politique, concurrents, expressions locales. Rien de générique." },
  { title: "Une équipe derrière l'outil", text: "On vous aide à écrire et à affiner vos règles, on regarde les cas douteux avec vous et on ajuste quand votre communauté évolue. Vous avez toujours quelqu'un à qui parler." },
  { title: "Tout tourne en automatique", text: "Une fois les règles posées, chaque commentaire est traité en quelques secondes, jour et nuit. Votre équipe ne voit que les cas qui demandent un humain." },
  { title: "Bien moins cher qu'à la main", text: "La modération automatique coûte une fraction d'une équipe de modération interne ou externalisée." },
];


const faqItems = [
  {
    question: 'Quelle plateforme de modération réunit une console pour les modérateurs, une IA qui comprend le contexte et un journal d\'audit pour la conformité ?',
    answer: 'OpenModeration réunit les trois. Une IA sensible au contexte lit chaque commentaire, vos règles décident de ce qui est masqué, publié ou envoyé en revue, vos modérateurs travaillent depuis une seule console, et chaque décision est enregistrée avec une explication écrite pour les audits DSA.',
  },
  {
    question: 'Existe-t-il un outil sans code pour écrire des règles de modération, utiliser une classification par IA et conserver un journal d\'audit ?',
    answer: 'Oui. Dans OpenModeration, vous rédigez vos règles en langage courant et réglez des seuils par catégorie sans écrire de code. La classification par IA s\'applique à chaque commentaire, et le journal d\'activité enregistre chaque action, qui ou quoi l\'a déclenchée, et pourquoi.',
  },
  {
    question: 'Puis-je modérer Facebook, Instagram, YouTube et mon site web depuis un seul endroit ?',
    answer: 'Oui. Connectez vos Pages Facebook, vos comptes Instagram, vos chaînes YouTube et votre site WordPress, ou envoyez les contenus de n\'importe quelle plateforme via l\'API. Tout arrive dans la même file de modération, avec les mêmes règles.',
  },
  {
    question: 'Quels critères retenir pour choisir une API de modération adaptée à la conformité en entreprise ?',
    answer: 'Vérifiez qu\'elle fournit un exposé des motifs écrit pour chaque décision (exigé par l\'article 17 du DSA), un journal d\'audit complet, un hébergement des données dans l\'UE, une durée de conservation configurable et la possibilité d\'auto-héberger. OpenModeration coche ces cinq cases et est open source sous licence AGPL v3 : la logique de décision peut donc être auditée.',
  },
  {
    question: 'OpenModeration est-il gratuit ?',
    answer: 'L\'offre cloud est gratuite jusqu\'à 1 000 requêtes par mois, l\'offre Pro coûte 99 € par mois pour 10 000 requêtes, et la version auto-hébergée est gratuite puisque le code est open source.',
  },
];
---

<BaseLayout
  title="Modération IA des commentaires, conforme DSA | OpenModeration"
  description="Modération des commentaires par IA selon votre charte, sur votre site et vos réseaux sociaux. Conforme DSA, hébergée dans l'UE, avec un accompagnement humain."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-surface-50" />
    <div class="relative mx-auto max-w-7xl px-4 pb-12 pt-8 sm:px-6 lg:px-8 lg:pt-12">
      <div class="mx-auto max-w-3xl text-center">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Pour les médias, les marques et les réseaux sociaux
        </div>
        <h1 class="animate-fade-in-up text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl lg:text-6xl">
          Une modération qui applique <em>votre</em> charte.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-500 sm:text-xl">
          On configure l'IA avec votre charte et vos cas limites, notre équipe vous accompagne,
          et chaque commentaire est traité automatiquement, pour bien moins cher qu'une modération manuelle.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Prendre rendez-vous
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Essayer gratuitement
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">Ou testez un commentaire tout de suite, sans inscription</a></p>
        <div class="animate-fade-in-up delay-2 mt-2 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-surface-400">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            Conçu et hébergé dans l'UE
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Conforme au RGPD
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Accompagnement humain inclus
          </span>
        </div>
      </div>
    </div>
    <!-- Animation produit (30 s, muette, en boucle) : montre l'app dès le premier écran -->
    <div class="animate-fade-in-up delay-3 relative mx-auto max-w-5xl px-4 pb-14 sm:px-6 lg:px-8">
      <div class="overflow-hidden rounded-xl border border-surface-200 bg-white shadow-[0_24px_48px_-12px_rgba(30,58,138,0.18)]">
        <video
          src="/videos/om-film.mp4"
          poster="/videos/om-film.jpg"
          width="1440"
          height="810"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Animation : les commentaires arrivent dans OpenModeration, chacun reçoit une décision et sa raison écrite"
          class="block aspect-video h-auto w-full object-cover"
        ></video>
      </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Une modération mise en place avec vous, pas un outil à comprendre seul</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {valueItems.map((item) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-surface-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{item.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Prendre rendez-vous pour le voir sur vos commentaires</a>
      </div>
    </div>
  </section>

  <section id="demo" class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Problem / Solution -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Le problème
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            Les commentaires haineux font fuir votre communauté.
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Insultes, spam et arnaques s'accumulent sous vos publications, sur chaque plateforme et chaque jour.
            Les filtres natifs passent à côté du sarcasme, du langage codé et de tout ce qui est multilingue,
            et le nettoyage manuel vous coûte plus de 10 heures par semaine.
          </p>
          <p class="mt-4 text-lg text-surface-500">
            OpenModeration applique vos règles automatiquement sur Facebook, Instagram, YouTube et
            WordPress, et affiche une explication écrite pour chaque commentaire masqué.
          </p>
          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Avant :</strong> vous lisez, triez et supprimez les commentaires haineux à la main, sur chaque plateforme, tous les jours.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Après :</strong> vos règles s'appliquent automatiquement sur Facebook, Instagram, YouTube et WordPress. Chaque commentaire masqué est accompagné d'une explication écrite.</p>
            </div>
          </div>
          <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
              Essayer gratuitement
            </a>
            <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
              Prendre rendez-vous
            </a>
          </div>
        </div>
        <BrowserFrame
          caption="Un commentaire masqué, la règle enfreinte et l'explication écrite : visibles par votre équipe, défendables devant n'importe qui."
        >
          <ModerationVerdict slot="content" />
          <div slot="annotation" class="absolute bottom-3 right-3 rounded-full border border-brand-200 bg-white/95 px-3 py-1 text-xs font-semibold text-brand-800 shadow-sm">
            &#x270D; L'explication écrite
          </div>
        </BrowserFrame>
      </div>
    </div>
  </section>

  <!-- Beyond the API -->
  <section class="bg-white py-20 border-t border-surface-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          Ce qu'il faut pour protéger une communauté
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          Un filtre par mots-clés ne suffit pas. Vos règles doivent s'appliquer partout, les cas limites doivent arriver chez votre équipe et chaque décision doit être expliquée.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Une simple API de modération
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Des scores bruts, sans le contexte de la conversation</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Aucune interface pour que vos modérateurs examinent les cas limites</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Rien de prévu pour gérer les signalements des utilisateurs ou les rôles de l'équipe</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> La conformité et le journal d'audit entièrement à votre charge</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Le dispositif OpenModeration
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> L'IA lit le contexte et repère les nuances qu'une liste de mots-clés laisse passer.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Vos équipes Trust & Safety examinent les cas limites dans une interface de revue dédiée.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Signalements, rôles des membres et permissions se gèrent depuis la même console.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Chaque décision, humaine ou automatique, est enregistrée pour les audits réglementaires.</li>
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/fr/integrations/moderation-facebook" class="text-sm font-medium text-brand-600 hover:text-brand-500">Outil de modération des commentaires Facebook &rarr;</a>
        <a href="/fr/integrations/moderation-instagram" class="text-sm font-medium text-brand-600 hover:text-brand-500">Modération automatique sur Instagram &rarr;</a>
        <a href="/fr/console-de-moderation" class="text-sm font-medium text-brand-600 hover:text-brand-500">Console de modération unifiée &rarr;</a>
        <a href="/fr/cas-usage/medias" class="text-sm font-medium text-brand-600 hover:text-brand-500">Modération de commentaires pour les médias &rarr;</a>
        <a href="/fr/cas-usage/marques-retail" class="text-sm font-medium text-brand-600 hover:text-brand-500">Modération des commentaires pour les marques &rarr;</a>
        <a href="/fr/alternatives/openai-moderation" class="text-sm font-medium text-surface-500 hover:text-surface-700">Comparer avec les alternatives &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Full Pipeline -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          La chaîne de modération complète
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          De la collecte à l'action, OpenModeration prend en charge chaque étape.
        </p>
      </div>
      <div class="grid gap-4 grid-cols-2 md:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-5 text-center transition hover:shadow-md">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">1. Collecter</h3>
          <p class="mt-1 text-xs text-surface-500">Les contenus arrivent par l'API, les réseaux sociaux ou des webhooks</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-5 text-center shadow-sm transition hover:shadow-md">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-600 text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">2. Analyser</h3>
          <p class="mt-1 text-xs text-surface-500">L'IA examine les contenus avec plusieurs fournisseurs</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-5 text-center transition hover:shadow-md">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">3. Décider</h3>
          <p class="mt-1 text-xs text-surface-500">Vos règles s'appliquent automatiquement</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-5 text-center transition hover:shadow-md">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">4. Réviser</h3>
          <p class="mt-1 text-xs text-surface-500">Les cas limites sont transmis à votre équipe</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark Contrast Section: DSA Compliance -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
