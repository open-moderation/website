---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/fr/api-moderation-texte",
      "url": "https://www.openmoderation.com/fr/api-moderation-texte",
      "name": "API de modération de texte : commentaires, chat et messages",
      "description": "Une API de modération de texte qui filtre les commentaires toxiques, les messages de chat et les avis d'utilisateurs : 10 fournisseurs derrière un seul point d'accès, règles sur mesure, double seuil et journal d'audit DSA.",
      "inLanguage": "fr",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/fr/api-moderation-texte#software",
      "name": "OpenModeration Text Moderation API",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Tous (API REST)",
      "description": "API de modération de texte : un point d'accès, 10 fournisseurs, règles sur mesure, double seuil, points d'accès par lots et journal d'audit DSA.",
      "inLanguage": "fr",
      "url": "https://www.openmoderation.com/fr/api-moderation-texte",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
    }
  ]
};

const quickstart = `# Modérez n'importe quel texte : commentaires, chat, messages, avis
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "user comment here",
    "model": "openai/omni-moderation-latest",
    "categories": ["hate", "harassment", "sexual", "violence", "self-harm", "spam"],
    "threshold": 0.5
  }'

# Réponse (standardisée quel que soit le fournisseur)
{
  "flagged": false,
  "results": [{ "category": "harassment", "score": 0.03, "flagged": false }],
  "usage": { "provider": "openai", "latency_ms": 212 }
}`;

const useCases = [
  { name: "Commentaires et avis", desc: "Masquez automatiquement discours de haine, spam et fuites de données personnelles dans les commentaires, avis et messages de forum, avant leur publication." },
  { name: "Chat et messagerie", desc: "Une modération de texte en temps réel dans plusieurs langues, avec une latence inférieure à 250 ms et des actions automatiques." },
  { name: "Prompts d'applications IA", desc: "Filtrez à la fois les entrées des utilisateurs et les réponses des LLM. Appuyez-vous sur une modération par LLM pour des catégories sur mesure et évolutives." },
  { name: "Annonces de marketplace", desc: "Signalez dès leur dépôt les annonces de spam, les arnaques et les contenus interdits dans les titres et les descriptions." },
];

const faqItems = [
  {
    question: "Qu'est-ce qu'une API de modération de texte ?",
    answer: "Une API de modération de texte attribue des scores aux textes générés par les utilisateurs (haine, harcèlement, contenus sexuels, violence, spam, données personnelles…) pour que votre application puisse les approuver, les signaler ou les rejeter automatiquement. OpenModeration réunit 10 fournisseurs derrière un seul point d'accès, avec un format de réponse standardisé, des règles sur mesure et un journal d'audit."
  },
  {
    question: "Quelle API de modération de texte choisir ?",
    answer: "Les API d'un seul fournisseur (OpenAI, Azure, Mistral) permettent de démarrer vite, mais vous enferment dans un seul profil de précision et un seul tarif. OpenModeration envoie chaque requête au fournisseur le plus adapté (OpenAI pour la toxicité en anglais, Mistral pour les langues européennes, des LLM pour les catégories sur mesure) et ajoute préfiltrage, règles et console de revue."
  },
  {
    question: "Combien coûte une API de modération de texte ?",
    answer: "Le point d'accès de modération d'OpenAI est gratuit, Mistral fixe lui-même le prix de son modèle de modération, et Azure AI Content Safety facture par tranche de 1 000 enregistrements de texte au-delà d'un palier gratuit de 5 000 enregistrements par mois. OpenModeration est gratuit en auto-hébergement ; le cloud géré démarre à 99 €/mois pour 10 000 requêtes, et le préfiltrage supprime 10 à 30 % des appels facturables."
  },
  {
    question: "Puis-je définir des règles de modération sur mesure ?",
    answer: "Oui, avec trois outils et sans code : les mots interdits (blocage immédiat), les seuils par catégorie (approbation automatique, revue humaine ou rejet automatique) et des règles en langage courant, appliquées par des LLM pour des catégories sur mesure comme la désinformation ou le grooming."
  },
  {
    question: "Puis-je migrer depuis openai text-moderation-latest ?",
    answer: "Oui. Remplacez openai.moderations.create par un seul appel POST /v1/moderation avec le modèle openai/omni-moderation-latest. Gardez votre clé OpenAI (BYOK), puis ajoutez des fournisseurs de secours sans réécrire votre code."
  },
  {
    question: "Chaque décision de modération de texte est-elle enregistrée ?",
    answer: "Oui. Chaque décision, prise par l'IA ou par un humain, conserve les scores du fournisseur, les seuils, le nom du relecteur et l'horodatage. Exportez le journal d'audit complet en un clic pour vos rapports de transparence DSA."
  },
];
---

<BaseLayout
  title="API de modération de texte : commentaires, chat et messages"
  description="Une API de modération de texte pour OpenAI, Mistral, Azure et 7 autres fournisseurs. Masquez commentaires toxiques, spam et données personnelles. Audit DSA. Gratuit."
  jsonLd={pageJsonLd}
>
  <Breadcrumb items={[{ label: "Accueil", href: "/fr" }, { label: "API de modération de texte" }]} />

  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Pour les développeurs : API REST et console
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Une API de modération de texte qui transforme les scores en décisions.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Un seul point d'accès envoie chaque texte (commentaires, chat, messages, avis) vers OpenAI,
        Mistral, Azure, Llama Guard et d'autres. Le préfiltrage, les règles sur mesure, le double seuil
        et un journal d'audit prêt pour le DSA sont inclus.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Obtenir une clé d'API gratuite
        </a>
        <a href="https://api.openmoderation.com/docs" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          Lire la documentation de l'API &rarr;
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Auto-hébergement gratuit · Sans carte bancaire · Référence OpenAPI</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Modérez n'importe quel texte en une requête</h2>
          <p class="mt-4 text-lg text-surface-500">
            Envoyez votre texte vers un seul point d'accès. Choisissez le fournisseur à chaque requête ou laissez le routeur intelligent décider.
            Les scores reviennent dans un format standardisé, avec des seuils que vous maîtrisez.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>10 catégories, plus de 120 langues</strong> : haine, harcèlement, contenus sexuels, violence, automutilation, spam, données personnelles et catégories sur mesure via LLM.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Préfiltrage</strong> : bloquez le spam évident et les mots interdits avant tout appel facturable à un fournisseur.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Double seuil</strong> : approbation automatique, zone grise envoyée en revue humaine, rejet automatique.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Lots jusqu'à 10 000 textes</strong>, avec le même schéma que les appels unitaires.</span></li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3 text-sm">
            <a href="/fr/api-moderation-contenu" class="font-medium text-brand-600 hover:text-brand-500">L'API de modération de contenu complète &rarr;</a>
            <a href="/fr/alternatives/openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">Alternative à OpenAI Moderation &rarr;</a>
            <a href="/fr/fonctionnalites" class="font-medium text-brand-600 hover:text-brand-500">Toutes les fonctionnalités de l'API &rarr;</a>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={quickstart} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Conçue pour tous les usages de la modération de texte</h2>
        <p class="mt-4 text-lg text-surface-500">Une seule API, partout où vos utilisateurs écrivent.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {useCases.map((u) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{u.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{u.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">API d'un seul fournisseur ou OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Un score de toxicité brut ne constitue pas un système de modération.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Capacité</th>
              <th class="px-6 py-4 font-semibold text-surface-500">API de texte d'un seul fournisseur</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            <tr><td class="px-6 py-4 font-medium text-surface-900">Fournisseurs</td><td class="px-6 py-4 text-surface-500">1 (dépendance)</td><td class="px-6 py-4">10 : OpenAI, Mistral, Azure, Llama Guard, Perspective, Hive…</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Règles sur mesure</td><td class="px-6 py-4 text-surface-500">À développer soi-même</td><td class="px-6 py-4">Mots interdits, seuils, règles en langage courant appliquées par LLM, sans code</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Revue humaine</td><td class="px-6 py-4 text-surface-500">À développer soi-même</td><td class="px-6 py-4">File de modération intégrée, avec contexte et attribution</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Journal d'audit</td><td class="px-6 py-4 text-surface-500">Logs d'API uniquement</td><td class="px-6 py-4">Export DSA complet des décisions IA et humaines</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Tarifs</td><td class="px-6 py-4 text-surface-500">Fixés par chaque fournisseur, de gratuit (OpenAI) à facturé à l'appel</td><td class="px-6 py-4">Auto-hébergement gratuit · cloud géré dès 99 €/mois · le préfiltrage fait économiser 10 à 30 %</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="API de modération de texte : FAQ" />
    </div>
  </section>

  <CTASection
    title="Commencez à modérer du texte en quelques minutes."
    subtitle="Obtenez une clé d'API, copiez l'exemple curl et modérez votre premier texte. Règles, file de modération et journal d'audit sont disponibles dès le premier jour."
    buttonText="Essayer l'API gratuitement"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
