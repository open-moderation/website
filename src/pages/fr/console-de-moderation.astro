---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'fr';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Console de modération : chaque décision et sa raison, en direct",
  "description": "Chaque commentaire, sa décision et sa raison écrite en temps réel, sur votre site et vos réseaux. Notre équipe traite les cas douteux ; vous corrigez si besoin.",
  "crumb": "Console de modération",
  "badge": "Ce que vous voyez en temps réel",
  "h1": "Chaque décision et sa raison, en temps réel",
  "lead": "La console n’est pas un outil que vous devez faire tourner. Notre IA et notre équipe modèrent ; vous voyez chaque commentaire, la décision, sa raison écrite et qui l’a prise, et vous pouvez corriger quand vous voulez.",
  "feedTitle": "Votre modération, au fil de l’eau",
  "feedLead": "Les commentaires de votre site et de vos pages, côte à côte, chacun avec sa décision et la raison qui la justifie.",
  "quote": [
    "« ",
    " »"
  ],
  "reasonLabel": "Raison :",
  "overrideLabel": "Corriger",
  "feed": [
    {
      "platform": "Site",
      "kind": "published",
      "decision": "Publié",
      "by": "Notre IA",
      "text": "Bon article, mais les chiffres du deuxième paragraphe semblent datés.",
      "reason": "Critique constructive, aucune règle enfreinte."
    },
    {
      "platform": "Facebook",
      "kind": "refused",
      "decision": "Masqué",
      "by": "Notre IA, recoupée",
      "text": "Vous êtes tous pourris, il faudrait vous faire taire pour de bon.",
      "reason": "Menace et attaque personnelle."
    },
    {
      "platform": "Instagram",
      "kind": "refused",
      "decision": "Masqué",
      "by": "Notre IA",
      "text": "Des abonnés pas chers ici, allez voir mon profil !!!",
      "reason": "Spam."
    },
    {
      "platform": "YouTube",
      "kind": "team",
      "decision": "Refusé après examen",
      "by": "Notre équipe",
      "text": "Typique de ces gens-là, ils ne changeront jamais.",
      "reason": "Généralisation visant un groupe, contraire à votre charte."
    }
  ],
  "shotAlt": "Console OpenModeration : commentaires, décisions et raisons écrites, plateforme par plateforme",
  "shotCaption": "La console : commentaires, décisions et raisons, plateforme par plateforme.",
  "illustrative": "Exemples et chiffres d’illustration, issus d’un espace de démonstration.",
  "kpis": [
    {
      "label": "Commentaires analysés aujourd’hui",
      "value": "84,2 k"
    },
    {
      "label": "Masqués, chacun avec une raison écrite",
      "value": "4,7 %"
    },
    {
      "label": "Cas douteux traités par notre équipe",
      "value": "2 %"
    }
  ],
  "cardsTitle": "Ce que vous voyez, et ce que vous pouvez faire",
  "cardsLead": "Une transparence totale, rien à faire tourner. Vous n’intervenez que si vous le souhaitez.",
  "cards": [
    {
      "title": "Chaque décision, avec sa raison",
      "text": "Chaque commentaire, la décision prise et sa raison écrite, sur votre site et sur chaque page connectée."
    },
    {
      "title": "Les cas douteux traités par notre équipe",
      "text": "Quand l’IA hésite, notre équipe tranche selon vos règles. Vous voyez ce qu’elle a traité et pourquoi."
    },
    {
      "title": "Une correction à tout moment",
      "text": "Publier, masquer ou rétablir un commentaire en un clic. Chaque changement est enregistré avec son auteur."
    },
    {
      "title": "Signalements et contestations suivis",
      "text": "Les signalements des utilisateurs et les décisions contestées sont suivis jusqu’à la réponse, comme le demande le DSA."
    },
    {
      "title": "Des chiffres exportables",
      "text": "Volumes et décisions par catégorie, plateforme par plateforme. Exportez-les pour vos rapports DSA et vos bilans internes."
    },
    {
      "title": "Vos règles, sous vos yeux",
      "text": "Voyez les règles appliquées à vos espaces. Pour les changer, dites-le-nous ou ajustez-les vous-même : notre équipe vous aide."
    }
  ],
  "devTitle": "Pour les équipes techniques",
  "devLead": "La console donne aussi à vos développeurs de quoi intégrer et surveiller OpenModeration.",
  "devPoints": [
    "Clés d’accès, avec limites de débit et permissions par clé",
    "Historique d’activité consultable par commentaire : scores, règle appliquée et résultat",
    "État des services, avec latence et taux d’erreur",
    "Conservation des données, origines autorisées et webhooks"
  ]
};

const decisionStyles: Record<string, string> = {
  published: 'bg-green-100 text-green-700',
  refused: 'bg-red-100 text-red-700',
  team: 'bg-amber-100 text-amber-700',
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/fr/console-de-moderation",
  "url": "https://www.openmoderation.com/fr/console-de-moderation",
  "name": "Console de modération : chaque décision et sa raison, en direct",
  "description": "Chaque commentaire, sa décision et sa raison écrite en temps réel, sur votre site et vos réseaux. Notre équipe traite les cas douteux ; vous corrigez si besoin.",
  "inLanguage": "fr",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Accueil", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-accent-500"></span> {c.badge}
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- What you see: live feed -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.feedTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.feedLead}</p>
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <ul class="divide-y divide-surface-100 overflow-hidden rounded-2xl border border-surface-200 bg-white shadow-sm">
          {c.feed.map((f) => (
            <li class="p-5">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-surface-600">{f.platform}</span>
                <span class={`rounded-full px-2.5 py-0.5 font-semibold ${decisionStyles[f.kind]}`}>{f.decision}</span>
                <span class="text-surface-400">{f.by}</span>
              </div>
              <p class="mt-3 text-surface-800">{c.quote[0]}{f.text}{c.quote[1]}</p>
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
                <p class="text-surface-500"><span class="font-medium text-surface-700">{c.reasonLabel}</span> {f.reason}</p>
                <span class="rounded-md border border-surface-300 px-3 py-1 text-xs font-semibold text-surface-700">{c.overrideLabel}</span>
              </div>
            </li>
          ))}
        </ul>
        <div>
          <BrowserFrame src="/images/dashboard.png" video="om-triage" alt={c.shotAlt} caption={c.shotCaption} eager={false} />
          <p class="mt-6 text-center text-xs text-surface-400">{c.illustrative}</p>
        </div>
      </div>
      <dl class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {c.kpis.map((k) => (
          <div class="flex flex-col-reverse rounded-xl border border-surface-200 bg-surface-50 p-6">
            <dt class="mt-1 text-sm text-surface-500">{k.label}</dt>
            <dd class="text-3xl font-bold text-surface-900">{k.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- What you see and what you can do -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.cardsTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.cardsLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {c.cards.map((card) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{card.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.devTitle}</h2>
      <p class="mt-3 text-surface-500">{c.devLead}</p>
      <ul class="mt-6 space-y-2 text-sm text-surface-600">
        {c.devPoints.map((p) => (
          <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
