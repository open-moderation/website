const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Declaración de motivos (artículo 17 de la DSA): a quién afecta y qué debe contener",
  "description": "Lo que el artículo 17 de la Ley de Servicios Digitales (DSA) exige en cada retirada de contenido: quién debe proporcionar una declaración de motivos, cuándo, con qué información, y un ejemplo.",
  "inLanguage": "es",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/es/cumplimiento-dsa/declaracion-de-motivos" }
};

const contents = [
  { letter: "a", title: "La medida adoptada", text: "Retirada de la información, bloqueo del acceso, relegación o restricción de su visibilidad, suspensión o cesación de los pagos monetarios u otra medida, con su ámbito territorial y su duración cuando proceda." },
  { letter: "b", title: "Los hechos y circunstancias", text: "En qué se basa la decisión, incluido si responde a una notificación (artículo 16) o a investigaciones por propia iniciativa. La identidad de quien notifica solo se indica en caso estrictamente necesario." },
  { letter: "c", title: "El uso de medios automatizados", text: "En su caso, si la decisión se ha adoptado utilizando medios automatizados o si se refiere a contenidos detectados o identificados por esos medios." },
  { letter: "d", title: "El fundamento jurídico", text: "Si el contenido se considera presuntamente ilícito: una referencia al fundamento jurídico utilizado y las explicaciones de por qué el contenido se considera ilícito conforme a él." },
  { letter: "e", title: "El fundamento contractual", text: "Si el contenido se considera incompatible con tus condiciones generales: una referencia a la cláusula aplicada y las explicaciones de por qué es incompatible con ella." },
  { letter: "f", title: "Las vías de recurso", text: "Información clara y de fácil utilización sobre los recursos disponibles: mecanismo interno de gestión de reclamaciones, resolución extrajudicial de litigios y recurso judicial." },
];

const faqItems = [
  {
    question: "¿Qué es la declaración de motivos de la DSA?",
    answer: "Es la explicación que el artículo 17 del Reglamento (UE) 2022/2065 de servicios digitales obliga a proporcionar al usuario cuyo contenido se retira, se bloquea, se relega o ve restringida su visibilidad, así como en caso de suspensión de su cuenta, del servicio o de los pagos.",
  },
  {
    question: "¿Afecta a un medio de comunicación que modera sus comentarios?",
    answer: "Sí. Desde el momento en que almacena comentarios publicados por sus lectores, actúa como prestador de servicios de alojamiento de datos respecto a esos contenidos. El artículo 17 se aplica a todos los prestadores de servicios de alojamiento de datos, incluidas las pequeñas empresas.",
  },
  {
    question: "¿Hace falta una declaración de motivos por cada comentario eliminado?",
    answer: "Sí, por cada restricción impuesta porque el contenido es ilícito o incompatible con tus condiciones generales, siempre que conozcas los datos de contacto electrónicos del autor. La obligación no se aplica a los contenidos comerciales engañosos de gran volumen ni a las órdenes de las autoridades previstas en el artículo 9.",
  },
  {
    question: "¿Hay que enviar las declaraciones de motivos a la Comisión Europea?",
    answer: "Los prestadores de plataformas en línea deben presentar sus decisiones y declaraciones de motivos a la Comisión, sin dilación indebida, para incluirlas en una base de datos de acceso público, sin datos personales (artículo 24, apartado 5). El artículo 19 excluye a las microempresas y pequeñas empresas, salvo que hayan sido designadas plataformas en línea de muy gran tamaño.",
  },
  {
    question: "¿Qué sanciones hay en caso de incumplimiento?",
    answer: "La DSA deja a los Estados miembros el régimen de sanciones, pero fija en un 6 % del volumen de negocios anual en todo el mundo del prestador el importe máximo de las multas por incumplir una obligación (artículo 52).",
  },
];
---

<BaseLayout title="Declaración de motivos (artículo 17 de la DSA): guía y ejemplo" description="Lo que exige el artículo 17 de la DSA al retirar un comentario: a quién afecta, cuándo avisar al autor, los seis elementos obligatorios y un ejemplo." ogType="article" jsonLd={articleJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Cumplimiento de la DSA", href: "/es/cumplimiento-dsa" }, { label: "Declaración de motivos" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">20 de octubre de 2026</time>
        <span>&middot;</span>
        <span>7 min de lectura</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">La declaración de motivos de la DSA: lo que exige el artículo 17 en cada retirada de contenido</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        Desde que se aplica la Ley de Servicios Digitales (DSA), retirar un comentario ya no basta:
        hay que explicar a su autor por qué. El artículo 17 llama a esta explicación «declaración de motivos» y fija su contenido
        mínimo. Te contamos a quién afecta, en qué momento, qué debe incluir y qué aspecto puede tener.
      </p>

      <h2 class="text-xl font-bold text-surface-900">¿Quién debe proporcionar una declaración de motivos?</h2>
      <p>
        La obligación recae en los <strong>prestadores de servicios de alojamiento de datos</strong>, es decir, cualquier servicio
        que almacena información facilitada por sus usuarios: una red social, un foro, un marketplace, pero también un medio
        digital o un blog que acoge comentarios de sus lectores. A diferencia de otras obligaciones de la DSA, el artículo 17 no
        prevé ninguna exclusión para las microempresas y pequeñas empresas.
      </p>

      <h2 class="text-xl font-bold text-surface-900">¿En qué casos?</h2>
      <p>
        La declaración de motivos se debe a cada usuario afectado por una restricción impuesta porque su contenido es ilegal
        o incompatible con tus condiciones generales. El texto contempla cuatro tipos de restricciones:
      </p>
      <ul>
        <li>cualquier restricción de la visibilidad de un contenido, incluida su eliminación, el bloqueo del acceso o su relegación;</li>
        <li>la suspensión, cesación u otra restricción de los pagos monetarios;</li>
        <li>la suspensión o cesación total o parcial de la prestación del servicio;</li>
        <li>la suspensión o supresión de la cuenta del usuario.</li>
      </ul>
      <p>
        La obligación se aplica cuando conoces los datos de contacto electrónicos del usuario, a más tardar en el momento
        en que se impone la restricción. No afecta a los contenidos comerciales engañosos de gran volumen ni a las órdenes
        de las autoridades previstas en el artículo 9.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Los seis elementos obligatorios</h2>
      <p>El apartado 3 del artículo 17 enumera la información que la declaración debe contener como mínimo:</p>
    </div>

    <div class="mt-6 space-y-3">
      {contents.map((c) => (
        <div class="flex items-start gap-4 rounded-lg border border-surface-200 bg-surface-50 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-mono text-sm font-semibold text-brand-700">{c.letter}</span>
          <div>
            <p class="text-sm font-medium text-surface-900">{c.title}</p>
            <p class="mt-1 text-sm text-surface-500">{c.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <p>
        Esta información debe ser «clara y fácil de comprender», tan precisa y específica como sea razonablemente posible, y
        permitir al usuario ejercer de manera efectiva sus posibilidades de recurso (apartado 4).
      </p>

      <h2 class="text-xl font-bold text-surface-900">¿Y las plataformas en línea?</h2>
      <p>
        Los prestadores de plataformas en línea tienen una obligación más: presentar sus decisiones y sus declaraciones de
        motivos a la Comisión Europea, sin dilación indebida, para incluirlas en una base de datos de acceso público. Estos
        envíos no deben contener datos personales (artículo 24, apartado 5). El artículo 19 excluye a las microempresas y
        pequeñas empresas, salvo que hayan sido designadas plataformas en línea de muy gran tamaño.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Ejemplo de declaración de motivos para un comentario retirado</h2>
      <p>Ejemplo ficticio, que debes adaptar a tu servicio y a tus condiciones generales:</p>
    </div>

    <div class="mt-6 rounded-xl border border-surface-200 bg-white p-6 text-sm leading-relaxed text-surface-700 shadow-sm">
      <p>Hola:</p>
      <p class="mt-3"><strong>Medida:</strong> tu comentario publicado el 14 de octubre de 2026 en el artículo «…» ha sido retirado. Tu cuenta no se ve afectada.</p>
      <p class="mt-3"><strong>Motivo:</strong> el comentario contiene un insulto dirigido a otro lector, lo que es contrario al artículo 4 de nuestras normas de participación («Respeto a los demás participantes»).</p>
      <p class="mt-3"><strong>Cómo se tomó la decisión:</strong> el comentario fue detectado por una herramienta automática de análisis y, después, un moderador confirmó la decisión.</p>
      <p class="mt-3"><strong>Tus vías de recurso:</strong> si consideras que esta decisión no está justificada, puedes impugnarla respondiendo a este mensaje en un plazo de seis meses. También puedes acudir a un órgano certificado de resolución extrajudicial de litigios o a los tribunales.</p>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Cómo te ayuda OpenModeration a redactar tus declaraciones de motivos</h2>
      <ul>
        <li><strong>Una explicación por escrito para cada decisión.</strong> Cada comentario rechazado recibe una explicación redactada, en el idioma que elijas, que sirve de base para el motivo (letra e o d).</li>
        <li><strong>El papel de la automatización, documentado.</strong> El registro de actividad indica si la decisión la tomó la IA o un moderador, y cuál (letras b y c).</li>
        <li><strong>Datos listos para enviar.</strong> La API y los webhooks devuelven para cada contenido el veredicto, la categoría y la explicación: puedes integrarlos en el mensaje que envías al autor.</li>
        <li><strong>Un historial completo.</strong> Todas las decisiones, automáticas o humanas, se conservan en el registro de auditoría para tus informes y tus controles.</li>
      </ul>
      <p>
        La información sobre las vías de recurso y el fundamento jurídico concreto siguen siendo responsabilidad tuya: dependen
        de tu servicio, de tus condiciones generales y del derecho aplicable.
      </p>
      <p class="text-sm text-surface-400">
        Fuente: <a href="https://eur-lex.europa.eu/legal-content/ES/TXT/?uri=CELEX:32022R2065" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Reglamento (UE) 2022/2065, de 19 de octubre de 2022, relativo a un mercado único de servicios digitales</a>, DO L 277 de 27 de octubre de 2022, artículos 17, 19, 24 y 52. Esta página es informativa y no constituye asesoramiento jurídico.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
    </div>
  </article>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/politica-de-moderacion" class="font-medium text-brand-600 hover:text-brand-500">Normas de la comunidad y política de moderación: guía y plantilla &rarr;</a></li>
        <li><a href="/es/cumplimiento-dsa" class="font-medium text-brand-600 hover:text-brand-500">El cumplimiento de la DSA con OpenModeration &rarr;</a></li>
        <li><a href="/es/producto/transparencia" class="font-medium text-brand-600 hover:text-brand-500">Cada decisión, explicada por escrito &rarr;</a></li>
        <li><a href="/es/casos-de-uso/medios" class="font-medium text-brand-600 hover:text-brand-500">La moderación de comentarios para medios de comunicación &rarr;</a></li>
        <li><a href="/es/blog/guia-dsa-pymes" class="font-medium text-brand-600 hover:text-brand-500">La DSA para pymes: guía práctica &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Una declaración de motivos para cada comentario retirado." subtitle="OpenModeration redacta la explicación de cada decisión y deja constancia de quién decidió qué. Gratis para empezar." />
</BaseLayout>
