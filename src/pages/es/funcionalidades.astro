---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/funcionalidades",
  "url": "https://www.openmoderation.com/es/funcionalidades",
  "name": "Funcionalidades de moderación de contenido: API unificada y motor de reglas",
  "description": "Todas las funcionalidades de OpenModeration: API de moderación, consola, motor de acciones, conectores nativos, lotes y registros de auditoría conformes con la DSA.",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const curlExample = `# Una sola llamada, puntuaciones estandarizadas
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "Your text to moderate here",
    "language": "en"
  }'

# Respuesta (siempre con el mismo formato)
{
  "id": "modr_01JXK...",
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const featureCategories = [
  {
    title: 'Una sola integración',
    description: 'Un único endpoint de API y un único formato de respuesta. Cuando incorporamos un modelo de IA mejor, no cambia nada en tu código.',
    items: [
      { title: 'Nuestra propia IA de moderación', desc: 'Envía el contenido una vez y recibe un veredicto claro (aprobado o rechazado) junto con las puntuaciones por categoría, según tus reglas y tus casos de uso.' },
      { title: 'Categorías de contenido predefinidas', desc: 'Categorías listas para usar que cubren odio, acoso, contenido sexual, violencia, autolesiones, spam, desinformación, datos personales y otras.' },
      { title: 'Arbitrada por otras IA', desc: 'En los casos delicados, otros modelos de IA arbitran la decisión antes de aplicarla. Menos errores, menos comentarios ocultados por error.' },
      { title: 'Decisiones de moderación más acertadas', desc: 'Ten en cuenta el contexto de la conversación, el historial del autor, el tipo de canal y tus propias reglas para decidir con más precisión.' },
      { title: 'Revisión masiva de contenido', desc: 'Envía hasta 10.000 elementos de una vez para procesarlos de forma asíncrona. Los resultados llegan a tu sistema en cuanto están listos.' },
      { title: 'Reglas de moderación a medida', desc: 'Define tus propias categorías. Aporta ejemplos y deja que la IA clasifique el contenido a tu manera.' },
    ],
  },
  {
    title: 'Consola de moderación',
    description: 'Una interfaz web completa para gestionar todas tus operaciones de moderación de contenido.',
    items: [
      { title: 'Gestión de accesos', desc: 'Crea y gestiona claves de acceso. Fija límites de uso por clave.' },
      { title: 'Gestión de equipos y roles', desc: 'Da acceso a tus compañeros, asigna roles y define permisos sin pasar por tu departamento de TI.' },
      { title: 'Gestión de denuncias', desc: 'Nuestro equipo tramita las denuncias de los usuarios, y tú sigues cada una en tiempo real hasta su resolución.' },
      { title: 'Historial de actividad', desc: 'Cada solicitud de moderación queda registrada con su veredicto, el tiempo de respuesta y las puntuaciones por categoría.' },
      { title: 'Supervisión del estado del servicio', desc: 'Consulta en tiempo real el estado del servicio: disponibilidad, tiempos de respuesta y tasas de error.' },
      { title: 'Informes de rendimiento', desc: 'Sigue el volumen de moderación y la tasa de contenido señalado y analiza la evolución de los costes.' },
      { title: 'Gestión de conectores', desc: 'Conecta tus cuentas de redes sociales con tus propias credenciales.' },
      { title: 'Configuración de reglas', desc: 'Define palabras prohibidas, fija umbrales por categoría y redacta las normas de tu comunidad: tres herramientas sencillas, sin necesidad de programar.' },
    ],
  },
  {
    title: 'Moderación automática',
    description: 'Define tus reglas de moderación con tres herramientas sencillas: palabras prohibidas, umbrales por categoría y las normas de tu comunidad escritas en lenguaje natural.',
    items: [
      { title: 'Reglas de IA que entienden el contexto', desc: 'Combina las puntuaciones de confianza de la IA con tus reglas, en lugar de depender solo de listas de palabras clave.' },
      { title: 'Acciones automáticas', desc: 'Cuando se supera un umbral, entra en juego el motor de acciones: ocultar, eliminar, señalar, notificar o marcar como spam.' },
      { title: 'Supervisión humana', desc: 'Nuestro equipo se ocupa de los casos dudosos. Tú puedes intervenir y tomar la decisión final cuando quieras.' },
      { title: 'Todo en tiempo real', desc: 'Ves cada decisión en el momento, con su explicación por escrito, y puedes aprobar o rechazar cualquier elemento tú mismo.' },
      { title: 'Notificaciones por webhook', desc: 'Recibe alertas en tiempo real sobre contenido señalado, lotes finalizados, errores y otros eventos.' },
      { title: 'Registro de auditoría completo', desc: 'Cada acción queda registrada: qué regla se activó, qué acción se tomó y cuál fue el resultado.' },
    ],
  },
  {
    title: 'Integraciones con plataformas',
    description: 'Conéctate directamente a las redes sociales y a tu blog para recoger y moderar el contenido de forma automática.',
    items: [
      { title: 'Facebook', desc: 'Recibe comentarios y publicaciones. Oculta o elimina automáticamente el contenido que incumple tus reglas.' },
      { title: 'Instagram', desc: 'Modera los comentarios y mensajes de Instagram para que el odio y el spam no se queden en tu perfil.' },
      { title: 'YouTube', desc: 'Recoge los comentarios de tus vídeos. Márcalos como spam o retenlos para que los revise nuestro equipo.' },
      { title: 'WordPress', desc: 'Modera los comentarios de tu blog. Apruébalos, retenlos para revisión o márcalos como spam automáticamente.' },
      { title: 'Usa tus propios accesos a las plataformas', desc: 'Aporta tus propios tokens de cada plataforma. Nunca los almacenamos en texto plano.' },
      { title: 'Receptor de webhooks genérico', desc: 'Recoge contenido de cualquier plataforma que admita webhooks salientes.' },
      { title: 'Callback de webhook genérico', desc: 'Envía los resultados de moderación a tu propio webhook para integraciones a medida.' },
    ],
  },
];
---

<BaseLayout title="Funcionalidades de moderación: API unificada y reglas" description="Todas las funcionalidades de OpenModeration: API de moderación, consola, motor de acciones, conectores nativos, lotes y registro de auditoría DSA." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Funcionalidades" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Funcionalidades</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        OpenModeration cubre todo el proceso de moderación, desde que llega el comentario hasta la acción que se toma.
      </p>
    </div>
  </section>

  {featureCategories.map((cat) => (
    <section class="scroll-mt-16 border-t border-surface-100 bg-white py-12 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-8 max-w-2xl text-center sm:mb-12">
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{cat.title}</h2>
          <p class="mt-4 text-lg text-surface-500">{cat.description}</p>
        </div>
        <div class={`grid gap-4 sm:gap-6 md:grid-cols-2 ${cat.items.length % 4 === 0 || cat.items.length === 7 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
          {cat.items.map((item) => (
            <div class="om-card relative overflow-hidden bg-white !p-5 sm:!p-6">
              <span class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-brand-500 to-violet-500" aria-hidden="true"></span>
              <h3 class="font-semibold text-surface-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-surface-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- API Reference Snippet -->
  <section class="border-t border-surface-100 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Un formato, sea cual sea el modelo</h2>
          <p class="mt-4 text-lg text-surface-500">
            Cuando incorporamos un modelo de IA mejor o más barato, los resultados mantienen el mismo formato, así que solo integras una vez.
          </p>
          <div class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>El mismo formato</strong> siempre, sin código adicional que escribir cuando la IA mejora.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Claves de acceso seguras</strong> con permisos acotados y límites de uso por clave.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Documentación interactiva de la API</strong> generada automáticamente. Prueba las solicitudes directamente desde tu navegador.</p>
            </div>
          </div>
        </div>
        <div>
          <CodeBlock code={curlExample} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
