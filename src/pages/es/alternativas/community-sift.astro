---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/community-sift",
  "name": "Alternativa a Community Sift: comparativa con OpenModeration",
  "description": "¿Buscas una alternativa a Community Sift? Estado, oferta, precios y modelos de IA frente a OpenModeration, la moderación de comentarios alojada en la UE.",
  "inLanguage": "es",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  { feature: "Estado", competitor: "Página de producto aún en línea, sin aviso de fin de vida (30 de octubre de 2026); un competidor afirma que los contratos no se renovarán en 2026, sin confirmación pública de Microsoft", openmod: "En desarrollo activo por Logora (París, desde 2019)" },
  { feature: "Oferta", competitor: "IA y experiencia humana para clasificar, filtrar y escalar contenido de usuarios en tiempo real, sobre todo para juegos y comunidades online", openmod: "Moderación de comentarios con IA para medios, marcas e instituciones públicas, configurada contigo por el equipo de Logora" },
  { feature: "Integraciones", competitor: "No detalladas en la página; plug-in para Discord y OCR como opciones", openmod: "Web, Facebook, Instagram, YouTube y WordPress de forma nativa; TikTok, X, LinkedIn y otras redes bajo petición, rápidamente" },
  { feature: "Tipos de contenido", competitor: "Texto, imágenes y vídeo", openmod: "Comentarios" },
  { feature: "Modelos de IA", competitor: "No especificado: IA combinada con experiencia humana, según la página de Microsoft", openmod: "IA de moderación propia, contrastada por otros modelos de IA; los nuevos modelos se conectan en cuanto salen" },
  { feature: "Reglas", competitor: "Guías de políticas personalizadas según las normas de tu comunidad", openmod: "Adaptadas a tus reglas y casos de uso: infracciones claras ocultas, críticas legítimas visibles, casos dudosos tratados por nuestro equipo" },
  { feature: "Idiomas", competitor: "22 idiomas premium indicados", openmod: "Se definen contigo durante la configuración" },
  { feature: "DSA y transparencia", competitor: "No especificado en la página", openmod: "Motivo escrito para cada decisión, registro de actividad, notificación y acción, declaración de motivos, revisión humana de decisiones impugnadas, cifras exportables" },
  { feature: "Alojamiento", competitor: "No especificado en la página", openmod: "Alojado en la UE, RGPD" },
  { feature: "Precio", competitor: "Varios niveles, bajo petición", openmod: "Gratis hasta 1.000 solicitudes/mes; Pro 99 €/mes por 10.000 solicitudes; Enterprise bajo petición" },
  { feature: "Referencias", competitor: "Xbox, Electronic Arts, Supercell, Kabam, Flip, MSN", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "¿Cuál es la mejor alternativa a Community Sift?",
    answer: "Para moderar comentarios de medios, páginas de marca y canales de instituciones públicas, OpenModeration es una opción sólida: conectores para webs, Facebook, Instagram, YouTube y WordPress, precios públicos, un motivo escrito para cada decisión, herramientas para la DSA y alojamiento en la UE. Para el chat en tiempo real de grandes juegos, busca una herramienta pensada para videojuegos.",
  },
  {
    question: "¿Cuánto cuesta Community Sift?",
    answer: "Microsoft no publica precios: su página menciona varios niveles y opciones, bajo petición. OpenModeration es gratis hasta 1.000 solicitudes al mes, luego 99 € al mes por 10.000 solicitudes, con Enterprise bajo petición.",
  },
  {
    question: "¿Va a desaparecer Community Sift?",
    answer: "El 30 de octubre de 2026 la página de producto de Microsoft seguía en línea, sin aviso de fin de vida. Un proveedor competidor escribió en febrero de 2026 que Microsoft había avisado a sus clientes de que los contratos no se renovarían al vencer. No encontramos confirmación pública de Microsoft: pide tu calendario a tu contacto en Microsoft.",
  },
  {
    question: "Community Sift vs OpenModeration: ¿qué cambia?",
    answer: "Community Sift, hoy en Microsoft, se orienta a juegos y grandes comunidades online, con moderación de texto, imágenes y vídeo. OpenModeration está pensado para comentarios de medios, marcas e instituciones públicas, publica sus precios, se aloja en la UE y da un motivo escrito y un registro de cada decisión.",
  },
  {
    question: "¿Puedo probar OpenModeration mientras Community Sift sigue funcionando?",
    answer: "Sí. En modo sandbox, OpenModeration analiza tu contenido real sin ocultar nada, así que comparas decisiones antes de cambiar.",
  },
  {
    question: "¿Quién configura OpenModeration?",
    answer: "El equipo de Logora, en París desde 2019 y propiedad de sus empleados. Adaptamos contigo la moderación a tus reglas y casos de uso y la ajustamos durante las primeras semanas.",
  },
];
---

<BaseLayout title="Alternativa a Community Sift: comparativa con OpenModeration" description="¿Buscas una alternativa a Community Sift? Estado, oferta, precios y modelos de IA frente a OpenModeration, la moderación de comentarios alojada en la UE." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Community Sift" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Community Sift: comparativa con OpenModeration</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Si moderas comentarios de un medio, de páginas de marca o de los canales de una institución pública, OpenModeration es una alternativa sólida a Community Sift: conectores para webs, Facebook, Instagram, YouTube y WordPress, precios públicos, herramientas para la DSA y alojamiento en la UE. Si gestionas el chat en tiempo real de grandes juegos online, Community Sift se creó para eso; aquí tienes en qué punto está, con fuentes.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/es/reservar-llamada" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Reservar una llamada</a>
        <a href="/es/precios" class="inline-flex items-center gap-2 rounded-lg border border-surface-200 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Ver precios</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">¿Para quién es Community Sift?</h2>
      <p class="mt-4 text-surface-600">Community Sift lo creó Two Hat, empresa canadiense que Microsoft compró en 2021; twohat.com redirige ahora a una página de Microsoft. Esa página describe una plataforma de moderación que "combina lo mejor de ambos mundos", IA y experiencia humana, para clasificar, filtrar y escalar contenido de usuarios en tiempo real, incluidos jerga, l33t speak, emojis y trucos Unicode, además de moderación de imágenes y vídeo. Indica 22 idiomas premium y muestra Xbox, Electronic Arts, Supercell, Kabam, Flip y MSN.</p>
      <p class="mt-4 text-surface-600">Su estado: el 30 de octubre de 2026 la página de producto de Microsoft seguía en línea, sin aviso de fin de vida. Un proveedor competidor escribió en febrero de 2026 que Microsoft había comunicado a sus clientes que los contratos se respetarían hasta su vencimiento y no se renovarían. No encontramos ningún anuncio público de Microsoft que lo confirme: consúltalo con tu contacto en Microsoft.</p>
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>moderas comentarios de un medio, de páginas de marca o de los canales de una institución pública;</li>
          <li>quieres conectores listos para Facebook, Instagram, YouTube y WordPress, y una API para tu web;</li>
          <li>quieres ver los precios antes de hablar con ventas;</li>
          <li>necesitas un motivo escrito para cada decisión y herramientas para la DSA;</li>
          <li>tus datos deben alojarse en la UE y quieres un equipo que configure la moderación contigo.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Community Sift puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>filtras el chat en tiempo real de grandes juegos online, donde lo usan Xbox, EA y Supercell;</li>
          <li>necesitas moderar imágenes y vídeo con controles de riesgo y difuminado que protege a los moderadores;</li>
          <li>dependes de su plug-in para Discord o de su opción de OCR;</li>
          <li>tu contrato con Microsoft sigue vigente y cubre lo que necesitas por ahora.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Community Sift y OpenModeration, punto por punto</h2>
      <p class="mt-4 text-surface-500">Información sobre Community Sift extraída de la página de Microsoft, developer.microsoft.com, consultada el 30 de octubre de 2026. Cuando su web no dice nada, lo indicamos.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Community Sift</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Un motor de IA que sigue los avances del mercado</h2>
      <p class="mt-4 text-surface-600">OpenModeration usa su propia IA de moderación y, en los casos delicados, otros modelos de IA contrastan sus decisiones. El motor no depende de un único modelo: cuando sale uno mejor o más barato, nuestro equipo lo conecta rápido, sin que tengas que cambiar nada.</p>
      <p class="mt-4 text-surface-600">La página de Microsoft dice que Community Sift combina IA y experiencia humana, sin nombrar los modelos que usa. Con OpenModeration, tu moderación sigue los avances de los modelos de IA en lugar de quedarse congelada en un solo algoritmo, algo importante cuando eliges una herramienta para varios años.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Precios de Community Sift y de OpenModeration</h2>
      <p class="mt-4 text-surface-600">Microsoft no publica los precios de Community Sift: su página habla de "varios niveles de precios" y de opciones como OCR y un plug-in para Discord, y remite al equipo comercial.</p>
      <p class="mt-4 text-surface-600">OpenModeration publica sus precios: gratis hasta 1.000 solicitudes al mes, Pro a 99 € al mes por 10.000 solicitudes y Enterprise bajo petición para grandes volúmenes. El despliegue en tus propios servidores es posible bajo petición.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Dejar Community Sift en 3 pasos</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-1 font-semibold text-surface-900">Traduce tu política</h3>
          <p class="mt-2 text-sm text-surface-600">Con nuestro equipo, convierte tu política de Community Sift, con sus temas y niveles de riesgo, en reglas para tus casos de uso: qué se oculta, qué se mantiene y qué va a un moderador.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-1 font-semibold text-surface-900">Ejecuta ambos en paralelo</h3>
          <p class="mt-2 text-sm text-surface-600">Conecta tu web por API, o tus cuentas de Facebook, Instagram, YouTube y WordPress, en modo sandbox. No se oculta nada mientras comparas decisiones sobre el mismo contenido.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-1 font-semibold text-surface-900">Cambia antes del vencimiento</h3>
          <p class="mt-2 text-sm text-surface-600">Activa la moderación automática en OpenModeration y deja de enviar contenido a Community Sift, idealmente mucho antes de que termine tu contrato.</p>
        </li>
      </ol>
      <p class="mt-8 text-surface-600">¿Quieres verlo antes con tus propios comentarios? <a href="/es/reservar-llamada" class="font-medium text-brand-600 hover:text-brand-500">Reserva una llamada con el equipo de Logora</a> y configuramos el sandbox contigo.</p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Community Sift y Two Hat son marcas de su titular, Microsoft. Fuentes: <a href="https://developer.microsoft.com/en-us/games/products/community-sift/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">developer.microsoft.com/en-us/games/products/community-sift</a>, <a href="https://www.twohat.com" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">twohat.com</a>, <a href="https://www.lassomoderation.com/blog/what-is-community-sift/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">lassomoderation.com/blog/what-is-community-sift</a> (consultadas el 30 de octubre de 2026). ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/blog/moderacion-de-comentarios-guia" class="font-medium text-brand-600 hover:text-brand-500">Moderación de comentarios: la guía completa &rarr;</a></li>
        <li><a href="/es/casos-de-uso/videojuegos" class="font-medium text-brand-600 hover:text-brand-500">Moderación para comunidades de videojuegos &rarr;</a></li>
        <li><a href="/es/software-de-moderacion" class="font-medium text-brand-600 hover:text-brand-500">El software de moderación OpenModeration &rarr;</a></li>
        <li><a href="/es/precios" class="font-medium text-brand-600 hover:text-brand-500">Precios de OpenModeration &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
        <li><a href="/es/reservar-llamada" class="font-medium text-brand-600 hover:text-brand-500">Reserva una llamada con nuestro equipo &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Prepara tu salida de Community Sift con el equipo de Logora." subtitle="Traducimos tu política, lanzamos el sandbox con tu contenido real y cambiamos cuando estés listo. Gratis hasta 1.000 solicitudes al mes." />
</BaseLayout>
