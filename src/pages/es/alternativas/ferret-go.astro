---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import SwitchProvider from '../../../components/SwitchProvider.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/ferret-go",
  "name": "Alternativa a Ferret Go: OpenModeration comparado",
  "description": "¿Buscas una alternativa a Ferret Go? Comparativa con fuentes frente a OpenModeration: precios públicos, motivo de cada decisión, alojamiento UE y más.",
  "inLanguage": "es",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  {
    "feature": "Empresa y oferta",
    "competitor": "ferret go GmbH, con sede en Berlín según su aviso legal. Dos productos: Conversario (moderación de comentarios con IA, analítica, herramientas de diálogo) y Engagently (plataforma de participación para los sitios de los editores)",
    "openmod": "Logora (París, desde 2019, propiedad de sus empleados). OpenModeration: moderación con IA que nuestro equipo adapta contigo a tus reglas y casos de uso"
  },
  {
    "feature": "Canales",
    "competitor": "Facebook, Instagram, YouTube, LinkedIn, TikTok y Threads según su cronología, además de sistemas onsite, apps de diálogo y foros",
    "openmod": "Web, Facebook, Instagram, YouTube y WordPress de forma nativa; TikTok, X, LinkedIn y otras redes bajo petición, rápidamente"
  },
  {
    "feature": "Precios",
    "competitor": "No publicados en la web. El formulario pide tu volumen mensual de comentarios; prueba gratuita de 30 días",
    "openmod": "Públicos: gratis hasta 1.000 solicitudes al mes, Pro por 99 € al mes (10.000 solicitudes), Enterprise bajo petición"
  },
  {
    "feature": "Configuración",
    "competitor": "Ajustes de severidad individuales, léxico y reglas propias (enmascarado, lista blanca)",
    "openmod": "Adaptada a tus reglas y casos de uso, un umbral por categoría, casos dudosos tratados por nuestro equipo"
  },
  {
    "feature": "Modelos de IA",
    "competitor": "Sus propios modelos de IA de moderación desde 2016, con IA generativa añadida en 2024 (según su web)",
    "openmod": "IA de moderación propia, contrastada por otros modelos de IA; nuevos modelos integrados en cuanto salen"
  },
  {
    "feature": "Motivo escrito de cada decisión",
    "competitor": "No especificado en su web",
    "openmod": "Sí, para cada decisión, en la consola y mediante la API"
  },
  {
    "feature": "Prueba antes de cambiar",
    "competitor": "Un modo «dry-run» que analiza los canales sin actuar",
    "openmod": "Modo sandbox con comentarios reales, sin ocultar nada"
  },
  {
    "feature": "DSA",
    "competitor": "Cronología de cada acción de moderación al segundo, área propia para denuncias de usuarios, API de reporting",
    "openmod": "Notificación y acción, declaración de motivos, revisión humana de decisiones impugnadas, cifras exportables, registro completo"
  },
  {
    "feature": "Alojamiento y RGPD",
    "competitor": "Declara cumplir el RGPD; ubicación del alojamiento no especificada en su web",
    "openmod": "Alojamiento en la UE, RGPD"
  },
  {
    "feature": "Referencias",
    "competitor": "Más de 100 clientes de Conversario según el proveedor; cita FAZ y ntv, y sus primeros modelos creados en 2016 para WELT y Bild",
    "openmod": "Entre ellos L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier y Egora"
  },
  {
    "feature": "Equipo",
    "competitor": "Zona de Berlín, mercado germanohablante",
    "openmod": "París, Madrid y Berlín, con una hablante nativa de alemán en Berlín para la región DACH"
  }
];

const faqItems = [
  {
    "question": "¿Cuál es la mejor alternativa a Ferret Go?",
    "answer": "Depende de lo que necesites. Si quieres precios públicos, un motivo escrito para cada decisión, alojamiento en la UE y conectores para Facebook, Instagram, YouTube y WordPress, OpenModeration cumple esos criterios. Si quieres moderación, analítica y una plataforma de participación del mismo proveedor, Ferret Go lo ofrece. TikTok, LinkedIn y otras redes se añaden a OpenModeration bajo petición."
  },
  {
    "question": "¿Cuál es el precio de Ferret Go?",
    "answer": "Ferret Go no publica los precios de Conversario. Su formulario pide tu volumen mensual de comentarios y ofrece una prueba gratuita de 30 días. OpenModeration es gratis hasta 1.000 solicitudes al mes, Pro cuesta 99 € al mes por 10.000 solicitudes y Enterprise es bajo petición."
  },
  {
    "question": "¿Ferret Go y Conversario son lo mismo?",
    "answer": "Pertenecen a la misma empresa. ferret go GmbH es el editor, Conversario su producto de moderación de comentarios con IA y Engagently su plataforma de participación. Nuestra página «Ferret Go y Conversario: la diferencia» lo explica en detalle."
  },
  {
    "question": "Ferret Go vs OpenModeration: ¿cuál es la diferencia principal?",
    "answer": "OpenModeration publica sus precios, motiva cada decisión por escrito, aloja en la UE y usa su propia IA, contrastada por otros modelos y actualizada en cuanto sale un modelo nuevo. Ferret Go cubre más redes sociales con Conversario y añade una plataforma de participación con Engagently."
  },
  {
    "question": "¿Puedo probar OpenModeration sin apagar Conversario?",
    "answer": "Sí. En modo sandbox, OpenModeration evalúa tus comentarios reales sin ocultar nada. Conversario sigue moderando y comparas las decisiones comentario a comentario."
  },
  {
    "question": "¿Tiene OpenModeration un equipo en España?",
    "answer": "Sí. OpenModeration lo construye el equipo de Logora, en París, Madrid y Berlín. Jesús, desde Madrid, acompaña a los clientes de España y América Latina en español."
  }
];
---

<BaseLayout title="Alternativa a Ferret Go: comparativa con OpenModeration" description="¿Buscas una alternativa a Ferret Go? Comparativa con fuentes frente a OpenModeration: precios públicos, motivo de cada decisión, alojamiento UE y más." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Ferret Go" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Ferret Go: OpenModeration comparado</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        La mejor alternativa a Ferret Go depende de lo que necesites. Si quieres precios públicos, un motivo escrito para cada comentario oculto, alojamiento en la UE y una IA que incorpora los nuevos modelos en cuanto salen, OpenModeration es una muy buena opción.
      </p>
      <p class="mx-auto mt-6 max-w-2xl rounded-xl border border-surface-200 bg-white px-5 py-4 text-sm text-surface-600">
        Conviene saberlo: Ferret Go es la empresa (ferret go GmbH) y Conversario es su producto de moderación de comentarios. <a href="/es/alternativas/ferret-go-vs-conversario" class="text-brand-600 hover:text-brand-500">Ferret Go y Conversario: la diferencia</a> · <a href="/es/alternativas/conversario" class="text-brand-600 hover:text-brand-500">Alternativa a Conversario</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">¿Para quién es Ferret Go?</h2>
      <p class="mt-4 text-surface-600">ferret go GmbH, empresa alemana, se presenta como proveedor de soluciones para comunidades digitales. Vende dos productos: Conversario, una moderación automática de comentarios que aplica las reglas de cada comunidad y se conecta con redes sociales, apps y chats, y Engagently, una plataforma de comentarios, votaciones y diálogo en los sitios de editores y marcas.</p>
      <p class="mt-4 text-surface-600">Según su web, la empresa trabaja en su plataforma desde 2015 y creó sus primeros modelos de moderación para WELT y Bild en 2016. Se dirige sobre todo a editores, cadenas y marcas del mercado germanohablante.</p>
    </div>
  </section>
  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>quieres conocer el precio antes de hablar con ventas;</li>
          <li>tu equipo necesita un motivo escrito para cada comentario oculto;</li>
          <li>quieres conectores listos para Facebook, Instagram, YouTube y WordPress;</li>
          <li>necesitas alojamiento en la UE y piezas DSA sin proyecto adicional;</li>
          <li>quieres que tu moderación aproveche el progreso de los nuevos modelos de IA.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Ferret Go puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>quieres moderación, analítica y una plataforma de participación del mismo proveedor;</li>
          <li>para ti pesa sobre todo una larga lista de referencias de medios germanohablantes.</li>
        </ul>
      </div>
    </div>
  </section>
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Ferret Go (Conversario) y OpenModeration, punto por punto</h2>
      <p class="mt-4 text-surface-500">Información sobre Ferret Go y Conversario tomada de ferret-go.com y conversar.io, consultados el 30 de octubre de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Ferret Go (Conversario)</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">El motor de IA, y por qué importa</h2>
      <p class="mt-4 text-surface-600">OpenModeration usa su propia IA de moderación. En los casos delicados, otros modelos de IA contrastan su decisión antes de ocultar un comentario o pasarlo a nuestro equipo.</p>
      <p class="mt-4 text-surface-600">La plataforma no depende de un solo modelo: cuando sale un modelo de IA mejor o más barato, nuestro equipo lo integra rápido, sin que tengas que cambiar nada. Tu moderación sigue el progreso del mercado de la IA en lugar de quedarse congelada en un único algoritmo propio.</p>
    </div>
  </section>
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Lo que cambia de verdad en el día a día</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Un motivo escrito para cada decisión</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration explica por qué cada comentario oculto incumple tus reglas. Tu equipo lo ve en la consola, la API lo devuelve, y sirve para la declaración de motivos que exige el artículo 17 de la DSA.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Fuera los abusos, la crítica se queda</h3>
          <p class="mt-2 text-sm text-surface-600">Las infracciones claras se ocultan automáticamente. La crítica legítima, aunque sea dura, sigue visible. Nuestro equipo trata los casos dudosos y tú lo ves todo en una sola consola, con registro completo.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Conectores, no un proyecto de IT</h3>
          <p class="mt-2 text-sm text-surface-600">Páginas de Facebook, cuentas profesionales de Instagram, canales de YouTube y WordPress se conectan en pocos clics. Tu sistema de comentarios o tu app, mediante la API.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Prueba sin apagar nada</h3>
          <p class="mt-2 text-sm text-surface-600">En modo sandbox, OpenModeration evalúa tus comentarios reales sin ocultar nada, mientras tu herramienta actual sigue moderando. Para ser justos, Conversario también ofrece un modo «dry-run» según su web; con OpenModeration lees el motivo de cada decisión.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Piezas DSA incluidas</h3>
          <p class="mt-2 text-sm text-surface-600">Notificación y acción, declaración de motivos, revisión humana de decisiones impugnadas y cifras exportables para tus informes de transparencia. RGPD, alojamiento en la UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Un equipo en París, Madrid y Berlín</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration lo construye Logora. Jesús, en Madrid, atiende a clientes de España y América Latina, y Sylvia, en Berlín, a los de habla alemana en su lengua materna. <a href="/es/reservar-llamada" class="text-brand-600 hover:text-brand-500">Reserva una llamada</a>.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Precio de Ferret Go y precio de OpenModeration</h2>
      <p class="mt-4 text-surface-600">Ferret Go no publica los precios de Conversario. El formulario de conversar.io pide tu volumen mensual de comentarios, y la web menciona una prueba gratuita de 30 días.</p>
      <p class="mt-4 text-surface-600">OpenModeration publica sus precios: gratis hasta 1.000 solicitudes al mes, Pro por 99 € al mes con 10.000 solicitudes, Enterprise bajo petición. El despliegue on-premise solo es posible bajo petición. <a href="/es/precios" class="text-brand-600 hover:text-brand-500">Ver precios</a>.</p>
    </div>
  </section>
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Cambiar en tres pasos</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-2 font-semibold text-surface-900">Conecta tus canales</h3>
          <p class="mt-2 text-sm text-surface-600">Facebook, Instagram, YouTube o WordPress en pocos clics, o tu sistema de comentarios mediante la API.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-2 font-semibold text-surface-900">Compara en sandbox</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration evalúa tus comentarios reales sin actuar, mientras tu herramienta actual sigue moderando. Nuestro equipo adapta la moderación a tus reglas contigo.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-2 font-semibold text-surface-900">Activa</h3>
          <p class="mt-2 text-sm text-surface-600">Cuando los resultados te convenzan, activa la moderación automática y termina el contrato anterior cuando te convenga.</p>
        </li>
      </ol>
    </div>
  </section>
  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Ferret Go, Conversario y Engagently son marcas de su editor, ferret go GmbH. Fuentes (consultadas el 30 de octubre de 2026): <a href="https://www.ferret-go.com" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">ferret-go.com</a>, <a href="https://www.ferret-go.com/impressum" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">ferret-go.com/impressum</a>, <a href="https://www.conversar.io/en/about" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">conversar.io/en/about</a>, <a href="https://www.conversar.io/en/product" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">conversar.io/en/product</a>, <a href="https://www.conversar.io/en/dsa-comment-moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">conversar.io/en/dsa-comment-moderation</a>, <a href="https://conversar.io/en/demo" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">conversar.io/en/demo</a>, <a href="https://www.engagently.com/en" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">engagently.com</a>, <a href="https://www.horizont.net/medien/nachrichten/ki-basierte-community-loesungen-dfv-mediengruppe-uebernimmt-mehrheit-an-ferret-go-197573" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Horizont, 2 de febrero de 2022</a>. ¿Ves un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/alternativas/ferret-go-vs-conversario" class="font-medium text-brand-600 hover:text-brand-500">Ferret Go y Conversario: la diferencia y la alternativa &rarr;</a></li>
        <li><a href="/es/alternativas/conversario" class="font-medium text-brand-600 hover:text-brand-500">Alternativa a Conversario &rarr;</a></li>
        <li><a href="/es/software-de-moderacion" class="font-medium text-brand-600 hover:text-brand-500">El software de moderación OpenModeration &rarr;</a></li>
        <li><a href="/es/blog/moderacion-de-comentarios-guia" class="font-medium text-brand-600 hover:text-brand-500">Guía de moderación de comentarios &rarr;</a></li>
        <li><a href="/es/cumplimiento-dsa/declaracion-de-motivos" class="font-medium text-brand-600 hover:text-brand-500">La declaración de motivos que exige la DSA &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
        <li><a href="/es/reservar-llamada" class="font-medium text-brand-600 hover:text-brand-500">Reservar una llamada &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Compara OpenModeration y Ferret Go con tus propios comentarios." subtitle="Empieza en modo sandbox: OpenModeration evalúa tus comentarios reales y explica cada decisión, sin tocar tu moderación actual." />
</BaseLayout>
