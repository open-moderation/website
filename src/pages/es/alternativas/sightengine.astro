---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/sightengine",
  "name": "Alternativa a Sightengine: comparativa con OpenModeration",
  "description": "¿Sightengine u OpenModeration? Comparativa con fuentes: imágenes o comentarios, idiomas, revisión humana, DSA, alojamiento en la UE, IA y precios públicos.",
  "inLanguage": "es",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  {
    "feature": "Oferta",
    "competitor": "API de moderación y análisis de imágenes: imágenes, vídeo, texto, audio, detección de contenido generado por IA, verificación de identidad",
    "openmod": "Moderación de comentarios con IA para medios, marcas e instituciones públicas, puesta en marcha contigo por el equipo de Logora"
  },
  {
    "feature": "Contenido moderado",
    "competitor": "Imágenes (más de 150 clases), vídeo y directos, texto, audio. Modelos de texto de aprendizaje automático en 7 idiomas (en, fr, it, pt, es, ru, tr), filtro por reglas en 18",
    "openmod": "Comentarios publicados en tus sitios web y páginas sociales"
  },
  {
    "feature": "Integraciones",
    "competitor": "API REST; reglas y flujos configurados en su panel. Ningún conector de redes sociales o WordPress en las páginas consultadas",
    "openmod": "API para sitios web, páginas de Facebook, cuentas profesionales de Instagram, canales de YouTube, WordPress"
  },
  {
    "feature": "Modelos de IA",
    "competitor": "Modelos propios: «modelos de última generación y tecnología propia», modelos a medida en Enterprise",
    "openmod": "IA de moderación propia, contrastada por otros modelos de IA; nuevos modelos conectados en cuanto salen"
  },
  {
    "feature": "Revisión humana",
    "competitor": "Modo híbrido opcional: unos umbrales envían el contenido a «tu plataforma de moderación humana», revisado por tu equipo",
    "openmod": "Infracciones claras ocultadas automáticamente, casos dudosos tratados por nuestro equipo; ves cada decisión en tiempo real en una sola consola"
  },
  {
    "feature": "Explicación de las decisiones",
    "competitor": "Una etiqueta que describe el tipo de contenido encontrado, con puntuaciones por categoría",
    "openmod": "Una explicación escrita para cada decisión y un registro de actividad completo"
  },
  {
    "feature": "DSA",
    "competitor": "No especificado en su web",
    "openmod": "Notificación y acción, declaración de motivos, revisión humana de decisiones impugnadas, cifras exportables"
  },
  {
    "feature": "Alojamiento y datos",
    "competitor": "Empresa con sede en París; «centros de datos en numerosos países»; endpoints regionales no incluidos en Free, Starter ni Pro",
    "openmod": "Alojado en la Unión Europea, RGPD; despliegue on-premise bajo petición"
  },
  {
    "feature": "Precios públicos",
    "competitor": "Gratis (2.000 operaciones/mes), Starter 29 $/mes (10.000), Pro 99 $/mes (40.000), Enterprise a medida",
    "openmod": "Gratis hasta 1.000 solicitudes/mes, Pro a 99 €/mes por 10.000 solicitudes, Enterprise a medida"
  },
  {
    "feature": "Referencias",
    "competitor": "Logos de clientes sin nombres; socios citados como NVIDIA, PubNub, Tremau y Checkstep",
    "openmod": "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora"
  }
];

const faqItems = [
  {
    "question": "¿Cuál es la mejor alternativa a Sightengine?",
    "answer": "Para moderar comentarios de medios, páginas de marca y canales públicos, OpenModeration está pensado para ese uso: conectores de redes sociales y WordPress, consola de revisión, explicación escrita de cada decisión, piezas para el DSA y alojamiento en la UE. Para imágenes, vídeo, deepfakes o estimación de edad, Sightengine sigue siendo una opción especializada."
  },
  {
    "question": "¿Cuánto cuesta Sightengine?",
    "answer": "Según su página de precios: gratis hasta 2.000 operaciones al mes, Starter a 29 $ al mes por 10.000 operaciones, Pro a 99 $ al mes por 40.000, 0,002 $ por operación adicional y Enterprise a medida. OpenModeration es gratis hasta 1.000 solicitudes al mes y luego cuesta 99 € al mes por 10.000 solicitudes."
  },
  {
    "question": "Sightengine vs OpenModeration: ¿qué diferencia hay?",
    "answer": "Sightengine es una API para desarrolladores, fuerte sobre todo en contenido visual, que devuelve etiquetas y puntuaciones. OpenModeration es un servicio de moderación de comentarios: se conecta a tu web y a tus páginas sociales, actúa sobre los comentarios, confía los casos dudosos a nuestro equipo y explica cada decisión por escrito."
  },
  {
    "question": "¿Puedo probar OpenModeration sin apagar Sightengine?",
    "answer": "Sí. En modo sandbox, OpenModeration analiza tus comentarios reales sin ocultar nada. Sightengine sigue funcionando y comparas las dos series de decisiones sobre los mismos comentarios, cada decisión de OpenModeration con su explicación escrita."
  },
  {
    "question": "¿Qué IA usa OpenModeration?",
    "answer": "OpenModeration funciona con su propia IA de moderación, y otros modelos de IA contrastan sus decisiones en los casos delicados. Cuando sale un modelo mejor o más barato, nuestro equipo lo conecta sin que cambies nada: te beneficias del progreso de los modelos de IA."
  },
  {
    "question": "¿Modera Sightengine comentarios en español?",
    "answer": "Sí: según sus preguntas frecuentes, el español está entre los 7 idiomas de sus modelos de texto de aprendizaje automático. Lo que no incluye, según las páginas consultadas, son conectores para Facebook, Instagram, YouTube o WordPress ni una consola de revisión propia."
  }
];
---

<BaseLayout title="Alternativa a Sightengine: comparativa con OpenModeration" description="¿Sightengine u OpenModeration? Comparativa con fuentes: imágenes o comentarios, idiomas, revisión humana, DSA, alojamiento en la UE, IA y precios públicos." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Sightengine" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Sightengine: OpenModeration frente a frente</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        La mejor alternativa a Sightengine depende de lo que moderes: para imágenes, vídeo y verificación de identidad, Sightengine está hecho para eso; para los comentarios de medios, páginas de marca y canales públicos, lo está OpenModeration. OpenModeration oculta las infracciones claras, confía los casos dudosos a nuestro equipo y explica cada decisión por escrito, con un equipo de Logora que lo pone en marcha contigo.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/es/reservar-llamada" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Reservar una llamada</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Ver la comparativa</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Para quién es Sightengine</h2>
      <p class="mt-4 text-surface-600">Según su web, Sightengine es una API con sede en París que detecta contenido no deseado en imágenes, vídeos, directos, texto y audio, además de imágenes generadas por IA, deepfakes y señales de identidad como la estimación de edad. Se dirige a los desarrolladores de plataformas que reciben contenido de usuarios: marketplaces, apps de citas, videojuegos, redes de fotografía y de creadores. La integras en tu código y recibes etiquetas y puntuaciones por categoría.</p>
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>moderas comentarios de un medio, de páginas de marca o de canales públicos, no subidas de imágenes;</li>
          <li>quieres conectar Facebook, Instagram, YouTube y WordPress sin desarrollo;</li>
          <li>necesitas una consola de revisión humana y una explicación escrita de cada comentario ocultado;</li>
          <li>necesitas piezas para el DSA y alojamiento en la UE;</li>
          <li>quieres un equipo que adapte la moderación a tus reglas y casos de uso.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Sightengine puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>las imágenes, los vídeos y los directos son tu principal riesgo;</li>
          <li>necesitas detectar imágenes generadas por IA, deepfakes o estimar la edad;</li>
          <li>tus desarrolladores quieren una API en bruto y construirán ellos mismos el flujo y las herramientas de revisión.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Sightengine y OpenModeration, frente a frente</h2>
      <p class="mt-4 text-surface-500">Información sobre Sightengine tomada de su web, sightengine.com, consultada el 30 de octubre de 2026. Precios sin impuestos.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Sightengine</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Un motor de IA que sigue el progreso de los modelos</h2>
      <p class="mt-4 text-surface-600">Sightengine afirma basarse en «modelos de última generación y tecnología propia», con modelos y clases a medida en su plan Enterprise. Según sus preguntas frecuentes, sus modelos de texto de aprendizaje automático cubren 7 idiomas.</p>
      <p class="mt-4 text-surface-600">OpenModeration funciona con su propia IA de moderación y, en los casos delicados, otros modelos de IA contrastan sus decisiones. El motor no depende de ningún modelo: cuando sale uno mejor o más barato, nuestro equipo lo conecta rápido, sin que tengas que cambiar nada. Tu moderación avanza al ritmo del mercado de la IA en lugar de quedarse congelada en un único algoritmo propio.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Precio de Sightengine y precio de OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Sightengine</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-600">
          <li>Gratis: 2.000 operaciones al mes, 500 al día como máximo</li>
          <li>Starter: 29 $ al mes por 10.000 operaciones</li>
          <li>Pro: 99 $ al mes por 40.000 operaciones</li>
          <li>Operación adicional: 0,002 $</li>
          <li>Enterprise: a medida</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6">
          <h3 class="font-semibold text-brand-700">OpenModeration</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-700">
          <li>Gratis: hasta 1.000 solicitudes al mes</li>
          <li>Pro: 99 € al mes por 10.000 solicitudes</li>
          <li>Enterprise: a medida, para grandes volúmenes</li>
          <li>Despliegue on-premise: solo bajo petición</li>
          </ul>
        </div>
      </div>
      <p class="mt-6 text-sm text-surface-500">Sightengine cuenta operaciones y OpenModeration solicitudes: compara con tus propios volúmenes. Un plan de Sightengine cubre también imágenes y vídeo, mientras que el precio de OpenModeration incluye la consola de revisión, los conectores y el acompañamiento del equipo de Logora.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pasar de Sightengine a OpenModeration en 3 pasos</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">1</div>
          <h3 class="mt-4 font-semibold text-surface-900">Activa el modo sandbox junto a Sightengine</h3>
          <p class="mt-2 text-sm text-surface-600">Conecta tu web o tus páginas sociales. OpenModeration analiza tus comentarios reales sin ocultar nada, mientras Sightengine sigue funcionando.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">2</div>
          <h3 class="mt-4 font-semibold text-surface-900">Adapta las reglas con nuestro equipo</h3>
          <p class="mt-2 text-sm text-surface-600">El equipo de Logora adapta la moderación a tus reglas y casos de uso. Comparas las decisiones, y sus explicaciones escritas, comentario a comentario.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">3</div>
          <h3 class="mt-4 font-semibold text-surface-900">Activa las acciones automáticas</h3>
          <p class="mt-2 text-sm text-surface-600">Cuando los resultados te convencen, las infracciones claras se ocultan solas y nuestro equipo trata los casos dudosos; tú lo ves todo en la consola.</p>
        </div>
      </div>
      <div class="mt-8">
        <a href="/es/reservar-llamada" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Reservar una llamada</a>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Sightengine es una marca de su propietario. La información sobre ella procede de su web (consultada el 30 de octubre de 2026). ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-center text-xs text-surface-400">
        Fuentes: <a href="https://sightengine.com/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/pricing</a> · <a href="https://sightengine.com/about" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/about</a> · <a href="https://sightengine.com/text-moderation-api" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/text-moderation-api</a> · <a href="https://sightengine.com/faq/languages-for-text-moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/faq/languages-for-text-moderation</a> · <a href="https://sightengine.com/faq/automated-vs-hybrid-moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/faq/automated-vs-hybrid-moderation</a>
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/software-de-moderacion" class="font-medium text-brand-600 hover:text-brand-500">El software de moderación OpenModeration &rarr;</a></li>
        <li><a href="/es/casos-de-uso/medios" class="font-medium text-brand-600 hover:text-brand-500">Moderación de comentarios para medios &rarr;</a></li>
        <li><a href="/es/blog/moderacion-de-comentarios-guia" class="font-medium text-brand-600 hover:text-brand-500">La guía de moderación de comentarios &rarr;</a></li>
        <li><a href="/es/blog/guia-moderacion-contenido-ia-desarrolladores" class="font-medium text-brand-600 hover:text-brand-500">Moderación de contenido con IA: guía para desarrolladores &rarr;</a></li>
        <li><a href="/es/precios" class="font-medium text-brand-600 hover:text-brand-500">Los precios de OpenModeration &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Modera tus comentarios, no solo tus imágenes." subtitle="Reserva una llamada: revisamos tus reglas y casos de uso y luego lanzamos el sandbox sobre tus comentarios reales, junto a Sightengine." buttonText="Reservar una llamada" buttonHref="/es/reservar-llamada" />
</BaseLayout>
