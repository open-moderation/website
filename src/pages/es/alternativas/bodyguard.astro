---
import { bookingUrl } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import SwitchProvider from '../../../components/SwitchProvider.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/bodyguard",
  "name": "Alternativa a Bodyguard: comparativa con OpenModeration",
  "description": "¿Bodyguard u OpenModeration? Comparativa con fuentes de las dos herramientas de moderación: redes cubiertas, precios, alojamiento de los datos y explicación por escrito de cada decisión.",
  "inLanguage": "es",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Ofertas", bodyguard: "Una API de moderación para plataformas y una oferta de moderación de redes sociales para marcas, agencias y organismos públicos", openmod: "Una única plataforma: conectores para redes sociales y WordPress, API REST y webhooks para todo lo demás" },
  { feature: "Redes sociales cubiertas", bodyguard: "Facebook, Instagram, TikTok, X, LinkedIn, YouTube, Twitch, Discord", openmod: "Web, Facebook, Instagram, YouTube y WordPress de forma nativa; TikTok, X, LinkedIn y otras redes bajo petición, rápidamente" },
  { feature: "Precio", bodyguard: "Guardian desde 1.000 € al mes, Sentinel desde 3.000 € al mes, Commander bajo presupuesto; precio según el tamaño de la audiencia", openmod: "Públicos: gratis hasta 1.000 comentarios analizados al mes, Pro a 99 € al mes" },
  { feature: "Alojamiento de los datos", bodyguard: "No se precisa en la página de inicio", openmod: "Diseñado y alojado en la Unión Europea" },
  { feature: "Modelos de IA", bodyguard: "Tecnología desarrollada por Bodyguard", openmod: "IA de moderación propia, contrastada por otros modelos de IA; los nuevos modelos se incorporan a medida que salen" },
  { feature: "Explicación por escrito de cada decisión", bodyguard: "No se menciona", openmod: "Sí, para cada decisión, en el idioma que elijas" },
  { feature: "DSA", bodyguard: "No se menciona en la página de inicio", openmod: "Registro de auditoría de todas las decisiones, automáticas o humanas" },
  { feature: "Cumplimiento declarado", bodyguard: "RGPD, SOC 2 Type 2", openmod: "RGPD; registro de auditoría completo y registro DSA" },
  { feature: "Idiomas", bodyguard: "46 idiomas, según la empresa", openmod: "Multilingüe, incluidos los idiomas de tu audiencia: cada comentario se analiza en su propio idioma" },
];

const faqItems = [
  {
    question: "¿Cuál es la mejor alternativa a Bodyguard?",
    answer: "Depende de lo que busques. Si quieres un plan gratuito para empezar, datos alojados en la UE y una explicación por escrito de cada comentario ocultado, OpenModeration cumple esos criterios. Si necesitas Twitch o Discord, Bodyguard los cubre de serie. TikTok, X, LinkedIn y otras redes se añaden a OpenModeration bajo petición, rápidamente.",
  },
  {
    question: "¿Cuánto cuesta Bodyguard en comparación con OpenModeration?",
    answer: "Según su página de precios, Bodyguard ofrece un plan Guardian desde 1.000 € al mes y un plan Sentinel desde 3.000 € al mes, con un precio que depende del tamaño de la audiencia. OpenModeration ofrece un plan gratuito de hasta 1.000 comentarios analizados al mes, y un plan Pro a 99 € al mes para 10.000 comentarios analizados.",
  },
  {
    question: "¿OpenModeration cumple la DSA?",
    answer: "OpenModeration redacta una explicación por escrito para cada decisión y conserva un registro de auditoría de todas ellas, tanto si las toma la IA como un moderador. Estas dos piezas sirven directamente para la declaración de motivos que exige el artículo 17 de la DSA.",
  },
  {
    question: "¿Se puede pasar de Bodyguard a OpenModeration sin empezar de cero?",
    answer: "En Facebook, Instagram, YouTube y WordPress basta con conectar tus cuentas y escribir tus reglas en lenguaje natural, sin código. Para una plataforma propia, la API REST de OpenModeration sustituye la llamada a la API anterior.",
  },
];
---

<BaseLayout title="Alternativa a Bodyguard: comparativa con OpenModeration (2026)" description="¿Bodyguard u OpenModeration? Comparativa con fuentes: redes cubiertas, precios, alojamiento en la UE y explicación de cada decisión." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Bodyguard" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Bodyguard: OpenModeration frente a frente</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bodyguard es una empresa francesa reconocida en la moderación con IA. OpenModeration toma otras decisiones: un plan gratuito y luego Pro a 99 € al mes, datos alojados en la UE y una explicación por escrito para cada decisión. Estas son las diferencias, con sus fuentes, para que elijas con conocimiento de causa.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/es/reservar-llamada" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Reservar una llamada</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Probar gratis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>quieres empezar gratis y después pagar menos de 100 € al mes;</li>
          <li>te importa tener un registro de auditoría completo y poder exportar tus datos;</li>
          <li>tus datos deben quedarse en la Unión Europea;</li>
          <li>tienes que explicar cada retirada de un comentario, como exige la DSA;</li>
          <li>quieres elegir, o cambiar, los modelos de IA que evalúan tus contenidos.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Bodyguard puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>necesitas moderar Twitch o Discord de serie;</li>
          <li>tu departamento de compras exige una certificación SOC 2 Type 2.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Bodyguard y OpenModeration, punto por punto</h2>
      <p class="mt-4 text-surface-500">Información sobre Bodyguard extraída de su web, bodyguard.ai, consultada el 20 de octubre de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Bodyguard</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.bodyguard}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Lo que cambia de verdad en el día a día</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sabes por qué se ocultó un comentario</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration acompaña cada decisión con una explicación por escrito, visible para tu equipo y devuelta por la API. Puedes responder a un lector que la impugne, y la DSA exige precisamente explicar cada retirada.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Tus reglas, escritas tal como las piensas</h3>
          <p class="mt-2 text-sm text-surface-600">Redactas tus reglas en lenguaje natural, añades palabras prohibidas y ajustas un umbral por categoría. Nuestro equipo trata los casos límite; tú ves cada decisión en tiempo real y puedes intervenir cuando quieras.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Un precio de entrada mucho más bajo</h3>
          <p class="mt-2 text-sm text-surface-600">Bodyguard empieza en 1.000 € al mes. OpenModeration es gratis hasta 1.000 comentarios analizados al mes y el plan Pro cuesta 99 € al mes. Si necesitas un despliegue on-premise, es posible bajo petición: <a href={bookingUrl('es')} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:text-brand-500">hablemos</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sin depender de un único modelo</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration funciona con su propia IA de moderación, y en los casos delicados otros modelos de IA contrastan su decisión. Cuando sale un modelo mejor o más económico, el equipo lo incorpora rápidamente, sin que tengas nada que cambiar.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bodyguard es una marca de su empresa titular. La información sobre ella procede de <a href="https://bodyguard.ai/fr" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">bodyguard.ai</a> y de su <a href="https://www.bodyguard.ai/en/social-media/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">página de precios</a> (consultada el 20 de octubre de 2026). ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/moderacion-redes-sociales" class="font-medium text-brand-600 hover:text-brand-500">Moderación de redes sociales con OpenModeration &rarr;</a></li>
        <li><a href="/es/cumplimiento-dsa/declaracion-de-motivos" class="font-medium text-brand-600 hover:text-brand-500">La declaración de motivos que exige la DSA &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
        <li><a href="/es/precios" class="font-medium text-brand-600 hover:text-brand-500">Los precios de OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Prueba la alternativa a Bodyguard." subtitle="Conecta tus páginas, escribe tus reglas y consulta la explicación por escrito de cada comentario ocultado. Gratis para empezar." />
</BaseLayout>
