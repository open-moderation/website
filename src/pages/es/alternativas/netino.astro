---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/netino",
  "name": "Alternativa a Netino: comparativa con OpenModeration",
  "description": "¿Netino u OpenModeration? Un servicio de moderación externalizado frente a un software que pilota tu equipo: reglas, contexto, explicación por escrito, prueba sin riesgo y precios públicos.",
  "inLanguage": "es",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Tipo de oferta", netino: "Servicio externalizado: Netino by Concentrix se presenta como «Marketing Process Outsourcer» y opera la moderación por ti", openmod: "Un software que tu equipo pilota, con la IA aplicando tus reglas" },
  { feature: "Quién decide", netino: "IA y moderadores de Netino; más de 3.000 moderadores 24 horas al día, según Blog du Modérateur", openmod: "La IA aplica tus reglas; tu equipo resuelve los casos de la zona gris" },
  { feature: "Reglas de moderación", netino: "Definidas en el marco del encargo", openmod: "Tu normativa en lenguaje natural, modificable cuando quieras, con propuestas de ajuste sacadas de las decisiones de tu equipo" },
  { feature: "Redes cubiertas", netino: "Moderación «multiplataforma»; la página de inicio no precisa las redes", openmod: "Facebook, Instagram, YouTube y WordPress de forma nativa; API REST y webhooks para el resto" },
  { feature: "Contexto", netino: "No se precisa en su web", openmod: "La IA lee cada comentario con el titular y el hilo de la conversación" },
  { feature: "Explicación de cada decisión", netino: "No se menciona", openmod: "Una explicación por escrito para cada decisión, en el idioma que elijas" },
  { feature: "Probar antes de cambiar", netino: "No se menciona", openmod: "Modo sandbox: OpenModeration analiza tus comentarios sin aplicar ninguna acción" },
  { feature: "Precio", netino: "No publica tarifas (formulario de contacto)", openmod: "Públicos: gratis hasta 1.000 solicitudes al mes, Pro a 99 € al mes, ofertas a medida para grandes volúmenes" },
  { feature: "Alojamiento de los datos", netino: "No se precisa en la página de inicio", openmod: "Diseñado y alojado en la Unión Europea; on-premise posible bajo petición" },
  { feature: "Otros servicios", netino: "Community management, social listening y atención al cliente en redes sociales", openmod: "Solo moderación" },
];

const faqItems = [
  {
    question: "¿Cuál es la mejor alternativa a Netino?",
    answer: "Depende de lo que quieras delegar. Netino es un servicio: sus equipos, apoyados por la IA, moderan por ti. OpenModeration es un software: la IA aplica tus reglas automáticamente y tu equipo decide en los casos dudosos, con una explicación por escrito para cada decisión.",
  },
  {
    question: "¿Cuánto cuesta Netino?",
    answer: "Netino no publica tarifas en su web; hay que pedir un presupuesto. OpenModeration publica las suyas: gratis hasta 1.000 solicitudes al mes, plan Pro a 99 € al mes para 10.000 solicitudes y ofertas a medida para grandes volúmenes.",
  },
  {
    question: "¿Puedo probar OpenModeration sin dejar Netino?",
    answer: "Sí. En modo sandbox, OpenModeration analiza los comentarios de la página o de la web conectada e indica lo que habría decidido, sin ocultar ni borrar nada. Comparas en silencio antes de decidir.",
  },
  {
    question: "¿Qué medios españoles trabajan con Netino?",
    answer: "La página de inicio de Netino no muestra clientes españoles. Según un estudio académico publicado en 2021 en El Profesional de la Información, Unidad Editorial (El Mundo, Marca, Expansión) confiaba entonces la moderación de sus comentarios a Netino, mientras que Vocento y Prisa trabajaban con Interactora.",
  },
  {
    question: "¿Netino puede encajarme mejor?",
    answer: "Si quieres confiar a un proveedor toda tu presencia en redes sociales (animación de la comunidad, respuestas a clientes, escucha social), un servicio como el de Netino cubre un perímetro más amplio que la moderación. OpenModeration no ofrece un equipo de moderadores.",
  },
];
---

<BaseLayout title="Alternativa a Netino: comparativa con OpenModeration (2026)" description="¿Netino u OpenModeration? Un servicio externalizado frente a un software que pilotas: tus reglas, el contexto, una explicación escrita y una prueba sin riesgo." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Netino" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Netino: recupera el control de tu moderación</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Netino, del grupo Concentrix, modera por cuenta de sus clientes combinando IA y equipos humanos. OpenModeration toma otro camino: un software que aplica tu normativa automáticamente, entiende el contexto de cada publicación y deja que tu equipo resuelva los casos difíciles, con una explicación por escrito para cada decisión.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>quieres que tu redacción o tu equipo fije las reglas y las cambie al ritmo de la actualidad;</li>
          <li>quieres saber por qué se ocultó cada comentario;</li>
          <li>tienes que explicar cada retirada, como exige la Ley de Servicios Digitales (DSA);</li>
          <li>prefieres pagar según tu volumen, con un precio publicado;</li>
          <li>tus datos deben quedarse en la Unión Europea.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Netino puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>quieres que un equipo externo modere día y noche en tu lugar;</li>
          <li>también buscas community management, escucha social o atención al cliente en redes;</li>
          <li>prefieres un proveedor de gran tamaño, respaldado por el grupo Concentrix.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Netino y OpenModeration, punto por punto</h2>
      <p class="mt-4 text-surface-500">Información sobre Netino extraída de su web, netino.com, consultada el 20 de octubre de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Netino</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.netino}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Lo que cambia cuando pilotas tu moderación</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">El contexto, no una lista de palabras</h3>
          <p class="mt-2 text-sm text-surface-600">Un mismo comentario no pesa igual bajo una noticia sobre una recogida solidaria que bajo un tema que divide. OpenModeration pasa a la IA el titular y el hilo de la conversación para detectar la ironía y los ataques disimulados.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Reglas que siguen la actualidad</h3>
          <p class="mt-2 text-sm text-surface-600">Una campaña electoral, un suceso, un grupo que vuelve siempre con los mismos ataques: añades una línea a tu normativa y se aplica en el acto. OpenModeration también te propone reglas a partir de las decisiones de tu equipo.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Cada decisión, explicada</h3>
          <p class="mt-2 text-sm text-surface-600">Cada comentario retirado conserva la regla aplicada y una explicación por escrito. Sabes qué responder a un lector que protesta, y la DSA exige justamente explicar cada retirada.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Una prueba sin riesgo</h3>
          <p class="mt-2 text-sm text-surface-600">En modo sandbox, OpenModeration analiza tus comentarios reales sin aplicar ninguna acción. Comparas sus decisiones con las de tu solución actual antes de cambiar nada.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Netino es una marca de su empresa titular. La información sobre ella procede de <a href="https://netino.com/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">netino.com</a>, del <a href="https://www.blogdumoderateur.com/tools/netino-by-concentrix/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Blog du Modérateur</a> y del <a href="https://revista.profesionaldelainformacion.com/index.php/EPI/article/download/86568/63065/290349" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">estudio de Paz-Rebollo et al. (2021)</a>, consultados el 20 de octubre de 2026. ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/alternativas/interactora" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration o Interactora: la comparativa &rarr;</a></li>
        <li><a href="/es/casos-de-uso/medios" class="font-medium text-brand-600 hover:text-brand-500">La moderación de comentarios para medios &rarr;</a></li>
        <li><a href="/es/moderacion-redes-sociales" class="font-medium text-brand-600 hover:text-brand-500">La moderación de redes sociales &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Prueba OpenModeration junto a tu solución actual." subtitle="Conecta una página en modo sandbox: ves lo que OpenModeration habría decidido, sin cambiar nada en tu moderación." />
</BaseLayout>
