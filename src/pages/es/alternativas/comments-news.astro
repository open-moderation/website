---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/comments-news",
  "name": "Alternativa a Comments News: comparativa con OpenModeration",
  "description": "¿Comments News u OpenModeration? Un sistema de comentarios con moderación integrada frente a un software que modera tus comentarios actuales y tus redes sociales, con una explicación de cada decisión.",
  "inLanguage": "es",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Tipo de producto", commentsnews: "Una plataforma de comentarios y debates para medios, con moderación por IA integrada", openmod: "Un software de moderación que trabaja sobre tu sistema de comentarios actual y tus redes sociales; no incluye un widget de comentarios" },
  { feature: "Instalación", commentsnews: "Un script en la web, con el login del propio medio", openmod: "Conectores nativos para Facebook, Instagram, YouTube y WordPress; API REST y webhooks para el resto" },
  { feature: "Redes sociales", commentsnews: "No se mencionan", openmod: "Facebook, Instagram y YouTube" },
  { feature: "Precio", commentsnews: "Cabecera 49 USD al mes (precio de lista 99 USD), Redacción 149 USD (lista 299 USD), Grupo 299 USD (lista 599 USD)", openmod: "Gratis hasta 1.000 solicitudes al mes, Pro a 99 € al mes para 10.000, ofertas a medida para grandes volúmenes" },
  { feature: "Moderación con IA", commentsnews: "Básica en el plan Cabecera; «moderación PRO con IA» en los planes Redacción y Grupo", openmod: "Tu normativa en lenguaje natural, un umbral por categoría y una zona gris que revisa tu equipo" },
  { feature: "Contexto", commentsnews: "El plan Redacción «entiende el contexto editorial»; el plan básico no", openmod: "La IA lee cada comentario con el titular y el hilo de la conversación" },
  { feature: "Explicación de cada decisión", commentsnews: "No se menciona", openmod: "Una explicación por escrito para cada decisión, en el idioma que elijas, devuelta por la API" },
  { feature: "Registro para la DSA", commentsnews: "No se menciona", openmod: "Registro de actividad: cada decisión indica si fue automática o qué moderador la tomó" },
  { feature: "Alojamiento y código", commentsnews: "No se precisa", openmod: "Diseñado y alojado en la UE; open source con licencia AGPL v3 y autoalojamiento con Docker" },
  { feature: "Referencias", commentsnews: "El Destape, El Día, El Tribuno, Tiempo de San Juan, El Deber, El Chubut, La Nueva y otros medios de Argentina y Bolivia", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "¿Cuál es la mejor alternativa a Comments News?",
    answer: "Depende de lo que te falte. Si necesitas un sistema de comentarios completo, con debates y estadísticas, Comments News lo ofrece y OpenModeration no. Si ya tienes tus comentarios (en WordPress, en una plataforma propia o en redes sociales) y quieres moderarlos con tus reglas y una explicación por escrito de cada decisión, OpenModeration está hecho para eso.",
  },
  {
    question: "¿Cuánto cuesta Comments News?",
    answer: "Según su web, el plan Cabecera cuesta 49 USD al mes, el plan Redacción 149 USD y el plan Grupo 299 USD, presentados como un 50 % de descuento sobre el precio de lista. OpenModeration es gratis hasta 1.000 solicitudes al mes y cuesta 99 € al mes en el plan Pro, para 10.000 solicitudes.",
  },
  {
    question: "¿Puedo probar OpenModeration sin dejar Comments News?",
    answer: "OpenModeration no sustituye un sistema de comentarios. Puedes probarlo en modo sandbox en tus páginas de Facebook, Instagram o YouTube, o en un sitio WordPress: analiza los comentarios reales y muestra lo que habría decidido, sin ocultar ni borrar nada.",
  },
  {
    question: "¿OpenModeration sirve para medios de América Latina?",
    answer: "Sí. OpenModeration funciona como servicio en línea desde cualquier país, entiende los comentarios en español y redacta las explicaciones en el idioma que elijas. Estadão, en Brasil, es uno de nuestros clientes. Los precios se facturan en euros.",
  },
];
---

<BaseLayout title="Alternativa a Comments News: comparativa con OpenModeration (2026)" description="¿Comments News u OpenModeration? Un sistema de comentarios frente a un software que modera tus comentarios y tus redes sociales con una explicación escrita." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Comments News" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Comments News: modera los comentarios que ya tienes</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Comments News es un sistema de comentarios para medios, usado en Argentina y Bolivia, con moderación por IA incluida. OpenModeration no reemplaza tu sistema de comentarios: modera los que ya tienes, en tu web y en tus redes sociales, y explica por escrito cada decisión. Estas son las diferencias, con sus fuentes.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>quieres conservar tu sistema de comentarios actual;</li>
          <li>también moderas los comentarios de Facebook, Instagram o YouTube;</li>
          <li>quieres una explicación por escrito de cada comentario ocultado;</li>
          <li>publicas en Europa y tienes que cumplir la DSA;</li>
          <li>prefieres un código abierto que puedas alojar tú mismo.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Comments News puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>buscas un sistema de comentarios completo, con debates y la moderación incluida;</li>
          <li>quieres enviar eventos de comentarios a GA4 o Marfeel;</li>
          <li>tu medio está en América Latina y prefieres un proveedor con referencias en la región;</li>
          <li>prefieres pagar en dólares una tarifa fija por dominio.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Comments News y OpenModeration, punto por punto</h2>
      <p class="mt-4 text-surface-500">Información sobre Comments News extraída de su web, comments.news, consultada el 20 de octubre de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Comments News</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.commentsnews}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Lo que cambia de verdad en el día a día</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Tus comentarios se quedan donde están</h3>
          <p class="mt-2 text-sm text-surface-600">No cambias de widget ni de base de usuarios. OpenModeration se conecta a WordPress, a tu plataforma por API y a tus páginas de Facebook, Instagram y YouTube, y modera todo con las mismas reglas.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">El contexto, en todos los planes</h3>
          <p class="mt-2 text-sm text-surface-600">La IA lee cada comentario junto al titular y al hilo de la conversación. Así distingue la ironía de un insulto y una crítica dura de un ataque personal.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sabes por qué se ocultó cada comentario</h3>
          <p class="mt-2 text-sm text-surface-600">Cada decisión llega con una explicación por escrito, y el registro de actividad indica si la tomó la IA o qué moderador. Puedes responder a un lector que protesta, y en Europa la DSA exige explicar cada retirada.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Código abierto</h3>
          <p class="mt-2 text-sm text-surface-600">El código de OpenModeration se publica con licencia AGPL v3. Puedes auditarlo, y alojarlo en tus propios servidores con Docker sin pagar licencia.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Comments News es una marca de su empresa titular. La información sobre ella procede de <a href="https://comments.news/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">comments.news</a> (consultada el 20 de octubre de 2026). ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/casos-de-uso/medios" class="font-medium text-brand-600 hover:text-brand-500">La moderación de comentarios para medios &rarr;</a></li>
        <li><a href="/es/integraciones/moderacion-wordpress" class="font-medium text-brand-600 hover:text-brand-500">Moderar los comentarios de WordPress &rarr;</a></li>
        <li><a href="/es/precios" class="font-medium text-brand-600 hover:text-brand-500">Los precios de OpenModeration &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Modera tus comentarios sin cambiar de sistema." subtitle="Conecta WordPress o tus páginas en redes sociales, escribe tus reglas y lee la explicación de cada decisión. Gratis hasta 1.000 solicitudes al mes." />
</BaseLayout>
