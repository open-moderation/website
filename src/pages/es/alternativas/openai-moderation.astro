---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# OpenAI Moderation API (directo)
const openai = new OpenAI({ apiKey: 'sk-...' });
const mod = await openai.moderations.create({ input: text });
// Resultado: formato propio de OpenAI, 11 categorías, sin umbrales

# OpenModeration (unificado)
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({
    input: text,
    categories: ['hate', 'harassment', 'sexual', 'violence', 'self-harm', 'spam'],
    threshold: 0.5
  })
});
// Además: prefiltro, doble umbral, acciones automáticas, registro de auditoría, consola de equipo`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa a la API OpenAI Moderation: precios y comparativa",
  "description": "¿Buscas una alternativa a la API OpenAI Moderation? OpenModeration reúne varios proveedores de moderación en una sola API y añade reglas automáticas, revisión humana y registros de auditoría para la DSA.",
  "inLanguage": "es",
};

const comparisonPoints = [
  { feature: "Proveedores", openai: "Solo OpenAI (un único proveedor)", openmod: "10 proveedores: OpenAI, Azure, Mistral, HuggingFace, LLM (GPT-4o, Claude), Cohere y más" },
  { feature: "Formato de la API", openai: "Formato propietario de OpenAI", openmod: "Formato estandarizado para todos los proveedores. Cambia de proveedor sin tocar el código." },
  { feature: "Prefiltrado", openai: "No disponible: cada petición llega a la API", openmod: "Filtro de palabras integrado que bloquea el contenido evidente antes de cualquier llamada a la API y ahorra costes" },
  { feature: "Lógica de decisión", openai: "Binaria: marcado o no marcado por categoría", openmod: "Doble umbral: aprobación automática / zona gris → revisión humana / rechazo automático" },
  { feature: "Consola de moderación", openai: "Solo API. Sin consola ni interfaz de revisión.", openmod: "Consola completa: cola de moderación, roles de equipo, analítica, estado de los proveedores" },
  { feature: "Reglas automáticas", openai: "Tienes que construir tu propia integración", openmod: "Listas para usar: defines las reglas una vez y el motor de acciones las aplica automáticamente" },
  { feature: "Revisión humana", openai: "Tienes que construir tu propia interfaz de revisión", openmod: "Cola de revisión integrada con contexto, asignación y aprobación/rechazo" },
  { feature: "Registro de auditoría", openai: "Limitado a los registros de la API", openmod: "Registro de auditoría completo: cada decisión de la IA y humana registrada, exportable para la DSA" },
  { feature: "Dependencia del proveedor", openai: "Dependencia total del ecosistema de OpenAI", openmod: "Ninguna. BYOK, autoalojable, open source bajo AGPL v3" },
  { feature: "Soberanía de los datos", openai: "Datos procesados en los servidores de OpenAI", openmod: "Autoalojamiento en tu infraestructura. Opción de nube europea disponible." },
  { feature: "Precios", openai: "Endpoint gratuito (solo puntuaciones)", openmod: "Gratis en autoalojamiento. Nube gestionada desde 99 €/mes (10.000 peticiones incluidas)." },
  { feature: "Longitud máxima de entrada", openai: "32.000 caracteres", openmod: "Hasta 32.000 caracteres (según el proveedor) + procesamiento por lotes para volúmenes mayores" },
];

const reasons = [
  {
    title: "Dependes de la precisión de un solo proveedor",
    icon: "lock",
    description: "OpenAI Moderation funciona muy bien en inglés, pero se queda corto en otros idiomas, en categorías de nicho o cuando necesitas un respaldo. Con OpenModeration, cada petición va al mejor proveedor: OpenAI para la toxicidad en inglés, Mistral para el spam multilingüe y LLM para las categorías personalizadas."
  },
  {
    title: "Una llamada a una API no es un flujo de moderación",
    icon: "api",
    description: "Con la puntuación de toxicidad de OpenAI en la mano, todavía tienes que decidir qué puntuación desencadena qué acción, construir una interfaz de revisión para los casos de la zona gris, registrar cada decisión para las auditorías y gestionar los accesos de tu equipo. OpenModeration ya trae todo eso."
  },
  {
    title: "Sin prefiltrado, cada comentario va a la API",
    icon: "cost",
    description: "El endpoint de OpenAI es gratuito, pero cada comentario hace igualmente un viaje de ida y vuelta hasta él, incluso el spam evidente o las palabras prohibidas. El prefiltro de OpenModeration los bloquea antes de que lleguen a cualquier proveedor, lo que también reduce los costes de los proveedores de pago que añadas."
  },
  {
    title: "Cumplir la DSA exige algo más que una API",
    icon: "compliance",
    description: "La Ley de Servicios Digitales de la UE exige decisiones de moderación documentadas, mecanismos de reclamación e informes de transparencia. Una respuesta en bruto de una API no basta. OpenModeration incluye el registro de auditoría, el historial de revisiones y los informes exportables."
  },
];

const verticals = [
  { name: "Plataformas sociales", desc: "Modera los comentarios y publicaciones de los usuarios con una IA que entiende el contexto y con las reglas propias de cada comunidad." },
  { name: "Aplicaciones de IA", desc: "Filtra tanto las entradas de los usuarios como las salidas del LLM. Usa la moderación basada en LLM para categorías personalizadas y cambiantes." },
  { name: "Videojuegos", desc: "Modera el chat en tiempo real y en varios idiomas, con una latencia inferior a 250 ms y acciones automáticas." },
  { name: "Marketplaces", desc: "Marca los anuncios de spam, el discurso de odio en las reseñas y las fugas de datos personales antes de que se publiquen." },
];

const faqItems = [
  {
    question: "¿Cuánto cuesta la API OpenAI Moderation frente a OpenModeration?",
    answer: "El endpoint de moderación de OpenAI es gratuito, pero solo devuelve puntuaciones. No incluye consola, reglas, revisión humana ni registro de auditoría. OpenModeration es gratuito si lo autoalojas y sigue usando omni-moderation-latest por debajo; la nube gestionada empieza en 99 €/mes por 10.000 peticiones."
  },
  {
    question: "¿Puedo seguir usando OpenAI como proveedor?",
    answer: "Sí. Usa tu propia clave de OpenAI (BYOK) y conserva omni-moderation-latest. Añade Mistral, Azure o Llama Guard como respaldo con un cambio de configuración, sin reescribir código."
  },
  {
    question: "¿Cuánto tarda la migración?",
    answer: "Menos de una hora: una llamada POST /v1/moderation sustituye a openai.moderations.create. Las puntuaciones se convierten a un formato estandarizado y los umbrales y las reglas se aplican de inmediato."
  },
  {
    question: "¿Qué gano además de las puntuaciones en bruto?",
    answer: "El prefiltro, el doble umbral (aprobación automática / revisión humana / rechazo automático), la consola de moderación, los roles de equipo y un registro de auditoría preparado para la DSA, con informes exportables."
  },
  {
    question: "¿Es open source?",
    answer: "Sí, bajo AGPL v3. Autoalójalo con Docker y conserva todos los datos en tu infraestructura, o usa la nube gestionada alojada en la UE."
  },
  {
    question: "¿Qué API de moderación es la mejor para el cumplimiento normativo en una empresa?",
    answer: "Para cumplir la normativa, una empresa necesita decisiones documentadas, control de acceso por roles, registros de auditoría e informes exportables, y unas puntuaciones en bruto no bastan. En OpenModeration, cada decisión de la IA y humana queda registrada, las reglas se aplican automáticamente y el registro de auditoría completo se exporta con un clic para los informes de transparencia de la DSA. El autoalojamiento o la nube europea mantienen los datos bajo tu control."
  },
  {
    question: "¿Funciona OpenModeration con el modelo omni-moderation-latest de OpenAI?",
    answer: "Sí. Usa tu propia clave de OpenAI y envía todas las peticiones a omni-moderation-latest como modelo principal. Las respuestas se estandarizan entre proveedores y puedes añadir Mistral, Azure o HuggingFace como respaldo con un cambio de configuración, sin reescribir código."
  },
];
---

<BaseLayout
  title="Alternativa a la API OpenAI Moderation: precios y comparativa"
  description="El endpoint gratuito de OpenAI solo da puntuaciones. OpenModeration suma 10 proveedores en una API, prefiltrado, reglas, revisión humana y auditoría DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Alternativa a OpenAI Moderation" }]} />
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-50 px-4 py-1.5 text-sm font-medium text-green-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Alternativa a la API OpenAI Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        OpenAI Moderation es un proveedor.<br/>OpenModeration es una plataforma que lo incluye.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        La API de moderación de OpenAI te da puntuaciones de toxicidad. OpenModeration añade todo lo que hace falta
        para moderar de verdad: 10 proveedores a través de una sola API, prefiltrado, reglas automáticas,
        revisión humana y registros de auditoría conformes a la DSA. El código es abierto, puedes autoalojarlo y no dependes de ningún proveedor.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Prueba OpenModeration gratis</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Ver la comparativa completa</a>
      </div>
    </div>
  </section>

  <!-- Why switch section -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por qué los equipos dejan OpenAI Moderation</h2>
        <p class="mt-4 text-lg text-surface-500">La API de OpenAI es un buen motor de moderación, pero le falta todo lo que va alrededor.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
              {r.icon === 'lock' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>}
              {r.icon === 'api' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>}
              {r.icon === 'cost' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
              {r.icon === 'compliance' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>}
            </div>
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Una integración para todos los proveedores
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            La misma moderación de texto, con más control
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Con la API de OpenAI obtienes puntuaciones. Con OpenModeration obtienes las mismas puntuaciones
            <strong>y además</strong> prefiltrado, umbrales configurables, acciones automáticas
            y un registro de auditoría completo, con la misma llamada a la API.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Sigue usando OpenAI</strong> como proveedor a través de OpenModeration con tus propias claves de API (BYOK).</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Añade redundancia</strong> enviando las peticiones a Mistral, Azure o HuggingFace cuando OpenAI va lento o no responde.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Compara proveedores</strong> con objetividad gracias a una analítica unificada de todo tu tráfico de moderación.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">API OpenAI Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Las funcionalidades que cuentan cuando moderas en producción.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funcionalidad</th>
              <th class="px-6 py-4 font-semibold text-surface-500">API OpenAI Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.openai}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Hidden cost vs advantage -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Usar solo la API OpenAI Moderation
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Cada comentario va a la API, incluso el spam evidente o las palabras prohibidas</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Marcado o no marcado, sin más: no hay zona gris para el contenido con matices</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Tienes que construir tu propia consola para que los moderadores revisen los casos límite</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Tienes que construir tu propio motor de reglas para convertir las puntuaciones en acciones</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Tienes que construir tu propio sistema de registro de auditoría para cumplir la DSA</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Sin respaldo si OpenAI va lento o no está disponible</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Dependencia del ecosistema de OpenAI</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            OpenModeration (con OpenAI como proveedor)
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> El prefiltro bloquea el spam evidente y las palabras prohibidas antes de cualquier llamada a la API, lo que ahorra entre un 10 y un 30 % en costes</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Con el doble umbral, cada comentario se aprueba, se rechaza o pasa a revisión humana según los límites que fijes</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> La consola está lista y tu equipo de moderación puede empezar a revisar desde el primer día</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Las reglas se configuran sin código con tres herramientas: palabras prohibidas, umbrales por categoría y las normas de tu comunidad</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> El registro de auditoría, los informes exportables y la retención de datos configurable vienen incluidos</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Si OpenAI va lento, las peticiones pasan a Mistral, Azure o HuggingFace</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> No dependes de nadie: el código es abierto (AGPL v3), puedes autoalojarlo y usar tus propias claves</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pensado para todos los casos de uso de la moderación de contenido</h2>
        <p class="mt-4 text-lg text-surface-500">OpenModeration puede sustituir a la API de OpenAI o funcionar junto a ella.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{v.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- omni-moderation-latest compatibility -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Compatible con omni-moderation-latest de OpenAI y con 9 modelos más</h2>
        <p class="mt-4 text-lg text-surface-500">Conserva como motor principal el modelo de moderación de OpenAI que ya usas y añádele todo lo demás.</p>
        <p class="mt-2 text-sm"><a href="/es/blog/guia-api-openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">Cómo funciona la API OpenAI Moderation: categorías, precio y límites &rarr;</a></p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Conserva omni-moderation-latest</h3>
          <p class="mt-2 text-sm text-surface-500">Usa tu propia clave de OpenAI (BYOK) y envía cada petición a omni-moderation-latest: el mismo modelo, con un formato de respuesta estandarizado.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Añade modelos de respaldo</h3>
          <p class="mt-2 text-sm text-surface-500">Si OpenAI va lento o no responde, las peticiones pasan automáticamente a Mistral, Azure o HuggingFace, sin tocar el código.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
