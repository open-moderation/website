---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/webpurify",
  "name": "Alternativa a WebPurify: comparativa con OpenModeration",
  "description": "¿WebPurify u OpenModeration? Comparativa con fuentes: filtro de palabrotas o moderación con IA, revisión humana, DSA, alojamiento UE, IA y precios públicos.",
  "inLanguage": "es",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  {
    "feature": "Oferta",
    "competitor": "API de filtro de palabrotas, moderación de imágenes y vídeos con IA y con sus propios moderadores humanos",
    "openmod": "Moderación de comentarios con IA para medios, marcas e instituciones públicas, puesta en marcha contigo por el equipo de Logora"
  },
  {
    "feature": "Contenido moderado",
    "competitor": "Texto (filtro de palabrotas en 15 idiomas), imágenes y vídeos",
    "openmod": "Comentarios publicados en tus sitios web y páginas sociales"
  },
  {
    "feature": "Integraciones",
    "competitor": "API; licencia de plugin para CMS como WordPress o Drupal. Conectores de redes sociales no especificados en las páginas consultadas",
    "openmod": "API para sitios web, páginas de Facebook, cuentas profesionales de Instagram, canales de YouTube, WordPress"
  },
  {
    "feature": "Modelos de IA",
    "competitor": "IA combinada con moderadores humanos; los modelos usados no se especifican en su web",
    "openmod": "IA de moderación propia, contrastada por otros modelos de IA; nuevos modelos conectados en cuanto salen"
  },
  {
    "feature": "Revisión humana",
    "competitor": "A cargo de los moderadores de WebPurify (moderación «live»), facturada por imagen o por minuto de vídeo",
    "openmod": "Infracciones claras ocultadas automáticamente, casos dudosos tratados por nuestro equipo; ves cada decisión en tiempo real en una sola consola"
  },
  {
    "feature": "Explicación de las decisiones",
    "competitor": "No especificado en su web",
    "openmod": "Una explicación escrita para cada decisión y un registro de actividad completo"
  },
  {
    "feature": "DSA",
    "competitor": "No especificado en su web",
    "openmod": "Notificación y acción, declaración de motivos, revisión humana de decisiones impugnadas, cifras exportables"
  },
  {
    "feature": "Alojamiento y datos",
    "competitor": "No especificado en su web; empresa con sede en Irvine, California",
    "openmod": "Alojado en la Unión Europea, RGPD; despliegue on-premise bajo petición"
  },
  {
    "feature": "Precios públicos",
    "competitor": "Filtro: 5 $/mes (plugin), 15 $/mes (estándar), 50 $/mes (hasta 6 dominios); moderación de imágenes live: 2 centavos por imagen",
    "openmod": "Gratis hasta 1.000 solicitudes/mes, Pro a 99 €/mes por 10.000 solicitudes, Enterprise a medida"
  },
  {
    "feature": "Referencias",
    "competitor": "No especificado en las páginas consultadas",
    "openmod": "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora"
  }
];

const faqItems = [
  {
    "question": "¿Cuál es la mejor alternativa a WebPurify?",
    "answer": "Para moderar comentarios de medios, páginas de marca y canales públicos, OpenModeration está pensado para ese uso: una IA que lee el contexto, conectores de redes sociales y WordPress, un equipo que trata los casos dudosos por ti, una explicación escrita de cada decisión y alojamiento en la UE. Si quieres moderadores humanos del proveedor para imágenes y vídeos, WebPurify está hecho para eso."
  },
  {
    "question": "¿Cuánto cuesta WebPurify?",
    "answer": "Según su web y sus condiciones: el filtro de palabrotas cuesta 5 $ al mes (licencia plugin), 15 $ al mes (estándar) o 50 $ al mes hasta 6 dominios, y la moderación de imágenes live 2 centavos por imagen, con una prueba gratuita de 14 días. OpenModeration es gratis hasta 1.000 solicitudes al mes y luego cuesta 99 € al mes por 10.000 solicitudes."
  },
  {
    "question": "WebPurify vs OpenModeration: ¿qué diferencia hay?",
    "answer": "WebPurify vende un filtro de palabrotas y trabajo de moderación hecho por sus propios equipos humanos. OpenModeration es moderación de comentarios con IA adaptada a tus reglas y casos de uso: actúa sobre tus comentarios, deja visibles las críticas legítimas, confía los casos dudosos a nuestro equipo y explica cada decisión por escrito."
  },
  {
    "question": "¿Puedo probar OpenModeration sin apagar WebPurify?",
    "answer": "Sí. En modo sandbox, OpenModeration analiza tus comentarios reales sin ocultar nada. WebPurify sigue funcionando y comparas las dos series de decisiones sobre los mismos comentarios, cada decisión de OpenModeration con su explicación escrita."
  },
  {
    "question": "¿Qué IA usa OpenModeration?",
    "answer": "OpenModeration funciona con su propia IA de moderación, y otros modelos de IA contrastan sus decisiones en los casos delicados. Cuando sale un modelo mejor o más barato, nuestro equipo lo conecta sin que cambies nada: te beneficias del progreso de los modelos de IA."
  },
  {
    "question": "¿WebPurify usa moderadores humanos?",
    "answer": "Sí. Según su web, su moderación «live» la hacen sus propios moderadores, por ejemplo a 2 centavos por imagen. Con OpenModeration, nuestro equipo trata los casos dudosos, y tú ves cada decisión en tiempo real en una sola consola, con su explicación escrita."
  }
];
---

<BaseLayout title="Alternativa a WebPurify: comparativa con OpenModeration" description="¿WebPurify u OpenModeration? Comparativa con fuentes: filtro de palabrotas o moderación con IA, revisión humana, DSA, alojamiento UE, IA y precios públicos." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "WebPurify" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a WebPurify: OpenModeration frente a frente</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Si buscas una moderación de comentarios que entienda el contexto en lugar de solo filtrar palabrotas, OpenModeration es una buena alternativa a WebPurify: su IA oculta las infracciones claras, deja visibles las críticas legítimas y confía los casos dudosos a nuestro equipo. Si quieres un proveedor que ponga moderadores humanos para imágenes y vídeos, WebPurify está pensado para eso.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/es/reservar-llamada" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Reservar una llamada</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Ver la comparativa</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Para quién es WebPurify</h2>
      <p class="mt-4 text-surface-600">WebPurify, fundada en 2007 en Irvine (California) y parte de IntouchCX desde 2025 según el anuncio de la compra, vende una API de filtro de palabrotas y moderación de imágenes y vídeos con IA y con sus propios moderadores humanos. Su oferta se dirige a empresas con contenido generado por usuarios, desde webs y apps hasta campañas de marca. Cada servicio se cobra por separado: por licencia el filtro, por imagen o por minuto la revisión humana.</p>
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>moderas comentarios de un medio, de páginas de marca o de canales públicos;</li>
          <li>quieres una IA que lea el contexto de un comentario, más allá del filtro de palabrotas;</li>
          <li>quieres conectar Facebook, Instagram, YouTube y WordPress sin tener que moderar tú mismo;</li>
          <li>necesitas una explicación escrita de cada decisión, piezas para el DSA y alojamiento en la UE;</li>
          <li>quieres un equipo que adapte la moderación a tus reglas y casos de uso.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">WebPurify puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>quieres que el proveedor ponga moderadores humanos para imágenes y vídeos;</li>
          <li>te basta con un filtro de palabrotas barato para un solo dominio;</li>
          <li>las imágenes y vídeos que suben los usuarios son tu principal riesgo.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">WebPurify y OpenModeration, frente a frente</h2>
      <p class="mt-4 text-surface-500">Información sobre WebPurify tomada de su web, webpurify.com, consultada el 30 de octubre de 2026. Precios sin impuestos.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">WebPurify</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Un motor de IA que sigue el progreso de los modelos</h2>
      <p class="mt-4 text-surface-600">WebPurify combina la moderación con IA con sus propios moderadores humanos; las páginas consultadas no dicen en qué modelos de IA se basa.</p>
      <p class="mt-4 text-surface-600">OpenModeration funciona con su propia IA de moderación y, en los casos delicados, otros modelos de IA contrastan sus decisiones. El motor no depende de ningún modelo: cuando sale uno mejor o más barato, nuestro equipo lo conecta rápido, sin que tengas que cambiar nada. Tu moderación avanza al ritmo del mercado de la IA en lugar de quedarse congelada en un único algoritmo propio.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Precio de WebPurify y precio de OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">WebPurify</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-600">
          <li>Filtro de palabrotas, licencia plugin: 5 $ al mes por un dominio</li>
          <li>Filtro de palabrotas, licencia estándar: 15 $ al mes por un dominio</li>
          <li>Filtro de palabrotas, licencia empresa: 50 $ al mes hasta 6 dominios</li>
          <li>Moderación de imágenes live (humana): 2 centavos por imagen, sin mínimo para los criterios estándar</li>
          <li>Prueba gratuita de 14 días</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6">
          <h3 class="font-semibold text-brand-700">OpenModeration</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-700">
          <li>Gratis: hasta 1.000 solicitudes al mes</li>
          <li>Pro: 99 € al mes por 10.000 solicitudes</li>
          <li>Enterprise: a medida, para grandes volúmenes</li>
          <li>Despliegue on-premise: solo bajo petición</li>
          </ul>
        </div>
      </div>
      <p class="mt-6 text-sm text-surface-500">WebPurify cobra cada servicio por separado y la revisión humana de sus equipos se paga por unidad. OpenModeration cobra por solicitudes: la IA, el tratamiento de los casos dudosos por nuestro equipo, la consola, los conectores y el registro de actividad están incluidos.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pasar de WebPurify a OpenModeration en 3 pasos</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">1</div>
          <h3 class="mt-4 font-semibold text-surface-900">Activa el modo sandbox junto a WebPurify</h3>
          <p class="mt-2 text-sm text-surface-600">Conecta tu web o tus páginas sociales. OpenModeration analiza tus comentarios reales sin ocultar nada, mientras WebPurify sigue funcionando.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">2</div>
          <h3 class="mt-4 font-semibold text-surface-900">Adapta las reglas con nuestro equipo</h3>
          <p class="mt-2 text-sm text-surface-600">El equipo de Logora adapta la moderación a tus reglas y casos de uso. Comparas las decisiones, y sus explicaciones escritas, comentario a comentario.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">3</div>
          <h3 class="mt-4 font-semibold text-surface-900">Activa las acciones automáticas</h3>
          <p class="mt-2 text-sm text-surface-600">Cuando los resultados te convencen, las infracciones claras se ocultan solas y nuestro equipo trata los casos dudosos; tú lo ves todo en la consola.</p>
        </div>
      </div>
      <div class="mt-8">
        <a href="/es/reservar-llamada" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Reservar una llamada</a>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        WebPurify es una marca de su propietario. La información sobre ella procede de su web (consultada el 30 de octubre de 2026). ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-center text-xs text-surface-400">
        Fuentes: <a href="https://www.webpurify.com/pricing/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">www.webpurify.com/pricing/</a> · <a href="https://www.webpurify.com/terms/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">www.webpurify.com/terms/</a> · <a href="https://www.webpurify.com/profanity-filter/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">www.webpurify.com/profanity-filter/</a> · <a href="https://www.webpurify.com/image-moderation/live/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">www.webpurify.com/image-moderation/live/</a> · <a href="https://www.newswire.ca/news-releases/intouchcx-expands-trust-amp-safety-solutions-with-strategic-acquisition-of-webpurify-843206076.html" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">www.newswire.ca/news-releases/intouchcx-expands-trust-amp-safety-solutions-with-strategic-acquisition-of-webpurify-843206076.html</a>
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/software-de-moderacion" class="font-medium text-brand-600 hover:text-brand-500">El software de moderación OpenModeration &rarr;</a></li>
        <li><a href="/es/casos-de-uso/medios" class="font-medium text-brand-600 hover:text-brand-500">Moderación de comentarios para medios &rarr;</a></li>
        <li><a href="/es/blog/moderacion-de-comentarios-guia" class="font-medium text-brand-600 hover:text-brand-500">La guía de moderación de comentarios &rarr;</a></li>
        <li><a href="/es/blog/guia-moderacion-contenido-ia-desarrolladores" class="font-medium text-brand-600 hover:text-brand-500">Moderación de contenido con IA: guía para desarrolladores &rarr;</a></li>
        <li><a href="/es/precios" class="font-medium text-brand-600 hover:text-brand-500">Los precios de OpenModeration &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Ve más allá del filtro de palabrotas." subtitle="Reserva una llamada: revisamos tus reglas y casos de uso y luego lanzamos el sandbox sobre tus comentarios reales, junto a WebPurify." buttonText="Reservar una llamada" buttonHref="/es/reservar-llamada" />
</BaseLayout>
