---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import CodeBlock from '../../../components/CodeBlock.astro';

const migrationCode = `# Antes: Hive Moderation (directo)
const response = await fetch('https://api.thehive.ai/api/v2/task/sync', {
  method: 'POST',
  headers: { 'Authorization': 'Token YOUR_HIVE_KEY' },
  body: JSON.stringify({ url: '...', text: { text: content } })
});

# Después: OpenModeration con Hive
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text, model: 'hive/moderation' })
});
// Añade OpenAI, Azure o Mistral como respaldo con la misma llamada a la API`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa a Hive Moderation | OpenModeration",
  "description": "Hive Moderation ofrece una buena moderación visual y de texto, pero te ata a un solo proveedor. OpenModeration combina Hive con OpenAI, Azure, Mistral y otros a través de una sola API, con flujos automatizados y cumplimiento de la DSA integrados.",
  "inLanguage": "es",
};

const comparisonPoints = [
  { feature: "Proveedores", hive: "Solo Hive (modelos propietarios)", openmod: "10 proveedores: Hive, OpenAI, Azure, Mistral, HuggingFace, LLM (GPT-4o, Claude), Cohere y más" },
  { feature: "Tipos de contenido", hive: "Texto, imagen y vídeo (moderación visual sólida)", openmod: "Moderación de texto con 10 categorías. Enrutamiento multiproveedor por idioma y categoría." },
  { feature: "Prefiltrado", hive: "No disponible", openmod: "Filtro de palabras integrado que bloquea el spam evidente y las palabras prohibidas antes de cualquier llamada a la API" },
  { feature: "Motor de decisión", hive: "Puntuaciones de clasificación en bruto", openmod: "Doble umbral con una zona gris que se envía a revisión humana" },
  { feature: "Acciones automáticas", hive: "Tienes que construir tu propia integración", openmod: "El motor de acciones integrado oculta, elimina, marca o notifica cuando se superan los umbrales." },
  { feature: "Consola", hive: "Panel básico de la API", openmod: "Consola de moderación completa: cola de revisión, roles de equipo, analítica, estado de los proveedores" },
  { feature: "Formato de la API", hive: "Formato propietario de Hive", openmod: "Estandarizado para los 10 proveedores. Cambia de proveedor con un cambio de configuración." },
  { feature: "Dependencia del proveedor", hive: "Atado a los modelos propietarios de Hive", openmod: "Ninguna. BYOK disponible para todos los proveedores. Autoalojable." },
  { feature: "Autoalojamiento", hive: "Solo API en la nube", openmod: "Autoalojado con Docker (gratis, AGPL v3) o nube gestionada en la UE" },
  { feature: "Registro de auditoría", hive: "Registros de peticiones a la API", openmod: "Registro de auditoría DSA completo: cada decisión de la IA y humana registrada, informes exportables" },
  { feature: "Precios", hive: "Según uso, precio bajo petición", openmod: "Gratis en autoalojamiento. Nube gestionada desde 99 €/mes (10.000 peticiones incluidas)." },
];

const reasons = [
  {
    title: "Hive destaca en la moderación visual, pero cada vez hay más texto que moderar",
    description: "Hive es conocido por su moderación de imágenes y vídeos. Con los LLM y los chatbots, el volumen de texto no deja de crecer, y necesitas una plataforma que trate el texto con la misma solvencia que las imágenes. OpenModeration envía el texto al mejor proveedor de PLN y puede integrar Hive para los casos de uso visuales."
  },
  {
    title: "Un solo proveedor es un único punto de fallo",
    description: "Si la API de Hive sufre una caída, un pico de latencia o un cambio de precios, todo tu flujo de moderación se resiente. OpenModeration ofrece respaldo automático entre 10 proveedores: si Hive va lento, tus peticiones pasan a OpenAI, Azure o Mistral sin intervención manual."
  },
  {
    title: "Modelos propietarios que no puedes auditar",
    description: "Los modelos de Hive son cajas negras. No puedes auditarlos, ajustarlos ni examinar sus datos de entrenamiento. OpenModeration te da acceso a modelos open source (HuggingFace Llama Guard) junto a los propietarios, y la propia plataforma es totalmente open source bajo AGPL v3."
  },
  {
    title: "Para cumplir la DSA, unas puntuaciones no bastan",
    description: "La Ley de Servicios Digitales de la UE exige decisiones de moderación documentadas, mecanismos de revisión humana e informes de transparencia. OpenModeration incluye los registros de auditoría, los flujos de revisión y los informes exportables, mucho más que los registros de la API."
  },
];
---

<BaseLayout
  title="Alternativa a Hive Moderation: una API, 10 proveedores"
  description="Hive destaca en la moderación visual. OpenModeration combina Hive con otros 9 proveedores de texto, reglas automáticas, revisión humana y auditoría DSA."
  jsonLd={comparisonJsonLd}
>
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1.5 text-sm font-medium text-amber-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Alternativa a Hive Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Hive destaca con el contenido visual.<br/>Para moderar texto, necesitas una plataforma.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Hive Moderation clasifica muy bien imágenes y vídeos. Pero cada vez hay más texto que moderar,
        entre LLM, chatbots, foros y comentarios. OpenModeration te da 10 proveedores
        de moderación de texto a través de una sola API, con reglas automáticas, revisión humana y cumplimiento de la DSA integrados.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Prueba OpenModeration gratis</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Ver la comparativa</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por qué los equipos buscan algo más que Hive</h2>
        <p class="mt-4 text-lg text-surface-500">Hive es un buen motor de moderación. Pero para moderar texto en producción necesitas más de un modelo y algo más que puntuaciones en bruto.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Una API para todos los proveedores
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Un solo formato para todo.</h2>
          <p class="mt-4 text-lg text-surface-500">
            Integrar Hive para la moderación visual y otra API distinta para el texto fragmenta tu stack.
            OpenModeration lo reúne todo en un único formato de API, con Hive, OpenAI, Azure,
            Mistral, HuggingFace o la combinación que prefieras.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Si Hive sufre una caída, las peticiones pasan automáticamente a OpenAI o Mistral.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Compara los proveedores y descubre cuál es el más rápido, el más preciso y el más barato para cada idioma.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Ejecuta modelos open source como Llama Guard junto a Hive, y audita su funcionamiento.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Hive Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Hive es un buen proveedor de moderación. OpenModeration coordina Hive y otros 9 proveedores.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funcionalidad</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Hive Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.hive}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Compara otros proveedores</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/es/alternativas/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/es/alternativas/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/es/alternativas/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/es/alternativas/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/es/alternativas/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <CTASection
    title="Unifica Hive y otros 9 proveedores en una sola llamada a la API."
    subtitle="Combina la moderación visual de Hive con OpenAI, Azure y Mistral para el texto, a través de una sola API. El código es abierto, puedes autoalojarlo y está preparado para la DSA."
    buttonText="Prueba OpenModeration gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
