---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# Azure Content Safety (directo)
const endpoint = "https://<resource>.cognitiveservices.azure.com/";
const res = await fetch(endpoint + "/contentsafety/text:analyze?api-version=2024-02-01", {
  method: 'POST',
  headers: { 'Ocp-Apim-Subscription-Key': '...' },
  body: JSON.stringify({ text, categories: ['Hate','SelfHarm','Sexual','Violence'] })
});
// Resultado: formato propio de Azure, 4 categorías, despliegue por región

# OpenModeration (unificado)
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({
    input: text,
    categories: ['hate', 'harassment', 'sexual', 'violence', 'self-harm', 'spam'],
    threshold: 0.5
  })
});
// Además: prefiltro, doble umbral, acciones automáticas, registro de auditoría, consola de equipo`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa a la API de moderación de Azure | OpenModeration",
  "description": "Compara OpenModeration y Azure Content Safety para la moderación con IA. Azure Content Safety es solo una API y te ata al ecosistema de Microsoft. OpenModeration te permite usar Azure junto a otros 9 proveedores a través de una sola API, con una consola de revisión integrada, reglas sin código y despliegue on-premise para la soberanía de tus datos.",
  "inLanguage": "es"
};

const faqItems = [
  {
    question: "¿Cuánto cuesta Azure Content Safety frente a OpenModeration?",
    answer: "Azure AI Content Safety factura por cada 1.000 registros de texto (un registro equivale a un máximo de 1.000 caracteres) a partir de un nivel gratuito de 5.000 registros al mes, con una tarifa que depende de tu región de Azure. OpenModeration es gratuito si lo autoalojas: solo pagas las llamadas a tus proveedores. La nube gestionada empieza en 99 €/mes por 10.000 peticiones, y el prefiltrado elimina entre un 10 y un 30 % de las llamadas facturables antes de que lleguen a Azure."
  },
  {
    question: "¿Puedo seguir usando Azure Content Safety con OpenModeration?",
    answer: "Sí. Usa tu propia clave de Azure (BYOK) y envía las peticiones a Azure Content Safety como proveedor principal. Añade OpenAI o Mistral como respaldo con un simple cambio de configuración, sin reescribir código ni reentrenar nada."
  },
  {
    question: "¿Es compatible OpenModeration con los modelos de moderación de Azure OpenAI?",
    answer: "Sí. Tanto el endpoint de Azure AI Content Safety como los modelos de moderación de Azure OpenAI están disponibles como proveedores. Las respuestas se normalizan en un único formato para los 10 proveedores."
  },
  {
    question: "¿Qué gano además de las puntuaciones en bruto de Azure?",
    answer: "El prefiltro, el doble umbral (aprobación automática / revisión humana / rechazo automático), las reglas sin código, una consola de moderación con roles de equipo y un registro de auditoría preparado para la DSA, con informes exportables."
  },
  {
    question: "¿Puedo autoalojarlo en lugar de usar la nube de Microsoft?",
    answer: "Sí. OpenModeration es open source bajo AGPL v3. Lo despliegas con Docker en tu propia infraestructura europea, conservas el control de los datos frente al RGPD y la DSA y mantienes Azure como uno de tus proveedores."
  },
];

const comparisonPoints = [
  { feature: "Alcance de la moderación", azure: "Un solo proveedor (solo Azure)", openmod: "Multiproveedor (Azure, OpenAI, Mistral, LLM) + consola unificada" },
  { feature: "Interfaz operativa", azure: "Solo API. Tienes que construir tu propia interfaz de revisión", openmod: "Consola completa de Trust & Safety con cola de revisión manual incluida" },
  { feature: "Motor de reglas", azure: "La lógica personalizada se construye y mantiene internamente", openmod: "Tres capas integradas: filtros de palabras, umbrales de puntuación y normas de la comunidad en lenguaje natural" },
  { feature: "Dependencia del proveedor", azure: "Alta (ligada al ecosistema de Microsoft)", openmod: "Ninguna (tus propias claves, cambio de proveedor al instante)" },
  { feature: "Soberanía de los datos", azure: "Datos procesados en la infraestructura de Microsoft", openmod: "Autoalojable en tu propia infraestructura europea, lo que facilita cumplir el RGPD y la DSA" },
  { feature: "Modelo de precios", azure: "Facturación de la API por petición", openmod: "Núcleo open source gratuito. Nube gestionada con precios predecibles disponible." }
];
---

<BaseLayout
  title="Alternativa a Azure Content Safety: precios y comparativa"
  description="Azure Content Safety es solo una API y te ata a Microsoft. OpenModeration suma Azure y 9 proveedores en una API, reglas sin código, revisión humana y auditoría DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Alternativa a Azure Content Safety" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Alternativa a la API de moderación de Azure</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Azure Content Safety es una API.<br/>OpenModeration es una plataforma que la incluye.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Azure Content Safety ofrece buenas API de moderación con IA, pero montar un flujo de moderación completo exige mucho trabajo de ingeniería. OpenModeration te da la API <strong>y</strong> todo lo que hace falta alrededor.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Prueba OpenModeration gratis</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Ver la comparativa completa</a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Migra desde Azure en menos de una hora</h2>
          <p class="mt-4 text-lg text-surface-500">
            Conserva tu clave de Azure (BYOK) como proveedor principal. Una llamada estandarizada sustituye al
            endpoint de Content Safety. Las puntuaciones llegan en un único formato y los umbrales los fijas tú.
          </p>
          <ul class="mt-6 space-y-3">
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Mantén Azure</strong> como proveedor principal y añade OpenAI o Mistral como respaldo cuando Azure vaya lento o no responda.</p>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>El prefiltro</strong> bloquea el spam evidente antes de cualquier llamada facturable a Azure, lo que ahorra entre un 10 y un 30 % en costes de API.</p>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Autoalójalo</strong> en tu propia infraestructura europea con Docker, con Azure disponible como uno de tus proveedores.</p>
            </li>
          </ul>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-4xl">
        <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Azure Content Safety frente a OpenModeration</h2>
        <div class="mt-8 overflow-hidden rounded-xl border border-surface-200">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="bg-surface-50">
                <th class="px-6 py-4 font-semibold text-surface-900">Funcionalidad</th>
                <th class="px-6 py-4 font-semibold text-surface-500">Azure Content Safety</th>
                <th class="px-6 py-4 font-semibold text-brand-700">OpenModeration</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200 bg-white">
              {comparisonPoints.map((row) => (
                <tr>
                  <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                  <td class="px-6 py-4 text-surface-600">{row.azure}</td>
                  <td class="px-6 py-4 font-medium text-accent-600">{row.openmod}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8">
          <h3 class="text-xl font-bold text-surface-900">El coste oculto de una moderación que es «solo una API»</h3>
          <p class="mt-4 text-surface-600">
            Integrar Azure Content Safety es el primer paso. Para que funcione en producción, tu equipo de ingeniería todavía tiene que construir:
          </p>
          <ul class="mt-4 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Una consola para que los moderadores humanos revisen los casos límite</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Un motor de reglas que convierta las puntuaciones de la IA en acciones automáticas (ocultar, eliminar, marcar)</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Sistemas de registro de auditoría para demostrar el cumplimiento de la DSA ante los reguladores</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Una lógica de respaldo por si las API de Azure sufren caídas</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="text-xl font-bold text-brand-700">La ventaja de OpenModeration</h3>
          <p class="mt-4 text-surface-700">
            OpenModeration puede usar Azure Content Safety como uno de sus proveedores de backend, y le añade todo lo necesario para moderar en el día a día:
          </p>
          <ul class="mt-4 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> La consola está lista y tu equipo de moderación puede empezar a revisar desde el primer día.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> Las reglas se configuran sin código con tres herramientas: palabras prohibidas, umbrales por categoría y las normas de tu comunidad.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> Si Azure va lento o falla, las peticiones pasan a OpenAI o Mistral.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> Cada decisión, de la IA o humana, queda en un registro de auditoría completo.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Alternativa a Azure Content Safety: preguntas frecuentes" />
    </div>
  </section>

  <CTASection
    title="No construyas tus propias herramientas de moderación."
    subtitle="OpenModeration ya trae la integración con Azure, las reglas automáticas y una consola de revisión para tu equipo."
    buttonText="Pruébalo gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Compara otros proveedores</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/es/alternativas/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/es/alternativas/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/es/api-moderacion-texto" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">API de moderación de texto</a>
        <a href="/es/alternativas/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/es/alternativas/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/es/alternativas/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>
</BaseLayout>
