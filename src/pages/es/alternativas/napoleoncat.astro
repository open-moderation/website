---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/napoleoncat",
  "name": "Alternativa a NapoleonCat: comparativa con OpenModeration",
  "description": "¿NapoleonCat u OpenModeration? Comparativa con fuentes entre una suite de gestión de redes sociales y una herramienta dedicada a la moderación: redes, precios, explicación escrita, registro DSA y alojamiento en la UE.",
  "inLanguage": "es",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Oferta", napoleoncat: "Una suite de gestión de redes sociales para marcas y agencias: bandeja de entrada, moderación automática, publicación, analítica e informes", openmod: "Solo moderación: conectores de redes sociales y WordPress, más API REST y webhooks para todo lo demás" },
  { feature: "Redes cubiertas", napoleoncat: "Facebook, Messenger, Instagram, LinkedIn, TikTok, YouTube, Google Business Profile, reseñas de App Store y Google Play; X para publicar", openmod: "Facebook, Instagram, YouTube y WordPress de forma nativa; el resto a través de la API" },
  { feature: "Comentarios en tu propia web", napoleoncat: "No se indica en su web", openmod: "Sí: conector de WordPress, o la API para cualquier sistema de comentarios" },
  { feature: "Precio", napoleoncat: "Standard 89 €, Pro 109 €, Expert 139 € al mes (pago mensual, 5 perfiles, 2 usuarios). Enterprise desde 465 €. Prueba gratuita de 14 días", openmod: "Público: gratis hasta 1.000 solicitudes al mes, Pro a 99 € al mes para 10.000" },
  { feature: "Ocultar comentarios automáticamente", napoleoncat: "Incluido a partir del plan Expert («Automatic comment hiding and deletion»)", openmod: "Incluido en todos los planes, también en el gratuito" },
  { feature: "Cómo se definen las reglas", napoleoncat: "Reglas de moderación automatizadas, más un asistente de IA para detectar spam y odio", openmod: "Tus reglas de moderación en lenguaje natural, un umbral por categoría y una zona gris que pasa a revisión humana" },
  { feature: "Explicación escrita de cada decisión", napoleoncat: "No se indica en su web", openmod: "Sí, en el idioma que elijas, devuelta por la API" },
  { feature: "DSA (Ley de Servicios Digitales)", napoleoncat: "No se indica en su web", openmod: "Registro de actividad que indica si cada decisión fue automática o qué moderador la tomó" },
  { feature: "Datos y cumplimiento", napoleoncat: "Sello «100% EU GDPR compliant»; ubicación del alojamiento no indicada", openmod: "Desarrollado y alojado en la Unión Europea, RGPD" },
  { feature: "Publicación, bandeja de entrada, analítica", napoleoncat: "Sí, es el núcleo de la suite", openmod: "No, OpenModeration solo modera" },
];

const faqItems = [
  {
    question: "¿Cuál es la mejor alternativa a NapoleonCat para moderar comentarios?",
    answer: "Si lo que necesitas es moderar, OpenModeration está hecho para eso: reglas en lenguaje natural, una explicación escrita para cada comentario ocultado y un registro para la DSA, en redes sociales y en tu web. Si buscas sobre todo una bandeja de entrada compartida, un calendario de publicación y analítica en TikTok, LinkedIn y reseñas de apps, NapoleonCat cubre eso y OpenModeration no.",
  },
  {
    question: "¿Cuánto cuesta NapoleonCat frente a OpenModeration?",
    answer: "NapoleonCat publica Standard a 89 €, Pro a 109 € y Expert a 139 € al mes con pago mensual, para 5 perfiles y 2 usuarios. La ocultación automática de comentarios llega con Expert. Enterprise empieza en 465 €. OpenModeration es gratis hasta 1.000 solicitudes al mes, después cuesta 99 € al mes por 10.000 solicitudes.",
  },
  {
    question: "¿Puedo probar OpenModeration sin apagar NapoleonCat?",
    answer: "Sí. En modo sandbox, OpenModeration analiza tus comentarios reales y redacta sus decisiones y explicaciones sin ocultar nada. Así comparas las dos herramientas con los mismos comentarios antes de cambiar un solo ajuste en NapoleonCat.",
  },
  {
    question: "¿Puedo quedarme con NapoleonCat para publicar y usar OpenModeration para moderar?",
    answer: "Sí. Nada te impide seguir con NapoleonCat para publicar, responder y sacar informes, y dejar la moderación a OpenModeration. Desactiva la ocultación automática en una de las dos herramientas para que nunca actúen sobre el mismo comentario.",
  },
  {
    question: "¿Sirve OpenModeration para los comentarios de lectores en la web de un medio?",
    answer: "Sí. El conector de WordPress y la API REST moderan los comentarios de los lectores en tu web con las mismas reglas que tus redes sociales. Redacciones como Estadão, L'Équipe y Sud Ouest usan OpenModeration.",
  },
];
---

<BaseLayout title="Alternativa a NapoleonCat: comparativa con OpenModeration (2026)" description="¿NapoleonCat u OpenModeration? Comparativa con fuentes: precios reales, redes, comentarios en la web, explicación escrita y registro DSA de cada decisión." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "NapoleonCat" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a NapoleonCat: OpenModeration comparado</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        NapoleonCat es una suite de gestión de redes sociales. Ocultar comentarios de forma automática es una función más, disponible desde el plan Expert. OpenModeration hace una sola cosa: modera comentarios, explica por escrito cada decisión y guarda un registro para la DSA. Estas son las diferencias, con fuentes.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>tu problema real es la moderación y ya tienes una herramienta para publicar;</li>
          <li>quieres que tus reglas de moderación se apliquen tal como están escritas, con una zona gris para tus moderadores;</li>
          <li>necesitas una explicación escrita y un registro DSA para cada comentario ocultado;</li>
          <li>los comentarios de lectores en tu web deben seguir las mismas reglas que tu página de Facebook;</li>
          <li>quieres un registro de auditoría completo y datos alojados en la UE.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">NapoleonCat puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>gestionas TikTok, LinkedIn, Google Business Profile o reseñas de tiendas de apps;</li>
          <li>quieres publicación, bandeja compartida, analítica y moderación en una sola suscripción;</li>
          <li>tu equipo dedica la mayor parte del tiempo a responder a clientes, no a retirar insultos;</li>
          <li>tienes que moderar comentarios en anuncios de TikTok.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">NapoleonCat y OpenModeration, punto por punto</h2>
      <p class="mt-4 text-surface-500">Información sobre NapoleonCat extraída de su web, napoleoncat.com, consultada el 20 de octubre de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">NapoleonCat</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.napoleoncat}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Lo que cambia de verdad en el día a día</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Cada comentario ocultado tiene su motivo</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration escribe por qué ocultó cada comentario, en el idioma que elijas. El registro de actividad muestra si la decisión fue automática o qué moderador la tomó. Cuando un lector protesta o un regulador pregunta, tienes la respuesta.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Tus reglas, aplicadas con contexto</h3>
          <p class="mt-2 text-sm text-surface-600">Escribes tus reglas en lenguaje natural y fijas un umbral por categoría. La IA lee cada comentario junto con el título de la publicación y el hilo de la conversación. Los casos dudosos van a una zona gris que resuelve un moderador.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Tu web y tus redes, con las mismas reglas</h3>
          <p class="mt-2 text-sm text-surface-600">Facebook, Instagram, YouTube y WordPress se conectan de forma nativa. Cualquier otro sistema de comentarios entra por la API REST y los webhooks. Una redacción modera sus artículos y sus publicaciones en redes con la misma política.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Alojamiento en la UE, datos exportables</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration está desarrollado y alojado en la Unión Europea. Puedes exportar tus datos y tu registro de auditoría cuando quieras. Si necesitas un despliegue on-premise, es posible bajo petición: <a href="https://calendly.com/pierre-logora/60min" target="_blank" rel="noopener" class="font-medium text-brand-600 hover:text-brand-500">hablemos</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        NapoleonCat es una marca de su empresa titular. La información sobre ella procede de <a href="https://napoleoncat.com/pricing/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">napoleoncat.com</a> (consultada el 20 de octubre de 2026). Los precios de NapoleonCat se muestran sin IVA. ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/moderacion-redes-sociales" class="font-medium text-brand-600 hover:text-brand-500">Moderación de redes sociales con OpenModeration &rarr;</a></li>
        <li><a href="/es/integraciones/moderacion-wordpress" class="font-medium text-brand-600 hover:text-brand-500">Moderar comentarios de WordPress &rarr;</a></li>
        <li><a href="/es/cumplimiento-dsa/declaracion-de-motivos" class="font-medium text-brand-600 hover:text-brand-500">La declaración de motivos que exige la DSA &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
        <li><a href="/es/precios" class="font-medium text-brand-600 hover:text-brand-500">Los precios de OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Modera tus comentarios con una herramienta hecha solo para eso." subtitle="Conecta tus páginas y tu web, escribe tus reglas y lee el motivo de cada comentario ocultado. Gratis hasta 1.000 solicitudes al mes." />
</BaseLayout>
