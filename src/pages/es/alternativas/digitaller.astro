---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/digitaller",
  "name": "Alternativa a Digitaller: comparativa con OpenModeration",
  "description": "¿Digitaller u OpenModeration? Un servicio de moderación gestionado frente a un software que pilota tu redacción: precios públicos, conectores con nombre, explicación de cada decisión y registro para la DSA.",
  "inLanguage": "es",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Tipo de oferta", digitaller: "Servicio de moderación gestionado, más community management (agencia de Grupo Raíz Digital)", openmod: "Un software que tu equipo pilota, con la IA aplicando tus reglas" },
  { feature: "Cómo se decide", digitaller: "Un filtro semántico con IA y, cuando hace falta, un equipo humano de Digitaller", openmod: "La IA aplica tus reglas con un umbral por categoría; la zona gris pasa a tu equipo" },
  { feature: "Reglas", digitaller: "Adaptadas a cada cliente, en premoderación o en posmoderación", openmod: "Tu normativa en lenguaje natural, modificable cuando quieras, con propuestas de ajuste sacadas de las decisiones de tu equipo" },
  { feature: "Dónde modera", digitaller: "Diarios digitales, blogs, webs corporativas, clasificados y «redes sociales» (sin precisar cuáles)", openmod: "Facebook, Instagram, YouTube y WordPress de forma nativa; API REST y webhooks para el resto" },
  { feature: "Precio", digitaller: "No publica tarifas", openmod: "Públicos: gratis hasta 1.000 solicitudes al mes, Pro a 99 € al mes para 10.000, ofertas a medida para grandes volúmenes" },
  { feature: "Contexto", digitaller: "No se precisa", openmod: "La IA lee cada comentario con el titular y el hilo de la conversación" },
  { feature: "Explicación de cada decisión", digitaller: "No se menciona", openmod: "Una explicación por escrito para cada decisión, en el idioma que elijas, devuelta por la API" },
  { feature: "Registro para la DSA", digitaller: "No se menciona", openmod: "Registro de actividad: cada decisión indica si fue automática o qué moderador la tomó" },
  { feature: "Alojamiento y código", digitaller: "No se precisa (su web cita el RGPD y la LOPD en el aviso de cookies)", openmod: "Diseñado y alojado en la UE; open source con licencia AGPL v3 y autoalojamiento con Docker" },
  { feature: "Referencias", digitaller: "Los diarios regionales de Prensa Ibérica (La Nueva España, Levante, Faro de Vigo, Diario de Mallorca y otros), El Español y clasificados de Schibsted", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "¿Cuál es la mejor alternativa a Digitaller?",
    answer: "Depende de quién quieras que modere. Si buscas un servicio gestionado con moderadores externos y community management, Digitaller ofrece eso. Si quieres que tu redacción controle las reglas, vea la explicación de cada decisión y pague un precio publicado, OpenModeration es el software pensado para eso.",
  },
  {
    question: "¿Cuánto cuesta Digitaller?",
    answer: "Digitaller no publica tarifas en su web. OpenModeration publica las suyas: gratis hasta 1.000 solicitudes al mes, plan Pro a 99 € al mes para 10.000 solicitudes, ofertas a medida para grandes volúmenes y autoalojamiento gratuito.",
  },
  {
    question: "¿Puedo probar OpenModeration sin dejar Digitaller?",
    answer: "Sí. En modo sandbox, OpenModeration analiza los comentarios reales de tu web o de tus páginas en redes sociales y muestra lo que habría decidido, sin ocultar ni borrar nada. Comparas en paralelo con tu servicio actual y decides después.",
  },
  {
    question: "¿Qué opciones tiene un diario regional para moderar los comentarios de sus lectores?",
    answer: "Dos caminos. Externalizar la moderación en una empresa como Digitaller, que dice moderar desde hace 20 años los principales diarios digitales locales de España. O pilotarla desde la redacción con un software como OpenModeration: la IA aplica la normativa del periódico y el equipo solo revisa los casos dudosos.",
  },
  {
    question: "¿OpenModeration ofrece moderadores humanos?",
    answer: "No. OpenModeration no ofrece un equipo de moderación. Nuestro equipo redacta contigo la normativa de moderación a partir de tus reglas y de comentarios reales, y la ajusta durante las primeras semanas. Después, el sistema aprende de las decisiones de tus moderadores y propone ajustes que un administrador aplica con un clic.",
  },
];
---

<BaseLayout title="Alternativa a Digitaller: comparativa con OpenModeration (2026)" description="¿Digitaller u OpenModeration? Un servicio gestionado frente a un software que pilota tu redacción: precios públicos y una explicación de cada decisión." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Digitaller" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Digitaller: modera los comentarios desde tu redacción</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Digitaller, agencia de Grupo Raíz Digital, modera comentarios para muchos diarios regionales españoles con un filtro de IA y un equipo humano. OpenModeration es un software: tu redacción escribe las reglas, la IA las aplica con el contexto de cada artículo y cada decisión llega con una explicación por escrito.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>quieres que tu redacción controle las reglas y las cambie sin pasar por un proveedor;</li>
          <li>quieres conocer el precio antes de pedir un presupuesto;</li>
          <li>tienes que explicar cada comentario retirado, como exige la DSA;</li>
          <li>quieres saber qué redes se moderan: Facebook, Instagram, YouTube y WordPress;</li>
          <li>prefieres un código abierto que puedas alojar tú mismo.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Digitaller puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>quieres que un equipo humano externo revise los comentarios en tu lugar;</li>
          <li>también buscas un servicio de community management;</li>
          <li>quieres un proveedor que ya trabaja con muchos diarios regionales españoles.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Digitaller y OpenModeration, punto por punto</h2>
      <p class="mt-4 text-surface-500">Información sobre Digitaller extraída de su web, raiz.es, consultada el 20 de octubre de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Digitaller</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.digitaller}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Lo que cambia de verdad en el día a día</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">El contexto del artículo cuenta</h3>
          <p class="mt-2 text-sm text-surface-600">Un mismo comentario no pesa igual bajo una crónica deportiva que bajo una noticia de sucesos. OpenModeration pasa a la IA el titular y el hilo de la conversación para detectar la ironía y los ataques disimulados.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sabes por qué se ocultó cada comentario</h3>
          <p class="mt-2 text-sm text-surface-600">Cada decisión llega con una explicación por escrito, y el registro de actividad indica si la tomó la IA o qué moderador. Es la base de la declaración de motivos que pide la Ley de Servicios Digitales.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Un precio publicado</h3>
          <p class="mt-2 text-sm text-surface-600">Empiezas gratis y sabes cuánto pagarás cuando crezca el volumen. Si prefieres tener los datos en tus servidores, el autoalojamiento con Docker es gratuito.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Una prueba sin riesgo</h3>
          <p class="mt-2 text-sm text-surface-600">En modo sandbox, OpenModeration analiza tus comentarios reales sin aplicar ninguna acción. Comparas sus decisiones con las de tu servicio actual antes de cambiar nada.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Digitaller es una marca de su empresa titular. La información sobre ella procede de <a href="https://raiz.es/es/servicios/moderacion-de-los-contenidos/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">raiz.es</a> (consultada el 20 de octubre de 2026). ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/casos-de-uso/medios" class="font-medium text-brand-600 hover:text-brand-500">La moderación de comentarios para medios &rarr;</a></li>
        <li><a href="/es/alternativas/interactora" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration o Interactora: la comparativa &rarr;</a></li>
        <li><a href="/es/integraciones/moderacion-wordpress" class="font-medium text-brand-600 hover:text-brand-500">Moderar los comentarios de WordPress &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Prueba OpenModeration junto a tu servicio de moderación actual." subtitle="Conecta tu web o tus páginas en modo sandbox y compara las decisiones durante unas semanas, sin tocar tu moderación." />
</BaseLayout>
