---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# Antes: Mistral Moderation (directo)
import { Mistral } from '@mistralai/mistralai';
const mistral = new Mistral({ apiKey: '...' });
const result = await mistral.moderations.create({ input: text });

# Después: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// Puntuaciones estandarizadas, umbrales, acciones automáticas y registro de auditoría`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa a Mistral Moderation | OpenModeration",
  "description": "Mistral Moderation es una buena API multilingüe, pero es un solo modelo. OpenModeration usa su propia IA de moderación, contrastada por otros modelos de IA, con prefiltrado, reglas automáticas y registros de auditoría listos para la DSA.",
  "inLanguage": "es",
};

const comparisonPoints = [
  { feature: "Modelos de IA", mistral: "Solo el modelo de Mistral", openmod: "IA de moderación propia, contrastada por otros modelos de IA en los casos delicados" },
  { feature: "Categorías", mistral: "11 categorías fijas en el modelo actual, entre ellas datos personales y jailbreak", openmod: "10 categorías estandarizadas, más tus propias reglas escritas en lenguaje natural" },
  { feature: "Idiomas", mistral: "Muy buen multilingüismo (francés, alemán, español, italiano, portugués, etc.)", openmod: "Multilingüe, incluidos los idiomas de tu audiencia, en Europa y fuera de ella: cada comentario se analiza en su propio idioma" },
  { feature: "Prefiltrado", mistral: "No disponible", openmod: "Filtro de palabras integrado que bloquea el contenido evidente al instante" },
  { feature: "Motor de decisión", mistral: "Solo puntuaciones en bruto", openmod: "Doble umbral: aprobación automática / zona gris → nuestro equipo / rechazo automático" },
  { feature: "Entrada máxima", mistral: "32.000 caracteres", openmod: "Hasta 32.000 caracteres + procesamiento por lotes para volúmenes mayores" },
  { feature: "Consola", mistral: "Solo API. Sin interfaz de revisión.", openmod: "Consola completa donde ves cada decisión en tiempo real, con analítica y roles de equipo" },
  { feature: "Dependencia de un modelo", mistral: "Atado a Mistral", openmod: "Ninguna: los modelos mejores o más baratos se incorporan a medida que salen, sin que cambies nada" },
  { feature: "Alojamiento", mistral: "Solo API en la nube", openmod: "Nube gestionada en la UE; on-premise posible bajo petición" },
  { feature: "Cumplimiento", mistral: "Registros básicos de la API", openmod: "Registro de auditoría DSA completo con informes exportables" },
  { feature: "Precios", mistral: "Lo fija Mistral en su API", openmod: "Gratis hasta 1.000 comentarios analizados al mes. Nube gestionada desde 99 €/mes (10.000 comentarios analizados incluidos)." },
];

const reasons = [
  {
    title: "Mistral destaca con las lenguas europeas, menos con el inglés",
    description: "La API de moderación de Mistral funciona muy bien en francés, alemán, español e italiano. En otros idiomas o en ciertos matices, un solo modelo tiene sus límites. OpenModeration usa su propia IA y, en los casos delicados, otros modelos de IA arbitran la decisión antes de aplicarla."
  },
  {
    title: "Categorías fijas frente a categorías configurables",
    description: "Mistral cubre un conjunto fijo de categorías. Si tu comunidad necesita detectar desinformación, grooming o infracciones de políticas propias, OpenModeration aplica tus propias reglas: las escribes en lenguaje natural y la IA las tiene en cuenta en cada decisión."
  },
  {
    title: "Una API sola no basta para moderar",
    description: "Mistral te da puntuaciones. Todavía te faltan una consola, alguien que revise los casos dudosos, un motor de acciones (ocultar/eliminar/marcar), control de acceso por roles, registros de auditoría para la DSA y analítica. OpenModeration incluye todo eso."
  },
  {
    title: "Sin prefiltro, cada spam evidente pasa por la API",
    description: "Cada comentario que envías al endpoint de moderación de Mistral cuenta para tu consumo de la API. Con el prefiltro de OpenModeration, el spam evidente, las palabras prohibidas y los patrones regex se bloquean al instante, antes de cualquier análisis por la IA."
  },
];

const faqItems = [
  {
    question: "¿Cuánto cuesta Mistral Moderation frente a OpenModeration?",
    answer: "Mistral fija el precio de su modelo de moderación en su propia API. OpenModeration es gratis hasta 1.000 comentarios analizados al mes, y la nube gestionada empieza en 99 €/mes por 10.000 comentarios analizados, con la consola, las reglas y el registro de auditoría incluidos."
  },
  {
    question: "¿Qué IA usa OpenModeration?",
    answer: "OpenModeration funciona con su propia IA de moderación, y en los casos delicados otros modelos de IA contrastan su decisión. No depende de un único modelo: cuando sale uno mejor o más barato, el equipo lo incorpora rápidamente, sin que tengas nada que cambiar."
  },
  {
    question: "¿Cuánto tarda la migración?",
    answer: "Menos de una hora para cambiar la API: una llamada POST /v1/moderation sustituye al cliente de Mistral. La consola, las reglas y los registros de auditoría funcionan desde ese mismo momento."
  },
  {
    question: "¿Funciona con el francés y otras lenguas europeas?",
    answer: "Sí. OpenModeration modera el francés, el alemán, el español, el italiano y las demás lenguas de tu comunidad, con las mismas reglas y la misma consola."
  },
  {
    question: "¿Se registra cada decisión para las auditorías de la DSA?",
    answer: "Sí. Cada decisión, de la IA o humana, conserva las puntuaciones, los umbrales, el revisor y la fecha y hora. Exporta el registro de auditoría completo con un clic para tus informes de transparencia de la DSA."
  },
];
---

<BaseLayout
  title="Alternativa a Mistral Moderation: precios y comparativa"
  description="Mistral Moderation te da puntuaciones. OpenModeration aporta su propia IA, arbitrada por otras, con reglas, revisión humana y auditoría DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Alternativa a Mistral Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-sm font-medium text-blue-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Alternativa a Mistral Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Mistral modera muy bien en lenguas europeas.<br/>OpenModeration te da la moderación completa.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        La API de moderación de Mistral trata muy bien las lenguas europeas, pero es un solo modelo.
        OpenModeration usa su propia IA de moderación, contrastada por otros modelos de IA en los casos delicados,
        con reglas automáticas, revisión humana y registros de auditoría conformes a la DSA.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/es/reservar-llamada" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Reservar una llamada</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Probar gratis</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por qué ir más allá de Mistral</h2>
        <p class="mt-4 text-lg text-surface-500">Mistral es una de las mejores API de moderación centradas en Europa. Pero moderar exige un flujo de trabajo completo alrededor de la API.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Una migración sencilla
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pasa de Mistral a OpenModeration.</h2>
          <p class="mt-4 text-lg text-surface-500">
            Una sola llamada sustituye al cliente de Mistral. OpenModeration añade prefiltrado,
            doble umbral, acciones automáticas y un registro de auditoría completo, todo con la misma llamada a la API.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Nuestra propia IA de moderación</strong>, configurada según tus reglas y tus casos de uso.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Siempre al día</strong>: cuando sale un modelo mejor o más barato, lo incorporamos sin que cambies nada.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">OpenModeration está hecho por un equipo europeo y alojado en la UE.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Mistral Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">La API de Mistral es muy buena. OpenModeration le añade lo que falta para moderar en producción.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funcionalidad</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Mistral Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.mistral}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Alternativa a Mistral Moderation: preguntas frecuentes" />
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Compara otras alternativas</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/es/alternativas/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/es/alternativas/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/es/alternativas/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/es/alternativas/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/es/alternativas/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection
    title="Mucho más que una API de moderación."
    subtitle="Una IA de moderación propia, arbitrada por otras IA, reglas automáticas y una consola de revisión humana, con cada decisión explicada por escrito."
    buttonText="Prueba OpenModeration gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
