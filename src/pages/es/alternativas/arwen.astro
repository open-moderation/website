---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/alternativas/arwen",
  "name": "Alternativa a Arwen: comparativa con OpenModeration",
  "description": "¿Arwen u OpenModeration? Comparativa con fuentes: redes cubiertas, comentarios de tu web, precios públicos, alojamiento en la UE y motivo de cada decisión.",
  "inLanguage": "es",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  {
    "feature": "Qué ofrece",
    "them": "Moderación con IA de comentarios en redes sociales para marcas, deporte y medios (Signals, Engage, Moderate, Protect)",
    "openmod": "Moderación de comentarios con IA para medios, marcas e instituciones, configurada con el equipo de Logora según tus reglas y tus casos de uso"
  },
  {
    "feature": "Canales",
    "them": "Facebook, Instagram, X, TikTok y YouTube; Reddit «próximamente»; anuncios de Meta y TikTok",
    "openmod": "Web, Facebook, Instagram, YouTube y WordPress de forma nativa; TikTok, X, LinkedIn y otras redes bajo petición, rápidamente"
  },
  {
    "feature": "Comentarios de tu web",
    "them": "No se especifica en su web",
    "openmod": "Sí, mediante WordPress o la API"
  },
  {
    "feature": "Precio",
    "them": "No publicado: depende de los seguidores, los perfiles y los anuncios; hay que pedir una demo",
    "openmod": "Público: gratis hasta 1.000 comentarios analizados al mes, Pro a 99 € al mes para 10.000, Enterprise bajo petición"
  },
  {
    "feature": "Explicación escrita de cada decisión",
    "them": "No se especifica en su web",
    "openmod": "Sí, una explicación escrita para cada decisión"
  },
  {
    "feature": "DSA",
    "them": "No se especifica en su web",
    "openmod": "Notificación y acción, declaración de motivos, revisión humana de las decisiones impugnadas, cifras exportables y registro de actividad completo"
  },
  {
    "feature": "Certificaciones",
    "them": "Cyber Essentials e ISO 27001",
    "openmod": "RGPD, con registro completo de cada decisión"
  },
  {
    "feature": "Alojamiento de los datos",
    "them": "No se especifica en su web",
    "openmod": "Alojado en la UE, conforme al RGPD"
  },
  {
    "feature": "Modelos de IA",
    "them": "No se especifica (habla de una IA «en aprendizaje constante»)",
    "openmod": "IA de moderación propia, contrastada por otros modelos de IA; los nuevos modelos se incorporan a medida que salen"
  },
  {
    "feature": "Referencias",
    "them": "Hinge, Formula 1, ITV, ATP, Red Bull Racing, Fulham (logotipos de su web)",
    "openmod": "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora"
  }
];

const faqItems = [
  {
    "question": "¿Cuál es la mejor alternativa a Arwen?",
    "answer": "La mejor alternativa a Arwen depende de tus canales: si moderas Facebook, Instagram, YouTube y los comentarios de tu propia web, OpenModeration lo hace en una sola consola, con precios públicos y una explicación escrita para cada decisión. Si la moderación de los comentarios de tus anuncios es prioritaria, Arwen la cubre. OpenModeration añade TikTok, X y otras redes bajo petición, rápidamente."
  },
  {
    "question": "¿Cuánto cuesta Arwen?",
    "answer": "Arwen no publica sus precios: según su web, dependen del número de seguidores, de perfiles y de anuncios, y se calculan tras una demo. OpenModeration publica los suyos: gratis hasta 1.000 comentarios analizados al mes, Pro a 99 € al mes para 10.000 comentarios analizados, y Enterprise bajo petición para grandes volúmenes. El precio no depende de tus seguidores."
  },
  {
    "question": "¿Arwen u OpenModeration: cuál elegir?",
    "answer": "Elige Arwen si necesitas moderar los comentarios de tus anuncios. Elige OpenModeration si quieres probar gratis con tus propios comentarios antes de comprometerte, si quieres precios públicos y una explicación escrita para cada decisión, con un equipo que configura la moderación contigo según tus reglas y tus casos de uso."
  },
  {
    "question": "¿Puedo probar OpenModeration sin dejar Arwen?",
    "answer": "Sí. En modo sandbox, OpenModeration analiza tus comentarios reales sin ocultar nada. Arwen sigue funcionando y comparas las dos series de decisiones, comentario a comentario, antes de cambiar nada."
  },
  {
    "question": "¿Qué modelos de IA usa OpenModeration?",
    "answer": "OpenModeration funciona con su propia IA de moderación, y en los casos delicados otros modelos de IA contrastan su decisión. Cuando sale un modelo mejor o más económico, el equipo lo incorpora rápidamente, sin que tengas nada que cambiar: tu moderación aprovecha el progreso de los modelos de IA."
  },
  {
    "question": "¿OpenModeration sirve para clubes deportivos y marcas de medios?",
    "answer": "Sí. La IA lee cada comentario con el título de la publicación y el hilo, algo decisivo en días de partido o de última hora. Medios deportivos como L'Équipe moderan sus comentarios con OpenModeration."
  }
];
---

<BaseLayout title="Alternativa a Arwen: comparativa con OpenModeration" description="¿Arwen u OpenModeration? Comparativa con fuentes: redes cubiertas, comentarios de tu web, precios públicos, alojamiento en la UE y motivo de cada decisión." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Alternativas", href: "/es/alternativas" }, { label: "Arwen" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparativa
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Arwen: comparativa con OpenModeration</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        La mejor alternativa a Arwen depende de tus canales: si moderas Facebook, Instagram, YouTube y los comentarios de tu propia web, OpenModeration lo hace en una sola consola, con precios públicos y una explicación escrita para cada decisión. Si la moderación de los comentarios de tus anuncios es prioritaria, Arwen la cubre. OpenModeration añade TikTok, X y otras redes bajo petición, rápidamente.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/es/reservar-llamada" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Reservar una llamada</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Probar gratis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900">¿Para quién es Arwen?</h2>
      <p class="mt-4 text-surface-600">Según su web, Arwen modera con IA los comentarios en redes sociales de marcas, clubes deportivos y medios, con cuatro productos (Signals, Engage, Moderate y Protect). Cubre Facebook, Instagram, X, TikTok y YouTube, anuncia Reddit «próximamente» y modera también los comentarios de anuncios de Meta y TikTok. Entre los logotipos de su web figuran Hinge, Formula 1, ITV, ATP y Red Bull Racing.</p>
      <p class="mt-4 text-surface-600">OpenModeration modera con IA los comentarios de medios, marcas e instituciones públicas, en su web y en sus páginas de Facebook, cuentas de Instagram y canales de YouTube. Oculta automáticamente las infracciones claras, deja visible la crítica legítima y confía los casos dudosos a nuestro equipo, y tú ves cada decisión en tiempo real en una sola consola. El equipo de Logora, en París desde 2019, la configura contigo según tus reglas y tus casos de uso.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Arwen y OpenModeration, punto por punto</h2>
      <p class="mt-4 text-surface-500">Información sobre Arwen extraída de su web, arwen.ai, consultada el 30 de octubre de 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Arwen</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.them}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Elige OpenModeration si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>quieres probar gratis con tus propios comentarios antes de comprometerte;</li>
          <li>también moderas los comentarios de tu web o de WordPress;</li>
          <li>necesitas una explicación escrita para cada comentario oculto, como pide la DSA;</li>
          <li>tus datos deben quedarse en la Unión Europea.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Arwen puede encajarte mejor si…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>necesitas moderar los comentarios de tus anuncios de Meta o TikTok;</li>
          <li>quieres respuestas sugeridas y escucha social en la misma herramienta;</li>
          <li>tu departamento de compras exige ISO 27001 o Cyber Essentials.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h2 class="text-xl font-bold text-surface-900">Una IA que sigue el progreso de los modelos</h2>
          <p class="mt-3 text-sm text-surface-600">OpenModeration funciona con su propia IA de moderación, y en los casos delicados otros modelos de IA contrastan su decisión. Cuando sale un modelo mejor o más económico, el equipo lo incorpora rápidamente, sin que tengas nada que cambiar. Tu moderación sigue el progreso del mercado de la IA en lugar de quedarse fija en un único algoritmo. Arwen no indica en su web qué modelos de IA utiliza.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h2 class="text-xl font-bold text-surface-900">Precios: Arwen frente a OpenModeration</h2>
          <p class="mt-3 text-sm text-surface-600">Arwen no publica sus precios: según su web, dependen del número de seguidores, de perfiles y de anuncios, y se calculan tras una demo. OpenModeration publica los suyos: gratis hasta 1.000 comentarios analizados al mes, Pro a 99 € al mes para 10.000 comentarios analizados, y Enterprise bajo petición para grandes volúmenes. El precio no depende de tus seguidores. El despliegue on-premise es posible bajo petición. <a href="/es/reservar-llamada" class="font-medium text-brand-600 hover:text-brand-500">Reserva una llamada</a> para calcular tu caso.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pasar de Arwen a OpenModeration en 3 pasos</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">1. Prueba en modo sandbox</h3>
          <p class="mt-2 text-sm text-surface-600">Conecta tu web, WordPress o tus páginas de Facebook, Instagram y YouTube. OpenModeration analiza comentarios reales sin ocultar nada, mientras Arwen sigue funcionando.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">2. Ajusta con el equipo de Logora</h3>
          <p class="mt-2 text-sm text-surface-600">Comparamos las decisiones con las de tu herramienta actual y adaptamos la moderación a tus reglas y tus casos de uso, con la explicación escrita de cada decisión a la vista.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">3. Activa canal por canal</h3>
          <p class="mt-2 text-sm text-surface-600">Activas la moderación en un canal, luego en los demás. Nuestro equipo se ocupa de los casos dudosos; tú ves cada decisión en tiempo real y puedes intervenir cuando quieras.</p>
        </div>
      </div>
      <p class="mt-8 text-center text-surface-600">¿Quieres verlo con tus propios comentarios? <a href="/es/reservar-llamada" class="font-medium text-brand-600 hover:text-brand-500">Reserva una llamada con el equipo</a>.</p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Arwen es una marca de su empresa titular. Fuentes: <a href="https://arwen.ai" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">arwen.ai</a> (consultadas el 30 de octubre de 2026). ¿Has visto un error? Escríbenos a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/moderacion-redes-sociales" class="font-medium text-brand-600 hover:text-brand-500">Moderación de redes sociales con OpenModeration &rarr;</a></li>
        <li><a href="/es/integraciones/moderacion-facebook" class="font-medium text-brand-600 hover:text-brand-500">Moderar los comentarios de Facebook &rarr;</a></li>
        <li><a href="/es/blog/moderacion-redes-sociales-guia" class="font-medium text-brand-600 hover:text-brand-500">Guía de moderación de redes sociales &rarr;</a></li>
        <li><a href="/es/software-de-moderacion" class="font-medium text-brand-600 hover:text-brand-500">El software de moderación OpenModeration &rarr;</a></li>
        <li><a href="/es/precios" class="font-medium text-brand-600 hover:text-brand-500">Los precios de OpenModeration &rarr;</a></li>
        <li><a href="/es/alternativas" class="font-medium text-brand-600 hover:text-brand-500">Todas las comparativas &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Compara tu moderación actual con OpenModeration." subtitle="Prueba OpenModeration en modo sandbox con tus propios comentarios, sin ocultar nada. Gratis hasta 1.000 comentarios analizados al mes." buttonText="Reserva una llamada" buttonHref="/es/reservar-llamada" />
</BaseLayout>
