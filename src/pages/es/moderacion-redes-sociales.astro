---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/moderacion-redes-sociales",
  "name": "Moderación de redes sociales con IA: Facebook, Instagram, YouTube",
  "description": "Una herramienta de moderación de redes sociales que oculta automáticamente los comentarios de odio, el spam y las estafas en Facebook, Instagram y YouTube, según tus reglas, con una explicación por escrito de cada decisión.",
  "inLanguage": "es",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const platforms = [
  { name: "Facebook", href: "/es/integraciones/moderacion-facebook", text: "Los comentarios en las publicaciones de tus páginas se analizan en cuanto llegan. Los que incumplen tus reglas se ocultan automáticamente." },
  { name: "Instagram", href: "/es/integraciones/moderacion-instagram", text: "Los comentarios en tus publicaciones de Instagram se analizan de la misma forma y se ocultan cuando incumplen tus reglas." },
  { name: "YouTube", href: "/es/integraciones/moderacion-youtube", text: "Cada comentario en tus vídeos se publica, se retiene para revisión o se rechaza, directamente a través de la API de YouTube." },
  { name: "WordPress", href: "/es/integraciones/moderacion-wordpress", text: "Los comentarios de tu web se aprueban, se dejan pendientes o se marcan como spam, sin desarrollar ningún plugin." },
];

const steps = [
  { title: "Conecta tus cuentas", text: "Facebook, Instagram, YouTube o WordPress se conectan en unos clics, sin necesidad de un desarrollador." },
  { title: "Escribe tus reglas", text: "Escribe tus reglas en lenguaje natural, añade palabras prohibidas y fija un umbral por categoría. Un ajuste predefinido equilibrado te permite empezar enseguida." },
  { title: "La IA aplica tus reglas", text: "Lo que incumple claramente tus reglas se oculta, lo aceptable sigue publicado y nuestro equipo se ocupa de los casos límite. Tú lo ves todo en tiempo real." },
  { title: "Cada decisión queda explicada", text: "Una explicación por escrito acompaña cada decisión, automática o humana, y se conserva en el registro de auditoría." },
];

const faqItems = [
  {
    question: "¿Qué redes sociales puede moderar OpenModeration?",
    answer: "Facebook, Instagram y YouTube, además de las webs con WordPress, gracias a conectores nativos. Para otras fuentes, puedes enviar los contenidos a través de la API REST o de webhooks. TikTok, X y LinkedIn no tienen conector nativo por ahora.",
  },
  {
    question: "¿Hace falta saber programar para moderar tus redes sociales con OpenModeration?",
    answer: "No. Conectas tus cuentas, escribes tus reglas en lenguaje natural y nosotros nos ocupamos del resto, casos límite incluidos. En la consola ves cada decisión en tiempo real y puedes intervenir cuando quieras. La API solo te hace falta si quieres conectar una plataforma propia.",
  },
  {
    question: "¿Los comentarios se eliminan o se ocultan?",
    answer: "En Facebook e Instagram, los comentarios que incumplen tus reglas se ocultan. En YouTube, se rechazan o se retienen para revisión. En WordPress, se dejan pendientes o se marcan como spam. En todos los casos, la decisión y su explicación se conservan en el registro de auditoría.",
  },
  {
    question: "¿Cuánto cuesta una herramienta de moderación de redes sociales como OpenModeration?",
    answer: "El plan gratuito cubre hasta 1.000 solicitudes al mes, unos 30 comentarios al día. El plan Pro cuesta 99 € al mes por 10.000 solicitudes.",
  },
  {
    question: "¿Dónde se alojan los datos?",
    answer: "OpenModeration está diseñado y alojado en la Unión Europea y cumple el RGPD. Un despliegue on-premise es posible bajo petición: hablemos.",
  },
];
---

<BaseLayout title="Herramienta de moderación de redes sociales con IA, sin código" description="Oculta automáticamente los comentarios de odio, el spam y las estafas en Facebook, Instagram y YouTube, según tus reglas, y explica cada decisión. Gratis." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Moderación de redes sociales" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Facebook • Instagram • YouTube • WordPress
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderación de redes sociales automática y explicada</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Insultos, spam y estafas se acumulan bajo tus publicaciones a cualquier hora. OpenModeration los oculta automáticamente según tus reglas, en todas tus cuentas a la vez, y deja por escrito por qué se descartó cada comentario.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Prueba gratis</a>
        <a href="/es/como-funciona" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Descubre cómo funciona</a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Sin tarjeta de crédito</p>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Lo que hace OpenModeration en cada red</h2>
        <p class="mt-4 text-lg text-surface-500">Una sola consola y las mismas reglas para todas tus cuentas. La acción aplicada depende de lo que permita cada plataforma.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {platforms.map((p) => (
          <a href={p.href} class="block rounded-xl border border-surface-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-lg font-semibold text-surface-900">{p.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{p.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Cuatro pasos y nada de código</h2>
          <ol class="mt-8 space-y-4">
            {steps.map((s, i) => (
              <li class="flex items-start gap-4 rounded-lg border border-surface-200 bg-white p-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700">{i + 1}</span>
                <div>
                  <p class="text-sm font-medium text-surface-900">{s.title}</p>
                  <p class="mt-1 text-sm text-surface-500">{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <BrowserFrame caption="Un comentario ocultado, la regla incumplida y la explicación por escrito, a la vista de todo tu equipo.">
          <ModerationVerdict slot="content" />
        </BrowserFrame>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por qué una herramienta específica y no los filtros nativos</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">El contexto cuenta tanto como las palabras</h3>
          <p class="mt-2 text-sm text-surface-500">Una lista de palabras bloqueadas no detecta el sarcasmo, los insultos disimulados ni las estafas bien redactadas. Los modelos de IA leen la frase entera y la evalúan a la luz de tus reglas.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Una sola consola para todas tus cuentas</h3>
          <p class="mt-2 text-sm text-surface-500">Ya no tienes que saltar de una red a otra. Las decisiones de Facebook, Instagram, YouTube y tu web aparecen en la misma consola, en tiempo real, y nuestro equipo se ocupa de los casos límite.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Decisiones que puedes justificar</h3>
          <p class="mt-2 text-sm text-surface-500">Cada comentario descartado conserva su regla y su explicación por escrito. Si un seguidor protesta, sabes qué responderle, y el registro de auditoría está listo para la DSA.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes sobre la moderación de redes sociales" items={faqItems} />
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Para saber más</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/es/politica-de-moderacion" class="font-medium text-brand-600 hover:text-brand-500">Normas de la comunidad y política de moderación: guía y plantilla &rarr;</a></li>
        <li><a href="/es/casos-de-uso/medios" class="font-medium text-brand-600 hover:text-brand-500">La moderación de comentarios para medios de comunicación &rarr;</a></li>
        <li><a href="/es/alternativas/bodyguard" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration o Bodyguard: la comparativa &rarr;</a></li>
        <li><a href="/es/cumplimiento-dsa/declaracion-de-motivos" class="font-medium text-brand-600 hover:text-brand-500">La declaración de motivos que exige la DSA &rarr;</a></li>
        <li><a href="/es/precios" class="font-medium text-brand-600 hover:text-brand-500">Los precios &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Protege tus redes sociales en 5 minutos." subtitle="Conecta tus cuentas y escribe tus reglas en lenguaje natural: cada comentario ocultado va acompañado de una explicación por escrito." />
</BaseLayout>
