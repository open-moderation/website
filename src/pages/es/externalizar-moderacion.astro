    { eyebrow: "Comparativa", title: "Alternativas de moderación", text: "OpenModeration frente a agencias y otras herramientas.", href: "/alternatives" },
    { eyebrow: "Decisión", title: "¿Construir o comprar?", text: "Cuándo tiene sentido un sistema propio, y cuándo no.", href: "/build-vs-buy" },
