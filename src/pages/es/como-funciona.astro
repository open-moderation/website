---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'es';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Cómo funciona: moderamos tus comentarios, tú lo ves todo",
  "description": "Conectas tus páginas, nuestra IA y nuestro equipo moderan con tus reglas y ves cada decisión y su motivo en tiempo real. Detalles técnicos más abajo.",
  "crumb": "Cómo funciona",
  "h1": "Conectas tus páginas. Nosotros moderamos. Tú lo ves todo.",
  "lead": "Ninguna herramienta de moderación que manejar: nuestra IA y nuestro equipo aplican tus reglas día y noche, y tú conservas la visión completa y la última palabra.",
  "stepsTitle": "Tres pasos, y nada que manejar",
  "steps": [
    {
      "title": "Conectas tus páginas",
      "text": "Web, Facebook, Instagram, YouTube o WordPress: nuestro equipo las conecta contigo y configura tus reglas a partir de tus normas y casos de uso."
    },
    {
      "title": "Nuestra IA y nuestro equipo moderan con tus reglas",
      "text": "Nuestra IA lee cada comentario en su contexto y resuelve los casos claros. Los casos delicados se contrastan con otros modelos de IA; los dudosos, las denuncias y las reclamaciones los gestiona nuestro equipo."
    },
    {
      "title": "Lo ves todo en tiempo real",
      "text": "Cada decisión llega con su motivo por escrito. Lo sigues todo en la consola y puedes intervenir o corregir cuando quieras."
    }
  ],
  "stepsNote": "Tu equipo no tiene nada que hacer, salvo que quiera. El historial de cada decisión queda disponible para tus obligaciones DSA.",
  "outcomesTitle": "Qué pasa con cada comentario",
  "outcomesLead": "Las decisiones se aplican directamente en tu web y tus páginas, y cada una queda registrada con su motivo.",
  "outcomes": [
    {
      "label": "Publicado",
      "title": "Los comentarios sanos se publican",
      "text": "Los comentarios constructivos, aunque sean críticos, se publican con normalidad. La conversación sigue."
    },
    {
      "label": "Ocultado",
      "title": "Los abusos no llegan a tus lectores",
      "text": "Insultos, amenazas y spam se ocultan en Facebook e Instagram y se rechazan en YouTube y en tu web, con el motivo por escrito."
    },
    {
      "label": "Retenido",
      "title": "Los casos dudosos pasan a nuestro equipo",
      "text": "Cuando la IA duda, el comentario queda apartado y nuestro equipo decide según tus reglas. Nada se publica por error, nada se pierde."
    },
    {
      "label": "Notificado",
      "title": "Tus herramientas siempre informadas",
      "text": "Si quieres, cada decisión puede enviarse a tus propias herramientas: tus equipos están informados sin cambiar sus hábitos."
    }
  ],
  "testTitle": "Míralo primero con tus propios comentarios",
  "testText": "Probamos OpenModeration con tus comentarios reales, en silencio y en paralelo a tu proveedor actual si tienes uno. Comparas decisión por decisión antes de elegir.",
  "devEyebrow": "Para desarrolladores",
  "devTitle": "Por dentro: el flujo en cuatro etapas",
  "devLead": "Detrás de los tres pasos, cada comentario pasa por cuatro etapas técnicas. Esto es lo que tu equipo técnico necesita saber.",
  "pipeline": [
    {
      "title": "Recogida",
      "text": "Los comentarios llegan por la API, un webhook o un conector de red social.",
      "tags": [
        "POST /v1/moderation",
        "Webhooks",
        "Facebook",
        "Instagram",
        "YouTube"
      ]
    },
    {
      "title": "Moderación con IA",
      "text": "Nuestra IA analiza el comentario; otros modelos contrastan los casos delicados.",
      "tags": [
        "IA OpenModeration",
        "Contraste"
      ]
    },
    {
      "title": "Reglas y acciones",
      "text": "Se evalúan tus reglas y las acciones se ejecutan automáticamente.",
      "tags": [
        "Ocultar",
        "Retener",
        "Publicar",
        "Webhook"
      ]
    },
    {
      "title": "Revisión humana",
      "text": "Nuestro equipo gestiona los casos dudosos; puedes intervenir en cualquier momento.",
      "tags": [
        "Nuestro equipo",
        "Corrección"
      ]
    }
  ],
  "stepLabel": "Etapa",
  "details": [
    {
      "title": "Los comentarios llegan de todas partes",
      "text": "Envía los comentarios por la API REST, por un webhook genérico o por los conectores nativos, que recogen los comentarios automáticamente.",
      "points": [
        "API: POST /v1/moderation, uno a uno o por lotes",
        "Webhooks: un punto de entrada genérico recibe y normaliza los datos externos",
        "Conectores: Facebook, Instagram, YouTube y WordPress"
      ],
      "codeTitle": "Ejemplo: un comentario de Facebook"
    },
    {
      "title": "La IA modera el comentario",
      "text": "Cada comentario lo analiza nuestra IA de moderación, desarrollada internamente y configurada con tus reglas. Los casos delicados se contrastan con otros modelos de IA. Los resultados vuelven en un formato estándar, con puntuaciones de 0,0 a 1,0 por categoría.",
      "points": [
        "El formato de respuesta no cambia nunca",
        "Cuando sale un modelo mejor, lo conectamos: nada cambia para ti"
      ],
      "codeTitle": "Respuesta estándar"
    },
    {
      "title": "Tus reglas se aplican automáticamente",
      "text": "Las reglas combinan palabras prohibidas para un bloqueo inmediato, umbrales por categoría y reglas en lenguaje natural que la IA aplica según el contexto. Nuestro equipo las configura contigo; tus desarrolladores también pueden gestionarlas por la API.",
      "points": [
        "Las palabras prohibidas bloquean un comentario al instante, antes de cualquier llamada a la IA",
        "Los umbrales por categoría activan las acciones automáticamente",
        "Las reglas en lenguaje natural marcan el tono de tus espacios"
      ],
      "codeTitle": "Configuración por la API"
    },
    {
      "title": "Todo queda registrado",
      "text": "Cada decisión, de la IA o de nuestro equipo, se registra con su motivo, su autor y las acciones realizadas. Los webhooks pueden avisar a tus herramientas de cada una.",
      "points": [
        "Cada corrección se registra con su autor y su justificación",
        "Historial completo para auditorías e informes DSA"
      ],
      "codeTitle": "Registro de auditoría de cada comentario"
    }
  ],
  "rulesAlt": "Ajustes de reglas de OpenModeration: palabras prohibidas, umbrales por categoría y reglas en lenguaje natural",
  "rulesCaption": "Tus reglas, configuradas una vez, aplicadas en cada plataforma conectada.",
  "code": {
    "webhook": "Facebook envía el comentario por webhook",
    "rules": "Configura tus umbrales de moderación",
    "audit": "Registro de auditoría completo de cada comentario"
  }
};

const stepIcons = [
  "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1",
  "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
];
const outcomeStyles = [
  "bg-green-100 text-green-600",
  "bg-red-100 text-red-600",
  "bg-amber-100 text-amber-600",
  "bg-blue-100 text-blue-600"
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/como-funciona",
  "url": "https://www.openmoderation.com/es/como-funciona",
  "name": "Cómo funciona: moderamos tus comentarios, tú lo ves todo",
  "description": "Conectas tus páginas, nuestra IA y nuestro equipo moderan con tus reglas y ves cada decisión y su motivo en tiempo real. Detalles técnicos más abajo.",
  "inLanguage": "es",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};

const facebookWebhookExample = `// Facebook envía el comentario por webhook
{
  "source": "facebook",
  "content_id": "comment_123",
  "author_id": "user_456",
  "text": "Comment text here...",
  "metadata": {"post_url": "..."}
}`;

const moderationResponseExample = `{
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const ruleConfigExample = `// Configura tus umbrales de moderación
PUT /v1/settings

{
  "thresholds": {
    "hate":       { "accepted": 0.3, "rejected": 0.7 },
    "harassment": { "accepted": 0.3, "rejected": 0.7 },
    "sexual":     { "accepted": 0.2, "rejected": 0.8 },
    "violence":   { "accepted": 0.3, "rejected": 0.7 },
    "self-harm":  { "accepted": 0.2, "rejected": 0.8 },
    "spam":       { "accepted": 0.4, "rejected": 0.8 }
  },
  "actions": {
    "on_reject": ["hide", "flag_for_review"]
  }
}`;

const auditTrailExample = `// Registro de auditoría completo de cada comentario
{
  "content_id": "...",
  "source": "webhook",
  "platform": "facebook",
  "status": "actioned",
  "moderation": {
    "flagged": true,
    "results": [...]
  },
  "actions": [{
    "rule": "Hide hate speech",
    "type": "hide",
    "status": "executed"
  }]
}`;
const codes = [facebookWebhookExample, moderationResponseExample, ruleConfigExample, auditTrailExample];
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Inicio", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- The promise in three steps -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mx-auto max-w-2xl text-center text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.stepsTitle}</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {c.steps.map((s, i) => (
          <li class="relative rounded-2xl border border-surface-200 bg-surface-50 p-8">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stepIcons[i]}/></svg>
            </div>
            <p class="text-sm font-semibold text-brand-600">{i + 1}</p>
            <h3 class="mt-1 text-xl font-semibold text-surface-900">{s.title}</h3>
            <p class="mt-3 text-surface-500">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mx-auto mt-10 max-w-2xl text-center text-surface-600">{c.stepsNote}</p>
    </div>
  </section>

  <!-- What happens to each comment -->
  <section id="action-engine" class="scroll-mt-24 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.outcomesTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.outcomesLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {c.outcomes.map((o, i) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <span class={`mb-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold ${outcomeStyles[i]}`}>{o.label}</span>
            <h3 class="font-semibold text-surface-900">{o.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{o.text}</p>
          </div>
        ))}
      </div>
      <div class="mx-auto mt-12 max-w-2xl rounded-2xl border border-brand-200 bg-white p-8 text-center">
        <h3 class="text-xl font-semibold text-surface-900">{c.testTitle}</h3>
        <p class="mt-2 text-surface-500">{c.testText}</p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section id="developers" class="scroll-mt-24 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{c.devEyebrow}</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-surface-900">{c.devTitle}</h2>
        <p class="mt-4 text-surface-500">{c.devLead}</p>
      </div>
      <div class="mb-16 grid grid-cols-2 gap-4 rounded-2xl border border-surface-200 bg-surface-50 p-6 lg:grid-cols-4">
        {c.pipeline.map((p, i) => (
          <div class="rounded-xl border border-surface-200 bg-white p-5 text-center">
            <p class="font-semibold text-surface-900">{i + 1}. {p.title}</p>
            <p class="mt-2 text-sm text-surface-500">{p.text}</p>
            <div class="mt-3 flex flex-wrap justify-center gap-2">
              {p.tags.map((tag) => <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">{tag}</span>)}
            </div>
          </div>
        ))}
      </div>
      <div class="space-y-16">
        {c.details.map((d, i) => (
          <div class="grid items-center gap-8 lg:grid-cols-2">
            <div class={i % 2 ? 'lg:order-2' : ''}>
              <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">{c.stepLabel} {i + 1}</span>
              <h3 class="text-2xl font-bold text-surface-900">{d.title}</h3>
              <p class="mt-4 text-surface-500">{d.text}</p>
              <ul class="mt-6 space-y-2 text-sm text-surface-600">
                {d.points.map((pt) => (
                  <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{pt}</span></li>
                ))}
              </ul>
            </div>
            <div class={i % 2 ? 'lg:order-1' : ''}>
              {i === 2 && (
                <div class="mb-4">
                  <BrowserFrame src="/images/rules.png" video="om-rules" alt={c.rulesAlt} caption={c.rulesCaption} eager={false} />
                </div>
              )}
              <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
                <p class="mb-3 text-sm font-semibold text-surface-900">{d.codeTitle}</p>
                <CodeBlock code={codes[i]} lang="json" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
