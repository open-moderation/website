---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/es/api-moderacion-texto",
      "url": "https://www.openmoderation.com/es/api-moderacion-texto",
      "name": "API de moderación de texto: modera comentarios, chats y mensajes",
      "description": "API de moderación de texto para comentarios, chats y reseñas: nuestra propia IA tras un único endpoint, reglas propias, doble umbral y auditoría DSA.",
      "inLanguage": "es",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/text-moderation-api#software",
      "name": "OpenModeration Text Moderation API",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cualquiera (API REST)",
      "description": "API de moderación de texto: un endpoint, nuestra propia IA contrastada por otros modelos, reglas propias, doble umbral, lotes y auditoría DSA.",
      "url": "https://www.openmoderation.com/es/api-moderacion-texto",
      "inLanguage": "es",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
    }
  ]
};

const quickstart = `# Modera cualquier texto: comentarios, chat, mensajes, reseñas
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "user comment here",
    "categories": ["hate", "harassment", "sexual", "violence", "self-harm", "spam"],
    "threshold": 0.5
  }'

# Respuesta (formato estandarizado)
{
  "flagged": false,
  "results": [{ "category": "harassment", "score": 0.03, "flagged": false }],
  "usage": { "latency_ms": 212 }
}`;

const useCases = [
  { name: "Comentarios y reseñas", desc: "Oculta automáticamente el discurso de odio, el spam y las filtraciones de datos personales en comentarios, reseñas y mensajes de foros antes de que se publiquen." },
  { name: "Chat y mensajería", desc: "Modera el texto en tiempo real y en varios idiomas, con una latencia inferior a 250 ms y acciones automáticas." },
  { name: "Prompts de aplicaciones de IA", desc: "Filtra tanto lo que escriben los usuarios como las respuestas del modelo. Define categorías personalizadas y cambiantes en lenguaje natural." },
  { name: "Anuncios de marketplaces", desc: "Señala los anuncios de spam, las estafas y el contenido prohibido en títulos y descripciones en el momento en que llegan." },
];

const faqItems = [
  {
    question: "¿Qué es una API de moderación de texto?",
    answer: "Una API de moderación de texto puntúa el texto generado por los usuarios (odio, acoso, contenido sexual, violencia, spam, datos personales…) para que tu aplicación pueda aprobarlo, señalarlo o rechazarlo automáticamente. OpenModeration usa su propia IA de moderación tras un único endpoint, contrastada por otros modelos de IA en los casos delicados, con un formato de respuesta estandarizado, reglas personalizadas y un registro de auditoría."
  },
  {
    question: "¿Qué API de moderación de texto debería elegir?",
    answer: "Las API de un solo modelo (OpenAI, Azure, Mistral) permiten arrancar rápido, pero te atan a ese modelo. OpenModeration usa su propia IA, contrastada por otros modelos en los casos delicados, incorpora los modelos mejores a medida que salen y añade prefiltrado, reglas, revisión de los casos dudosos por nuestro equipo y una consola en tiempo real."
  },
  {
    question: "¿Cuánto cuesta una API de moderación de texto?",
    answer: "El endpoint de moderación de OpenAI es gratuito, Mistral fija su propio precio para su modelo de moderación y Azure AI Content Safety factura por cada 1.000 registros de texto tras un nivel gratuito de 5.000 registros al mes. OpenModeration es gratis hasta 1.000 comentarios analizados al mes; la nube gestionada empieza en 99 €/mes por 10.000 comentarios analizados."
  },
  {
    question: "¿Puedo definir reglas de moderación personalizadas?",
    answer: "Sí. Tienes tres herramientas, sin código: palabras prohibidas (bloqueo inmediato), umbrales por categoría (aprobación automática, revisión por nuestro equipo o rechazo automático) y tus propias reglas en lenguaje natural, que nuestra IA aplica para categorías personalizadas como la desinformación o el grooming."
  },
  {
    question: "¿Puedo migrar desde text-moderation-latest de OpenAI?",
    answer: "Sí. Sustituye openai.moderations.create por una única llamada POST /v1/moderation. Obtienes puntuaciones estandarizadas, motivos por escrito y un registro de auditoría, y cuando incorporamos un modelo de IA mejor, no cambia nada en tu código."
  },
  {
    question: "¿Queda registrada cada decisión de moderación de texto?",
    answer: "Sí. Cada decisión, de la IA o humana, conserva las puntuaciones, los umbrales, el revisor y la fecha y hora. Exporta el registro de auditoría completo con un clic para tus informes de transparencia de la DSA."
  },
];
---

<BaseLayout
  title="API de moderación de texto: comentarios, chats y mensajes"
  description="API de moderación de texto con nuestra propia IA, contrastada por otros modelos. Oculta comentarios tóxicos, spam y datos personales, con auditoría DSA."
  jsonLd={pageJsonLd}
>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "API de moderación de texto" }]} />

  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Para desarrolladores: API REST + consola
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Una API de moderación de texto que puntúa, decide y deja constancia.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Un único endpoint analiza cada texto (comentarios, chats, mensajes, reseñas) con nuestra propia IA,
        contrastada por otros modelos en los casos delicados. Incluye prefiltrado, reglas personalizadas, doble umbral
        y un registro de auditoría preparado para la DSA.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/es/reservar-llamada" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Reservar una llamada</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          Consigue tu clave de API gratis
        </a>
        <a href="https://api.openmoderation.com/docs" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          Lee la documentación de la API &rarr;
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Plan gratuito · Sin tarjeta de crédito · Referencia OpenAPI</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Modera cualquier texto con una sola solicitud</h2>
          <p class="mt-4 text-lg text-surface-500">
            Envía el texto a un único endpoint. Cuando incorporamos un modelo de IA mejor, tu integración no cambia.
            Las puntuaciones llegan estandarizadas, con los umbrales que tú decides.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span>Cubre 10 categorías y analiza cada texto en su propio idioma: odio, acoso, contenido sexual, violencia, autolesiones, spam, datos personales y categorías personalizadas.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span>El prefiltrado bloquea el spam evidente y las palabras prohibidas antes de cualquier llamada a la IA.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span>Con el doble umbral, los casos claros se aprueban o se rechazan automáticamente, y nuestro equipo revisa la zona gris.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span>Los lotes de hasta 10.000 textos usan el mismo esquema que las llamadas individuales.</span></li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3 text-sm">
            <a href="/es/api-moderacion-contenido" class="font-medium text-brand-600 hover:text-brand-500">API de moderación de contenido completa &rarr;</a>
            <a href="/es/alternativas/openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">Alternativa a OpenAI Moderation &rarr;</a>
            <a href="/es/funcionalidades" class="font-medium text-brand-600 hover:text-brand-500">Todas las funcionalidades de la API &rarr;</a>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={quickstart} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pensada para todos los casos de moderación de texto</h2>
        <p class="mt-4 text-lg text-surface-500">Una sola API para cualquier lugar donde escriban tus usuarios.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {useCases.map((u) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{u.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{u.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">API de un solo modelo frente a OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Una puntuación de toxicidad en bruto no basta para moderar.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Capacidad</th>
              <th class="px-6 py-4 font-semibold text-surface-500">API de texto de un solo modelo</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            <tr><td class="px-6 py-4 font-medium text-surface-900">Motor de IA</td><td class="px-6 py-4 text-surface-500">Un solo modelo (dependencia total)</td><td class="px-6 py-4">Nuestra propia IA, contrastada por otros modelos; incorporamos los mejores a medida que salen</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Reglas personalizadas</td><td class="px-6 py-4 text-surface-500">Por tu cuenta</td><td class="px-6 py-4">Palabras prohibidas, umbrales y normas en lenguaje natural aplicadas por la IA, sin código</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Revisión humana</td><td class="px-6 py-4 text-surface-500">Por tu cuenta</td><td class="px-6 py-4">Nuestro equipo se ocupa de los casos dudosos; tú lo ves todo en tiempo real</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Registro de auditoría</td><td class="px-6 py-4 text-surface-500">Solo los logs de la API</td><td class="px-6 py-4">Exportación DSA completa: decisiones de la IA y humanas</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Precio</td><td class="px-6 py-4 text-surface-500">Lo fija cada modelo, desde gratis (OpenAI) hasta facturado por llamada</td><td class="px-6 py-4">Gratis hasta 1.000 comentarios analizados/mes · gestionado desde 99 €/mes</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="API de moderación de texto: preguntas frecuentes" />
    </div>
  </section>

  <CTASection
    title="Empieza a moderar texto en minutos."
    subtitle="Consigue una clave de API, copia el ejemplo curl y modera tu primer texto hoy mismo, con reglas, revisión de los casos dudosos por nuestro equipo y registro de auditoría desde el primer día."
    buttonText="Prueba la API gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
