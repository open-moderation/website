---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import BrowserFrame from '../../../components/BrowserFrame.astro';
import ClientLogos from '../../../components/ClientLogos.astro';
import FAQ from '../../../components/FAQ.astro';

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Moderación de comentarios para medios de comunicación y webs de noticias",
  "description": "Moderación de comentarios con IA para medios digitales y redacciones: tu línea editorial aplicada en cada artículo, una explicación por escrito de cada comentario retirado, una cola de revisión para los periodistas y un registro de auditoría para la DSA.",
  "inLanguage": "es",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const faqItems = [
  {
    question: "¿Tienen que cumplir la DSA los medios digitales en sus secciones de comentarios?",
    answer: "Las secciones de comentarios alojan contenido publicado por los lectores, así que un medio que las ofrece actúa como servicio de alojamiento de datos según la Ley de Servicios Digitales. El artículo 17 exige una declaración de motivos clara cada vez que se retira o se restringe un comentario, indicando también si se han utilizado medios automatizados. OpenModeration redacta esa declaración para cada decisión y la conserva en el registro de auditoría.",
  },
  {
    question: "¿Podemos moderar según nuestra propia línea editorial?",
    answer: "Sí. Redactas tu línea editorial en lenguaje natural y OpenModeration la aplica a cada comentario. La sección de deportes y la de política pueden tener reglas distintas, y puedes endurecer o relajar una regla en cualquier momento sin tocar el código.",
  },
  {
    question: "¿Qué pasa con los comentarios dudosos?",
    answer: "Cada categoría tiene dos umbrales. Las infracciones claras se ocultan automáticamente, los comentarios claramente aceptables se publican y todo lo que queda en medio va a una cola de revisión donde tus moderadores o periodistas deciden con un solo clic.",
  },
  {
    question: "¿Pueden los periodistas seguir moderando desde la página del artículo?",
    answer: "Sí. Las decisiones que toma tu redacción quedan registradas en el mismo historial de actividad que las decisiones automáticas, así que conservas un único registro completo de quién decidió qué y por qué.",
  },
  {
    question: "¿Dónde se alojan los datos?",
    answer: "OpenModeration se desarrolla y se aloja en la Unión Europea y cumple el RGPD. Si tu equipo jurídico lo exige, un despliegue on-premise es posible bajo petición.",
  },
];
---

<BaseLayout title="Moderación de comentarios para medios de comunicación" description="Modera los comentarios de cada artículo con una IA que sigue tu línea editorial. Explicación de cada retirada, cola de revisión y auditoría DSA. Alojado en la UE." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Casos de uso", href: "/es/casos-de-uso" }, { label: "Medios de comunicación" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Caso de uso
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderación de comentarios para medios de comunicación</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Los comentarios de los lectores dan vida a un artículo, hasta que los insultos y el spam se adueñan del hilo. OpenModeration aplica tu línea editorial a cada comentario, explica por escrito cada retirada y deja que tu redacción resuelva los casos difíciles.
      </p>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">El reto</h3>
          <p class="mt-2 text-sm text-surface-600">Un medio con mucho tráfico recibe comentarios a todas horas, con picos en cada noticia de última hora. Los periodistas no pueden leerlos todos, y los filtros de palabras clave no captan el sarcasmo, los insultos encubiertos ni los ataques fuera de tema, mientras bloquean críticas legítimas.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">El enfoque de OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">Una IA que entiende el contexto contrasta cada comentario con tu línea editorial. Las infracciones claras se ocultan al instante, los comentarios aceptables se publican y los dudosos llegan a una cola de revisión con la regla en cuestión y una explicación por escrito.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">El resultado</h3>
          <p class="mt-2 text-sm text-surface-600">Tus moderadores dedican su tiempo a los comentarios que necesitan un criterio humano. Cada decisión, automática o editorial, queda registrada con su motivo, lista para responder a la reclamación de un lector o a un regulador.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pensado para la forma de trabajar de las redacciones</h2>
          <p class="mt-4 text-lg text-surface-500">
            Moderar una sección de comentarios es una decisión editorial. OpenModeration deja a tu equipo al mando y le quita de encima la parte repetitiva.
          </p>
          <div class="mt-8 space-y-3">
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Tu línea editorial, en lenguaje natural</p>
              <p class="mt-1 text-xs text-surface-500">Escribe las normas que tus lectores ya conocen. Sin listas de palabras clave que mantener ni código que cambiar cuando se mueve el límite.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Una zona gris para el criterio humano</p>
              <p class="mt-1 text-xs text-surface-500">Dos umbrales por categoría separan lo que se oculta automáticamente de lo que revisa tu equipo. Tú decides cuán amplia es la zona gris.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Un único historial para la IA y la redacción</p>
              <p class="mt-1 text-xs text-surface-500">Las retiradas que hacen los periodistas aparecen junto a las automáticas en el registro de actividad, con el moderador que las tomó y el motivo.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Comentarios de artículos y redes sociales, juntos</p>
              <p class="mt-1 text-xs text-surface-500">Modera tu web a través de la API o del conector de WordPress, y los comentarios de tus publicaciones en Facebook, Instagram y YouTube desde la misma consola.</p>
            </div>
          </div>
        </div>
        <BrowserFrame
          src="/images/dashboard.png"
          video="om-triage"
          alt="Cola de moderación de OpenModeration con comentarios de lectores, su estado y la acción aplicada"
          caption="La cola de revisión: cada comentario con su estado, la regla implicada y la explicación por escrito."
        />
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por qué los medios eligen OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Una declaración de motivos para cada retirada</h3>
          <p class="mt-2 text-sm text-surface-500">La DSA obliga a los servicios de alojamiento a explicar cada retirada. OpenModeration redacta esa explicación automáticamente, para que los lectores sepan qué norma han incumplido.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Desarrollado y alojado en la UE</h3>
          <p class="mt-2 text-sm text-surface-500">Los datos de tus lectores se quedan en Europa y la plataforma cumple el RGPD. Si tu equipo jurídico lo exige, un despliegue on-premise es posible bajo petición.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Sin caja negra</h3>
          <p class="mt-2 text-sm text-surface-500">Cada decisión llega con su explicación por escrito y queda en un registro de auditoría completo. Puedes cambiar de proveedor de IA sin reescribir tu integración.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Preguntas frecuentes" items={faqItems} />
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Recursos relacionados</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/es/cumplimiento-dsa" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Normativa</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Cumplimiento de la DSA</h3>
          <p class="mt-2 text-sm text-surface-500">Qué exige la Ley de Servicios Digitales a los sitios que alojan comentarios y cómo cumplirlo.</p>
        </a>
        <a href="/es/producto/transparencia" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Plataforma</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Cada decisión, explicada</h3>
          <p class="mt-2 text-sm text-surface-500">Cómo redacta OpenModeration un motivo para cada decisión de moderación.</p>
        </a>
        <a href="/es/integraciones/moderacion-wordpress" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Integración</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Moderación de comentarios en WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Modera los comentarios de un medio en WordPress sin escribir código.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection title="Devuelve la sección de comentarios a tus lectores." subtitle="Redacta tu línea editorial, conecta tu web y deja que tu redacción se centre en los comentarios que necesitan una decisión humana." />
</BaseLayout>
