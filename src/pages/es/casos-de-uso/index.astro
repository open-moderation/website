---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import KpiBand from '../../../components/KpiBand.astro';

const useCasesJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Casos de uso de la moderación de contenido | OpenModeration",
  "description": "Cómo usan OpenModeration plataformas de todo tipo: redes sociales, aplicaciones de IA, marketplaces, videojuegos y SaaS empresarial.",
  "inLanguage": "es"
};

const kpis = [
  { value: "24/7", label: "Moderación automática, con nuestro equipo para los casos dudosos" },
  { value: "300 ms", prefix: "<", label: "Latencia mediana (P50)" },
  { value: "10.000", label: "Elementos por petición batch" },
  { value: "100 %", label: "Decisiones explicadas por escrito" },
];

const useCases = [
  {
    title: "Medios de comunicación",
    tagline: "Comentarios de artículos, redacciones",
    description: "Aplica tu línea editorial a cada comentario de tus lectores, explica por escrito cada retirada y deja los casos dudosos a nuestro equipo mientras tú lo ves todo en tiempo real.",
    href: "/es/casos-de-uso/medios",
    iconPath: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
  },
  {
    title: "Plataformas sociales",
    tagline: "Foros, comunidades, contenido de usuarios",
    description: "Protege a tu comunidad del discurso de odio, el spam y las estafas. Automatiza la aplicación de tus reglas; nuestro equipo se ocupa de los casos límite.",
    href: "/es/casos-de-uso/plataformas-sociales",
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Aplicaciones de IA",
    tagline: "Filtrado de entradas y salidas de LLM",
    description: "Filtra los prompts y las respuestas del modelo en un mismo sistema. Nuestra IA, contrastada por otros modelos, defiende contra la inyección de prompts y las salidas dañinas.",
    href: "/es/casos-de-uso/aplicaciones-ia",
    iconPath: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Marketplaces",
    tagline: "Anuncios, reseñas, clasificados",
    description: "Modera anuncios de productos, reseñas y mensajes de vendedores, sea cual sea el volumen. Detecta estafas y artículos prohibidos antes de que se publiquen.",
    href: "/es/casos-de-uso/marketplaces",
    iconPath: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z",
  },
  {
    title: "Videojuegos",
    tagline: "Chat, MMO, live ops",
    description: "Modera el chat en tiempo real y en varios idiomas, en menos de 500 ms. Elimina automáticamente las infracciones antes de que el resto de jugadores llegue a verlas.",
    href: "/es/casos-de-uso/videojuegos",
    iconPath: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "SaaS empresarial",
    tagline: "Cumplimiento, SOC 2, auditoría",
    description: "Registros de auditoría completos, datos alojados en la UE, control de la retención de datos y una preparación demostrable para la DSA y SOC 2.",
    href: "/es/casos-de-uso/saas-empresarial",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
  {
    title: "Marcas y retail",
    tagline: "Páginas de marca, campañas, opiniones de clientes",
    description: "Oculta el spam, las estafas y los insultos de tus publicaciones, dejando visibles a los clientes descontentos a los que responder.",
    href: "/es/casos-de-uso/marcas-retail",
    iconPath: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z",
  },
  {
    title: "Lujo y moda",
    tagline: "Instagram, falsificaciones, multilingüe",
    description: "Aparta de tus publicaciones las falsificaciones, las cuentas falsas y los mensajes de odio, en todos los idiomas de tus clientes.",
    href: "/es/casos-de-uso/lujo-moda",
    iconPath: "M5 3l3.057 4.583L12 3l3.943 4.583L19 3l2 7-9 11-9-11 2-7z",
  },
  {
    title: "Sector público e instituciones",
    tagline: "Consultas, participación ciudadana",
    description: "Modera tus consultas y tus páginas con normas públicas y una explicación por escrito de cada decisión.",
    href: "/es/casos-de-uso/sector-publico",
    iconPath: "M3 21h18M5 21V10m14 11V10M12 3l9 7H3l9-7zM9 21v-6h6v6",
  },
];
---

<BaseLayout title="Casos de uso de la moderación de contenido: redes, IA, juegos" description="Descubre cómo redes sociales, apps de IA, marketplaces, videojuegos y empresas usan OpenModeration para una moderación transparente y conforme a la DSA." jsonLd={useCasesJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Casos de uso" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
        <span class="flex h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        Casos de uso
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Una sola plataforma de moderación para cualquier tipo de plataforma</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Un foro, una app basada en LLM, un marketplace o un videojuego: OpenModeration se adapta a tu contenido, a tus reglas y a tus casos de uso.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/es/reservar-llamada" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Reservar una llamada</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Probar gratis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <KpiBand items={kpis} />
  </section>

  <section class="bg-white pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {useCases.map((useCase) => (
          <a href={useCase.href} class="group rounded-xl border border-surface-200 bg-surface-50 p-8 transition hover:border-brand-300 hover:shadow-md">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={useCase.iconPath}/></svg>
            </div>
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">{useCase.title}</h2>
            <p class="mt-1 text-xs font-medium uppercase tracking-wide text-surface-400">{useCase.tagline}</p>
            <p class="mt-3 text-sm text-surface-500">{useCase.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Más información
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
        <a href="/es/funcionalidades" class="group rounded-xl border-2 border-dashed border-surface-300 bg-white p-8 transition hover:border-brand-400">
          <div class="flex h-full flex-col items-start justify-center">
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">Descubre todas las funcionalidades</h2>
            <p class="mt-3 text-sm text-surface-500">API unificada, motor de acciones, consola de revisión, conectores y registros de auditoría para la DSA.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Ver la plataforma
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">La misma plataforma, normas distintas</h2>
        <p class="mt-4 text-lg text-surface-500">Todos los casos de uso comparten las mismas piezas. Lo único que cambia son las reglas.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">1. Recibe el contenido</h3>
          <p class="mt-2 text-sm text-surface-500">API REST, endpoint batch para el contenido acumulado, webhooks o conectores nativos para Facebook, Instagram, YouTube y WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">2. Modera con IA</h3>
          <p class="mt-2 text-sm text-surface-500">Nuestra propia IA analiza cada petición y otros modelos arbitran los casos delicados. Siempre con el mismo esquema de respuesta.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">3. Actúa automáticamente</h3>
          <p class="mt-2 text-sm text-surface-500">Las palabras prohibidas, los umbrales por categoría y las normas de tu comunidad determinan qué se oculta, se elimina, se marca o pasa a revisión por nuestro equipo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Recursos relacionados</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/es/blog/guia-dsa-pymes" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guía</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Cumplimiento de la DSA para plataformas pequeñas y medianas</h3>
          <p class="mt-2 text-sm text-surface-500">Pasos prácticos para cumplir los requisitos de la DSA en 2026 paso a paso.</p>
        </a>
        <a href="/es/blog/guia-moderacion-contenido-ia-desarrolladores" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guía</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Moderación de contenido para aplicaciones de IA</h3>
          <p class="mt-2 text-sm text-surface-500">Buenas prácticas para filtrar entradas y salidas en apps basadas en LLM.</p>
        </a>
        <a href="/es/consola-de-moderacion" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Producto</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">La consola de moderación</h3>
          <p class="mt-2 text-sm text-surface-500">Cada decisión en tiempo real, registros de auditoría, estado del servicio y analítica de uso.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Empieza con tu caso de uso."
    subtitle="Elige un caso de uso, empieza gratis en la nube gestionada y modera tu primer comentario hoy mismo."
    buttonText="Pruébalo gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
