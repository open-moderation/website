---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModerationDemo from '../../components/ModerationDemo.astro';
import { bookingUrl, useTranslations } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';
import CharterSupport from '../../components/CharterSupport.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import ValueCards from '../../components/ValueCards.astro';
import AppVideo from '../../components/AppVideo.astro';
import CostCalculator from '../../components/CostCalculator.astro';
import TeamSection from '../../components/TeamSection.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "description": "AI comment moderation adapted to each client's rules and use cases, with a team that sets it up. DSA-compliant, hosted in the EU.",
      "email": "contact@openmoderation.com",
      "areaServed": "EU",
      "knowsAbout": ["Comment moderation", "Content moderation", "Social media moderation", "Digital Services Act compliance", "Trust and safety"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "contact@openmoderation.com",
        "url": "https://www.openmoderation.com/book-a-call",
        "availableLanguage": ["English", "French", "Spanish", "German", "Italian"]
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "inLanguage": "es",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/#software",
      "name": "OpenModeration",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Moderación de comentarios con IA para medios, marcas y redes sociales, adaptada a tus reglas y casos de uso. Funciona en tu web, Facebook, Instagram, YouTube y WordPress, envía los casos dudosos a tu equipo, explica cada decisión por escrito y cumple la DSA, con un equipo que te acompaña.",
      "url": "https://www.openmoderation.com",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Comentarios moderados al día", value: "10 M+" },
  { label: "Listo en", value: "5 min" },
  { label: "Moderación automática", value: "24/7" },
  { label: "Decisiones explicadas por escrito", value: "100 %" },
];

const valueItems = [
  { title: "Tus reglas, tus casos de uso", text: "Adaptamos la moderación a tus reglas y a lo que importa en tu contexto: ironía, política, competidores, jerga local. Nada genérico." },
  { title: "Un equipo detrás de la herramienta", text: "Te ayudamos a redactar y ajustar tus reglas, revisamos contigo los casos dudosos y lo adaptamos a medida que cambia tu comunidad. Siempre tienes a alguien con quien hablar." },
  { title: "Todo funciona de forma automática", text: "Una vez definidas las reglas, cada comentario se gestiona en segundos, de día y de noche. Tu equipo solo ve los casos que necesitan a una persona." },
  { title: "Mucho más barato que hacerlo a mano", text: "La moderación automática cuesta una fracción de lo que cuesta un equipo de moderación externo o interno." },
];


const faqItems = [
  {
    question: '¿Qué plataforma de moderación combina una consola para moderadores, IA que entiende el contexto y registros de auditoría para el cumplimiento normativo?',
    answer: 'OpenModeration reúne las tres cosas. Una IA que entiende el contexto lee cada comentario, tus reglas deciden qué se oculta, qué se publica y qué pasa a revisión, los moderadores trabajan desde una única consola y cada decisión queda registrada con una explicación por escrito para las auditorías de la DSA.',
  },
  {
    question: '¿Existe una herramienta sin código que permita escribir reglas de moderación, usar clasificación con IA y conservar un registro de auditoría?',
    answer: 'Sí. En OpenModeration escribes tus reglas en lenguaje natural y fijas umbrales por categoría sin programar. La clasificación con IA se aplica a cada comentario y el registro de actividad guarda cada acción, quién o qué la realizó y por qué.',
  },
  {
    question: '¿Puedo moderar Facebook, Instagram, YouTube y mi web desde un solo lugar?',
    answer: 'Sí. Conecta tus páginas de Facebook, tus cuentas de Instagram, tus canales de YouTube y tu sitio WordPress, o envía contenido desde cualquier plataforma a través de la API. Todo llega a la misma cola de revisión y se rige por las mismas reglas.',
  },
  {
    question: '¿Qué debe ofrecer una API de moderación para el cumplimiento normativo en una gran empresa?',
    answer: 'Busca una declaración de motivos por escrito para cada decisión (exigida por el artículo 17 de la DSA), un registro de auditoría completo, alojamiento de datos en la UE, un periodo de conservación configurable e informes exportables. OpenModeration cumple los cinco requisitos y nuestro equipo configura las reglas contigo.',
  },
  {
    question: '¿OpenModeration es gratis?',
    answer: 'El plan en la nube es gratuito hasta 1.000 solicitudes al mes, el plan Pro cuesta 99 € al mes por 10.000 solicitudes. Para grandes volúmenes o un despliegue en tus servidores, reserva una llamada y dimensionamos la oferta contigo.',
  },
];
---

<BaseLayout
  title="Moderación de comentarios con IA, conforme a la DSA"
  description="Moderación de comentarios con IA adaptada a tus reglas y casos de uso, en tu web y redes sociales. Conforme a la DSA, alojada en la UE, con nuestro equipo."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-violet-50" />
    <div class="joy-blob pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-300/40 blur-3xl" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute -right-24 top-10 h-[28rem] w-[28rem] rounded-full bg-violet-300/40 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-sun-300/30 blur-3xl" style="animation-delay:-12s" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16">
      <div class="text-center lg:text-left">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Para medios, marcas y redes sociales
        </div>
        <h1 class="animate-fade-in-up text-4xl font-extrabold leading-[1.05] tracking-tight text-surface-900 sm:text-5xl lg:text-[3.7rem]">
          Una moderación que se adapta a <em>tus</em> reglas.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-600 sm:text-xl">
          Configuramos la IA según tus reglas y tus casos de uso, nuestro equipo te acompaña
          y cada comentario se gestiona automáticamente, por mucho menos que la moderación manual.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Reservar una llamada
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Pruébalo gratis
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">O prueba un comentario ahora mismo, sin registro</a></p>
        <div class="animate-fade-in-up delay-2 mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-surface-500 lg:justify-start">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            Desarrollado y alojado en la UE
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Conforme al RGPD
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Soporte humano incluido
          </span>
        </div>
      </div>
      <HeroAnimation />
    </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Una moderación configurada para ti, no una herramienta que descifrar a solas</h2>
      </div>
      <ValueCards items={valueItems} />
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Reserva una llamada para verlo con tus comentarios</a>
      </div>
    </div>
  </section>

  <AppVideo />

  <section id="demo" class="bg-gradient-to-br from-violet-50 via-white to-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Problem / Solution -->
  <section class="bg-gradient-to-br from-rose-50 via-white to-sun-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-rose-500 px-3 py-1 text-xs font-semibold text-white shadow-sm">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-white" />
            El problema
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            Los comentarios de odio ahuyentan a tu comunidad.
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Los insultos, el spam y las estafas se acumulan bajo tus publicaciones, en todas las
            plataformas y todos los días. Los filtros nativos no detectan el sarcasmo, el lenguaje
            en clave ni nada que mezcle idiomas, y la limpieza manual se come más de 10 horas a la semana.
          </p>
          <p class="mt-4 text-lg text-surface-500">
            OpenModeration aplica tus reglas automáticamente en Facebook, Instagram, YouTube y
            WordPress, y muestra una explicación por escrito de cada comentario oculto.
          </p>
          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Antes:</strong> leer, clasificar y borrar a mano los comentarios de odio, en cada plataforma y todos los días.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Después:</strong> tus reglas se aplican automáticamente en Facebook, Instagram, YouTube y WordPress. Cada comentario oculto viene con su explicación por escrito.</p>
            </div>
          </div>
          <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
              Pruébalo gratis
            </a>
            <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
              Reservar una llamada
            </a>
          </div>
        </div>
        <BrowserFrame
          caption="Un comentario oculto, la regla que incumplió y la explicación por escrito: visible para tu equipo y defendible ante cualquiera."
        >
          <ModerationVerdict slot="content" />
          <div slot="annotation" class="absolute bottom-3 right-3 rounded-full border border-brand-200 bg-white/95 px-3 py-1 text-xs font-semibold text-brand-800 shadow-sm">
            &#x270D; La explicación por escrito
          </div>
        </BrowserFrame>
      </div>
    </div>
  </section>

  <!-- Beyond the API -->
  <section class="bg-white py-20 border-t border-surface-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          Una protección completa, más allá de los filtros
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          Los filtros de palabras clave no bastan. Necesitas que tus reglas se apliquen en todas partes, que los casos dudosos lleguen a tu equipo y que cada decisión quede explicada.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-rose-100 bg-rose-50/70 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Una simple API de moderación
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Puntuaciones en bruto, sin el contexto de la conversación</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Ninguna interfaz para que los moderadores revisen los casos dudosos</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Nada previsto para gestionar las denuncias de usuarios ni los roles del equipo</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> El cumplimiento normativo y los registros de auditoría corren por tu cuenta</li>
          </ul>
        </div>
        <div class="lift rounded-2xl border border-mint-100 bg-gradient-to-br from-mint-50 to-white p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            La plataforma completa de OpenModeration
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> La IA tiene en cuenta el contexto y los matices, en lugar de buscar palabras clave</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Tus moderadores revisan los casos dudosos en una interfaz pensada para ello</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Gestionas las denuncias, los roles y los permisos del equipo en el mismo sitio</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Cada decisión, humana o de la IA, queda registrada para las auditorías</li>
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/es/integraciones/moderacion-facebook" class="text-sm font-medium text-brand-600 hover:text-brand-500">Herramienta de moderación de comentarios en Facebook &rarr;</a>
        <a href="/es/integraciones/moderacion-instagram" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderación automática en Instagram &rarr;</a>
        <a href="/es/consola-de-moderacion" class="text-sm font-medium text-brand-600 hover:text-brand-500">Consola de moderación unificada &rarr;</a>
        <a href="/es/casos-de-uso/medios" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderación de comentarios para medios de comunicación &rarr;</a>
        <a href="/es/alternativas/openai-moderation" class="text-sm font-medium text-surface-500 hover:text-surface-700">Compara con las alternativas &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Full Pipeline -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          El proceso de moderación completo
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          OpenModeration se encarga de cada paso, desde que llega el comentario hasta la decisión final.
        </p>
      </div>
      <div class="grid gap-4 grid-cols-2 md:grid-cols-4">
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">1. Recoger</h3>
          <p class="mt-1 text-xs text-surface-500">El contenido llega por la API, las redes sociales o webhooks</p>
        </div>
        <div class="lift rounded-2xl bg-gradient-to-br from-brand-600 to-violet-600 p-6 text-center text-white shadow-lg [&_h3]:text-white [&_p]:text-white/85">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-white/20 text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">2. Analizar</h3>
          <p class="mt-1 text-xs text-surface-500">La IA revisa el contenido con varios proveedores</p>
        </div>
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">3. Decidir</h3>
          <p class="mt-1 text-xs text-surface-500">Las políticas aplican tus reglas automáticamente</p>
        </div>
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
