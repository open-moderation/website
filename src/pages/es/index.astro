---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';
import { getLocale } from '../../i18n/routes';
import CharterSupport from '../../components/CharterSupport.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const t = useTranslations(getLocale(Astro.url.pathname));

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "sameAs": [
        "https://github.com/open-moderation/open-moderation"
      ],
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "inLanguage": "es",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/#software",
      "name": "OpenModeration",
      "applicationCategory": "SecurityApplication",
      "operatingSystem": "Linux, Docker",
      "description": "Plataforma de moderación de código abierto para comentarios y redes sociales. Una API sobre varios proveedores de IA, reglas en lenguaje natural, una explicación por escrito de cada decisión y un registro de auditoría DSA.",
      "url": "https://www.openmoderation.com",
      "inLanguage": "es",
      "license": "https://github.com/open-moderation/open-moderation/blob/main/LICENSE",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Comentarios moderados al día", value: "10 M+" },
  { label: "Comentarios analizados", value: "100 %" },
  { label: "Protegido en", value: "5 min" },
  { label: "Decisiones explicadas por escrito", value: "100 %" },
];

const providerItems = [
  { name: 'OpenAI', subtitle: 'Moderation API' },
  { name: 'Azure', subtitle: 'AI Content Safety' },
  { name: 'HuggingFace', subtitle: 'Llama Guard' },
  { name: 'Mistral', subtitle: 'Moderation' },
  { name: 'Google', subtitle: 'Perspective API' },
  { name: 'Cohere', subtitle: 'Classify' },
  { name: 'Hive', subtitle: 'AI Moderation' },
  { name: 'OpenAI', subtitle: 'LLM (GPT-4o)' },
  { name: 'Anthropic', subtitle: 'LLM (Claude)' },
];


const faqItems = [
  {
    question: '¿Qué plataforma de moderación combina una consola para moderadores, IA que entiende el contexto y registros de auditoría para el cumplimiento normativo?',
    answer: 'OpenModeration reúne las tres cosas. Modelos de IA que entienden el contexto (OpenAI, Azure, Mistral y otros) puntúan cada comentario, tus reglas deciden qué se oculta, qué se publica y qué pasa a revisión, los moderadores trabajan desde una única consola y cada decisión queda registrada con una explicación por escrito para las auditorías de la DSA.',
  },
  {
    question: '¿Existe una herramienta sin código que permita escribir reglas de moderación, usar clasificación con IA y conservar un registro de auditoría?',
    answer: 'Sí. En OpenModeration escribes tus reglas en lenguaje natural y fijas umbrales por categoría sin programar. La clasificación con IA se aplica a cada comentario y el registro de actividad guarda cada acción, quién o qué la realizó y por qué.',
  },
  {
    question: '¿Puedo moderar Facebook, Instagram, YouTube y mi web desde un solo lugar?',
    answer: 'Sí. Conecta tus páginas de Facebook, tus cuentas de Instagram, tus canales de YouTube y tu sitio WordPress, o envía contenido desde cualquier plataforma a través de la API. Todo llega a la misma cola de revisión y se rige por las mismas reglas.',
  },
  {
    question: '¿Qué debe ofrecer una API de moderación para el cumplimiento normativo en una gran empresa?',
    answer: 'Busca una declaración de motivos por escrito para cada decisión (exigida por el artículo 17 de la DSA), un registro de auditoría completo, alojamiento de datos en la UE, un periodo de conservación configurable y la opción de autoalojamiento. OpenModeration cumple los cinco requisitos y es de código abierto bajo AGPL v3, así que su lógica de decisión se puede auditar.',
  },
  {
    question: '¿OpenModeration es gratis?',
    answer: 'El plan en la nube es gratuito hasta 1.000 solicitudes al mes, el plan Pro cuesta 99 € al mes por 10.000 solicitudes y la versión autoalojada es gratuita porque el código es abierto.',
  },
];
---

<BaseLayout
  title="Moderación de comentarios con IA para redes sociales | OpenModeration"
  description="OpenModeration oculta los comentarios de odio y el spam en tus redes sociales y en WordPress, según tus reglas y con cada decisión explicada. Empieza gratis."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-surface-50" />
    <div class="relative mx-auto max-w-7xl px-4 pb-12 pt-8 sm:px-6 lg:px-8 lg:pt-12">
      <div class="mx-auto max-w-3xl text-center">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Para Facebook • Instagram • YouTube. Sin código
        </div>
        <h1 class="animate-fade-in-up text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl lg:text-6xl">
          Tu comunidad, <em class="italic text-brand-800">protegida</em>.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-500 sm:text-xl">
          Los comentarios de odio y el spam ahuyentan a tu comunidad. OpenModeration los oculta
          automáticamente en tus redes sociales siguiendo tus reglas, y muestra una explicación
          por escrito de cada decisión.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Pruébalo gratis
          </a>
          <a href="/es/como-funciona" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Descubre cómo funciona
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400">Sin tarjeta de crédito</p>
        <div class="animate-fade-in-up delay-2 mt-2 flex items-center justify-center gap-6 text-xs text-surface-400">
          <span class="flex items-center gap-1.5">
            
            Desarrollado y alojado en la UE
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Conforme al RGPD
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            AGPL v3
          </span>
        </div>
      </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- Logo Marquee -->
  <section class="border-t border-surface-100 bg-white py-8">
    <p class="mb-4 text-center text-xs font-medium uppercase tracking-wider text-surface-400">Proveedores integrados</p>
    <LogoMarquee items={providerItems} speed="45s" />
  </section>

  <!-- Problem / Solution -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            El problema
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            Los comentarios de odio ahuyentan a tu comunidad.
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Los insultos, el spam y las estafas se acumulan bajo tus publicaciones, en todas las
            plataformas y todos los días. Los filtros nativos no detectan el sarcasmo, el lenguaje
            en clave ni nada que mezcle idiomas, y la limpieza manual se come más de 10 horas a la semana.
          </p>
          <p class="mt-4 text-lg text-surface-500">
            OpenModeration aplica tus reglas automáticamente en Facebook, Instagram, YouTube y
            WordPress, y muestra una explicación por escrito de cada comentario oculto.
          </p>
          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Antes:</strong> leer, clasificar y borrar a mano los comentarios de odio, en cada plataforma y todos los días.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Después:</strong> tus reglas se aplican automáticamente en Facebook, Instagram, YouTube y WordPress. Cada comentario oculto viene con su explicación por escrito.</p>
            </div>
          </div>
          <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
              Pruébalo gratis
            </a>
            <p class="text-sm text-surface-400">Sin tarjeta de crédito</p>
          </div>
        </div>
        <BrowserFrame
          caption="Un comentario oculto, la regla que incumplió y la explicación por escrito: visible para tu equipo y defendible ante cualquiera."
        >
          <ModerationVerdict slot="content" />
          <div slot="annotation" class="absolute bottom-3 right-3 rounded-full border border-brand-200 bg-white/95 px-3 py-1 text-xs font-semibold text-brand-800 shadow-sm">
            &#x270D; La explicación por escrito
          </div>
        </BrowserFrame>
      </div>
    </div>
  </section>

  <!-- Beyond the API -->
  <section class="bg-white py-20 border-t border-surface-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          Una protección completa, más allá de los filtros
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          Los filtros de palabras clave no bastan. Necesitas que tus reglas se apliquen en todas partes, que los casos dudosos lleguen a tu equipo y que cada decisión quede explicada.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Una simple API de moderación
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Puntuaciones en bruto, sin el contexto de la conversación</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Ninguna interfaz para que los moderadores revisen los casos dudosos</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Nada previsto para gestionar las denuncias de usuarios ni los roles del equipo</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> El cumplimiento normativo y los registros de auditoría corren por tu cuenta</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            La plataforma completa de OpenModeration
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> La IA tiene en cuenta el contexto y los matices, en lugar de buscar palabras clave</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Tus moderadores revisan los casos dudosos en una interfaz pensada para ello</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Gestionas las denuncias, los roles y los permisos del equipo en el mismo sitio</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Cada decisión, humana o de la IA, queda registrada para las auditorías</li>
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/es/integraciones/moderacion-facebook" class="text-sm font-medium text-brand-600 hover:text-brand-500">Herramienta de moderación de comentarios en Facebook &rarr;</a>
        <a href="/es/integraciones/moderacion-instagram" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderación automática en Instagram &rarr;</a>
        <a href="/es/consola-de-moderacion" class="text-sm font-medium text-brand-600 hover:text-brand-500">Consola de moderación unificada &rarr;</a>
        <a href="/es/casos-de-uso/medios" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderación de comentarios para medios de comunicación &rarr;</a>
        <a href="/es/alternativas/openai-moderation" class="text-sm font-medium text-surface-500 hover:text-surface-700">Compara con las alternativas &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Full Pipeline -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          El proceso de moderación completo
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          OpenModeration se encarga de cada paso, desde que llega el comentario hasta la decisión final.
        </p>
      </div>
      <div class="grid gap-4 grid-cols-2 md:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-5 text-center transition hover:shadow-md">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">1. Recoger</h3>
          <p class="mt-1 text-xs text-surface-500">El contenido llega por la API, las redes sociales o webhooks</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-5 text-center shadow-sm transition hover:shadow-md">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-600 text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">2. Analizar</h3>
          <p class="mt-1 text-xs text-surface-500">La IA revisa el contenido con varios proveedores</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-5 text-center transition hover:shadow-md">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">3. Decidir</h3>
          <p class="mt-1 text-xs text-surface-500">Las políticas aplican tus normas automáticamente</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-5 text-center transition hover:shadow-md">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">4. Revisar</h3>
          <p class="mt-1 text-xs text-surface-500">Los casos dudosos se envían a tu equipo</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark Contrast Section: DSA Compliance -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800 px-4 py-1.5 text-sm text-surface-300">
          <svg class="h-4 w-4 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Preparado para la DSA
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Diseñado para el cumplimiento normativo
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-surface-400">
          Cada decisión de moderación queda en un registro de auditoría completo. Tú eliges cuánto tiempo
          se conservan los datos, exportas los informes de transparencia y, si lo necesitas, alojas todo en tus servidores.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm">
            Pruébalo gratis
          </a>
          <a href="/es/cumplimiento-dsa" class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
            Todo sobre el cumplimiento de la DSA
          </a>
        </div>
        <p class="mt-4 text-sm text-surface-400">Sin tarjeta de crédito</p>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          Comparativa con otras plataformas
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          En qué se diferencia OpenModeration de Nima, Checkstep y Bodyguard.
        </p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Funcionalidad</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Nima</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Checkstep</th>
