---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModerationDemo from '../../components/ModerationDemo.astro';
import { bookingUrl, useTranslations } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import ValueCards from '../../components/ValueCards.astro';
import AppVideo from '../../components/AppVideo.astro';
import AIEngine from '../../components/AIEngine.astro';
import SwitchProvider from '../../components/SwitchProvider.astro';
import CostCalculator from '../../components/CostCalculator.astro';
import TeamSection from '../../components/TeamSection.astro';
import PricingTeaser from '../../components/PricingTeaser.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "description": "AI comment moderation adapted to each client's rules and use cases, with a team that sets it up. DSA-compliant, hosted in the EU.",
      "email": "contact@openmoderation.com",
      "areaServed": "EU",
      "knowsAbout": ["Comment moderation", "Content moderation", "Social media moderation", "Digital Services Act compliance", "Trust and safety"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "contact@openmoderation.com",
        "url": "https://www.openmoderation.com/book-a-call",
        "availableLanguage": ["English", "French", "Spanish", "German", "Italian"]
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "inLanguage": "es",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/#software",
      "name": "OpenModeration",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Moderación de comentarios con IA para medios, marcas y redes sociales, adaptada a tus reglas y casos de uso. Funciona en tu web, Facebook, Instagram, YouTube y WordPress, nuestro equipo se ocupa de los casos dudosos, explica cada decisión por escrito y te la muestra en tiempo real, y cumple la DSA. Solo conectas tus páginas, nosotros nos encargamos del resto.",
      "url": "https://www.openmoderation.com",
      "inLanguage": "es",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Comentarios moderados al día", value: "10 M+" },
  { label: "Listo en", value: "5 min" },
  { label: "Moderación automática", value: "24/7" },
  { label: "Decisiones explicadas por escrito", value: "100 %" },
];

const valueItems = [
  { title: "Tus reglas, tus casos de uso", text: "No es una lista de palabras: tus reglas, leídas en su contexto. Adaptamos la moderación a lo que te importa: ironía, política, competidores, jerga local. Nada genérico." },
  { title: "Un equipo detrás de la herramienta", text: "Te ayudamos a redactar y ajustar tus reglas, nos ocupamos nosotros de los casos dudosos y lo adaptamos a medida que cambia tu comunidad. Siempre tienes a alguien con quien hablar." },
  { title: "Todo funciona de forma automática", text: "Solo conectas tus páginas: cada comentario se gestiona en segundos, de día y de noche, y nuestro equipo se ocupa de los casos dudosos. No tienes que hacer nada, pero ves cada decisión en tiempo real y puedes intervenir cuando quieras." },
  { title: "Mucho más barato que hacerlo a mano", text: "La moderación automática cuesta una fracción de lo que cuesta un equipo de moderación externo o interno." },
];


const faqItems = [
  {
    question: "¿La IA modera sola?",
    answer: "No. Nuestra IA está configurada con tus reglas. Decide sola cuando está segura, y cada decisión se contrasta con otros modelos de IA. Cuando hay dudas, el comentario pasa a nuestro equipo, que decide y te informa de lo que ha gestionado.",
  },
  {
    question: "¿Cómo conoce la IA nuestra línea editorial?",
    answer: "Partimos de tus normas y de tus casos de uso: lo que aceptas, lo que rechazas, los casos límite. Cuando corriges una decisión, ajustamos las reglas contigo. No es una lista de palabras prohibidas: la IA lee cada comentario en su contexto.",
  },
  {
    question: "¿Puedo probarlo antes de comprometerme?",
    answer: "Sí. En modo de pruebas, OpenModeration analiza tus comentarios reales sin publicar ni ocultar nada. Ves lo que habríamos aceptado o rechazado, con el motivo, y lo comparas con tu moderación actual.",
  },
  {
    question: "¿Puedo probarlo sin dejar a mi proveedor actual?",
    answer: "Sí. El entorno de pruebas funciona en paralelo, sin tocar tu producción. Comparas decisión por decisión y eliges con conocimiento de causa, cuando mejor te venga.",
  },
  {
    question: "¿Qué veo por mi parte?",
    answer: "Todo, en tiempo real: cada comentario, la decisión tomada, el motivo por escrito y el historial. No tienes nada que hacer, pero puedes corregir una decisión o intervenir en cualquier momento.",
  },
  {
    question: "¿Por qué se rechazó un comentario?",
    answer: "Cada decisión lleva un motivo por escrito (insulto, ataque personal, spam…) que puedes transmitir al autor. Es más claro para tus lectores y más fácil de justificar si alguien lo impugna.",
  },
  {
    question: "¿OpenModeration ayuda a cumplir la DSA?",
    answer: "Está pensado para la DSA: un motivo por escrito para cada decisión, un historial trazable, las denuncias con seguimiento y las reclamaciones gestionadas. Tú sigues siendo el editor responsable, y tienes los elementos para justificar cada decisión.",
  },
  {
    question: "¿Qué pasa cuando la IA duda?",
    answer: "El comentario se aparta y nuestro equipo lo gestiona según tus reglas. Recibes un informe de los casos gestionados y de los puntos que conviene aclarar en tus normas.",
  },
  {
    question: "¿En qué plataformas funciona OpenModeration?",
    answer: "Tu web, Facebook, Instagram, YouTube y WordPress de forma nativa, con conectores listos que configuras en pocos minutos. TikTok, X, LinkedIn y otras redes se añaden fácilmente si lo pides.",
  },
  {
    question: "¿Dónde se alojan nuestros datos?",
    answer: "En la Unión Europea. Los comentarios solo se usan para moderar tus propios espacios.",
  },
  {
    question: "¿Hace falta movilizar a nuestro equipo técnico?",
    answer: "Muy poco. Para redes sociales y WordPress, basta con conectar tus cuentas. Para una web o una herramienta propia, una API te permite enviar tus comentarios y recibir cada decisión con su motivo.",
  },
  {
    question: "¿Cuánto cuesta?",
    answer: "El precio depende del volumen de comentarios que moderar. Te proponemos una tarifa previsible tras una prueba con tus propios comentarios, para que valores la calidad antes de hablar de presupuesto.",
  },
];
---

<BaseLayout
  title="Moderación de comentarios con IA, conforme a la DSA"
  description="Moderación de comentarios con IA adaptada a tus reglas y casos de uso, en tu web y redes sociales. Conforme a la DSA, alojada en la UE, con nuestro equipo."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-violet-50" />
    <div class="joy-blob pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-300/40 blur-3xl" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute -right-24 top-10 h-[28rem] w-[28rem] rounded-full bg-violet-300/40 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-sun-300/30 blur-3xl" style="animation-delay:-12s" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16">
      <div class="text-center lg:text-left">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Para medios, marcas y redes sociales
        </div>
        <h1 class="animate-fade-in-up text-4xl font-extrabold leading-[1.05] tracking-tight text-surface-900 sm:text-5xl lg:text-[3.7rem]">
          Una moderación que se adapta a <em>tus</em> reglas.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-600 sm:text-xl">
          Solo conectas tus páginas. Configuramos la IA según tus reglas y tus casos de uso, nuestro equipo se ocupa de los casos dudosos
          y tú ves cada decisión en tiempo real, por mucho menos que la moderación manual.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Reservar una llamada
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Pruébalo gratis
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">O prueba un comentario ahora mismo, sin registro</a></p>
        <div class="animate-fade-in-up delay-2 mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-surface-500 lg:justify-start">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            Desarrollado y alojado en la UE
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Conforme al RGPD
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Soporte humano incluido
          </span>
        </div>
      </div>
      <HeroAnimation />
    </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Una moderación configurada para ti, no una herramienta que descifrar a solas</h2>
      </div>
      <ValueCards items={valueItems} />
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Reserva una llamada para verlo con tus comentarios</a>
      </div>
    </div>
  </section>

  <AppVideo />

  <AIEngine />

  <SwitchProvider />

  <section id="demo" class="bg-gradient-to-br from-violet-50 via-white to-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Dark Contrast Section: DSA Compliance -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800 px-4 py-1.5 text-sm text-surface-300">
          <svg class="h-4 w-4 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Preparado para la DSA
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Diseñado para el cumplimiento normativo
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-surface-400">
          Cada decisión de moderación queda en un registro de auditoría completo. Tú eliges cuánto tiempo
          se conservan los datos, exportas los informes de transparencia y tus datos se quedan alojados en la UE.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm">
            Pruébalo gratis
          </a>
          <a href="/es/cumplimiento-dsa" class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
            Todo sobre el cumplimiento de la DSA
          </a>
        </div>
        <p class="mt-4 text-sm text-surface-400">Sin tarjeta de crédito</p>
      </div>
    </div>
  </section>

  <CostCalculator />

  <PricingTeaser />



  <TeamSection />

  <section class="bg-white pb-6 pt-2">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/es/integraciones/moderacion-facebook" class="text-sm font-medium text-brand-600 hover:text-brand-500">Herramienta de moderación de comentarios en Facebook &rarr;</a>
        <a href="/es/integraciones/moderacion-instagram" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderación automática en Instagram &rarr;</a>
        <a href="/es/consola-de-moderacion" class="text-sm font-medium text-brand-600 hover:text-brand-500">Consola de moderación unificada &rarr;</a>
        <a href="/es/casos-de-uso/medios" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderación de comentarios para medios de comunicación &rarr;</a>
        <a href="/es/alternativas/openai-moderation" class="text-sm font-medium text-surface-500 hover:text-surface-700">Compara con las alternativas &rarr;</a>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Lo que preguntan los equipos antes de elegir una plataforma de moderación" items={faqItems} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
