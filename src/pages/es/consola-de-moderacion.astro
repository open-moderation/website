---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'es';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Consola de moderación: cada decisión y su motivo, en directo",
  "description": "Cada comentario, su decisión y su motivo por escrito en tiempo real, en tu web y tus redes. Nuestro equipo gestiona los casos dudosos; tú corriges si quieres.",
  "crumb": "Consola de moderación",
  "badge": "Lo que ves en tiempo real",
  "h1": "Cada decisión y su motivo, en tiempo real",
  "lead": "La consola no es una herramienta que tengas que manejar. Nuestra IA y nuestro equipo moderan; tú ves cada comentario, la decisión, su motivo por escrito y quién la tomó, y puedes corregirla cuando quieras.",
  "feedTitle": "Tu moderación, en directo",
  "feedLead": "Los comentarios de tu web y de tus páginas, uno al lado del otro, cada uno con su decisión y el motivo que la justifica.",
  "quote": [
    "«",
    "»"
  ],
  "reasonLabel": "Motivo:",
  "overrideLabel": "Corregir",
  "feed": [
    {
      "platform": "Web",
      "kind": "published",
      "decision": "Publicado",
      "by": "Nuestra IA",
      "text": "Buen artículo, pero las cifras del segundo párrafo parecen desactualizadas.",
      "reason": "Crítica constructiva, ninguna regla incumplida."
    },
    {
      "platform": "Facebook",
      "kind": "refused",
      "decision": "Ocultado",
      "by": "Nuestra IA, contrastada",
      "text": "Sois todos unos corruptos, habría que callaros para siempre.",
      "reason": "Amenaza y ataque personal."
    },
    {
      "platform": "Instagram",
      "kind": "refused",
      "decision": "Ocultado",
      "by": "Nuestra IA",
      "text": "¡¡¡Seguidores baratos aquí, mirad mi perfil!!!",
      "reason": "Spam."
    },
    {
      "platform": "YouTube",
      "kind": "team",
      "decision": "Rechazado tras revisión",
      "by": "Nuestro equipo",
      "text": "Típico de esa gente, no cambiarán nunca.",
      "reason": "Generalización contra un grupo, contraria a tus normas."
    }
  ],
  "shotAlt": "Consola de OpenModeration: comentarios, decisiones y motivos por escrito, plataforma por plataforma",
  "shotCaption": "La consola: comentarios, decisiones y motivos, plataforma por plataforma.",
  "illustrative": "Ejemplos y cifras ilustrativos, de un espacio de demostración.",
  "kpis": [
    {
      "label": "Comentarios analizados hoy",
      "value": "84,2 k"
    },
    {
      "label": "Ocultados, cada uno con su motivo",
      "value": "4,7 %"
    },
    {
      "label": "Casos dudosos gestionados por nuestro equipo",
      "value": "2 %"
    }
  ],
  "cardsTitle": "Lo que ves y lo que puedes hacer",
  "cardsLead": "Transparencia total, nada que manejar. Solo intervienes si quieres.",
  "cards": [
    {
      "title": "Cada decisión, con su motivo",
      "text": "Cada comentario, la decisión tomada y su motivo por escrito, en tu web y en cada página conectada."
    },
    {
      "title": "Los casos dudosos, para nuestro equipo",
      "text": "Cuando la IA duda, nuestro equipo decide según tus reglas. Ves lo que ha gestionado y por qué."
    },
    {
      "title": "Corrige en cualquier momento",
      "text": "Publica, oculta o restablece un comentario con un clic. Cada cambio queda registrado con su autor."
    },
    {
      "title": "Denuncias y reclamaciones con seguimiento",
      "text": "Las denuncias de los usuarios y las decisiones impugnadas se siguen hasta la respuesta, como exige la DSA."
    },
    {
      "title": "Cifras exportables",
      "text": "Volúmenes y decisiones por categoría, plataforma por plataforma. Expórtalas para tus informes DSA y tus balances internos."
    },
    {
      "title": "Tus reglas, a la vista",
      "text": "Ve las reglas aplicadas a tus espacios. Para cambiarlas, dínoslo o ajústalas tú: nuestro equipo te ayuda."
    }
  ],
  "devTitle": "Para equipos técnicos",
  "devLead": "La consola también da a tus desarrolladores lo necesario para integrar y supervisar OpenModeration.",
  "devPoints": [
    "Claves de acceso, con límites de uso y permisos por clave",
    "Historial de actividad consultable por comentario: puntuaciones, regla aplicada y resultado",
    "Estado de los servicios, con latencia y tasa de errores",
    "Conservación de datos, orígenes autorizados y webhooks"
  ]
};

const decisionStyles: Record<string, string> = {
  published: 'bg-green-100 text-green-700',
  refused: 'bg-red-100 text-red-700',
  team: 'bg-amber-100 text-amber-700',
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/es/consola-de-moderacion",
  "url": "https://www.openmoderation.com/es/consola-de-moderacion",
  "name": "Consola de moderación: cada decisión y su motivo, en directo",
  "description": "Cada comentario, su decisión y su motivo por escrito en tiempo real, en tu web y tus redes. Nuestro equipo gestiona los casos dudosos; tú corriges si quieres.",
  "inLanguage": "es",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Inicio", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-accent-500"></span> {c.badge}
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- What you see: live feed -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.feedTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.feedLead}</p>
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <ul class="divide-y divide-surface-100 overflow-hidden rounded-2xl border border-surface-200 bg-white shadow-sm">
          {c.feed.map((f) => (
            <li class="p-5">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-surface-600">{f.platform}</span>
                <span class={`rounded-full px-2.5 py-0.5 font-semibold ${decisionStyles[f.kind]}`}>{f.decision}</span>
                <span class="text-surface-400">{f.by}</span>
              </div>
              <p class="mt-3 text-surface-800">{c.quote[0]}{f.text}{c.quote[1]}</p>
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
                <p class="text-surface-500"><span class="font-medium text-surface-700">{c.reasonLabel}</span> {f.reason}</p>
                <span class="rounded-md border border-surface-300 px-3 py-1 text-xs font-semibold text-surface-700">{c.overrideLabel}</span>
              </div>
            </li>
          ))}
        </ul>
        <div>
          <BrowserFrame src="/images/dashboard.png" video="om-triage" alt={c.shotAlt} caption={c.shotCaption} eager={false} />
          <p class="mt-6 text-center text-xs text-surface-400">{c.illustrative}</p>
        </div>
      </div>
      <dl class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {c.kpis.map((k) => (
          <div class="flex flex-col-reverse rounded-xl border border-surface-200 bg-surface-50 p-6">
            <dt class="mt-1 text-sm text-surface-500">{k.label}</dt>
            <dd class="text-3xl font-bold text-surface-900">{k.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- What you see and what you can do -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.cardsTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.cardsLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {c.cards.map((card) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{card.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.devTitle}</h2>
      <p class="mt-3 text-surface-500">{c.devLead}</p>
      <ul class="mt-6 space-y-2 text-sm text-surface-600">
        {c.devPoints.map((p) => (
          <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
