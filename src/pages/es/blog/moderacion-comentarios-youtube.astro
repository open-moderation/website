  { need: "Entender la ironía, el contexto y el lenguaje en clave", builtin: "En parte: el filtro de YouTube es genérico y no se puede ajustar", tool: "Sí, cada comentario se lee en su contexto" },
  { need: "Aplicar reglas propias de tu canal", builtin: "No, solo palabras, enlaces y un nivel de rigor", tool: "Sí, tus reglas y tus casos de uso en lenguaje natural" },
