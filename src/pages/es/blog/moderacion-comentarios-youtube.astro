  { level: "Retención más estricta", effect: "YouTube retiene un abanico más amplio: frena más spam e insultos, pero también más comentarios legítimos.", fit: "Canales que atraen trolls o sufren un ataque coordinado" },
  { level: "Retener todos los comentarios", effect: "No se publica nada sin aprobación manual.", fit: "Vídeos delicados, periodos cortos, poco volumen" },
