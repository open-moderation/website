const title = "Moderación de comentarios en YouTube: guía práctica";
const description = "Cómo moderar comentarios en YouTube: retenidos para revisión, palabras y enlaces bloqueados, usuarios aprobados y ocultos, chat en vivo y automatización.";

const articleJsonLd = {
