        <li><a href="/es/como-funciona" class="font-medium text-brand-600 hover:text-brand-500">Cómo funciona la cadena de moderación &rarr;</a></li>
        <li><a href="/es/funcionalidades" class="font-medium text-brand-600 hover:text-brand-500">Una IA que sigue el progreso del mercado &rarr;</a></li>
      </ul>
    </div>
  </section>

  <GuideComparisons />

  <CTASection />
</BaseLayout>
