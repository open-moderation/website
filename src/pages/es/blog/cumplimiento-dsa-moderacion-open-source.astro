<BaseLayout title="Cumplimiento de la DSA con moderación open source" description="Cómo cumplir la Ley de Servicios Digitales (DSA) con herramientas open source: registro de auditoría, informes de transparencia y soberanía de los datos." jsonLd={articleJsonLd}>
<Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Blog", href: "/es/blog" }, { label: "Cumplimiento de la DSA con open source" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
