---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.openmoderation.com/es/blog",
  "url": "https://www.openmoderation.com/es/blog",
  "name": "Blog de moderación de contenido: DSA, seguridad de la IA y guías técnicas",
  "description": "Artículos sobre moderación de contenido, cumplimiento de la DSA, seguridad de la IA y guías técnicas.",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const posts = [
  {
    title: "Moderación de comentarios: guía completa (2026)",
    description: "Cómo moderar comentarios: métodos comparados, qué deben cubrir tus normas, zonas grises, la DSA, cómo elegir un software de moderación y 10 buenas prácticas.",
    href: "/es/blog/moderacion-de-comentarios-guia",
    date: "2026-10-30",
    readTime: "15 min",
    tags: ["guide"],
  },
  {
    title: "Ocultar comentarios de Facebook automáticamente (2026)",
    description: "Cómo ocultar comentarios automáticamente en tu página de Facebook: ocultar, eliminar o bloquear, los filtros nativos, sus límites y qué herramienta elegir.",
    href: "/es/blog/ocultar-comentarios-facebook-automaticamente",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guide"],
  },
  {
    title: "Moderación de comentarios en Instagram y palabras ocultas",
    description: "Cómo moderar comentarios en Instagram: palabras ocultas, límites y restringir, sus carencias y qué necesitas para conectar una herramienta de moderación.",
    href: "/es/blog/moderacion-comentarios-instagram",
    date: "2026-10-30",
    readTime: "11 min",
    tags: ["guide"],
  },
  {
    title: "Moderación de comentarios en TikTok: filtros y consejos",
    description: "Cómo moderar comentarios en TikTok: filtros, palabras clave filtradas, aprobación manual, moderadores en LIVE, límites para marcas y qué hacer en una crisis.",
    href: "/es/blog/moderacion-comentarios-tiktok",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guide"],
  },
  {
    title: "Moderación de redes sociales: guía completa (2026)",
    description: "Cómo moderar redes sociales: métodos, normas, claves de Facebook, Instagram, YouTube, TikTok, LinkedIn y X, equipo, crisis, métricas y herramientas.",
    href: "/es/blog/moderacion-redes-sociales-guia",
    date: "2026-10-30",
    readTime: "15 min",
    tags: ["guide"],
  },
  {
    title: "Moderación de comentarios en YouTube: guía práctica",
    description: "Cómo moderar comentarios en YouTube: retenidos para revisión, palabras y enlaces bloqueados, usuarios aprobados y ocultos, chat en vivo y automatización.",
    href: "/es/blog/moderacion-comentarios-youtube",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guide"],
  },
  {
    title: "Cómo gestionar comentarios negativos y trolls: guía",
    description: "Cómo gestionar comentarios negativos y trolls: crítica o abuso, cuándo responder, ocultar, borrar o bloquear, plantillas, ataques masivos, crisis y equipo.",
    href: "/es/blog/gestionar-comentarios-negativos-trolls",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guide"],
  },
  {
    title: "Qué es la moderación de contenido: definición y tipos",
    description: "Qué es la moderación de contenido: qué se modera, los 6 tipos, el trabajo del moderador de contenido, cómo funciona la IA, la DSA y cómo elegir tu enfoque.",
    href: "/es/blog/que-es-moderacion-de-contenido",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guide"],
  },
  {
    title: "API de OpenAI Moderation: omni-moderation-latest, categorías, precio y límites",
    description: "Qué detecta la API de OpenAI Moderation, las 13 categorías, el formato de respuesta, si es gratis y qué te deja por construir.",
    href: "/es/blog/guia-api-openai-moderation",
    date: "2026-10-20",
    readTime: "6 min",
    tags: ["openai", "API", "guía"],
  },
  {
    title: "Cumplimiento de la DSA para plataformas pequeñas y medianas: guía práctica",
    description: "Pasos prácticos para que las plataformas pequeñas y medianas cumplan los requisitos de la DSA con herramientas sencillas.",
    href: "/es/blog/guia-dsa-pymes",
    date: "2026-06-16",
    readTime: "8 min",
    tags: ["DSA", "cumplimiento", "guía"],
  },
  {
    title: "Construir o comprar: el coste de la infraestructura de moderación en 2026",
    description: "El coste real de desarrollar tu propia moderación frente a usar OpenModeration. Analizamos el tiempo de ingeniería, el mantenimiento y los costes ocultos.",
    href: "/es/blog/moderacion-construir-o-comprar",
    date: "2026-06-14",
    readTime: "9 min",
    tags: ["comparativa", "construir o comprar"],
  },
  {
    title: "Cierre de Google Perspective API: guía de migración para foros",
    description: "Google cerrará Perspective API a finales de 2026. Cómo migrar tu foro o tu comunidad a otra solución de moderación.",
    href: "/es/blog/migracion-perspective-api",
    date: "2026-06-12",
    readTime: "7 min",
    tags: ["perspective", "migración", "guía"],
  },
  {
    title: "OpenAI Moderation, Azure o Llama Guard: comparativa 2026",
    description: "Una comparativa objetiva de los principales proveedores de moderación con IA: rendimiento, precios, cobertura de idiomas y cuándo conviene usar cada uno.",
    href: "/es/blog/comparativa-openai-azure-llama-guard",
    date: "2026-06-10",
    readTime: "8 min",
    tags: ["comparativa", "proveedores"],
  },
  {
    title: "Cumplir la DSA de forma sencilla en la moderación de comentarios",
    description: "Cómo cumplir la Ley de Servicios Digitales (DSA): decisiones explicadas por escrito, registro de auditoría, informes de transparencia y datos en la UE.",
    href: "/es/blog/cumplimiento-dsa-moderacion-open-source",
    date: "2026-06-08",
    readTime: "6 min",
    tags: ["DSA", "cumplimiento", "transparencia"],
  },
  {
    title: "Moderación de contenido para aplicaciones de IA: guía para desarrolladores",
    description: "Cómo filtrar las entradas y salidas de una aplicación basada en LLM. Buenas prácticas para prevenir la inyección de prompts y garantizar la seguridad del contenido.",
    href: "/es/blog/guia-moderacion-contenido-ia-desarrolladores",
    date: "2026-06-05",
    readTime: "10 min",
    tags: ["IA", "LLM", "guía"],
  },
  {
    title: "Presentamos OpenModeration, la plataforma de moderación unificada",
    description: "Una plataforma de moderación con su propia IA, arbitrada por otros modelos en los casos delicados, decisiones explicadas por escrito y datos en la UE.",
    href: "/es/blog/presentamos-openmoderation",
    date: "2026-06-01",
    readTime: "5 min",
    tags: ["anuncio", "producto"],
  },
];
---

<BaseLayout title="Blog de moderación de contenido: DSA, IA y guías técnicas" description="Artículos sobre moderación de contenido, cumplimiento de la DSA, seguridad de la IA y guías técnicas." jsonLd={blogJsonLd}>
<Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Blog" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Análisis y guías sobre moderación de contenido, seguridad de la IA, cumplimiento de la DSA y transparencia de las decisiones.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8">
        {posts.map((post) => (
          <a href={post.href} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
            <div class="flex items-center gap-3 text-xs text-surface-400">
              <time datetime={post.date}>{new Date(post.date + "T00:00:00").toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })}</time>
              <span>&middot;</span>
              <span>{post.readTime} de lectura</span>
              <span>&middot;</span>
              {post.tags.map((tag) => (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-500">{tag}</span>
              ))}
            </div>
            <h2 class="mt-3 text-xl font-bold text-surface-900 group-hover:text-brand-600">{post.title}</h2>
            <p class="mt-2 text-sm text-surface-500">{post.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-medium text-brand-600">
              Leer más
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
