---
import { bookingUrl } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Herramienta de moderación de comentarios en Facebook: oculta los comentarios tóxicos automáticamente (2026, sin código)",
  "description": "Oculta automáticamente con IA los comentarios tóxicos de tu página de Facebook. Reglas sin código, más de 120 idiomas, ocultación o eliminación inmediata vía Graph API. Empieza gratis, registro de auditoría DSA incluido.",
  "inLanguage": "es"
};

const faqItems = [
  {
    question: "¿Cómo funciona la moderación de comentarios en Facebook?",
    answer: "Conecta tu página de Facebook a través de la Graph API. Los comentarios se recogen automáticamente y la IA los analiza. Según tus reglas, los comentarios tóxicos se ocultan o se eliminan sin que nadie tenga que revisarlos a mano."
  },
  {
    question: "¿Tengo que programar para configurarlo?",
    answer: "No. Conectas tu página de Facebook desde la consola, defines tus reglas en lenguaje natural o con interruptores y en pocos minutos está funcionando."
  },
  {
    question: "¿Qué tipos de contenido de Facebook se pueden moderar?",
    answer: "Los comentarios, las respuestas y las publicaciones de tu página de Facebook. La plataforma detecta discursos de odio, acoso, spam, contenido NSFW, datos personales, estafas y otras categorías en más de 120 idiomas."
  },
  {
    question: "¿Cuánto cuesta la moderación de comentarios en Facebook?",
    answer: "La nube gestionada de OpenModeration tiene un plan gratuito de hasta 1000 solicitudes al mes y un plan Pro a 99 € al mes, sin costes ocultos."
  },
  {
    question: "¿Cuánto se tarda en configurarlo?",
    answer: "Unos minutos. Conectas tu página de Facebook, escribes tus reglas en lenguaje natural y la moderación automática arranca el mismo día, sin código ni desarrollador."
  },
  {
    question: "¿Queda registrada cada decisión de moderación para las auditorías de la DSA?",
    answer: "Sí. Cada comentario oculto, eliminado o señalado conserva su regla, sus puntuaciones de IA y su explicación por escrito en un registro de auditoría completo. Expórtalo con un clic para tus informes de transparencia de la DSA."
  },
];
---

<BaseLayout title="Moderación de comentarios en Facebook con IA, sin código (2026)" description="Oculta automáticamente los comentarios tóxicos de Facebook. Reglas sin código, más de 120 idiomas y acción inmediata vía Graph API. Cada decisión explicada." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Integraciones", href: "/es/integraciones" }, { label: "Moderación en Facebook" }]} />
  <section class="bg-gradient-to-b from-blue-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-blue-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderación de comentarios en Facebook</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        La IA oculta los comentarios tóxicos de tu página de Facebook según tus reglas. Se configura en minutos y sin código.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Pruébalo gratis</a>
        <a href="/es/como-funciona" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Cómo funciona</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderar Facebook en 3 pasos</h2>
        <p class="mt-4 text-lg text-surface-500">En unos minutos y sin equipo técnico.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Crea tu cuenta</h3>
          <p class="mt-2 text-sm text-surface-500">Regístrate gratis en OpenModeration, sin tarjeta de crédito ni compromiso.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Conecta tu página de Facebook</h3>
          <p class="mt-2 text-sm text-surface-500">Vincula tu página de Facebook con tus propias credenciales. El conector recoge los comentarios y publicaciones automáticamente.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Define tus reglas</h3>
          <p class="mt-2 text-sm text-surface-500">Escribe tus reglas en lenguaje natural. La IA las aplica sola y oculta, elimina o señala cada comentario según corresponda.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Qué puedes detectar</h2>
        <p class="mt-4 text-lg text-surface-500">Más de 20 modelos de detección predefinidos, entrenados con miles de millones de etiquetas.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicidad</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discurso de odio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Acoso</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Estafas y phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Datos personales</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Autolesiones</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Lenguaje soez</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentimiento</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temas sensibles</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Enlaces de riesgo</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por qué es la forma más sencilla de moderar Facebook</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sin necesidad de programar</h3>
          <p class="mt-2 text-sm text-surface-500">Todo se configura desde la consola. Conectas tu página, escribes tus reglas en lenguaje natural y la IA las aplica.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Tus credenciales, bajo tu control</h3>
          <p class="mt-2 text-sm text-surface-500">Usa tu propio token de acceso de la página de Facebook. Nunca guardamos credenciales en texto plano y siguen siendo tuyas.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aplicación automática en Facebook</h3>
          <p class="mt-2 text-sm text-surface-500">Oculta o elimina los comentarios infractores directamente a través de la Graph API de Facebook, sin pasar por una cola de moderación manual.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Más de 120 idiomas</h3>
          <p class="mt-2 text-sm text-surface-500">Modera comentarios en cualquier idioma que hable tu comunidad. Nuestra propia IA, arbitrada por otros modelos en los casos delicados, aplica tus reglas en cada idioma.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Reglas propias en lenguaje natural</h3>
          <p class="mt-2 text-sm text-surface-500">Redacta tus reglas de moderación como se las explicarías a un compañero, sin prompts elaborados ni expresiones regulares.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Alojado en la UE, auditable</h3>
          <p class="mt-2 text-sm text-surface-500">Tus datos se alojan en la UE y puedes exportarlos cuando quieras. Cada decisión queda en un registro de auditoría completo. ¿On-premise? Posible bajo petición: <a href={bookingUrl('es')} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:text-brand-500">hablemos</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Preguntas frecuentes sobre la moderación en Facebook" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
