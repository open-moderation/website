---
import { bookingUrl } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Moderación de comentarios en WordPress: aprueba, retiene o marca como spam con IA (2026, sin código)",
  "description": "Modera automáticamente con IA los comentarios de WordPress. Conecta tu sitio con una contraseña de aplicación, sin desarrollar plugins y sin código. Aprueba, retiene o marca como spam los comentarios infractores, con registro de auditoría DSA incluido.",
  "inLanguage": "es"
};

const faqItems = [
  {
    question: "¿Cómo funciona la moderación de comentarios en WordPress?",
    answer: "Conecta tu sitio WordPress con una contraseña de aplicación. Los comentarios se recogen automáticamente desde la API REST de WordPress y la IA los analiza. Según tus reglas, cada comentario se aprueba, se retiene para revisión o se marca como spam, sin pasar por una cola manual."
  },
  {
    question: "¿Tengo que programar para configurarlo?",
    answer: "No. Crea una contraseña de aplicación en el escritorio de WordPress (Usuarios → Perfil) e introduce la URL de tu sitio, tu nombre de usuario y la contraseña en la consola de OpenModeration. Tu sitio se verifica en segundos y la moderación se pone en marcha."
  },
  {
    question: "¿Qué tipos de contenido de WordPress se pueden moderar?",
    answer: "Las entradas del blog y los comentarios de tu sitio WordPress. La plataforma detecta discursos de odio, acoso, spam, contenido NSFW, datos personales, estafas y otras categorías, y cada comentario se analiza en su propio idioma."
  },
  {
    question: "¿Qué ocurre con un comentario infractor en mi sitio WordPress?",
    answer: "Según tus reglas de moderación, el comentario pasa a aprobado, queda retenido para moderación o se marca como spam directamente a través de la API REST de WordPress. Cada acción queda registrada con su regla, sus puntuaciones de IA y una explicación por escrito."
  },
  {
    question: "¿Qué permisos necesita mi usuario de WordPress?",
    answer: "Tu usuario de WordPress necesita permisos para moderar comentarios, es decir, el rol de administrador o de editor. El conector lo comprueba al conectar tu sitio."
  },
  {
    question: "¿Queda registrada cada decisión de moderación para las auditorías de la DSA?",
    answer: "Sí. Cada comentario aprobado, retenido o marcado como spam conserva su regla, sus puntuaciones de IA y su explicación por escrito en un registro de auditoría completo. Expórtalo con un clic para tus informes de transparencia de la DSA."
  },
];
---

<BaseLayout title="Moderación de comentarios en WordPress con IA, sin código (2026)" description="Modera con IA los comentarios de WordPress. Conecta tu sitio con una contraseña de aplicación, sin código: aprueba, retiene o marca spam, con auditoría DSA." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Integraciones", href: "/es/integraciones" }, { label: "Moderación en WordPress" }]} />
  <section class="bg-gradient-to-b from-sky-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.026-.78-.07-1.11m-7.981.105c.647-.03 1.232-.105 1.232-.105.582-.075.514-.93-.067-.899 0 0-1.755.135-2.88.135-1.064 0-2.85-.15-2.85-.15-.585-.03-.661.855-.075.885 0 0 .54.061 1.125.09l1.68 4.605-2.37 7.08L5.354 6.9c.649-.03 1.234-.1 1.234-.1.585-.075.516-.93-.065-.896 0 0-1.746.138-2.874.138-.2 0-.438-.008-.69-.015C4.911 3.15 8.235 1.215 12 1.215c2.809 0 5.365 1.072 7.286 2.833-.046-.003-.091-.009-.141-.009-1.06 0-1.812.923-1.812 1.914 0 .89.513 1.643 1.06 2.531.411.72.89 1.643.89 2.977 0 .915-.354 1.994-.821 3.479l-1.075 3.585-3.9-11.61.001.014zM12 22.784c-1.059 0-2.081-.153-3.048-.437l3.237-9.406 3.315 9.087c.024.053.05.101.078.149-1.12.393-2.325.609-3.582.609M1.211 12c0-1.564.336-3.05.935-4.39L7.29 21.709C3.694 19.96 1.212 16.271 1.211 12M12 0C5.385 0 0 5.385 0 12s5.385 12 12 12 12-5.385 12-12S18.615 0 12 0"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderación de comentarios en WordPress</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        La IA modera los comentarios de tu sitio WordPress según tus reglas. Lo conectas con una contraseña de aplicación y lo configuras en minutos, sin código.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/es/reservar-llamada" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Reservar una llamada</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Pruébalo gratis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderar WordPress en 3 pasos</h2>
        <p class="mt-4 text-lg text-surface-500">En unos minutos y sin equipo técnico.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Crea tu cuenta</h3>
          <p class="mt-2 text-sm text-surface-500">Regístrate gratis en OpenModeration, sin tarjeta de crédito ni compromiso.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Conecta tu sitio WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Crea una contraseña de aplicación en el escritorio de WordPress e introduce la URL de tu sitio, tu nombre de usuario y la contraseña. Tu sitio se verifica automáticamente (necesitas el rol de administrador o de editor).</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Fijamos tus reglas contigo</h3>
          <p class="mt-2 text-sm text-surface-500">Definimos juntos tus reglas en lenguaje natural. La IA aprueba o marca como spam los casos claros y nuestro equipo se ocupa de los casos dudosos; tú ves cada decisión y su motivo en tiempo real.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Qué puedes detectar</h2>
        <p class="mt-4 text-lg text-surface-500">Más de 20 modelos de detección predefinidos, entrenados con miles de millones de etiquetas.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicidad</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discurso de odio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Acoso</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Estafas y phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Datos personales</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Autolesiones</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Lenguaje soez</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentimiento</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temas sensibles</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Enlaces de riesgo</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por qué es la forma más sencilla de moderar WordPress</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sin necesidad de programar</h3>
          <p class="mt-2 text-sm text-surface-500">Todo se configura desde la consola. Generas una contraseña de aplicación, conectas tu sitio, escribes tus reglas en lenguaje natural y la IA las aplica.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Tus credenciales, bajo tu control</h3>
          <p class="mt-2 text-sm text-surface-500">Conéctate con tu propia contraseña de aplicación. Las credenciales se cifran, nunca se almacenan en texto plano y puedes revocar el acceso cuando quieras desde el escritorio de WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aplicación automática en WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Cada comentario se aprueba, se retiene para revisión o se marca como spam directamente a través de la API REST de WordPress, sin pasar por una cola de moderación manual.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Multilingüe, incluidos los idiomas de tu audiencia</h3>
          <p class="mt-2 text-sm text-surface-500">Modera comentarios en cualquier idioma que usen tus lectores. Nuestra propia IA, arbitrada por otros modelos en los casos delicados, aplica tus reglas en cada idioma.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Reglas propias en lenguaje natural</h3>
          <p class="mt-2 text-sm text-surface-500">Redacta tus reglas de moderación como se las explicarías a un compañero, sin prompts elaborados ni expresiones regulares.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Alojado en la UE, auditable</h3>
          <p class="mt-2 text-sm text-surface-500">Tus datos se alojan en la UE y puedes exportarlos cuando quieras. Cada decisión queda en un registro de auditoría completo. ¿On-premise? Posible bajo petición: <a href={bookingUrl('es')} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:text-brand-500">hablemos</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Preguntas frecuentes sobre la moderación en WordPress" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
