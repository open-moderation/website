---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Plataforma de moderación de comentarios en YouTube | OpenModeration",
  "description": "Modera con IA los comentarios de YouTube a gran escala. Cada comentario se publica, se retiene para revisión o se rechaza de forma automática, según tus reglas.",
  "inLanguage": "es"
};

const faqItems = [
  {
    question: "¿Cómo funciona la moderación de comentarios en YouTube?",
    answer: "Conecta tu canal de YouTube a través de la YouTube Data API. Los comentarios se recogen y la IA los analiza. Según tus reglas, cada comentario se publica, se retiene para revisión o se rechaza."
  },
  {
    question: "¿Es fácil de configurar?",
    answer: "Sí. Todo se configura desde la consola. Conectas tu canal de YouTube, defines tus reglas con interruptores y en lenguaje natural, y la moderación empieza de inmediato."
  },
  {
    question: "¿Qué detecta la moderación de YouTube?",
    answer: "Discursos de odio, acoso, spam, contenido NSFW, datos personales, estafas, phishing, lenguaje soez, autolesiones, sentimiento, temas sensibles y enlaces de riesgo. Más de 20 modelos en más de 120 idiomas."
  },
  {
    question: "¿Necesito conocimientos técnicos para usarlo?",
    answer: "No. OpenModeration está pensado para creadores y community managers. Las reglas se escriben en lenguaje natural desde la consola, sin programar."
  },
  {
    question: "¿Puedo revisar los comentarios señalados antes de retirarlos?",
    answer: "Sí. Los casos dudosos pueden enviarse a una cola de revisión manual donde tu equipo los aprueba o los rechaza. Cada acción queda registrada."
  },
];
---

<BaseLayout title="Moderación de comentarios en YouTube con IA | OpenModeration" description="Modera con IA los comentarios de YouTube: rechaza los tóxicos, retén los dudosos para revisión, más de 120 idiomas. Pensado para creadores y marcas." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Inicio", href: "/es" }, { label: "Integraciones", href: "/es/integraciones" }, { label: "Moderación en YouTube" }]} />
  <section class="bg-gradient-to-b from-red-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 text-red-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderación de comentarios en YouTube</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        La IA modera los comentarios de tu canal de YouTube según tus reglas. Sin código y lista en pocos minutos.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Pruébalo gratis</a>
        <a href="/es/como-funciona" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Cómo funciona</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderar YouTube en 3 pasos</h2>
        <p class="mt-4 text-lg text-surface-500">En unos minutos y sin desarrollo.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Crea tu cuenta</h3>
          <p class="mt-2 text-sm text-surface-500">Regístrate gratis, sin tarjeta de crédito. Elige el despliegue en la nube o el autoalojamiento.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Conecta YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Vincula tu canal de YouTube con tus propias credenciales de la Data API. El conector recoge los comentarios automáticamente.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Define tus reglas</h3>
          <p class="mt-2 text-sm text-surface-500">Escribe tus reglas en lenguaje natural. La IA rechaza los comentarios tóxicos y retiene automáticamente los casos dudosos para revisión.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Lo que la IA detecta en tus comentarios</h2>
        <p class="mt-4 text-lg text-surface-500">Más de 20 modelos de detección predefinidos, entrenados con miles de millones de etiquetas.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicidad</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Discurso de odio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Acoso</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Estafas y phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Datos personales</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Autolesiones</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Lenguaje soez</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentimiento</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temas sensibles</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Enlaces de riesgo</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Por qué es la forma más sencilla de moderar YouTube</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sin programar</h3>
          <p class="mt-2 text-sm text-surface-500">Todo se configura desde la consola, sin tocar la API ni dedicar horas de desarrollo.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Acciones nativas de YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Publica, retén para revisión o rechaza comentarios directamente a través de la YouTube Data API. Son las mismas acciones que en YouTube Studio, pero automáticas.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Para cualquier volumen</h3>
          <p class="mt-2 text-sm text-surface-500">De 100 comentarios al día a 100.000, OpenModeration acompaña el crecimiento de tu canal.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Más de 120 idiomas</h3>
          <p class="mt-2 text-sm text-surface-500">Si tu audiencia comenta en varios idiomas, la misma plataforma detecta la toxicidad en todos ellos.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Reglas propias en lenguaje natural</h3>
          <p class="mt-2 text-sm text-surface-500">Escribe tus reglas de moderación en lenguaje natural. La IA tiene en cuenta la intención de cada comentario, además de las palabras.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Auditable y transparente</h3>
          <p class="mt-2 text-sm text-surface-500">Cada decisión de moderación queda registrada con su contexto. El código es abierto y puedes autoalojarlo para conservar el control de tus datos.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Preguntas frecuentes sobre la moderación en YouTube" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
