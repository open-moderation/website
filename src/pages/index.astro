---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModerationDemo from '../components/ModerationDemo.astro';
import { BOOKING_URL, useTranslations } from '../i18n/ui';
import { getLocale, localizePath } from '../i18n/routes';
import CharterSupport from '../components/CharterSupport.astro';
import CTASection from '../components/CTASection.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import ModerationVerdict from '../components/ModerationVerdict.astro';
import KpiBand from '../components/KpiBand.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import ValueCards from '../components/ValueCards.astro';
import AppVideo from '../components/AppVideo.astro';
import CostCalculator from '../components/CostCalculator.astro';
import ClientLogos from '../components/ClientLogos.astro';
import FAQ from '../components/FAQ.astro';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "description": "AI comment moderation adapted to each client's rules and use cases, with a team that sets it up. DSA-compliant, hosted in the EU.",
      "email": "contact@openmoderation.com",
      "areaServed": "EU",
      "knowsAbout": ["Comment moderation", "Content moderation", "Social media moderation", "Digital Services Act compliance", "Trust and safety"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "contact@openmoderation.com",
        "url": "https://www.openmoderation.com/book-a-call",
        "availableLanguage": ["English", "French", "Spanish", "German", "Italian"]
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/#software",
      "name": "OpenModeration",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "AI comment moderation for news sites, brands and social pages, adapted to your rules and use cases. Works on your website, Facebook, Instagram, YouTube and WordPress, sends doubtful cases to your team, explains every decision in writing and is DSA-compliant, with a team to set it up with you.",
      "url": "https://www.openmoderation.com",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Comments moderated every day", value: "10M+" },
  { label: "Ready in", value: "5 min" },
  { label: "Automatic moderation", value: "24/7" },
  { label: "Decisions explained in writing", value: "100%" },
];

const valueItems = [
  { title: "Your rules, your use cases", text: "We adapt the moderation to your rules and to what matters in your context: irony, politics, competitors, local slang. Nothing generic." },
  { title: "A team behind the tool", text: "We help you write and tune your rules, look at doubtful cases with you and adjust as your community changes. You always have someone to talk to." },
  { title: "Everything runs automatically", text: "Once the rules are set, every comment is handled within seconds, day and night. Your team only sees the cases that need a human." },
  { title: "Far cheaper than doing it by hand", text: "Automatic moderation costs a fraction of an outsourced or in-house moderation team." },
];


const faqItems = [
  {
    question: 'Which moderation platform combines a moderator dashboard, context-aware AI and audit logs for compliance?',
    answer: 'OpenModeration brings the three together. Context-aware AI reads each comment, your rules decide what is hidden, published or sent to review, moderators work from one dashboard, and every decision is logged with a written reason for DSA audits.',
  },
  {
    question: 'Is there a no-code tool that lets me write moderation rules, use AI classification and keep an audit trail?',
    answer: 'Yes. In OpenModeration you write your rules in plain language and set thresholds per category without code. AI classification runs on every comment, and the activity log records each action, who or what took it, and why.',
  },
  {
    question: 'Can I moderate Facebook, Instagram, YouTube and my website from one place?',
    answer: 'Yes. Connect your Facebook Pages, Instagram accounts, YouTube channels and WordPress site, or send content from any platform through the API. All of it lands in the same review queue with the same rules.',
  },
  {
    question: 'What should I look for in a moderation API for enterprise compliance?',
    answer: 'Look for a written statement of reasons for each decision (required by Article 17 of the DSA), a complete audit log, EU data hosting, configurable retention and exportable reports. OpenModeration covers all five, and our team sets the rules up with you.',
  },
  {
    question: 'Is OpenModeration free?',
    answer: 'The cloud plan is free up to 1,000 requests a month, the Pro plan costs €99 a month for 10,000 requests. For large volumes or an on-premise deployment, book a call and we size the offer with you.',
  },
];
---

<BaseLayout
  title="AI Comment Moderation, DSA-Compliant | OpenModeration"
  description="AI comment moderation that adapts to your rules and use cases, on your site and social pages. DSA-compliant, hosted in the EU, with a team at your side."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-violet-50" />
    <div class="joy-blob pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-300/40 blur-3xl" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute -right-24 top-10 h-[28rem] w-[28rem] rounded-full bg-violet-300/40 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-sun-300/30 blur-3xl" style="animation-delay:-12s" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16">
      <div class="text-center lg:text-left">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          For news sites, brands and social pages
        </div>
        <h1 class="animate-fade-in-up text-4xl font-extrabold leading-[1.05] tracking-tight text-surface-900 sm:text-5xl lg:text-[3.7rem]">
          Moderation that adapts to <em>your</em> rules.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-600 sm:text-xl">
          We set the AI up around your rules and your use cases, our team stays with you,
          and every comment is handled automatically, for far less than manual moderation.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Book a call
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Try it for free
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">Or test a comment right now, no sign-up</a></p>
        <div class="animate-fade-in-up delay-2 mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-surface-500 lg:justify-start">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            Made and hosted in the EU
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            GDPR-compliant
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Human support included
          </span>
        </div>
      </div>
      <HeroAnimation />
    </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderation set up for you, not a tool to figure out alone</h2>
      </div>
      <ValueCards items={valueItems} />
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Book a call to see it on your comments</a>
      </div>
    </div>
  </section>

  <AppVideo />

  <section id="demo" class="bg-gradient-to-br from-violet-50 via-white to-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Problem / Solution -->
  <section class="bg-gradient-to-br from-rose-50 via-white to-sun-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-rose-500 px-3 py-1 text-xs font-semibold text-white shadow-sm">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-white" />
            The problem
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            Hateful comments drive your community away.
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Insults, spam and scams pile up under your posts on every platform, every day.
            Native filters miss sarcasm, coded language and anything multilingual, and manual
            cleanup eats 10+ hours a week.
          </p>
          <p class="mt-4 text-lg text-surface-500">
            OpenModeration enforces your rules automatically on Facebook, Instagram, YouTube and
            WordPress, and shows a written reason for every hidden comment.
          </p>
          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Before:</strong> You read, sort and delete hateful comments by hand on every platform, every day.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>After:</strong> Your rules apply automatically on Facebook, Instagram, YouTube and WordPress. Every hidden comment comes with a written reason.</p>
            </div>
          </div>
          <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
              Try it for free
            </a>
            <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
              Book a call
            </a>
          </div>
        </div>
        <BrowserFrame
          caption="A hidden comment, the rule it broke and the written reason. Your team sees it, and you can show it to anyone who asks."
        >
          <ModerationVerdict slot="content" />
          <div slot="annotation" class="absolute bottom-3 right-3 rounded-full border border-brand-200 bg-white/95 px-3 py-1 text-xs font-semibold text-brand-800 shadow-sm">
            &#x270D; The written reason
          </div>
        </BrowserFrame>
      </div>
    </div>
  </section>

  <!-- Beyond the API -->
  <section class="bg-white py-20 border-t border-surface-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          Filters catch words. Your community needs judgement too.
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          Keyword filters miss a lot. Your rules have to apply everywhere, edge cases have to reach your team, and every decision needs an explanation.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-rose-100 bg-rose-50/70 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Just a moderation API
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Raw scores without conversational context</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> No interface for human moderators to review edge cases</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> No built-in handling of user reports or team roles</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Compliance and audit trails left entirely to you</li>
          </ul>
        </div>
        <div class="lift rounded-2xl border border-mint-100 bg-gradient-to-br from-mint-50 to-white p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            With OpenModeration
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> AI that reads each comment in context and picks up nuance that keywords miss</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> A review workspace built for your Trust & Safety team</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> User reports, member roles and permissions managed in the same place</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Every human and AI decision logged for regulatory audits</li>
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/integrations/facebook" class="text-sm font-medium text-brand-600 hover:text-brand-500">Facebook comment moderation tool &rarr;</a>
        <a href="/integrations/instagram" class="text-sm font-medium text-brand-600 hover:text-brand-500">Instagram automoderation &rarr;</a>
        <a href="/dashboard" class="text-sm font-medium text-brand-600 hover:text-brand-500">Unified moderation dashboard &rarr;</a>
        <a href="/use-cases/news-publishers" class="text-sm font-medium text-brand-600 hover:text-brand-500">Comment moderation for news publishers &rarr;</a>
        <a href="/use-cases/brands-retail" class="text-sm font-medium text-brand-600 hover:text-brand-500">Comment moderation for brands &rarr;</a>
        <a href="/blog/comment-moderation-guide" class="text-sm font-medium text-brand-600 hover:text-brand-500">The complete comment moderation guide &rarr;</a>
        <a href="/alternatives/openai-moderation" class="text-sm font-medium text-surface-500 hover:text-surface-700">Compare with alternatives &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Full Pipeline -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          The complete moderation pipeline
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          OpenModeration takes each comment from the moment it arrives to the final action.
        </p>
      </div>
      <div class="grid gap-4 grid-cols-2 md:grid-cols-4">
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">1. Collect</h3>
          <p class="mt-1 text-xs text-surface-500">Comments arrive through the API, social platforms or webhooks</p>
        </div>
        <div class="lift rounded-2xl bg-gradient-to-br from-brand-600 to-violet-600 p-6 text-center text-white shadow-lg [&_h3]:text-white [&_p]:text-white/85">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-white/20 text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">2. Analyze</h3>
          <p class="mt-1 text-xs text-surface-500">AI reviews each comment with one or more providers</p>
        </div>
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">3. Decide</h3>
          <p class="mt-1 text-xs text-surface-500">Your rules decide what happens automatically</p>
        </div>
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">4. Review</h3>
          <p class="mt-1 text-xs text-surface-500">Edge cases flagged for your team</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark Contrast Section: DSA Compliance -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800 px-4 py-1.5 text-sm text-surface-300">
          <svg class="h-4 w-4 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          DSA-ready
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Built for regulatory compliance
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-surface-400">
          Every moderation decision goes into a full audit trail. You set the data retention,
          export transparency reports, and your data stays hosted in the EU.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm">
            Try it for free
          </a>
          <a href="/dsa-compliance" class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
            Learn about DSA compliance
          </a>
        </div>
        <p class="mt-4 text-sm text-surface-400">No credit card required</p>
