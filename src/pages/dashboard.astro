---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const locale: Locale = 'en';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Moderation console: every decision and its reason, live",
  "description": "See every comment, decision and written reason in real time on your site and social pages. Our team handles doubtful cases; you can override at any time.",
  "crumb": "Moderation console",
  "badge": "What you see in real time",
  "h1": "Every decision and its reason, in real time",
  "lead": "The console is not a tool you have to operate. Our AI and our team moderate; you see each comment, the decision, its written reason and who took it, and you can override whenever you want.",
  "feedTitle": "Your moderation, as it happens",
  "feedLead": "Comments from your site and your pages, side by side, each with its decision and the reason behind it.",
  "quote": [
    "“",
    "”"
  ],
  "reasonLabel": "Reason:",
  "overrideLabel": "Override",
  "feed": [
    {
      "platform": "Website",
      "kind": "published",
      "decision": "Published",
      "by": "Our AI",
      "text": "Good piece, but the figures in the second paragraph look outdated.",
      "reason": "Constructive criticism, no rule broken."
    },
    {
      "platform": "Facebook",
      "kind": "refused",
      "decision": "Hidden",
      "by": "Our AI, cross-checked",
      "text": "You’re all corrupt, someone should shut you up for good.",
      "reason": "Threat and personal attack."
    },
    {
      "platform": "Instagram",
      "kind": "refused",
      "decision": "Hidden",
      "by": "Our AI",
      "text": "Cheap followers here, check my profile!!!",
      "reason": "Spam."
    },
    {
      "platform": "YouTube",
      "kind": "team",
      "decision": "Refused after review",
      "by": "Our team",
      "text": "Typical of those people, they’ll never change.",
      "reason": "Generalisation targeting a group, contrary to your charter."
    }
  ],
  "shotAlt": "OpenModeration console: comments, decisions and written reasons, platform by platform",
  "shotCaption": "The console: comments, decisions and reasons, platform by platform.",
  "illustrative": "Examples and figures for illustration, from a demo space.",
  "kpis": [
    {
      "label": "Comments analysed today",
      "value": "84.2k"
    },
    {
      "label": "Hidden, each with a written reason",
      "value": "4.7%"
    },
    {
      "label": "Doubtful cases handled by our team",
      "value": "2%"
    }
  ],
  "cardsTitle": "What you see, and what you can do",
  "cardsLead": "Full transparency, nothing to operate. You step in only if you want to.",
  "cards": [
    {
      "title": "Every decision, with its reason",
      "text": "Each comment, the decision taken and its written reason, on your site and every connected page."
    },
    {
      "title": "Doubtful cases handled by our team",
      "text": "When the AI hesitates, our team decides according to your rules. You see what they handled and why."
    },
    {
      "title": "Override at any moment",
      "text": "Publish, hide or restore a comment in one click. Every change is logged with its author."
    },
    {
      "title": "Reports and appeals followed up",
      "text": "User reports and contested decisions are tracked through to the answer, as the DSA requires."
    },
    {
      "title": "Figures you can export",
      "text": "Volumes and decisions by category, platform by platform. Export them for your DSA reporting and internal reviews."
    },
    {
      "title": "Your rules, in plain sight",
      "text": "See the rules applied to your spaces. To change them, tell us or adjust them yourself: our team helps you."
    }
  ],
  "devTitle": "For technical teams",
  "devLead": "The console also gives your developers what they need to integrate and monitor OpenModeration.",
  "devPoints": [
    "Access keys, with rate limits and permissions per key",
    "Activity log searchable by comment: scores, rule applied and result",
    "Service status, with latency and error rates",
    "Data retention, allowed origins and webhooks"
  ]
};

const decisionStyles: Record<string, string> = {
  published: 'bg-green-100 text-green-700',
  refused: 'bg-red-100 text-red-700',
  team: 'bg-amber-100 text-amber-700',
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/dashboard",
  "url": "https://www.openmoderation.com/dashboard",
  "name": "Moderation console: every decision and its reason, live",
  "description": "See every comment, decision and written reason in real time on your site and social pages. Our team handles doubtful cases; you can override at any time.",
  "inLanguage": "en",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-accent-500"></span> {c.badge}
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- What you see: live feed -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.feedTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.feedLead}</p>
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <ul class="divide-y divide-surface-100 overflow-hidden rounded-2xl border border-surface-200 bg-white shadow-sm">
          {c.feed.map((f) => (
            <li class="p-5">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-surface-600">{f.platform}</span>
                <span class={`rounded-full px-2.5 py-0.5 font-semibold ${decisionStyles[f.kind]}`}>{f.decision}</span>
                <span class="text-surface-400">{f.by}</span>
              </div>
              <p class="mt-3 text-surface-800">{c.quote[0]}{f.text}{c.quote[1]}</p>
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
                <p class="text-surface-500"><span class="font-medium text-surface-700">{c.reasonLabel}</span> {f.reason}</p>
                <span class="rounded-md border border-surface-300 px-3 py-1 text-xs font-semibold text-surface-700">{c.overrideLabel}</span>
              </div>
            </li>
          ))}
        </ul>
        <div>
          <BrowserFrame src="/images/dashboard.png" video="om-triage" alt={c.shotAlt} caption={c.shotCaption} eager={false} />
          <p class="mt-6 text-center text-xs text-surface-400">{c.illustrative}</p>
        </div>
      </div>
      <dl class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {c.kpis.map((k) => (
          <div class="flex flex-col-reverse rounded-xl border border-surface-200 bg-surface-50 p-6">
            <dt class="mt-1 text-sm text-surface-500">{k.label}</dt>
            <dd class="text-3xl font-bold text-surface-900">{k.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- What you see and what you can do -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.cardsTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.cardsLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {c.cards.map((card) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{card.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.devTitle}</h2>
      <p class="mt-3 text-surface-500">{c.devLead}</p>
      <ul class="mt-6 space-y-2 text-sm text-surface-600">
        {c.devPoints.map((p) => (
          <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
