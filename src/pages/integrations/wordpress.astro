---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "WordPress Comment Moderation — Auto-Approve, Hold or Spam with AI (2026, No Code)",
  "description": "Moderate WordPress comments automatically with AI. Connect your site with an Application Password — no plugin development, no code. Approve, hold or spam violating comments, DSA audit trail included."
};

const faqItems = [
  {
    question: "How does WordPress comment moderation work?",
    answer: "Connect your WordPress site with an Application Password. Comments are automatically ingested from the WordPress REST API and analyzed by our AI engine. Based on your rules, violating comments are approved, held for review, or marked as spam — no manual queue needed."
  },
  {
    question: "Do I need to write code to set it up?",
    answer: "No. Create an Application Password in your WordPress admin (Users → Profile), then connect your site URL, username, and password in the OpenModeration dashboard. Your site is verified in seconds and moderation goes live."
  },
  {
    question: "What types of content can WordPress moderate?",
    answer: "Blog posts and comments on your WordPress site. The platform detects hate speech, harassment, spam, NSFW content, PII, scams, and more across 120+ languages."
  },
  {
    question: "What happens to a violating comment on my WordPress site?",
    answer: "Based on your moderation rules, the comment is set to approved, held for moderation, or marked as spam directly through the WordPress REST API. Every action is logged with its rule, AI scores, and a written reason."
  },
  {
    question: "What permissions does my WordPress user need?",
    answer: "Your WordPress user needs comment moderation rights — an administrator or editor role. The connector verifies this when you connect your site."
  },
  {
    question: "Is every moderation decision logged for DSA audits?",
    answer: "Yes. Every approved, held or spammed comment keeps its rule, AI scores and written reason in a full audit trail. Export it in one click for DSA transparency reports."
  },
];
---

<BaseLayout title="WordPress Comment Moderation — Auto-Approve, Hold or Spam with AI (2026, No Code)" description="Moderate WordPress comments automatically with AI. Connect your site with an Application Password — no code. Approve, hold or spam violating comments, DSA audit trail included." canonical="https://www.openmoderation.com/integrations/wordpress" jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Connectors", href: "/connectors" }, { label: "WordPress Moderation" }]} />
  <section class="bg-gradient-to-b from-sky-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.026-.78-.07-1.11m-7.981.105c.647-.03 1.232-.105 1.232-.105.582-.075.514-.93-.067-.899 0 0-1.755.135-2.88.135-1.064 0-2.85-.15-2.85-.15-.585-.03-.661.855-.075.885 0 0 .54.061 1.125.09l1.68 4.605-2.37 7.08L5.354 6.9c.649-.03 1.234-.1 1.234-.1.585-.075.516-.93-.065-.896 0 0-1.746.138-2.874.138-.2 0-.438-.008-.69-.015C4.911 3.15 8.235 1.215 12 1.215c2.809 0 5.365 1.072 7.286 2.833-.046-.003-.091-.009-.141-.009-1.06 0-1.812.923-1.812 1.914 0 .89.513 1.643 1.06 2.531.411.72.89 1.643.89 2.977 0 .915-.354 1.994-.821 3.479l-1.075 3.585-3.9-11.61.001.014zM12 22.784c-1.059 0-2.081-.153-3.048-.437l3.237-9.406 3.315 9.087c.024.053.05.101.078.149-1.12.393-2.325.609-3.582.609M1.211 12c0-1.564.336-3.05.935-4.39L7.29 21.709C3.694 19.96 1.212 16.271 1.211 12M12 0C5.385 0 0 5.385 0 12s5.385 12 12 12 12-5.385 12-12S18.615 0 12 0"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">WordPress Comment Moderation</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Protect your WordPress site with AI-powered moderation. Connect with an Application Password, set up in minutes, no code required.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Try it for free</a>
        <a href="/how-it-works" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">How it works</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Simple moderation in 3 steps</h2>
        <p class="mt-4 text-lg text-surface-500">From zero to protected in minutes. No engineering team required.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Create your account</h3>
          <p class="mt-2 text-sm text-surface-500">Sign up for free on OpenModeration — no credit card, no commitment. Choose cloud or self-host.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Connect your WordPress site</h3>
          <p class="mt-2 text-sm text-surface-500">Create an Application Password in your WordPress admin, then connect your site URL, username, and password. Your site is verified automatically — you need an administrator or editor role.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Set rules and relax</h3>
          <p class="mt-2 text-sm text-surface-500">Define your moderation rules with plain language. Our AI enforces them automatically — approve, hold, or mark comments as spam.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">What you can detect</h2>
        <p class="mt-4 text-lg text-surface-500">20+ pre-built detection models, trained on billions of labels.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxicity</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Hate speech</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Harassment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Scams & phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">PII</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Self-harm</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Profanity</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sensitive topics</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">URL risks</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Why it's the simplest WordPress moderation solution</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">No code required</h3>
          <p class="mt-2 text-sm text-surface-500">Set up everything from the dashboard. Generate an Application Password, connect your site, write rules in plain English, and let AI handle the rest.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Your credentials, your control</h3>
          <p class="mt-2 text-sm text-surface-500">Connect with your own Application Password. Credentials are encrypted, never stored in plaintext, and you can revoke access at any time from your WordPress admin.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Auto-enforcement on WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Violating comments are approved, held for review, or marked as spam directly through the WordPress REST API. No manual moderation queue needed.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">120+ languages</h3>
          <p class="mt-2 text-sm text-surface-500">Moderate comments in any language your readers use. Smart routing picks the best AI provider for each language.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Custom rules in plain language</h3>
          <p class="mt-2 text-sm text-surface-500">Write your moderation policy the way you'd explain it to a teammate. No prompt engineering or regex required.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Open source & self-hostable</h3>
          <p class="mt-2 text-sm text-surface-500">Deploy on your infrastructure with Docker. All data stays under your control. AGPL v3 licensed.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Frequently asked questions about WordPress moderation" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
