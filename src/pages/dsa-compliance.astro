---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/dsa-compliance",
  "url": "https://www.openmoderation.com/dsa-compliance",
  "name": "DSA Compliance: Moderation Audit Trails & Transparency",
  "description": "Meet DSA and Online Safety Act requirements with OpenModeration. Audit trails, transparency reporting and control over your data.",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const dsaExportExample = `{
  "period": {
    "from": "2026-01-01",
    "to": "2026-06-30"
  },
  "total_requests": 145230,
  "total_flagged": 12450,
  "by_category": [{
    "category": "hate",
    "count": 4200,
    "avg_score": 0.72
  }]
}`;
---

<BaseLayout title="DSA Compliance: Moderation Audit Trails & Transparency" description="Meet DSA and Online Safety Act requirements with OpenModeration. Audit trails, transparency reporting and control over your data." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "DSA Compliance" }]} />
<section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-700">
        <span class="flex items-center gap-1.5">
          
          Made and hosted in the EU
        </span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">DSA Compliance</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Meet your regulatory obligations with an open-source moderation platform.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">The DSA already applies to you</h2>
          <p class="mt-4 text-lg text-surface-500">
            The EU Digital Services Act (DSA) came into full effect in 2024. It requires
            services that host user content in the EU to act on notices of illegal content, explain
            each moderation decision and let users contest it.
            Fines can reach <strong>6% of global annual turnover</strong>.
          </p>
          <p class="mt-4 text-lg text-surface-500">
            The UK Online Safety Act imposes similar obligations. Platforms must <strong>prove</strong>
            that they moderate, and the penalties for failing to do so are heavy.
          </p>
          <div class="mt-8 rounded-lg border border-surface-200 bg-amber-50 p-4">
            <p class="text-sm text-amber-800">
              <strong>Warning:</strong> Manual moderation teams struggle to keep up with DSA requirements.
              For most platforms, the realistic path is automated moderation with a full audit trail.
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Complete Audit Trail</h3>
                <p class="mt-1 text-sm text-surface-500">Every moderation action is logged with the content, the provider, the scores and the decision. You can export it for DSA transparency reports.</p>
              </div>
            </div>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Data Sovereignty</h3>
                <p class="mt-1 text-sm text-surface-500">Self-host on your own infrastructure and keep every piece of data under your control. No third party processes it, which matters for GDPR compliance.</p>
              </div>
            </div>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Multi-Language Coverage</h3>
                <p class="mt-1 text-sm text-surface-500">Moderate comments in any language. Combine providers to cover EU languages well, for example by sending French to Mistral and German to OpenAI.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">How OpenModeration helps with DSA compliance</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Article 16: Notice and Action</h3>
          <p class="mt-2 text-sm text-surface-500">Content is flagged automatically and every flag is recorded in the audit trail. Users can be notified when their content is moderated.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Article 15: Transparency Reporting</h3>
          <p class="mt-2 text-sm text-surface-500">You can export the total items moderated, the actions taken and provider accuracy, which is what DSA transparency reports need.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Article 17: Statement of Reasons</h3>
           <p class="mt-2 text-sm text-surface-500">Every moderation decision comes with a written reason, and the audit log records whether it was taken automatically or by a moderator.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Article 20: Complaint System</h3>
          <p class="mt-2 text-sm text-surface-500">The review queue lets moderators handle edge cases themselves. Every decision is logged for audit.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Article 34: Risk Assessment</h3>
          <p class="mt-2 text-sm text-surface-500">Usage analytics and provider comparison data help assess moderation effectiveness and identify gaps in coverage.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Data Retention</h3>
          <p class="mt-2 text-sm text-surface-500">You choose how long to keep input text and logs. Sensitive content is stored encrypted.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-8">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <h2 class="text-2xl font-bold text-surface-900">Open source makes compliance provable</h2>
            <p class="mt-4 text-surface-600">
              Proprietary moderation platforms are black boxes. If you can't inspect the code,
              it is hard to prove to a regulator that your moderation system works.
            </p>
            <p class="mt-4 text-surface-600">
              OpenModeration is fully open source (AGPL v3). Anyone can audit every line of
              moderation logic, and every decision can be traced. Your compliance team can verify
              exactly how content is moderated.
            </p>
            <div class="mt-6 flex items-center gap-2 text-sm text-brand-700">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Nothing hidden, and no lock-in to a single vendor.
            </div>
          </div>
          <div class="rounded-lg border border-brand-200 bg-white p-6">
            <h4 class="mb-2 text-sm font-semibold text-surface-900">DSA-relevant data export</h4>
            <CodeBlock code={dsaExportExample} lang="json" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Further reading</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/dsa-compliance/statement-of-reasons" class="font-medium text-brand-600 hover:text-brand-500">The statement of reasons (Article 17): obligations and an example &rarr;</a></li>
        <li><a href="/blog/dsa-compliance-sme-guide" class="font-medium text-brand-600 hover:text-brand-500">Practical DSA guide for small and medium platforms &rarr;</a></li>
        <li><a href="/product/transparency" class="font-medium text-brand-600 hover:text-brand-500">Every hidden comment comes with a written reason &rarr;</a></li>
        <li><a href="/pricing" class="font-medium text-brand-600 hover:text-brand-500">Start free, upgrade when you grow &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>