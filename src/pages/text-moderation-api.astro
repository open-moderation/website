---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTASection from '../components/CTASection.astro';
import CodeBlock from '../components/CodeBlock.astro';
import FAQ from '../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/text-moderation-api",
      "url": "https://www.openmoderation.com/text-moderation-api",
      "name": "Text Moderation API: Moderate Comments, Chat & Messages",
      "description": "A text moderation API that filters toxic comments, chat messages and user reviews: 10 providers behind one endpoint, custom rules, dual thresholds and DSA audit trails.",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/text-moderation-api#software",
      "name": "OpenModeration Text Moderation API",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any (REST API)",
      "description": "Text moderation API: one endpoint, 10 providers, custom rules, dual thresholds, batch endpoints and DSA audit trails.",
      "url": "https://www.openmoderation.com/text-moderation-api",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
    }
  ]
};

const quickstart = `# Moderate any text — comments, chat, messages, reviews
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "user comment here",
    "model": "openai/omni-moderation-latest",
    "categories": ["hate", "harassment", "sexual", "violence", "self-harm", "spam"],
    "threshold": 0.5
  }'

# Response (standardized across providers)
{
  "flagged": false,
  "results": [{ "category": "harassment", "score": 0.03, "flagged": false }],
  "usage": { "provider": "openai", "latency_ms": 212 }
}`;

const useCases = [
  { name: "Comments & reviews", desc: "Auto-hide hate speech, spam and PII leaks in comments, reviews and forum posts before they go live." },
  { name: "Chat & messaging", desc: "Real-time moderation in many languages, with latency under 250ms and automated actions." },
  { name: "AI app prompts", desc: "Filter what users send and what your LLM answers. LLM-based moderation handles custom categories that change over time." },
  { name: "Marketplace listings", desc: "Flag spam listings, scams and prohibited content in titles and descriptions at ingest time." },
];

const faqItems = [
  {
    question: "What is a text moderation API?",
    answer: "A text moderation API scores what users write (hate, harassment, sexual, violence, spam, PII…) so your app can approve, flag or reject it automatically. OpenModeration puts 10 providers behind one endpoint, with one response format, custom rules and an audit trail."
  },
  {
    question: "Which text moderation API should I choose?",
    answer: "Single-provider APIs (OpenAI, Azure, Mistral) are fast to start but lock you into one accuracy profile and one price. OpenModeration sends each request to the best provider (OpenAI for English toxicity, Mistral for EU languages, LLMs for custom categories) and adds pre-filtering, rules and a review dashboard."
  },
  {
    question: "How much does a text moderation API cost?",
    answer: "OpenAI's moderation endpoint is free, Mistral sets its own price for its moderation model, and Azure AI Content Safety bills per 1,000 text records after a free tier of 5,000 records a month. OpenModeration is free to self-host. The managed cloud starts at €99/month for 10K requests, and pre-filtering cuts 10-30% of billable calls."
  },
  {
    question: "Can I define custom moderation rules?",
    answer: "Yes, with three tools and no code. Forbidden words block a message instantly. Category thresholds decide between auto-approve, human review and auto-reject. A community charter written in plain language is applied by LLMs for categories such as misinformation or grooming."
  },
  {
    question: "Can I migrate from openai text-moderation-latest?",
    answer: "Yes. Replace openai.moderations.create with one POST /v1/moderation call using model openai/omni-moderation-latest. Keep your OpenAI key (BYOK), then add fallback providers without rewriting code."
  },
  {
    question: "Is every text moderation decision logged?",
    answer: "Yes. Every AI and human decision keeps its provider scores, thresholds, reviewer and timestamp. You can export the full audit trail in one click for DSA transparency reports."
  },
];
---

<BaseLayout
  title="Text Moderation API: Moderate Comments, Chat & Messages"
  description="One text moderation API for OpenAI, Mistral, Azure and 7 more providers. Hide toxic comments, chat spam and PII with custom rules and DSA audit trails."
  canonical="https://www.openmoderation.com/text-moderation-api"
  jsonLd={pageJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Text Moderation API" }]} />

  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        For developers: REST API and dashboard
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        A text moderation API that acts on the score.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        One endpoint sends comments, chat, messages and reviews to OpenAI,
        Mistral, Azure, Llama Guard and others. Pre-filtering, custom rules, dual thresholds
        and an audit trail ready for the DSA are included.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Get a free API key
        </a>
        <a href="https://api.openmoderation.com/docs" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          Read the API docs &rarr;
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Free self-hosted · No credit card · OpenAPI reference</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderate any text, one request</h2>
          <p class="mt-4 text-lg text-surface-500">
            Send text to one endpoint. Pick the provider for each request or let the router decide.
            Scores come back in one format, with thresholds you control.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>10 categories, 120+ languages.</strong> Hate, harassment, sexual, violence, self-harm, spam, PII and your own LLM categories.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Pre-filter.</strong> Obvious spam and forbidden words are blocked before any billable provider call.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Dual thresholds.</strong> Clear cases are approved or rejected automatically, and the grey zone goes to human review.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Batch up to 10K texts.</strong> Batch calls use the same schema as single-text calls.</span></li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3 text-sm">
            <a href="/content-moderation-api" class="font-medium text-brand-600 hover:text-brand-500">Full content moderation API &rarr;</a>
            <a href="/alternatives/openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">OpenAI Moderation alternative &rarr;</a>
            <a href="/features" class="font-medium text-brand-600 hover:text-brand-500">All API features &rarr;</a>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={quickstart} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Built for every text moderation use case</h2>
        <p class="mt-4 text-lg text-surface-500">One API for every place where users type.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {useCases.map((u) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{u.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{u.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Single-provider API vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">A raw toxicity score is not a moderation system.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Capability</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Single-provider text API</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            <tr><td class="px-6 py-4 font-medium text-surface-900">Providers</td><td class="px-6 py-4 text-surface-500">1 (lock-in)</td><td class="px-6 py-4">10: OpenAI, Mistral, Azure, Llama Guard, Perspective, Hive…</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Custom rules</td><td class="px-6 py-4 text-surface-500">DIY</td><td class="px-6 py-4">Forbidden words, thresholds and an LLM charter, with no code</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Human review</td><td class="px-6 py-4 text-surface-500">DIY</td><td class="px-6 py-4">Built-in review queue with context and assignation</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Audit trail</td><td class="px-6 py-4 text-surface-500">API logs only</td><td class="px-6 py-4">Full DSA export of AI and human decisions</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Pricing</td><td class="px-6 py-4 text-surface-500">Set by each provider, from free (OpenAI) to billed per call</td><td class="px-6 py-4">Free self-hosted · managed from €99/mo · pre-filter saves 10-30%</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Text moderation API: FAQ" />
    </div>
  </section>

  <CTASection
    title="Start moderating text in minutes."
    subtitle="Get an API key, copy the curl example, and moderate your first text today, with rules, a review queue and an audit trail from day one."
    buttonText="Try the API free"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
