---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Plattform zur Moderation von YouTube-Kommentaren | OpenModeration",
  "description": "YouTube-Kommentare in großem Umfang per KI moderieren. Jeden Kommentar automatisch veröffentlichen, zur Prüfung zurückhalten oder ablehnen. Die einfachste Lösung zur Moderation von YouTube-Kommentaren.",
  "inLanguage": "de"
};

const faqItems = [
  {
    question: "Wie funktioniert die Moderation von YouTube-Kommentaren?",
    answer: "Sie verbinden Ihren YouTube-Kanal über die YouTube Data API. Kommentare werden erfasst und von der KI analysiert. Je nach Ihren Regeln wird jeder Kommentar veröffentlicht, zur Prüfung zurückgehalten oder abgelehnt."
  },
  {
    question: "Ist die Einrichtung einfach?",
    answer: "Ja. Die gesamte Einrichtung erfolgt in der Konsole. Verbinden Sie Ihren YouTube-Kanal, konfigurieren Sie Ihre Moderationsregeln per Schalter und in natürlicher Sprache, und die Plattform schützt Ihre Videos sofort."
  },
  {
    question: "Was erkennt die YouTube-Moderation?",
    answer: "Hassrede, Belästigung, Spam, NSFW-Inhalte, personenbezogene Daten, Betrug, Phishing, vulgäre Sprache, Selbstverletzung, Stimmung, sensible Themen und riskante URLs. Dafür stehen über 20 Modelle in mehr als 120 Sprachen bereit."
  },
  {
    question: "Brauche ich technische Kenntnisse?",
    answer: "Nein. OpenModeration ist für Creator und Community-Manager gemacht. Regeln konfigurieren Sie in natürlicher Sprache in der Konsole. Programmieren ist nicht nötig."
  },
  {
    question: "Kann ich markierte Kommentare prüfen, bevor sie entfernt werden?",
    answer: "Ja. Grenzfälle lassen sich in eine manuelle Prüfwarteschlange schicken, in der Ihr Team sie freigibt oder ablehnt. Jede Aktion wird protokolliert und bleibt nachvollziehbar."
  },
];
---

<BaseLayout title="YouTube-Kommentare moderieren mit KI | OpenModeration" description="YouTube-Kommentare per KI moderieren: toxische Kommentare ablehnen, Grenzfälle zur Prüfung zurückhalten, über 120 Sprachen. Die einfachste Lösung für Creator und Marken." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Integrationen", href: "/de/integrationen" }, { label: "YouTube-Moderation" }]} />
  <section class="bg-gradient-to-b from-red-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 text-red-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderation von YouTube-Kommentaren</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Moderieren Sie YouTube-Kommentare auch in großer Zahl mit KI. Die Einrichtung dauert wenige Minuten und kommt ohne Code aus.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Kostenlos testen</a>
        <a href="/de/so-funktioniert-es" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">So funktioniert es</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">In 3 einfachen Schritten moderieren</h2>
        <p class="mt-4 text-lg text-surface-500">Nach wenigen Minuten ist Ihr Kanal geschützt, ganz ohne Entwicklungsarbeit.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Konto erstellen</h3>
          <p class="mt-2 text-sm text-surface-500">Registrieren Sie sich kostenlos, eine Kreditkarte brauchen Sie nicht. Wählen Sie zwischen Cloud und selbst gehostetem Betrieb.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">YouTube verbinden</h3>
          <p class="mt-2 text-sm text-surface-500">Verknüpfen Sie Ihren YouTube-Kanal mit Ihren eigenen Zugangsdaten für die Data API. Der Konnektor erfasst Kommentare automatisch.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Regeln festlegen</h3>
          <p class="mt-2 text-sm text-surface-500">Formulieren Sie Ihre Regeln in natürlicher Sprache. Die KI lehnt toxische Kommentare ab und hält Grenzfälle automatisch zur Prüfung zurück.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Was die KI in Ihren Kommentaren erkennt</h2>
        <p class="mt-4 text-lg text-surface-500">Über 20 vortrainierte Modelle, trainiert mit Milliarden von Inhaltslabels.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxizität</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Hassrede</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Belästigung</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Betrug & Phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Personenbezogene Daten</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Selbstverletzung</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Vulgäre Sprache</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Stimmung</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sensible Themen</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Riskante URLs</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum YouTube-Moderation damit einfach wird</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Ganz ohne Code</h3>
          <p class="mt-2 text-sm text-surface-500">Alles wird in der Konsole konfiguriert. Ihr Entwicklerteam muss dafür nichts programmieren.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Native YouTube-Aktionen</h3>
          <p class="mt-2 text-sm text-surface-500">Kommentare direkt über die YouTube Data API veröffentlichen, zur Prüfung zurückhalten oder ablehnen. Das entspricht den Aktionen in YouTube Studio, nur automatisch.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Jede Größenordnung</h3>
          <p class="mt-2 text-sm text-surface-500">Ob 100 oder 100.000 Kommentare am Tag: OpenModeration wächst mit Ihrem Kanal.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Über 120 Sprachen</h3>
          <p class="mt-2 text-sm text-surface-500">Ihr internationales Publikum kommentiert in vielen Sprachen. Eine einzige Plattform erkennt Toxizität in allen davon automatisch.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Eigene Regeln in natürlicher Sprache</h3>
          <p class="mt-2 text-sm text-surface-500">Formulieren Sie Ihre Moderationsrichtlinie in natürlicher Sprache. Die KI versteht die Absicht, nicht nur Schlüsselwörter.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Prüfbar & transparent</h3>
          <p class="mt-2 text-sm text-surface-500">Jede Moderationsentscheidung wird mit vollständigem Kontext protokolliert. Der Code ist Open Source und selbst hostbar, Ihre Daten bleiben also unter Ihrer Kontrolle.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Häufige Fragen zur YouTube-Moderation" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
