---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "WordPress-Kommentarmoderation: per KI freigeben, zurückhalten oder als Spam markieren (2026, ohne Code)",
  "description": "WordPress-Kommentare automatisch per KI moderieren. Verbinden Sie Ihre Website mit einem Anwendungspasswort, ohne Plugin-Entwicklung und ohne Code. Regelwidrige Kommentare freigeben, zurückhalten oder als Spam markieren, DSA-Audit-Trail inklusive.",
  "inLanguage": "de"
};

const faqItems = [
  {
    question: "Wie funktioniert die Moderation von WordPress-Kommentaren?",
    answer: "Sie verbinden Ihre WordPress-Website mit einem Anwendungspasswort. Kommentare werden automatisch über die WordPress REST API erfasst und von unserer KI analysiert. Je nach Ihren Regeln wird jeder Kommentar freigegeben, zur Prüfung zurückgehalten oder als Spam markiert, ganz ohne manuelle Warteschlange."
  },
  {
    question: "Muss ich für die Einrichtung programmieren?",
    answer: "Nein. Erstellen Sie in Ihrem WordPress-Admin (Benutzer → Profil) ein Anwendungspasswort und tragen Sie dann die URL Ihrer Website, Ihren Benutzernamen und das Passwort in der OpenModeration-Konsole ein. Ihre Website wird in Sekunden verifiziert, und die Moderation startet."
  },
  {
    question: "Welche Inhalte lassen sich auf WordPress moderieren?",
    answer: "Blogbeiträge und Kommentare auf Ihrer WordPress-Website. Die Plattform erkennt Hassrede, Belästigung, Spam, NSFW-Inhalte, personenbezogene Daten, Betrugsversuche und mehr in über 120 Sprachen."
  },
  {
    question: "Was passiert mit einem regelwidrigen Kommentar auf meiner WordPress-Website?",
    answer: "Je nach Ihren Moderationsregeln wird der Kommentar direkt über die WordPress REST API freigegeben, zur Moderation zurückgehalten oder als Spam markiert. Jede Aktion wird mit der Regel, den KI-Scores und einer schriftlichen Begründung protokolliert."
  },
  {
    question: "Welche Berechtigungen braucht mein WordPress-Benutzer?",
    answer: "Ihr WordPress-Benutzer benötigt das Recht, Kommentare zu moderieren, also die Rolle Administrator oder Redakteur. Der Konnektor prüft das beim Verbinden Ihrer Website."
  },
  {
    question: "Wird jede Moderationsentscheidung für DSA-Prüfungen protokolliert?",
    answer: "Ja. Zu jedem freigegebenen, zurückgehaltenen oder als Spam markierten Kommentar bleiben die Regel, die KI-Scores und die schriftliche Begründung in einem vollständigen Audit-Trail erhalten. Mit einem Klick exportieren Sie ihn für Ihre DSA-Transparenzberichte."
  },
];
---

<BaseLayout title="WordPress-Kommentare per KI moderieren (2026, ohne Code)" description="WordPress-Kommentare automatisch per KI moderieren: Verbindung per Anwendungspasswort, ohne Code. Freigeben, zurückhalten oder Spam, mit DSA-Audit-Trail." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Integrationen", href: "/de/integrationen" }, { label: "WordPress-Moderation" }]} />
  <section class="bg-gradient-to-b from-sky-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.026-.78-.07-1.11m-7.981.105c.647-.03 1.232-.105 1.232-.105.582-.075.514-.93-.067-.899 0 0-1.755.135-2.88.135-1.064 0-2.85-.15-2.85-.15-.585-.03-.661.855-.075.885 0 0 .54.061 1.125.09l1.68 4.605-2.37 7.08L5.354 6.9c.649-.03 1.234-.1 1.234-.1.585-.075.516-.93-.065-.896 0 0-1.746.138-2.874.138-.2 0-.438-.008-.69-.015C4.911 3.15 8.235 1.215 12 1.215c2.809 0 5.365 1.072 7.286 2.833-.046-.003-.091-.009-.141-.009-1.06 0-1.812.923-1.812 1.914 0 .89.513 1.643 1.06 2.531.411.72.89 1.643.89 2.977 0 .915-.354 1.994-.821 3.479l-1.075 3.585-3.9-11.61.001.014zM12 22.784c-1.059 0-2.081-.153-3.048-.437l3.237-9.406 3.315 9.087c.024.053.05.101.078.149-1.12.393-2.325.609-3.582.609M1.211 12c0-1.564.336-3.05.935-4.39L7.29 21.709C3.694 19.96 1.212 16.271 1.211 12M12 0C5.385 0 0 5.385 0 12s5.385 12 12 12 12-5.385 12-12S18.615 0 12 0"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderation von WordPress-Kommentaren</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Schützen Sie Ihre WordPress-Website mit KI-Moderation. Die Verbindung läuft über ein Anwendungspasswort und ist in wenigen Minuten ohne Code eingerichtet.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Kostenlos testen</a>
        <a href="/de/so-funktioniert-es" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">So funktioniert es</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Einfache Moderation in 3 Schritten</h2>
        <p class="mt-4 text-lg text-surface-500">Die Einrichtung dauert wenige Minuten, und Sie brauchen kein Entwicklerteam.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Konto erstellen</h3>
          <p class="mt-2 text-sm text-surface-500">Registrieren Sie sich kostenlos bei OpenModeration, ohne Kreditkarte und ohne Verpflichtung. Unser Team hilft Ihnen bei der Einrichtung.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">WordPress-Website verbinden</h3>
          <p class="mt-2 text-sm text-surface-500">Erstellen Sie in Ihrem WordPress-Admin ein Anwendungspasswort und verbinden Sie dann URL, Benutzernamen und Passwort. Ihre Website wird automatisch verifiziert. Sie benötigen dafür die Rolle Administrator oder Redakteur.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Regeln festlegen</h3>
          <p class="mt-2 text-sm text-surface-500">Formulieren Sie Ihre Moderationsregeln in natürlicher Sprache. Unsere KI setzt sie automatisch durch: Kommentare freigeben, zurückhalten oder als Spam markieren.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Was erkannt wird</h2>
        <p class="mt-4 text-lg text-surface-500">Über 20 vortrainierte Erkennungsmodelle, trainiert mit Milliarden von Labels.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxizität</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Hassrede</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Belästigung</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Betrug & Phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Personenbezogene Daten</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Selbstverletzung</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Vulgäre Sprache</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Stimmung</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sensible Themen</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Riskante URLs</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum WordPress-Moderation damit einfach wird</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Kein Code erforderlich</h3>
          <p class="mt-2 text-sm text-surface-500">Richten Sie alles in der Konsole ein. Sie erzeugen ein Anwendungspasswort, verbinden die Website und formulieren Ihre Regeln in natürlicher Sprache. Den Rest übernimmt die KI.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Ihre Zugangsdaten, Ihre Kontrolle</h3>
          <p class="mt-2 text-sm text-surface-500">Verbinden Sie sich mit Ihrem eigenen Anwendungspasswort. Zugangsdaten werden verschlüsselt, niemals im Klartext gespeichert, und Sie können den Zugriff jederzeit in Ihrem WordPress-Admin widerrufen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Automatische Durchsetzung auf WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Jeder Kommentar wird direkt über die WordPress REST API freigegeben, zur Prüfung zurückgehalten oder als Spam markiert. Eine manuelle Moderationswarteschlange ist nicht nötig.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Über 120 Sprachen</h3>
          <p class="mt-2 text-sm text-surface-500">Moderieren Sie Kommentare in jeder Sprache, die Ihre Leserinnen und Leser sprechen. Unsere eigene KI liest jeden Kommentar in seiner Sprache, und heikle Fälle prüfen weitere KI-Modelle.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Eigene Regeln in natürlicher Sprache</h3>
          <p class="mt-2 text-sm text-surface-500">Formulieren Sie Ihre Regeln so, wie Sie sie einer Kollegin erklären würden. Prompt Engineering oder reguläre Ausdrücke brauchen Sie dafür nicht.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">EU-Hosting & Datenexport</h3>
          <p class="mt-2 text-sm text-surface-500">Ihre Daten werden in der EU gehostet und lassen sich jederzeit exportieren. Eine On-Premise-Bereitstellung ist auf Anfrage möglich.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Häufige Fragen zur WordPress-Moderation" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
