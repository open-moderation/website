---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/de/so-funktioniert-es",
  "url": "https://www.openmoderation.com/de/so-funktioniert-es",
  "name": "So funktioniert KI-Moderation: die komplette Pipeline",
  "description": "Die komplette Moderationspipeline im Überblick: Erfassung, KI-Moderation über mehrere Anbieter, automatische Regeln und Aktionen sowie manuelle Prüfung.",
  "inLanguage": "de",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const facebookWebhookExample = `// Facebook sendet den Kommentar per Webhook
{
  "source": "facebook",
  "content_id": "comment_123",
  "author_id": "user_456",
  "text": "Kommentartext hier...",
  "metadata": {"post_url": "..."}
}`;

const moderationResponseExample = `{
  "model": "openai/omni-moderation-latest",
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243,
    "provider": "openai"
  }
}`;

const ruleConfigExample = `// Moderationsschwellenwerte konfigurieren
PUT /v1/settings

{
  "thresholds": {
    "hate":       { "accepted": 0.3, "rejected": 0.7 },
    "harassment": { "accepted": 0.3, "rejected": 0.7 },
    "sexual":     { "accepted": 0.2, "rejected": 0.8 },
    "violence":   { "accepted": 0.3, "rejected": 0.7 },
    "self-harm":  { "accepted": 0.2, "rejected": 0.8 },
    "spam":       { "accepted": 0.4, "rejected": 0.8 }
  },
  "actions": {
    "on_reject": ["hide", "flag_for_review"]
  }
}`;

const auditTrailExample = `// Vollständiger Audit-Trail für jeden Inhalt
{
  "content_id": "...",
  "source": "webhook",
  "platform": "facebook",
  "status": "actioned",
  "moderation": {
    "provider": "openai",
    "flagged": true,
    "results": [...]
  },
  "actions": [{
    "rule": "Hassrede ausblenden",
    "type": "hide",
    "status": "executed"
  }]
}`;
---

<BaseLayout title="So funktioniert KI-Moderation: die komplette Pipeline" description="Die komplette Moderationspipeline im Überblick: Erfassung, KI-Moderation über mehrere Anbieter, automatische Regeln und Aktionen sowie manuelle Prüfung." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "So funktioniert es" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">So funktioniert es</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Jeder Kommentar durchläuft dieselbe Pipeline, von der Erfassung bis zur automatischen Aktion.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Pipeline Overview -->
      <div class="mb-20">
        <div class="relative rounded-2xl border border-surface-200 bg-surface-50 p-8">
          <div class="grid gap-6 grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-brand-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">1. Erfassung</h3>
              <p class="mt-2 text-sm text-surface-500">Inhalte kommen über die API, einen Webhook oder einen Social-Media-Konnektor an.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">POST /v1/moderation</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Webhooks</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Facebook</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Instagram</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">YouTube</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-brand-400 bg-white p-6 text-center shadow-md">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">2. KI-Moderation</h3>
              <p class="mt-2 text-sm text-surface-500">Intelligentes Routing schickt den Inhalt zum passendsten Anbieter. Zurück kommt ein standardisiertes Ergebnis.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">OpenAI</span>
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">Azure</span>
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">HuggingFace</span>
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">LLMs</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-surface-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">3. Regeln & Aktionen</h3>
              <p class="mt-2 text-sm text-surface-500">Die Regel-Engine wertet die Ergebnisse aus. Aktionen werden automatisch ausgeführt.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Ausblenden</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Zurückhalten</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Veröffentlichen</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Webhook</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-surface-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">4. Manuelle Prüfung</h3>
              <p class="mt-2 text-sm text-surface-500">Grenzfälle werden markiert, damit menschliche Moderatoren sie freigeben oder ablehnen.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Prüfwarteschlange</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Freigeben</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Ablehnen</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Detailed Steps -->
      <div class="space-y-16">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Schritt 1</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Inhalte kommen von überall</h2>
            <p class="mt-4 text-surface-500">
              Senden Sie Inhalte über jeden beliebigen Kanal. Nutzen Sie die API direkt für den programmatischen Zugriff,
              richten Sie Webhooks ein, um Inhalte von externen Plattformen zu empfangen, oder aktivieren Sie die nativen
              Social-Media-Konnektoren, die Kommentare und Beiträge automatisch erfassen.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Die <strong>API</strong> (POST /v1/moderation) moderiert einzelne Inhalte oder ganze Batches.</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Ein generischer <strong>Webhook</strong>-Endpunkt empfängt externe Payloads und bringt sie in ein einheitliches Format.</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Native <strong>Konnektoren</strong> gibt es für Facebook, Instagram, YouTube und WordPress.</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Beispiel: ein Facebook-Kommentar</h4>
            <CodeBlock code={facebookWebhookExample} lang="json" />
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div class="lg:order-2">
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Schritt 2</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Die KI moderiert den Inhalt</h2>
            <p class="mt-4 text-surface-500">
              Der Inhalt wird je nach Sprache, Inhaltstyp, benötigten Kategorien und Kosten an den
              passendsten verfügbaren Anbieter geleitet. Jeder Anbieter liefert standardisierte Ergebnisse
               mit Scores von 0,0 bis 1,0 in 10 Inhaltskategorien.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Das <strong>Routing</strong> wählt den passendsten Anbieter, wenn Sie keinen angeben.</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Mit <strong>BYOK</strong> nutzen Sie Ihre eigenen API-Schlüssel der Anbieter (oder die der Plattform).</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Die <strong>Ausgabe</strong> hat immer dasselbe Format, egal welcher Anbieter dahintersteht.</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 lg:order-1">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Standardisierte Antwort</h4>
            <CodeBlock code={moderationResponseExample} lang="json" />
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Schritt 3</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Die Moderation folgt Ihren Regeln</h2>
            <p class="mt-4 text-surface-500">
              Definieren Sie Ihre Moderation mit drei einfachen Werkzeugen: <strong>verbotene Wörter</strong> für sofortiges Blockieren, <strong>Schwellenwerte pro Kategorie</strong> für automatische Entscheidungen und Ihre <strong>Regeln in natürlicher Sprache</strong> für eine kontextbezogene KI-Moderation.
            </p>
            <div class="mt-6 space-y-3">
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Verbotene Wörter</strong> blockieren Inhalte sofort, noch vor jedem KI-Aufruf und ohne Kosten</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Schwellenwerte pro Kategorie</strong> lösen automatische Aktionen aus, sobald Scores Ihre Grenzen überschreiten</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700">Ihre <strong>Regeln in natürlicher Sprache</strong> leiten die kontextbezogenen KI-Entscheidungen und geben den Ton auf Ihrer Plattform vor</p>
              </div>
            </div>
          </div>
          <div>
            <BrowserFrame
              src="/images/rules.png"
              video="om-rules"
              alt="Regeleinstellungen in OpenModeration mit verbotenen Wörtern, Schwellenwerten pro Kategorie und Regeln in natürlicher Sprache"
              caption="Ihre Schwellenwerte, einmal festgelegt und überall durchgesetzt."
              eager={false}
            />
            <details class="mt-4 rounded-xl border border-surface-200 bg-surface-50 p-4">
              <summary class="cursor-pointer text-sm font-semibold text-surface-700">Für Entwickler: Konfiguration per API</summary>
              <div class="mt-3">
                <CodeBlock code={ruleConfigExample} lang="json" />
              </div>
            </details>
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div class="lg:order-2">
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Schritt 4</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Grenzfälle manuell prüfen</h2>
            <p class="mt-4 text-surface-500">
              Ihr Trust-&-Safety-Team hat einen eigenen Arbeitsbereich.
              Dort prüft es markierte Inhalte, bearbeitet Nutzermeldungen und korrigiert KI-Entscheidungen. Jeder Schritt bleibt nachvollziehbar.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Ein Klick</strong> genügt zum Freigeben oder Ablehnen. Jede Korrektur wird mit Entscheider und Begründung protokolliert.</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Markierte Inhalte in der Moderationskonsole freigeben oder ablehnen</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Webhook-Benachrichtigungen bei neuen Prüffällen</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 lg:order-1">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Alles wird protokolliert</h4>
            <CodeBlock code={auditTrailExample} lang="json" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Action Engine -->
  <section id="action-engine" class="scroll-mt-24 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Action Engine</h2>
        <p class="mt-4 text-lg text-surface-500">Sobald Ihre Regeln greifen, setzt die Action Engine Ihre Entscheidung automatisch auf der Plattform um. Jede Aktion wird protokolliert.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-100 text-red-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Automatisch ausblenden</h3>
          <p class="mt-1 text-sm text-surface-500">Abgelehnte Inhalte werden auf Facebook &amp; Instagram ausgeblendet und auf YouTube abgelehnt. Ihre Community bekommt sie nie zu sehen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Zur Prüfung zurückhalten</h3>
          <p class="mt-1 text-sm text-surface-500">Grenzwertige Inhalte werden zurückgehalten und warten in Ihrer Prüfwarteschlange. Bis zur Entscheidung wird nichts veröffentlicht, und es geht nichts verloren.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-green-100 text-green-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Veröffentlichen &amp; wiederherstellen</h3>
          <p class="mt-1 text-sm text-surface-500">Unbedenkliche Inhalte gehen ganz normal online. Gibt ein Moderator einen zurückgehaltenen Kommentar frei, wird er veröffentlicht.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Ihre Tools benachrichtigen</h3>
          <p class="mt-1 text-sm text-surface-500">Jede Entscheidung kann per Webhook an Ihre eigenen Tools gehen, für individuelle Workflows und Integrationen.</p>
        </div>
      </div>
      <div class="mx-auto mt-12 max-w-xl">
        <BrowserFrame
          src="/images/rules.png"
          video="om-rules"
          alt="OpenModeration-Konsole: Regelkonfiguration mit Schwellenwerten pro Kategorie und automatischen Aktionen"
          caption="Ihre Schwellenwerte, einmal festgelegt und auf jeder verbundenen Plattform durchgesetzt."
        />
      </div>
      <div class="mt-10 text-center">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Kostenlos testen
        </a>
