---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'de';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "So funktioniert es: Wir moderieren, Sie sehen alles",
  "description": "Sie verbinden Ihre Seiten, unsere KI und unser Team moderieren nach Ihren Regeln, Sie sehen jede Entscheidung mit Begründung in Echtzeit. Technik weiter unten.",
  "crumb": "So funktioniert es",
  "h1": "Sie verbinden Ihre Seiten. Wir moderieren. Sie sehen alles.",
  "lead": "Kein Moderationstool, das Sie bedienen müssen: Unsere KI und unser Team wenden Ihre Regeln rund um die Uhr an, und Sie behalten den vollen Überblick und das letzte Wort.",
  "stepsTitle": "Drei Schritte, und nichts zu bedienen",
  "steps": [
    {
      "title": "Sie verbinden Ihre Seiten",
      "text": "Website, Facebook, Instagram, YouTube oder WordPress: Unser Team verbindet sie mit Ihnen und richtet Ihre Regeln auf Basis Ihrer Netiquette und Anwendungsfälle ein."
    },
    {
      "title": "Unsere KI und unser Team moderieren nach Ihren Regeln",
      "text": "Unsere KI liest jeden Kommentar im Kontext und entscheidet die klaren Fälle. Heikle Fälle werden von weiteren KI-Modellen gegengeprüft; Zweifelsfälle, Meldungen und Beschwerden bearbeitet unser Team."
    },
    {
      "title": "Sie sehen alles in Echtzeit",
      "text": "Jede Entscheidung kommt mit ihrer schriftlichen Begründung. Sie verfolgen alles in der Konsole und können jederzeit eingreifen oder korrigieren."
    }
  ],
  "stepsNote": "Ihr Team muss nichts tun, außer es möchte. Der Verlauf jeder Entscheidung bleibt für Ihre DSA-Pflichten verfügbar.",
  "outcomesTitle": "Was mit jedem Kommentar passiert",
  "outcomesLead": "Die Entscheidungen werden direkt auf Ihrer Website und Ihren Seiten umgesetzt, und jede wird mit ihrer Begründung protokolliert.",
  "outcomes": [
    {
      "label": "Veröffentlicht",
      "title": "Saubere Kommentare gehen online",
      "text": "Konstruktive Kommentare, auch kritische, werden normal veröffentlicht. Die Diskussion läuft weiter."
    },
    {
      "label": "Ausgeblendet",
      "title": "Missbrauch erreicht Ihre Leser nicht",
      "text": "Beleidigungen, Drohungen und Spam werden auf Facebook und Instagram ausgeblendet und auf YouTube und Ihrer Website abgelehnt, mit schriftlicher Begründung."
    },
    {
      "label": "Zurückgehalten",
      "title": "Zweifelsfälle gehen an unser Team",
      "text": "Wenn die KI zögert, wird der Kommentar zurückgehalten und unser Team entscheidet nach Ihren Regeln. Nichts wird versehentlich veröffentlicht, nichts geht verloren."
    },
    {
      "label": "Benachrichtigt",
      "title": "Ihre Tools bleiben informiert",
      "text": "Auf Wunsch wird jede Entscheidung an Ihre eigenen Tools übermittelt: Ihre Teams sind informiert, ohne ihre Gewohnheiten zu ändern."
    }
  ],
  "testTitle": "Sehen Sie es zuerst an Ihren eigenen Kommentaren",
  "testText": "Wir testen OpenModeration mit Ihren echten Kommentaren, still und parallel zu Ihrem aktuellen Dienstleister, falls Sie einen haben. Sie vergleichen Entscheidung für Entscheidung, bevor Sie wählen.",
  "devEyebrow": "Für Entwickler",
  "devTitle": "Unter der Haube: die Pipeline in vier Stufen",
  "devLead": "Hinter den drei Schritten durchläuft jeder Kommentar vier technische Stufen. Das muss Ihr Technik-Team wissen.",
  "pipeline": [
    {
      "title": "Erfassung",
      "text": "Kommentare kommen über die API, einen Webhook oder einen Social-Media-Konnektor.",
      "tags": [
        "POST /v1/moderation",
        "Webhooks",
        "Facebook",
        "Instagram",
        "YouTube"
      ]
    },
    {
      "title": "KI-Moderation",
      "text": "Unsere KI analysiert den Kommentar; weitere Modelle prüfen heikle Fälle gegen.",
      "tags": [
        "OpenModeration-KI",
        "Gegenprüfung"
      ]
    },
    {
      "title": "Regeln und Aktionen",
      "text": "Ihre Regeln werden ausgewertet, dann laufen die Aktionen automatisch.",
      "tags": [
        "Ausblenden",
        "Zurückhalten",
        "Veröffentlichen",
        "Webhook"
      ]
    },
    {
      "title": "Menschliche Prüfung",
      "text": "Unser Team bearbeitet Zweifelsfälle; Sie können jederzeit eingreifen.",
      "tags": [
        "Unser Team",
        "Korrektur"
      ]
    }
  ],
  "stepLabel": "Stufe",
  "details": [
    {
      "title": "Kommentare kommen von überall",
      "text": "Senden Sie Kommentare über die REST-API, einen generischen Webhook oder die nativen Konnektoren, die Kommentare automatisch abrufen.",
      "points": [
        "API: POST /v1/moderation, einzeln oder im Stapel",
        "Webhooks: ein generischer Endpunkt empfängt und normalisiert externe Daten",
        "Konnektoren: Facebook, Instagram, YouTube und WordPress"
      ],
      "codeTitle": "Beispiel: ein Facebook-Kommentar"
    },
    {
      "title": "Die KI moderiert den Kommentar",
      "text": "Jeder Kommentar wird von unserer im Haus entwickelten Moderations-KI analysiert, eingestellt auf Ihre Regeln. Heikle Fälle werden von weiteren KI-Modellen gegengeprüft. Die Ergebnisse kommen in einem Standardformat zurück, mit Werten von 0,0 bis 1,0 pro Kategorie.",
      "points": [
        "Das Antwortformat ändert sich nie",
        "Kommt ein besseres Modell heraus, binden wir es ein: Für Sie ändert sich nichts"
      ],
      "codeTitle": "Standardisierte Antwort"
    },
    {
      "title": "Ihre Regeln greifen automatisch",
      "text": "Die Regeln kombinieren verbotene Wörter für eine sofortige Sperre, Schwellenwerte pro Kategorie und Regeln in Alltagssprache, die die KI im Kontext anwendet. Unser Team richtet sie mit Ihnen ein; Ihre Entwickler können sie auch über die API verwalten.",
      "points": [
        "Verbotene Wörter sperren einen Kommentar sofort, vor jedem KI-Aufruf",
        "Schwellenwerte pro Kategorie lösen Aktionen automatisch aus",
        "Regeln in Alltagssprache bestimmen den Ton Ihrer Bereiche"
      ],
      "codeTitle": "Konfiguration über die API"
    },
    {
      "title": "Alles wird protokolliert",
      "text": "Jede Entscheidung, ob von der KI oder von unserem Team, wird mit Begründung, Urheber und ausgeführten Aktionen protokolliert. Webhooks können Ihre Tools über jede informieren.",
      "points": [
        "Jede Korrektur wird mit Urheber und Begründung gespeichert",
        "Vollständiger Verlauf für Audits und DSA-Berichte"
      ],
      "codeTitle": "Audit-Trail für jeden Kommentar"
    }
  ],
  "rulesAlt": "Regeleinstellungen von OpenModeration: verbotene Wörter, Schwellenwerte pro Kategorie und Regeln in Alltagssprache",
  "rulesCaption": "Ihre Regeln, einmal eingestellt, auf jeder verbundenen Plattform angewendet.",
  "code": {
    "webhook": "Facebook sendet den Kommentar per Webhook",
    "rules": "Moderationsschwellen festlegen",
    "audit": "Vollständiger Audit-Trail für jeden Kommentar"
  }
};

const stepIcons = [
  "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1",
  "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
];
const outcomeStyles = [
  "bg-green-100 text-green-600",
  "bg-red-100 text-red-600",
  "bg-amber-100 text-amber-600",
  "bg-blue-100 text-blue-600"
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/de/so-funktioniert-es",
  "url": "https://www.openmoderation.com/de/so-funktioniert-es",
  "name": "So funktioniert es: Wir moderieren, Sie sehen alles",
  "description": "Sie verbinden Ihre Seiten, unsere KI und unser Team moderieren nach Ihren Regeln, Sie sehen jede Entscheidung mit Begründung in Echtzeit. Technik weiter unten.",
  "inLanguage": "de",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};

const facebookWebhookExample = `// Facebook sendet den Kommentar per Webhook
{
  "source": "facebook",
  "content_id": "comment_123",
  "author_id": "user_456",
  "text": "Comment text here...",
  "metadata": {"post_url": "..."}
}`;

const moderationResponseExample = `{
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const ruleConfigExample = `// Moderationsschwellen festlegen
PUT /v1/settings

{
  "thresholds": {
    "hate":       { "accepted": 0.3, "rejected": 0.7 },
    "harassment": { "accepted": 0.3, "rejected": 0.7 },
    "sexual":     { "accepted": 0.2, "rejected": 0.8 },
    "violence":   { "accepted": 0.3, "rejected": 0.7 },
    "self-harm":  { "accepted": 0.2, "rejected": 0.8 },
    "spam":       { "accepted": 0.4, "rejected": 0.8 }
  },
  "actions": {
    "on_reject": ["hide", "flag_for_review"]
  }
}`;

const auditTrailExample = `// Vollständiger Audit-Trail für jeden Kommentar
{
  "content_id": "...",
  "source": "webhook",
  "platform": "facebook",
  "status": "actioned",
  "moderation": {
    "flagged": true,
    "results": [...]
  },
  "actions": [{
    "rule": "Hide hate speech",
    "type": "hide",
    "status": "executed"
  }]
}`;
const codes = [facebookWebhookExample, moderationResponseExample, ruleConfigExample, auditTrailExample];
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Startseite", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- The promise in three steps -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mx-auto max-w-2xl text-center text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.stepsTitle}</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {c.steps.map((s, i) => (
          <li class="relative rounded-2xl border border-surface-200 bg-surface-50 p-8">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stepIcons[i]}/></svg>
            </div>
            <p class="text-sm font-semibold text-brand-600">{i + 1}</p>
            <h3 class="mt-1 text-xl font-semibold text-surface-900">{s.title}</h3>
            <p class="mt-3 text-surface-500">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mx-auto mt-10 max-w-2xl text-center text-surface-600">{c.stepsNote}</p>
    </div>
  </section>

  <!-- What happens to each comment -->
  <section id="action-engine" class="scroll-mt-24 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.outcomesTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.outcomesLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {c.outcomes.map((o, i) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <span class={`mb-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold ${outcomeStyles[i]}`}>{o.label}</span>
            <h3 class="font-semibold text-surface-900">{o.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{o.text}</p>
          </div>
        ))}
      </div>
      <div class="mx-auto mt-12 max-w-2xl rounded-2xl border border-brand-200 bg-white p-8 text-center">
        <h3 class="text-xl font-semibold text-surface-900">{c.testTitle}</h3>
        <p class="mt-2 text-surface-500">{c.testText}</p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section id="developers" class="scroll-mt-24 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{c.devEyebrow}</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-surface-900">{c.devTitle}</h2>
        <p class="mt-4 text-surface-500">{c.devLead}</p>
      </div>
      <div class="mb-16 grid grid-cols-2 gap-4 rounded-2xl border border-surface-200 bg-surface-50 p-6 lg:grid-cols-4">
        {c.pipeline.map((p, i) => (
          <div class="rounded-xl border border-surface-200 bg-white p-5 text-center">
            <p class="font-semibold text-surface-900">{i + 1}. {p.title}</p>
            <p class="mt-2 text-sm text-surface-500">{p.text}</p>
            <div class="mt-3 flex flex-wrap justify-center gap-2">
              {p.tags.map((tag) => <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">{tag}</span>)}
            </div>
          </div>
        ))}
      </div>
      <div class="space-y-16">
        {c.details.map((d, i) => (
          <div class="grid items-center gap-8 lg:grid-cols-2">
            <div class={i % 2 ? 'lg:order-2' : ''}>
              <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">{c.stepLabel} {i + 1}</span>
              <h3 class="text-2xl font-bold text-surface-900">{d.title}</h3>
              <p class="mt-4 text-surface-500">{d.text}</p>
              <ul class="mt-6 space-y-2 text-sm text-surface-600">
                {d.points.map((pt) => (
                  <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{pt}</span></li>
                ))}
              </ul>
            </div>
            <div class={i % 2 ? 'lg:order-1' : ''}>
              {i === 2 && (
                <div class="mb-4">
                  <BrowserFrame src="/images/rules.png" video="om-rules" alt={c.rulesAlt} caption={c.rulesCaption} eager={false} />
                </div>
              )}
              <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
                <p class="mb-3 text-sm font-semibold text-surface-900">{d.codeTitle}</p>
                <CodeBlock code={codes[i]} lang="json" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
