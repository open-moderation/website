---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'de';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Moderationskonsole: jede Entscheidung mit Begründung, live",
  "description": "Jeder Kommentar mit Entscheidung und Begründung in Echtzeit, auf Website und Social Media. Zweifelsfälle bearbeitet unser Team; Sie greifen bei Bedarf ein.",
  "crumb": "Moderationskonsole",
  "badge": "Was Sie in Echtzeit sehen",
  "h1": "Jede Entscheidung und ihre Begründung, in Echtzeit",
  "lead": "Die Konsole ist kein Werkzeug, das Sie bedienen müssen. Unsere KI und unser Team moderieren; Sie sehen jeden Kommentar, die Entscheidung, ihre schriftliche Begründung und wer sie getroffen hat, und können jederzeit korrigieren.",
  "feedTitle": "Ihre Moderation, live",
  "feedLead": "Die Kommentare Ihrer Website und Ihrer Seiten nebeneinander, jeder mit seiner Entscheidung und der Begründung dafür.",
  "quote": [
    "„",
    "“"
  ],
  "reasonLabel": "Begründung:",
  "overrideLabel": "Korrigieren",
  "feed": [
    {
      "platform": "Website",
      "kind": "published",
      "decision": "Veröffentlicht",
      "by": "Unsere KI",
      "text": "Guter Artikel, aber die Zahlen im zweiten Absatz wirken veraltet.",
      "reason": "Konstruktive Kritik, keine Regel verletzt."
    },
    {
      "platform": "Facebook",
      "kind": "refused",
      "decision": "Ausgeblendet",
      "by": "Unsere KI, gegengeprüft",
      "text": "Ihr seid alle korrupt, man sollte euch für immer zum Schweigen bringen.",
      "reason": "Drohung und persönlicher Angriff."
    },
    {
      "platform": "Instagram",
      "kind": "refused",
      "decision": "Ausgeblendet",
      "by": "Unsere KI",
      "text": "Günstige Follower hier, schaut auf mein Profil!!!",
      "reason": "Spam."
    },
    {
      "platform": "YouTube",
      "kind": "team",
      "decision": "Nach Prüfung abgelehnt",
      "by": "Unser Team",
      "text": "Typisch für diese Leute, die ändern sich nie.",
      "reason": "Pauschalisierung gegen eine Gruppe, entgegen Ihrer Netiquette."
    }
  ],
  "shotAlt": "OpenModeration-Konsole: Kommentare, Entscheidungen und schriftliche Begründungen, Plattform für Plattform",
  "shotCaption": "Die Konsole: Kommentare, Entscheidungen und Begründungen, Plattform für Plattform.",
  "illustrative": "Beispiele und Zahlen zur Veranschaulichung, aus einer Demo-Umgebung.",
  "kpis": [
    {
      "label": "Heute analysierte Kommentare",
      "value": "84,2 Tsd."
    },
    {
      "label": "Ausgeblendet, jeweils mit Begründung",
      "value": "4,7 %"
    },
    {
      "label": "Zweifelsfälle, von unserem Team bearbeitet",
      "value": "2 %"
    }
  ],
  "cardsTitle": "Was Sie sehen und was Sie tun können",
  "cardsLead": "Volle Transparenz, nichts zu bedienen. Sie greifen nur ein, wenn Sie möchten.",
  "cards": [
    {
      "title": "Jede Entscheidung mit Begründung",
      "text": "Jeder Kommentar, die getroffene Entscheidung und ihre schriftliche Begründung, auf Ihrer Website und jeder verbundenen Seite."
    },
    {
      "title": "Zweifelsfälle bearbeitet unser Team",
      "text": "Wenn die KI zögert, entscheidet unser Team nach Ihren Regeln. Sie sehen, was es bearbeitet hat und warum."
    },
    {
      "title": "Jederzeit korrigieren",
      "text": "Einen Kommentar mit einem Klick veröffentlichen, ausblenden oder wiederherstellen. Jede Änderung wird mit Urheber protokolliert."
    },
    {
      "title": "Meldungen und Beschwerden nachverfolgt",
      "text": "Nutzermeldungen und angefochtene Entscheidungen werden bis zur Antwort nachverfolgt, wie es der DSA verlangt."
    },
    {
      "title": "Exportierbare Zahlen",
      "text": "Volumen und Entscheidungen nach Kategorie, Plattform für Plattform. Exportieren Sie sie für DSA-Berichte und interne Auswertungen."
    },
    {
      "title": "Ihre Regeln im Blick",
      "text": "Sehen Sie, welche Regeln in Ihren Bereichen gelten. Für Änderungen sagen Sie es uns oder passen Sie sie selbst an: Unser Team hilft Ihnen."
    }
  ],
  "devTitle": "Für technische Teams",
  "devLead": "Die Konsole bietet Ihren Entwicklern auch alles, um OpenModeration zu integrieren und zu überwachen.",
  "devPoints": [
    "Zugriffsschlüssel mit Ratenlimits und Berechtigungen pro Schlüssel",
    "Aktivitätsprotokoll, durchsuchbar nach Kommentar: Scores, angewandte Regel und Ergebnis",
    "Servicestatus mit Latenz und Fehlerraten",
    "Datenaufbewahrung, erlaubte Ursprünge und Webhooks"
  ]
};

const decisionStyles: Record<string, string> = {
  published: 'bg-green-100 text-green-700',
  refused: 'bg-red-100 text-red-700',
  team: 'bg-amber-100 text-amber-700',
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/de/moderationskonsole",
  "url": "https://www.openmoderation.com/de/moderationskonsole",
  "name": "Moderationskonsole: jede Entscheidung mit Begründung, live",
  "description": "Jeder Kommentar mit Entscheidung und Begründung in Echtzeit, auf Website und Social Media. Zweifelsfälle bearbeitet unser Team; Sie greifen bei Bedarf ein.",
  "inLanguage": "de",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Startseite", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-accent-500"></span> {c.badge}
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- What you see: live feed -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.feedTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.feedLead}</p>
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <ul class="divide-y divide-surface-100 overflow-hidden rounded-2xl border border-surface-200 bg-white shadow-sm">
          {c.feed.map((f) => (
            <li class="p-5">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-surface-600">{f.platform}</span>
                <span class={`rounded-full px-2.5 py-0.5 font-semibold ${decisionStyles[f.kind]}`}>{f.decision}</span>
                <span class="text-surface-400">{f.by}</span>
              </div>
              <p class="mt-3 text-surface-800">{c.quote[0]}{f.text}{c.quote[1]}</p>
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
                <p class="text-surface-500"><span class="font-medium text-surface-700">{c.reasonLabel}</span> {f.reason}</p>
                <span class="rounded-md border border-surface-300 px-3 py-1 text-xs font-semibold text-surface-700">{c.overrideLabel}</span>
              </div>
            </li>
          ))}
        </ul>
        <div>
          <BrowserFrame src="/images/dashboard.png" video="om-triage" alt={c.shotAlt} caption={c.shotCaption} eager={false} />
          <p class="mt-6 text-center text-xs text-surface-400">{c.illustrative}</p>
        </div>
      </div>
      <dl class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {c.kpis.map((k) => (
          <div class="flex flex-col-reverse rounded-xl border border-surface-200 bg-surface-50 p-6">
            <dt class="mt-1 text-sm text-surface-500">{k.label}</dt>
            <dd class="text-3xl font-bold text-surface-900">{k.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- What you see and what you can do -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.cardsTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.cardsLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {c.cards.map((card) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{card.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.devTitle}</h2>
      <p class="mt-3 text-surface-500">{c.devLead}</p>
      <ul class="mt-6 space-y-2 text-sm text-surface-600">
        {c.devPoints.map((p) => (
          <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
