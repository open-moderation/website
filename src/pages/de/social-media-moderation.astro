---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Social-Media-Moderation mit KI: Facebook, Instagram, YouTube",
  "description": "Ein Tool für Social-Media-Moderation, das Hasskommentare, Spam und Betrugsversuche auf Facebook, Instagram und YouTube automatisch nach Ihren Regeln ausblendet, mit einer schriftlichen Begründung für jede Entscheidung.",
  "inLanguage": "de",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const platforms = [
  { name: "Facebook", href: "/de/integrationen/facebook-moderation", text: "Kommentare unter den Beiträgen Ihrer Seiten werden sofort beim Eingang analysiert. Was gegen Ihre Regeln verstößt, wird automatisch ausgeblendet." },
  { name: "Instagram", href: "/de/integrationen/instagram-moderation", text: "Kommentare unter Ihren Instagram-Beiträgen werden auf die gleiche Weise analysiert und ausgeblendet, wenn sie gegen Ihre Regeln verstoßen." },
  { name: "YouTube", href: "/de/integrationen/youtube-moderation", text: "Jeder Kommentar unter Ihren Videos wird veröffentlicht, zur Prüfung zurückgehalten oder abgelehnt, direkt über die YouTube-API." },
  { name: "WordPress", href: "/de/integrationen/wordpress-moderation", text: "Die Kommentare Ihrer Website werden freigegeben, zurückgehalten oder als Spam eingestuft, ohne dass Sie ein Plugin entwickeln müssen." },
];

const steps = [
  { title: "Verbinden Sie Ihre Konten", text: "Facebook, Instagram, YouTube oder WordPress sind mit wenigen Klicks verbunden, ganz ohne Entwickler." },
  { title: "Formulieren Sie Ihre Regeln", text: "Ihre Regeln in natürlicher Sprache, verbotene Wörter und ein Schwellenwert pro Kategorie. Mit einer ausgewogenen Voreinstellung können Sie sofort loslegen." },
  { title: "Die KI wendet Ihre Regeln an", text: "Was klar gegen Ihre Regeln verstößt, wird ausgeblendet, was in Ordnung ist, bleibt online, und Grenzfälle übernimmt unser Team." },
  { title: "Jede Entscheidung wird begründet", text: "Jede Entscheidung, ob automatisch oder menschlich, erhält eine schriftliche Begründung und bleibt im Audit-Trail gespeichert." },
];

const faqItems = [
  {
    question: "Welche sozialen Netzwerke kann OpenModeration moderieren?",
    answer: "Facebook, Instagram und YouTube sowie WordPress-Websites, dank nativer Konnektoren. Inhalte aus anderen Quellen können Sie über die REST-API oder Webhooks senden. Für TikTok, X und LinkedIn gibt es derzeit keinen nativen Konnektor.",
  },
  {
    question: "Muss man programmieren können, um seine sozialen Netzwerke mit OpenModeration zu moderieren?",
    answer: "Nein. Sie verbinden Ihre Konten, formulieren Ihre Regeln in natürlicher Sprache, und um den Rest kümmern wir uns. In der Moderationskonsole sehen Sie alles in Echtzeit und können jederzeit eingreifen. Die API brauchen Sie nur, wenn Sie eine eigene Plattform anbinden möchten.",
  },
  {
    question: "Werden Kommentare gelöscht oder ausgeblendet?",
    answer: "Auf Facebook und Instagram werden Kommentare, die gegen Ihre Regeln verstoßen, ausgeblendet. Auf YouTube werden sie abgelehnt oder zur Prüfung zurückgehalten. Auf WordPress werden sie zurückgehalten oder als Spam eingestuft. In allen Fällen bleiben die Entscheidung und ihre Begründung im Audit-Trail gespeichert.",
  },
  {
    question: "Was kostet ein Tool für Social-Media-Moderation wie OpenModeration?",
    answer: "Das kostenlose Angebot umfasst bis zu 1.000 Anfragen pro Monat, also etwa 30 Kommentare pro Tag. Das Pro-Angebot kostet 99 € pro Monat für 10.000 Anfragen. Für große Volumen stimmen wir ein individuelles Angebot mit Ihnen ab.",
  },
  {
    question: "Wo werden die Daten gehostet?",
    answer: "OpenModeration wird in der Europäischen Union entwickelt und gehostet und erfüllt die DSGVO. Eine On-Premise-Bereitstellung ist auf Anfrage möglich.",
  },
];
---

<BaseLayout title="Social-Media-Moderation mit KI: Tool ohne Code" description="Hasskommentare, Spam und Betrug auf Facebook, Instagram und YouTube automatisch nach Ihren Regeln ausblenden, jede Entscheidung begründet. Kostenlos starten." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Social-Media-Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Facebook • Instagram • YouTube • WordPress
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Social-Media-Moderation, automatisch und nachvollziehbar begründet</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Beleidigungen, Spam und Betrugsversuche sammeln sich rund um die Uhr unter Ihren Beiträgen. OpenModeration blendet sie automatisch nach Ihren Regeln aus, auf allen Ihren Konten gleichzeitig, und hält schriftlich fest, warum jeder Kommentar entfernt wurde.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Kostenlos testen</a>
        <a href="/de/so-funktioniert-es" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">So funktioniert es</a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Keine Kreditkarte erforderlich</p>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Was OpenModeration in jedem Netzwerk tut</h2>
        <p class="mt-4 text-lg text-surface-500">Eine einzige Konsole und dieselben Regeln für alle Ihre Konten. Welche Aktion angewendet wird, hängt davon ab, was die jeweilige Plattform zulässt.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {platforms.map((p) => (
          <a href={p.href} class="block rounded-xl border border-surface-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-lg font-semibold text-surface-900">{p.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{p.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Vier Schritte, keine Zeile Code</h2>
          <ol class="mt-8 space-y-4">
            {steps.map((s, i) => (
              <li class="flex items-start gap-4 rounded-lg border border-surface-200 bg-white p-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700">{i + 1}</span>
                <div>
                  <p class="text-sm font-medium text-surface-900">{s.title}</p>
                  <p class="mt-1 text-sm text-surface-500">{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <BrowserFrame caption="Ein ausgeblendeter Kommentar, die verletzte Regel und die schriftliche Begründung, sichtbar für Ihr ganzes Team.">
          <ModerationVerdict slot="content" />
        </BrowserFrame>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum ein eigenes Tool statt der integrierten Filter</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Der Kontext zählt, nicht nur die Wörter</h3>
          <p class="mt-2 text-sm text-surface-500">Eine Liste gesperrter Wörter übersieht Sarkasmus, verschleierte Beleidigungen und geschickt formulierten Betrug. KI-Modelle lesen den ganzen Satz und bewerten ihn im Licht Ihrer Regeln.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Eine Konsole für alle Ihre Konten</h3>
          <p class="mt-2 text-sm text-surface-500">Kein Wechseln mehr zwischen den Netzwerken: Die Entscheidungen zu Facebook, Instagram, YouTube und Ihrer Website erscheinen in Echtzeit in derselben Konsole.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Entscheidungen, die Sie begründen können</h3>
          <p class="mt-2 text-sm text-surface-500">Zu jedem entfernten Kommentar bleiben die Regel und die schriftliche Begründung erhalten. Widerspricht ein Follower, wissen Sie, was Sie ihm antworten, und der Audit-Trail ist bereit für den DSA.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Häufige Fragen zur Social-Media-Moderation" items={faqItems} />
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Weiterlesen</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/de/moderationsrichtlinien" class="font-medium text-brand-600 hover:text-brand-500">Moderationsrichtlinien: Leitfaden und Vorlage &rarr;</a></li>
        <li><a href="/de/anwendungsfaelle/medien" class="font-medium text-brand-600 hover:text-brand-500">Kommentarmoderation für Medien &rarr;</a></li>
        <li><a href="/de/alternativen/bodyguard" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration oder Bodyguard: der Vergleich &rarr;</a></li>
        <li><a href="/de/dsa-konformitaet/begruendung" class="font-medium text-brand-600 hover:text-brand-500">Die vom DSA verlangte Begründung &rarr;</a></li>
        <li><a href="/de/preise" class="font-medium text-brand-600 hover:text-brand-500">Die Preise &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Schützen Sie Ihre Social-Media-Kanäle in 5 Minuten." subtitle="Verbinden Sie Ihre Konten und formulieren Sie Ihre Regeln in natürlicher Sprache: Jeder ausgeblendete Kommentar erhält eine schriftliche Begründung." />
</BaseLayout>
