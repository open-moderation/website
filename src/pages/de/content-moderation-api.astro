---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/de/content-moderation-api",
      "url": "https://www.openmoderation.com/de/content-moderation-api",
      "name": "Content-Moderation-API: eine Integration, 10 Anbieter (2026)",
      "description": "Eine Content-Moderation-API für alle Anbieter: OpenAI, Mistral, Azure, Llama Guard und weitere. Standardisierte Moderations-Endpunkte, Vorfilterung, eigene Regeln und DSA-Audit-Trail.",
      "inLanguage": "de",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/content-moderation-api#software",
      "name": "OpenModeration API",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Beliebig (REST API)",
      "description": "Einheitliche Content-Moderation-API: ein Endpunkt, 10 Anbieter, eigene Moderationsregeln, Batch-Endpunkte und Audit-Trail.",
      "url": "https://www.openmoderation.com/de/content-moderation-api",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
    }
  ]
};

const quickstart = `# Text mit beliebigem Anbieter moderieren: gleiche Anfrage, gleiche Antwort
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "Ihr zu moderierender Text",
    "model": "openai/omni-moderation-latest",
    "categories": ["hate", "harassment", "sexual", "violence", "self-harm", "spam"],
    "threshold": 0.5
  }'

# Antwort (über alle Anbieter standardisiert)
{
  "flagged": false,
  "results": [{ "category": "hate", "score": 0.02, "flagged": false }],
  "usage": { "provider": "openai", "latency_ms": 243 }
}`;

const faqItems = [
  {
    question: "Was ist eine Content-Moderation-API?",
    answer: "Eine Content-Moderation-API bewertet nutzergenerierte Inhalte (Hassrede, Belästigung, sexuelle Inhalte, Gewalt, Spam, personenbezogene Daten …), damit Ihre Anwendung sie automatisch freigeben, markieren oder ablehnen kann. OpenModeration bündelt 10 Anbieter hinter einem Endpunkt mit standardisiertem Antwortformat."
  },
  {
    question: "Welche Moderations-API eignet sich am besten für Compliance im Unternehmen?",
    answer: "Für regulierte Plattformen empfiehlt sich ein Setup mit mehreren Anbietern: OpenAI für hohe Genauigkeit auf Englisch, Mistral oder Azure für EU-Sprachen und Compliance, dazu ein vollständiger Audit-Trail. OpenModeration routet jede Anfrage einzeln und protokolliert jede Entscheidung für DSA-Berichte."
  },
  {
    question: "Was kostet eine Moderations-API?",
    answer: "Der Moderations-Endpunkt von OpenAI ist kostenlos, Mistral legt den Preis für sein Moderationsmodell selbst fest, und Azure AI Content Safety berechnet pro 1.000 Textdatensätze, nach einem kostenlosen Kontingent von 5.000 Datensätzen pro Monat. OpenModeration ist selbst gehostet kostenlos. Die verwaltete Cloud beginnt bei 99 €/Monat für 10.000 Anfragen, und die Vorfilterung spart 10 bis 30 % der kostenpflichtigen Aufrufe ein."
  },
  {
    question: "Kann ich von OpenAI text-moderation-latest migrieren?",
    answer: "Ja. Ersetzen Sie openai.moderations.create durch einen einzigen POST /v1/moderation-Aufruf mit dem Modell openai/omni-moderation-latest. Behalten Sie Ihren OpenAI-Schlüssel (BYOK) und ergänzen Sie Fallback-Anbieter, ohne Code neu zu schreiben."
  },
  {
    question: "Kann ich eigene Moderationsregeln definieren?",
    answer: "Ja. Es gibt drei Werkzeuge: verbotene Wörter (sofortige Sperre), Schwellenwerte pro Kategorie (automatisch freigeben / prüfen / ablehnen) und Ihre Regeln in natürlicher Sprache, die LLMs für eigene Kategorien durchsetzen."
  },
  {
    question: "Wo finde ich die vollständige API-Referenz?",
    answer: "Die interaktive Referenz finden Sie unter api.openmoderation.com/docs (OpenAPI). Hier erhalten Sie zunächst Konzepte und Vergleiche, danach kopieren Sie das curl-Beispiel in Ihren Stack."
  },
];
---

<BaseLayout
  title="Content-Moderation-API: eine Integration, 10 Anbieter (2026)"
  description="Eine Moderations-API für OpenAI, Mistral, Azure, Llama Guard und mehr. Standardisierte Endpunkte, Vorfilterung, eigene Regeln, Batch und DSA-Audit-Trail."
  jsonLd={pageJsonLd}
>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Content-Moderation-API" }]} />

  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Für Entwickler: REST-API + Konsole
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Eine Content-Moderation-API.<br />Alle Anbieter.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Schluss mit dem ständigen Neuschreiben von Integrationen. Ein einziger <strong>Moderations-Endpunkt</strong> leitet an OpenAI,
        Mistral, Azure, Llama Guard und weitere Anbieter weiter, mit Vorfilterung, eigenen Regeln,
        Batch-Endpunkten und einem DSA-tauglichen Audit-Trail.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Kostenlosen API-Schlüssel holen
        </a>
        <a href="https://api.openmoderation.com/docs" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          Zur API-Dokumentation &rarr;
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Selbst gehostet kostenlos · Keine Kreditkarte · OpenAPI-Referenz</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Gleiche Anfrage, beliebiger Anbieter</h2>
          <p class="mt-4 text-lg text-surface-500">
            Wechseln Sie von <code class="text-sm">openai/omni-moderation-latest</code> zu
            <code class="text-sm">mistral/mistral-moderation-2411</code>, indem Sie ein einziges Feld ändern.
            Die Scores kommen in einem standardisierten Format zurück, mit Schwellenwerten, die Sie selbst festlegen.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Standardisierte Moderations-Endpunkte:</strong> Einzeltext und Batch (bis zu 10.000 Elemente), überall dasselbe Schema.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Vorfilterung:</strong> Offensichtlichen Spam und verbotene Wörter blockieren, bevor ein kostenpflichtiger Anbieteraufruf erfolgt.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Doppelte Schwellenwerte:</strong> automatisch freigeben, Graubereich → menschliche Prüfung, automatisch ablehnen.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>BYOK + Fallback:</strong> Ihre eigenen Schlüssel und automatisches Umleiten, wenn ein Anbieter langsam ist.</span></li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3 text-sm">
            <a href="/de/text-moderation-api" class="font-medium text-brand-600 hover:text-brand-500">Text-Moderation-API &rarr;</a>
            <a href="/de/alternativen/openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">Alternative zu OpenAI Moderation &rarr;</a>
            <a href="/de/alternativen/mistral-moderation" class="font-medium text-brand-600 hover:text-brand-500">Alternative zu Mistral Moderation &rarr;</a>
            <a href="/de/funktionen" class="font-medium text-brand-600 hover:text-brand-500">Alle API-Funktionen &rarr;</a>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={quickstart} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum Teams sich für eine einheitliche API entscheiden</h2>
        <p class="mt-4 text-lg text-surface-500">Ein roher Score eines Anbieters ist noch kein Moderationssystem.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Funktion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">API eines einzelnen Anbieters</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration API</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            <tr><td class="px-6 py-4 font-medium text-surface-900">Anbieter</td><td class="px-6 py-4 text-surface-500">1 (Lock-in)</td><td class="px-6 py-4">10: OpenAI, Mistral, Azure, Llama Guard, Perspective, Hive …</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Antwortformat</td><td class="px-6 py-4 text-surface-500">Proprietär, je nach Anbieter</td><td class="px-6 py-4">Standardisierte Scores + Urteil „flagged“</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Vorfilterung</td><td class="px-6 py-4 text-surface-500">Nein</td><td class="px-6 py-4">Ja, 10 bis 30 % weniger Anbieterkosten</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Eigene Regeln</td><td class="px-6 py-4 text-surface-500">Selbst bauen</td><td class="px-6 py-4">Verbotene Wörter, Schwellenwerte, LLM-Richtlinien</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Prüfung + Audit</td><td class="px-6 py-4 text-surface-500">Selbst bauen</td><td class="px-6 py-4">Konsole, Teamrollen, DSA-Export</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Dokumentation</td><td class="px-6 py-4 text-surface-500">Doku des Anbieters</td><td class="px-6 py-4"><a class="text-brand-600 hover:text-brand-500" href="https://api.openmoderation.com/docs">OpenAPI-Referenz &rarr;</a></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Starten Sie mit Ihrem Stack</h2>
        <p class="mt-4 text-lg text-surface-500">Migrieren Sie in weniger als einer Stunde, oder moderieren Sie Social-Media-Kommentare ganz ohne Code.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/de/alternativen/openai-moderation" class="rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <h3 class="font-semibold text-surface-900">Von OpenAI migrieren</h3>
          <p class="mt-2 text-sm text-surface-500">text-moderation- und omni-moderation-Aufrufe austauschen, Ihren Schlüssel behalten, Fallbacks ergänzen.</p>
        </a>
        <a href="/de/alternativen/mistral-moderation" class="rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <h3 class="font-semibold text-surface-900">Mistral behalten, 9 Anbieter dazunehmen</h3>
          <p class="mt-2 text-sm text-surface-500">EU-Sprachen an Mistral, Englisch an OpenAI: vollautomatisch geroutet.</p>
        </a>
        <a href="/de/anwendungsfaelle/soziale-plattformen" class="rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <h3 class="font-semibold text-surface-900">No-Code-Moderationsplattform</h3>
          <p class="mt-2 text-sm text-surface-500">Lieber mit Oberfläche? Steuern Sie alles aus der zentralen Moderationskonsole.</p>
        </a>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-4">
        <a href="/de/integrationen/facebook-moderation" class="text-sm font-medium text-brand-600 hover:text-brand-500">Tool zur Moderation von Facebook-Kommentaren &rarr;</a>
        <a href="/de/integrationen/instagram-moderation" class="text-sm font-medium text-brand-600 hover:text-brand-500">Automatische Instagram-Moderation &rarr;</a>
        <a href="/de/integrationen/wordpress-moderation" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderation von WordPress-Kommentaren &rarr;</a>
        <a href="https://api.openmoderation.com/docs" class="text-sm font-medium text-surface-500 hover:text-surface-700">Vollständige API-Referenz (api.openmoderation.com/docs) &rarr;</a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Content-Moderation-API: häufige Fragen" />
    </div>
  </section>

  <CTASection
    title="Eine Integration. Alle Moderationsanbieter."
    subtitle="API-Schlüssel holen, curl-Beispiel kopieren und Ihren ersten Text in wenigen Minuten moderieren, mit Audit-Trail vom ersten Tag an."
    buttonText="API kostenlos testen"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
