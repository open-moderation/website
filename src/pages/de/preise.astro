---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pricingJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "OpenModeration",
  "description": "Open-Source-Moderationsplattform mit kostenlosem Cloud-Tarif, Pro-Tarif für 99 €/Monat und Enterprise-Tarifen. Auch kostenlos zum Selbst-Hosten erhältlich.",
  "inLanguage": "de",
  "offers": [
    { "@type": "Offer", "name": "Free", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" },
    { "@type": "Offer", "name": "Pro", "price": "99", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" },
    { "@type": "Offer", "name": "Enterprise", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
  ]
};
---

<BaseLayout title="Preise: Free, Pro für 99 €/Monat oder kostenlos selbst hosten" description="Kostenlos starten mit 1.000 Anfragen/Monat, Pro für 99 €/Monat mit 10.000 Anfragen oder kostenlos selbst hosten. Transparente Preise ohne versteckte Kosten." jsonLd={pricingJsonLd}>
<Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Preise" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="flex items-center gap-1.5">
          
          In der EU entwickelt und gehostet
        </span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Einfache, transparente Preise</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Starten Sie kostenlos mit 1.000 Anfragen pro Monat, oder wechseln Sie zu Pro für das komplett verwaltete Angebot.
        Sie brauchen kein Verkaufsgespräch, und es gibt keine versteckten Kosten.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Free -->
        <div class="rounded-2xl border border-surface-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-surface-900">Free</h2>
              <p class="mt-1 text-xs text-surface-500">Verwaltete Cloud</p>
            </div>
            <span class="rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-700">Kostenlos</span>
          </div>
          <p class="mt-4 text-3xl font-bold text-surface-900">0 &euro;</p>
          <p class="mt-1 text-xs text-surface-500">Bis zu 1.000 Anfragen / Monat · ≈ 30 Kommentare/Tag</p>
          <ul class="mt-6 space-y-2 text-sm text-surface-600">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Alle Funktionen inklusive</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Eigene API-Schlüssel (BYOK)</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> In der EU gehostete Infrastruktur</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Community-Support</li>
          </ul>
          <a href="https://app.openmoderation.com/signup" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-surface-300 px-4 py-2.5 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Kostenlos starten
          </a>
          <p class="mt-3 text-center text-xs text-surface-400">Keine Kreditkarte erforderlich · Jederzeit kündbar</p>
        </div>

        <!-- Pro -->
        <div class="relative rounded-2xl border-2 border-brand-500 bg-white p-6 shadow-md lg:col-span-1">
          <div class="absolute -top-3 right-4 rounded-full bg-brand-600 px-2.5 py-0.5 text-[10px] font-semibold text-white">Beliebt</div>
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-surface-900">Pro</h2>
              <p class="mt-1 text-xs text-surface-500">Vollständig verwaltete Cloud</p>
            </div>
          </div>
          <p class="mt-4">
            <span class="text-3xl font-bold text-surface-900">99 &euro;</span>
            <span class="text-sm text-surface-400">/Monat</span>
          </p>
          <p class="mt-1">
            <span class="text-sm text-surface-400">990 &euro;</span>
            <span class="text-sm text-surface-400">/Jahr (Sie sparen ca. 17 %)</span>
          </p>
          <ul class="mt-6 space-y-2 text-sm text-surface-600">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Verwaltetes Hosting & Infrastruktur</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> 10.000 Anfragen/Monat inklusive · ≈ 300 Kommentare/Tag</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> In der EU gehostete Infrastruktur</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Anbieter-Schlüssel von der Plattform verwaltet</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Priorisierter Support & SLA</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Teamverwaltung & Analysen</li>
          </ul>
          <a href="https://app.openmoderation.com/signup" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
            Pro testen
          </a>
          <p class="mt-3 text-center text-xs text-surface-400">Keine Kreditkarte erforderlich · Jederzeit kündbar</p>
        </div>

        <!-- Enterprise -->
        <div class="rounded-2xl border border-surface-200 bg-ink-900 p-6 text-white shadow-sm lg:col-span-1">
          <h2 class="text-lg font-bold">Enterprise</h2>
          <p class="mt-1 text-xs text-surface-400">Individuell</p>
          <p class="mt-4 text-3xl font-bold">Auf Anfrage</p>
          <ul class="mt-6 space-y-2 text-sm text-surface-300">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Dedizierte Infrastruktur</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Individuelles SLA</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Unbegrenzte Anfragen</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Dedizierter Support-Engineer</li>
          </ul>
          <a href="mailto:contact@openmoderation.com" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-surface-900 shadow-sm transition hover:bg-surface-100">
            Kontakt aufnehmen
          </a>
        </div>
      </div>

      <!-- Self-hosted banner -->
      <div class="mx-auto mt-12 max-w-3xl rounded-xl border border-surface-200 bg-surface-50 p-6">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          </div>
          <div class="flex-1">
            <h3 class="text-base font-semibold text-surface-900">Lieber selbst hosten?</h3>
            <p class="mt-2 text-sm text-surface-500">
              Betreiben Sie OpenModeration kostenlos auf Ihrer eigenen Infrastruktur. Sie bekommen alle Funktionen ohne Nutzungsgrenze, und Ihre Daten bleiben bei Ihnen.
              Der Code ist Open Source unter AGPL v3, mit Docker läuft die Plattform in wenigen Minuten.
            </p>
            <p class="mt-2 text-sm">
              <code class="rounded bg-surface-200 px-2 py-0.5 font-mono text-xs text-surface-700">docker compose up</code>
            </p>
            <a href="https://github.com/open-moderation/open-moderation" class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-brand-600 transition hover:text-brand-500">
              Selbst gehostet bereitstellen
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- EU badge -->
      <div class="mx-auto mt-8 max-w-lg rounded-xl border border-surface-200 bg-surface-50 p-5 text-center">
        <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-surface-100 px-3 py-1 text-xs font-medium text-surface-600">
          <span class="flex items-center gap-1.5">
            
            In der EU entwickelt und gehostet
          </span>
        </div>
        <p class="text-sm text-surface-500">Alle SaaS-Tarife laufen auf Infrastruktur in europäischem Besitz. Ihre Daten verlassen die EU nicht, und die Verarbeitung ist DSGVO-konform.</p>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
