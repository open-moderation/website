---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/de/dsa-konformitaet",
  "url": "https://www.openmoderation.com/de/dsa-konformitaet",
  "name": "DSA-Konformität: Audit-Trail und Transparenz für die Moderation",
  "description": "Erfüllen Sie die Anforderungen des DSA und des britischen Online Safety Act mit OpenModeration. Audit-Trail, Transparenzberichte und volle Datensouveränität.",
  "inLanguage": "de",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const dsaExportExample = `{
  "period": {
    "from": "2026-01-01",
    "to": "2026-06-30"
  },
  "total_requests": 145230,
  "total_flagged": 12450,
  "by_category": [{
    "category": "hate",
    "count": 4200,
    "avg_score": 0.72
  }]
}`;
---

<BaseLayout title="DSA-Konformität: Audit-Trail & Transparenz der Moderation" description="Erfüllen Sie die Anforderungen von DSA und Online Safety Act mit OpenModeration: Audit-Trail, Transparenzberichte und volle Datensouveränität." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "DSA-Konformität" }]} />
<section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-700">
        <span class="flex items-center gap-1.5">
          
          In der EU entwickelt und gehostet
        </span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">DSA-Konformität</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Erfüllen Sie Ihre regulatorischen Pflichten mit einer Open-Source-Moderationsplattform.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Der DSA gilt bereits</h2>
          <p class="mt-4 text-lg text-surface-500">
            Der Digital Services Act (DSA) der EU gilt seit 2024 vollumfänglich. Er verpflichtet
            Dienste, die in der EU Nutzerinhalte hosten, auf Meldungen illegaler Inhalte zu reagieren, jede
            Moderationsentscheidung zu begründen und Nutzern den Widerspruch zu ermöglichen.
            Die Bußgelder können bis zu <strong>6 % des weltweiten Jahresumsatzes</strong> erreichen.
          </p>
          <p class="mt-4 text-lg text-surface-500">
            Der britische Online Safety Act sieht ähnliche Pflichten vor. Plattformen müssen <strong>nachweisen</strong>,
            dass sie moderieren, sonst drohen existenzbedrohende Strafen.
          </p>
          <div class="mt-8 rounded-lg border border-surface-200 bg-amber-50 p-4">
            <p class="text-sm text-amber-800">
              <strong>Achtung:</strong> Manuelle Moderationsteams lassen sich nicht so skalieren, dass sie die Anforderungen des DSA erfüllen.
              Automatisierte Moderation mit vollständigem Audit-Trail ist für Plattformen jeder Größe der einzig gangbare Weg.
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Vollständiger Audit-Trail</h3>
                <p class="mt-1 text-sm text-surface-500">Jede Moderationsaktion wird protokolliert: welcher Inhalt, welcher Anbieter, welche Scores, welche Entscheidung. Exportierbar für die DSA-Transparenzberichte.</p>
              </div>
            </div>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Datensouveränität</h3>
                <p class="mt-1 text-sm text-surface-500">Self-Hosting auf Ihrer Infrastruktur. Alle Daten bleiben unter Ihrer Kontrolle, ohne Datenverarbeitung durch Dritte. Unverzichtbar für die DSGVO-Konformität.</p>
              </div>
            </div>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Mehrsprachige Abdeckung</h3>
                <p class="mt-1 text-sm text-surface-500">Moderieren Sie Inhalte in jeder Sprache. Kombinieren Sie Anbieter für eine optimale Abdeckung der EU-Sprachen: Französisch an Mistral, Deutsch an OpenAI und so weiter.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Wie OpenModeration Sie bei der DSA-Konformität unterstützt</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artikel 16: Melde- und Abhilfeverfahren</h3>
          <p class="mt-2 text-sm text-surface-500">Automatische Markierung von Inhalten mit nachvollziehbarem Audit-Trail. Nutzer können benachrichtigt werden, wenn ihre Inhalte moderiert werden.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artikel 15: Transparenzberichte</h3>
          <p class="mt-2 text-sm text-surface-500">Exportierbare Analysen: Gesamtzahl moderierter Inhalte, ergriffene Maßnahmen, Genauigkeit der Anbieter. Bereit für die DSA-Transparenzberichte.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artikel 17: Begründung</h3>
           <p class="mt-2 text-sm text-surface-500">Jede Moderationsentscheidung wird schriftlich begründet, und das Audit-Log hält fest, ob sie automatisch oder von einem Moderator getroffen wurde.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artikel 20: Beschwerdesystem</h3>
          <p class="mt-2 text-sm text-surface-500">Die Prüfwarteschlange ermöglicht die menschliche Moderation von Grenzfällen. Jede Entscheidung wird für Prüfzwecke protokolliert.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Artikel 34: Risikobewertung</h3>
          <p class="mt-2 text-sm text-surface-500">Nutzungsanalysen und Vergleichsdaten der Anbieter helfen, die Wirksamkeit der Moderation zu bewerten und Lücken in der Abdeckung zu erkennen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Datenaufbewahrung</h3>
          <p class="mt-2 text-sm text-surface-500">Konfigurierbare Aufbewahrungsrichtlinien. Sie bestimmen, wie lange Eingabetexte und Protokolle gespeichert werden. Verschlüsselte Speicherung sensibler Inhalte.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-8">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <h2 class="text-2xl font-bold text-surface-900">Open Source ist DSA-fest</h2>
            <p class="mt-4 text-surface-600">
              Proprietäre Moderationsplattformen sind Blackboxes. Wie wollen Sie den Behörden nachweisen,
              dass Ihr Moderationssystem funktioniert, wenn Sie den Code nicht einsehen können?
            </p>
            <p class="mt-4 text-surface-600">
              OpenModeration ist vollständig Open Source (AGPL v3). Jede Zeile der Moderationslogik
              ist prüfbar, jede Entscheidung nachvollziehbar. Ihr Compliance-Team kann genau
              überprüfen, wie Inhalte moderiert werden.
            </p>
            <div class="mt-6 flex items-center gap-2 text-sm text-brand-700">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Keine Blackboxes. Keine Anbieterbindung. Volle Sicherheit gegenüber den Behörden.
            </div>
          </div>
          <div class="rounded-lg border border-brand-200 bg-white p-6">
            <h4 class="mb-2 text-sm font-semibold text-surface-900">Datenexport für den DSA</h4>
            <CodeBlock code={dsaExportExample} lang="json" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Weiterlesen</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/de/dsa-konformitaet/begruendung" class="font-medium text-brand-600 hover:text-brand-500">Die Begründung nach Artikel 17: Pflichten und Beispiel &rarr;</a></li>
        <li><a href="/de/blog/dsa-leitfaden-kmu" class="font-medium text-brand-600 hover:text-brand-500">Praxisleitfaden zum DSA für kleine und mittlere Plattformen &rarr;</a></li>
        <li><a href="/de/produkt/transparenz" class="font-medium text-brand-600 hover:text-brand-500">Jeder ausgeblendete Kommentar mit schriftlicher Begründung &rarr;</a></li>
        <li><a href="/de/preise" class="font-medium text-brand-600 hover:text-brand-500">Kostenlos starten, upgraden, wenn Sie wachsen &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
