    { eyebrow: "Integration", title: "Facebook-Moderation", text: "Kommentare unter den Beiträgen Ihrer Kommune.", href: "/de/integrationen/facebook-moderation" },
  ]}
  ctaTitle="Eine offene Debatte, ohne Beleidigungen."
