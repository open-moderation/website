---
import { bookingUrl } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Content Moderation für Enterprise-SaaS | OpenModeration",
  "description": "Erfüllen Sie die Compliance-Anforderungen großer Unternehmen mit begründeter, in der EU gehosteter Moderation. Bereit für DSA und SOC 2, mit vollständigem Audit-Trail und Dashboards für die Teamverwaltung.",
  "inLanguage": "de"
};

---

<BaseLayout title="Enterprise Content Moderation: EU-Hosting, DSA-konform" description="Content Moderation auf Enterprise-Niveau für B2B-SaaS-Plattformen. In der EU gehostet, DSA-konform, bereit für SOC 2, mit Audit-Trail und Datenexport." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Anwendungsfälle", href: "/de/anwendungsfaelle" }, { label: "Enterprise-SaaS" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Anwendungsfall</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Content Moderation für Enterprise-SaaS</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">Erfüllen Sie strenge Compliance-Anforderungen im Enterprise-Umfeld mit einer vollständigen KI-Moderationsplattform, die jede Entscheidung schriftlich begründet und lückenlos protokolliert.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/de/termin-vereinbaren" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Termin vereinbaren</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Kostenlos testen</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Die Herausforderung</h3>
          <p class="mt-2 text-sm text-surface-600">B2B-SaaS-Plattformen mit nutzergenerierten Inhalten stehen unter dem Druck strenger Regulierung und anspruchsvoller Unternehmenskunden. Manuelle Moderation ist kaum nachvollziehbar, und reine Cloud-Tools erfüllen die Anforderungen an Datensouveränität nicht.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">Die Lösung von OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">Ein Moderationssystem, das jede Entscheidung schriftlich begründet und in der EU gehostet wird. Unser Team richtet es mit Ihnen ein, nach Ihren eigenen Compliance-Regeln, und übernimmt die Zweifelsfälle. Ihr Trust-&-Safety-Team sieht jede Entscheidung in Echtzeit in einem Dashboard mit vollständigem Audit-Trail.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Das Ergebnis</h3>
          <p class="mt-2 text-sm text-surface-600">Gewinnen Sie Enterprise-Kunden mit Überzeugung. Belegen Sie Ihre Bereitschaft für DSA und SOC 2 mit unveränderlichen Protokollen, behalten Sie die Kontrolle über Ihre Daten, mit EU-Hosting und Export jederzeit, und skalieren Sie die Moderation, ohne bei der Sicherheit Abstriche zu machen.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Enterprise-Compliance ist nicht verhandelbar</h2>
          <p class="mt-4 text-lg text-surface-500">Unternehmenskunden verlangen eine nachweisbare, prüfbare Moderation, und die Regulierungsbehörden schreiben sie vor. OpenModeration wurde von Grund auf für diese Standards entwickelt.</p>
          <div class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">EU</p>
              <p class="text-xs text-surface-500">Hosting in der Europäischen Union</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">Jede</p>
              <p class="text-xs text-surface-500">Entscheidung schriftlich begründet</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">&lt;300 ms</p>
              <p class="text-xs text-surface-500">P50-Latenz pro Anfrage</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">10K</p>
              <p class="text-xs text-surface-500">Inhalte pro Batch-Anfrage</p>
            </div>
          </div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
              <h3 class="font-semibold text-surface-900">Moderationskonsole</h3>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-700"><span class="flex h-1.5 w-1.5 rounded-full bg-accent-500"></span> Alle Anbieter in Betrieb</span>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Anfragen heute</p>
                <p class="mt-1 text-xl font-bold text-surface-900">84,2K</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Markierungsquote</p>
                <p class="mt-1 text-xl font-bold text-surface-900">4,7 %</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">P50-Latenz</p>
                <p class="mt-1 text-xl font-bold text-surface-900">267 ms</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Audit-Exporte</p>
                <p class="mt-1 text-xl font-bold text-surface-900">12</p>
              </div>
            </div>
            <div class="mt-4 rounded-lg border border-surface-200 bg-white">
              <div class="flex items-center justify-between border-b border-surface-200 px-4 py-2 text-xs font-semibold text-surface-500">
                <span>AUDIT-TRAIL</span>
                <span class="text-accent-600">DSA-Export bereit</span>
              </div>
              <ul class="divide-y divide-surface-100 text-xs">
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXK4&hellip;</span>
                  <span class="text-surface-600">hate <strong class="text-surface-900">0,91</strong> &rarr; gelöscht</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">auto</span>
                </li>
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXJ9&hellip;</span>
                  <span class="text-surface-600">harassment <strong class="text-surface-900">0,58</strong> &rarr; Prüfung</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">gegengeprüft</span>
                </li>
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXH2&hellip;</span>
                  <span class="text-surface-600">flagged: false</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">auto</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
              <h3 class="font-semibold text-surface-900">Kontrolle über die Datenaufbewahrung</h3>
              <p class="mt-2 text-sm text-surface-500">Konfigurierbare Aufbewahrungsfristen von 0, 7, 30 oder 90 Tagen. Verschlüsselte Speicherung sensibler Inhalte. Vollständige Löschung auf Anfrage.</p>
            </div>
            <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
              <h3 class="font-semibold text-surface-900">Bereit für SOC 2</h3>
              <p class="mt-2 text-sm text-surface-500">Audit-Logs, Zugriffskontrollen sowie Verschlüsselung im Ruhezustand und bei der Übertragung. Ausgelegt auf SOC-2-Zertifizierungsprozesse.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 text-center">Häufige Fragen zur Enterprise-Moderation</h2>
        <div class="mt-8 divide-y divide-surface-200">
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Können wir OpenModeration komplett on-premise betreiben, einschließlich der KI?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Eine On-Premise-Bereitstellung ist auf Anfrage möglich: <a href={bookingUrl('de')} class="font-medium text-brand-600 hover:text-brand-500" target="_blank" rel="noopener noreferrer">sprechen wir darüber</a>. Wir prüfen gemeinsam Ihre Sicherheitsanforderungen, auch die Frage, wo die KI-Modelle laufen.</p>
          </details>
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Wie unterstützt OpenModeration bei SOC-2- und DSA-Audits?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Jede Moderationsentscheidung, ob von der KI oder von einem Menschen getroffen, wird mit Anbieter, Scores, angewandter Regel, Aktion und Zeitstempel protokolliert. Analyse-Endpunkte liefern die aggregierten Zahlen für die DSA-Transparenzberichte, und die Aufbewahrungsfristen lassen sich je nach Anforderung konfigurieren.</p>
          </details>
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Wie verwalten wir den Zugriff über Teams und Kunden hinweg?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Workspaces trennen Inhalte und Konfiguration pro Team oder Mandant. Admins vergeben API-Schlüssel mit begrenztem Geltungsbereich und eigenen Rate Limits, und das Dashboard verwaltet Rollen und Berechtigungen Ihrer Nutzer.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Weiterführende Ressourcen</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/de/blog/dsa-leitfaden-kmu" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Leitfaden</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA-Konformität für kleine und mittlere Plattformen</h3>
          <p class="mt-2 text-sm text-surface-500">Praktische Schritte, mit denen SaaS-Plattformen die DSA-Anforderungen 2026 erfüllen.</p>
        </a>
        <a href="/de/alternativen/azure-content-safety" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Vergleich</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">OpenModeration vs. Azure Content Safety</h3>
          <p class="mt-2 text-sm text-surface-500">Warum eine Moderationsplattform mit Begründungen und Audit-Trail für Enterprise-Compliance mehr leistet als eine reine API.</p>
        </a>
        <a href="/de/funktionen" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Plattform</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Alle Funktionen entdecken</h3>
          <p class="mt-2 text-sm text-surface-500">Lernen Sie die Action Engine, die Teamverwaltung und die automatisierten Workflows kennen.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Gewinnen Sie Enterprise-Kunden mit nachweisbarer Moderation."
    subtitle="Hosten Sie die gesamte Plattform selbst, behalten Sie 100 % Datensouveränität und gehen Sie mit unveränderlichen Protokollen in jedes Audit. Sprechen Sie mit uns oder deployen Sie in wenigen Minuten."
    buttonText="Kostenlos testen"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
