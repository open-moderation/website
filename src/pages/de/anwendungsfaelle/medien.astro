---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import BrowserFrame from '../../../components/BrowserFrame.astro';
import ClientLogos from '../../../components/ClientLogos.astro';
import FAQ from '../../../components/FAQ.astro';

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Kommentarmoderation für Medienhäuser und Nachrichtenseiten",
  "description": "KI-Kommentarmoderation für Nachrichtenseiten und Redaktionen: Ihre redaktionellen Regeln bei jedem Artikel durchgesetzt, eine schriftliche Begründung für jeden entfernten Kommentar, Zweifelsfälle übernimmt unser Team, und ein DSA-Audit-Trail.",
  "inLanguage": "de",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const faqItems = [
  {
    question: "Müssen Nachrichtenseiten für ihre Kommentarbereiche den DSA einhalten?",
    answer: "Kommentarbereiche enthalten Inhalte, die von Lesern veröffentlicht werden. Eine Nachrichtenseite, die solche Bereiche betreibt, ist daher im Sinne des Digital Services Act ein Hosting-Dienst. Artikel 17 verlangt eine klare Begründung, sobald ein Kommentar entfernt oder eingeschränkt wird, einschließlich der Angabe, ob automatisierte Mittel eingesetzt wurden. OpenModeration verfasst diese Begründung für jede Entscheidung und bewahrt sie im Audit-Trail auf.",
  },
  {
    question: "Können wir nach unseren eigenen redaktionellen Regeln moderieren?",
    answer: "Ja. Sie formulieren Ihre Regeln in natürlicher Sprache, und OpenModeration wendet sie auf jeden Kommentar an. Das Sportressort und das Politikressort können unterschiedliche Regeln haben, und Sie können jede Regel jederzeit ohne Code verschärfen oder lockern.",
  },
  {
    question: "Was passiert mit Kommentaren im Graubereich?",
    answer: "Jede Kategorie hat zwei Schwellenwerte. Eindeutige Verstöße werden automatisch ausgeblendet, eindeutig zulässige Kommentare werden veröffentlicht, und alles dazwischen prüft unser Team. Ihre Redaktion sieht jede Entscheidung in Echtzeit und kann jederzeit mit einem Klick eingreifen.",
  },
  {
    question: "Können Journalisten weiterhin direkt auf der Artikelseite moderieren?",
    answer: "Ja. Die Entscheidungen Ihrer Redaktion werden in derselben Aktivitätshistorie erfasst wie die automatischen Entscheidungen. So haben Sie ein einziges, vollständiges Protokoll darüber, wer was warum entschieden hat.",
  },
  {
    question: "Wo werden die Daten gehostet?",
    answer: "OpenModeration wird in der Europäischen Union entwickelt und gehostet und ist DSGVO-konform. Sie können Ihre Daten jederzeit exportieren, und eine On-Premise-Bereitstellung ist auf Anfrage möglich.",
  },
];
---

<BaseLayout title="Kommentarmoderation für Medienhäuser | OpenModeration" description="Moderieren Sie Leserkommentare mit KI nach Ihren redaktionellen Regeln. Begründung für jede Löschung, Prüfwarteschlange und DSA-Audit-Trail. EU-Hosting." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Anwendungsfälle", href: "/de/anwendungsfaelle" }, { label: "Medienhäuser" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Anwendungsfall
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Kommentarmoderation für Medienhäuser</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Leserkommentare machen einen Artikel lebendig, bis Beleidigungen und Spam die Diskussion übernehmen. OpenModeration wendet Ihre redaktionellen Regeln auf jeden Kommentar an, begründet jede Löschung schriftlich und überlässt die schwierigen Fälle Ihrer Redaktion.
      </p>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Die Herausforderung</h3>
          <p class="mt-2 text-sm text-surface-600">Eine viel besuchte Nachrichtenseite erhält rund um die Uhr Kommentare, mit Spitzen bei jeder Eilmeldung. Journalisten können sie nicht alle lesen, und Keyword-Filter übersehen Sarkasmus, verschlüsselte Beleidigungen und themenfremde Angriffe, während sie berechtigte Kritik blockieren.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">Der Ansatz von OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">Kontextbewusste KI prüft jeden Kommentar anhand Ihrer Regeln. Eindeutige Verstöße werden sofort ausgeblendet, zulässige Kommentare gehen online, und Grenzfälle prüft unser Team, mit der betroffenen Regel und einer schriftlichen Begründung.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Das Ergebnis</h3>
          <p class="mt-2 text-sm text-surface-600">Ihre Redaktion muss nichts tun: Die Kommentare, die ein menschliches Urteil brauchen, übernimmt unser Team, und Sie können jederzeit eingreifen. Jede Entscheidung, ob automatisch oder redaktionell, wird mit ihrer Begründung protokolliert und ist bereit für den Einspruch eines Lesers oder eine Anfrage der Aufsichtsbehörde.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Gemacht für die Arbeitsweise von Redaktionen</h2>
          <p class="mt-4 text-lg text-surface-500">
            Einen Kommentarbereich zu moderieren, ist eine redaktionelle Entscheidung. Mit OpenModeration behält Ihr Team die Kontrolle und wird von der Routinearbeit entlastet.
          </p>
          <div class="mt-8 space-y-3">
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Ihre Regeln, in natürlicher Sprache</p>
              <p class="mt-1 text-xs text-surface-500">Schreiben Sie die Regeln, die Ihre Leser bereits kennen. Sie pflegen keine Keyword-Listen und müssen keinen Code anpassen, wenn sich die Grenze verschiebt.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Ein Graubereich für das menschliche Urteil</p>
              <p class="mt-1 text-xs text-surface-500">Zwei Schwellenwerte pro Kategorie trennen, was automatisch ausgeblendet wird, von dem, was unser Team prüft. Sie bestimmen, wie breit der Graubereich ist.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Eine Historie für KI- und Redaktionsentscheidungen</p>
              <p class="mt-1 text-xs text-surface-500">Löschungen durch Journalisten stehen im Aktivitätsprotokoll neben den automatischen, mit dem verantwortlichen Moderator und der Begründung.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Artikelkommentare und Social-Media-Seiten zusammen</p>
              <p class="mt-1 text-xs text-surface-500">Moderieren Sie Ihre Website über die API oder den WordPress-Konnektor und die Kommentare unter Ihren Beiträgen auf Facebook, Instagram und YouTube in derselben Konsole.</p>
            </div>
          </div>
        </div>
        <BrowserFrame
          src="/images/dashboard.png"
          video="om-triage"
          alt="Moderationswarteschlange von OpenModeration mit Leserkommentaren, ihrem Status und der ergriffenen Maßnahme"
          caption="Die Prüfwarteschlange: jeder Kommentar mit seinem Status, der betroffenen Regel und der schriftlichen Begründung."
        />
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum Medienhäuser sich für OpenModeration entscheiden</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Eine Begründung für jede Löschung</h3>
          <p class="mt-2 text-sm text-surface-500">Der DSA verpflichtet Hosting-Dienste, jede Entfernung zu begründen. OpenModeration verfasst diese Begründung automatisch, sodass Leser wissen, gegen welche Regel sie verstoßen haben.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">In der EU entwickelt und gehostet</h3>
          <p class="mt-2 text-sm text-surface-500">Die Daten Ihrer Leser bleiben in Europa, und die Plattform ist DSGVO-konform. Wenn Ihre Rechtsabteilung es verlangt, ist auf Anfrage auch eine On-Premise-Bereitstellung möglich.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Nachvollziehbar statt Blackbox</h3>
          <p class="mt-2 text-sm text-surface-500">Jede Entscheidung ist schriftlich begründet und im vollständigen Audit-Trail festgehalten. Sie sehen, wie Entscheidungen zustande kommen, und profitieren von jedem neuen KI-Modell, das wir anbinden, ohne Ihre Integration neu zu schreiben.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Häufig gestellte Fragen" items={faqItems} />
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Weiterführende Ressourcen</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/de/dsa-konformitaet" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Regulierung</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA-Konformität</h3>
          <p class="mt-2 text-sm text-surface-500">Was der Digital Services Act von Websites mit Kommentarfunktion verlangt und wie Sie die Anforderungen erfüllen.</p>
        </a>
        <a href="/de/produkt/transparenz" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Plattform</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Jede Entscheidung begründet</h3>
          <p class="mt-2 text-sm text-surface-500">Wie OpenModeration für jede Moderationsentscheidung eine Begründung verfasst.</p>
        </a>
        <a href="/de/integrationen/wordpress-moderation" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Integration</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Kommentarmoderation für WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Moderieren Sie die Kommentare einer WordPress-Nachrichtenseite, ohne eine Zeile Code zu schreiben.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection title="Geben Sie Ihren Kommentarbereich den Lesern zurück." subtitle="Formulieren Sie Ihre Regeln, verbinden Sie Ihre Website und lassen Sie Ihre Redaktion sich auf die Kommentare konzentrieren, die eine menschliche Entscheidung brauchen." />
</BaseLayout>
