---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModerationDemo from '../../components/ModerationDemo.astro';
import { BOOKING_URL, useTranslations } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';
import CharterSupport from '../../components/CharterSupport.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import ValueCards from '../../components/ValueCards.astro';
import AppVideo from '../../components/AppVideo.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "inLanguage": "de",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/#software",
      "name": "OpenModeration",
      "applicationCategory": "SecurityApplication",
      "operatingSystem": "Linux, Docker",
      "description": "Open-Source-Moderationsplattform für Kommentare und Social-Media-Seiten. Eine API für mehrere KI-Anbieter, Regeln in Alltagssprache, eine schriftliche Begründung für jede Entscheidung und ein DSA-Prüfprotokoll.",
      "inLanguage": "de",
      "url": "https://www.openmoderation.com",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Moderierte Kommentare pro Tag", value: "10 Mio.+" },
  { label: "Startklar in", value: "5 Min." },
  { label: "Automatische Moderation", value: "24/7" },
  { label: "Entscheidungen schriftlich begründet", value: "100 %" },
];

const valueItems = [
  { title: "Ihre Regeln, Ihre Anwendungsfälle", text: "Wir passen die Moderation an Ihre Regeln an und an das, was in Ihrem Kontext zählt: Ironie, Politik, Wettbewerber, regionaler Slang. Nichts von der Stange." },
  { title: "Ein Team hinter dem Tool", text: "Wir helfen Ihnen, Ihre Regeln zu formulieren und zu verfeinern, prüfen Zweifelsfälle gemeinsam mit Ihnen und passen alles an, wenn sich Ihre Community verändert. Sie haben immer einen persönlichen Ansprechpartner." },
  { title: "Alles läuft automatisch", text: "Sobald die Regeln stehen, wird jeder Kommentar innerhalb von Sekunden bearbeitet, rund um die Uhr. Ihr Team sieht nur die Fälle, bei denen ein Mensch gefragt ist." },
  { title: "Deutlich günstiger als von Hand", text: "Automatische Moderation kostet nur einen Bruchteil eines externen oder internen Moderationsteams." },
];


const faqItems = [
  {
    question: 'Welche Moderationsplattform vereint Moderationskonsole, kontextbezogene KI und Audit-Logs für die Compliance?',
    answer: 'OpenModeration bringt alle drei zusammen. Eine kontextbezogene KI liest jeden Kommentar, Ihre Regeln entscheiden, was ausgeblendet, veröffentlicht oder zur Prüfung weitergeleitet wird, Ihr Moderationsteam arbeitet in einer einzigen Konsole, und jede Entscheidung wird mit schriftlicher Begründung für DSA-Prüfungen protokolliert.',
  },
  {
    question: 'Gibt es ein No-Code-Tool, mit dem ich Moderationsregeln schreiben, KI-Klassifizierung nutzen und einen Audit-Trail führen kann?',
    answer: 'Ja. In OpenModeration formulieren Sie Ihre Regeln in natürlicher Sprache und legen Schwellenwerte pro Kategorie fest, ganz ohne Code. Die KI-Klassifizierung läuft über jeden Kommentar, und das Aktivitätsprotokoll hält jede Aktion fest: wer oder was sie ausgelöst hat und warum.',
  },
  {
    question: 'Kann ich Facebook, Instagram, YouTube und meine Website an einem Ort moderieren?',
    answer: 'Ja. Verbinden Sie Ihre Facebook-Seiten, Instagram-Konten, YouTube-Kanäle und Ihre WordPress-Website, oder senden Sie Inhalte von jeder beliebigen Plattform über die API. Alles landet in derselben Prüfwarteschlange und unterliegt denselben Regeln.',
  },
  {
    question: 'Worauf sollte ich bei einer Moderations-API für Compliance im Unternehmen achten?',
    answer: 'Achten Sie auf eine schriftliche Begründung für jede Entscheidung (nach Artikel 17 des DSA vorgeschrieben), ein vollständiges Audit-Log, Datenhosting in der EU, konfigurierbare Aufbewahrungsfristen und die Möglichkeit zum Self-Hosting. OpenModeration erfüllt alle fünf Punkte und ist Open Source unter AGPL v3, sodass sich die Entscheidungslogik prüfen lässt.',
  },
  {
    question: 'Ist OpenModeration kostenlos?',
    answer: 'Der Cloud-Tarif ist bis 1.000 Anfragen pro Monat kostenlos, der Pro-Tarif kostet 99 € pro Monat für 10.000 Anfragen, und die selbst gehostete Version ist kostenlos, weil der Code Open Source ist.',
  },
];
---

<BaseLayout
  title="KI-Kommentarmoderation, DSA-konform | OpenModeration"
  description="KI-Kommentarmoderation nach Ihren Regeln und Anwendungsfällen, auf Website und Social Media. DSA-konform, in der EU gehostet, mit persönlicher Begleitung."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-violet-50" />
    <div class="joy-blob pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-300/40 blur-3xl" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute -right-24 top-10 h-[28rem] w-[28rem] rounded-full bg-violet-300/40 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-sun-300/30 blur-3xl" style="animation-delay:-12s" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16">
      <div class="text-center lg:text-left">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Für Medien, Marken und Social-Media-Seiten
        </div>
        <h1 class="animate-fade-in-up text-4xl font-extrabold leading-[1.05] tracking-tight text-surface-900 sm:text-5xl lg:text-[3.7rem]">
          Moderation, die sich an <em>Ihre</em> Regeln anpasst.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-600 sm:text-xl">
          Wir richten die KI nach Ihren Regeln und Anwendungsfällen ein, unser Team begleitet Sie,
          und jeder Kommentar wird automatisch bearbeitet, für deutlich weniger als manuelle Moderation.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Termin vereinbaren
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Kostenlos testen
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">Oder testen Sie gleich einen Kommentar, ohne Anmeldung</a></p>
        <div class="animate-fade-in-up delay-2 mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-surface-500 lg:justify-start">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            In der EU entwickelt und gehostet
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            DSGVO-konform
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Persönlicher Support inklusive
          </span>
        </div>
      </div>
      <HeroAnimation />
    </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderation, die für Sie eingerichtet wird, statt eines Tools, mit dem Sie allein bleiben</h2>
      </div>
      <ValueCards items={valueItems} />
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Termin vereinbaren und es an Ihren Kommentaren sehen</a>
      </div>
    </div>
  </section>

  <AppVideo />

  <section id="demo" class="bg-gradient-to-br from-violet-50 via-white to-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Problem / Solution -->
  <section class="bg-gradient-to-br from-rose-50 via-white to-sun-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-rose-500 px-3 py-1 text-xs font-semibold text-white shadow-sm">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-white" />
            Das Problem
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            Hasskommentare vertreiben Ihre Community.
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Beleidigungen, Spam und Betrugsversuche stapeln sich unter Ihren Beiträgen, auf jeder
            Plattform und jeden Tag. Die eingebauten Filter übersehen Sarkasmus, verschlüsselte Sprache
            und alles Mehrsprachige, und das manuelle Aufräumen kostet mehr als 10 Stunden pro Woche.
          </p>
          <p class="mt-4 text-lg text-surface-500">
            OpenModeration setzt Ihre Regeln auf Facebook, Instagram, YouTube und WordPress
            automatisch durch und liefert zu jedem ausgeblendeten Kommentar eine schriftliche Begründung.
          </p>
          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Vorher:</strong> Hasskommentare von Hand lesen, sortieren und löschen, auf jeder Plattform und jeden Tag.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Nachher:</strong> Ihre Regeln werden auf Facebook, Instagram, YouTube und WordPress automatisch durchgesetzt. Zu jedem ausgeblendeten Kommentar gibt es eine schriftliche Begründung.</p>
            </div>
          </div>
          <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
              Kostenlos testen
            </a>
            <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
              Termin vereinbaren
            </a>
          </div>
        </div>
        <BrowserFrame
          caption="Ein ausgeblendeter Kommentar, die verletzte Regel und die schriftliche Begründung: für Ihr Team sichtbar und gegenüber jedem vertretbar."
        >
          <ModerationVerdict slot="content" />
          <div slot="annotation" class="absolute bottom-3 right-3 rounded-full border border-brand-200 bg-white/95 px-3 py-1 text-xs font-semibold text-brand-800 shadow-sm">
            &#x270D; Die schriftliche Begründung
          </div>
        </BrowserFrame>
      </div>
    </div>
  </section>

  <!-- Beyond the API -->
  <section class="bg-white py-20 border-t border-surface-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          Ein Keyword-Filter allein reicht nicht
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          Ihre Regeln müssen überall gelten, Grenzfälle gehören zu Ihrem Team, und jede Entscheidung braucht eine Begründung.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-rose-100 bg-rose-50/70 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Nur eine Moderations-API
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Rohe Scores ohne Gesprächskontext</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Keine Oberfläche, in der menschliche Moderatoren Grenzfälle prüfen können</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Keine eingebaute Verwaltung von Nutzermeldungen oder Teamrollen</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Compliance und Audit-Trail bleiben komplett Ihnen überlassen</li>
          </ul>
        </div>
        <div class="lift rounded-2xl border border-mint-100 bg-gradient-to-br from-mint-50 to-white p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Mit OpenModeration
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Die <strong>KI liest den Kontext</strong> und erkennt Zwischentöne, die eine starre Wortliste übersieht.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Ihr Trust-&-Safety-Team prüft Grenzfälle in einer <strong>eigenen Oberfläche</strong>.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Sie verwalten <strong>Meldungen, Rollen und Berechtigungen</strong> direkt in der Plattform.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Jede Entscheidung, ob von Mensch oder KI, wird für behördliche Prüfungen <strong>protokolliert</strong>.</li>
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/de/integrationen/facebook-moderation" class="text-sm font-medium text-brand-600 hover:text-brand-500">Tool zur Moderation von Facebook-Kommentaren &rarr;</a>
        <a href="/de/integrationen/instagram-moderation" class="text-sm font-medium text-brand-600 hover:text-brand-500">Automatische Instagram-Moderation &rarr;</a>
        <a href="/de/moderationskonsole" class="text-sm font-medium text-brand-600 hover:text-brand-500">Zentrale Moderationskonsole &rarr;</a>
        <a href="/de/anwendungsfaelle/medien" class="text-sm font-medium text-brand-600 hover:text-brand-500">Kommentarmoderation für Medienhäuser &rarr;</a>
        <a href="/de/alternativen/openai-moderation" class="text-sm font-medium text-surface-500 hover:text-surface-700">Mit Alternativen vergleichen &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Full Pipeline -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          Die komplette Moderationspipeline
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          Von der Erfassung bis zur Aktion übernimmt OpenModeration jeden Schritt.
        </p>
      </div>
      <div class="grid gap-4 grid-cols-2 md:grid-cols-4">
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">1. Erfassen</h3>
          <p class="mt-1 text-xs text-surface-500">Inhalte kommen über die API, soziale Plattformen oder Webhooks an</p>
        </div>
        <div class="lift rounded-2xl bg-gradient-to-br from-brand-600 to-violet-600 p-6 text-center text-white shadow-lg [&_h3]:text-white [&_p]:text-white/85">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-white/20 text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">2. Analysieren</h3>
          <p class="mt-1 text-xs text-surface-500">Die KI prüft Inhalte über mehrere Anbieter hinweg</p>
        </div>
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">3. Entscheiden</h3>
          <p class="mt-1 text-xs text-surface-500">Ihre Regeln werden automatisch angewendet</p>
        </div>
        <div class="lift rounded-2xl border border-surface-100 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">4. Prüfen</h3>
          <p class="mt-1 text-xs text-surface-500">Grenzfälle werden für Ihr Team markiert</p>
        </div>
      </div>
    </div>
  </section>

