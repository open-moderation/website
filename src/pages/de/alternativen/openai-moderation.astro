---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# OpenAI Moderation API (direkt)
const openai = new OpenAI({ apiKey: 'sk-...' });
const mod = await openai.moderations.create({ input: text });
// Ergebnis: OpenAI-spezifisches Format, 11 Kategorien, keine Schwellenwerte

# OpenModeration (einheitlich)
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({
    input: text,
    categories: ['hate', 'harassment', 'sexual', 'violence', 'self-harm', 'spam'],
    threshold: 0.5
  })
});
// Dazu: Vorfilter, doppelter Schwellenwert, automatische Aktionen, Audit-Trail, Team-Dashboard`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative zur OpenAI Moderation API: Preise und Vergleich",
  "description": "Sie suchen eine Alternative zur OpenAI Moderation API? OpenModeration bietet Moderation über mehrere Anbieter hinter einer einzigen API und dazu eine vollständige Compliance-Ebene für Unternehmen mit automatischen Regeln, manueller Prüfung und DSA-Audit-Trail.",
  "inLanguage": "de",
};

const comparisonPoints = [
  { feature: "Anbieter", openai: "Nur OpenAI (ein einziger Anbieter)", openmod: "10 Anbieter: OpenAI, Azure, Mistral, HuggingFace, LLMs (GPT-4o, Claude), Cohere und weitere" },
  { feature: "API-Format", openai: "Proprietäres OpenAI-Format", openmod: "Einheitliches Format für alle Anbieter. Anbieterwechsel ganz ohne Codeänderung." },
  { feature: "Vorfilterung", openai: "Nicht verfügbar, jede Anfrage geht an die API", openmod: "Integrierter Wortfilter blockiert offensichtliche Inhalte vor jedem API-Aufruf und senkt so die Kosten" },
  { feature: "Entscheidungslogik", openai: "Binär markiert/nicht markiert pro Kategorie", openmod: "Doppelter Schwellenwert: automatisch freigeben / Graubereich → manuelle Prüfung / automatisch ablehnen" },
  { feature: "Moderationskonsole", openai: "Nur API. Kein Dashboard, keine Prüfoberfläche.", openmod: "Vollständiges Dashboard: Moderationswarteschlange, Teamrollen, Analysen, Anbieterstatus" },
  { feature: "Automatische Regeln", openai: "Eigene Integration erforderlich", openmod: "Sofort einsatzbereit: Regeln einmal definieren, die Action Engine setzt sie automatisch durch" },
  { feature: "Manuelle Prüfung", openai: "Eigene Prüfoberfläche erforderlich", openmod: "Integrierte Prüfwarteschlange mit Kontext, Zuweisung, Freigeben/Ablehnen" },
  { feature: "Audit-Trail", openai: "Beschränkt auf API-Protokolle", openmod: "Vollständiger Audit-Trail: jede Entscheidung von KI und Mensch protokolliert, exportierbar für den DSA" },
  { feature: "Anbieterbindung", openai: "Vollständige Bindung an das OpenAI-Ökosystem", openmod: "Keine. BYOK, Anbieter per Konfiguration wechselbar, Export Ihrer Daten" },
  { feature: "Datensouveränität", openai: "Datenverarbeitung auf Servern von OpenAI", openmod: "Hosting in der EU. On-Premise auf Anfrage." },
  { feature: "Preise", openai: "Kostenloser Endpunkt (nur Scores)", openmod: "Kostenlos bis 1.000 Anfragen pro Monat. Pro ab 99 €/Monat (10K Anfragen inklusive)." },
  { feature: "Maximale Eingabelänge", openai: "32.000 Zeichen", openmod: "Bis zu 32.000 Zeichen (je nach Anbieter) + Batch-Verarbeitung für größere Mengen" },
];

const reasons = [
  {
    title: "Sie sind an die Genauigkeit eines einzigen Anbieters gebunden",
    icon: "lock",
    description: "OpenAI Moderation ist hervorragend für englische Inhalte, aber weniger geeignet für andere Sprachen, Nischenkategorien oder wenn Sie Redundanz brauchen. Mit OpenModeration leiten Sie jede Anfrage an den besten Anbieter weiter: OpenAI für toxische Inhalte auf Englisch, Mistral für mehrsprachigen Spam, LLMs für eigene Kategorien."
  },
  {
    title: "Ein API-Aufruf ist noch kein Moderations-Workflow",
    icon: "api",
    description: "Einen Toxizitäts-Score von OpenAI zu erhalten, ist erst der Anfang. Sie müssen noch festlegen, welcher Score welche Aktion auslöst, eine Prüfoberfläche für Grenzfälle bauen, jede Entscheidung für Audits protokollieren und den Zugriff Ihres Teams verwalten. OpenModeration liefert all das direkt mit."
  },
  {
    title: "Ohne Vorfilter geht jeder Kommentar an die API",
    icon: "cost",
    description: "Der OpenAI-Endpunkt ist kostenlos, aber jeder Kommentar durchläuft trotzdem einen Aufruf dorthin, selbst bei offensichtlichem Spam oder verbotenen Wörtern. Der Vorfilter von OpenModeration blockiert solche Inhalte, bevor sie einen Anbieter erreichen, und senkt so auch die Kosten bei den kostenpflichtigen Anbietern, die Sie hinzufügen."
  },
  {
    title: "DSA-Konformität erfordert mehr als eine API",
    icon: "compliance",
    description: "Der Digital Services Act der EU verlangt dokumentierte Moderationsentscheidungen, Beschwerdemechanismen und Transparenzberichte. Eine rohe API-Antwort reicht dafür nicht aus. OpenModeration liefert die komplette Compliance-Ebene: Audit-Logs, Prüfprotokolle und exportierbare Berichte."
  },
];

const verticals = [
  { name: "Soziale Plattformen", desc: "Moderieren Sie Kommentare und Beiträge mit kontextbewusster KI und Regeln, die auf Ihre Community und Ihre Anwendungsfälle zugeschnitten sind." },
  { name: "KI-Anwendungen", desc: "Filtern Sie Nutzereingaben und LLM-Ausgaben. Nutzen Sie LLM-basierte Moderation für eigene, sich wandelnde Kategorien." },
  { name: "Gaming", desc: "Chat-Moderation in Echtzeit in mehreren Sprachen, mit einer Latenz unter 250 ms und automatischen Aktionen." },
  { name: "Marktplätze", desc: "Markieren Sie Spam-Angebote, Hassrede in Bewertungen und offengelegte personenbezogene Daten, bevor sie online gehen." },
];

const faqItems = [
  {
    question: "Was kostet die OpenAI Moderation API im Vergleich zu OpenModeration?",
    answer: "Der Moderations-Endpunkt von OpenAI ist kostenlos, liefert aber nur Scores: kein Dashboard, keine Regeln, keine manuelle Prüfung und kein Audit-Trail. OpenModeration ist bis 1.000 Anfragen pro Monat kostenlos und nutzt im Hintergrund weiterhin omni-moderation-latest. Der Pro-Tarif beginnt bei 99 €/Monat für 10K Anfragen."
  },
  {
    question: "Kann ich OpenAI weiterhin als Anbieter nutzen?",
    answer: "Ja. Hinterlegen Sie Ihren eigenen OpenAI-Schlüssel (BYOK) und behalten Sie omni-moderation-latest. Mistral, Azure oder Llama Guard fügen Sie per Konfigurationsänderung als Fallback hinzu, ohne Code neu zu schreiben."
  },
  {
    question: "Wie lange dauert die Migration?",
    answer: "Weniger als eine Stunde: Ein einziger Aufruf von POST /v1/moderation ersetzt openai.moderations.create. Die Scores werden in ein einheitliches Format übertragen, Schwellenwerte und Regeln greifen sofort."
  },
  {
    question: "Was bekomme ich über die reinen Scores hinaus?",
    answer: "Eine komplette Plattform: Vorfilter, doppelte Schwellenwerte (automatisch freigeben, manuell prüfen, automatisch ablehnen), Moderations-Dashboard, Teamrollen und einen DSA-fähigen Audit-Trail mit exportierbaren Berichten."
  },
  {
    question: "Welche Moderations-API eignet sich am besten für Enterprise-Compliance?",
    answer: "Für Enterprise-Compliance brauchen Sie mehr als rohe Scores: dokumentierte Entscheidungen, rollenbasierten Zugriff, einen Audit-Trail und exportierbare Berichte. OpenModeration bietet all das: Jede Entscheidung von KI und Mensch wird protokolliert, Regeln werden automatisch durchgesetzt, und der vollständige Audit-Trail lässt sich mit einem Klick für DSA-Transparenzberichte exportieren. Ihre Daten werden in der EU gehostet und lassen sich jederzeit exportieren."
  },
  {
    question: "Funktioniert OpenModeration mit dem Modell omni-moderation-latest von OpenAI?",
    answer: "Ja. Hinterlegen Sie Ihren eigenen OpenAI-Schlüssel und leiten Sie alle Anfragen an omni-moderation-latest als primäres Modell. Die Antworten sind über alle Anbieter hinweg einheitlich, und Mistral, Azure oder HuggingFace fügen Sie per Konfigurationsänderung als Fallback hinzu, ohne Code neu zu schreiben."
  },
];
---

<BaseLayout
  title="Alternative zur OpenAI Moderation API: Preise & Vergleich"
  description="Der kostenlose OpenAI-Endpunkt liefert nur Scores. OpenModeration: 10 Anbieter, eine API, Vorfilter, Regeln, manuelle Prüfung und DSA-Audit-Trail."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Alternativen", href: "/de/alternativen" }, { label: "Alternative zu OpenAI Moderation" }]} />
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-50 px-4 py-1.5 text-sm font-medium text-green-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Alternative zur OpenAI Moderation API
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        OpenAI Moderation einbinden<br/>und den Rest nicht selbst bauen
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Die Moderation API von OpenAI liefert Toxizitäts-Scores. OpenModeration ergänzt, was Sie im Betrieb brauchen:
        10 Anbieter hinter einer API, Vorfilterung, automatische Regeln, manuelle Prüfung und einen
        DSA-konformen Audit-Trail. Jede Entscheidung wird schriftlich begründet, eine Anbieterbindung gibt es nicht.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">OpenModeration kostenlos testen</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Zum vollständigen Vergleich</a>
      </div>
    </div>
  </section>

  <!-- Why switch section -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum Teams von OpenAI Moderation wechseln</h2>
        <p class="mt-4 text-lg text-surface-500">Die API von OpenAI bewertet Texte gut. Für den Moderationsalltag fehlt ihr aber alles, was nach dem Score kommt.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
              {r.icon === 'lock' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>}
              {r.icon === 'api' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>}
              {r.icon === 'cost' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
              {r.icon === 'compliance' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>}
            </div>
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Eine Integration, unbegrenzt viele Anbieter
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            Dieselbe Textmoderation, mehr Kontrolle
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Mit der API von OpenAI erhalten Sie Scores. Mit OpenModeration erhalten Sie Scores
            <strong>plus</strong> Vorfilterung, konfigurierbare Schwellenwerte, automatische Aktionen
            und einen vollständigen Audit-Trail, alles über denselben einzelnen API-Aufruf.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>OpenAI weiter nutzen</strong> als Anbieter über OpenModeration, mit Ihren eigenen API-Schlüsseln (BYOK).</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Redundanz schaffen</strong> durch Routing zu Mistral, Azure oder HuggingFace, wenn OpenAI langsam oder nicht erreichbar ist.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Anbieter objektiv vergleichen</strong> dank einheitlicher Analysen über Ihren gesamten Moderationstraffic.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">OpenAI Moderation API vs. OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Der direkte Vergleich der Funktionen, die für Moderation im Produktivbetrieb zählen.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funktion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">OpenAI Moderation API</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.openai}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Hidden cost vs advantage -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Nur mit der OpenAI Moderation API
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Jeder Kommentar geht an die API, selbst offensichtlicher Spam oder verbotene Wörter</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Binär markiert/nicht markiert, kein Graubereich für nuancierte Inhalte</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Ein eigenes Dashboard, in dem menschliche Moderatoren Grenzfälle prüfen, müssen Sie selbst bauen</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Eine eigene Regel-Engine, die Scores in Aktionen übersetzt, müssen Sie selbst bauen</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Ein eigenes Audit-Logging für die DSA-Konformität müssen Sie selbst bauen</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Kein Fallback, wenn OpenAI langsam oder nicht verfügbar ist</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Bindung an das OpenAI-Ökosystem</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            OpenModeration (mit OpenAI als Anbieter)
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Ein <strong>Vorfilter</strong> blockiert offensichtlichen Spam und verbotene Wörter vor jedem API-Aufruf. Das spart 10 bis 30 % der Kosten.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Ein <strong>doppelter Schwellenwert</strong> entscheidet, was automatisch freigegeben, automatisch abgelehnt oder zur manuellen Prüfung weitergeleitet wird.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Im <strong>Dashboard</strong> kann Ihr Trust-&-Safety-Team sofort mit der Prüfung beginnen.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Die <strong>Regeln</strong> stellen Sie ohne Code mit drei Werkzeugen ein: verbotene Wörter, Schwellenwerte pro Kategorie und Ihre eigenen Vorgaben in natürlicher Sprache.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Für die <strong>Compliance</strong> gibt es einen vollständigen Audit-Trail, exportierbare Berichte und eine konfigurierbare Datenaufbewahrung.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Ist OpenAI langsam, geht die Anfrage per <strong>Fallback</strong> an Mistral, Azure oder HuggingFace.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Es gibt <strong>keine Anbieterbindung</strong>: Sie nutzen Ihre eigenen Schlüssel (BYOK) und können Ihre Daten jederzeit exportieren.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Content Moderation für unterschiedliche Anwendungsfälle</h2>
        <p class="mt-4 text-lg text-surface-500">OpenModeration kann die API von OpenAI ersetzen oder ergänzen.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{v.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- omni-moderation-latest compatibility -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Funktioniert mit omni-moderation-latest von OpenAI und 9 weiteren Modellen</h2>
        <p class="mt-4 text-lg text-surface-500">Behalten Sie das OpenAI-Moderationsmodell, dem Sie bereits vertrauen, als primäre Engine und betten Sie es in eine Plattform ein.</p>
        <p class="mt-2 text-sm"><a href="/de/blog/openai-moderation-api-leitfaden" class="font-medium text-brand-600 hover:text-brand-500">So funktioniert die OpenAI Moderation API: Kategorien, Preise und Grenzen &rarr;</a></p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
