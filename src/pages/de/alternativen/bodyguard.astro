---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import SwitchProvider from '../../../components/SwitchProvider.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Bodyguard-Alternative: OpenModeration im Vergleich",
  "description": "Bodyguard oder OpenModeration? Ein Vergleich der beiden Moderationstools mit Quellen: abgedeckte Netzwerke, Preise, Datenhosting und schriftliche Begründung jeder Entscheidung.",
  "inLanguage": "de",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Angebote", bodyguard: "Eine Moderations-API für Plattformen und ein Angebot zur Social-Media-Moderation für Marken, Agenturen und öffentliche Einrichtungen", openmod: "Eine einzige Plattform: Konnektoren für soziale Netzwerke und WordPress, REST-API und Webhooks für alles andere" },
  { feature: "Abgedeckte soziale Netzwerke", bodyguard: "Facebook, Instagram, TikTok, X, LinkedIn, YouTube, Twitch, Discord", openmod: "Website, Facebook, Instagram, YouTube und WordPress nativ; TikTok, X, LinkedIn und weitere Netzwerke auf Anfrage, schnell eingerichtet; alles andere über die API" },
  { feature: "Preise", bodyguard: "Guardian ab 1.000 € pro Monat, Sentinel ab 3.000 € pro Monat, Commander auf Anfrage; Preis abhängig von der Reichweite", openmod: "Öffentlich: kostenlos bis 1.000 analysierte Kommentare pro Monat, Pro für 99 € pro Monat, individuelle Angebote für große Volumen" },
  { feature: "Datenhosting", bodyguard: "Auf der Startseite nicht angegeben", openmod: "In der Europäischen Union entwickelt und gehostet" },
  { feature: "KI-Modelle", bodyguard: "Von Bodyguard entwickelte Technologie", openmod: "Eigene Moderations-KI, bei heiklen Fällen von weiteren KI-Modellen geprüft; neue Modelle werden schnell angebunden" },
  { feature: "Schriftliche Begründung jeder Entscheidung", bodyguard: "Nicht erwähnt", openmod: "Ja, für jede Entscheidung, in der Sprache Ihrer Wahl" },
  { feature: "DSA", bodyguard: "Auf der Startseite nicht erwähnt", openmod: "Audit-Trail aller Entscheidungen, ob automatisch oder menschlich" },
  { feature: "Ausgewiesene Konformität", bodyguard: "DSGVO, SOC 2 Type 2", openmod: "DSGVO, DSA: Begründung und Aktivitätsprotokoll für jede Entscheidung" },
  { feature: "Sprachen", bodyguard: "46 Sprachen nach eigenen Angaben", openmod: "Alle Sprachen Ihrer Community, über unsere eigene KI und die Prüfung durch weitere Modelle" },
];

const faqItems = [
  {
    question: "Was ist die beste Alternative zu Bodyguard?",
    answer: "Das hängt davon ab, was Sie suchen. Wenn Sie einen kostenlosen Einstieg, Datenhosting in der EU und eine schriftliche Begründung für jeden ausgeblendeten Kommentar wollen, erfüllt OpenModeration diese Kriterien. TikTok, X, LinkedIn und weitere Netzwerke richtet OpenModeration auf Anfrage schnell ein. Wenn Sie eine Moderations-API für eine große Plattform suchen, ist Bodyguard eine Option.",
  },
  {
    question: "Was kostet Bodyguard im Vergleich zu OpenModeration?",
    answer: "Laut seiner Preisseite startet Bodyguard mit dem Guardian-Paket ab 1.000 € pro Monat, das Sentinel-Paket beginnt bei 3.000 € pro Monat, und der Preis hängt von der Reichweite ab. OpenModeration bietet ein kostenloses Angebot bis 1.000 analysierte Kommentare pro Monat, ein Pro-Angebot für 99 € pro Monat mit 10.000 Kommentaren und individuelle Angebote für große Volumen.",
  },
  {
    question: "Ist OpenModeration DSA-konform?",
    answer: "OpenModeration verfasst für jede Entscheidung eine schriftliche Begründung und führt einen Audit-Trail aller Entscheidungen, ob sie von der KI oder von einem Moderator getroffen wurden. Beide Bausteine dienen unmittelbar der Begründung, die Artikel 17 des DSA verlangt.",
  },
  {
    question: "Kann man von Bodyguard zu OpenModeration wechseln, ohne alles neu aufzusetzen?",
    answer: "Auf Facebook, Instagram, YouTube und WordPress genügt es, Ihre Konten zu verbinden und Ihre Regeln in natürlicher Sprache zu formulieren, ganz ohne Code. Bei einer eigenen Plattform ersetzt die REST-API von OpenModeration den Aufruf der bisherigen API.",
  },
];
---

<BaseLayout title="Bodyguard-Alternative: Vergleich mit OpenModeration (2026)" description="Bodyguard oder OpenModeration? Vergleich mit Quellen: Netzwerke, Preise, EU-Hosting und schriftliche Begründung jeder Entscheidung." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Alternativen", href: "/de/alternativen" }, { label: "Bodyguard" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Vergleich
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Bodyguard-Alternative: OpenModeration im Vergleich</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bodyguard ist ein etablierter französischer Anbieter für KI-Moderation. OpenModeration setzt andere Schwerpunkte: ein kostenloser Einstieg und Pro für 99 € pro Monat, Datenhosting in der EU und eine schriftliche Begründung für jede Entscheidung. Hier sind die Unterschiede mit Quellen, damit Sie fundiert entscheiden können.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/de/termin-vereinbaren" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Termin vereinbaren</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Kostenlos testen</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Wählen Sie OpenModeration, wenn …</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>Sie kostenlos starten und danach weniger als 100 € im Monat zahlen möchten;</li>
          <li>unser Team die Moderation mit Ihnen an Ihre Regeln und Anwendungsfälle anpassen soll;</li>
          <li>Ihre Daten in der Europäischen Union bleiben müssen;</li>
          <li>Sie jede Entfernung eines Kommentars begründen müssen, wie es der DSA verlangt;</li>
          <li>Sie die KI-Modelle, die Ihre Inhalte bewerten, selbst wählen oder wechseln möchten.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Bodyguard passt womöglich besser, wenn …</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>Ihr Einkauf eine SOC-2-Type-2-Zertifizierung verlangt;</li>
          <li>Sie eine vollständig von einem einzigen Anbieter betreute Lösung bevorzugen.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Bodyguard und OpenModeration im Detail</h2>
      <p class="mt-4 text-surface-500">Angaben zu Bodyguard von der eigenen Website, bodyguard.ai, abgerufen am 20. Oktober 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Kriterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Bodyguard</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.bodyguard}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Was sich im Alltag wirklich ändert</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sie wissen, warum ein Kommentar ausgeblendet wurde</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration versieht jede Entscheidung mit einer schriftlichen Begründung, die Ihr Team sieht und die API zurückgibt. So können Sie einem Leser antworten, der widerspricht, und genau das verlangt der DSA: jede Entfernung zu begründen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Ihre Regeln, so formuliert, wie Sie denken</h3>
          <p class="mt-2 text-sm text-surface-600">Sie formulieren Ihre Regeln in natürlicher Sprache, ergänzen verbotene Wörter und legen pro Kategorie einen Schwellenwert fest. Grenzfälle landen in einem Graubereich, den unser Team entscheidet. Sie können jederzeit eingreifen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Ein deutlich niedrigerer Einstiegspreis</h3>
          <p class="mt-2 text-sm text-surface-600">Bodyguard startet bei 1.000 € pro Monat. OpenModeration ist bis 1.000 analysierte Kommentare pro Monat kostenlos, Pro kostet 99 € pro Monat.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Keine Abhängigkeit von einem einzigen Modell</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration arbeitet mit einer eigenen Moderations-KI, die bei heiklen Fällen von weiteren KI-Modellen geprüft wird. Kommt ein besseres oder günstigeres Modell heraus, binden wir es schnell an. Für Sie ändert sich nichts.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Häufige Fragen" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bodyguard ist eine Marke ihres Herausgebers. Die Angaben dazu stammen von <a href="https://bodyguard.ai/fr" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">bodyguard.ai</a> und seiner <a href="https://www.bodyguard.ai/en/social-media/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Preisseite</a> (abgerufen am 20. Oktober 2026). Ein Fehler? Schreiben Sie uns an <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Weiterlesen</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/de/social-media-moderation" class="font-medium text-brand-600 hover:text-brand-500">Social-Media-Moderation mit OpenModeration &rarr;</a></li>
        <li><a href="/de/dsa-konformitaet/begruendung" class="font-medium text-brand-600 hover:text-brand-500">Die vom DSA verlangte Begründung &rarr;</a></li>
        <li><a href="/de/alternativen" class="font-medium text-brand-600 hover:text-brand-500">Alle Vergleiche &rarr;</a></li>
        <li><a href="/de/preise" class="font-medium text-brand-600 hover:text-brand-500">Die Preise von OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Testen Sie die transparente Alternative zu Bodyguard." subtitle="Verbinden Sie Ihre Seiten, formulieren Sie Ihre Regeln und sehen Sie die schriftliche Begründung für jeden ausgeblendeten Kommentar. Kostenlos starten." />
</BaseLayout>
