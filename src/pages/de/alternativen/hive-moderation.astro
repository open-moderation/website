---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';

const migrationCode = `# Vorher: Hive Moderation (direkt)
const response = await fetch('https://api.thehive.ai/api/v2/task/sync', {
  method: 'POST',
  headers: { 'Authorization': 'Token YOUR_HIVE_KEY' },
  body: JSON.stringify({ url: '...', text: { text: content } })
});

# Nachher: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// Unsere KI entscheidet, weitere Modelle prüfen heikle Fälle: derselbe API-Aufruf`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative zu Hive Moderation | OpenModeration",
  "description": "Hive Moderation bietet starke Bild- und Textmoderation, bindet Sie aber an die proprietären Modelle von Hive. OpenModeration nutzt eine eigene Moderations-KI, die bei heiklen Fällen von weiteren KI-Modellen geprüft wird, mit integrierten automatisierten Workflows und DSA-Konformität.",
  "inLanguage": "de",
};

const comparisonPoints = [
  { feature: "KI-Modelle", hive: "Nur Hive (proprietäre Modelle)", openmod: "Eigene Moderations-KI, bei heiklen Fällen von weiteren KI-Modellen geprüft" },
  { feature: "Inhaltstypen", hive: "Text, Bild, Video (starke Bildmoderation)", openmod: "Kommentar- und Textmoderation mit 10 Kategorien, in allen Sprachen Ihrer Community." },
  { feature: "Vorfilterung", hive: "Nicht verfügbar", openmod: "Integrierter Wortfilter blockiert offensichtlichen Spam und verbotene Wörter vor jedem API-Aufruf" },
  { feature: "Entscheidungslogik", hive: "Rohe Klassifikations-Scores", openmod: "Doppelter Schwellenwert; Zweifelsfälle prüft unser Team, Sie müssen nichts tun" },
  { feature: "Automatische Aktionen", hive: "Eigene Integration erforderlich", openmod: "Die integrierte Action Engine blendet aus, löscht, markiert oder benachrichtigt, sobald Schwellenwerte überschritten werden." },
  { feature: "Dashboard", hive: "Einfaches API-Dashboard", openmod: "Vollständige Moderationskonsole: jede Entscheidung in Echtzeit, Eingriff jederzeit möglich, Teamrollen, Analysen" },
  { feature: "API-Format", hive: "Proprietäres Hive-Format", openmod: "Standardisierte Scores. Bindet OpenModeration ein neues Modell an, bleibt Ihre Integration unverändert." },
  { feature: "Weiterentwicklung der KI", hive: "An die proprietären Modelle von Hive gebunden", openmod: "Modellunabhängig: bessere oder günstigere Modelle werden schnell angebunden. Export Ihrer Daten jederzeit." },
  { feature: "Hosting", hive: "Nur Cloud-API", openmod: "Managed Cloud in der EU. On-Premise auf Anfrage" },
  { feature: "Audit-Trail", hive: "Protokolle der API-Anfragen", openmod: "Vollständiger DSA-Audit-Trail: jede Entscheidung von KI und Mensch protokolliert, exportierbare Berichte" },
  { feature: "Preise", hive: "Nutzungsbasiert, Preis auf Anfrage", openmod: "Kostenlos bis 1.000 Anfragen pro Monat. Pro ab 99 €/Monat (10K Anfragen inklusive)." },
];

const reasons = [
  {
    title: "Hive glänzt bei Bildern, doch das KI-Wachstum findet beim Text statt",
    description: "Hive ist für die Moderation von Bildern und Videos bekannt. Doch seit LLMs und Chatbots Text in großen Mengen erzeugen, brauchen Sie eine Plattform, die Text und visuelle Inhalte gleich gut beherrscht. OpenModeration ist auf Text und Kommentare spezialisiert, mit einer eigenen KI, die für die Kommentarmoderation trainiert ist."
  },
  {
    title: "Ein einziges Modell veraltet zwischen zwei Updates",
    description: "Mit Hive hängt Ihre gesamte Moderationspipeline an einem einzigen proprietären Modell. OpenModeration ist modellunabhängig: Kommt ein besseres oder günstigeres KI-Modell heraus, binden wir es schnell an. Sie profitieren vom Fortschritt der KI, ohne etwas zu ändern."
  },
  {
    title: "Proprietäre Modelle bedeuten keine Transparenz",
    description: "Die Modelle von Hive sind Blackboxes. Sie können sie weder prüfen noch feinabstimmen noch ihre Trainingsdaten einsehen. Bei OpenModeration wird jede Entscheidung schriftlich begründet, heikle Fälle werden von weiteren KI-Modellen geprüft, und Sie sehen alles in Echtzeit."
  },
  {
    title: "DSA-Konformität braucht mehr als API-Scores",
    description: "Der Digital Services Act der EU verlangt dokumentierte Moderationsentscheidungen, Mechanismen zur menschlichen Überprüfung und Transparenzberichte. OpenModeration liefert den kompletten Compliance-Stack mit Audit-Trail, Prüf-Workflows und exportierbaren Berichten statt bloßer Protokolle auf API-Ebene."
  },
];
---

<BaseLayout
  title="Alternative zu Hive Moderation: KI für Kommentare"
  description="Hive ist stark bei Bildmoderation. OpenModeration: eigene, von weiteren Modellen geprüfte KI für Text, automatische Regeln und DSA-Audit-Trail."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Alternativen", href: "/de/alternativen" }, { label: "Hive Moderation Alternative" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1.5 text-sm font-medium text-amber-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Alternative zu Hive Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Hive ist stark bei visuellen Inhalten.<br/>Für die Textmoderation brauchen Sie eine Plattform.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Hive Moderation ist hervorragend bei der Klassifizierung von Bildern und Videos. Der Bedarf an Textmoderation wächst aber
        stark, durch LLMs, Chatbots, Foren und Kommentare. OpenModeration moderiert Text mit einer eigenen KI,
        von weiteren Modellen geprüft, mit integrierten automatischen Regeln, menschlicher Prüfung durch unser Team und DSA-Konformität.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">OpenModeration kostenlos testen</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Zum Vergleich</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum Teams über Hive allein hinausdenken</h2>
        <p class="mt-4 text-lg text-surface-500">Hive ist eine gute Moderations-Engine. Für Textmoderation im Produktivbetrieb brauchen Sie aber mehr als ein einziges Modell und mehr als rohe Scores.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Eine KI, die mit dem Markt geht
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Eine KI, die nicht veraltet</h2>
          <p class="mt-4 text-lg text-surface-500">
            Wer Hive für die Bildmoderation und eine separate API für Text integriert, zersplittert seinen Stack.
            OpenModeration liefert Ihnen eine eigene Moderations-KI hinter einer stabilen API.
            Bessere oder günstigere Modelle binden wir schnell an, für Sie ändert sich nichts.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Bei heiklen Fällen <strong>prüfen weitere KI-Modelle</strong> die Entscheidung, bevor sie angewendet wird.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Sie <strong>sehen jede Entscheidung in Echtzeit</strong> und können jederzeit eingreifen.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Jede Entscheidung ist <strong>schriftlich begründet</strong>, Sie sehen also, wie sie zustande kommt.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Hive Moderation vs. OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Rohe Scores von einem Modell oder eine vollständige Moderationslösung.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funktion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Hive Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.hive}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Weitere Anbieter vergleichen</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/de/alternativen/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/de/alternativen/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/de/alternativen/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/de/alternativen/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/de/alternativen/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection
    title="Eine KI für Kommentare, die mit dem Markt geht."
    subtitle="Verbinden Sie Ihre Seiten, den Rest übernehmen wir: eigene KI, von weiteren Modellen geprüft, und unser Team für die Zweifelsfälle. Jede Entscheidung ist schriftlich begründet, in der EU gehostet und auf den DSA ausgelegt."
    buttonText="OpenModeration kostenlos testen"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
