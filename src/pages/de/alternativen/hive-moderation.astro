---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import CodeBlock from '../../../components/CodeBlock.astro';

const migrationCode = `# Vorher: Hive Moderation (direkt)
const response = await fetch('https://api.thehive.ai/api/v2/task/sync', {
  method: 'POST',
  headers: { 'Authorization': 'Token YOUR_HIVE_KEY' },
  body: JSON.stringify({ url: '...', text: { text: content } })
});

# Nachher: OpenModeration mit Hive
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text, model: 'hive/moderation' })
});
// OpenAI, Azure oder Mistral als Fallback hinzufügen, mit demselben API-Aufruf`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative zu Hive Moderation | OpenModeration",
  "description": "Hive Moderation bietet starke Bild- und Textmoderation, bindet Sie aber an einen einzigen Anbieter. OpenModeration kombiniert Hive mit OpenAI, Azure, Mistral und weiteren Anbietern hinter einer API, mit integrierten automatisierten Workflows und DSA-Konformität.",
  "inLanguage": "de",
};

const comparisonPoints = [
  { feature: "Anbieter", hive: "Nur Hive (proprietäre Modelle)", openmod: "10 Anbieter: Hive, OpenAI, Azure, Mistral, HuggingFace, LLMs (GPT-4o, Claude), Cohere und weitere" },
  { feature: "Inhaltstypen", hive: "Text, Bild, Video (starke Bildmoderation)", openmod: "Textmoderation mit 10 Kategorien. Routing über mehrere Anbieter nach Sprache und Kategorie." },
  { feature: "Vorfilterung", hive: "Nicht verfügbar", openmod: "Integrierter Wortfilter blockiert offensichtlichen Spam und verbotene Wörter vor jedem API-Aufruf" },
  { feature: "Entscheidungslogik", hive: "Rohe Klassifikations-Scores", openmod: "Doppelter Schwellenwert, Graubereich wird zur manuellen Prüfung weitergeleitet" },
  { feature: "Automatische Aktionen", hive: "Eigene Integration erforderlich", openmod: "Die integrierte Action Engine blendet aus, löscht, markiert oder benachrichtigt, sobald Schwellenwerte überschritten werden." },
  { feature: "Dashboard", hive: "Einfaches API-Dashboard", openmod: "Vollständige Moderationskonsole: Prüfwarteschlange, Teamrollen, Analysen, Anbieterstatus" },
  { feature: "API-Format", hive: "Proprietäres Hive-Format", openmod: "Einheitlich über alle 10 Anbieter. Anbieterwechsel per Konfigurationsänderung." },
  { feature: "Anbieterbindung", hive: "An die proprietären Modelle von Hive gebunden", openmod: "Keine. BYOK für alle Anbieter. Self-Hosting möglich." },
  { feature: "Self-Hosting", hive: "Nur Cloud-API", openmod: "Self-Hosting mit Docker (kostenlos, AGPL v3) oder Managed Cloud in der EU" },
  { feature: "Audit-Trail", hive: "Protokolle der API-Anfragen", openmod: "Vollständiger DSA-Audit-Trail: jede Entscheidung von KI und Mensch protokolliert, exportierbare Berichte" },
  { feature: "Preise", hive: "Nutzungsbasiert, Preis auf Anfrage", openmod: "Self-Hosting kostenlos. Managed Cloud ab 99 €/Monat (10K Anfragen inklusive)." },
];

const reasons = [
  {
    title: "Hive glänzt bei Bildern, doch das KI-Wachstum findet beim Text statt",
    description: "Hive ist für die Moderation von Bildern und Videos bekannt. Doch seit LLMs und Chatbots Text in großen Mengen erzeugen, brauchen Sie eine Plattform, die Text und visuelle Inhalte gleich gut beherrscht. OpenModeration leitet Text an den besten NLP-Anbieter weiter und kann Hive für visuelle Anwendungsfälle einbinden."
  },
  {
    title: "Ein Anbieter bedeutet einen Single Point of Failure",
    description: "Hat die API von Hive einen Ausfall, eine Latenzspitze oder eine Preisänderung, ist Ihre gesamte Moderationspipeline betroffen. OpenModeration bietet automatisches Fallback über 10 Anbieter: Ist Hive langsam, werden Ihre Anfragen an OpenAI, Azure oder Mistral umgeleitet, ganz automatisch."
  },
  {
    title: "Proprietäre Modelle bedeuten keine Transparenz",
    description: "Die Modelle von Hive sind Blackboxes. Sie können sie weder prüfen noch feinabstimmen noch ihre Trainingsdaten einsehen. OpenModeration gibt Ihnen Zugang zu Open-Source-Modellen (HuggingFace Llama Guard) neben proprietären, und die Plattform selbst ist vollständig Open Source unter AGPL v3."
  },
  {
    title: "DSA-Konformität braucht mehr als API-Scores",
    description: "Der Digital Services Act der EU verlangt dokumentierte Moderationsentscheidungen, Mechanismen zur menschlichen Überprüfung und Transparenzberichte. OpenModeration liefert den kompletten Compliance-Stack mit Audit-Trail, Prüf-Workflows und exportierbaren Berichten statt bloßer Protokolle auf API-Ebene."
  },
];
---

<BaseLayout
  title="Alternative zu Hive Moderation: eine API, 10 Anbieter"
  description="Hive ist stark bei Bildmoderation. OpenModeration kombiniert Hive mit 9 weiteren Textanbietern, automatischen Regeln, manueller Prüfung und DSA-Audit-Trail."
  jsonLd={comparisonJsonLd}
>
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1.5 text-sm font-medium text-amber-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Alternative zu Hive Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Hive ist stark bei visuellen Inhalten.<br/>Für die Textmoderation brauchen Sie eine Plattform.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Hive Moderation ist hervorragend bei der Klassifizierung von Bildern und Videos. Der Bedarf an Textmoderation wächst aber
        stark, durch LLMs, Chatbots, Foren und Kommentare. OpenModeration bündelt 10 Anbieter für Textmoderation
        hinter einer API, mit integrierten automatischen Regeln, manueller Prüfung und DSA-Konformität.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">OpenModeration kostenlos testen</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Zum Vergleich</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum Teams über Hive allein hinausdenken</h2>
        <p class="mt-4 text-lg text-surface-500">Hive ist eine gute Moderations-Engine. Für Textmoderation im Produktivbetrieb brauchen Sie aber mehr als ein Modell und mehr als rohe Scores.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Eine API, jeder Anbieter
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Ein einheitlicher Stack für alle Anbieter</h2>
          <p class="mt-4 text-lg text-surface-500">
            Wer Hive für die Bildmoderation und eine separate API für Text integriert, zersplittert seinen Stack.
            OpenModeration vereint alles unter einem einheitlichen API-Format: Nutzen Sie Hive, OpenAI, Azure,
            Mistral, HuggingFace oder eine beliebige Kombination.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Fällt Hive aus, greift ein <strong>automatisches Fallback</strong> auf OpenAI oder Mistral.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Sie <strong>vergleichen die Anbieter</strong> pro Sprache nach Geschwindigkeit, Genauigkeit und Preis.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Neben Hive können Sie <strong>Open-Source-Modelle</strong> wie Llama Guard betreiben, deren Funktionsweise sich prüfen lässt.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Hive Moderation vs. OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">OpenModeration bindet Hive und 9 weitere Anbieter in einer Plattform zusammen.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funktion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Hive Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.hive}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Weitere Anbieter vergleichen</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/de/alternativen/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/de/alternativen/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/de/alternativen/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/de/alternativen/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/de/alternativen/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <CTASection
    title="Hive und 9 weitere Anbieter in einem einzigen API-Aufruf."
    subtitle="Kombinieren Sie die Bildmoderation von Hive mit OpenAI, Azure und Mistral für Text, alles über eine einheitliche API. Der Code ist Open Source, selbst hostbar und auf den DSA ausgelegt."
    buttonText="OpenModeration kostenlos testen"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
