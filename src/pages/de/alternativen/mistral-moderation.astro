---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# Vorher: Mistral Moderation (direkt)
import { Mistral } from '@mistralai/mistralai';
const mistral = new Mistral({ apiKey: '...' });
const result = await mistral.moderations.create({ input: text });

# Nachher: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// Unsere KI entscheidet, weitere Modelle prüfen heikle Fälle: derselbe API-Aufruf`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternative zu Mistral Moderation | OpenModeration",
  "description": "Mistral Moderation ist eine starke mehrsprachige API, liefert aber nur Scores. OpenModeration bietet eine eigene Moderations-KI, bei heiklen Fällen von weiteren KI-Modellen geprüft, mit Vorfilterung, automatischen Regeln und DSA-fähigem Audit-Trail.",
  "inLanguage": "de",
};

const comparisonPoints = [
  { feature: "KI-Engine", mistral: "Ein einziges Mistral-Modell", openmod: "Eigene Moderations-KI, bei heiklen Fällen von weiteren KI-Modellen geprüft" },
  { feature: "Kategorien", mistral: "11 feste Kategorien im aktuellen Modell, darunter personenbezogene Daten und Jailbreaking", openmod: "10 standardisierte Kategorien, dazu eigene Regeln in natürlicher Sprache" },
  { feature: "Sprachen", mistral: "Stark mehrsprachig (Französisch, Deutsch, Spanisch, Italienisch, Portugiesisch usw.)", openmod: "Alle Sprachen Ihrer Community, über unsere eigene KI und die Prüfung durch weitere Modelle" },
  { feature: "Vorfilterung", mistral: "Nicht verfügbar", openmod: "Integrierter Wortfilter blockiert offensichtliche Inhalte vor jedem KI-Aufruf" },
  { feature: "Entscheidungslogik", mistral: "Nur rohe Scores", openmod: "Doppelter Schwellenwert: automatisch freigeben / Graubereich → Prüfung durch unser Team / automatisch ablehnen" },
  { feature: "Maximale Eingabe", mistral: "32.000 Zeichen", openmod: "Bis zu 32.000 Zeichen + Batch-Verarbeitung für größere Mengen" },
  { feature: "Dashboard", mistral: "Nur API. Keine Prüfoberfläche.", openmod: "Vollständige Moderationskonsole: jede Entscheidung in Echtzeit, Eingriff jederzeit möglich, Analysen und Teamrollen" },
  { feature: "Anbieterbindung", mistral: "An Mistral gebunden", openmod: "Keine. Modellunabhängig: Bessere oder günstigere Modelle binden wir schnell an, für Sie ändert sich nichts." },
  { feature: "Hosting", mistral: "Nur Cloud-API", openmod: "Managed Cloud in der EU. On-Premise auf Anfrage" },
  { feature: "Compliance", mistral: "Einfache API-Protokolle", openmod: "Vollständiger DSA-Audit-Trail mit exportierbaren Berichten" },
  { feature: "Preise", mistral: "Von Mistral auf seiner API festgelegt", openmod: "Kostenlos bis 1.000 Anfragen pro Monat. Pro ab 99 €/Monat (10K Anfragen inklusive)." },
];

const reasons = [
  {
    title: "Mistral ist stark bei EU-Sprachen, weniger bei Englisch",
    description: "Die Moderations-API von Mistral glänzt bei französischen, deutschen, spanischen und italienischen Inhalten. Ein einzelnes Modell ist aber nie in allen Sprachen gleich gut. Bei OpenModeration prüfen weitere KI-Modelle die heiklen Fälle, bevor eine Entscheidung angewendet wird."
  },
  {
    title: "Feste Kategorien oder frei konfigurierbare",
    description: "Mistral deckt einen festen Satz von Kategorien ab. Muss Ihre Community Desinformation, Grooming oder Verstöße gegen Ihre eigenen Regeln erkennen, reicht das nicht aus. Bei OpenModeration beschreiben Sie eigene Regeln in natürlicher Sprache, und unsere KI wendet sie auf jeden Kommentar an."
  },
  {
    title: "Eine API braucht eine operative Ebene",
    description: "Mistral liefert Ihnen Scores. Sie brauchen trotzdem eine Prüfung der Grenzfälle, eine Action Engine (ausblenden/löschen/markieren), rollenbasierten Zugriff, einen Audit-Trail für den DSA und Analysen. OpenModeration liefert all das mit, und die Zweifelsfälle übernimmt unser Team."
  },
  {
    title: "Ohne Vorfilter zahlen Sie für offensichtlichen Spam",
    description: "Jeder Kommentar, den Sie an den Moderations-Endpunkt von Mistral senden, zählt zu Ihrer API-Nutzung. Mit dem Vorfilter von OpenModeration werden offensichtlicher Spam, verbotene Wörter und Regex-Muster blockiert, bevor überhaupt eine KI aufgerufen wird."
  },
];

const faqItems = [
  {
    question: "Was kostet Mistral Moderation im Vergleich zu OpenModeration?",
    answer: "Mistral legt den Preis seines Moderationsmodells auf seiner eigenen API fest. OpenModeration ist bis 1.000 Anfragen pro Monat kostenlos. Der Pro-Tarif beginnt bei 99 €/Monat für 10K Anfragen."
  },
  {
    question: "Welche KI nutzt OpenModeration?",
    answer: "Eine eigene Moderations-KI, eingerichtet nach Ihren Regeln und Anwendungsfällen. Bei heiklen Fällen prüfen weitere KI-Modelle die Entscheidung, bevor sie angewendet wird. Kommt ein besseres oder günstigeres Modell heraus, binden wir es schnell an, ohne dass Sie eine Zeile Code ändern müssen."
  },
  {
    question: "Wie lange dauert die Migration?",
    answer: "Weniger als eine Stunde für den Austausch der API: Ein einziger Aufruf von POST /v1/moderation ersetzt den Mistral-Client. Regeln, Audit-Trail und die Konsole, in der Sie jede Entscheidung in Echtzeit sehen, funktionieren sofort danach."
  },
  {
    question: "Werden Französisch und andere EU-Sprachen unterstützt?",
    answer: "Ja. OpenModeration moderiert Französisch, Deutsch, Spanisch, Italienisch, Englisch und die anderen Sprachen Ihrer Community mit derselben KI, heikle Fälle werden von weiteren Modellen geprüft."
  },
  {
    question: "Wird jede Entscheidung für DSA-Audits protokolliert?",
    answer: "Ja. Für jede Entscheidung von KI und Mensch werden die Scores, die Schwellenwerte, der Prüfer und der Zeitstempel gespeichert. Exportieren Sie den vollständigen Audit-Trail mit einem Klick für Ihre DSA-Transparenzberichte."
  },
];
---

<BaseLayout
  title="Alternative zu Mistral Moderation: Preise, Vergleich, Migration"
  description="Mistral Moderation liefert nur Scores. OpenModeration: eigene, von weiteren Modellen geprüfte KI, Regeln, Prüfung durch unser Team, DSA-Audit-Trail."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Alternativen", href: "/de/alternativen" }, { label: "Alternative zu Mistral Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-sm font-medium text-blue-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Alternative zu Mistral Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Mistral moderiert europäische Sprachen sehr gut.<br/>OpenModeration liefert die komplette Moderation.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Die Moderations-API von Mistral ist bei europäischen Sprachen stark, liefert aber nur Scores.
        OpenModeration nutzt eine eigene KI, von weiteren Modellen geprüft, über einen einzigen
        API-Aufruf, mit automatischen Regeln, Prüfung der Zweifelsfälle durch unser Team und DSA-konformem Audit-Trail.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">OpenModeration kostenlos testen</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Zum Vergleich</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Warum mehr als Mistral</h2>
        <p class="mt-4 text-lg text-surface-500">Mistral gehört zu den besten Moderations-APIs mit EU-Fokus. Für die Moderation im Alltag brauchen Sie aber den ganzen Workflow drumherum.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Mehr als Scores
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Wechseln Sie zu OpenModeration und erhalten Sie die komplette Plattform.</h2>
          <p class="mt-4 text-lg text-surface-500">
            Ein einziger API-Aufruf ersetzt den Mistral-Client. Dazu kommen Vorfilterung,
            doppelte Schwellenwerte, automatische Aktionen und einen vollständigen Audit-Trail, alles über denselben API-Aufruf.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Unsere eigene Moderations-KI</strong>, bei heiklen Fällen von weiteren KI-Modellen geprüft.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Kein eingefrorenes Modell</strong>: Bessere oder günstigere Modelle binden wir schnell an, für Sie ändert sich nichts.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Mistral und OpenModeration werden beide von <strong>europäischen Teams</strong> für Entwickler gebaut.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Mistral Moderation vs. OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Was OpenModeration zur API von Mistral ergänzt, im direkten Vergleich.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funktion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Mistral Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.mistral}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Alternative zu Mistral Moderation: FAQ" />
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Weitere Anbieter vergleichen</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/de/alternativen/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/de/alternativen/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/de/alternativen/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/de/alternativen/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/de/alternativen/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection
    title="Mehr als Scores, über eine einzige API."
    subtitle="Verbinden Sie Ihre Seiten, den Rest übernehmen wir: eigene, geprüfte KI, automatische Regeln und unser Team für die Zweifelsfälle. Sie sehen jede Entscheidung in Echtzeit."
    buttonText="OpenModeration kostenlos testen"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
