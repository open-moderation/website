  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Google Perspective API wird abgeschaltet: Migrationsleitfaden für Foren",
  "description": "Die Perspective API wird Ende 2026 eingestellt. Was das für Ihr Forum bedeutet und wie Sie vor der Frist zu OpenModeration migrieren.",
  "inLanguage": "de",
  "datePublished": "2026-06-12",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
