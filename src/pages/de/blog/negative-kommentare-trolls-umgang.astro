const faqItems = [
  {
    question: "Sollte man negative Kommentare löschen?",
    answer: "Nicht, wenn es Kritik ist. Ein negativer, aber sachlicher Kommentar zu Ihrem Produkt, Service oder Inhalt sollte sichtbar bleiben, am besten mit einer Antwort. Löschen wirkt wie Zensur und bringt den Verfasser oft verärgert zurück. Löschen Sie Spam, Betrug, personenbezogene Daten und rechtswidrige Inhalte, und blenden Sie Beleidigungen aus.",
  },
  {
    question: "Wie antwortet man auf negative Kommentare in Social Media?",
