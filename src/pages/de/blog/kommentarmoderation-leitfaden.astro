const methods = [
  { name: "Vorabmoderation", how: "Jeder Kommentar wird geprüft, bevor er erscheint.", speed: "Langsam: die Veröffentlichung wartet auf einen Moderator", cost: "Hoch", risk: "Gering bei rechtswidrigen Inhalten, hoch für die Diskussion", scale: "Schlecht" },
  { name: "Nachträgliche Moderation", how: "Kommentare erscheinen sofort und werden danach geprüft.", speed: "Sofort", cost: "Hoch", risk: "Mittel: Problematisches bleibt bis zur Prüfung sichtbar", scale: "Mittel" },
  { name: "Reaktive Moderation", how: "Sie handeln nur auf Meldungen von Nutzern.", speed: "Sofort", cost: "Gering", risk: "Hoch: nichts fällt auf, bis jemand meldet", scale: "Gut, aber passiv" },
  { name: "Automatische Filter", how: "Wortlisten, Linksperren, feste Regeln.", speed: "Sofort", cost: "Gering", risk: "Hoch: Fehlalarme bei Kritik und Ironie, verschleierte Beleidigungen rutschen durch", scale: "Gut" },
  { name: "Hybrid: KI und Mensch", how: "Die KI wendet Ihre Regeln an, Zweifelsfälle gehen an ein Team.", speed: "Sekunden", cost: "Moderat", risk: "Gering bei gut abgestimmten Regeln und Schwellenwerten", scale: "Sehr gut" },
];

const actions = [
  { action: "Ausblenden", what: "Der Kommentar ist öffentlich nicht mehr sichtbar. Auf Facebook sehen ihn der Verfasser und seine Freunde weiterhin.", when: "Beleidigungen, Spam, aggressive Off-Topic-Beiträge: der Normalfall, und umkehrbar." },
  { action: "Löschen oder ablehnen", what: "Der Kommentar wird endgültig entfernt (oder gar nicht erst veröffentlicht).", when: "Eindeutig rechtswidrige Inhalte, Betrug, personenbezogene Daten Dritter." },
  { action: "Sperren oder einschränken", what: "Der Verfasser kann nicht mehr kommentieren, befristet oder dauerhaft.", when: "Wiederholungstäter, gezielte Belästigung, Spam-Konten, koordinierte Shitstorms." },
];

const faqItems = [
  {
    question: "Was ist Kommentarmoderation?",
    answer: "Kommentarmoderation umfasst die Regeln und Maßnahmen, mit denen Sie entscheiden, welche Kommentare unter Ihren Artikeln, Videos und Beiträgen sichtbar bleiben: veröffentlichen, ausblenden, löschen, zur Prüfung weiterleiten oder einen Verfasser einschränken, und die Entscheidung anschließend begründen.",
  },
  {
    question: "Wie moderiert man Kommentare effektiv?",
    answer: "Formulieren Sie klare Regeln mit Beispielen, automatisieren Sie die eindeutigen Fälle, geben Sie Zweifelsfälle an einen Menschen, begründen Sie jede Entscheidung gegenüber dem Verfasser, protokollieren Sie alles und überarbeiten Sie Ihre Regeln regelmäßig anhand der Fehler, die Sie beobachten.",
  },
  {
    question: "Soll ich einen Kommentar ausblenden oder löschen?",
    answer: "Ausblenden ist der sinnvolle Standard: Es lässt sich rückgängig machen und reicht, um die Diskussion zu schützen. Löschen Sie nur eindeutig rechtswidrige oder gefährliche Inhalte. In beiden Fällen sollten Sie die Entscheidung und ihre Begründung festhalten.",
  },
  {
    question: "Gilt der DSA auch für die Kommentare auf meiner Website?",
    answer: "Ja. Sobald Sie Inhalte Ihrer Nutzer speichern, etwa Kommentare, sind Sie im Sinne des DSA ein Hostingdienst. Welche Pflichten genau gelten, hängt von Art und Größe Ihres Dienstes ab. Das ist keine Rechtsberatung.",
  },
  {
    question: "Kann man Kommentare automatisch moderieren?",
    answer: "Ja. Eine KI kann jeden Kommentar im Kontext lesen, Ihre Regeln innerhalb von Sekunden anwenden und ausblenden, was dagegen verstößt. Über Zweifelsfälle sollte weiterhin ein Mensch entscheiden, und Verfasser sollten erfahren, wenn automatisierte Mittel eingesetzt wurden.",
  },
  {
    question: "Sollte man negative Kommentare löschen?",
