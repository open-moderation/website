const pageTitle = "Kommentarmoderation: der komplette Leitfaden (2026)";
const pageDescription = "Kommentare moderieren in der Praxis: Methoden im Vergleich, Regeln, Graubereiche, der DSA, die Wahl einer Moderationssoftware und 10 bewährte Grundsätze.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Kommentarmoderation: der komplette Leitfaden, um Kommentare richtig zu moderieren",
  "description": pageDescription,
  "inLanguage": "de",
  "datePublished": "2026-10-30",
  "dateModified": "2026-10-30",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/de/blog/kommentarmoderation-leitfaden" }
