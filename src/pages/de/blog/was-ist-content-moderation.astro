const types = [
  { type: "Vorab-Moderation", how: "Jeder Inhalt wird vor der Veröffentlichung geprüft.", pros: "Nichts Schädliches geht online.", cons: "Langsam, teuer, bremst Live-Diskussionen aus." },
  { type: "Nachträgliche Moderation", how: "Inhalte gehen sofort online und werden danach geprüft.", pros: "Schnell und flüssig für die Nutzer.", cons: "Schädliches bleibt sichtbar, bis jemand prüft." },
  { type: "Reaktive Moderation", how: "Nur gemeldete Inhalte werden geprüft.", pros: "Günstig, nutzt die Augen der Community.", cons: "Hängt davon ab, dass jemand meldet." },
  { type: "Verteilte Moderation", how: "Die Community bewertet, meldet oder blendet Inhalte selbst aus.", pros: "Wächst mit der Community mit.", cons: "Mehrheitsdruck, koordinierte Angriffe, schwankende Qualität." },
  { type: "Automatisierte Moderation", how: "Filter oder KI-Modelle entscheiden über jeden Inhalt.", pros: "Sofort, rund um die Uhr, große Mengen.", cons: "Fehler beim Kontext, braucht Aufsicht." },
  { type: "Hybride Moderation", how: "Automatisierung erledigt klare Fälle, Menschen die unklaren.", pros: "Tempo und Urteilsvermögen.", cons: "Braucht klare Regeln und ein gutes Prüfwerkzeug." },
];

const glossary = [
  { term: "Nutzergenerierte Inhalte (UGC)", def: "Alles, was Nutzer veröffentlichen und nicht der Dienst selbst: Kommentare, Bewertungen, Beiträge, Fotos, Videos, Nachrichten." },
  { term: "Community-Richtlinien", def: "Die öffentlichen Regeln, die festlegen, was auf einem Dienst erlaubt ist. Auch Netiquette oder Moderationsrichtlinien genannt." },
  { term: "Falsch-Positiv", def: "Ein zulässiger Inhalt, der zu Unrecht ausgeblendet oder gelöscht wird." },
  { term: "Falsch-Negativ", def: "Ein schädlicher Inhalt, der zu Unrecht online bleibt." },
  { term: "Human in the Loop", def: "Ein Ablauf, bei dem Menschen die Entscheidungen prüfen, bei denen die Automatisierung unsicher ist." },
  { term: "Prüfwarteschlange", def: "Die Liste der gemeldeten oder unklaren Inhalte, die auf eine menschliche Entscheidung warten." },
  { term: "Melde- und Abhilfeverfahren", def: "Der DSA-Mechanismus, über den jeder rechtswidrige Inhalte bei einem Hostingdienst melden kann, der die Meldung bearbeiten muss." },
  { term: "Begründung", def: "Die Erklärung, die ein Dienst nach dem DSA einem Nutzer geben muss, dessen Inhalt er beschränkt." },
  { term: "Audit-Trail", def: "Das Protokoll jeder Entscheidung: was, wann, durch wen oder welches System und warum." },
  { term: "Trust & Safety", def: "Der übergeordnete Bereich, der für die Sicherheit der Nutzer zuständig ist. Content Moderation ist ein Teil davon." },
];

