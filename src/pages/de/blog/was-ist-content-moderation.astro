const title = "Was ist Content Moderation? Definition und Arten";
const description = "Was Content Moderation bedeutet: welche Inhalte moderiert werden, die 6 Arten, der Beruf Content-Moderator, KI-Moderation, der DSA und die Wahl des Ansatzes.";
const linkClass = "text-brand-600 hover:text-brand-500";

const articleJsonLd = {
  "@context": "https://schema.org",
