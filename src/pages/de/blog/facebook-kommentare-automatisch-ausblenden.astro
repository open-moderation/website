const title = "Facebook Kommentare automatisch ausblenden (2026)";
const description = "So moderieren Sie Kommentare auf Ihrer Facebook-Seite: Ausblenden, Löschen oder Sperren, die integrierten Filter, ihre Grenzen und die Wahl eines Tools.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Facebook-Kommentare automatisch ausblenden: ein Praxisleitfaden zur Facebook-Kommentarmoderation",
  "description": description,
  "inLanguage": "de",
  "datePublished": "2026-10-30",
  "dateModified": "2026-10-30",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/de/blog/facebook-kommentare-automatisch-ausblenden" }
