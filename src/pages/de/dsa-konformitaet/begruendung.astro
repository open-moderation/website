---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Begründung nach Artikel 17 DSA: Wer ist betroffen, was muss sie enthalten?",
  "description": "Was Artikel 17 des Digital Services Act (Gesetz über digitale Dienste) bei jeder Entfernung von Inhalten verlangt: wer eine Begründung vorlegen muss, wann, mit welchen Angaben, und ein Beispiel.",
  "inLanguage": "de",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/de/dsa-konformitaet/begruendung" }
};

const contents = [
  { letter: "a", title: "Die getroffene Maßnahme", text: "Entfernung, Sperrung des Zugangs, Herabstufung oder Einschränkung der Anzeige, Aussetzung von Zahlungen oder eine andere Maßnahme, gegebenenfalls mit räumlichem Geltungsbereich und Dauer." },
  { letter: "b", title: "Die Tatsachen und Umstände", text: "Worauf die Entscheidung beruht, einschließlich der Angabe, ob sie auf eine Meldung (Artikel 16) oder auf eine Untersuchung auf Eigeninitiative zurückgeht. Die Identität der meldenden Person wird nur genannt, wenn dies unbedingt notwendig ist." },
  { letter: "c", title: "Der Einsatz automatisierter Mittel", text: "Gegebenenfalls die Angabe, dass automatisierte Mittel zur Entscheidungsfindung verwendet wurden oder dass die Entscheidung Inhalte betrifft, die mit automatisierten Mitteln erkannt wurden." },
  { letter: "d", title: "Die Rechtsgrundlage", text: "Wenn der Inhalt als rechtswidrig eingestuft wird: ein Verweis auf die Rechtsgrundlage und Erläuterungen, warum der Inhalt auf dieser Grundlage als rechtswidrig angesehen wird." },
  { letter: "e", title: "Die Bestimmung der AGB", text: "Wenn der Inhalt als unvereinbar mit Ihren allgemeinen Geschäftsbedingungen eingestuft wird: die betreffende vertragliche Bestimmung und Erläuterungen, warum der Inhalt damit unvereinbar ist." },
  { letter: "f", title: "Die Rechtsbehelfe", text: "Klare Informationen über die verfügbaren Rechtsbehelfe: internes Beschwerdemanagementverfahren, außergerichtliche Streitbeilegung, gerichtliche Rechtsmittel." },
];

const faqItems = [
  {
    question: "Was ist die Begründung nach dem DSA?",
    answer: "Es ist die Erklärung, die Artikel 17 der Verordnung (EU) 2022/2065 über digitale Dienste einem Nutzer vorschreibt, dessen Inhalt entfernt, gesperrt, herabgestuft oder in seiner Anzeige eingeschränkt wird, ebenso bei der Aussetzung eines Kontos, des Dienstes oder von Zahlungen.",
  },
  {
    question: "Ist eine Nachrichtenseite betroffen, die ihre Kommentare moderiert?",
    answer: "Ja. Sobald sie von Lesern veröffentlichte Kommentare speichert, handelt sie für diese Inhalte als Hostingdiensteanbieter. Artikel 17 gilt für alle Hostingdiensteanbieter, auch für kleine Unternehmen.",
  },
  {
    question: "Braucht jeder gelöschte Kommentar eine Begründung?",
    answer: "Ja, jede Beschränkung, die verhängt wird, weil der Inhalt rechtswidrig ist oder gegen Ihre Nutzungsbedingungen verstößt, sofern Ihnen die elektronischen Kontaktangaben des Verfassers bekannt sind. Die Pflicht gilt nicht für irreführende, umfangreiche kommerzielle Inhalte und nicht für behördliche Anordnungen nach Artikel 9.",
  },
  {
    question: "Müssen die Begründungen an die Europäische Kommission übermittelt werden?",
    answer: "Anbieter von Online-Plattformen müssen ihre Entscheidungen und Begründungen unverzüglich an die Kommission übermitteln, zur Aufnahme in eine öffentlich zugängliche Datenbank, ohne personenbezogene Daten (Artikel 24 Absatz 5). Kleinst- und Kleinunternehmen sind nach Artikel 19 davon ausgenommen, es sei denn, sie sind als sehr große Online-Plattform benannt.",
  },
  {
    question: "Welche Sanktionen drohen bei Verstößen?",
    answer: "Der DSA überlässt es den Mitgliedstaaten, die Sanktionen festzulegen, begrenzt aber Geldbußen für die Nichteinhaltung einer Verpflichtung auf 6 % des weltweiten Jahresumsatzes des Anbieters (Artikel 52).",
  },
];
---

<BaseLayout title="Begründung nach Art. 17 DSA: Pflichten und Beispiel" description="Was Art. 17 DSA bei jeder Entfernung von Inhalten verlangt: wer betroffen ist, wann Sie informieren müssen, die sechs Pflichtangaben und ein Beispiel." ogType="article" jsonLd={articleJsonLd}>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "DSA-Konformität", href: "/de/dsa-konformitaet" }, { label: "Begründung" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">20. Oktober 2026</time>
        <span>&middot;</span>
        <span>7 Min. Lesezeit</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Die Begründung nach dem DSA: Was Artikel 17 bei jeder Entfernung von Inhalten verlangt</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        Seit der Digital Services Act (DSA) gilt, reicht es nicht mehr, einen Kommentar zu entfernen:
        Sie müssen dem Verfasser auch erklären, warum. Artikel 17 nennt diese Erklärung „Begründung“ und legt ihren
        Mindestinhalt fest. Hier erfahren Sie, wer betroffen ist, wann die Begründung fällig wird, was sie enthalten muss und wie sie aussehen kann.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Wer muss eine Begründung vorlegen?</h2>
      <p>
        Die Pflicht trifft <strong>Hostingdiensteanbieter</strong>, also jeden Dienst, der von seinen Nutzern bereitgestellte
        Informationen speichert: soziale Netzwerke, Foren und Marktplätze, aber auch Nachrichtenseiten oder Blogs mit
        Leserkommentaren. Anders als bei anderen Pflichten des DSA sieht Artikel 17 keine Ausnahme für Kleinst- und
        Kleinunternehmen vor.
      </p>

      <h2 class="text-xl font-bold text-surface-900">In welchen Fällen?</h2>
      <p>
        Die Begründung ist jedem betroffenen Nutzer vorzulegen, gegen den eine Beschränkung verhängt wird, weil sein Inhalt
        rechtswidrig ist oder nicht mit Ihren Nutzungsbedingungen vereinbar ist. Der Text nennt vier Arten von Beschränkungen:
      </p>
      <ul>
        <li>jede Beschränkung der Anzeige eines Inhalts: Entfernung, Sperrung des Zugangs oder Herabstufung;</li>
        <li>die Aussetzung, Beendigung oder sonstige Beschränkung von Geldzahlungen;</li>
        <li>die Aussetzung oder Beendigung der gesamten oder teilweisen Bereitstellung des Dienstes;</li>
        <li>die Aussetzung oder Schließung des Kontos des Nutzers.</li>
      </ul>
      <p>
        Die Pflicht gilt, wenn Ihnen die elektronischen Kontaktangaben des Nutzers bekannt sind, und zwar spätestens ab dem
        Zeitpunkt, zu dem die Beschränkung verhängt wird. Sie gilt nicht für irreführende, umfangreiche kommerzielle Inhalte
        und nicht für behördliche Anordnungen nach Artikel 9.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Die sechs Pflichtangaben</h2>
      <p>Absatz 3 von Artikel 17 listet die Angaben auf, die die Begründung mindestens enthalten muss:</p>
    </div>

    <div class="mt-6 space-y-3">
      {contents.map((c) => (
        <div class="flex items-start gap-4 rounded-lg border border-surface-200 bg-surface-50 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-mono text-sm font-semibold text-brand-700">{c.letter}</span>
          <div>
            <p class="text-sm font-medium text-surface-900">{c.title}</p>
            <p class="mt-1 text-sm text-surface-500">{c.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <p>
        Diese Informationen müssen „klar und leicht verständlich“ sowie so genau und spezifisch wie möglich sein und es dem
        Nutzer ermöglichen, seine Rechtsbehelfe wirksam wahrzunehmen (Absatz 4).
      </p>

      <h2 class="text-xl font-bold text-surface-900">Und für Online-Plattformen?</h2>
      <p>
        Anbieter von Online-Plattformen haben eine zusätzliche Pflicht: Sie übermitteln ihre Entscheidungen und Begründungen
        unverzüglich an die Europäische Kommission, die damit eine öffentlich zugängliche Datenbank speist. Diese Übermittlungen
        dürfen keine personenbezogenen Daten enthalten (Artikel 24 Absatz 5). Kleinst- und Kleinunternehmen sind nach
        Artikel 19 davon ausgenommen, es sei denn, sie sind als sehr große Online-Plattform benannt.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Beispiel einer Begründung für einen entfernten Kommentar</h2>
      <p>Fiktives Beispiel, das Sie an Ihren Dienst und Ihre Nutzungsbedingungen anpassen sollten:</p>
    </div>

    <div class="mt-6 rounded-xl border border-surface-200 bg-white p-6 text-sm leading-relaxed text-surface-700 shadow-sm">
      <p>Guten Tag,</p>
      <p class="mt-3"><strong>Maßnahme:</strong> Ihr am 14. Oktober 2026 unter dem Artikel „…“ veröffentlichter Kommentar wurde entfernt. Ihr Konto ist davon nicht betroffen.</p>
      <p class="mt-3"><strong>Grund:</strong> Der Kommentar enthält eine Beleidigung gegen einen anderen Leser und verstößt damit gegen Punkt 4 unserer Netiquette („Respekt gegenüber anderen Teilnehmenden“).</p>
      <p class="mt-3"><strong>Wie die Entscheidung getroffen wurde:</strong> Der Kommentar wurde von einem automatischen Analysetool erkannt, die Entscheidung anschließend von einem Moderator bestätigt.</p>
      <p class="mt-3"><strong>Ihre Rechtsbehelfe:</strong> Wenn Sie diese Entscheidung für ungerechtfertigt halten, können Sie innerhalb von sechs Monaten widersprechen, indem Sie auf diese Nachricht antworten. Sie können sich auch an eine zertifizierte außergerichtliche Streitbeilegungsstelle wenden oder den Rechtsweg beschreiten.</p>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Wie OpenModeration Sie bei Ihren Begründungen unterstützt</h2>
      <ul>
        <li><strong>Eine schriftliche Begründung für jede Entscheidung.</strong> Jeder abgelehnte Kommentar erhält eine ausformulierte Erklärung in der Sprache Ihrer Wahl, die als Grundlage für den Grund dient (Buchstabe e oder d).</li>
        <li><strong>Der Anteil der Automatisierung, nachvollziehbar.</strong> Das Aktivitätsprotokoll zeigt, ob die Entscheidung von der KI oder von einem Moderator stammt, und von welchem (Buchstaben b und c).</li>
        <li><strong>Versandfertige Daten.</strong> API und Webhooks liefern für jeden Inhalt das Urteil, die Kategorie und die Erklärung: Sie können sie in die Nachricht an den Verfasser übernehmen.</li>
        <li><strong>Eine vollständige Historie.</strong> Alle Entscheidungen, ob automatisch oder menschlich, bleiben im Audit-Trail für Ihre Berichte und Prüfungen gespeichert.</li>
      </ul>
      <p>
        Der Hinweis auf die Rechtsbehelfe und die genaue Rechtsgrundlage bleiben Ihre Aufgabe: Sie hängen von Ihrem Dienst,
        Ihren Nutzungsbedingungen und dem anwendbaren Recht ab.
      </p>
      <p class="text-sm text-surface-400">
        Quelle: <a href="https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32022R2065" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Verordnung (EU) 2022/2065 vom 19. Oktober 2022 über einen Binnenmarkt für digitale Dienste (Gesetz über digitale Dienste)</a>, ABl. L 277 vom 27.10.2022, Artikel 17, 19, 24 und 52. Diese Seite dient der Information und stellt keine Rechtsberatung dar.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="Häufige Fragen" items={faqItems} />
    </div>
  </article>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Weiterlesen</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/de/moderationsrichtlinien" class="font-medium text-brand-600 hover:text-brand-500">Moderationsrichtlinien: Leitfaden und Vorlage &rarr;</a></li>
        <li><a href="/de/dsa-konformitaet" class="font-medium text-brand-600 hover:text-brand-500">DSA-Konformität mit OpenModeration &rarr;</a></li>
        <li><a href="/de/produkt/transparenz" class="font-medium text-brand-600 hover:text-brand-500">Jede Entscheidung schriftlich begründet &rarr;</a></li>
        <li><a href="/de/anwendungsfaelle/medien" class="font-medium text-brand-600 hover:text-brand-500">Kommentarmoderation für Medien &rarr;</a></li>
        <li><a href="/de/blog/dsa-leitfaden-kmu" class="font-medium text-brand-600 hover:text-brand-500">Der DSA für KMU: ein Praxisleitfaden &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Eine Begründung für jeden entfernten Kommentar." subtitle="OpenModeration formuliert die Erklärung zu jeder Entscheidung und hält fest, wer was entschieden hat. Kostenlos starten." />
</BaseLayout>
