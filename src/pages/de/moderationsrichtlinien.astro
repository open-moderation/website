---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import FAQ from '../../components/FAQ.astro';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Moderationsrichtlinien: wie Sie sie schreiben, was der DSA verlangt, und eine Vorlage",
  "description": "Leitfaden für die Moderationsrichtlinien (Community-Richtlinien, Netiquette) einer Website, eines Mediums oder einer Social-Media-Seite: Abschnitte, DSA-Pflichten, Regeln, die eine KI anwenden kann, und eine Vorlage.",
  "inLanguage": "de",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/de/moderationsrichtlinien" }
};

const sections = [
  { title: "Der Geist der Diskussion", text: "Wozu der Kommentarbereich da ist und welcher Ton erwartet wird. Zwei oder drei Sätze genügen, aber sie geben allen schwierigen Entscheidungen die Richtung vor." },
  { title: "Was verboten ist", text: "Beleidigungen und persönliche Angriffe, Hass oder diskriminierende Äußerungen, Drohungen, Belästigung, Spam und Werbung, Betrug, die Veröffentlichung personenbezogener Daten, rechtswidrige Inhalte. Jedes Verbot wird durch ein Beispiel verständlicher." },
  { title: "Was erlaubt bleibt", text: "Widerspruch, scharfe Kritik an einer Idee, einem Artikel oder einer Person des öffentlichen Lebens, Ironie, die niemanden trifft. Wer aufschreibt, was erlaubt ist, verhindert, dass aus übertriebener Vorsicht die Debatte zensiert wird." },
  { title: "Wie moderiert wird", text: "Wer moderiert, mit welchen Werkzeugen und wie sich automatische und menschliche Entscheidungen verteilen. Genau darüber sollen Sie Ihre Nutzer nach dem DSA informieren." },
  { title: "Die Sanktionen", text: "Entfernung des Kommentars, vorübergehende Sperre, dauerhafter Ausschluss: Eine abgestufte, allen bekannte Skala macht jede Entscheidung leichter akzeptierbar." },
  { title: "Wie man widerspricht", text: "Wo und wie ein Nutzer die Überprüfung einer Entscheidung beantragen kann und innerhalb welcher Frist er eine Antwort erhält." },
];

const faqItems = [
  {
    question: "Was sind Moderationsrichtlinien?",
    answer: "Es ist der Text, der festlegt, was in einem Kommentarbereich, einem Forum oder unter den Beiträgen einer Seite akzeptiert oder abgelehnt wird, und wie Entscheidungen getroffen werden. Man spricht auch von Community-Richtlinien, Diskussionsregeln oder Netiquette.",
  },
  {
    question: "Sind Moderationsrichtlinien Pflicht?",
    answer: "Der DSA verpflichtet jeden Anbieter von Vermittlungsdiensten, in seinen allgemeinen Geschäftsbedingungen die Beschränkungen anzugeben, die er Inhalten auferlegt, sowie die Leitlinien, Verfahren und Werkzeuge der Moderation, einschließlich der algorithmischen Entscheidungsfindung und der menschlichen Überprüfung (Artikel 14). Klare Moderationsrichtlinien sind der einfachste Weg, diese Pflicht zu erfüllen.",
  },
  {
    question: "Kann eine KI Moderationsrichtlinien anwenden?",
    answer: "Ja, wenn sie in klarer Sprache formuliert sind, mit Beispielen und einer deutlichen Grenze zwischen eindeutigen Fällen und solchen, die ein Mensch prüfen soll. In OpenModeration erhält die KI Ihre Richtlinien zu jedem Kommentar, zusammen mit dem Titel des Beitrags und dem Diskussionsverlauf.",
  },
  {
    question: "Braucht man je nach Ressort unterschiedliche Richtlinien?",
    answer: "Oft ja. Ein Sportressort und ein Politikressort erfordern nicht dieselbe Wachsamkeit, besonders im Wahlkampf. Am einfachsten ist es, gemeinsame Richtlinien beizubehalten und für bestimmte Quellen oder Ressorts eigene Anweisungen zu ergänzen.",
  },
  {
    question: "Wie oft sollte man die Moderationsrichtlinien aktualisieren?",
    answer: "Sobald die Nachrichtenlage neue Formen von Missbrauch hervorbringt oder Ihre Moderatoren immer wieder dieselben Entscheidungen korrigieren. Der DSA verlangt, die Nutzer über wesentliche Änderungen der allgemeinen Geschäftsbedingungen zu informieren.",
  },
];
---

<BaseLayout title="Moderationsrichtlinien: Leitfaden, DSA-Pflichten und Vorlage" description="So schreiben Sie Moderationsrichtlinien für Website, Medium oder Social Media: die nötigen Abschnitte, was der DSA verlangt, Regeln für die KI und eine Vorlage." ogType="article" jsonLd={articleJsonLd}>
  <Breadcrumb items={[{ label: "Startseite", href: "/de" }, { label: "Moderationsrichtlinien" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">20. Oktober 2026</time>
        <span>&middot;</span>
        <span>8 Min. Lesezeit</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderationsrichtlinien: wie Sie sie schreiben, was der DSA verlangt, und eine Vorlage</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        Gute Moderation beginnt mit einem guten Text. Ihre Moderationsrichtlinien sagen Ihren Lesern, was sie schreiben dürfen,
        leiten Ihre Moderatoren in schwierigen Fällen und dienen heute auch der KI als Anweisung, die die Kommentare sortiert.
        Hier erfahren Sie, wie Sie sie aufbauen, was das Gesetz verlangt, und Sie erhalten eine Vorlage für den Einstieg.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Was der DSA verlangt</h2>
      <p>
        Die europäische Verordnung über digitale Dienste (DSA) verpflichtet alle Anbieter von Vermittlungsdiensten, in ihren
        allgemeinen Geschäftsbedingungen die Beschränkungen anzugeben, die sie den von ihren Nutzern bereitgestellten Inhalten
        auferlegen (Artikel 14). Diese Angaben müssen Folgendes umfassen:
      </p>
      <ul>
        <li>die Leitlinien, Verfahren, Maßnahmen und Werkzeuge, die zur Moderation von Inhalten eingesetzt werden;</li>
        <li>die algorithmische Entscheidungsfindung und die menschliche Überprüfung;</li>
        <li>die Verfahrensregeln für das interne Beschwerdemanagementsystem.</li>
      </ul>
      <p>
        Der Text muss in klarer, einfacher, verständlicher und eindeutiger Sprache abgefasst und öffentlich zugänglich sein,
        und die Nutzer müssen über wesentliche Änderungen informiert werden. Schließlich muss die Moderation sorgfältig,
        objektiv und verhältnismäßig erfolgen und dabei das Recht auf freie Meinungsäußerung sowie die Freiheit und den
        Pluralismus der Medien berücksichtigen.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Die Abschnitte guter Moderationsrichtlinien</h2>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      {sections.map((s) => (
        <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
          <p class="text-sm font-medium text-surface-900">{s.title}</p>
          <p class="mt-1 text-sm text-surface-500">{s.text}</p>
        </div>
      ))}
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Regeln schreiben, die eine KI anwenden kann</h2>
      <p>
        Eine KI liest Ihre Richtlinien wie ein neuer Moderator: Sie wendet an, was dort steht, und nicht mehr. Einige
        Grundsätze machen den entscheidenden Unterschied.
      </p>
      <ul>
        <li><strong>Sätze statt Wortlisten.</strong> „Keine Beleidigung anderer Leser, auch nicht verschleiert“ deckt weit mehr Fälle ab als eine Liste verbotener Wörter, die Ironie und absichtliche Tippfehler durchlässt.</li>
        <li><strong>Beispiele in beide Richtungen.</strong> Zu jedem Verbot ein abgelehntes Beispiel und ein ähnliches, akzeptiertes Beispiel. So ziehen Sie die Grenze am besten.</li>
        <li><strong>Der Kontext zählt.</strong> Dasselbe Wort wiegt unter einem Artikel über eine Spendenaktion anders als unter einem Thema, das spaltet. Schreiben Sie das hinein und nutzen Sie ein Tool, das der KI das Thema des Beitrags mitgibt.</li>
        <li><strong>Ein bewusster Graubereich.</strong> Legen Sie fest, welche Fälle ein Mensch prüfen soll, statt sie automatisch zu entscheiden: harte Kritik an einem Journalisten, laufende Gerichtsverfahren, politische Grenzfälle.</li>
        <li><strong>Anweisungen zur Nachrichtenlage.</strong> Ergänzen Sie während einer Wahl oder nach einem aufsehenerregenden Ereignis lieber eine gezielte, befristete Anweisung, als die gesamten Richtlinien zu verschärfen.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">Vorlage für Moderationsrichtlinien</h2>
      <p>Eine Vorlage zum Anpassen, hier für den Kommentarbereich einer Nachrichtenseite:</p>
    </div>

    <div class="mt-6 rounded-xl border border-surface-200 bg-white p-6 text-sm leading-relaxed text-surface-700 shadow-sm">
      <p class="font-semibold text-surface-900">Netiquette</p>
      <p class="mt-3">Die Kommentare sind ein Raum für Debatten rund um unsere Artikel. Sie können hier Ihren Widerspruch äußern, auch gegenüber der Redaktion, sofern Sie die anderen Teilnehmenden respektieren.</p>
      <p class="mt-3"><strong>Nicht zulässig sind:</strong> Beleidigungen und persönliche Angriffe, auch verschleierte; Hass oder diskriminierende Äußerungen; Drohungen und Aufrufe zur Gewalt; die Belästigung anderer Teilnehmender; Werbung, Spam und irreführende Links; die Veröffentlichung personenbezogener Daten Dritter; alle rechtswidrigen Inhalte.</p>
      <p class="mt-3"><strong>Zulässig sind:</strong> Kritik, auch scharfe, an einer Idee, einem Artikel oder einer Person des öffentlichen Lebens; Ironie, die sich nicht gegen eine bestimmte Person richtet; Minderheitenmeinungen, die ohne Angriff geäußert werden.</p>
      <p class="mt-3"><strong>Wie wir moderieren:</strong> Die Kommentare werden von einem automatischen Tool analysiert, das diese Netiquette anwendet. Unklare Fälle prüft unser Team. Jede Entfernung eines Kommentars wird begründet.</p>
      <p class="mt-3"><strong>Sanktionen:</strong> Entfernung des Kommentars, im Wiederholungsfall vorübergehende Sperre des Kontos, danach dauerhafter Ausschluss.</p>
      <p class="mt-3"><strong>Eine Entscheidung anfechten:</strong> Sie können die Überprüfung einer Entscheidung beantragen, indem Sie auf die Nachricht antworten, mit der wir Sie darüber informiert haben. Wir antworten Ihnen so schnell wie möglich.</p>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Richtlinien lebendig halten</h2>
      <p>
        Moderationsrichtlinien sind nie fertig. Die Entscheidungen Ihrer Moderatoren zeigen, wo sie unklar sind: Wenn sie die
        KI bei derselben Art von Kommentar immer wieder korrigieren, fehlt eine Regel oder ein Beispiel ist schlecht gewählt.
        In OpenModeration lernt das System aus diesen Entscheidungen und schlägt Anpassungen Ihrer Regeln vor, die Sie mit
        einem Klick übernehmen. Jede Änderung erzeugt eine neue Version, sodass Sie wissen, welche Regel bei welcher
        Entscheidung galt.
      </p>
      <p class="text-sm text-surface-400">
        Quelle: <a href="https://eur-lex.europa.eu/legal-content/DE/TXT/?uri=CELEX:32022R2065" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Verordnung (EU) 2022/2065 über einen Binnenmarkt für digitale Dienste (Gesetz über digitale Dienste)</a>, Artikel 14. Diese Seite dient der Information und stellt keine Rechtsberatung dar.
      </p>
    </div>
  </article>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Häufige Fragen zu Moderationsrichtlinien" items={faqItems} />
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Weiterlesen</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/de/dsa-konformitaet/begruendung" class="font-medium text-brand-600 hover:text-brand-500">Die vom DSA verlangte Begründung &rarr;</a></li>
        <li><a href="/de/anwendungsfaelle/medien" class="font-medium text-brand-600 hover:text-brand-500">Kommentarmoderation für Medien &rarr;</a></li>
        <li><a href="/de/social-media-moderation" class="font-medium text-brand-600 hover:text-brand-500">Social-Media-Moderation &rarr;</a></li>
        <li><a href="/de/dsa-konformitaet" class="font-medium text-brand-600 hover:text-brand-500">DSA-Konformität mit OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Lassen Sie Ihre Richtlinien für sich arbeiten." subtitle="Fügen Sie Ihre Moderationsrichtlinien in OpenModeration ein: Sie gelten für jeden Kommentar, und unser Team hilft Ihnen, sie zu verfeinern. Kostenlos starten." />
</BaseLayout>
