---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FAQ from '../../components/FAQ.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/nl/tekstmoderatie-api",
      "url": "https://www.openmoderation.com/nl/tekstmoderatie-api",
      "name": "Tekstmoderatie-API: reacties, chat en berichten modereren",
      "description": "Een tekstmoderatie-API die giftige reacties, chatberichten en gebruikersreviews filtert: onze eigen gecontroleerde AI, eigen regels, dubbele drempels en DSA-audittrajecten.",
      "inLanguage": "nl",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/nl/tekstmoderatie-api#software",
      "name": "OpenModeration Text Moderation API",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Alle (REST API)",
      "description": "Tekstmoderatie-API: één endpoint, onze eigen gecontroleerde moderatie-AI, eigen regels, dubbele drempels, batch-endpoints en DSA-audittrajecten.",
      "url": "https://www.openmoderation.com/nl/tekstmoderatie-api",
      "inLanguage": "nl",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
    }
  ]
};

const quickstart = `# Modereer elke tekst: reacties, chat, berichten, reviews
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "user comment here",
    "categories": ["hate", "harassment", "sexual", "violence", "self-harm", "spam"],
    "threshold": 0.5
  }'

# Response (gestandaardiseerd formaat)
{
  "flagged": false,
  "results": [{ "category": "harassment", "score": 0.03, "flagged": false }],
  "usage": { "latency_ms": 212 }
}`;

const useCases = [
  { name: "Reacties en reviews", desc: "Verberg haatzaaiende taal, spam en gelekte persoonsgegevens in reacties, reviews en forumberichten automatisch, nog voordat ze online staan." },
  { name: "Chat en berichten", desc: "Realtime moderatie in veel talen, met een latentie onder 250 ms en automatische acties." },
  { name: "Prompts in AI-apps", desc: "Filter wat gebruikers insturen en wat je LLM antwoordt. Je eigen categorieën kunnen in de loop van de tijd veranderen." },
  { name: "Advertenties op marktplaatsen", desc: "Markeer spamadvertenties, oplichting en verboden content in titels en beschrijvingen zodra ze binnenkomen." },
];

const faqItems = [
  {
    question: "Wat is een tekstmoderatie-API?",
    answer: "Een tekstmoderatie-API geeft scores aan wat gebruikers schrijven (haat, intimidatie, seksuele content, geweld, spam, persoonsgegevens…) zodat je app het automatisch kan goedkeuren, markeren of afwijzen. OpenModeration draait zijn eigen moderatie-AI achter één endpoint, bij lastige gevallen gecontroleerd door andere AI-modellen, met één responseformaat, eigen regels en een audittraject."
  },
  {
    question: "Welke tekstmoderatie-API moet ik kiezen?",
    answer: "Kale model-API's (OpenAI, Azure, Mistral) zijn snel op te starten, maar binden je aan één model dat tussen twee updates stilstaat. OpenModeration draait zijn eigen moderatie-AI, laat lastige gevallen controleren door andere AI-modellen, sluit betere modellen aan zodra ze uitkomen en voegt voorfiltering, regels en menselijke beoordeling van twijfelgevallen door ons team toe."
  },
  {
    question: "Wat kost een tekstmoderatie-API?",
    answer: "Het moderatie-endpoint van OpenAI is gratis, Mistral bepaalt zelf de prijs van zijn moderatiemodel, en Azure AI Content Safety rekent per 1.000 tekstrecords af na een gratis tegoed van 5.000 records per maand. OpenModeration heeft een gratis abonnement tot 1.000 verzoeken per maand. Het Pro-abonnement in de beheerde cloud begint bij € 99 per maand voor 10.000 verzoeken."
  },
  {
    question: "Kan ik eigen moderatieregels opstellen?",
    answer: "Ja, met drie hulpmiddelen en zonder code. Verboden woorden blokkeren een bericht direct. Drempels per categorie bepalen of iets automatisch wordt goedgekeurd, door ons team wordt beoordeeld of automatisch wordt afgewezen. Je eigen regels, in gewone taal geschreven, worden door onze AI toegepast voor categorieën zoals desinformatie of grooming."
  },
  {
    question: "Kan ik overstappen van openai text-moderation-latest?",
    answer: "Ja. Vervang openai.moderations.create door één aanroep van POST /v1/moderation. Je krijgt gestandaardiseerde scores, schriftelijke motiveringen en een audittraject, en als wij een beter AI-model aansluiten, verandert er niets aan je code."
  },
  {
    question: "Wordt elke moderatiebeslissing vastgelegd?",
    answer: "Ja. Bij elke beslissing van de AI of van een mens worden de scores, drempels, beoordelaar en tijdstempel bewaard. Je exporteert het volledige audittraject met één klik voor je DSA-transparantieverslagen."
  },
];
---

<BaseLayout
  title="Tekstmoderatie-API: reacties, chat en berichten"
  description="Tekstmoderatie-API met onze eigen AI, gecontroleerd door andere modellen. Verberg giftige reacties, chatspam en persoonsgegevens, met eigen regels en DSA-log."
  jsonLd={pageJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Tekstmoderatie-API" }]} />

  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Voor ontwikkelaars: REST API en dashboard
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Een tekstmoderatie-API die ook iets doet met de score.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Eén endpoint modereert reacties, chat, berichten en reviews met onze eigen AI,
        bij lastige gevallen gecontroleerd door andere modellen. Voorfiltering, eigen regels, dubbele drempels
        en een audittraject dat klaar is voor de DSA zijn inbegrepen.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Vraag een gratis API-sleutel aan
        </a>
        <a href="https://api.openmoderation.com/docs" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          Lees de API-documentatie &rarr;
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Gratis abonnement · Geen creditcard · OpenAPI-referentie</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Elke tekst modereren, met één verzoek</h2>
          <p class="mt-4 text-lg text-surface-500">
            Stuur tekst naar één endpoint. Onze moderatie-AI analyseert hem, en andere AI-modellen controleren de lastige gevallen.
            Scores komen terug in één formaat, met drempels die jij bepaalt.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>10 categorieën, meer dan 120 talen.</strong> Haat, intimidatie, seksuele content, geweld, zelfbeschadiging, spam, persoonsgegevens en je eigen categorieën.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Voorfilter.</strong> Duidelijke spam en verboden woorden worden geblokkeerd vóór elke AI-aanroep.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Dubbele drempels.</strong> Duidelijke gevallen worden automatisch goedgekeurd of afgewezen, en het grijze gebied wordt beoordeeld door ons team.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Batches tot 10.000 teksten.</strong> Batchaanroepen gebruiken hetzelfde schema als aanroepen voor één tekst.</span></li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3 text-sm">
            <a href={localizePath('/content-moderation-api', locale)} class="font-medium text-brand-600 hover:text-brand-500">Volledige API voor contentmoderatie &rarr;</a>
            <a href={localizePath('/alternatives/openai-moderation', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alternatief voor OpenAI Moderation &rarr;</a>
            <a href={localizePath('/features', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alle API-functies &rarr;</a>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={quickstart} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Gemaakt voor elke use case van tekstmoderatie</h2>
        <p class="mt-4 text-lg text-surface-500">Eén API voor elke plek waar gebruikers typen.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {useCases.map((u) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{u.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{u.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Kale model-API vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Een kale toxiciteitsscore is nog geen moderatiesysteem.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Functie</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Kale tekst-API van een model</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            <tr><td class="px-6 py-4 font-medium text-surface-900">AI-engine</td><td class="px-6 py-4 text-surface-500">Eén model (lock-in)</td><td class="px-6 py-4">Onze eigen AI, gecontroleerd door andere modellen; betere modellen worden aangesloten zodra ze uitkomen</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Eigen regels</td><td class="px-6 py-4 text-surface-500">Zelf bouwen</td><td class="px-6 py-4">Verboden woorden, drempels en regels in gewone taal toegepast door AI, zonder code</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Menselijke beoordeling</td><td class="px-6 py-4 text-surface-500">Zelf bouwen</td><td class="px-6 py-4">Twijfelgevallen afgehandeld door ons team; jij ziet elke beslissing in realtime en kunt ingrijpen</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Audittraject</td><td class="px-6 py-4 text-surface-500">Alleen API-logs</td><td class="px-6 py-4">Volledige DSA-export van beslissingen door AI en mensen</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Prijs</td><td class="px-6 py-4 text-surface-500">Bepaald door elke leverancier, van gratis (OpenAI) tot betalen per aanroep</td><td class="px-6 py-4">Gratis abonnement tot 1.000 verzoeken per maand · Pro vanaf € 99 per maand</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Tekstmoderatie-API: veelgestelde vragen" />
    </div>
  </section>

  <CTASection
    title="Begin binnen enkele minuten met tekstmoderatie."
    subtitle="Vraag een API-sleutel aan, kopieer het curl-voorbeeld en modereer vandaag nog je eerste tekst, met regels, menselijke beoordeling door ons team en een audittraject vanaf dag één."
    buttonText="Probeer de API gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
