---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'nl';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Moderatieconsole: elke beslissing en de reden, live",
  "description": "Elke reactie met beslissing en schriftelijke reden in realtime, op je website en sociale kanalen. Ons team behandelt twijfelgevallen; jij grijpt in als je wilt.",
  "crumb": "Moderatieconsole",
  "badge": "Wat je in realtime ziet",
  "h1": "Elke beslissing en de reden ervan, in realtime",
  "lead": "De console is geen tool die je zelf moet bedienen. Onze AI en ons team modereren; jij ziet elke reactie, de beslissing, de schriftelijke reden en wie haar nam, en je kunt corrigeren wanneer je wilt.",
  "feedTitle": "Je moderatie, live",
  "feedLead": "De reacties van je website en je pagina’s naast elkaar, elk met de beslissing en de reden erachter.",
  "quote": [
    "“",
    "”"
  ],
  "reasonLabel": "Reden:",
  "overrideLabel": "Corrigeren",
  "feed": [
    {
      "platform": "Website",
      "kind": "published",
      "decision": "Gepubliceerd",
      "by": "Onze AI",
      "text": "Goed stuk, maar de cijfers in de tweede alinea lijken verouderd.",
      "reason": "Constructieve kritiek, geen regel overtreden."
    },
    {
      "platform": "Facebook",
      "kind": "refused",
      "decision": "Verborgen",
      "by": "Onze AI, gecontroleerd",
      "text": "Jullie zijn allemaal corrupt, iemand moet jullie voorgoed de mond snoeren.",
      "reason": "Bedreiging en persoonlijke aanval."
    },
    {
      "platform": "Instagram",
      "kind": "refused",
      "decision": "Verborgen",
      "by": "Onze AI",
      "text": "Goedkope volgers hier, check mijn profiel!!!",
      "reason": "Spam."
    },
    {
      "platform": "YouTube",
      "kind": "team",
      "decision": "Geweigerd na beoordeling",
      "by": "Ons team",
      "text": "Typisch voor dat soort mensen, die veranderen nooit.",
      "reason": "Generalisatie gericht op een groep, in strijd met je huisregels."
    }
  ],
  "shotAlt": "OpenModeration-console: reacties, beslissingen en schriftelijke redenen, platform per platform",
  "shotCaption": "De console: reacties, beslissingen en redenen, platform per platform.",
  "illustrative": "Voorbeelden en cijfers ter illustratie, uit een demo-omgeving.",
  "kpis": [
    {
      "label": "Reacties vandaag geanalyseerd",
      "value": "84,2k"
    },
    {
      "label": "Verborgen, elk met een schriftelijke reden",
      "value": "4,7%"
    },
    {
      "label": "Twijfelgevallen behandeld door ons team",
      "value": "2%"
    }
  ],
  "cardsTitle": "Wat je ziet en wat je kunt doen",
  "cardsLead": "Volledige transparantie, niets te bedienen. Je grijpt alleen in als je dat wilt.",
  "cards": [
    {
      "title": "Elke beslissing, met de reden",
      "text": "Elke reactie, de genomen beslissing en de schriftelijke reden, op je website en elke gekoppelde pagina."
    },
    {
      "title": "Twijfelgevallen voor ons team",
      "text": "Als de AI twijfelt, beslist ons team volgens jouw regels. Je ziet wat het heeft behandeld en waarom."
    },
    {
      "title": "Op elk moment corrigeren",
      "text": "Publiceer, verberg of herstel een reactie met één klik. Elke wijziging wordt vastgelegd met de auteur."
    },
    {
      "title": "Meldingen en bezwaren opgevolgd",
      "text": "Meldingen van gebruikers en betwiste beslissingen worden gevolgd tot het antwoord, zoals de DSA vraagt."
    },
    {
      "title": "Exporteerbare cijfers",
      "text": "Volumes en beslissingen per categorie, platform per platform. Exporteer ze voor je DSA-rapportage en interne evaluaties."
    },
    {
      "title": "Je regels in beeld",
      "text": "Zie welke regels op je kanalen gelden. Om ze te wijzigen, laat het ons weten of pas ze zelf aan: ons team helpt je."
    }
  ],
  "devTitle": "Voor technische teams",
  "devLead": "De console geeft je developers ook alles om OpenModeration te integreren en te monitoren.",
  "devPoints": [
    "Toegangssleutels, met limieten en rechten per sleutel",
    "Activiteitenlog doorzoekbaar per reactie: scores, toegepaste regel en resultaat",
    "Servicestatus, met latency en foutpercentages",
    "Gegevensbewaring, toegestane origins en webhooks"
  ]
};

const decisionStyles: Record<string, string> = {
  published: 'bg-green-100 text-green-700',
  refused: 'bg-red-100 text-red-700',
  team: 'bg-amber-100 text-amber-700',
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/moderatieconsole",
  "url": "https://www.openmoderation.com/nl/moderatieconsole",
  "name": "Moderatieconsole: elke beslissing en de reden, live",
  "description": "Elke reactie met beslissing en schriftelijke reden in realtime, op je website en sociale kanalen. Ons team behandelt twijfelgevallen; jij grijpt in als je wilt.",
  "inLanguage": "nl",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-accent-500"></span> {c.badge}
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- What you see: live feed -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.feedTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.feedLead}</p>
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <ul class="divide-y divide-surface-100 overflow-hidden rounded-2xl border border-surface-200 bg-white shadow-sm">
          {c.feed.map((f) => (
            <li class="p-5">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-surface-600">{f.platform}</span>
                <span class={`rounded-full px-2.5 py-0.5 font-semibold ${decisionStyles[f.kind]}`}>{f.decision}</span>
                <span class="text-surface-400">{f.by}</span>
              </div>
              <p class="mt-3 text-surface-800">{c.quote[0]}{f.text}{c.quote[1]}</p>
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
                <p class="text-surface-500"><span class="font-medium text-surface-700">{c.reasonLabel}</span> {f.reason}</p>
                <span class="rounded-md border border-surface-300 px-3 py-1 text-xs font-semibold text-surface-700">{c.overrideLabel}</span>
              </div>
            </li>
          ))}
        </ul>
        <div>
          <BrowserFrame src="/images/dashboard.png" video="om-triage" alt={c.shotAlt} caption={c.shotCaption} eager={false} />
          <p class="mt-6 text-center text-xs text-surface-400">{c.illustrative}</p>
        </div>
      </div>
      <dl class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {c.kpis.map((k) => (
          <div class="flex flex-col-reverse rounded-xl border border-surface-200 bg-surface-50 p-6">
            <dt class="mt-1 text-sm text-surface-500">{k.label}</dt>
            <dd class="text-3xl font-bold text-surface-900">{k.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- What you see and what you can do -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.cardsTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.cardsLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {c.cards.map((card) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{card.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.devTitle}</h2>
      <p class="mt-3 text-surface-500">{c.devLead}</p>
      <ul class="mt-6 space-y-2 text-sm text-surface-600">
        {c.devPoints.map((p) => (
          <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
