---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModerationDemo from '../../components/ModerationDemo.astro';
import { bookingUrl, useTranslations } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import ValueCards from '../../components/ValueCards.astro';
import AppVideo from '../../components/AppVideo.astro';
import AIEngine from '../../components/AIEngine.astro';
import CostCalculator from '../../components/CostCalculator.astro';
import TeamSection from '../../components/TeamSection.astro';
import PricingTeaser from '../../components/PricingTeaser.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "description": "AI comment moderation adapted to each client's rules and use cases, with a team that sets it up. DSA-compliant, hosted in the EU.",
      "email": "contact@openmoderation.com",
      "areaServed": "EU",
      "knowsAbout": ["Comment moderation", "Content moderation", "Social media moderation", "Digital Services Act compliance", "Trust and safety"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "contact@openmoderation.com",
        "url": "https://www.openmoderation.com/nl/afspraak-maken",
        "availableLanguage": ["English", "French", "Spanish", "German", "Italian"]
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "inLanguage": "nl",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/#software",
      "name": "OpenModeration",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "AI-moderatie van reacties voor nieuwssites, merken en socialmediapagina's, afgestemd op je regels en use cases. Werkt op je website, Facebook, Instagram, YouTube en WordPress, laat twijfelgevallen door ons team afhandelen, licht elke beslissing schriftelijk toe, toont die in realtime en is DSA-proof. Jij koppelt alleen je pagina's, wij doen de rest.",
      "url": "https://www.openmoderation.com/nl",
      "inLanguage": "nl",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Reacties per dag gemodereerd", value: "10M+" },
  { label: "Klaar in", value: "5 min" },
  { label: "Automatische moderatie", value: "24/7" },
  { label: "Beslissingen schriftelijk uitgelegd", value: "100%" },
];

const valueItems = [
  { title: "Jouw regels, jouw use cases", text: "We stemmen de moderatie af op je regels en op wat er in jouw context toe doet: ironie, politiek, concurrenten, lokale straattaal. Niets generieks." },
  { title: "Een team achter de tool", text: "We helpen je je regels te schrijven en bij te stellen, handelen de twijfelgevallen zelf af en passen aan als je community verandert. Je hebt altijd iemand om mee te praten." },
  { title: "Alles draait automatisch", text: "Koppel gewoon je pagina's: elke reactie wordt binnen enkele seconden afgehandeld, dag en nacht. Twijfelgevallen handelt ons team af. Jij hoeft niets te doen, maar ziet alles in realtime en kunt ingrijpen wanneer je wilt." },
  { title: "Veel goedkoper dan handwerk", text: "Automatische moderatie kost een fractie van een uitbesteed of eigen moderatieteam." },
];


const faqItems = [
  {
    question: 'Welk moderatieplatform combineert een dashboard voor moderatoren, AI die context begrijpt en auditlogs voor compliance?',
    answer: 'OpenModeration brengt die drie samen. AI die context begrijpt leest elke reactie, je regels bepalen wat wordt verborgen of gepubliceerd, ons team handelt de twijfelgevallen af, jij ziet alles in realtime in één dashboard en kunt ingrijpen wanneer je wilt, en elke beslissing wordt met een schriftelijke reden vastgelegd voor DSA-audits.',
  },
  {
    question: 'Bestaat er een tool zonder code waarmee ik moderatieregels kan schrijven, AI-classificatie kan gebruiken en een audittraject kan bijhouden?',
    answer: 'Ja. In OpenModeration schrijf je je regels in gewone taal en stel je drempels per categorie in, zonder code. De AI-classificatie draait op elke reactie, en het activiteitenlog legt elke actie vast: wie of wat die uitvoerde, en waarom.',
  },
  {
    question: 'Kan ik Facebook, Instagram, YouTube en mijn website vanuit één plek modereren?',
    answer: 'Ja. Koppel je Facebook-pagina\'s, Instagram-accounts, YouTube-kanalen en WordPress-site, of stuur content van elk platform in via de API. Alles komt in realtime terecht in dezelfde console, met dezelfde regels.',
  },
  {
    question: 'Waar let ik op bij een moderatie-API voor compliance in een grote organisatie?',
    answer: 'Let op een schriftelijke motivering bij elke beslissing (vereist door artikel 17 van de DSA), een volledig auditlog, hosting van gegevens in de EU, instelbare bewaartermijnen en exporteerbare rapporten. OpenModeration biedt alle vijf, en ons team zet de regels samen met jou op.',
  },
  {
    question: 'Is OpenModeration gratis?',
    answer: 'Het cloudabonnement is gratis tot 1.000 verzoeken per maand, het Pro-abonnement kost € 99 per maand voor 10.000 verzoeken. Voor grote volumes of een on-premise installatie plan je een gesprek en stellen we samen het aanbod op maat.',
  },
];
---

<BaseLayout
  title="AI-moderatie van reacties, DSA-proof | OpenModeration"
  description="AI-moderatie van reacties die zich aanpast aan je regels en use cases, op je website en social media. DSA-proof, gehost in de EU, met een team naast je."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-violet-50" />
    <div class="joy-blob pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-300/40 blur-3xl" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute -right-24 top-10 h-[28rem] w-[28rem] rounded-full bg-violet-300/40 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-sun-300/30 blur-3xl" style="animation-delay:-12s" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16">
      <div class="text-center lg:text-left">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Voor nieuwssites, merken en socialmediapagina's
        </div>
        <h1 class="animate-fade-in-up text-4xl font-extrabold leading-[1.05] tracking-tight text-surface-900 sm:text-5xl lg:text-[3.7rem]">
          Moderatie die zich aanpast aan <em>jouw</em> regels.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-600 sm:text-xl">
          Jij koppelt alleen je pagina's. We richten de AI in rond je regels en je use cases, ons team handelt de twijfelgevallen af,
          en jij ziet elke beslissing in realtime, voor veel minder dan handmatige moderatie.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Plan een gesprek
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Probeer het gratis
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">Of test meteen een reactie, zonder aanmelding</a></p>
        <div class="animate-fade-in-up delay-2 mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-surface-500 lg:justify-start">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            Gemaakt en gehost in de EU
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            AVG-proof
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Menselijke ondersteuning inbegrepen
          </span>
        </div>
      </div>
      <HeroAnimation />
    </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderatie die voor je wordt ingericht, geen tool die je zelf moet uitzoeken</h2>
      </div>
      <ValueCards items={valueItems} />
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Plan een gesprek en zie het op je eigen reacties</a>
      </div>
    </div>
  </section>

  <AppVideo />

  <AIEngine />

  <section id="demo" class="bg-gradient-to-br from-violet-50 via-white to-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Dark Contrast Section: DSA Compliance -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800 px-4 py-1.5 text-sm text-surface-300">
          <svg class="h-4 w-4 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Klaar voor de DSA
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Gebouwd voor naleving van regelgeving
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-surface-400">
          Elke moderatiebeslissing komt in een volledig audittraject. Jij bepaalt de bewaartermijnen,
          exporteert transparantieverslagen, en je gegevens blijven gehost in de EU.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm">
            Probeer het gratis
          </a>
          <a href={localizePath('/dsa-compliance', locale)} class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
            Meer over DSA-naleving
          </a>
        </div>
        <p class="mt-4 text-sm text-surface-400">Geen creditcard nodig</p>
      </div>
    </div>
  </section>

  <CostCalculator />

  <PricingTeaser />



  <TeamSection />

  <section class="bg-white pb-6 pt-2">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="flex flex-wrap items-center justify-center gap-4">
        <a href={localizePath('/integrations/facebook', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Tool voor moderatie van Facebook-reacties &rarr;</a>
        <a href={localizePath('/integrations/instagram', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Automatische moderatie op Instagram &rarr;</a>
        <a href={localizePath('/dashboard', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Eén moderatieconsole voor alles &rarr;</a>
        <a href={localizePath('/use-cases/news-publishers', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderatie van reacties voor nieuwsuitgevers &rarr;</a>
        <a href={localizePath('/use-cases/brands-retail', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderatie van reacties voor merken &rarr;</a>
        <a href={localizePath('/blog/comment-moderation-guide', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">De complete gids voor moderatie van reacties &rarr;</a>
        <a href={localizePath('/alternatives/openai-moderation', locale)} class="text-sm font-medium text-surface-500 hover:text-surface-700">Vergelijk met alternatieven &rarr;</a>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Vragen die teams stellen voordat ze een moderatieplatform kiezen" items={faqItems} />
    </div>
  </section>

  <CTASection />
</BaseLayout>