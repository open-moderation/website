---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/hoe-het-werkt",
  "url": "https://www.openmoderation.com/nl/hoe-het-werkt",
  "name": "Zo werkt AI-contentmoderatie: de volledige keten",
  "description": "Begrijp de volledige moderatieketen: content binnenhalen, AI-moderatie met dubbele AI-controle, automatische regels en acties, en menselijke beoordeling.",
  "inLanguage": "nl",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const facebookWebhookExample = `// Facebook stuurt een reactie via webhook
{
  "source": "facebook",
  "content_id": "comment_123",
  "author_id": "user_456",
  "text": "Comment text here...",
  "metadata": {"post_url": "..."}
}`;

const moderationResponseExample = `{
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const ruleConfigExample = `// Stel je moderatiedrempels in
PUT /v1/settings

{
  "thresholds": {
    "hate":       { "accepted": 0.3, "rejected": 0.7 },
    "harassment": { "accepted": 0.3, "rejected": 0.7 },
    "sexual":     { "accepted": 0.2, "rejected": 0.8 },
    "violence":   { "accepted": 0.3, "rejected": 0.7 },
    "self-harm":  { "accepted": 0.2, "rejected": 0.8 },
    "spam":       { "accepted": 0.4, "rejected": 0.8 }
  },
  "actions": {
    "on_reject": ["hide", "flag_for_review"]
  }
}`;

const auditTrailExample = `// Volledig audittraject voor elk content-item
{
  "content_id": "...",
  "source": "webhook",
  "platform": "facebook",
  "status": "actioned",
  "moderation": {
    "flagged": true,
    "results": [...]
  },
  "actions": [{
    "rule": "Hide hate speech",
    "type": "hide",
    "status": "executed"
  }]
}`;
---

<BaseLayout title="Zo werkt AI-contentmoderatie: de volledige keten" description="Begrijp de volledige moderatieketen: content binnenhalen, AI-moderatie met dubbele AI-controle, automatische regels en acties, en menselijke beoordeling." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Hoe het werkt" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Hoe het werkt</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Eén keten brengt elke reactie van binnenkomst tot automatische actie.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Pipeline Overview -->
      <div class="mb-20">
        <div class="relative rounded-2xl border border-surface-200 bg-surface-50 p-8">
          <div class="grid gap-6 grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-brand-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">1. Binnenkomst</h3>
              <p class="mt-2 text-sm text-surface-500">Content komt binnen via de API, een webhook of een connector voor sociale platforms.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">POST /v1/moderation</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Webhooks</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Facebook</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Instagram</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">YouTube</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-brand-400 bg-white p-6 text-center shadow-md">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">2. AI-moderatie</h3>
              <p class="mt-2 text-sm text-surface-500">Onze eigen AI analyseert de content, andere AI-modellen controleren lastige gevallen, en je krijgt een gestandaardiseerd resultaat terug.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">Eigen AI</span>
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">Controle door andere AI’s</span>
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">Schriftelijke motivering</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-surface-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">3. Regels en acties</h3>
              <p class="mt-2 text-sm text-surface-500">De regel-engine beoordeelt de resultaten en acties worden automatisch uitgevoerd.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Verbergen</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Vasthouden</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Publiceren</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Webhook</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-surface-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">4. Menselijke beoordeling</h3>
              <p class="mt-2 text-sm text-surface-500">Grensgevallen worden afgehandeld door ons team. Jij ziet alles in realtime en kunt ingrijpen.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Ons team</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Goedkeuren</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Afwijzen</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Detailed Steps -->
      <div class="space-y-16">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Stap 1</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Content komt overal vandaan</h2>
            <p class="mt-4 text-surface-500">
              Content kan via verschillende kanalen binnenkomen. Roep de API direct aan,
              stel webhooks in om content van externe platforms te ontvangen, of zet de kant-en-klare
              connectoren voor social media op, die reacties en posts automatisch binnenhalen.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>API:</strong> POST /v1/moderation voor losse of batchmoderatie</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Webhooks:</strong> een generiek endpoint ontvangt en normaliseert externe payloads</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Connectoren:</strong> kant-en-klare integratie met Facebook, Instagram, YouTube en WordPress</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Voorbeeld: Facebook-reactie</h4>
            <CodeBlock code={facebookWebhookExample} lang="json" />
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div class="lg:order-2">
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Stap 2</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">AI modereert de content</h2>
            <p class="mt-4 text-surface-500">
              Onze eigen moderatie-AI leest elke reactie in context en past je regels toe. Bij lastige gevallen
              beoordelen andere AI-modellen de beslissing voordat die wordt toegepast. Je krijgt gestandaardiseerde resultaten terug met
               scores van 0,0 tot 1,0 over 10 contentcategorieën.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Gecontroleerde AI:</strong> minder fouten, minder reacties die onterecht verborgen worden</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Model-agnostisch:</strong> komt er een beter of goedkoper AI-model uit, dan sluiten we het snel aan</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Gestandaardiseerde output:</strong> hetzelfde formaat, welk model er ook achter zit</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 lg:order-1">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Gestandaardiseerde response</h4>
            <CodeBlock code={moderationResponseExample} lang="json" />
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Stap 3</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Moderatie afgestemd op je regels</h2>
            <p class="mt-4 text-surface-500">
              Leg je moderatieregels vast met drie eenvoudige hulpmiddelen: <strong>verboden woorden</strong> om direct te blokkeren, <strong>drempels per categorie</strong> voor automatische beslissingen, en <strong>je eigen regels</strong> in gewone taal voor AI-moderatie die de context begrijpt.
            </p>
            <div class="mt-6 space-y-3">
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Verboden woorden</strong> blokkeren content direct, nog vóór een AI-aanroep, dus ze kosten niets</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Drempels per categorie</strong> zetten automatische acties in gang zodra scores je grenzen overschrijden</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Je regels in gewone taal</strong> sturen de AI-beslissingen in context en bepalen de toon op je platform</p>
              </div>
            </div>
          </div>
          <div>
            <BrowserFrame
              src="/images/rules.png"
              video="om-rules"
              alt="Regelinstellingen van OpenModeration met verboden woorden, drempels per categorie en regels in gewone taal"
              caption="Stel je drempels één keer in en ze gelden overal."
              eager={false}
            />
            <details class="mt-4 rounded-xl border border-surface-200 bg-surface-50 p-4">
              <summary class="cursor-pointer text-sm font-semibold text-surface-700">Voor ontwikkelaars: configuratie via de API</summary>
              <div class="mt-3">
                <CodeBlock code={ruleConfigExample} lang="json" />
              </div>
            </details>
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div class="lg:order-2">
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Stap 4</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Grensgevallen: ons team neemt ze voor zijn rekening</h2>
            <p class="mt-4 text-surface-500">
              Twijfelgevallen, meldingen van gebruikers en betwiste beslissingen worden afgehandeld door ons team. Jij hoeft niets te doen,
              maar ziet elke beslissing in realtime en kunt op elk moment ingrijpen of overrulen. Elke stap blijft controleerbaar.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Goedkeuren of afwijzen met één klik.</strong> Elke correctie wordt vastgelegd met wie besliste en waarom.</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Keur zelf items goed of af in de moderatieconsole, wanneer je wilt</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Webhookmeldingen bij nieuwe beslissingen</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 lg:order-1">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Alles wordt vastgelegd</h4>
            <CodeBlock code={auditTrailExample} lang="json" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Action Engine -->
  <section id="action-engine" class="scroll-mt-24 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Action Engine</h2>
        <p class="mt-4 text-lg text-surface-500">Wanneer je regels worden geraakt, voert de Action Engine je beslissing automatisch uit op het platform zelf. Elke actie wordt vastgelegd.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-100 text-red-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Automatisch verbergen</h3>
          <p class="mt-1 text-sm text-surface-500">Afgewezen content wordt verborgen op Facebook en Instagram en afgewezen op YouTube. Je community ziet hem nooit.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Vasthouden voor beoordeling</h3>
          <p class="mt-1 text-sm text-surface-500">Twijfelachtige content wordt tegengehouden en door ons team beoordeeld. Er wordt niets gepubliceerd en niets raakt kwijt.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-green-100 text-green-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Publiceren en herstellen</h3>
          <p class="mt-1 text-sm text-surface-500">Nette content gaat gewoon online. Keurt een moderator een vastgehouden reactie goed, dan wordt die gepubliceerd.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Je eigen tools informeren</h3>
          <p class="mt-1 text-sm text-surface-500">Elke beslissing kan via een webhook je eigen tools bereiken, voor eigen workflows en integraties.</p>
        </div>
      </div>
      <div class="mx-auto mt-12 max-w-xl">
        <BrowserFrame
          src="/images/rules.png"
          video="om-rules"
          alt="Dashboard van OpenModeration: regelconfiguratie met drempels per categorie en automatische acties"
          caption="Stel je drempels één keer in en ze gelden op elk gekoppeld platform."
        />
      </div>
      <div class="mt-10 text-center">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Probeer het gratis
        </a>
        <p class="mt-3 text-sm text-surface-400">Geen creditcard nodig</p>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>