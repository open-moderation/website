---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'nl';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Hoe het werkt: wij modereren je reacties, jij ziet alles",
  "description": "Je koppelt je pagina’s, onze AI en ons team modereren met jouw regels en je ziet elke beslissing en de reden in realtime. Technische details verderop.",
  "crumb": "Hoe het werkt",
  "h1": "Jij koppelt je pagina’s. Wij modereren. Jij ziet alles.",
  "lead": "Geen moderatietool die je zelf moet bedienen: onze AI en ons team passen je regels dag en nacht toe, en jij houdt het volledige overzicht en het laatste woord.",
  "stepsTitle": "Drie stappen, en niets te bedienen",
  "steps": [
    {
      "title": "Jij koppelt je pagina’s",
      "text": "Website, Facebook, Instagram, YouTube of WordPress: ons team koppelt ze samen met jou en stelt je regels in op basis van je huisregels en use cases."
    },
    {
      "title": "Onze AI en ons team modereren met jouw regels",
      "text": "Onze AI leest elke reactie in haar context en handelt de duidelijke gevallen af. Lastige gevallen worden gecontroleerd door andere AI-modellen; twijfelgevallen, meldingen en bezwaren behandelt ons team."
    },
    {
      "title": "Je ziet alles in realtime",
      "text": "Elke beslissing komt met een schriftelijke reden. Je volgt alles in de console en kunt ingrijpen of corrigeren wanneer je wilt."
    }
  ],
  "stepsNote": "Je team hoeft niets te doen, tenzij het dat wil. De geschiedenis van elke beslissing blijft beschikbaar voor je DSA-verplichtingen.",
  "outcomesTitle": "Wat er met elke reactie gebeurt",
  "outcomesLead": "Beslissingen worden direct op je website en pagina’s toegepast, en elke beslissing wordt met haar reden vastgelegd.",
  "outcomes": [
    {
      "label": "Gepubliceerd",
      "title": "Gezonde reacties gaan online",
      "text": "Constructieve reacties, ook kritische, worden gewoon gepubliceerd. Het gesprek gaat door."
    },
    {
      "label": "Verborgen",
      "title": "Misbruik bereikt je lezers niet",
      "text": "Beledigingen, bedreigingen en spam worden verborgen op Facebook en Instagram en geweigerd op YouTube en je website, met de reden op schrift."
    },
    {
      "label": "Apart gezet",
      "title": "Twijfelgevallen gaan naar ons team",
      "text": "Als de AI twijfelt, wordt de reactie apart gezet en beslist ons team volgens jouw regels. Er wordt niets per ongeluk gepubliceerd en niets gaat verloren."
    },
    {
      "label": "Gemeld",
      "title": "Je tools blijven op de hoogte",
      "text": "Als je wilt, wordt elke beslissing naar je eigen tools gestuurd: je teams zijn op de hoogte zonder hun gewoontes te veranderen."
    }
  ],
  "testTitle": "Bekijk het eerst op je eigen reacties",
  "testText": "We testen OpenModeration op je echte reacties, stil en naast je huidige leverancier als je die hebt. Je vergelijkt beslissing per beslissing voordat je kiest.",
  "devEyebrow": "Voor developers",
  "devTitle": "Onder de motorkap: de pipeline in vier fasen",
  "devLead": "Achter de drie stappen doorloopt elke reactie vier technische fasen. Dit moet je technische team weten.",
  "pipeline": [
    {
      "title": "Verzamelen",
      "text": "Reacties komen binnen via de API, een webhook of een connector voor sociale media.",
      "tags": [
        "POST /v1/moderation",
        "Webhooks",
        "Facebook",
        "Instagram",
        "YouTube"
      ]
    },
    {
      "title": "AI-moderatie",
      "text": "Onze AI analyseert de reactie; andere modellen controleren lastige gevallen.",
      "tags": [
        "OpenModeration-AI",
        "Controle"
      ]
    },
    {
      "title": "Regels en acties",
      "text": "Je regels worden geëvalueerd, daarna lopen de acties automatisch.",
      "tags": [
        "Verbergen",
        "Apart zetten",
        "Publiceren",
        "Webhook"
      ]
    },
    {
      "title": "Menselijke beoordeling",
      "text": "Ons team behandelt twijfelgevallen; jij kunt altijd ingrijpen.",
      "tags": [
        "Ons team",
        "Correctie"
      ]
    }
  ],
  "stepLabel": "Fase",
  "details": [
    {
      "title": "Reacties komen overal vandaan",
      "text": "Stuur reacties via de REST-API, een generieke webhook of de native connectoren, die reacties automatisch ophalen.",
      "points": [
        "API: POST /v1/moderation, per stuk of in batches",
        "Webhooks: een generiek endpoint ontvangt en normaliseert externe data",
        "Connectoren: Facebook, Instagram, YouTube en WordPress"
      ],
      "codeTitle": "Voorbeeld: een Facebook-reactie"
    },
    {
      "title": "De AI modereert de reactie",
      "text": "Elke reactie wordt geanalyseerd door onze intern ontwikkelde moderatie-AI, ingesteld op jouw regels. Lastige gevallen worden gecontroleerd door andere AI-modellen. De resultaten komen terug in een standaardformaat, met scores van 0,0 tot 1,0 per categorie.",
      "points": [
        "Het antwoordformaat verandert nooit",
        "Komt er een beter model uit, dan koppelen we het: voor jou verandert er niets"
      ],
      "codeTitle": "Standaardantwoord"
    },
    {
      "title": "Je regels worden automatisch toegepast",
      "text": "Regels combineren verboden woorden voor een directe blokkade, drempels per categorie en regels in gewone taal die de AI in context toepast. Ons team stelt ze samen met je in; je developers kunnen ze ook via de API beheren.",
      "points": [
        "Verboden woorden blokkeren een reactie direct, vóór elke AI-aanroep",
        "Drempels per categorie starten acties automatisch",
        "Regels in gewone taal bepalen de toon van je kanalen"
      ],
      "codeTitle": "Configuratie via de API"
    },
    {
      "title": "Alles wordt vastgelegd",
      "text": "Elke beslissing, van de AI of van ons team, wordt vastgelegd met de reden, de auteur en de uitgevoerde acties. Webhooks kunnen je tools over elke beslissing informeren.",
      "points": [
        "Elke correctie wordt opgeslagen met auteur en motivering",
        "Volledige geschiedenis voor audits en DSA-rapportage"
      ],
      "codeTitle": "Audittrail van elke reactie"
    }
  ],
  "rulesAlt": "Regelinstellingen van OpenModeration: verboden woorden, drempels per categorie en regels in gewone taal",
  "rulesCaption": "Je regels, één keer ingesteld, toegepast op elk gekoppeld platform.",
  "code": {
    "webhook": "Facebook stuurt de reactie via een webhook",
    "rules": "Stel je moderatiedrempels in",
    "audit": "Volledige audittrail voor elke reactie"
  }
};

const stepIcons = [
  "M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1",
  "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
];
const outcomeStyles = [
  "bg-green-100 text-green-600",
  "bg-red-100 text-red-600",
  "bg-amber-100 text-amber-600",
  "bg-blue-100 text-blue-600"
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/hoe-het-werkt",
  "url": "https://www.openmoderation.com/nl/hoe-het-werkt",
  "name": "Hoe het werkt: wij modereren je reacties, jij ziet alles",
  "description": "Je koppelt je pagina’s, onze AI en ons team modereren met jouw regels en je ziet elke beslissing en de reden in realtime. Technische details verderop.",
  "inLanguage": "nl",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};

const facebookWebhookExample = `// Facebook stuurt de reactie via een webhook
{
  "source": "facebook",
  "content_id": "comment_123",
  "author_id": "user_456",
  "text": "Comment text here...",
  "metadata": {"post_url": "..."}
}`;

const moderationResponseExample = `{
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const ruleConfigExample = `// Stel je moderatiedrempels in
PUT /v1/settings

{
  "thresholds": {
    "hate":       { "accepted": 0.3, "rejected": 0.7 },
    "harassment": { "accepted": 0.3, "rejected": 0.7 },
    "sexual":     { "accepted": 0.2, "rejected": 0.8 },
    "violence":   { "accepted": 0.3, "rejected": 0.7 },
    "self-harm":  { "accepted": 0.2, "rejected": 0.8 },
    "spam":       { "accepted": 0.4, "rejected": 0.8 }
  },
  "actions": {
    "on_reject": ["hide", "flag_for_review"]
  }
}`;

const auditTrailExample = `// Volledige audittrail voor elke reactie
{
  "content_id": "...",
  "source": "webhook",
  "platform": "facebook",
  "status": "actioned",
  "moderation": {
    "flagged": true,
    "results": [...]
  },
  "actions": [{
    "rule": "Hide hate speech",
    "type": "hide",
    "status": "executed"
  }]
}`;
const codes = [facebookWebhookExample, moderationResponseExample, ruleConfigExample, auditTrailExample];
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- The promise in three steps -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mx-auto max-w-2xl text-center text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.stepsTitle}</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {c.steps.map((s, i) => (
          <li class="relative rounded-2xl border border-surface-200 bg-surface-50 p-8">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stepIcons[i]}/></svg>
            </div>
            <p class="text-sm font-semibold text-brand-600">{i + 1}</p>
            <h3 class="mt-1 text-xl font-semibold text-surface-900">{s.title}</h3>
            <p class="mt-3 text-surface-500">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mx-auto mt-10 max-w-2xl text-center text-surface-600">{c.stepsNote}</p>
    </div>
  </section>

  <!-- What happens to each comment -->
  <section id="action-engine" class="scroll-mt-24 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.outcomesTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.outcomesLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {c.outcomes.map((o, i) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <span class={`mb-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold ${outcomeStyles[i]}`}>{o.label}</span>
            <h3 class="font-semibold text-surface-900">{o.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{o.text}</p>
          </div>
        ))}
      </div>
      <div class="mx-auto mt-12 max-w-2xl rounded-2xl border border-brand-200 bg-white p-8 text-center">
        <h3 class="text-xl font-semibold text-surface-900">{c.testTitle}</h3>
        <p class="mt-2 text-surface-500">{c.testText}</p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section id="developers" class="scroll-mt-24 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{c.devEyebrow}</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-surface-900">{c.devTitle}</h2>
        <p class="mt-4 text-surface-500">{c.devLead}</p>
      </div>
      <div class="mb-16 grid grid-cols-2 gap-4 rounded-2xl border border-surface-200 bg-surface-50 p-6 lg:grid-cols-4">
        {c.pipeline.map((p, i) => (
          <div class="rounded-xl border border-surface-200 bg-white p-5 text-center">
            <p class="font-semibold text-surface-900">{i + 1}. {p.title}</p>
            <p class="mt-2 text-sm text-surface-500">{p.text}</p>
            <div class="mt-3 flex flex-wrap justify-center gap-2">
              {p.tags.map((tag) => <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">{tag}</span>)}
            </div>
          </div>
        ))}
      </div>
      <div class="space-y-16">
        {c.details.map((d, i) => (
          <div class="grid items-center gap-8 lg:grid-cols-2">
            <div class={i % 2 ? 'lg:order-2' : ''}>
              <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">{c.stepLabel} {i + 1}</span>
              <h3 class="text-2xl font-bold text-surface-900">{d.title}</h3>
              <p class="mt-4 text-surface-500">{d.text}</p>
              <ul class="mt-6 space-y-2 text-sm text-surface-600">
                {d.points.map((pt) => (
                  <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{pt}</span></li>
                ))}
              </ul>
            </div>
            <div class={i % 2 ? 'lg:order-1' : ''}>
              {i === 2 && (
                <div class="mb-4">
                  <BrowserFrame src="/images/rules.png" video="om-rules" alt={c.rulesAlt} caption={c.rulesCaption} eager={false} />
                </div>
              )}
              <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
                <p class="mb-3 text-sm font-semibold text-surface-900">{d.codeTitle}</p>
                <CodeBlock code={codes[i]} lang="json" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
