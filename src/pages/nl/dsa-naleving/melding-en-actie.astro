---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="DSA artikel 16: het meldings- en actiemechanisme uitgelegd"
  description="DSA artikel 16 uitgelegd: wat een meldings- en actiemechanisme moet bieden, wat een geldige melding bevat en hoe je elke melding afhandelt en vastlegt."
  crumb="Melding en actie (art. 16)"
  parent={{ label: "DSA-naleving", href: localizePath('/dsa-compliance', locale) }}
  eyebrow="DSA, artikel 16"
  h1="Meldings- en actiemechanisme van de DSA: meldingen van gebruikers afhandelen"
  intro="Artikel 16 van de digitaledienstenverordening (Verordening (EU) 2022/2065) verplicht elke hostingdienst, ook een website die reacties host, om iedereen in staat te stellen illegale content te melden, die melding vervolgens zorgvuldig te behandelen en de melder te laten weten wat er is besloten."
  problem="Veel sites hebben een knop “melden” waar niets achter zit: geen wachtrij om te verwerken, geen ontvangstbevestiging, geen vastlegging van de beslissing. Bij een controle door een toezichthouder of bij een aangevochten beslissing kun je niet aantonen dat meldingen zijn behandeld."
  approach="In OpenModeration komt elke melding terecht in dezelfde console als de automatische moderatie. Ze wordt getoetst aan je regels, automatisch of door ons team beslist, en de beslissing wordt met de schriftelijke motivering in het auditlog vastgelegd."
  result="Voor elke melding kun je laten zien wanneer ze is ontvangen, wie of wat haar heeft behandeld, wat er is besloten en waarom. Dezelfde gegevens voeden ook je transparantieverslag."
  featuresTitle="Wat artikel 16 vereist"
  featuresIntro="De hoofdpunten van de verplichting, en hoe OpenModeration je helpt eraan te voldoen. Deze samenvatting is geen juridisch advies."
  features={[
    { title: "Een gemakkelijk toegankelijk elektronisch mechanisme", text: "Iedereen moet content die hij of zij illegaal acht eenvoudig kunnen melden, vanaf je website of app." },
    { title: "Een voldoende nauwkeurige melding", text: "De melding moet de content aanwijzen (de exacte URL), uitleggen waarom die vermoedelijk illegaal is en in principe de naam en het e-mailadres van de melder bevatten, plus een verklaring te goeder trouw." },
    { title: "Tijdige, zorgvuldige, niet-willekeurige en objectieve behandeling", text: "Meldingen moeten tijdig worden behandeld. Worden daarbij geautomatiseerde middelen gebruikt, dan moet de melder dat te horen krijgen." },
    { title: "Ontvangstbevestiging en meegedeelde beslissing", text: "De melder krijgt een ontvangstbevestiging en daarna de genomen beslissing en de beschikbare beroepsmogelijkheden. De auteur van de content krijgt een motivering (artikel 17)." },
  ]}
  why={[
    { title: "Eén wachtrij", text: "Meldingen van gebruikers en automatische moderatie worden op dezelfde plek behandeld, met dezelfde regels." },
    { title: "Alles wordt vastgelegd", text: "Ontvangst, beslissing, reden en wie de melding heeft behandeld, worden in het auditlog vastgelegd." },
    { title: "Persoonlijke begeleiding", text: "We helpen je je meldknop aan OpenModeration te koppelen en je moderatiebeleid te schrijven." },
  ]}
  faq={[
    { question: "Geldt artikel 16 voor een nieuwswebsite?", answer: "Ja, zodra de site content host die gebruikers plaatsen, zoals reacties. De site is dan een hostingdienst in de zin van de DSA." },
    { question: "Moeten we op elke melding reageren?", answer: "Ja. De DSA vereist een ontvangstbevestiging als de melder contactgegevens heeft verstrekt, en daarna informatie over de genomen beslissing en de mogelijke beroepsmogelijkheden." },
    { question: "Mogen meldingen automatisch worden behandeld?", answer: "Ja, mits de melder dat te horen krijgt en de beslissing objectief en gemotiveerd blijft. In OpenModeration worden de twijfelgevallen altijd door ons team beoordeeld, en jij kunt op elk moment ingrijpen." },
    { question: "Hoe verhoudt dit zich tot de motivering?", answer: "Leidt een melding ertoe dat content wordt verwijderd of verborgen, dan verplicht artikel 17 je om de redenen aan de auteur uit te leggen. OpenModeration schrijft die motivering bij elke beslissing." },
  ]}
  related={[
    { eyebrow: "DSA", title: "Motivering (artikel 17)", text: "Wat erin moet staan, met een voorbeeld.", href: localizePath('/dsa-compliance/statement-of-reasons', locale) },
    { eyebrow: "DSA", title: "DSA-naleving", text: "Een overzicht van de verplichtingen en wat OpenModeration afdekt.", href: localizePath('/dsa-compliance', locale) },
    { eyebrow: "Gids", title: "De DSA voor het mkb", text: "Een praktische gids voor kleine en middelgrote platforms.", href: localizePath('/blog/dsa-compliance-sme-guide', locale) },
  ]}
  ctaTitle="Meldingen behandeld en vastgelegd, zonder gedoe."
  ctaSubtitle="Plan een gesprek: we bekijken je huidige opzet en wat er nog ontbreekt om te voldoen."
/>
