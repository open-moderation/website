---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Motivering (DSA artikel 17): wie moet er een geven en wat moet erin staan",
  "description": "Wat artikel 17 van de digitaledienstenverordening (DSA) vereist bij elke verwijdering van content: wie een motivering moet geven, wanneer, met welke informatie, en een voorbeeld.",
  "inLanguage": "nl",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/nl/dsa-naleving/motivering" }
};

const contents = [
  { letter: "a", title: "De genomen maatregel", text: "Verwijdering, het onmogelijk maken van toegang, lagere rangschikking of beperking van de zichtbaarheid, opschorting van geldelijke betalingen of een andere maatregel, en waar van toepassing de territoriale reikwijdte en de duur ervan." },
  { letter: "b", title: "De feiten en omstandigheden", text: "Waarop de beslissing berust, waaronder of ze volgt op een melding (artikel 16) of op een vrijwillig onderzoek op eigen initiatief. De identiteit van de melder wordt alleen vermeld als dat strikt noodzakelijk is." },
  { letter: "c", title: "Het gebruik van geautomatiseerde middelen", text: "Waar van toepassing, het feit dat de beslissing met geautomatiseerde middelen is genomen, of betrekking heeft op content die met zulke middelen is opgespoord of geïdentificeerd." },
  { letter: "d", title: "De rechtsgrond", text: "Als de content als illegaal wordt beschouwd: de rechtsgrond waarop wordt gesteund en uitleg waarom de content op die grond als illegaal wordt beschouwd." },
  { letter: "e", title: "De bepaling uit de algemene voorwaarden", text: "Als de content als onverenigbaar met je algemene voorwaarden wordt beschouwd: de contractuele grond waarop wordt gesteund en uitleg waarom de content daarmee onverenigbaar is." },
  { letter: "f", title: "De beroepsmogelijkheden", text: "Duidelijke en gebruiksvriendelijke informatie over de beschikbare beroepsmogelijkheden: interne klachtenafhandeling, buitengerechtelijke geschillenbeslechting, beroep in rechte." },
];

const faqItems = [
  {
    question: "Wat is een motivering onder de DSA?",
    answer: "Het is de uitleg die je volgens artikel 17 van Verordening (EU) 2022/2065, de digitaledienstenverordening (DSA), moet geven aan een gebruiker van wie de content wordt verwijderd, ontoegankelijk wordt gemaakt, lager wordt gerangschikt of in zichtbaarheid wordt beperkt, en ook wanneer een account, de dienst of geldelijke betalingen worden opgeschort.",
  },
  {
    question: "Moet een nieuwssite die haar reacties modereert hieraan voldoen?",
    answer: "Ja. Zodra de site reacties van haar lezers opslaat, treedt ze voor die content op als aanbieder van hostingdiensten. Artikel 17 geldt voor alle aanbieders van hostingdiensten, ook voor kleine ondernemingen.",
  },
  {
    question: "Heb ik voor elke verwijderde reactie een motivering nodig?",
    answer: "Ja, voor elke beperking die wordt opgelegd omdat de content illegaal is of onverenigbaar met je algemene voorwaarden, mits je de elektronische contactgegevens van de auteur kent. De verplichting geldt niet voor misleidende commerciële content in grote volumes, en ook niet voor bevelen van autoriteiten op grond van artikel 9.",
  },
  {
    question: "Moeten motiveringen naar de Europese Commissie worden gestuurd?",
    answer: "Aanbieders van onlineplatforms moeten hun beslissingen en motiveringen zonder onnodige vertraging aan de Commissie voorleggen, voor opname in een openbaar toegankelijke databank, zonder persoonsgegevens (artikel 24, lid 5). Micro- en kleine ondernemingen zijn vrijgesteld op grond van artikel 19, tenzij ze zijn aangewezen als zeer groot onlineplatform.",
  },
  {
    question: "Welke sancties staan er op niet-naleving?",
    answer: "De DSA laat de sancties over aan de lidstaten, maar beperkt boetes voor het niet nakomen van een verplichting tot maximaal 6% van de wereldwijde jaaromzet van de aanbieder (artikel 52).",
  },
];
---

<BaseLayout title="Motivering onder de DSA (artikel 17): regels en voorbeeld" description="Wat artikel 17 van de DSA vereist bij elke verwijderde reactie: wie moet voldoen, wanneer je de auteur informeert, de zes onderdelen en een voorbeeld." ogType="article" jsonLd={articleJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "DSA-naleving", href: localizePath('/dsa-compliance', locale) }, { label: "Motivering" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">20 oktober 2026</time>
        <span>&middot;</span>
        <span>7 min leestijd</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">De motivering onder de DSA: wat artikel 17 vereist bij elke verwijdering van content</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        Sinds de digitaledienstenverordening (DSA) van toepassing is, is een reactie verwijderen niet meer genoeg:
        je moet de auteur vertellen waarom. Artikel 17 noemt deze uitleg een "motivering" en legt de minimale
        inhoud vast. Hier lees je wie het betreft, wanneer het geldt, wat de motivering moet bevatten en hoe ze eruit kan zien.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Wie moet een motivering geven?</h2>
      <p>
        De verplichting rust op <strong>aanbieders van hostingdiensten</strong>, dat wil zeggen elke dienst die
        door gebruikers verstrekte informatie opslaat: sociale netwerken, forums, marktplaatsen, maar ook nieuwssites of blogs
        die reacties van lezers hosten. Anders dan bij sommige andere DSA-verplichtingen bevat artikel 17 geen vrijstelling voor micro-
        en kleine ondernemingen.
      </p>

      <h2 class="text-xl font-bold text-surface-900">In welke gevallen?</h2>
      <p>
        Een motivering is verschuldigd aan elke gebruiker die wordt getroffen door een beperking die is opgelegd omdat zijn content illegaal is
        of onverenigbaar met je algemene voorwaarden. De tekst noemt vier soorten beperkingen:
      </p>
      <ul>
        <li>elke beperking van de zichtbaarheid van content: verwijdering, het onmogelijk maken van toegang of lagere rangschikking;</li>
        <li>opschorting, beëindiging of andere beperking van geldelijke betalingen;</li>
        <li>gehele of gedeeltelijke opschorting of beëindiging van de dienst;</li>
        <li>opschorting of beëindiging van het account van de gebruiker.</li>
      </ul>
      <p>
        De verplichting geldt als je de elektronische contactgegevens van de gebruiker kent, uiterlijk vanaf het moment
        dat de beperking wordt opgelegd. Ze geldt niet voor misleidende commerciële content in grote volumes, en ook niet voor
        bevelen van autoriteiten op grond van artikel 9.
      </p>

      <h2 class="text-xl font-bold text-surface-900">De zes vereiste onderdelen</h2>
      <p>Lid 3 van artikel 17 somt de informatie op die de motivering ten minste moet bevatten:</p>
    </div>

    <div class="mt-6 space-y-3">
      {contents.map((c) => (
        <div class="flex items-start gap-4 rounded-lg border border-surface-200 bg-surface-50 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-mono text-sm font-semibold text-brand-700">{c.letter}</span>
          <div>
            <p class="text-sm font-medium text-surface-900">{c.title}</p>
            <p class="mt-1 text-sm text-surface-500">{c.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <p>
        Deze informatie moet "duidelijk en gemakkelijk te begrijpen" zijn, zo nauwkeurig en specifiek als redelijkerwijs mogelijk, en
        de gebruiker in staat stellen de beroepsmogelijkheden daadwerkelijk te benutten (lid 4).
      </p>

      <h2 class="text-xl font-bold text-surface-900">En onlineplatforms?</h2>
      <p>
        Aanbieders van onlineplatforms hebben een extra verplichting: hun beslissingen en motiveringen
        zonder onnodige vertraging aan de Europese Commissie voorleggen, voor opname in een openbaar toegankelijke databank. Deze inzendingen
        mogen geen persoonsgegevens bevatten (artikel 24, lid 5). Micro- en kleine ondernemingen zijn
        vrijgesteld op grond van artikel 19, tenzij ze zijn aangewezen als zeer groot onlineplatform.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Voorbeeld van een motivering voor een verwijderde reactie</h2>
      <p>Fictief voorbeeld, aan te passen aan je dienst en je algemene voorwaarden:</p>
    </div>

    <div class="mt-6 rounded-xl border border-surface-200 bg-white p-6 text-sm leading-relaxed text-surface-700 shadow-sm">
      <p>Hallo,</p>
      <p class="mt-3"><strong>Maatregel:</strong> je reactie van 14 oktober 2026 onder het artikel "…" is verwijderd. Je account blijft ongemoeid.</p>
      <p class="mt-3"><strong>Reden:</strong> de reactie bevat een belediging gericht aan een andere lezer, wat in strijd is met paragraaf 4 van onze communityrichtlijnen ("Respect voor andere deelnemers").</p>
      <p class="mt-3"><strong>Hoe de beslissing is genomen:</strong> de reactie is opgespoord door een geautomatiseerde analysetool, waarna de beslissing door een moderator is bevestigd.</p>
      <p class="mt-3"><strong>Je beroepsmogelijkheden:</strong> vind je deze beslissing onterecht, dan kun je haar binnen zes maanden aanvechten door op dit bericht te antwoorden. Je kunt je ook wenden tot een gecertificeerde instantie voor buitengerechtelijke geschillenbeslechting of naar de rechter stappen.</p>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Hoe OpenModeration je helpt je motiveringen op te stellen</h2>
      <ul>
        <li><strong>Een schriftelijke reden bij elke beslissing.</strong> Elke afgewezen reactie krijgt een schriftelijke uitleg, in de taal van je keuze, die als basis dient voor de grond (punt e of d).</li>
        <li><strong>De rol van automatisering, vastgelegd.</strong> Het activiteitenlog laat zien of de beslissing van de AI of van een moderator kwam, en van welke (punten b en c).</li>
        <li><strong>Gegevens klaar om te versturen.</strong> De API en webhooks geven voor elk item het oordeel, de categorie en de reden terug: die kun je opnemen in het bericht aan de auteur.</li>
        <li><strong>Een volledige geschiedenis.</strong> Elke beslissing, automatisch of menselijk, blijft in het audittraject staan voor je rapportages en audits.</li>
      </ul>
      <p>
        De informatie over beroepsmogelijkheden en de precieze rechtsgrond blijven jouw verantwoordelijkheid: die hangen af van je
        dienst, je algemene voorwaarden en het toepasselijke recht.
      </p>
      <p class="text-sm text-surface-400">
        Bron: <a href="https://eur-lex.europa.eu/legal-content/NL/TXT/?uri=CELEX:32022R2065" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Verordening (EU) 2022/2065 van 19 oktober 2022 betreffende een eengemaakte markt voor digitale diensten</a>, PB L 277 van 27 oktober 2022, artikelen 17, 19, 24 en 52. Deze pagina is uitsluitend informatief en vormt geen juridisch advies.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="Veelgestelde vragen" items={faqItems} />
    </div>
  </article>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Verder lezen</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/content-moderation-policy', locale)} class="font-medium text-brand-600 hover:text-brand-500">Moderatiebeleid: gids en voorbeeld &rarr;</a></li>
        <li><a href={localizePath('/dsa-compliance', locale)} class="font-medium text-brand-600 hover:text-brand-500">DSA-naleving met OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/product/transparency', locale)} class="font-medium text-brand-600 hover:text-brand-500">Elke beslissing schriftelijk uitgelegd &rarr;</a></li>
        <li><a href={localizePath('/use-cases/news-publishers', locale)} class="font-medium text-brand-600 hover:text-brand-500">Moderatie van reacties voor nieuwsuitgevers &rarr;</a></li>
        <li><a href={localizePath('/blog/dsa-compliance-sme-guide', locale)} class="font-medium text-brand-600 hover:text-brand-500">De DSA voor het mkb: een praktische gids &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Een motivering bij elke verwijderde reactie." subtitle="OpenModeration schrijft de reden bij elke beslissing en houdt bij wie wat heeft besloten. Gratis om te beginnen." />
</BaseLayout>
