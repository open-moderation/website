---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Platform voor moderatie van YouTube-reacties | OpenModeration",
  "description": "Modereer YouTube-reacties op grote schaal met AI. Elke reactie wordt automatisch gepubliceerd, vastgehouden voor beoordeling of afgewezen, volgens je regels.",
  "url": "https://www.openmoderation.com/nl/integraties/youtube-moderatie",
  "inLanguage": "nl"
};

const faqItems = [
  {
    question: "Hoe werkt de moderatie van YouTube-reacties?",
    answer: "Koppel je YouTube-kanaal via de YouTube Data API. Reacties worden binnengehaald en door de AI geanalyseerd. Op basis van je regels wordt elke reactie gepubliceerd, vastgehouden voor beoordeling of afgewezen."
  },
  {
    question: "Is het eenvoudig op te zetten?",
    answer: "Ja. Alles wordt ingesteld in het dashboard. Koppel je YouTube-kanaal, stel je regels in met schakelaars en gewone taal, en de moderatie start meteen op je video's."
  },
  {
    question: "Wat kan de YouTube-moderatie detecteren?",
    answer: "Haatzaaiende taal, intimidatie, spam, NSFW-content, persoonsgegevens, oplichting, phishing, grof taalgebruik, zelfbeschadiging, sentiment, gevoelige onderwerpen en risicovolle URL's. Meer dan 20 modellen in meer dan 120 talen."
  },
  {
    question: "Heb ik technische kennis nodig om het te gebruiken?",
    answer: "Nee. OpenModeration is gemaakt voor creators en communitymanagers. Je schrijft regels in gewone taal in het dashboard, zonder enige code."
  },
  {
    question: "Kan ik gemarkeerde reacties beoordelen voordat ze worden verwijderd?",
    answer: "Ja. Grensgevallen worden vastgehouden en door ons team beoordeeld. Jij ziet elke beslissing in realtime en kunt zelf goedkeuren of afwijzen. Elke actie wordt vastgelegd."
  },
];
---

<BaseLayout title="YouTube-reacties modereren met AI | OpenModeration" description="Modereer YouTube-reacties met AI. Wijs giftige reacties af en houd twijfelgevallen vast, in 120+ talen. Moderatie voor creators en merken, zonder code." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Integraties", href: localizePath('/connectors', locale) }, { label: "YouTube-moderatie" }]} />
  <section class="bg-gradient-to-b from-red-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 text-red-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderatie van YouTube-reacties</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Modereer YouTube-reacties op grote schaal met AI. Instellen vraagt geen code en duurt een paar minuten.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Probeer het gratis</a>
        <a href={localizePath('/how-it-works', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Hoe het werkt</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">In 3 stappen aan de slag</h2>
        <p class="mt-4 text-lg text-surface-500">Binnen enkele minuten ben je aan de slag, zonder ontwikkelwerk.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Maak je account aan</h3>
          <p class="mt-2 text-sm text-surface-500">Meld je gratis aan. Geen creditcard nodig. Je gegevens worden gehost in de EU.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Koppel YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Koppel je YouTube-kanaal met je eigen inloggegevens voor de Data API. De connector haalt reacties automatisch binnen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Stel je regels in</h3>
          <p class="mt-2 text-sm text-surface-500">Schrijf je regels in gewone taal. De AI wijst giftige reacties af en houdt twijfelgevallen vast voor beoordeling.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Wat de AI in je reacties detecteert</h2>
        <p class="mt-4 text-lg text-surface-500">Meer dan 20 kant-en-klare modellen, getraind op miljarden contentlabels.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxiciteit</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Haatzaaiende taal</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Intimidatie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Oplichting en phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Persoonsgegevens</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Zelfbeschadiging</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Grof taalgebruik</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Gevoelige onderwerpen</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Risicovolle URL's</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Waarom YouTube-moderatie eenvoudig is met OpenModeration</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Geen code nodig</h3>
          <p class="mt-2 text-sm text-surface-500">Alles wordt ingesteld vanuit het dashboard. Je hoeft niet tegen de API te bouwen of om tijd van ontwikkelaars te vragen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Acties rechtstreeks in YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Publiceer reacties, houd ze vast voor beoordeling of wijs ze af, rechtstreeks via de YouTube Data API. Het werkt zoals YouTube Studio, maar dan automatisch.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Aankunnen op elke schaal</h3>
          <p class="mt-2 text-sm text-surface-500">OpenModeration houdt je kanaal bij, of het nu 100 of 100.000 reacties per dag krijgt.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Meer dan 120 talen</h3>
          <p class="mt-2 text-sm text-surface-500">Je publiek reageert in veel talen, en één platform detecteert toxiciteit in al die talen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Eigen regels in gewone taal</h3>
          <p class="mt-2 text-sm text-surface-500">Schrijf je moderatiebeleid in gewone taal. De AI leest zowel de bedoeling van een reactie als de woorden.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Controleerbaar en transparant</h3>
          <p class="mt-2 text-sm text-surface-500">Elke moderatiebeslissing wordt met de context vastgelegd. Je gegevens worden gehost in de Europese Unie en zijn op elk moment te exporteren.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Veelgestelde vragen over YouTube-moderatie" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
