---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Automatische moderatie op Instagram: giftige reacties verbergen (zonder code)",
  "description": "Modereer Instagram-reacties automatisch met AI. Regels zonder code, giftige content automatisch verborgen, meer dan 120 talen, DSA-audittraject. Gratis starten, binnen minuten live.",
  "url": "https://www.openmoderation.com/nl/integraties/instagram-moderatie",
  "inLanguage": "nl"
};

const faqItems = [
  {
    question: "Hoe werkt de moderatie van Instagram-reacties?",
    answer: "Koppel je Instagram-account aan OpenModeration. Reacties en antwoorden worden automatisch door de AI geanalyseerd. Giftige reacties worden volgens je regels verborgen of verwijderd, zonder handwerk."
  },
  {
    question: "Is het ingewikkeld om op te zetten?",
    answer: "Nee. Je stelt alles in vanuit het dashboard, zonder code te schrijven. Koppel je Instagram-account, kies je moderatieregels en het platform doet de rest. Het kost een paar minuten."
  },
  {
    question: "Wat detecteert de Instagram-moderatie?",
    answer: "Het platform detecteert haatzaaiende taal, intimidatie, spam, NSFW-content, persoonsgegevens, oplichting, phishing, grof taalgebruik, zelfbeschadiging en meer. Meer dan 20 kant-en-klare detectiemodellen dekken meer dan 120 talen."
  },
  {
    question: "Moet ik kunnen programmeren om OpenModeration voor Instagram te gebruiken?",
    answer: "Nee. Het platform is gemaakt voor niet-technische gebruikers. Regels stel je in met gewone taal en schakelaars. Het dashboard is eenvoudig te gebruiken en vraagt geen ontwikkelwerk."
  },
  {
    question: "Is dit beter dan de ingebouwde moderatie van Instagram?",
    answer: "Ja. De ingebouwde filters van Instagram beperken zich tot het blokkeren van trefwoorden. OpenModeration gebruikt AI die context begrijpt, inclusief nuance, sarcasme en het verloop van het gesprek. Je krijgt er ook eigen regels, menselijke beoordeling van twijfelgevallen door ons team en volledige audittrajecten bij."
  },
  {
    question: "Wat kost automatische moderatie op Instagram?",
    answer: "Het gratis abonnement dekt tot 1.000 verzoeken per maand. Het Pro-abonnement begint bij € 99 per maand voor 10.000 verzoeken, AI-modellen inbegrepen. Er zijn geen kosten per gebruiker en je kunt altijd opzeggen."
  },
  {
    question: "Wordt elke beslissing vastgelegd voor audits?",
    answer: "Ja. Bij elke automatisch verborgen of gemarkeerde reactie blijven de regel, de AI-scores en de schriftelijke reden bewaard. Exporteer het volledige audittraject met één klik voor brand-safety- of DSA-controles."
  },
];
---

<BaseLayout title="Instagram-reacties automatisch modereren, zonder code" description="Modereer Instagram-reacties automatisch met AI. Regels zonder code, giftige content automatisch verborgen, 120+ talen. Gratis starten, binnen minuten live." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Integraties", href: localizePath('/connectors', locale) }, { label: "Instagram-moderatie" }]} />
  <section class="bg-gradient-to-b from-pink-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-pink-100 text-pink-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Contentmoderatie voor Instagram</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Houd giftige reacties van je Instagram-profiel. AI-moderatie stel je in een paar minuten in, zonder code.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Probeer het gratis</a>
        <a href={localizePath('/how-it-works', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Hoe het werkt</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderatie die eenvoudig werkt</h2>
        <p class="mt-4 text-lg text-surface-500">Drie stappen naar een veiliger Instagram-profiel.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Meld je aan</h3>
          <p class="mt-2 text-sm text-surface-500">Maak een gratis OpenModeration-account aan. Je gegevens worden gehost in de EU.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Koppel Instagram</h3>
          <p class="mt-2 text-sm text-surface-500">Koppel je Instagram-account in een paar klikken aan het platform, met je eigen inloggegevens.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Binnen minuten live</h3>
          <p class="mt-2 text-sm text-surface-500">Stel je moderatieregels in en laat de AI je profiel beschermen. Verberg, verwijder of markeer content automatisch.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Detectie die verder gaat dan trefwoorden</h2>
        <p class="mt-4 text-lg text-surface-500">De AI leest de context en pikt zo nuance, sarcasme en bedoeling op.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxiciteit</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Haatzaaiende taal</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Intimidatie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Oplichting en phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Persoonsgegevens</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Zelfbeschadiging</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Grof taalgebruik</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Gevoelige onderwerpen</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Risicovolle URL's</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Waarom dit de eenvoudigste moderatietool voor Instagram is</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">In minuten ingesteld, zonder code</h3>
          <p class="mt-2 text-sm text-surface-500">Je koppelt je Instagram-account vanuit het dashboard. Je hoeft de API niet te kennen of een ontwikkelaar in te schakelen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">AI die context begrijpt</h3>
          <p class="mt-2 text-sm text-surface-500">De AI volgt het gesprek. Net als een menselijke moderator beoordeelt hij dezelfde zin anders, afhankelijk van wat eraan voorafging.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Automatische handhaving</h3>
          <p class="mt-2 text-sm text-surface-500">Verberg of verwijder overtredende reacties automatisch. Je Instagram-profiel blijft schoon zonder dat jij hoeft in te grijpen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Meer dan 120 talen</h3>
          <p class="mt-2 text-sm text-surface-500">Je publiek schrijft in veel talen, en één platform modereert ze allemaal even nauwkeurig.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Eigen regels in gewone taal</h3>
          <p class="mt-2 text-sm text-surface-500">Schrijf regels zoals je ze aan een mens zou uitleggen. Onze AI begrijpt je regels en past ze consequent toe.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Uitgelegd en privé</h3>
          <p class="mt-2 text-sm text-surface-500">Elke beslissing krijgt een schriftelijke reden en een volledig audittraject. Je gegevens worden gehost in de Europese Unie en zijn op elk moment te exporteren.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Veelgestelde vragen over Instagram-moderatie" />
    <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-violet-100 bg-violet-50 p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Gids</p>
      <a href={localizePath('/blog/instagram-comment-moderation', locale)} class="mt-1 block text-lg font-bold text-surface-900 hover:text-violet-700">Instagram-reacties modereren: de gids voor automatische moderatie &rarr;</a>
    </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
