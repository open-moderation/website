---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "WordPress-reacties modereren met AI: goedkeuren, vasthouden of spam",
  "description": "Modereer WordPress-reacties automatisch met AI. Koppel je site met een applicatiewachtwoord, zonder plug-in te ontwikkelen en zonder code. Keur reacties goed, houd ze vast of markeer ze als spam als ze je regels overtreden, met een DSA-audittraject inbegrepen.",
  "url": "https://www.openmoderation.com/nl/integraties/wordpress-moderatie",
  "inLanguage": "nl"
};

const faqItems = [
  {
    question: "Hoe werkt de moderatie van WordPress-reacties?",
    answer: "Koppel je WordPress-site met een applicatiewachtwoord. Reacties worden automatisch binnengehaald via de WordPress REST API en geanalyseerd door onze AI-engine. Op basis van je regels wordt elke reactie goedgekeurd, vastgehouden voor beoordeling of als spam gemarkeerd, zonder handmatige wachtrij."
  },
  {
    question: "Moet ik code schrijven om het op te zetten?",
    answer: "Nee. Maak een applicatiewachtwoord aan in je WordPress-beheer (Gebruikers → Profiel) en vul daarna de URL van je site, je gebruikersnaam en het wachtwoord in in het OpenModeration-dashboard. Je site wordt binnen enkele seconden geverifieerd en de moderatie start."
  },
  {
    question: "Welke soorten content op WordPress kunnen worden gemodereerd?",
    answer: "Blogberichten en reacties op je WordPress-site. Het platform detecteert haatzaaiende taal, intimidatie, spam, NSFW-content, persoonsgegevens, oplichting en meer, in meer dan 120 talen."
  },
  {
    question: "Wat gebeurt er met een overtredende reactie op mijn WordPress-site?",
    answer: "Op basis van je moderatieregels wordt de reactie rechtstreeks via de WordPress REST API goedgekeurd, vastgehouden voor moderatie of als spam gemarkeerd. Elke actie wordt vastgelegd met de regel, de AI-scores en een schriftelijke reden."
  },
  {
    question: "Welke rechten heeft mijn WordPress-gebruiker nodig?",
    answer: "Je WordPress-gebruiker moet reacties mogen modereren, dus de rol beheerder of redacteur hebben. De connector controleert dit wanneer je je site koppelt."
  },
  {
    question: "Wordt elke moderatiebeslissing vastgelegd voor DSA-audits?",
    answer: "Ja. Bij elke goedgekeurde, vastgehouden of als spam gemarkeerde reactie blijven de regel, de AI-scores en de schriftelijke reden bewaard in een volledig audittraject. Exporteer het met één klik voor je DSA-transparantieverslagen."
  },
];
---

<BaseLayout title="WordPress-reacties modereren met AI, zonder plug-in" description="Modereer WordPress-reacties met AI. Koppel je site met een applicatiewachtwoord, zonder code. Keur goed, houd vast of markeer als spam, met DSA-audittraject." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Integraties", href: localizePath('/connectors', locale) }, { label: "WordPress-moderatie" }]} />
  <section class="bg-gradient-to-b from-sky-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.026-.78-.07-1.11m-7.981.105c.647-.03 1.232-.105 1.232-.105.582-.075.514-.93-.067-.899 0 0-1.755.135-2.88.135-1.064 0-2.85-.15-2.85-.15-.585-.03-.661.855-.075.885 0 0 .54.061 1.125.09l1.68 4.605-2.37 7.08L5.354 6.9c.649-.03 1.234-.1 1.234-.1.585-.075.516-.93-.065-.896 0 0-1.746.138-2.874.138-.2 0-.438-.008-.69-.015C4.911 3.15 8.235 1.215 12 1.215c2.809 0 5.365 1.072 7.286 2.833-.046-.003-.091-.009-.141-.009-1.06 0-1.812.923-1.812 1.914 0 .89.513 1.643 1.06 2.531.411.72.89 1.643.89 2.977 0 .915-.354 1.994-.821 3.479l-1.075 3.585-3.9-11.61.001.014zM12 22.784c-1.059 0-2.081-.153-3.048-.437l3.237-9.406 3.315 9.087c.024.053.05.101.078.149-1.12.393-2.325.609-3.582.609M1.211 12c0-1.564.336-3.05.935-4.39L7.29 21.709C3.694 19.96 1.212 16.271 1.211 12M12 0C5.385 0 0 5.385 0 12s5.385 12 12 12 12-5.385 12-12S18.615 0 12 0"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderatie van WordPress-reacties</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bescherm je WordPress-site met moderatie op basis van AI. Je koppelt met een applicatiewachtwoord en bent binnen enkele minuten klaar, zonder code.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Probeer het gratis</a>
        <a href={localizePath('/how-it-works', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Hoe het werkt</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Eenvoudige moderatie in 3 stappen</h2>
        <p class="mt-4 text-lg text-surface-500">Je site is binnen enkele minuten beschermd, en je hebt geen technisch team nodig.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Maak je account aan</h3>
          <p class="mt-2 text-sm text-surface-500">Meld je gratis aan bij OpenModeration, zonder creditcard en zonder verplichtingen. Je gegevens worden gehost in de EU.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Koppel je WordPress-site</h3>
          <p class="mt-2 text-sm text-surface-500">Maak een applicatiewachtwoord aan in je WordPress-beheer en koppel daarna de URL van je site, je gebruikersnaam en het wachtwoord. Je site wordt automatisch geverifieerd. Je hebt de rol beheerder of redacteur nodig.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Stel je regels in</h3>
          <p class="mt-2 text-sm text-surface-500">Schrijf je moderatieregels in gewone taal. Onze AI past ze automatisch toe en keurt reacties goed, houdt ze vast of markeert ze als spam.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Wat je kunt detecteren</h2>
        <p class="mt-4 text-lg text-surface-500">Meer dan 20 kant-en-klare detectiemodellen, getraind op miljarden labels.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxiciteit</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Haatzaaiende taal</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Intimidatie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Oplichting en phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Persoonsgegevens</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Zelfbeschadiging</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Grof taalgebruik</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Gevoelige onderwerpen</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Risicovolle URL's</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Waarom WordPress-moderatie eenvoudig is met OpenModeration</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Geen code nodig</h3>
          <p class="mt-2 text-sm text-surface-500">Stel alles in vanuit het dashboard. Maak een applicatiewachtwoord aan, koppel je site en schrijf regels in gewone taal. De AI doet de rest.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Jouw inloggegevens, jouw regie</h3>
          <p class="mt-2 text-sm text-surface-500">Koppel met je eigen applicatiewachtwoord. Inloggegevens worden versleuteld, nooit als platte tekst opgeslagen, en je kunt de toegang op elk moment intrekken vanuit je WordPress-beheer.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Automatische handhaving op WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Elke reactie wordt rechtstreeks via de WordPress REST API goedgekeurd, vastgehouden voor beoordeling of als spam gemarkeerd, zodat je geen handmatige moderatiewachtrij nodig hebt.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Meer dan 120 talen</h3>
          <p class="mt-2 text-sm text-surface-500">Modereer reacties in elke taal die je lezers gebruiken. Lastige gevallen worden gecontroleerd door andere AI-modellen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Eigen regels in gewone taal</h3>
          <p class="mt-2 text-sm text-surface-500">Schrijf je moderatiebeleid zoals je het aan een collega zou uitleggen. Geen prompt engineering of regex nodig.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Uitgelegd en gehost in de EU</h3>
          <p class="mt-2 text-sm text-surface-500">Elke beslissing krijgt een schriftelijke reden. Je gegevens worden gehost in de Europese Unie en zijn op elk moment te exporteren.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Veelgestelde vragen over WordPress-moderatie" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
