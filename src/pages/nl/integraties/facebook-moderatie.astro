---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Moderatie van Facebook-reacties: giftige reacties automatisch verbergen, zonder code",
  "description": "Verberg giftige reacties op je Facebook-pagina automatisch met AI. Regels zonder code, meertalig, direct verbergen of verwijderen via de Graph API. Gratis starten, DSA-audittraject inbegrepen.",
  "url": "https://www.openmoderation.com/nl/integraties/facebook-moderatie",
  "inLanguage": "nl"
};

const faqItems = [
  {
    question: "Hoe werkt de moderatie van Facebook-reacties?",
    answer: "Koppel je Facebook-pagina via de Graph API. Reacties worden verzameld en door de AI geanalyseerd zodra ze binnenkomen. Volgens je regels worden giftige reacties verborgen of verwijderd, zonder dat iemand ze hoeft te beoordelen."
  },
  {
    question: "Moet ik code schrijven om het op te zetten?",
    answer: "Nee. Alles wordt ingesteld in het dashboard. Koppel je Facebook-pagina, stel je moderatieregels in met gewone taal of schakelaars, en binnen enkele minuten start de moderatie."
  },
  {
    question: "Welke soorten content op Facebook kunnen worden gemodereerd?",
    answer: "Reacties, antwoorden en posts op je Facebook-pagina. Het platform detecteert haatzaaiende taal, intimidatie, spam, NSFW-content, persoonsgegevens, oplichting en meer. Elke reactie wordt in haar eigen taal geanalyseerd, ook in de talen van je publiek."
  },
  {
    question: "Wat kost de moderatie van Facebook-reacties?",
    answer: "De beheerde cloud heeft een gratis abonnement tot 1.000 geanalyseerde reacties per maand en een Pro-abonnement voor € 99 per maand, zonder verborgen kosten."
  },
  {
    question: "Hoe lang duurt het instellen?",
    answer: "Een paar minuten. Koppel je Facebook-pagina en schrijf je regels in gewone taal. De automatische moderatie gaat dezelfde dag live, zonder code of ontwikkelaar."
  },
  {
    question: "Wordt elke moderatiebeslissing vastgelegd voor DSA-audits?",
    answer: "Ja. Bij elke verborgen, verwijderde of gemarkeerde reactie blijven de regel, de AI-scores en de schriftelijke reden bewaard in een volledig audittraject. Exporteer het met één klik voor je DSA-transparantieverslagen."
  },
];
---

<BaseLayout title="Facebook-reacties modereren: giftige reacties verbergen" description="Verberg giftige Facebook-reacties automatisch. Regels zonder code, meertalig, verbergen of verwijderen via Graph API. Gratis, elke beslissing uitgelegd." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Integraties", href: localizePath('/connectors', locale) }, { label: "Facebook-moderatie" }]} />
  <section class="bg-gradient-to-b from-blue-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-blue-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderatie van Facebook-reacties</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Modereer de reacties op je Facebook-pagina met AI. Instellen duurt een paar minuten en vraagt geen code.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/nl/afspraak-maken" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Plan een gesprek</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-medium text-surface-700 transition hover:bg-surface-50">Probeer het gratis</a>
        <a href={localizePath('/how-it-works', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Hoe het werkt</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Eenvoudige moderatie in 3 stappen</h2>
        <p class="mt-4 text-lg text-surface-500">Binnen enkele minuten ben je aan de slag, zonder technisch team.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Maak je account aan</h3>
          <p class="mt-2 text-sm text-surface-500">Meld je gratis aan bij OpenModeration, zonder creditcard en zonder verplichtingen. Je gegevens worden gehost in de EU.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Koppel je Facebook-pagina</h3>
          <p class="mt-2 text-sm text-surface-500">Koppel je Facebook-pagina met je eigen inloggegevens. De connector haalt reacties en posts automatisch binnen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Stel je regels in</h3>
          <p class="mt-2 text-sm text-surface-500">We stellen je moderatieregels samen met je op. De AI past ze automatisch toe (verbergen, verwijderen of markeren) en ons team handelt de twijfelgevallen af.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Wat je kunt detecteren</h2>
        <p class="mt-4 text-lg text-surface-500">Meer dan 20 kant-en-klare detectiemodellen, getraind op miljarden labels.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toxiciteit</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Haatzaaiende taal</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Intimidatie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Oplichting en phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Persoonsgegevens</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Zelfbeschadiging</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Grof taalgebruik</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Gevoelige onderwerpen</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Risicovolle URL's</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Waarom Facebook-moderatie eenvoudig is met OpenModeration</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Geen code nodig</h3>
          <p class="mt-2 text-sm text-surface-500">Alles wordt ingesteld vanuit het dashboard. Koppel je pagina, schrijf regels in gewone taal en de AI past ze toe.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Jouw inloggegevens, jouw regie</h3>
          <p class="mt-2 text-sm text-surface-500">Gebruik je eigen toegangstoken voor je Facebook-pagina. We slaan inloggegevens nooit als platte tekst op en jij blijft volledig eigenaar.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Automatische handhaving op Facebook</h3>
          <p class="mt-2 text-sm text-surface-500">Verberg of verwijder overtredende reacties rechtstreeks via de Facebook Graph API. Geen handmatige moderatiewachtrij nodig.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Meertalig</h3>
          <p class="mt-2 text-sm text-surface-500">Elke reactie wordt in haar eigen taal geanalyseerd, ook in de talen van je community. Lastige gevallen worden gecontroleerd door andere AI-modellen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Eigen regels in gewone taal</h3>
          <p class="mt-2 text-sm text-surface-500">Schrijf je moderatiebeleid zoals je het aan een collega zou uitleggen. Geen prompt engineering of regex nodig.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Uitgelegd en gehost in de EU</h3>
          <p class="mt-2 text-sm text-surface-500">Elke beslissing krijgt een schriftelijke reden. Je gegevens worden gehost in de Europese Unie en zijn op elk moment te exporteren.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Veelgestelde vragen over Facebook-moderatie" />
    <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-violet-100 bg-violet-50 p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Gids</p>
      <a href={localizePath('/blog/hide-facebook-comments-automatically', locale)} class="mt-1 block text-lg font-bold text-surface-900 hover:text-violet-700">Facebook-reacties automatisch verbergen: zo doe je dat &rarr;</a>
    </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
