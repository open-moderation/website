---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'nl';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "FAQ reactiemoderatie: AI, ons team, DSA en prijs",
  "description": "Wie modereert, hoe de AI je regels volgt, testen op je eigen reacties, DSA, platforms, data en prijs: antwoorden voor media, merken en overheden.",
  "crumb": "Veelgestelde vragen",
  "h1": "Je vragen over reactiemoderatie, beantwoord",
  "intro": "De vragen die media, merken en overheidsinstellingen ons het vaakst stellen voordat ze kiezen. Staat de jouwe er niet bij? Plan een gesprek en vraag het ons.",
  "buyerTitle": "Voordat je kiest",
  "techTitle": "Voor technische teams",
  "techIntro": "Meer technische details voor je developers en IT-afdeling.",
  "ctaTitle": "Nog een vraag?",
  "ctaSubtitle": "Plan een gesprek: we beantwoorden je vragen en laten zien wat onze moderatie met je eigen reacties zou doen.",
  "buyer": [
    {
      "question": "Modereert de AI zelfstandig?",
      "answer": "Nee. Onze AI wordt ingesteld op jouw regels en beslist alleen zelf als ze zeker is. Lastige gevallen worden gecontroleerd door andere AI-modellen, twijfelgevallen gaan naar ons team, dat beslist volgens jouw regels en je op de hoogte houdt. Je hoeft niets te doen, tenzij je zelf wilt ingrijpen."
    },
    {
      "question": "Hoe kent de AI onze redactionele lijn?",
      "answer": "We vertrekken vanuit je huisregels en use cases: wat je accepteert, wat je weigert, de grensgevallen. Als je een beslissing corrigeert, passen we de regels samen met je aan. Het is geen lijst met verboden woorden: de AI leest elke reactie in haar context."
    },
    {
      "question": "Kunnen we testen voordat we tekenen?",
      "answer": "Ja. In de sandbox analyseert OpenModeration je echte reacties zonder iets te publiceren of te verbergen. Je ziet wat we zouden hebben geaccepteerd of geweigerd, met de reden, en vergelijkt het met je huidige moderatie. Er wordt niets voor je verborgen."
    },
    {
      "question": "Kunnen we testen zonder onze huidige leverancier te verlaten?",
      "answer": "Ja. De test draait stil naast je huidige moderatie, zonder je productie aan te raken. Je vergelijkt beslissing per beslissing en kiest daarna met kennis van zaken, wanneer het jou uitkomt."
    },
    {
      "question": "Wat zien we aan onze kant?",
      "answer": "Alles, in realtime: elke reactie, de genomen beslissing, de schriftelijke reden en de geschiedenis. Je kunt elke beslissing op elk moment terugdraaien in de console."
    },
    {
      "question": "Waarom is een reactie geweigerd?",
      "answer": "Elke beslissing heeft een schriftelijke reden (belediging, persoonlijke aanval, spam…), die je kunt doorgeven aan de schrijver. Dat is duidelijker voor je lezers en makkelijker te verantwoorden bij bezwaar."
    },
    {
      "question": "Helpt OpenModeration bij de DSA?",
      "answer": "Het is gebouwd voor de DSA: een schriftelijke reden voor elke beslissing, een traceerbare geschiedenis, opvolging van meldingen en bezwaren, en exporteerbare cijfers. Jij blijft de verantwoordelijke uitgever, en je hebt alles om elke beslissing te verantwoorden."
    },
    {
      "question": "Wat gebeurt er als de AI twijfelt?",
      "answer": "De reactie wordt apart gezet en ons team behandelt haar volgens jouw regels. Je krijgt een verslag van de behandelde gevallen en van de punten in je huisregels die verduidelijking verdienen."
    },
    {
      "question": "En ’s nachts, in het weekend of bij pieken?",
      "answer": "De AI modereert dag en nacht met dezelfde regels, ongeacht het volume, ook tijdens een wedstrijd of een verkiezingsavond. Twijfelachtige reacties worden apart gezet in plaats van gepubliceerd, tot ons team ze heeft behandeld."
    },
    {
      "question": "Op welke platforms werkt OpenModeration?",
      "answer": "Je website (via onze API of WordPress), Facebook, Instagram en YouTube, met kant-en-klare connectoren. TikTok, X, LinkedIn en andere netwerken voegen we op aanvraag snel toe. Ons team koppelt je pagina’s samen met jou."
    },
    {
      "question": "Welke talen worden gemodereerd?",
      "answer": "OpenModeration is meertalig: elke reactie wordt in haar eigen taal geanalyseerd, ook in de talen van je publiek. Vertel ons welke voor jou tellen, dan laten we je de resultaten zien op je eigen reacties."
    },
    {
      "question": "Waar worden onze gegevens gehost?",
      "answer": "In de Europese Unie, conform de AVG. Je reacties worden alleen gebruikt om je eigen kanalen te modereren."
    },
    {
      "question": "Moeten we ons technische team inschakelen?",
      "answer": "Nauwelijks. Voor sociale netwerken en WordPress koppel je gewoon je accounts. Voor een website of eigen tool stuurt een API ons je reacties en krijg je elke beslissing met reden terug. Ons team regelt de inrichting samen met jou."
    },
    {
      "question": "Wat kost het?",
      "answer": "De prijs hangt af van het aantal reacties dat gemodereerd moet worden. Met een gratis plan kun je het uitproberen; daarna bieden we een voorspelbaar pakket op maat van je volumes, na een test op je eigen reacties: zo beoordeel je de kwaliteit voordat we over budget praten."
    }
  ],
  "tech": [
    {
      "question": "Is er een API?",
      "answer": "Ja. Een REST-API ontvangt elke reactie en geeft de beslissing, de categorie en de schriftelijke reden terug. Webhooks informeren je tools over elke beslissing, en toegangssleutels beheer je in de console."
    },
    {
      "question": "Op welke AI draait OpenModeration?",
      "answer": "Op onze eigen moderatie-AI, intern ontwikkeld en in zeven jaar getraind op miljoenen berichten. Bij lastige gevallen controleren andere AI-modellen de beslissing voordat ze wordt toegepast. Komt er een beter model uit, dan koppelen we het, zonder wijziging aan jouw kant."
    },
    {
      "question": "Kunnen we eigen categorieën toevoegen?",
      "answer": "Ja. Naast de standaardcategorieën (haat, intimidatie, spam…) schrijf je je regels in gewone taal, dus elke categorie uit je eigen beleid kan worden toegevoegd. De AI past ze toe met oog voor de context."
    },
    {
      "question": "En afbeeldingen of video?",
      "answer": "De huidige versie richt zich op tekst. Moderatie van afbeeldingen en video staat op de roadmap en profiteert van multimodale AI-modellen naarmate die beter worden."
    },
    {
      "question": "Kan het op onze eigen servers draaien?",
      "answer": "Standaard wordt OpenModeration gehost in de Europese Unie en blijven je gegevens exporteerbaar. Een on-premise installatie is mogelijk op aanvraag: laten we het erover hebben."
    }
  ]
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/veelgestelde-vragen",
  "url": "https://www.openmoderation.com/nl/veelgestelde-vragen",
  "name": "FAQ reactiemoderatie: AI, ons team, DSA en prijs",
  "description": "Wie modereert, hoe de AI je regels volgt, testen op je eigen reacties, DSA, platforms, data en prijs: antwoorden voor media, merken en overheden.",
  "inLanguage": "nl",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.intro}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={c.buyer} title={c.buyerTitle} />
    </div>
  </section>
  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mx-auto mb-6 max-w-3xl text-center text-sm text-surface-500">{c.techIntro}</p>
      <FAQ items={c.tech} title={c.techTitle} disableJsonLd />
    </div>
  </section>

  <CTASection title={c.ctaTitle} subtitle={c.ctaSubtitle} />
</BaseLayout>
