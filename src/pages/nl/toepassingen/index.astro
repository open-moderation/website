---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import KpiBand from '../../../components/KpiBand.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const useCasesJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://www.openmoderation.com/nl/toepassingen",
  "url": "https://www.openmoderation.com/nl/toepassingen",
  "name": "Toepassingen van contentmoderatie | OpenModeration",
  "description": "Hoe platforms van elk type OpenModeration gebruiken: sociale platforms, AI-toepassingen, marktplaatsen, gaming en enterprise SaaS.",
  "inLanguage": "nl"
};

const kpis = [
  { value: "EU", label: "Ontwikkeld en gehost in de EU" },
  { value: "300 ms", prefix: "<", label: "Mediane latency (P50)" },
  { value: "10.000", label: "Items per batchverzoek" },
  { value: "100%", label: "Beslissingen schriftelijk uitgelegd" },
];

const useCases = [
  {
    title: "Nieuwsmedia",
    tagline: "Reacties onder artikelen, redacties",
    description: "Pas je redactionele regels toe op elke lezersreactie, leg elke verwijdering schriftelijk uit; twijfelgevallen handelt ons team af, en je redactie kan altijd ingrijpen.",
    href: localizePath("/use-cases/news-publishers", locale),
    iconPath: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
  },
  {
    title: "Sociale platforms",
    tagline: "Forums, community's, UGC",
    description: "Bescherm je community tegen haatzaaiende taal, spam en oplichting. De handhaving draait automatisch, grensgevallen handelt ons team af en jij ziet elke beslissing in realtime.",
    href: localizePath("/use-cases/social-platforms", locale),
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "AI-toepassingen",
    tagline: "Filtering van LLM-input en -output",
    description: "Filter prompts en modelantwoorden via één integratie. Onze moderatie-AI, gecontroleerd door andere AI-modellen, beschermt tegen injectie en schadelijke output.",
    href: localizePath("/use-cases/ai-applications", locale),
    iconPath: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Marktplaatsen",
    tagline: "Advertenties, reviews, zoekertjes",
    description: "Modereer productadvertenties, reviews en berichten van verkopers op schaal. Onderschep oplichting en verboden artikelen voordat ze online staan.",
    href: localizePath("/use-cases/marketplaces", locale),
    iconPath: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z",
  },
  {
    title: "Gaming",
    tagline: "Chat, MMO's, live ops",
    description: "Realtime chatmoderatie in meerdere talen, binnen 500 ms. Overtredingen worden automatisch verwijderd voordat andere spelers ze zien.",
    href: localizePath("/use-cases/gaming", locale),
    iconPath: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Enterprise SaaS",
    tagline: "Compliance, SOC 2, audit",
    description: "Hosting in de EU met volledige audittrails, controle over de bewaartermijn van data en aantoonbare gereedheid voor de DSA en SOC 2.",
    href: localizePath("/use-cases/enterprise-saas", locale),
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
  {
    title: "Merken & retail",
    tagline: "Merkpagina's, campagnes, klantreacties",
    description: "Verberg spam, oplichting en scheldpartijen onder je merkposts, terwijl ontevreden klanten zichtbaar blijven en een antwoord krijgen.",
    href: localizePath("/use-cases/brands-retail", locale),
    iconPath: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z",
  },
  {
    title: "Luxe & mode",
    tagline: "Instagram, namaak, veel talen",
    description: "Houd namaakproducten, nepaccounts en haat weg van je posts, in elke taal die je klanten spreken.",
    href: localizePath("/use-cases/luxury-fashion", locale),
    iconPath: "M5 3l3.057 4.583L12 3l3.943 4.583L19 3l2 7-9 11-9-11 2-7z",
  },
  {
    title: "Publieke sector",
    tagline: "Inspraak, burgerparticipatie",
    description: "Modereer publieke consultaties en de pagina's van je organisatie met openbare regels en een schriftelijke motivering bij elke beslissing.",
    href: localizePath("/use-cases/public-sector", locale),
    iconPath: "M3 21h18M5 21V10m14 11V10M12 3l9 7H3l9-7zM9 21v-6h6v6",
  },
];
---

<BaseLayout title="Toepassingen van contentmoderatie: social, AI, gaming" description="Ontdek hoe sociale platforms, AI-apps, marktplaatsen, games en bedrijven OpenModeration inzetten voor transparante, DSA-conforme contentmoderatie." jsonLd={useCasesJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath("/", locale) }, { label: "Toepassingen" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
        <span class="flex h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        Toepassingen
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Eén moderatieplatform voor elk type platform</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Forums, LLM-apps, marktplaatsen en games gebruiken allemaal OpenModeration. We stemmen het af op je content, je regels en je use cases.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <KpiBand items={kpis} />
  </section>

  <section class="bg-white pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {useCases.map((useCase) => (
          <a href={useCase.href} class="group rounded-xl border border-surface-200 bg-surface-50 p-8 transition hover:border-brand-300 hover:shadow-md">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={useCase.iconPath}/></svg>
            </div>
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">{useCase.title}</h2>
            <p class="mt-1 text-xs font-medium uppercase tracking-wide text-surface-400">{useCase.tagline}</p>
            <p class="mt-3 text-sm text-surface-500">{useCase.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Meer weten
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
        <a href={localizePath("/features", locale)} class="group rounded-xl border-2 border-dashed border-surface-300 bg-white p-8 transition hover:border-brand-400">
          <div class="flex h-full flex-col items-start justify-center">
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">Alle functies bekijken</h2>
            <p class="mt-3 text-sm text-surface-500">Uniforme API, Action Engine, reviewdashboard, connectoren en DSA-audittrails.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Bekijk het platform
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Hetzelfde platform, andere handhaving</h2>
        <p class="mt-4 text-lg text-surface-500">Elke toepassing krijgt dezelfde bouwstenen. Alleen de regels verschillen.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">1. Content binnenhalen</h3>
          <p class="mt-2 text-sm text-surface-500">REST API, een batch-endpoint voor achterstanden, webhooks of native connectoren voor Facebook, Instagram, YouTube en WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">2. Modereren met AI</h3>
          <p class="mt-2 text-sm text-surface-500">Onze eigen moderatie-AI beslist, bij lastige gevallen gecontroleerd door andere AI-modellen, en het responsschema verandert nooit.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">3. Automatisch handhaven</h3>
          <p class="mt-2 text-sm text-surface-500">Verboden woorden, drempels per categorie en je eigen regels sturen de acties: verbergen, verwijderen, markeren; twijfelgevallen handelt ons team af.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Gerelateerde artikelen</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href={localizePath("/blog/dsa-compliance-sme-guide", locale)} class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Gids</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA-compliance voor kleine en middelgrote platforms</h3>
          <p class="mt-2 text-sm text-surface-500">Praktische stappen om in 2026 aan de eisen van de DSA te voldoen.</p>
        </a>
        <a href={localizePath("/blog/ai-content-moderation-developer-guide", locale)} class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Gids</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Contentmoderatie voor AI-toepassingen</h3>
          <p class="mt-2 text-sm text-surface-500">Best practices voor het filteren van input en output in apps die op LLM's draaien.</p>
        </a>
        <a href={localizePath("/dashboard", locale)} class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Product</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">De moderatieconsole</h3>
          <p class="mt-2 text-sm text-surface-500">Elke beslissing in realtime, audittrails en gebruiksstatistieken.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Binnen een paar minuten weet je wat bij je past."
    subtitle="Kies een toepassing, start met de beheerde cloud en modereer vandaag nog je eerste content."
    buttonText="Gratis uitproberen"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
