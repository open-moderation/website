---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import { getLocale, localizePath } from '../../../i18n/routes';
import { bookingUrl } from '../../../i18n/ui';

const locale = getLocale(Astro.url.pathname);

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/toepassingen/enterprise-saas",
  "url": "https://www.openmoderation.com/nl/toepassingen/enterprise-saas",
  "name": "Contentmoderatie voor enterprise SaaS | OpenModeration",
  "description": "Voldoe aan de compliance-eisen van grote klanten met transparante contentmoderatie, gehost in de EU. Klaar voor de DSA en SOC 2, met volledige audittrails en dashboards voor teambeheer.",
  "inLanguage": "nl"
};

---

<BaseLayout title="Contentmoderatie voor enterprise: EU-hosting en DSA" description="Contentmoderatie voor B2B-SaaS: gehost in de EU, DSA-conform en klaar voor SOC 2, met volledige audittrails en elke beslissing schriftelijk uitgelegd." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath("/", locale) }, { label: "Toepassingen", href: localizePath("/use-cases", locale) }, { label: "Enterprise SaaS" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Toepassing</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Contentmoderatie voor enterprise SaaS</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">Voldoe aan strenge compliance-eisen van grote organisaties met een AI-moderatieplatform dat elke beslissing schriftelijk uitlegt en een volledige audittrail bijhoudt.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/nl/afspraak-maken" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Plan een gesprek</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Gratis proberen</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">De uitdaging</h3>
          <p class="mt-2 text-sm text-surface-600">B2B-SaaS-platforms die door gebruikers gemaakte content hosten, leggen verantwoording af aan toezichthouders en aan veeleisende zakelijke klanten. Handmatige moderatie is lastig te auditen, en tools die buiten de EU worden gehost, voldoen niet altijd aan de eisen voor datasoevereiniteit.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">De oplossing van OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">Een moderatieplatform dat in de EU wordt gehost en samen met ons team wordt ingericht. Je koppelt je platform, wij doen de rest: je compliance-regels worden toegepast, twijfelgevallen handelt ons team af, en jij ziet elke beslissing met haar schriftelijke motivering in realtime in een dashboard met volledige audittrail.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Het resultaat</h3>
          <p class="mt-2 text-sm text-surface-600">Ga enterprise-deals in met het bewijs al klaar. Onveranderbare logs tonen aan dat je klaar bent voor de DSA en SOC 2, je data blijft volledig onder je eigen controle en de moderatie groeit mee zonder dat de beveiliging verzwakt.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Over compliance valt niet te onderhandelen</h2>
          <p class="mt-4 text-lg text-surface-500">Zakelijke klanten verwachten moderatie die ze kunnen auditen, en toezichthouders eisen het. OpenModeration is vanaf het begin ontworpen om aan die normen te voldoen.</p>
          <div class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">EU</p>
              <p class="text-xs text-surface-500">Data gehost in de Europese Unie</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">100%</p>
              <p class="text-xs text-surface-500">Beslissingen schriftelijk uitgelegd</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">&lt;300 ms</p>
              <p class="text-xs text-surface-500">P50-latency per verzoek</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">10.000</p>
              <p class="text-xs text-surface-500">Items per batchverzoek</p>
            </div>
          </div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
              <h3 class="font-semibold text-surface-900">Moderatieconsole</h3>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-700"><span class="flex h-1.5 w-1.5 rounded-full bg-accent-500"></span> Alle systemen operationeel</span>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Verzoeken vandaag</p>
                <p class="mt-1 text-xl font-bold text-surface-900">84,2K</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Aandeel gemarkeerd</p>
                <p class="mt-1 text-xl font-bold text-surface-900">4,7%</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">P50-latency</p>
                <p class="mt-1 text-xl font-bold text-surface-900">267 ms</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Auditexports</p>
                <p class="mt-1 text-xl font-bold text-surface-900">12</p>
              </div>
            </div>
            <div class="mt-4 rounded-lg border border-surface-200 bg-white">
              <div class="flex items-center justify-between border-b border-surface-200 px-4 py-2 text-xs font-semibold text-surface-500">
                <span>AUDITTRAIL</span>
                <span class="text-accent-600">DSA-export klaar</span>
              </div>
              <ul class="divide-y divide-surface-100 text-xs">
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXK4&hellip;</span>
                  <span class="text-surface-600">hate <strong class="text-surface-900">0.91</strong> &rarr; verwijderd</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">automatisch</span>
                </li>
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXJ9&hellip;</span>
                  <span class="text-surface-600">harassment <strong class="text-surface-900">0.58</strong> &rarr; beoordeling</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">ons team</span>
                </li>
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXH2&hellip;</span>
                  <span class="text-surface-600">flagged: false</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">automatisch</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
              <h3 class="font-semibold text-surface-900">Controle over bewaartermijnen</h3>
              <p class="mt-2 text-sm text-surface-500">Stel de bewaartermijn in op 0, 7, 30 of 90 dagen. Gevoelige content wordt versleuteld opgeslagen en op verzoek volledig verwijderd.</p>
            </div>
            <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
              <h3 class="font-semibold text-surface-900">Klaar voor SOC 2</h3>
              <p class="mt-2 text-sm text-surface-500">Auditlogs, toegangsbeheer en versleuteling in opslag en tijdens transport, ontworpen om aan te sluiten op een SOC 2-certificeringstraject.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 text-center">Veelgestelde vragen over enterprise-moderatie</h2>
        <div class="mt-8 divide-y divide-surface-200">
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Is een on-premise installatie van OpenModeration mogelijk?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Standaard wordt OpenModeration in de Europese Unie gehost. Een on-premise installatie is op aanvraag mogelijk: <a href={bookingUrl(locale)} class="text-brand-600 hover:text-brand-500" target="_blank" rel="noopener">laten we het bespreken</a>.</p>
          </details>
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Hoe helpt OpenModeration bij SOC 2- en DSA-audits?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Elke moderatiebeslissing, door AI of door een mens, wordt gelogd met scores, toegepaste regel, actie, schriftelijke reden en tijdstempel. Analytics-endpoints leveren de totalen voor DSA-transparantieverslagen, en het bewaarbeleid is per vereiste in te stellen.</p>
          </details>
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Hoe beheren we de toegang voor verschillende teams en klanten?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Workspaces scheiden content en configuratie per team of tenant. Beheerders geven API-sleutels uit met een beperkte reikwijdte en rate limits, en het dashboard regelt de rollen en rechten van iedereen in je team die de beslissingen wil volgen of ingrijpen.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Gerelateerde artikelen</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href={localizePath("/blog/dsa-compliance-sme-guide", locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Gids</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA-compliance voor kleine en middelgrote platforms</h3>
          <p class="mt-2 text-sm text-surface-500">Praktische stappen voor SaaS-platforms om in 2026 aan de eisen van de DSA te voldoen.</p>
        </a>
        <a href={localizePath("/alternatives/azure-content-safety", locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Vergelijking</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">OpenModeration vs Azure Content Safety</h3>
          <p class="mt-2 text-sm text-surface-500">Waarom een volledig moderatieplatform met audittrails beter past bij enterprise-compliance dan een kale API.</p>
        </a>
        <a href={localizePath("/features", locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Platform</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Alle functies bekijken</h3>
          <p class="mt-2 text-sm text-surface-500">Bekijk de Action Engine, teambeheer en geautomatiseerde workflows.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Win enterprise-deals met aantoonbare moderatie."
    subtitle="Houd je data in de EU, exporteer ze wanneer je wilt en ga audits in met onveranderbare logs. Neem contact op om het in te richten."
    buttonText="Gratis uitproberen"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>