---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';
const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Reactiemoderatie voor merken en retail"
  description="Modereer reacties onder je merkposts op Facebook, Instagram en YouTube met je eigen regels: spam, scams en scheldwoorden verborgen, kritiek blijft zichtbaar."
  crumb="Merken en retail"
  h1="Reactiemoderatie voor merken en retail"
  intro="Onder elke post van een merk staan echte klanten naast spam, nepaccounts, scams en scheldpartijen. OpenModeration verbergt wat je imago schaadt volgens jouw regels, laat terechte kritiek zichtbaar en signaleert de berichten waarop je team moet reageren."
  problem="Een campagne die aanslaat, levert in een paar uur honderden reacties op, vaak 's avonds en in het weekend. De ingebouwde filters van Meta en YouTube blokkeren woorden, geen intenties: nepwinacties en scamlinks glippen erdoor, en klanten met een echt probleem worden soms juist verborgen."
  approach="Contextbewuste AI leest elke reactie naast de regels van je merk. Spam, scams, haat en persoonlijke aanvallen worden direct verborgen. Klachten, vragen over een bestelling en kritiek blijven zichtbaar en komen bij je team terecht."
  result="Je communitymanager hoeft niet langer 's avonds threads op te schonen. Klanten zien een merk dat antwoordt, geen pagina vol spam, en voor elke verborgen reactie is er een schriftelijke reden als iemand ernaar vraagt."
  featuresTitle="Gemaakt voor socialmediateams"
  featuresIntro="We richten de moderatie samen met je in, op basis van je regels en de situaties waar je merk echt mee te maken krijgt."
  features={[
    { title: "Kritiek is geen scheldpartij", text: "Een ontevreden klant blijft zichtbaar en kan een antwoord krijgen. Alleen beledigende, haatdragende of frauduleuze reacties worden verborgen." },
    { title: "Nepwinacties en scamlinks", text: "Accounts die zich voordoen als je merk om prijzen te beloven of mensen naar frauduleuze sites te sturen, worden automatisch herkend en verborgen." },
    { title: "Al je pagina's op één plek", text: "Facebook, Instagram, YouTube en je WordPress-site komen in dezelfde console terecht met dezelfde regels, of je nu één pagina beheert of vijftig." },
    { title: "Regels per campagne", text: "Een lancering, een crisis of een samenwerking kan strengere regels vragen. Je past ze aan in gewone taal, zonder code." },
  ]}
  why={[
    { title: "Jouw regels, jouw use cases", text: "Geen generieke lijst met trefwoorden: de moderatie volgt wat jij hebt opgeschreven, en we stemmen haar campagne na campagne met je af." },
    { title: "Mensen achter de tool", text: "Ons team helpt je je regels op te stellen en handelt de grensgevallen af. Je staat er nooit alleen voor met een tool." },
    { title: "Veel goedkoper dan een bureau", text: "De moderatie draait dag en nacht automatisch, voor een fractie van de kosten van uitbestede moderatie." },
  ]}
  faq={[
    { question: "Worden negatieve reacties verwijderd?", answer: "Nee. Kritiek, ook als die hard is, blijft zichtbaar als ze je regels respecteert. Beledigingen, haat, spam en scams worden verborgen. Jij bepaalt waar de grens ligt." },
    { question: "Worden reacties verwijderd of verborgen?", answer: "Op Facebook en Instagram worden reacties verborgen: de schrijver en diens vrienden zien ze nog, de rest van je publiek niet. Je kunt ze met één klik weer zichtbaar maken vanuit de console." },
    { question: "Hoe snel kun je starten?", answer: "Een pagina koppelen duurt een paar minuten. Daarna plannen we een gesprek om de moderatie af te stemmen op je regels en use cases en haar te testen op je echte reacties." },
    { question: "Waar worden de gegevens gehost?", answer: "OpenModeration wordt ontwikkeld en gehost in de Europese Unie en voldoet aan de AVG." },
  ]}
  related={[
    { eyebrow: "Integratie", title: "Facebook-reacties modereren", text: "Koppel je Facebook-pagina's en verberg automatisch reacties die je regels overtreden.", href: localizePath('/integrations/facebook', locale) },
    { eyebrow: "Integratie", title: "Instagram-reacties modereren", text: "Reacties onder je posts en Reels, gemodereerd met dezelfde regels.", href: localizePath('/integrations/instagram', locale) },
    { eyebrow: "Gids", title: "Een moderatiebeleid opstellen", text: "De regels die je vastlegt voordat je automatiseert, met voorbeelden.", href: localizePath('/content-moderation-policy', locale) },
  ]}
  ctaTitle="Een schone merkpagina, zonder je avonden op te offeren."
  ctaSubtitle="Plan een gesprek: we bekijken samen je reacties en laten zien wat de moderatie ermee had gedaan."
/>
