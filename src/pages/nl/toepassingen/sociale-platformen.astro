---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import BrowserFrame from '../../../components/BrowserFrame.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/toepassingen/sociale-platformen",
  "url": "https://www.openmoderation.com/nl/toepassingen/sociale-platformen",
  "name": "Moderatieplatform voor sociale apps en communities: één centrale console (2026)",
  "description": "Het moderatieplatform voor sociale apps, forums en communities: centrale moderatieconsole, automatische regels zonder code, menselijke beoordeling door ons team en DSA-conforme audittrails. Gratis starten.",
  "inLanguage": "nl"
};
---

<BaseLayout title="Moderatie voor sociale platforms en communities, zonder code" description="Beheer al je moderatie vanuit één console: verberg toxische reacties direct, regels zonder code, twijfelgevallen voor ons team en DSA-audit." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Toepassingen", href: localizePath('/use-cases', locale) }, { label: "Sociale platforms" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Toepassing
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">AI-contentmoderatie voor sociale platforms</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bescherm je community terwijl ze groeit. OpenModeration modereert reacties, posts en berichten automatisch, en je Trust &amp; Safety-team krijgt een eigen beoordelingsconsole.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">De uitdaging</h3>
          <p class="mt-2 text-sm text-surface-600">Op een sociaal platform blijven gebruikersposts binnenstromen. Handmatige moderatie houdt het niet bij, en starre trefwoordfilters geven zoveel valse positieven dat ze je community irriteren.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">De oplossing van OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">De AI leest elke post in context en in realtime, en de Action Engine verbergt risicovolle posts automatisch. Grensgevallen worden door ons team afgehandeld, en jij ziet elke beslissing in realtime.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Het resultaat</h3>
          <p class="mt-2 text-sm text-surface-600">Je team hoeft niets handmatig te beoordelen, tenzij het dat wil. Volledige, exporteerbare audittrails houden je DSA-conform, en je community wordt een veiligere plek om mee te doen.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Modereer elk contactpunt</h2>
          <p class="mt-4 text-lg text-surface-500">
            Communities die niets doen, riskeren boetes van toezichthouders en het verlies van leden. OpenModeration geeft je de tools om compliant en veilig te blijven.
          </p>
          <div class="mt-8 space-y-3">
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Reactiemoderatie in realtime</p>
              <p class="mt-1 text-xs text-surface-500">Analyseer content voordat die verschijnt. De AI leest elke post in zijn eigen taal en past overal dezelfde regels toe.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Bestaande content achteraf modereren</p>
              <p class="mt-1 text-xs text-surface-500">Verstuur tot 10.000 items in één batch en schoon maanden aan oude content op in een paar minuten.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Automatische handhaving en menselijke beoordeling</p>
              <p class="mt-1 text-xs text-surface-500">Haatzaaiende taal wordt automatisch verborgen en grensgevallen worden door ons team beoordeeld. Elke actie wordt vastgelegd voor compliance.</p>
            </div>
          </div>
        </div>
        <BrowserFrame
          src="/images/dashboard.png"
          video="om-triage"
          alt="Console van OpenModeration: gemarkeerde reacties, hun status en de genomen actie"
          caption="Alles in één console: gemarkeerde content, beslissingen en geschiedenis, in realtime zichtbaar."
        />
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Waarom sociale platforms kiezen voor OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Meertalige ondersteuning</h3>
          <p class="mt-2 text-sm text-surface-500">De AI leest Engels, Frans, Duits en andere talen in hun oorspronkelijke vorm, met dezelfde regels voor iedereen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Realtime prestaties</h3>
          <p class="mt-2 text-sm text-surface-500">De gebruikelijke latentie blijft onder de 300 ms, snel genoeg om reacties direct te modereren zonder gebruikers op te houden.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Audittrail klaar voor de DSA</h3>
          <p class="mt-2 text-sm text-surface-500">Elke moderatiebeslissing wordt volledig vastgelegd en kan worden geëxporteerd voor transparantieverslagen en audits door toezichthouders.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Gerelateerde bronnen</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href={localizePath('/blog/dsa-compliance-sme-guide', locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Gids</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA-compliance voor kleine en middelgrote platforms</h3>
          <p class="mt-2 text-sm text-surface-500">Praktische stappen voor communities om in 2026 aan de DSA-eisen te voldoen.</p>
        </a>
        <a href={localizePath('/alternatives/perspective-api', locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Vergelijking</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">OpenModeration vs Perspective API</h3>
          <p class="mt-2 text-sm text-surface-500">Waarom communityforums een volledig moderatieplatform nodig hebben in plaats van een API die verdwijnt.</p>
        </a>
        <a href={localizePath('/features', locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Platform</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Ontdek alle functies</h3>
          <p class="mt-2 text-sm text-surface-500">Ontdek de Action Engine, het teambeheer en de geautomatiseerde workflows.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
