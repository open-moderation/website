---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';
const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderatie voor gemeenten en publieke instellingen"
  description="Modereer inspraakrondes, participatieplatforms en de sociale pagina's van je instelling met openbare regels en een schriftelijke reden bij elke beslissing."
  crumb="Publieke sector"
  h1="Moderatie voor gemeenten en publieke instellingen"
  intro="Inspraakrondes, participatieplatforms, de Facebook-pagina van de gemeente: het publieke debat heeft open ruimtes nodig die ook veilig zijn. OpenModeration past je participatieregels toe op elke bijdrage en legt elke beslissing schriftelijk uit, zodat niemand van willekeurige censuur kan spreken."
  problem="Een inspraakronde over een lokaal project kan in een paar dagen honderden bijdragen opleveren, met beledigingen aan het adres van bestuurders of medewerkers, haatzaaiende taal en berichten die niets met het onderwerp te maken hebben. Handmatig modereren kost personeelstijd, en elke verwijdering kan worden aangevochten."
  approach="We stemmen de moderatie af op je participatieregels en use cases. Elke bijdrage wordt in context gelezen: beledigingen en haat worden verborgen, kritiek blijft gepubliceerd, ook als die scherp is, en grensgevallen gaan met een schriftelijke reden naar je medewerkers."
  result="Het debat blijft open en respectvol, je teams besparen tijd en je kunt op elk moment laten zien waarom een bijdrage is verborgen. Elke beslissing wordt bewaard in een volledige geschiedenis."
  featuresTitle="Gemaakt voor het publieke debat"
  featuresIntro="In een publieke ruimte is de manier waarop je modereert net zo belangrijk als het resultaat. We stellen de regels samen met je op."
  features={[
    { title: "Openbare regels, toegepast zoals ze er staan", text: "De regels die je voor inwoners publiceert, zijn de regels die de AI toepast. Geen verborgen regels." },
    { title: "Kritiek blijft mogelijk", text: "Bezwaar tegen een project of een besluit blijft zichtbaar. Alleen beledigende, haatdragende of regelovertredende inhoud wordt verborgen." },
    { title: "Een reden bij elke beslissing", text: "Bij elke verborgen bijdrage hoort de betrokken regel en een schriftelijke reden die je met de schrijver kunt delen." },
    { title: "Platform en sociale pagina's samen", text: "Je participatietool via de API, en je pagina's op Facebook, Instagram en YouTube, in dezelfde console." },
  ]}
  why={[
    { title: "Transparantie", text: "Elke beslissing wordt uitgelegd en vastgelegd: handig als je een inwoner, een bestuurder of een audit te woord moet staan." },
    { title: "Menselijke begeleiding", text: "Ons team helpt je je regels vast te stellen en gevoelige gevallen af te handelen, in samenwerking met je afdelingen." },
    { title: "Gehost in de EU", text: "Ontwikkeld en gehost in de Europese Unie, AVG-conform." },
  ]}
  faq={[
    { question: "Is automatische moderatie geen vorm van censuur?", answer: "Ze past alleen de regels toe die je openbaar hebt gemaakt en legt elke beslissing schriftelijk uit. Over twijfelgevallen beslissen je medewerkers, niet de AI." },
    { question: "Kun je een bestaand participatieplatform modereren?", answer: "Ja. Bijdragen kunnen vanuit je tool via de API naar OpenModeration worden gestuurd, naast je sociale pagina's." },
    { question: "Blijven de gegevens van inwoners in Europa?", answer: "Ja. OpenModeration wordt ontwikkeld en gehost in de Europese Unie en voldoet aan de AVG." },
    { question: "Hoe beginnen we?", answer: "Plan een gesprek: we vertrekken vanuit je participatieregels en use cases en testen ze op echte bijdragen voordat we ze inschakelen." },
  ]}
  related={[
    { eyebrow: "Gids", title: "Een moderatiebeleid opstellen", text: "De regels die je vastlegt voordat je automatiseert, met voorbeelden.", href: localizePath('/content-moderation-policy', locale) },
    { eyebrow: "Platform", title: "Elke beslissing uitgelegd", text: "Hoe OpenModeration bij elke moderatiebeslissing een reden opschrijft.", href: localizePath('/product/transparency', locale) },
    { eyebrow: "Integratie", title: "Facebook-reacties modereren", text: "Reacties onder de posts van je instelling.", href: localizePath('/integrations/facebook', locale) },
  ]}
  ctaTitle="Een open debat, zonder scheldpartijen."
  ctaSubtitle="Plan een gesprek: we vertrekken vanuit je participatieregels en laten je de moderatie zien op je echte bijdragen."
/>
