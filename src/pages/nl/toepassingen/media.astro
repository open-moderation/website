---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import BrowserFrame from '../../../components/BrowserFrame.astro';
import ClientLogos from '../../../components/ClientLogos.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Reactiemoderatie voor nieuwsmedia en mediawebsites",
  "description": "AI-reactiemoderatie voor nieuwssites en redacties: moderatie afgestemd op je redactionele regels bij elk artikel, een schriftelijke reden voor elke verwijderde reactie, twijfelgevallen afgehandeld door ons team en een DSA-audittrail.",
  "inLanguage": "nl",
  "url": "https://www.openmoderation.com/nl/toepassingen/media",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const faqItems = [
  {
    question: "Moeten nieuwswebsites voor hun reactiesecties aan de DSA voldoen?",
    answer: "Reactiesecties bevatten content die lezers plaatsen, dus een nieuwssite met reacties is een hostingdienst in de zin van de Digital Services Act. Artikel 17 vereist een duidelijke motivering telkens wanneer een reactie wordt verwijderd of beperkt, inclusief de vermelding of daarbij geautomatiseerde middelen zijn gebruikt. OpenModeration schrijft die motivering bij elke beslissing en bewaart haar in de audittrail.",
  },
  {
    question: "Kan de moderatie onze eigen redactionele regels volgen?",
    answer: "Ja. We stemmen de moderatie af op je redactionele regels en use cases, in gewone taal geschreven, en OpenModeration past ze toe op elke reactie. De sportredactie en de politieke redactie kunnen verschillende regels hebben, en je kunt een regel op elk moment strenger of soepeler maken, zonder code.",
  },
  {
    question: "Wat gebeurt er met twijfelachtige reacties?",
    answer: "Elke categorie heeft twee drempels. Duidelijke overtredingen worden automatisch verborgen, duidelijk acceptabele reacties worden gepubliceerd, en alles daartussen wordt door ons team afgehandeld. Je redactie ziet elke beslissing in realtime en kan op elk moment ingrijpen.",
  },
  {
    question: "Kunnen journalisten blijven modereren vanaf de artikelpagina?",
    answer: "Ja. Beslissingen van je redactie worden vastgelegd in dezelfde activiteitengeschiedenis als de automatische beslissingen, zodat je één volledig overzicht houdt van wie wat heeft besloten en waarom.",
  },
  {
    question: "Waar wordt de data gehost?",
    answer: "OpenModeration wordt ontwikkeld en gehost in de Europese Unie en voldoet aan de AVG. Een on-premise installatie is op aanvraag mogelijk: laten we het bespreken.",
  },
];
---

<BaseLayout title="Reactiemoderatie voor nieuwsmedia en mediawebsites" description="Modereer lezersreacties met AI die je redactionele regels volgt. Een schriftelijke reden per verwijdering, twijfelgevallen voor ons team en DSA-audit." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Toepassingen", href: localizePath('/use-cases', locale) }, { label: "Nieuwsmedia" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Toepassing
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Reactiemoderatie voor nieuwsmedia</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Lezersreacties brengen een artikel tot leven, totdat beledigingen en spam de discussie overnemen. OpenModeration past je redactionele regels toe op elke reactie, licht elke verwijdering schriftelijk toe en ons team beslist over de twijfelgevallen. Je redactie ziet alles en houdt de regie.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/nl/afspraak-maken" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Plan een gesprek</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Gratis proberen</a>
      </div>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">De uitdaging</h3>
          <p class="mt-2 text-sm text-surface-600">Een drukbezochte nieuwssite krijgt de klok rond reacties, met pieken bij elk breaking nieuwsbericht. Journalisten kunnen ze niet allemaal lezen, en trefwoordfilters missen sarcasme, verhulde beledigingen en aanvallen die niets met het onderwerp te maken hebben, terwijl ze legitieme kritiek juist blokkeren.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">De aanpak van OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">AI die de context begrijpt, toetst elke reactie aan je regels. Duidelijke overtredingen worden meteen verborgen, acceptabele reacties gaan live, en twijfelgevallen worden door ons team afgehandeld, met de betreffende regel en een schriftelijke reden.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Het resultaat</h3>
          <p class="mt-2 text-sm text-surface-600">Je redactie hoeft niets te doen, tenzij ze dat wil: ze ziet elke beslissing in realtime en kan op elk moment ingrijpen. Elke beslissing, automatisch of redactioneel, wordt met de reden vastgelegd, klaar voor bezwaar van een lezer of een vraag van een toezichthouder.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Gemaakt voor hoe redacties werken</h2>
          <p class="mt-4 text-lg text-surface-500">
            Een reactiesectie modereren is een redactionele keuze. Met OpenModeration houdt je redactie het zicht en de regie, en wij doen het werk.
          </p>
          <div class="mt-8 space-y-3">
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Jouw regels, in gewone taal</p>
              <p class="mt-1 text-xs text-surface-500">Schrijf de regels op die je lezers al kennen. Geen trefwoordlijsten om bij te houden, geen code om aan te passen als de grens verschuift.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Menselijk oordeel voor twijfelgevallen</p>
              <p class="mt-1 text-xs text-surface-500">Twee drempels per categorie scheiden wat automatisch wordt verborgen van wat ons team beoordeelt. Jij bepaalt hoe breed die zone is.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Eén geschiedenis voor beslissingen van AI en redactie</p>
              <p class="mt-1 text-xs text-surface-500">Verwijderingen door journalisten staan naast de automatische in het activiteitenlogboek, met wie ze uitvoerde en de reden.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Reacties bij artikelen en sociale pagina's samen</p>
              <p class="mt-1 text-xs text-surface-500">Modereer je website via de API of de WordPress-connector, en de reacties onder je posts op Facebook, Instagram en YouTube vanuit dezelfde console.</p>
            </div>
          </div>
        </div>
        <BrowserFrame
          src="/images/dashboard.png"
          video="om-triage"
          alt="Moderatieconsole van OpenModeration met lezersreacties, hun status en de uitgevoerde actie"
          caption="De console: elke reactie met haar status, de betreffende regel en de schriftelijke reden, in realtime."
        />
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Waarom uitgevers voor OpenModeration kiezen</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Een motivering bij elke verwijdering</h3>
          <p class="mt-2 text-sm text-surface-500">De DSA verplicht hostingdiensten om elke verwijdering toe te lichten. OpenModeration schrijft die toelichting automatisch, zodat lezers weten welke regel ze hebben overtreden.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Ontwikkeld en gehost in de EU</h3>
          <p class="mt-2 text-sm text-surface-500">Lezersdata blijft in Europa en het platform voldoet aan de AVG. Vereist je juridische team een on-premise installatie, dan is die op aanvraag mogelijk: laten we het bespreken.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Geen black box</h3>
          <p class="mt-2 text-sm text-surface-500">Elke beslissing komt met een schriftelijke reden en een volledige audittrail. Komt er een beter AI-model uit, dan sluiten we het aan zonder dat jij iets hoeft te veranderen.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Veelgestelde vragen" items={faqItems} />
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Gerelateerde artikelen</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href={localizePath('/dsa-compliance', locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Regelgeving</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA-compliance</h3>
          <p class="mt-2 text-sm text-surface-500">Wat de Digital Services Act vraagt van sites met reacties, en hoe je eraan voldoet.</p>
        </a>
        <a href={localizePath('/product/transparency', locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Platform</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Elke beslissing uitgelegd</h3>
          <p class="mt-2 text-sm text-surface-500">Hoe OpenModeration bij elke moderatiebeslissing een reden schrijft.</p>
        </a>
        <a href={localizePath('/integrations/wordpress', locale)} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Integratie</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Reactiemoderatie voor WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Modereer de reacties op een WordPress-nieuwssite zonder code te schrijven.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection title="Geef je reactiesectie terug aan je lezers." subtitle="Vertel ons je regels en koppel je site: onze AI en ons team doen de rest, je redactie ziet elke beslissing in realtime." />
</BaseLayout>
