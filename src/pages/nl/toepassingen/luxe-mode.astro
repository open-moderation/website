---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';
const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Reactiemoderatie voor luxe- en modemerken"
  description="Bescherm het imago van je maison op Instagram, Facebook en YouTube: namaak, scams en haat verborgen volgens je regels, in elke taal die je klanten spreken."
  crumb="Luxe en mode"
  h1="Reactiemoderatie voor luxe en mode"
  intro="Een luxehuis wordt ook beoordeeld op de reacties onder zijn posts. OpenModeration verbergt namaak, nepaccounts, scams en haat volgens jouw regels, in elke taal die je klanten spreken, en laat de gesprekken staan die je community levend houden."
  problem="Luxeaccounts trekken verkopers van namaak aan, nepaccounts die zich voordoen als het huis, scams met nepwinacties en golven van haat rond shows of de aankondiging van ambassadeurs. En dat alles in een tiental talen, de klok rond."
  approach="We stemmen de moderatie af op je regels, je use cases en je merkstem. De AI leest elke reactie in context en in haar eigen taal: namaak, scamlinks en aanvallen worden direct verborgen, en delicate gevallen worden door ons team afgehandeld. Jij ziet elke beslissing met haar schriftelijke reden in realtime."
  result="Je posts blijven het huis waardig, overal ter wereld, zonder een team dat dag en nacht de threads in de gaten houdt. Elke beslissing wordt vastgelegd, wat de samenwerking met je juridische en communicatieteams vergemakkelijkt."
  featuresTitle="Gemaakt voor internationale maisons"
  featuresIntro="Een merkimago bescherm je niet met een lijst verboden woorden. We bouwen de moderatie samen met je op."
  features={[
    { title: "Namaak en nepaccounts", text: "Berichten die verwijzen naar replica's, nepwinkels of accounts die zich voordoen als het huis, worden herkend en verborgen." },
    { title: "Elke taal van je klanten", text: "Eén set regels, toegepast op reacties in het Engels, Frans, Chinees, Arabisch, Italiaans of Japans." },
    { title: "Gevoelige momenten onder controle", text: "Een show, een lancering, een ambassadeur onder vuur: maak de regels tijdelijk strenger en ga daarna terug naar normaal." },
    { title: "Eén console voor alle regio's", text: "Elk landenteam ziet de gevallen die het aangaan, met de betrokken regel en de schriftelijke reden." },
  ]}
  why={[
    { title: "Jouw stem, jouw regels", text: "De moderatie volgt je regels en je imago, geen generiek raster. We stemmen haar met je af." },
    { title: "Persoonlijke begeleiding", text: "Ons team handelt de grensgevallen af en volgt de resultaten samen met je socialmediateams." },
    { title: "Gehost in de EU", text: "Ontwikkeld en gehost in de Europese Unie, AVG-conform, met een volledige geschiedenis van elke beslissing." },
  ]}
  faq={[
    { question: "Werkt de moderatie in elke taal?", answer: "Ja. De AI leest reacties in hun oorspronkelijke taal en past dezelfde regels toe, dus je hoeft nooit per taal regels te schrijven." },
    { question: "Kunnen verschillende markten verschillende regels hebben?", answer: "Ja. Elk account of elke pagina kan eigen regels hebben, bijvoorbeeld strengere op een gevoelige markt of tijdens een lancering." },
    { question: "Wat gebeurt er met een twijfelachtige reactie?", answer: "Die wordt niet blind verborgen of gepubliceerd: ons team handelt haar af. Jij ziet de beslissing en de redenering erachter in realtime en kunt op elk moment ingrijpen." },
    { question: "Hoe verloopt de onboarding?", answer: "We beginnen met een gesprek om je regels, use cases en gevoelige gevallen te begrijpen, en testen de regels daarna op je echte reacties voordat we ze inschakelen." },
  ]}
  related={[
    { eyebrow: "Integratie", title: "Instagram-reacties modereren", text: "Reacties onder je posts en Reels, gemodereerd volgens je regels.", href: localizePath('/integrations/instagram', locale) },
    { eyebrow: "Integratie", title: "YouTube-reacties modereren", text: "Reacties onder je video's van shows en campagnes.", href: localizePath('/integrations/youtube', locale) },
    { eyebrow: "Platform", title: "Elke beslissing uitgelegd", text: "Hoe OpenModeration bij elke moderatiebeslissing een reden opschrijft.", href: localizePath('/product/transparency', locale) },
  ]}
  ctaTitle="Reacties die je huis waardig zijn."
  ctaSubtitle="Plan een gesprek: we nemen samen de reacties op je laatste posts door en laten zien wat de moderatie ermee had gedaan."
/>
