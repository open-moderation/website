---
import SectorPage from '../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Automatische moderatie van reacties met AI"
  description="Automatische moderatie van reacties op je site en social media, afgestemd op je regels en use cases, dag en nacht, met een schriftelijke reden per beslissing."
  crumb="Automatische moderatie"
  parent={null}
  eyebrow="AI-moderatie van reacties"
  h1="Automatische moderatie van reacties, op jouw voorwaarden"
  intro="Reacties komen de klok rond binnen, en vooral als je team offline is. OpenModeration modereert ze automatisch met AI die je regels binnen enkele seconden toepast, en ons team neemt de gevallen voor zijn rekening waarvoor menselijk oordeel nodig is."
  problem="Handmatige moderatie houdt het niet bij: pieken komen 's avonds, in het weekend of wanneer er groot nieuws is. Traditionele geautomatiseerde tools werken met woordenlijsten en verbergen uiteindelijk te veel of te weinig."
  approach="De AI leest elke reactie in context en toetst die aan je regels. Twee drempels per categorie bepalen wat automatisch wordt verborgen, wat wordt gepubliceerd en wat door ons team wordt beoordeeld. Elke beslissing krijgt een schriftelijke uitleg."
  result="Beledigingen, haat, spam en oplichting verdwijnen binnen enkele seconden, zonder te wachten tot een moderator inlogt. De echte grensgevallen handelt ons team af, en jij ziet elke beslissing in realtime."
  featuresTitle="Automatische moderatie die onder controle blijft"
  featuresIntro="Automatisch betekent geen black box. Jij ziet elke beslissing en kunt op elk moment ingrijpen."
  features={[
    { title: "Jij bepaalt de mate van automatisering", text: "Strenger, soepeler, meer of minder gevallen naar beoordeling: je stelt de drempels per categorie in." },
    { title: "Een reden bij elke beslissing", text: "Elke verborgen reactie heeft een schriftelijke reden die je aan de schrijver of aan een toezichthouder kunt laten zien." },
    { title: "Elke taal", text: "Eén beleid, toegepast op reacties in welke taal ze ook geschreven zijn." },
    { title: "Op al je platforms", text: "Je website via de API of WordPress, plus je Facebook-, Instagram- en YouTube-pagina's, met dezelfde regels." },
  ]}
  why={[
    { title: "Jouw regels, geen standaardraster", text: "De moderatie volgt je regels en je use cases. We stemmen haar samen met jou af." },
    { title: "Test het live", text: "Plak een reactie in de demo en zie de beslissing en de uitleg, zonder je aan te melden." },
    { title: "DSA-proof", text: "Motiveringen, meldingen van gebruikers, menselijke beoordeling en een volledige geschiedenis zijn inbegrepen." },
  ]}
  faq={[
    { question: "Maakt automatische moderatie fouten?", answer: "Geen enkel systeem is perfect. Daarom beslist de AI niet alleen over twijfelgevallen: die worden afgehandeld door ons team, en jij kunt elke beslissing met één klik terugdraaien." },
    { question: "Hoe snel wordt een reactie gemodereerd?", answer: "Binnen enkele seconden nadat ze is geplaatst of ontvangen." },
    { question: "Kunnen Facebook-reacties automatisch worden gemodereerd?", answer: "Ja. Koppel je Facebook-pagina's en Instagram-accounts: reacties die je regels overtreden, worden automatisch verborgen." },
    { question: "Wat kost het?", answer: "Er is een gratis abonnement om te beginnen en een Pro-abonnement. Voor grote volumes plan je een gesprek en bepalen we samen het juiste abonnement." },
  ]}
  related={[
    { eyebrow: "Demo", title: "Probeer de moderatie", text: "Plak een reactie en zie binnen enkele seconden de beslissing.", href: localizePath('/demo', locale) },
    { eyebrow: "Integratie", title: "Facebook-reacties modereren", text: "Verberg automatisch reacties onder je Facebook-posts.", href: localizePath('/integrations/facebook', locale) },
    { eyebrow: "Gids", title: "Een moderatiebeleid opstellen", text: "De regels die je vastlegt voordat je automatiseert.", href: localizePath('/content-moderation-policy', locale) },
  ]}
  ctaTitle="Automatiseer je moderatie deze week nog."
  ctaSubtitle="Plan een gesprek: we zetten samen je regels op en testen ze op je echte reacties."
/>
