---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const title = "OpenAI Moderation API alternatief: prijs en vergelijking";
const description = "De OpenAI Moderation API is gratis, maar geeft alleen scores. Vergelijk met OpenModeration: je eigen regels, menselijke beoordeling, uitleg en DSA-logboek.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/openai-moderation",
  "url": "https://www.openmoderation.com/nl/alternatieven/openai-moderation",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Wat het biedt", them: "Een API-endpoint dat teksten en afbeeldingen classificeert en een score per categorie teruggeeft", openmod: "AI-moderatie van reacties voor media, merken en overheidsinstanties, samen met het team van Logora ingericht volgens je regels en je use cases" },
  { feature: "Resultaat", them: "Een „flagged”-indicator (ja/nee) en een score per categorie (13 categorieën)", openmod: "Een uitgevoerde beslissing (verbergen, zichtbaar laten of naar menselijke beoordeling sturen) met een geschreven uitleg" },
  { feature: "Eigen regels", them: "Het is aan jou om scores om te zetten in acties", openmod: "Je regels en je use cases, ingericht met ons team" },
  { feature: "Menselijke beoordeling", them: "Geen interface: die bouw je zelf", openmod: "Twijfelgevallen afgehandeld door ons team; jij ziet alles in één console" },
  { feature: "Kanalen", them: "Geen connectoren: je roept de API aan vanuit je eigen code", openmod: "Website, Facebook, Instagram, YouTube en WordPress standaard; TikTok, X, LinkedIn en andere netwerken snel toegevoegd op verzoek" },
  { feature: "Logboek en DSA", them: "Niet inbegrepen", openmod: "Volledig activiteitenlogboek, melding en actie, motivering van beslissingen, menselijke beoordeling van betwiste beslissingen, exporteerbare cijfers" },
  { feature: "AI-modellen", them: "Een eigen model, omni-moderation-latest", openmod: "Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden aangesloten zodra ze uitkomen" },
  { feature: "Hosting van data", them: "Data verwerkt op de servers van OpenAI", openmod: "Gehost in de EU, AVG-conform; on-premise op aanvraag" },
  { feature: "Prijs", them: "Gratis endpoint (alleen scores)", openmod: "Gratis tot 1.000 verzoeken/maand, Pro € 99/maand voor 10.000 verzoeken, Enterprise op aanvraag" },
];

const faqItems = [
  {
    question: "Wat is het beste alternatief voor de OpenAI Moderation API?",
    answer: "Heb je alleen toxiciteitsscores nodig in je eigen code, dan doet het endpoint van OpenAI dat gratis. Wil je de reacties op je website, Facebook, Instagram en YouTube echt modereren, met je eigen regels, menselijke beoordeling en een geschreven uitleg bij elke beslissing, dan levert OpenModeration dat kant-en-klaar, ingericht samen met het team van Logora.",
  },
  {
    question: "Is de OpenAI Moderation API gratis?",
    answer: "Ja. OpenAI geeft aan dat zijn moderatie-endpoint gratis te gebruiken is. Het geeft een „flagged”-indicator en een score per categorie terug. Beslissen wat je verbergt, grensgevallen beoordelen en een auditlogboek bijhouden laat het aan jou over.",
  },
  {
    question: "Wat kost de OpenAI Moderation API in vergelijking met OpenModeration?",
    answer: "Het endpoint van OpenAI is gratis, maar geeft alleen scores terug: geen console, geen regels, geen menselijke beoordeling en geen auditlogboek. OpenModeration is gratis tot 1.000 verzoeken per maand, daarna € 99 per maand voor 10.000 verzoeken met Pro, en Enterprise op aanvraag voor grote volumes.",
  },
  {
    question: "Wat detecteert omni-moderation-latest?",
    answer: "omni-moderation-latest is het huidige moderatiemodel van OpenAI. Het accepteert teksten en afbeeldingen en scoort 13 categorieën: harassment, harassment/threatening, hate, hate/threatening, illicit, illicit/violent, self-harm, self-harm/intent, self-harm/instructions, sexual, sexual/minors, violence en violence/graphic.",
  },
  {
    question: "OpenAI Moderation API vs OpenModeration: wat kies je?",
    answer: "Kies de API van OpenAI als je een technisch team hebt dat de regels, de beoordelingsinterface en het auditlogboek kan bouwen. Kies OpenModeration als je moderatie wilt die vanaf dag één werkt op je kanalen, met een geschreven uitleg bij elke beslissing en bouwstenen voor de DSA.",
  },
  {
    question: "Welke AI-modellen gebruikt OpenModeration?",
    answer: "OpenModeration werkt met een eigen moderatie-AI, en bij gevoelige gevallen controleren andere AI-modellen de beslissingen. Komt er een beter of goedkoper model uit, dan sluit ons team het snel aan, zonder dat jij iets hoeft te veranderen: je profiteert van de vooruitgang van AI-modellen.",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: L('/') }, { label: "Alternatieven", href: L('/alternatives') }, { label: "OpenAI Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Vergelijking
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternatief voor de OpenAI Moderation API: van scores naar moderatie</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        De moderatie-API van OpenAI is gratis en geeft toxiciteitsscores terug; de rest moet je zelf regelen. Zoek je een alternatief dat je reacties echt modereert, dan verbergt OpenModeration duidelijke overtredingen, laat het legitieme kritiek zichtbaar, handelt ons team de twijfelgevallen af en legt het elke beslissing schriftelijk uit, volgens je regels en je use cases.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={L('/book-a-call')} class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Plan een gesprek</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Bekijk de vergelijking</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Voor wie is de OpenAI Moderation API?</h2>
      <p class="mt-4 text-surface-600">Volgens de documentatie van OpenAI is het moderatie-endpoint gratis en gebruikt het het model omni-moderation-latest, dat teksten en afbeeldingen accepteert en 13 categorieën scoort, zoals intimidatie, haat, seksuele content en geweld. Het geeft een „flagged”-indicator en een score per categorie terug. Het is een goed hulpmiddel voor ontwikkelteams die een classificatie in hun eigen product willen inbouwen en de rest zelf bouwen: regels, beoordeling, logboek.</p>
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Kies OpenModeration als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>je je website, WordPress, Facebook, Instagram en YouTube wilt modereren zonder iets te ontwikkelen;</li>
          <li>je een uitgevoerde beslissing wilt, niet alleen een score, met een geschreven uitleg;</li>
          <li>je twijfelgevallen niet zelf wilt afhandelen, maar wel elke beslissing in realtime wilt zien;</li>
          <li>je bouwstenen voor de DSA en in de EU gehoste data nodig hebt;</li>
          <li>je een team wilt dat de moderatie samen met jou inricht.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">De OpenAI Moderation API past misschien beter als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>je alleen een score per categorie nodig hebt in je eigen code;</li>
          <li>je technische team de regels, de beoordelingsinterface en het auditlogboek kan bouwen;</li>
          <li>je ook afbeeldingen moet classificeren;</li>
          <li>de nulkosten van het endpoint je belangrijkste criterium zijn.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">OpenAI Moderation API vs OpenModeration</h2>
      <p class="mt-4 text-surface-500">Informatie over de OpenAI Moderation API afkomstig uit de documentatie van OpenAI, geraadpleegd op 30 oktober 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">OpenAI Moderation API</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.them}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Een API-aanroep is nog geen moderatieproces</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Van scores naar beslissingen</h3>
          <p class="mt-2 text-sm text-surface-600">Met de score van OpenAI in handen moet je nog bepalen welke score welke actie uitlokt. OpenModeration past je regels toe: het verbergt duidelijke overtredingen, laat legitieme kritiek zichtbaar en laat de twijfelgevallen door ons team beoordelen.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Twijfelgevallen door ons team afgehandeld</h3>
          <p class="mt-2 text-sm text-surface-600">Een ja/nee-indicator laat geen ruimte voor genuanceerde reacties. Bij OpenModeration handelt ons team de twijfelgevallen af; jij ziet elke beslissing in realtime en kunt ingrijpen wanneer je wilt.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Een geschreven reden bij elke beslissing</h3>
          <p class="mt-2 text-sm text-surface-600">Elke beslissing komt met een geschreven uitleg en blijft in het activiteitenlogboek staan. Klaagt een lezer, dan weet je wat je moet antwoorden.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">De DSA vraagt meer dan een API</h3>
          <p class="mt-2 text-sm text-surface-600">De Europese Digital Services Act eist gedocumenteerde beslissingen, bezwaarmogelijkheden en transparantiecijfers. OpenModeration bevat melding en actie, motivering van beslissingen, menselijke beoordeling van betwiste beslissingen en exporteerbare cijfers.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Een AI-engine die de vooruitgang van de modellen volgt</h2>
      <p class="mt-4 text-surface-600">De API van OpenAI draait op één model, omni-moderation-latest. OpenModeration werkt met een eigen moderatie-AI, en bij gevoelige gevallen controleren andere AI-modellen de beslissingen. De engine is niet aan één model gebonden: komt er een beter of goedkoper AI-model uit, dan sluit ons team het snel aan, zonder dat jij iets hoeft te veranderen. Je moderatie gaat mee met de vooruitgang van de AI-markt, in plaats van vast te zitten aan één algoritme.</p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Prijzen: OpenAI Moderation API en OpenModeration</h2>
      <p class="mt-4 text-surface-600">Het moderatie-endpoint van OpenAI is gratis, maar de echte kosten zitten in wat je eromheen moet bouwen: regels, een beoordelingsinterface, een auditlogboek, connectoren voor je kanalen.</p>
      <p class="mt-4 text-surface-600">OpenModeration publiceert zijn prijzen: gratis tot 1.000 verzoeken per maand, Pro voor € 99 per maand voor 10.000 verzoeken en Enterprise op aanvraag voor grote volumes. Een on-premise installatie is mogelijk op aanvraag. <a href={L('/pricing')} class="font-medium text-brand-600 hover:text-brand-500">Bekijk de prijzen</a>.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Overstappen van de OpenAI Moderation API naar OpenModeration in 3 stappen</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">1. Test in sandboxmodus</h3>
          <p class="mt-2 text-sm text-surface-600">Koppel je website via de API, WordPress of je pagina's op Facebook, Instagram en YouTube. OpenModeration analyseert echte reacties zonder iets te verbergen, terwijl je huidige integratie gewoon blijft draaien.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">2. Stem af met het team van Logora</h3>
          <p class="mt-2 text-sm text-surface-600">We stemmen de moderatie af op je regels en je use cases en vergelijken de beslissingen, met de geschreven uitleg van elke beslissing erbij.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">3. Zet automatische moderatie aan</h3>
          <p class="mt-2 text-sm text-surface-600">Duidelijke overtredingen worden verborgen, twijfelgevallen worden door ons team afgehandeld en elke beslissing blijft in het activiteitenlogboek staan.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Alternatief voor OpenAI Moderation: veelgestelde vragen" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        OpenAI is een merk van de eigenaar ervan. Bronnen: <a href="https://platform.openai.com/docs/guides/moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">platform.openai.com/docs/guides/moderation</a> (geraadpleegd op 30 oktober 2026). Zie je een fout? Schrijf ons op <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Meer weten</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={L('/blog/openai-moderation-api-guide')} class="font-medium text-brand-600 hover:text-brand-500">Zo werkt de OpenAI Moderation API: categorieën, prijs en beperkingen &rarr;</a></li>
        <li><a href={L('/blog/ai-content-moderation-developer-guide')} class="font-medium text-brand-600 hover:text-brand-500">Contentmoderatie met AI: gids voor developers &rarr;</a></li>
        <li><a href={L('/moderation-software')} class="font-medium text-brand-600 hover:text-brand-500">De moderatiesoftware van OpenModeration &rarr;</a></li>
        <li><a href={L('/alternatives/azure-content-safety')} class="font-medium text-brand-600 hover:text-brand-500">Vergelijking: Azure Content Safety &rarr;</a></li>
        <li><a href={L('/alternatives/perspective-api')} class="font-medium text-brand-600 hover:text-brand-500">Vergelijking: Perspective API &rarr;</a></li>
        <li><a href={L('/alternatives')} class="font-medium text-brand-600 hover:text-brand-500">Alle vergelijkingen &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Ga verder dan een moderatiescore." subtitle="Test OpenModeration in sandboxmodus op je eigen reacties, zonder iets te verbergen. Gratis tot 1.000 verzoeken per maand." buttonText="Plan een gesprek" buttonHref={L('/book-a-call')} />
</BaseLayout>
