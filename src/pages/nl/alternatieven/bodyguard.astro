---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import SwitchProvider from '../../../components/SwitchProvider.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Bodyguard alternatief: vergelijking met OpenModeration";
const description = "Bodyguard of OpenModeration? Vergelijking met bronnen: ondersteunde netwerken, prijzen, hosting in de EU, DSA en een schriftelijke uitleg bij elke beslissing.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/bodyguard",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Aanbod", bodyguard: "Een moderatie-API voor platforms en een aanbod voor socialemediamoderatie voor merken, bureaus en overheidsorganisaties", openmod: "Eén platform: koppelingen met sociale media en WordPress, plus een REST-API en webhooks voor al het andere" },
  { feature: "Ondersteunde sociale netwerken", bodyguard: "Facebook, Instagram, TikTok, X, LinkedIn, YouTube, Twitch, Discord", openmod: "Website, Facebook, Instagram, YouTube en WordPress standaard; TikTok, X, LinkedIn en andere netwerken snel toegevoegd op verzoek" },
  { feature: "Prijs", bodyguard: "Guardian vanaf € 1.000 per maand, Sentinel vanaf € 3.000 per maand, Commander op offerte; prijs afhankelijk van de omvang van het publiek", openmod: "Openbaar: gratis tot 1.000 geanalyseerde reacties per maand, Pro voor € 99 per maand voor 10.000 reacties, Enterprise op aanvraag" },
  { feature: "Hosting van gegevens", bodyguard: "Niet vermeld op de homepage", openmod: "Ontwikkeld en gehost in de Europese Unie" },
  { feature: "AI-modellen", bodyguard: "Technologie ontwikkeld door Bodyguard", openmod: "Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden toegevoegd zodra ze uitkomen" },
  { feature: "Schriftelijke uitleg bij elke beslissing", bodyguard: "Niet vermeld", openmod: "Ja, bij elke beslissing, in de taal die je kiest" },
  { feature: "DSA", bodyguard: "Niet vermeld op de homepage", openmod: "Melding en actie, motivering, menselijke beoordeling van betwiste beslissingen, exporteerbare cijfers en een volledig activiteitenlogboek" },
  { feature: "Vermelde compliance", bodyguard: "AVG, SOC 2 Type 2", openmod: "AVG; volledig logboek van elke beslissing" },
  { feature: "Talen", bodyguard: "46 talen, volgens het bedrijf", openmod: "Uitleg in de taal die je kiest" },
];

const faqItems = [
  {
    question: "Wat is het beste alternatief voor Bodyguard?",
    answer: "Dat hangt af van wat je zoekt. Wil je gratis beginnen, gegevens in de EU en een schriftelijke uitleg bij elke verborgen reactie, dan voldoet OpenModeration aan die criteria. Moet je TikTok, X, LinkedIn of andere netwerken modereren, dan voegt OpenModeration die snel toe op verzoek.",
  },
  {
    question: "Wat kost Bodyguard in vergelijking met OpenModeration?",
    answer: "Volgens de prijspagina biedt Bodyguard een Guardian-abonnement vanaf € 1.000 per maand en een Sentinel-abonnement vanaf € 3.000 per maand, met een prijs die afhangt van de omvang van het publiek. OpenModeration is gratis tot 1.000 geanalyseerde reacties per maand, Pro kost € 99 per maand voor 10.000 reacties en Enterprise is op aanvraag.",
  },
  {
    question: "Bodyguard vs OpenModeration: wat is het verschil?",
    answer: "Bodyguard dekt meer sociale netwerken en vermeldt SOC 2 Type 2. OpenModeration kiest voor openbare prijzen met een gratis instap, hosting in de EU, een schriftelijke uitleg bij elke beslissing en DSA-bouwstenen, met een team dat de moderatie samen met je inricht volgens je regels en je use cases.",
  },
  {
    question: "Helpt OpenModeration bij het naleven van de DSA?",
    answer: "OpenModeration schrijft bij elke beslissing een uitleg en houdt een logboek bij van alle beslissingen, of ze nu door de AI of door een moderator worden genomen. Beide voeden rechtstreeks de motivering die artikel 17 van de DSA vereist.",
  },
  {
    question: "Welke AI-modellen gebruikt OpenModeration?",
    answer: "OpenModeration werkt met een eigen moderatie-AI, en in gevoelige gevallen controleren andere AI-modellen de beslissing. Komt er een beter of voordeliger model uit, dan voegt het team het snel toe, zonder dat jij iets hoeft te veranderen: je moderatie profiteert van de vooruitgang van AI-modellen.",
  },
  {
    question: "Kan ik van Bodyguard overstappen naar OpenModeration zonder opnieuw te beginnen?",
    answer: "Op Facebook, Instagram, YouTube en WordPress koppel je gewoon je accounts, en het team van Logora stemt de moderatie samen met je af op je regels en je use cases. Voor een eigen platform vervangt de REST-API van OpenModeration de aanroep naar je vorige API. In sandboxmodus test je eerst op echte reacties zonder iets te verbergen.",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Alternatieven", href: localizePath('/alternatives', locale) }, { label: "Bodyguard" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Vergelijking
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Bodyguard alternatief: vergelijking met OpenModeration</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bodyguard is een bekend Frans bedrijf in AI-moderatie. OpenModeration maakt andere keuzes: een gratis abonnement en daarna Pro voor € 99 per maand, gegevens gehost in de EU en een schriftelijke uitleg bij elke beslissing. Hieronder de verschillen, met bronnen, zodat je met kennis van zaken kiest.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/nl/afspraak-maken" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Plan een gesprek</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Gratis proberen</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Kies OpenModeration als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>je gratis wilt beginnen en daarna minder dan € 100 per maand wilt betalen;</li>
          <li>je een volledig logboek van elke moderatiebeslissing wilt;</li>
          <li>je gegevens in de Europese Unie moeten blijven;</li>
          <li>je elke verwijderde reactie moet kunnen uitleggen, zoals de DSA vereist;</li>
          <li>je een moderatie wilt die de vooruitgang van AI-modellen volgt in plaats van vast te zitten aan één algoritme.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Bodyguard past misschien beter als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>je chats op Twitch of Discord in realtime moet modereren;</li>
          <li>je inkoopafdeling een SOC 2 Type 2-certificering eist;</li>
          <li>je de voorkeur geeft aan een oplossing die volledig door één leverancier wordt beheerd.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Bodyguard en OpenModeration naast elkaar</h2>
      <p class="mt-4 text-surface-500">Informatie over Bodyguard afkomstig van de website bodyguard.ai, geraadpleegd op 20 oktober 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Bodyguard</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.bodyguard}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Wat er in de praktijk verandert</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Je weet waarom een reactie verborgen is</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration geeft bij elke beslissing een schriftelijke uitleg, realtime zichtbaar in de console en teruggegeven door de API. Zo kun je een lezer antwoorden die de beslissing betwist, en de DSA vraagt precies dat je elke verwijdering uitlegt.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Afgestemd op je regels en je use cases</h3>
          <p class="mt-2 text-sm text-surface-600">Het team van Logora richt de moderatie samen met je in. Duidelijke overtredingen worden automatisch verborgen, legitieme kritiek blijft zichtbaar en twijfelgevallen worden door ons team beoordeeld, terwijl je elke beslissing realtime in één console ziet.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Prijzen: Bodyguard vs OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-600">Bodyguard begint bij € 1.000 per maand. OpenModeration is gratis tot 1.000 geanalyseerde reacties per maand, Pro kost € 99 per maand voor 10.000 reacties en Enterprise is op aanvraag. On-premise is mogelijk op aanvraag: <a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">plan een gesprek</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Een AI die de vooruitgang van AI-modellen volgt</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration werkt met een eigen moderatie-AI, en in gevoelige gevallen controleren andere AI-modellen de beslissing. Komt er een beter of voordeliger model uit, dan voegt het team het snel toe, zonder dat jij iets hoeft te veranderen. Bodyguard werkt volgens de website met eigen technologie.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">In 3 stappen van Bodyguard naar OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">1. Test in sandboxmodus</h3>
          <p class="mt-2 text-sm text-surface-600">Koppel je website, WordPress of je Facebook-pagina's, Instagram en YouTube. OpenModeration analyseert echte reacties zonder iets te verbergen, terwijl Bodyguard blijft werken.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">2. Stel bij met het team van Logora</h3>
          <p class="mt-2 text-sm text-surface-600">We vergelijken de beslissingen met die van je huidige tool en stemmen de moderatie af op je regels en je use cases, met de schriftelijke uitleg van elke beslissing in beeld.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">3. Zet kanaal voor kanaal aan</h3>
          <p class="mt-2 text-sm text-surface-600">Je activeert de moderatie op één kanaal en daarna op de andere. Twijfelgevallen behandelt ons team. Elke beslissing komt in het activiteitenlogboek, dat je in realtime volgt.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Veelgestelde vragen" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bodyguard is een merk van de betreffende eigenaar. Bronnen: <a href="https://bodyguard.ai/fr" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">bodyguard.ai</a> en de <a href="https://www.bodyguard.ai/en/social-media/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">prijspagina</a> (geraadpleegd op 20 oktober 2026). Fout gezien? Mail ons op <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Meer weten</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/social-media-moderation', locale)} class="font-medium text-brand-600 hover:text-brand-500">Socialemediamoderatie met OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/dsa-compliance/statement-of-reasons', locale)} class="font-medium text-brand-600 hover:text-brand-500">De motivering die de DSA vereist &rarr;</a></li>
        <li><a href={localizePath('/moderation-software', locale)} class="font-medium text-brand-600 hover:text-brand-500">De moderatiesoftware van OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/alternatives', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alle vergelijkingen &rarr;</a></li>
        <li><a href={localizePath('/pricing', locale)} class="font-medium text-brand-600 hover:text-brand-500">De prijzen van OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Vergelijk je huidige moderatie met OpenModeration." subtitle="Test OpenModeration in sandboxmodus op je eigen reacties, zonder iets te verbergen. Gratis tot 1.000 geanalyseerde reacties per maand." buttonText="Plan een gesprek" buttonHref={localizePath('/book-a-call', locale)} />
</BaseLayout>
