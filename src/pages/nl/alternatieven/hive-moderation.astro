---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const migrationCode = `# Voor: Hive Moderation (direct)
const response = await fetch('https://api.thehive.ai/api/v2/task/sync', {
  method: 'POST',
  headers: { 'Authorization': 'Token YOUR_HIVE_KEY' },
  body: JSON.stringify({ url: '...', text: { text: content } })
});

# Na: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// Plus: voorfilter, dubbele drempel, automatische acties, auditlog, gecontroleerde AI`;

const title = "Hive Moderation alternatief voor reacties en sociale media";
const description = "Hive is sterk in visuele moderatie. OpenModeration draait een eigen AI voor reacties, gecontroleerd door andere modellen, met regels, review en DSA-log.";

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/hive-moderation",
  "url": "https://www.openmoderation.com/nl/alternatieven/hive-moderation",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const comparisonPoints = [
  { feature: "AI-engine", hive: "Alleen Hive (eigen, gesloten modellen)", openmod: "Onze eigen moderatie-AI, bij gevoelige gevallen gecontroleerd door andere AI-modellen" },
  { feature: "AI-modellen", hive: "Eigen modellen van Hive", openmod: "Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden toegevoegd zodra ze uitkomen" },
  { feature: "Soorten content", hive: "Tekst, afbeeldingen, video (sterk in visuele moderatie)", openmod: "Tekstmoderatie met 10 categorieën, plus je eigen categorieën in gewone taal" },
  { feature: "Voorfilter", hive: "Niet beschikbaar", openmod: "Ingebouwd woordfilter houdt duidelijke spam en verboden woorden tegen vóór elke API-call" },
  { feature: "Beslisengine", hive: "Ruwe classificatiescores", openmod: "Dubbele drempel, met de grijze zone beoordeeld door ons team" },
  { feature: "Automatische acties", hive: "Je bouwt zelf de integratie", openmod: "Ingebouwde Action Engine die verbergt, verwijdert, markeert of meldt zodra een drempel wordt overschreden" },
  { feature: "Dashboard", hive: "Eenvoudig API-dashboard", openmod: "Volledige console: elke beslissing realtime, teamrollen, analytics" },
  { feature: "API-formaat", hive: "Eigen formaat van Hive", openmod: "Gestandaardiseerd formaat. Voegen we een beter model toe, dan verandert er niets in je code" },
  { feature: "Afhankelijkheid van de leverancier", hive: "Vast aan de eigen modellen van Hive", openmod: "Laag. Engine niet gebonden aan één model: betere modellen toegevoegd zodra ze uitkomen" },
  { feature: "Hosting", hive: "Alleen een cloud-API", openmod: "Beheerde cloud in de EU; on-premise installatie mogelijk op aanvraag" },
  { feature: "Auditlog", hive: "Logs van API-verzoeken", openmod: "Volledig DSA-auditlog: elke beslissing van AI en mens vastgelegd, exporteerbare rapporten" },
  { feature: "Prijs", hive: "Op basis van gebruik, prijs op aanvraag", openmod: "Gratis tot 1.000 geanalyseerde reacties per maand. Beheerde cloud vanaf € 99 per maand (10.000 reacties inbegrepen)" },
];

const reasons = [
  {
    title: "Hive is vooral bekend om visuele moderatie, terwijl de hoeveelheid tekst blijft groeien",
    description: "Hive staat bekend om moderatie van afbeeldingen en video. LLM's en chatbots produceren nu tekst op een schaal die geen team met de hand kan lezen, dus tekst verdient dezelfde zorg als beeld. OpenModeration richt zich op tekst, met een eigen moderatie-AI die bij gevoelige gevallen door andere AI-modellen wordt gecontroleerd."
  },
  {
    title: "Eén bevroren model betekent geen second opinion",
    description: "Met één gesloten model hangt elke beslissing af van één classifier, die tussen twee updates stilstaat. Bij OpenModeration beoordelen andere AI-modellen de gevoelige gevallen, en betere of goedkopere modellen worden toegevoegd zodra ze uitkomen, zonder dat jij iets hoeft te veranderen."
  },
  {
    title: "Gesloten modellen bieden weinig transparantie",
    description: "De modellen van Hive zijn black boxes. Je kunt ze niet auditen, niet bijstellen en hun trainingsdata niet inzien. OpenModeration legt elke beslissing schriftelijk uit, zodat je ziet waarom elke reactie bleef staan of werd verborgen."
  },
  {
    title: "DSA-naleving vraagt meer dan API-scores",
    description: "De Europese Digital Services Act vraagt om gedocumenteerde moderatiebeslissingen, menselijke beoordeling en transparantieverslagen. Logs op API-niveau dekken dat niet. OpenModeration geeft je auditlogs, menselijke beoordeling door ons team en exporteerbare rapporten."
  },
];

const faqItems = [
  {
    question: "Wat is het beste alternatief voor Hive Moderation?",
    answer: "Voor tekstmoderatie van reacties en sociale media is OpenModeration een alternatief: een eigen moderatie-AI gecontroleerd door andere AI-modellen, automatische regels, menselijke beoordeling door ons team en DSA-naleving ingebouwd. Moet je vooral afbeeldingen en video modereren, dan is Hive daar sterk in."
  },
  {
    question: "Wat kost Hive Moderation?",
    answer: "Hive rekent op basis van gebruik, met een prijs op aanvraag. OpenModeration is gratis tot 1.000 geanalyseerde reacties per maand; de beheerde cloud begint bij € 99 per maand met 10.000 reacties inbegrepen, Enterprise op aanvraag."
  },
  {
    question: "Hive vs OpenModeration: wat is het verschil?",
    answer: "Hive levert classificatiescores van zijn eigen modellen, met sterke visuele moderatie. OpenModeration richt zich op tekst en levert de hele workflow: voorfilter, dubbele drempel, automatische acties, een console met elke beslissing realtime en een volledig DSA-auditlog."
  },
  {
    question: "Welke AI-modellen gebruikt OpenModeration?",
    answer: "OpenModeration werkt met een eigen moderatie-AI, en bij gevoelige gevallen controleren andere AI-modellen die beslissing. Komt er een beter of goedkoper model uit, dan voegt het team dat snel toe, en het API-formaat blijft hetzelfde."
  },
  {
    question: "Waar worden mijn gegevens gehost?",
    answer: "OpenModeration draait in een beheerde cloud in de EU, en een on-premise installatie is mogelijk op aanvraag."
  }
];
---

<BaseLayout title={title} description={description} jsonLd={comparisonJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: L('/') }, { label: "Alternatieven", href: L('/alternatives') }, { label: "Hive Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1.5 text-sm font-medium text-amber-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Hive Moderation alternatief
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Hive is sterk in visuele content.<br/>Voor tekstmoderatie heb je een platform nodig.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Hive Moderation is erg goed in het classificeren van afbeeldingen en video. Tekst is een ander verhaal: die komt nu
        van LLM's en chatbots, naast fora en reactiesecties. OpenModeration geeft je een eigen moderatie-AI,
        gecontroleerd door andere AI-modellen, met automatische regels, menselijke beoordeling door ons team en DSA-naleving ingebouwd.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/nl/afspraak-maken" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Plan een gesprek</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Gratis proberen</a>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Waarom teams verder kijken dan alleen Hive</h2>
        <p class="mt-4 text-lg text-surface-500">Hive is een capabele moderatie-engine. Tekst modereren in productie vraagt meer dan één model en meer dan ruwe scores.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Eén API, een AI die steeds beter wordt
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Een AI die de vooruitgang van AI-modellen volgt</h2>
          <p class="mt-4 text-lg text-surface-500">
            Hive gebruiken voor visuele moderatie en een aparte API voor tekst betekent twee integraties om te onderhouden.
            Voor tekst geeft OpenModeration je één gestandaardiseerd API-formaat, aangedreven door een eigen moderatie-AI.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Gevoelige gevallen worden door andere AI-modellen gecontroleerd voordat een beslissing wordt toegepast.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Komt er een beter of goedkoper model uit, dan voegen wij het toe. Aan jouw kant verandert er niets.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600">Elke beslissing krijgt een schriftelijke reden, en je ziet die realtime.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Hive Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Hive is een sterke moderatieleverancier. OpenModeration is een compleet platform voor reactiemoderatie.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Hive Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.hive}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-8 text-center text-surface-600">Prijzen: Hive rekent op basis van gebruik, met een prijs op aanvraag; OpenModeration is gratis tot 1.000 geanalyseerde reacties per maand en Pro kost € 99 per maand. <a href={L('/pricing')} class="font-medium text-brand-600 hover:text-brand-500">Bekijk de prijzen</a> of <a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">plan een gesprek</a>.</p>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Hive Moderation alternatief: veelgestelde vragen" />
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Vergelijk andere alternatieven</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={L('/alternatives/openai-moderation')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href={L('/alternatives/azure-content-safety')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href={L('/alternatives/mistral-moderation')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href={L('/alternatives/perspective-api')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href={L('/alternatives/checkstep')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
        <a href={L('/alternatives')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Alle vergelijkingen</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection
    title="Reactiemoderatie met een AI die steeds beter wordt."
    subtitle="Onze eigen gecontroleerde AI en menselijke beoordeling door ons team, via één gestandaardiseerde API. OpenModeration wordt in de EU gehost, legt elke beslissing uit en is klaar voor de DSA."
    buttonText="Probeer OpenModeration gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
