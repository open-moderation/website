---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Digitaller alternatief: vergelijking met OpenModeration";
const description = "Digitaller of OpenModeration? Uitbestede dienst tegenover automatische moderatie die je realtime volgt: openbare prijzen en een reden bij elk besluit.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/digitaller",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Soort aanbod", digitaller: "Beheerde moderatiedienst, plus community management (bureau van Grupo Raíz Digital)", openmod: "Automatische moderatie die je regels toepast; ons team behandelt de twijfelgevallen en jij ziet alles realtime" },
  { feature: "Hoe er wordt beslist", digitaller: "Een semantisch AI-filter en, waar nodig, een menselijk team van Digitaller", openmod: "De AI past je regels toe met een drempel per categorie; de grijze zone behandelt ons team" },
  { feature: "Regels", digitaller: "Afgestemd op elke klant, met moderatie vooraf of achteraf", openmod: "Je moderatiebeleid in gewone taal, altijd aan te passen, met voorstellen voor bijstelling op basis van eerdere beslissingen" },
  { feature: "Waar het modereert", digitaller: "Digitale kranten, blogs, bedrijfswebsites, advertentiesites en ‘sociale netwerken’ (zonder te zeggen welke)", openmod: "Facebook, Instagram, YouTube en WordPress standaard; TikTok, X, LinkedIn en andere netwerken snel op verzoek; REST-API voor de rest" },
  { feature: "Prijs", digitaller: "Geen tarieven gepubliceerd", openmod: "Openbaar: gratis tot 1.000 verzoeken per maand, Pro voor € 99 per maand voor 10.000 verzoeken, maatwerk voor grote volumes" },
  { feature: "Context", digitaller: "Niet vermeld", openmod: "De AI leest elke reactie samen met de kop en de discussiedraad" },
  { feature: "AI-modellen", digitaller: "Niet vermeld op de website (spreekt van een semantisch AI-filter)", openmod: "Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden toegevoegd zodra ze uitkomen" },
  { feature: "Reden bij elke beslissing", digitaller: "Niet vermeld", openmod: "Een schriftelijke reden bij elke beslissing, in de taal van je keuze, teruggegeven door de API" },
  { feature: "Logboek voor de DSA", digitaller: "Niet vermeld", openmod: "Activiteitenlogboek: bij elke beslissing staat of die automatisch was of welke moderator hem nam" },
  { feature: "Hosting", digitaller: "Niet vermeld (de cookiemelding noemt de AVG en de Spaanse privacywet LOPD)", openmod: "Ontwikkeld en gehost in de EU; on-premise mogelijk op aanvraag" },
  { feature: "Referenties", digitaller: "De regionale kranten van Prensa Ibérica (La Nueva España, Levante, Faro de Vigo, Diario de Mallorca en andere), El Español en advertentiesites van Schibsted", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "Wat is het beste Digitaller alternatief?",
    answer: "Dat hangt af van wie er modereert. Zoek je een beheerde dienst met externe moderators en community management, dan biedt Digitaller dat. Wil je je pagina's gewoon koppelen en de rest aan ons overlaten, terwijl je redactie de regels in handen houdt, bij elke beslissing de reden ziet en een gepubliceerde prijs betaalt, dan is OpenModeration daarvoor gemaakt.",
  },
  {
    question: "Wat kost Digitaller?",
    answer: "Digitaller publiceert geen tarieven op zijn website. OpenModeration wel: gratis tot 1.000 verzoeken per maand, Pro voor € 99 per maand voor 10.000 verzoeken en maatwerk voor grote volumes.",
  },
  {
    question: "Digitaller vs OpenModeration: wat is het verschil?",
    answer: "Digitaller is een dienst: een AI-filter en een menselijk team van Digitaller modereren je reacties voor je. Bij OpenModeration bepaalt je redactie de regels, past de AI ze toe met de context van elk artikel en behandelt ons team de twijfelgevallen. Elke beslissing krijgt een schriftelijke reden in het activiteitenlogboek, dat je realtime volgt.",
  },
  {
    question: "Kan ik OpenModeration testen zonder Digitaller op te zeggen?",
    answer: "Ja. In sandboxmodus analyseert OpenModeration de echte reacties op je website of je social-mediapagina's en laat zien wat het zou hebben besloten, zonder iets te verbergen of te verwijderen. Je vergelijkt parallel met je huidige dienst en beslist daarna.",
  },
  {
    question: "Welke opties heeft een regionale krant om lezersreacties te modereren?",
    answer: "Twee routes. De moderatie uitbesteden aan een bedrijf als Digitaller, dat naar eigen zeggen al 20 jaar de belangrijkste lokale digitale kranten van Spanje modereert. Of OpenModeration gebruiken: de AI past het beleid van de krant toe, ons team behandelt de twijfelgevallen en de redactie ziet elke beslissing realtime en kan op elk moment ingrijpen.",
  },
  {
    question: "Levert OpenModeration menselijke moderators?",
    answer: "Ja, voor de twijfelgevallen. De automatisering doet het meeste werk, en twijfelgevallen, meldingen van gebruikers en betwiste beslissingen behandelt ons team. Ons team stelt ook samen met jou het moderatiebeleid op, op basis van je regels en echte reacties, en verfijnt het in de eerste weken. Je redactie hoeft niets te doen, maar ziet elke beslissing realtime en kan op elk moment ingrijpen.",
  },
  {
    question: "Welke AI-modellen gebruikt OpenModeration?",
    answer: "OpenModeration werkt met een eigen moderatie-AI, en in gevoelige gevallen wordt de beslissing gecontroleerd door andere AI-modellen. Komt er een beter of goedkoper model uit, dan voegt het team het snel toe, zonder dat jij iets hoeft aan te passen.",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Alternatieven", href: localizePath('/alternatives', locale) }, { label: "Digitaller" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Vergelijking
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Digitaller alternatief: je redactie houdt de regels, wij doen de rest</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Digitaller, een bureau van Grupo Raíz Digital, modereert reacties voor veel Spaanse regionale kranten met een AI-filter en een menselijk team. Bij OpenModeration schrijft je redactie de regels, past de AI ze toe met de context van elk artikel en behandelt ons team de twijfelgevallen. Elke beslissing komt met een schriftelijke reden die je realtime ziet.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Kies OpenModeration als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>je je pagina's gewoon wilt koppelen, terwijl je redactie de regels zelf beheert en aanpast;</li>
          <li>je de prijs wilt kennen voordat je een offerte aanvraagt;</li>
          <li>je elke verwijderde reactie moet motiveren, zoals de DSA vereist;</li>
          <li>je wilt weten welke netwerken worden gemodereerd: Facebook, Instagram, YouTube en WordPress standaard, TikTok, X, LinkedIn en andere snel op verzoek;</li>
          <li>je een volledig activiteitenlogboek wilt en je data wilt kunnen exporteren.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Digitaller past misschien beter als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>je wilt dat een extern menselijk team alle reacties met de hand beoordeelt;</li>
          <li>je ook een dienst voor community management zoekt;</li>
          <li>je een leverancier wilt die al voor veel Spaanse regionale kranten werkt.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Digitaller en OpenModeration naast elkaar</h2>
      <p class="mt-4 text-surface-500">Informatie over Digitaller afkomstig van de eigen website, raiz.es, geraadpleegd op 20 oktober 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Digitaller</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.digitaller}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Wat er in de praktijk echt verandert</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">De context van het artikel telt mee</h3>
          <p class="mt-2 text-sm text-surface-600">Dezelfde reactie weegt anders onder een sportverslag dan onder een misdaadbericht. OpenModeration geeft de AI de kop en de discussiedraad mee, zodat ironie en verhulde aanvallen herkend worden.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Je weet waarom elke reactie verborgen is</h3>
          <p class="mt-2 text-sm text-surface-600">Elke beslissing komt met een schriftelijke reden, en het activiteitenlogboek laat zien of de AI of welke moderator hem nam. Dat is de basis voor de motivering die de DSA vraagt.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Een gepubliceerde prijs</h3>
          <p class="mt-2 text-sm text-surface-600">Je begint gratis en weet wat je betaalt als het volume groeit. Heb je een on-premise installatie nodig, dan kan dat op aanvraag: <a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">laten we praten</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Testen zonder risico</h3>
          <p class="mt-2 text-sm text-surface-600">In sandboxmodus analyseert OpenModeration je echte reacties zonder iets te doen. Je vergelijkt de beslissingen met die van je huidige dienst voordat je iets verandert.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900">Een AI die de vooruitgang van AI-modellen volgt</h2>
      <p class="mt-4 text-surface-600">OpenModeration werkt met een eigen moderatie-AI, waarvan de beslissingen in gevoelige gevallen door andere AI-modellen worden gecontroleerd. Komt er een beter of goedkoper model uit, dan voegt ons team het snel toe, zonder dat jij iets hoeft aan te passen. Zo volgt je moderatie de vooruitgang van de AI-markt in plaats van vast te zitten aan één algoritme. Digitaller spreekt op zijn website van een semantisch AI-filter, zonder het model te noemen.</p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Veelgestelde vragen" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Digitaller is een merk van de betreffende eigenaar. Bronnen: <a href="https://raiz.es/es/servicios/moderacion-de-los-contenidos/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">raiz.es</a> (geraadpleegd op 20 oktober 2026). Fout gezien? Mail ons op <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Meer weten</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/use-cases/news-publishers', locale)} class="font-medium text-brand-600 hover:text-brand-500">Reactiemoderatie voor nieuwsmedia &rarr;</a></li>
        <li><a href={localizePath('/alternatives/interactora', locale)} class="font-medium text-brand-600 hover:text-brand-500">OpenModeration of Interactora: de vergelijking &rarr;</a></li>
        <li><a href={localizePath('/integrations/wordpress', locale)} class="font-medium text-brand-600 hover:text-brand-500">WordPress-reacties modereren &rarr;</a></li>
        <li><a href={localizePath('/alternatives', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alle vergelijkingen &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Vergelijk je huidige moderatie met OpenModeration." subtitle="Test OpenModeration in sandboxmodus op je eigen reacties, zonder iets te verbergen. Gratis tot 1.000 verzoeken per maand." buttonText="Plan een gesprek" buttonHref={localizePath('/book-a-call', locale)} />
</BaseLayout>
