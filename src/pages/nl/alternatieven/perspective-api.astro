---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const L = (p: string) => localizePath(p, locale);

const migrationCode = `# Voor: Perspective API
const result = await fetch('https://commentanalyzer.googleapis.com/v1alpha1/comments:analyze', ...)

# Na: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
})`;

const title = "Perspective API alternatief: stap over vóór eind 2026";
const description = "Google stopt eind 2026 met de Perspective API. Stap over naar OpenModeration: een eigen moderatie-AI, hosting in de EU en een reden bij elke beslissing.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/perspective-api",
  "url": "https://www.openmoderation.com/nl/alternatieven/perspective-api",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": {
    "@type": "SoftwareApplication",
    "name": "OpenModeration",
    "applicationCategory": "ContentModeration",
    "operatingSystem": "Cross-platform"
  }
};
---

<BaseLayout title={title} description={description} {jsonLd}>
  <Breadcrumb items={[{ label: "Home", href: L('/') }, { label: "Alternatieven", href: L('/alternatives') }, { label: "Alternatief voor Perspective API" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-4 py-1.5 text-sm font-medium text-red-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        De Perspective API stopt eind 2026
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">De Perspective API van Google stopt in 2026. Dit is je alternatief.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Google heeft aangekondigd dat de Perspective API eind 2026 stopt. Duizenden fora en community's hebben een vervanger nodig.
        OpenModeration is een alternatief dat je snel koppelt, elke beslissing schriftelijk uitlegt en niet vastzit aan één AI-model.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Waarom dit belangrijk is</h2>
          <p class="mt-4 text-lg text-surface-500">
            De Perspective API detecteert toxiciteit voor duizenden uitgevers, fora en reactiesecties van media.
            Nu Google heeft aangekondigd dat de dienst eind 2026 stopt, moet elk platform dat Perspective gebruikt een vervanger vinden.
          </p>
          <div class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Fora die op Perspective draaien, moeten overstappen</h3>
                <p class="mt-1 text-sm text-surface-500">Na 2026 reageren aanroepen naar de Perspective API niet meer. Je moderatie valt stil als je geen vervanger klaar hebt staan.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">De DSA maakt het urgenter</h3>
                <p class="mt-1 text-sm text-surface-500">De Europese digitaledienstenverordening (DSA) eist dat je elke moderatiebeslissing uitlegt en bezwaren afhandelt. Wachten tot 2026 is geen optie.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h4 class="mb-2 text-sm font-semibold text-surface-900">Snel overstappen: voor en na</h4>
          <CodeBlock code={migrationCode} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Zo vervangt OpenModeration de Perspective API</h2>
        <p class="mt-4 text-lg text-surface-500">Eén API, een moderatie-AI die de vooruitgang van de modellen volgt en een team dat het samen met jou inricht.</p>
      </div>
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Een eigen moderatie-AI</h3>
          <p class="mt-2 text-sm text-surface-500">OpenModeration werkt met een eigen moderatie-AI, afgestemd op je regels en je use cases, in plaats van een algemene toxiciteitsscore.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-100 text-accent-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Gecontroleerd door andere AI-modellen</h3>
          <p class="mt-2 text-sm text-surface-500">Bij gevoelige gevallen controleren andere AI-modellen de beslissing. Wat daarna nog twijfelachtig is, gaat naar menselijke beoordeling in één console.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-100 text-purple-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Nieuwe modellen aangesloten zodra ze uitkomen</h3>
          <p class="mt-2 text-sm text-surface-500">Komt er een beter of goedkoper AI-model uit, dan sluit het team het snel aan, zonder dat jij iets hoeft te veranderen. Je moderatie gaat mee met de vooruitgang van de AI-markt.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 text-cyan-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Een stabiele API</h3>
          <p class="mt-2 text-sm text-surface-500">Je roept altijd hetzelfde endpoint POST /v1/moderation aan. Veranderen de modellen erachter, dan blijft je integratie gelijk.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perspective API vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Beide opties vergeleken op de functies die er het meest toe doen.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Functie</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Perspective API</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Prijzen</td>
              <td class="px-6 py-4 text-surface-500">Gratis, met quota voor verzoeken</td>
              <td class="px-6 py-4 text-surface-900">Gratis tot 1.000 verzoeken/maand, Pro € 99/maand voor 10.000 verzoeken, Enterprise op aanvraag</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Talen</td>
              <td class="px-6 py-4 text-surface-500">Ongeveer 20 talen, met wisselende nauwkeurigheid</td>
              <td class="px-6 py-4 text-surface-900">Samen met jou bepaald tijdens de inrichting</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Moderatiecategorieën</td>
              <td class="px-6 py-4 text-surface-500">9 vaste categorieën</td>
              <td class="px-6 py-4 text-surface-900">10 categorieën, volledig aan te passen aan je regels en je use cases</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">AI-modellen</td>
              <td class="px-6 py-4 text-surface-500">Eigen model van Google, dat wordt uitgefaseerd</td>
              <td class="px-6 py-4 text-surface-900">Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden aangesloten zodra ze uitkomen</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Afhankelijkheid van de leverancier</td>
              <td class="px-6 py-4 text-surface-500">Hoog (afhankelijk van Google)</td>
              <td class="px-6 py-4 text-surface-900">Laag: de moderatie zit niet vast aan één AI-model</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">DSA-auditlogboek</td>
              <td class="px-6 py-4 text-surface-500">Niet beschikbaar</td>
              <td class="px-6 py-4 text-surface-900">Geschreven uitleg bij elke beslissing, activiteitenlogboek en export ingebouwd</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Hosting</td>
              <td class="px-6 py-4 text-surface-500">Infrastructuur van Google</td>
              <td class="px-6 py-4 text-surface-900">Gehost in de EU, AVG-conform</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Status</td>
              <td class="px-6 py-4 text-surface-500">Stopt eind 2026</td>
              <td class="px-6 py-4 text-surface-900">Actief onderhouden door het team van Logora</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-8 text-center text-surface-600">Wil je de overstap voorbereiden met ons team? <a href={L('/book-a-call')} class="font-medium text-brand-600 hover:text-brand-500">Plan een gesprek</a> of bekijk <a href={L('/moderation-software')} class="font-medium text-brand-600 hover:text-brand-500">de moderatiesoftware van OpenModeration</a>.</p>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Wacht niet tot het einde" subtitle="Stap nu over van de Perspective API. Begin gratis in de cloud, met je data gehost in de EU." buttonText="Gratis proberen" buttonHref="https://app.openmoderation.com/signup" />

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Vergelijk andere oplossingen</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={L('/alternatives/openai-moderation')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href={L('/alternatives/azure-content-safety')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href={L('/alternatives/mistral-moderation')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href={L('/alternatives/hive-moderation')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href={L('/alternatives/checkstep')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
        <a href={L('/alternatives')} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Alle vergelijkingen</a>
      </div>
    </div>
  </section>
</BaseLayout>
