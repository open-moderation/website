---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Sightengine alternatief: vergelijking met OpenModeration";
const description = "Sightengine of OpenModeration? Vergelijking met bronnen: beelden of reacties, talen, menselijke beoordeling, DSA, hosting in de EU, AI en publieke prijzen.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/sightengine",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  {
    "feature": "Aanbod",
    "competitor": "API voor moderatie en analyse van beelden: afbeeldingen, video, tekst, audio, detectie van door AI gegenereerde content, identiteitscontrole",
    "openmod": "AI-moderatie van reacties voor media, merken en overheidsinstanties, samen met jou opgezet door het team van Logora"
  },
  {
    "feature": "Gemodereerde content",
    "competitor": "Afbeeldingen (meer dan 150 klassen), video en livestreams, tekst, audio. Tekstmodellen op basis van machine learning in 7 talen (en, fr, it, pt, es, ru, tr), regelgebaseerd filter in 18",
    "openmod": "Reacties op je websites en sociale pagina's"
  },
  {
    "feature": "Integraties",
    "competitor": "REST-API; regels en workflows ingesteld in het dashboard. Geen connectoren voor sociale media of WordPress op de geraadpleegde pagina's",
    "openmod": "API voor websites, Facebook-pagina's, professionele Instagram-accounts, YouTube-kanalen, WordPress"
  },
  {
    "feature": "AI-modellen",
    "competitor": "Eigen modellen: „state-of-the-art modellen en eigen technologie”, maatwerkmodellen in Enterprise",
    "openmod": "Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden aangesloten zodra ze uitkomen"
  },
  {
    "feature": "Menselijke beoordeling",
    "competitor": "Optionele hybride modus: drempels sturen content naar „je platform voor menselijke moderatie”, beoordeeld door je eigen team",
    "openmod": "Duidelijke overtredingen automatisch verborgen, twijfelgevallen afgehandeld door ons team; jij ziet alles in één console"
  },
  {
    "feature": "Uitleg bij beslissingen",
    "competitor": "Een label dat het soort gevonden content beschrijft, met scores per categorie",
    "openmod": "Een geschreven uitleg bij elke beslissing en een volledig activiteitenlogboek"
  },
  {
    "feature": "DSA",
    "competitor": "Niet vermeld op de website",
    "openmod": "Melding en actie, motivering van beslissingen, menselijke beoordeling van betwiste beslissingen, exporteerbare cijfers"
  },
  {
    "feature": "Hosting en data",
    "competitor": "Bedrijf gevestigd in Parijs; „datacenters in tal van landen”; regionale endpoints niet inbegrepen in Free, Starter en Pro",
    "openmod": "Gehost in de Europese Unie, AVG; on-premise installatie op aanvraag"
  },
  {
    "feature": "Publieke prijzen",
    "competitor": "Gratis (2.000 operaties/maand), Starter $ 29/maand (10.000), Pro $ 99/maand (40.000), Enterprise op maat",
    "openmod": "Gratis tot 1.000 verzoeken/maand, Pro € 99/maand voor 10.000 verzoeken, Enterprise op maat"
  },
  {
    "feature": "Referenties",
    "competitor": "Klantlogo's zonder namen; genoemde partners zoals NVIDIA, PubNub, Tremau en Checkstep",
    "openmod": "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora"
  }
];

const faqItems = [
  {
    "question": "Wat is het beste alternatief voor Sightengine?",
    "answer": "Voor het modereren van reacties bij media, merkpagina's en publieke kanalen is OpenModeration voor precies dat gebruik gemaakt: connectoren voor sociale media en WordPress, een beoordelingsconsole, een geschreven uitleg bij elke beslissing, bouwstenen voor de DSA en hosting in de EU. Voor afbeeldingen, video, deepfakes of leeftijdsschatting blijft Sightengine een gespecialiseerde keuze."
  },
  {
    "question": "Wat kost Sightengine?",
    "answer": "Volgens de prijspagina: gratis tot 2.000 operaties per maand, Starter voor $ 29 per maand voor 10.000 operaties, Pro voor $ 99 per maand voor 40.000, $ 0,002 per extra operatie en Enterprise op maat. OpenModeration is gratis tot 1.000 verzoeken per maand en kost daarna € 99 per maand voor 10.000 verzoeken."
  },
  {
    "question": "Sightengine vs OpenModeration: wat is het verschil?",
    "answer": "Sightengine is een API voor developers, vooral sterk in visuele content, die labels en scores teruggeeft. OpenModeration is een dienst voor het modereren van reacties: het koppelt aan je website en je sociale pagina's, grijpt in op reacties, laat twijfelgevallen door ons team afhandelen en legt elke beslissing schriftelijk uit."
  },
  {
    "question": "Kan ik OpenModeration testen zonder Sightengine uit te zetten?",
    "answer": "Ja. In sandboxmodus analyseert OpenModeration je echte reacties zonder iets te verbergen. Sightengine blijft gewoon draaien en je vergelijkt beide reeksen beslissingen op dezelfde reacties, elke beslissing van OpenModeration met een geschreven uitleg."
  },
  {
    "question": "Welke AI gebruikt OpenModeration?",
    "answer": "OpenModeration werkt met een eigen moderatie-AI, en bij gevoelige gevallen controleren andere AI-modellen de beslissingen. Komt er een beter of goedkoper model uit, dan sluit ons team het aan zonder dat jij iets hoeft te veranderen: je profiteert van de vooruitgang van AI-modellen."
  },
  {
    "question": "Modereert Sightengine reacties in het Nederlands?",
    "answer": "Volgens de veelgestelde vragen van Sightengine dekken de tekstmodellen op basis van machine learning 7 talen (Engels, Frans, Italiaans, Portugees, Spaans, Russisch en Turks); Nederlands staat daar niet tussen. Het regelgebaseerde filter dekt 18 talen. Connectoren voor Facebook, Instagram, YouTube of WordPress en een eigen beoordelingsconsole zitten er volgens de geraadpleegde pagina's niet bij."
  }
];
---

<BaseLayout title={title} description={description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Alternatieven", href: localizePath('/alternatives', locale) }, { label: "Sightengine" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Vergelijking
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternatief voor Sightengine: OpenModeration naast elkaar gezet</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Het beste alternatief voor Sightengine hangt af van wat je modereert: voor afbeeldingen, video en identiteitscontrole is Sightengine gemaakt; voor reacties bij media, op merkpagina's en op publieke kanalen is dat OpenModeration. OpenModeration verbergt duidelijke overtredingen, laat twijfelgevallen door ons team afhandelen en geeft een geschreven uitleg bij elke beslissing, met een team van Logora dat het samen met jou opzet.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={localizePath('/book-a-call', locale)} class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Plan een gesprek</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Bekijk de vergelijking</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Voor wie is Sightengine?</h2>
      <p class="mt-4 text-surface-600">Volgens de website is Sightengine een API uit Parijs die ongewenste content herkent in afbeeldingen, video's, livestreams, tekst en audio, plus door AI gegenereerde beelden, deepfakes en identiteitssignalen zoals leeftijdsschatting. Het richt zich op developers van platforms die content van gebruikers ontvangen: marktplaatsen, datingapps, games, foto- en creatorplatforms. Je bouwt het in je code in en krijgt labels en scores per categorie terug.</p>
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Kies OpenModeration als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>je reacties modereert van een mediabedrijf, merkpagina's of publieke kanalen, geen geüploade afbeeldingen;</li>
          <li>je Facebook, Instagram, YouTube en WordPress wilt koppelen zonder ontwikkelwerk;</li>
          <li>je een console voor menselijke beoordeling en een geschreven uitleg bij elke verborgen reactie nodig hebt;</li>
          <li>je bouwstenen voor de DSA en hosting in de EU nodig hebt;</li>
          <li>je een team wilt dat de moderatie afstemt op je regels en je use cases.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Sightengine past misschien beter als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>afbeeldingen, video's en livestreams je grootste risico zijn;</li>
          <li>je door AI gegenereerde beelden of deepfakes moet herkennen, of leeftijd moet schatten;</li>
          <li>je developers een kale API willen en de workflow en beoordelingstools zelf bouwen.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Sightengine en OpenModeration naast elkaar</h2>
      <p class="mt-4 text-surface-500">Informatie over Sightengine afkomstig van de website sightengine.com, geraadpleegd op 30 oktober 2026. Prijzen exclusief btw.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Sightengine</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Een AI-engine die de vooruitgang van de modellen volgt</h2>
      <p class="mt-4 text-surface-600">Sightengine zegt te werken met „state-of-the-art modellen en eigen technologie”, met maatwerkmodellen en -klassen in het Enterprise-abonnement. Volgens de veelgestelde vragen dekken de tekstmodellen op basis van machine learning 7 talen.</p>
      <p class="mt-4 text-surface-600">OpenModeration werkt met een eigen moderatie-AI, en bij gevoelige gevallen controleren andere AI-modellen de beslissingen. De engine is niet aan één model gebonden: komt er een beter of goedkoper model uit, dan sluit ons team het snel aan, zonder dat jij iets hoeft te veranderen. Zo gaat je moderatie mee met de vooruitgang van de AI-markt, in plaats van vast te zitten aan één eigen algoritme.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Prijs van Sightengine en prijs van OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Sightengine</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-600">
          <li>Gratis: 2.000 operaties per maand, maximaal 500 per dag</li>
          <li>Starter: $ 29 per maand voor 10.000 operaties</li>
          <li>Pro: $ 99 per maand voor 40.000 operaties</li>
          <li>Extra operatie: $ 0,002</li>
          <li>Enterprise: op maat</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6">
          <h3 class="font-semibold text-brand-700">OpenModeration</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-700">
          <li>Gratis: tot 1.000 verzoeken per maand</li>
          <li>Pro: € 99 per maand voor 10.000 verzoeken</li>
          <li>Enterprise: op maat, voor grote volumes</li>
          <li>On-premise installatie: alleen op aanvraag</li>
          </ul>
        </div>
      </div>
      <p class="mt-6 text-sm text-surface-500">Sightengine telt operaties en OpenModeration verzoeken: vergelijk met je eigen volumes. Een abonnement van Sightengine dekt ook afbeeldingen en video, terwijl de prijs van OpenModeration de beoordelingsconsole, de connectoren en de begeleiding door het team van Logora omvat.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Overstappen van Sightengine naar OpenModeration in 3 stappen</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">1</div>
          <h3 class="mt-4 font-semibold text-surface-900">Zet de sandboxmodus aan naast Sightengine</h3>
          <p class="mt-2 text-sm text-surface-600">Koppel je website of je sociale pagina's. OpenModeration analyseert je echte reacties zonder iets te verbergen, terwijl Sightengine gewoon blijft draaien.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">2</div>
          <h3 class="mt-4 font-semibold text-surface-900">Stem de regels af met ons team</h3>
          <p class="mt-2 text-sm text-surface-600">Het team van Logora stemt de moderatie af op je regels en je use cases. Je vergelijkt de beslissingen, en de geschreven uitleg erbij, reactie per reactie.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">3</div>
          <h3 class="mt-4 font-semibold text-surface-900">Zet de automatische acties aan</h3>
          <p class="mt-2 text-sm text-surface-600">Overtuigen de resultaten je, dan worden duidelijke overtredingen automatisch verborgen en worden twijfelgevallen door ons team afgehandeld; jij volgt alles in de console.</p>
        </div>
      </div>
      <div class="mt-8">
        <a href={localizePath('/book-a-call', locale)} class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Plan een gesprek</a>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Veelgestelde vragen" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Sightengine is een merk van de eigenaar ervan. De informatie komt van de website (geraadpleegd op 30 oktober 2026). Zie je een fout? Schrijf ons op <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-center text-xs text-surface-400">
        Bronnen: <a href="https://sightengine.com/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/pricing</a> · <a href="https://sightengine.com/about" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/about</a> · <a href="https://sightengine.com/text-moderation-api" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/text-moderation-api</a> · <a href="https://sightengine.com/faq/languages-for-text-moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/faq/languages-for-text-moderation</a> · <a href="https://sightengine.com/faq/automated-vs-hybrid-moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">sightengine.com/faq/automated-vs-hybrid-moderation</a>
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Meer weten</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/moderation-software', locale)} class="font-medium text-brand-600 hover:text-brand-500">De moderatiesoftware van OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/use-cases/news-publishers', locale)} class="font-medium text-brand-600 hover:text-brand-500">Moderatie van reacties voor media &rarr;</a></li>
        <li><a href={localizePath('/blog/comment-moderation-guide', locale)} class="font-medium text-brand-600 hover:text-brand-500">De gids voor het modereren van reacties &rarr;</a></li>
        <li><a href={localizePath('/blog/ai-content-moderation-developer-guide', locale)} class="font-medium text-brand-600 hover:text-brand-500">Contentmoderatie met AI: gids voor developers &rarr;</a></li>
        <li><a href={localizePath('/pricing', locale)} class="font-medium text-brand-600 hover:text-brand-500">De prijzen van OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/alternatives', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alle vergelijkingen &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Modereer je reacties, niet alleen je afbeeldingen." subtitle="Plan een gesprek: we bekijken je regels en je use cases en starten daarna de sandbox op je echte reacties, naast Sightengine." buttonText="Plan een gesprek" buttonHref={localizePath('/book-a-call', locale)} />
</BaseLayout>
