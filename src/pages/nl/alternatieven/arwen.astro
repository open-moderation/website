---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Arwen alternatief: vergelijking met OpenModeration";
const description = "Arwen of OpenModeration? Vergelijking met bronnen: ondersteunde netwerken, reacties op je website, openbare prijzen, EU-hosting en een reden per beslissing.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/arwen",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  {
    "feature": "Wat het biedt",
    "them": "AI-moderatie van reacties op sociale media voor merken, sport en media (Signals, Engage, Moderate, Protect)",
    "openmod": "AI-moderatie van reacties voor media, merken en instellingen, met het team van Logora ingericht volgens je regels en je use cases"
  },
  {
    "feature": "Kanalen",
    "them": "Facebook, Instagram, X, TikTok en YouTube; Reddit 'binnenkort'; advertenties op Meta en TikTok",
    "openmod": "Website, Facebook, Instagram, YouTube en WordPress standaard; TikTok, X, LinkedIn en andere netwerken snel toegevoegd op verzoek"
  },
  {
    "feature": "Reacties op je website",
    "them": "Niet vermeld op de website",
    "openmod": "Ja, via WordPress of de API"
  },
  {
    "feature": "Prijs",
    "them": "Niet gepubliceerd: hangt af van volgers, profielen en advertenties; demo aanvragen",
    "openmod": "Openbaar: gratis tot 1.000 verzoeken per maand, Pro voor € 99 per maand voor 10.000 verzoeken, Enterprise op aanvraag"
  },
  {
    "feature": "Schriftelijke uitleg bij elke beslissing",
    "them": "Niet vermeld op de website",
    "openmod": "Ja, een schriftelijke uitleg bij elke beslissing"
  },
  {
    "feature": "DSA",
    "them": "Niet vermeld op de website",
    "openmod": "Melding en actie, motivering, menselijke beoordeling van betwiste beslissingen, exporteerbare cijfers en een volledig activiteitenlogboek"
  },
  {
    "feature": "Certificeringen",
    "them": "Cyber Essentials en ISO 27001",
    "openmod": "AVG, met een volledig logboek van elke beslissing"
  },
  {
    "feature": "Hosting van gegevens",
    "them": "Niet vermeld op de website",
    "openmod": "Gehost in de EU, conform de AVG"
  },
  {
    "feature": "AI-modellen",
    "them": "Niet vermeld (spreekt van een AI die 'voortdurend leert')",
    "openmod": "Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden toegevoegd zodra ze uitkomen"
  },
  {
    "feature": "Referenties",
    "them": "Hinge, Formula 1, ITV, ATP, Red Bull Racing, Fulham (logo's op de website)",
    "openmod": "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora"
  }
];

const faqItems = [
  {
    "question": "Wat is het beste alternatief voor Arwen?",
    "answer": "Het beste alternatief voor Arwen hangt af van je kanalen: modereer je Facebook, Instagram, YouTube en de reacties op je eigen website, dan doet OpenModeration dat in één console, met openbare prijzen en een schriftelijke uitleg bij elke beslissing. Heb je moderatie van advertenties nodig, dan dekt Arwen die en OpenModeration niet; X en TikTok voegt OpenModeration snel toe op verzoek."
  },
  {
    "question": "Wat kost Arwen?",
    "answer": "Arwen publiceert geen prijzen: volgens de website hangen ze af van het aantal volgers, profielen en advertenties, en worden ze na een demo berekend. OpenModeration publiceert zijn prijzen wel: gratis tot 1.000 verzoeken per maand, Pro voor € 99 per maand voor 10.000 verzoeken, en Enterprise op aanvraag voor grote volumes. De prijs hangt niet af van je volgers."
  },
  {
    "question": "Arwen of OpenModeration: welke kies je?",
    "answer": "Kies Arwen als je de reacties op je advertenties wilt modereren. Kies OpenModeration als je de prijs wilt kennen voordat je een demo aanvraagt, als je openbare prijzen en een schriftelijke uitleg bij elke beslissing wilt, met een team dat de moderatie samen met je inricht volgens je regels en je use cases."
  },
  {
    "question": "Kan ik OpenModeration testen zonder Arwen op te zeggen?",
    "answer": "Ja. In sandboxmodus analyseert OpenModeration je echte reacties zonder iets te verbergen. Arwen blijft werken en je vergelijkt beide reeksen beslissingen, reactie per reactie, voordat je iets verandert."
  },
  {
    "question": "Welke AI-modellen gebruikt OpenModeration?",
    "answer": "OpenModeration werkt met een eigen moderatie-AI, en in gevoelige gevallen controleren andere AI-modellen de beslissing. Komt er een beter of voordeliger model uit, dan voegt het team het snel toe, zonder dat jij iets hoeft te veranderen: je moderatie profiteert van de vooruitgang van AI-modellen."
  },
  {
    "question": "Is OpenModeration geschikt voor sportclubs en mediamerken?",
    "answer": "Ja. De AI leest elke reactie samen met de titel van het bericht en de discussie, wat beslissend is op wedstrijddagen of bij breaking news. Sportmedia zoals L'Équipe modereren hun reacties met OpenModeration."
  }
];
---

<BaseLayout title={title} description={description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Alternatieven", href: localizePath('/alternatives', locale) }, { label: "Arwen" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Vergelijking
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Arwen alternatief: vergelijking met OpenModeration</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Het beste alternatief voor Arwen hangt af van je kanalen: modereer je Facebook, Instagram, YouTube en de reacties op je eigen website, dan doet OpenModeration dat in één console, met openbare prijzen en een schriftelijke uitleg bij elke beslissing. Heb je moderatie van advertenties nodig, dan dekt Arwen die en OpenModeration niet; X en TikTok voegt OpenModeration snel toe op verzoek.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900">Voor wie is Arwen?</h2>
      <p class="mt-4 text-surface-600">Volgens de website modereert Arwen met AI de reacties op sociale media van merken, sportclubs en media, met vier producten (Signals, Engage, Moderate en Protect). Arwen dekt Facebook, Instagram, X, TikTok en YouTube, kondigt Reddit 'binnenkort' aan en modereert ook reacties op advertenties van Meta en TikTok. Onder de logo's op de website staan Hinge, Formula 1, ITV, ATP en Red Bull Racing.</p>
      <p class="mt-4 text-surface-600">OpenModeration modereert met AI de reacties van media, merken en overheidsinstanties, op hun website en op hun Facebook-pagina's, Instagram-accounts en YouTube-kanalen. Het verbergt duidelijke overtredingen automatisch, laat legitieme kritiek zichtbaar en laat twijfelgevallen door ons team beoordelen, terwijl je elke beslissing realtime in één console ziet. Het team van Logora, sinds 2019 in Parijs, richt het samen met je in volgens je regels en je use cases.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Arwen en OpenModeration naast elkaar</h2>
      <p class="mt-4 text-surface-500">Informatie over Arwen afkomstig van de website arwen.ai, geraadpleegd op 30 oktober 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Arwen</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.them}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Kies OpenModeration als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>je de prijs wilt kennen voordat je een demo aanvraagt;</li>
          <li>je ook de reacties op je website of WordPress modereert;</li>
          <li>je een schriftelijke uitleg nodig hebt voor elke verborgen reactie, zoals de DSA vraagt;</li>
          <li>je gegevens in de Europese Unie moeten blijven.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Arwen past misschien beter als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>je de reacties op je advertenties wilt modereren;</li>
          <li>je voorgestelde antwoorden en social listening in dezelfde tool wilt;</li>
          <li>je inkoopafdeling ISO 27001 of Cyber Essentials eist.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h2 class="text-xl font-bold text-surface-900">Een AI die de vooruitgang van AI-modellen volgt</h2>
          <p class="mt-3 text-sm text-surface-600">OpenModeration werkt met een eigen moderatie-AI, en in gevoelige gevallen controleren andere AI-modellen de beslissing. Komt er een beter of voordeliger model uit, dan voegt het team het snel toe, zonder dat jij iets hoeft te veranderen. Je moderatie volgt de vooruitgang van de AI-markt in plaats van vast te zitten aan één algoritme. Arwen vermeldt op de website niet welke AI-modellen het gebruikt.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h2 class="text-xl font-bold text-surface-900">Prijzen: Arwen vs OpenModeration</h2>
          <p class="mt-3 text-sm text-surface-600">Arwen publiceert geen prijzen: volgens de website hangen ze af van het aantal volgers, profielen en advertenties, en worden ze na een demo berekend. OpenModeration publiceert zijn prijzen wel: gratis tot 1.000 verzoeken per maand, Pro voor € 99 per maand voor 10.000 verzoeken, en Enterprise op aanvraag voor grote volumes. De prijs hangt niet af van je volgers. On-premise is mogelijk op aanvraag. <a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">Plan een gesprek</a> om jouw situatie door te rekenen.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">In 3 stappen van Arwen naar OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">1. Test in sandboxmodus</h3>
          <p class="mt-2 text-sm text-surface-600">Koppel je website, WordPress of je Facebook-pagina's, Instagram en YouTube. OpenModeration analyseert echte reacties zonder iets te verbergen, terwijl Arwen blijft werken.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">2. Stel bij met het team van Logora</h3>
          <p class="mt-2 text-sm text-surface-600">We vergelijken de beslissingen met die van je huidige tool en stemmen de moderatie af op je regels en je use cases, met de schriftelijke uitleg van elke beslissing in beeld.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">3. Zet kanaal voor kanaal aan</h3>
          <p class="mt-2 text-sm text-surface-600">Je activeert de moderatie op één kanaal en daarna op de andere. Twijfelgevallen behandelt ons team. Elke beslissing komt in het activiteitenlogboek, dat je in realtime volgt.</p>
        </div>
      </div>
      <p class="mt-8 text-center text-surface-600">Wil je het zien met je eigen reacties? <a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">Plan een gesprek met het team</a>.</p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Veelgestelde vragen" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Arwen is een merk van de betreffende eigenaar. Bronnen: <a href="https://arwen.ai" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">arwen.ai</a> (geraadpleegd op 30 oktober 2026). Fout gezien? Mail ons op <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Meer weten</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/social-media-moderation', locale)} class="font-medium text-brand-600 hover:text-brand-500">Socialemediamoderatie met OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/integrations/facebook', locale)} class="font-medium text-brand-600 hover:text-brand-500">Facebook-reacties modereren &rarr;</a></li>
        <li><a href={localizePath('/blog/social-media-moderation-guide', locale)} class="font-medium text-brand-600 hover:text-brand-500">Gids voor socialemediamoderatie &rarr;</a></li>
        <li><a href={localizePath('/moderation-software', locale)} class="font-medium text-brand-600 hover:text-brand-500">De moderatiesoftware van OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/pricing', locale)} class="font-medium text-brand-600 hover:text-brand-500">De prijzen van OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/alternatives', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alle vergelijkingen &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Vergelijk je huidige moderatie met OpenModeration." subtitle="Test OpenModeration in sandboxmodus op je eigen reacties, zonder iets te verbergen. Gratis tot 1.000 verzoeken per maand." buttonText="Plan een gesprek" buttonHref={localizePath('/book-a-call', locale)} />
</BaseLayout>
