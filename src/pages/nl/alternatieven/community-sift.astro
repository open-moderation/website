---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Community Sift alternatief: vergelijking met OpenModeration";
const description = "Op zoek naar een Community Sift alternatief? Status, aanbod, prijzen en AI-modellen vergeleken met OpenModeration, reactiemoderatie gehost in de EU.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/community-sift",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  { feature: "Status", competitor: "Productpagina nog online, zonder end-of-life-melding (30 oktober 2026); een concurrent stelt dat contracten in 2026 niet worden verlengd, zonder openbare bevestiging van Microsoft", openmod: "Actief ontwikkeld door Logora (Parijs, sinds 2019)" },
  { feature: "Aanbod", competitor: "AI en menselijke expertise om gebruikerscontent in realtime te classificeren, filteren en escaleren, vooral voor games en online community's", openmod: "AI-moderatie van reacties voor nieuwsmedia, merken en overheidsinstanties, samen met jou ingericht door het team van Logora" },
  { feature: "Koppelingen", competitor: "Niet uitgewerkt op de pagina; Discord-plug-in en OCR als opties", openmod: "Website, Facebook, Instagram, YouTube en WordPress standaard; TikTok, X, LinkedIn en andere netwerken snel toegevoegd op verzoek" },
  { feature: "Soorten content", competitor: "Tekst, afbeeldingen en video", openmod: "Reacties" },
  { feature: "AI-modellen", competitor: "Niet vermeld: AI gecombineerd met menselijke expertise, volgens de pagina van Microsoft", openmod: "Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden toegevoegd zodra ze uitkomen" },
  { feature: "Regels", competitor: "Beleidsrichtlijnen op maat van de regels van je community", openmod: "Afgestemd op je regels en je use cases: duidelijke overtredingen verborgen, legitieme kritiek zichtbaar, twijfelgevallen beoordeeld door ons team" },
  { feature: "Talen", competitor: "22 premium talen vermeld", openmod: "Samen met jou bepaald tijdens de inrichting" },
  { feature: "DSA en transparantie", competitor: "Niet vermeld op de pagina", openmod: "Schriftelijke reden bij elke beslissing, activiteitenlogboek, melding en actie, motivering, menselijke beoordeling van betwiste beslissingen, exporteerbare cijfers" },
  { feature: "Hosting", competitor: "Niet vermeld op de pagina", openmod: "Gehost in de EU, AVG" },
  { feature: "Prijs", competitor: "Meerdere niveaus, op aanvraag", openmod: "Gratis tot 1.000 geanalyseerde reacties per maand; Pro voor € 99 per maand voor 10.000 reacties; Enterprise op aanvraag" },
  { feature: "Referenties", competitor: "Xbox, Electronic Arts, Supercell, Kabam, Flip, MSN", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "Wat is het beste Community Sift alternatief?",
    answer: "Voor het modereren van reacties bij nieuwsmedia, merkpagina's en kanalen van overheidsinstanties is OpenModeration een sterke keuze: koppelingen voor websites, Facebook, Instagram, YouTube en WordPress, openbare prijzen, een schriftelijke reden bij elke beslissing, DSA-bouwstenen en hosting in de EU. Voor realtime chat in grote games kun je beter een tool zoeken die voor gaming is gebouwd.",
  },
  {
    question: "Wat kost Community Sift?",
    answer: "Microsoft publiceert geen prijzen: de pagina noemt meerdere niveaus en opties, op aanvraag. OpenModeration is gratis tot 1.000 geanalyseerde reacties per maand, daarna € 99 per maand voor 10.000 reacties, met Enterprise op aanvraag.",
  },
  {
    question: "Verdwijnt Community Sift?",
    answer: "Op 30 oktober 2026 stond de productpagina van Microsoft nog online, zonder end-of-life-melding. Een concurrerende leverancier schreef in februari 2026 dat Microsoft zijn klanten had laten weten dat contracten na afloop niet worden verlengd. Een openbare bevestiging van Microsoft hebben we niet gevonden: vraag de planning na bij je contactpersoon bij Microsoft.",
  },
  {
    question: "Community Sift vs OpenModeration: wat is het verschil?",
    answer: "Community Sift, inmiddels van Microsoft, richt zich op games en grote online community's, met moderatie van tekst, afbeeldingen en video. OpenModeration is gemaakt voor reacties bij nieuwsmedia, merken en overheidsinstanties, publiceert zijn prijzen, wordt gehost in de EU en geeft bij elke beslissing een schriftelijke reden en een logboekregel.",
  },
  {
    question: "Kan ik OpenModeration testen terwijl Community Sift blijft draaien?",
    answer: "Ja. In sandboxmodus analyseert OpenModeration je echte content zonder iets te verbergen, zodat je de beslissingen kunt vergelijken voordat je overstapt.",
  },
  {
    question: "Wie richt OpenModeration in?",
    answer: "Het team van Logora, sinds 2019 in Parijs en in handen van de medewerkers. We stemmen de moderatie samen met jou af op je regels en je use cases en verfijnen haar in de eerste weken.",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Alternatieven", href: localizePath('/alternatives', locale) }, { label: "Community Sift" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Vergelijking
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Community Sift alternatief: vergelijking met OpenModeration</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Modereer je reacties van een nieuwsmedium, merkpagina's of de kanalen van een overheidsinstantie? Dan is OpenModeration een sterk alternatief voor Community Sift: koppelingen voor websites, Facebook, Instagram, YouTube en WordPress, openbare prijzen, DSA-bouwstenen en hosting in de EU. Beheer je realtime chat in grote online games, dan is Community Sift daarvoor gebouwd; hieronder lees je hoe het ervoor staat, met bronnen.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={localizePath('/book-a-call', locale)} class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Plan een gesprek</a>
        <a href={localizePath('/pricing', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-200 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Bekijk de prijzen</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Voor wie is Community Sift bedoeld?</h2>
      <p class="mt-4 text-surface-600">Community Sift is ontwikkeld door Two Hat, een Canadees bedrijf dat Microsoft in 2021 overnam; twohat.com verwijst nu door naar een pagina van Microsoft. Die pagina beschrijft een moderatieplatform dat "het beste van twee werelden combineert", AI en menselijke expertise, om gebruikerscontent in realtime te classificeren, filteren en escaleren, inclusief straattaal, l33t speak, emoji's en Unicode-trucs, plus moderatie van afbeeldingen en video. Er worden 22 premium talen genoemd en de logo's van Xbox, Electronic Arts, Supercell, Kabam, Flip en MSN getoond.</p>
      <p class="mt-4 text-surface-600">De status: op 30 oktober 2026 stond de productpagina van Microsoft nog online, zonder end-of-life-melding. Een concurrerende leverancier schreef in februari 2026 dat Microsoft zijn klanten had laten weten dat lopende contracten tot het einde worden nagekomen en niet worden verlengd. Een openbare aankondiging van Microsoft die dit bevestigt, hebben we niet gevonden: vraag het na bij je contactpersoon bij Microsoft.</p>
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Kies OpenModeration als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>je reacties modereert van een nieuwsmedium, merkpagina's of de kanalen van een overheidsinstantie;</li>
          <li>je kant-en-klare koppelingen wilt voor Facebook, Instagram, YouTube en WordPress, en een API voor je website;</li>
          <li>je eerst gratis wilt testen op je eigen reacties, voordat je je vastlegt;</li>
          <li>je een schriftelijke reden bij elke beslissing en DSA-bouwstenen nodig hebt;</li>
          <li>je data in de EU gehost moet worden en je een team wilt dat de moderatie samen met jou inricht.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Community Sift past misschien beter als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>je realtime chat in grote online games filtert, waar Xbox, EA en Supercell het gebruiken;</li>
          <li>je afbeeldingen en video moet modereren, met risicoinstellingen en vervaging die moderators beschermt;</li>
          <li>je afhankelijk bent van de Discord-plug-in of de OCR-optie;</li>
          <li>je contract met Microsoft nog loopt en voorlopig dekt wat je nodig hebt.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Community Sift en OpenModeration naast elkaar</h2>
      <p class="mt-4 text-surface-500">Informatie over Community Sift afkomstig van de pagina van Microsoft, developer.microsoft.com, geraadpleegd op 30 oktober 2026. Waar de pagina niets zegt, geven we dat aan.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Community Sift</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Een AI die de vooruitgang van AI-modellen volgt</h2>
      <p class="mt-4 text-surface-600">OpenModeration werkt met een eigen moderatie-AI en laat de beslissingen in gevoelige gevallen controleren door andere AI-modellen. De engine is niet aan één model gebonden: komt er een beter of goedkoper model uit, dan koppelt ons team het snel, zonder dat jij iets hoeft aan te passen.</p>
      <p class="mt-4 text-surface-600">Volgens de pagina van Microsoft combineert Community Sift AI met menselijke expertise, zonder te vermelden welke modellen het gebruikt. Met OpenModeration volgt je moderatie de vooruitgang van AI-modellen in plaats van vast te zitten aan één algoritme, en dat telt als je een tool voor meerdere jaren kiest.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Prijzen: Community Sift vs OpenModeration</h2>
      <p class="mt-4 text-surface-600">Microsoft publiceert geen prijzen voor Community Sift: de pagina spreekt van "meerdere prijsniveaus" en opties zoals OCR en een Discord-plug-in, en verwijst naar het salesteam.</p>
      <p class="mt-4 text-surface-600">OpenModeration publiceert zijn prijzen: gratis tot 1.000 geanalyseerde reacties per maand, Pro voor € 99 per maand voor 10.000 reacties en Enterprise op aanvraag voor grote volumes. Een installatie op je eigen servers is mogelijk op aanvraag.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">In 3 stappen van Community Sift naar OpenModeration</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-1 font-semibold text-surface-900">Vertaal je beleid</h3>
          <p class="mt-2 text-sm text-surface-600">Zet samen met ons team je Community Sift-beleid, met zijn onderwerpen en risiconiveaus, om in regels voor je use cases: wat wordt verborgen, wat blijft staan en wat ons team beoordeelt.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-1 font-semibold text-surface-900">Laat beide parallel draaien</h3>
          <p class="mt-2 text-sm text-surface-600">Koppel je website via de API, of je Facebook-, Instagram-, YouTube- en WordPress-accounts, in sandboxmodus. Er wordt niets verborgen terwijl je de beslissingen over dezelfde content vergelijkt.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-1 font-semibold text-surface-900">Stap over vóór de einddatum</h3>
          <p class="mt-2 text-sm text-surface-600">Zet de automatische moderatie in OpenModeration aan en stop met het versturen van content naar Community Sift, bij voorkeur ruim voordat je contract afloopt.</p>
        </li>
      </ol>
      <p class="mt-8 text-surface-600">Wil je het eerst zien op je eigen reacties? <a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">Plan een gesprek met het team van Logora</a>, dan zetten we de sandbox samen met je op.</p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Veelgestelde vragen" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Community Sift en Two Hat zijn merken van de betreffende eigenaar, Microsoft. Bronnen: <a href="https://developer.microsoft.com/en-us/games/products/community-sift/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">developer.microsoft.com/en-us/games/products/community-sift</a>, <a href="https://www.twohat.com" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">twohat.com</a>, <a href="https://www.lassomoderation.com/blog/what-is-community-sift/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">lassomoderation.com/blog/what-is-community-sift</a> (geraadpleegd op 30 oktober 2026). Fout gezien? Mail ons op <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Meer weten</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/blog/comment-moderation-guide', locale)} class="font-medium text-brand-600 hover:text-brand-500">Reacties modereren: de complete gids &rarr;</a></li>
        <li><a href={localizePath('/use-cases/gaming', locale)} class="font-medium text-brand-600 hover:text-brand-500">Moderatie voor gaming-community's &rarr;</a></li>
        <li><a href={localizePath('/moderation-software', locale)} class="font-medium text-brand-600 hover:text-brand-500">De moderatiesoftware van OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/pricing', locale)} class="font-medium text-brand-600 hover:text-brand-500">De prijzen van OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/alternatives', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alle vergelijkingen &rarr;</a></li>
        <li><a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">Plan een gesprek met ons team &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Vergelijk je huidige moderatie met OpenModeration." subtitle="Test OpenModeration in sandboxmodus op je eigen reacties, zonder iets te verbergen. Gratis tot 1.000 geanalyseerde reacties per maand." buttonText="Plan een gesprek" buttonHref={localizePath('/book-a-call', locale)} />
</BaseLayout>
