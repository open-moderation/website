---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import SwitchProvider from '../../../components/SwitchProvider.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Netino alternatief: vergelijking met OpenModeration";
const description = "Netino of OpenModeration? Een extern moderatiebureau naast moderatie die zelf draait: regels, publieke prijzen, AI-engine, DSA-tools en EU-hosting.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/alternatieven/netino",
  "url": "https://www.openmoderation.com/nl/alternatieven/netino",
  "name": title,
  "description": description,
  "inLanguage": "nl",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  { feature: "Soort aanbod", them: "Uitbestede dienst: Netino modereert voor je, naast community management, social listening en klantenservice via sociale media", openmod: "Moderatie die zelf draait: je koppelt je pagina's, de automatisering en het team van Logora doen de rest" },
  { feature: "Wie beslist", them: "AI gecombineerd met menselijke experts van Netino, 24/7", openmod: "Duidelijke overtredingen automatisch verborgen, legitieme kritiek blijft zichtbaar, twijfelgevallen afgehandeld door ons team; jij ziet alles in één console" },
  { feature: "Kanalen", them: "„Alle kanalen” en sociale media op meerdere platforms; netwerken niet genoemd op de homepage", openmod: "Website, Facebook, Instagram, YouTube en WordPress standaard; TikTok, X, LinkedIn en andere netwerken snel toegevoegd op verzoek" },
  { feature: "Prijzen", them: "Niet gepubliceerd; audit of contact op aanvraag", openmod: "Publiek: gratis tot 1.000 geanalyseerde reacties per maand, Pro € 99 per maand voor 10.000 reacties, Enterprise op aanvraag" },
  { feature: "AI-modellen", them: "Niet vermeld op de website", openmod: "Eigen moderatie-AI, gecontroleerd door andere AI-modellen; nieuwe modellen worden aangesloten zodra ze uitkomen" },
  { feature: "Geschreven uitleg bij elke beslissing", them: "Niet vermeld op de website", openmod: "Ja, een geschreven uitleg bij elke beslissing" },
  { feature: "DSA", them: "Moderatie gepresenteerd als steun bij naleving van regelgeving, met rapportage over volumes; details niet vermeld", openmod: "Melding en actie, motivering van beslissingen, menselijke beoordeling van betwiste beslissingen, exporteerbare cijfers, volledig activiteitenlogboek" },
  { feature: "Hosting van data", them: "Niet vermeld op de homepage (bedrijf gevestigd in Parijs)", openmod: "Gehost in de Europese Unie, AVG" },
  { feature: "Andere diensten", them: "Community management, social listening, klantenservice via sociale media, contentbeheer, martech", openmod: "Alleen moderatie" },
];

const faqItems = [
  {
    question: "Wat is het beste alternatief voor Netino?",
    answer: "Dat hangt ervan af wie de moderatie moet doen. Wil je dat een bureau het voor je doet, samen met community management en klantenservice, dan biedt Netino dat. Wil je dat moderatie gewoon draait volgens jouw regels, zonder dat je team er werk aan heeft, met een geschreven uitleg bij elke beslissing en een gepubliceerde prijs, dan is OpenModeration daarvoor gemaakt.",
  },
  {
    question: "Wat kost Netino?",
    answer: "Netino publiceert zijn prijzen niet op de website. OpenModeration is gratis tot 1.000 geanalyseerde reacties per maand, daarna € 99 per maand voor 10.000 reacties met Pro, en Enterprise op aanvraag.",
  },
  {
    question: "Netino vs OpenModeration: wat is het verschil?",
    answer: "Netino is een dienst: zijn teams modereren voor je, ondersteund door AI. OpenModeration is geautomatiseerd: de AI verbergt duidelijke overtredingen, laat legitieme kritiek zichtbaar en twijfelgevallen worden door ons team afgehandeld. Jij ziet elke beslissing met haar geschreven uitleg in realtime in één console, met bouwstenen voor de DSA.",
  },
  {
    question: "Kan ik OpenModeration testen zonder met Netino te stoppen?",
    answer: "Ja. In sandboxmodus analyseert OpenModeration je echte reacties zonder iets te verbergen of te verwijderen. Netino blijft gewoon werken en je vergelijkt de beslissingen op dezelfde reacties voordat je iets verandert.",
  },
  {
    question: "Welke AI-modellen gebruikt OpenModeration?",
    answer: "OpenModeration werkt met een eigen moderatie-AI, waarvan de beslissingen bij gevoelige gevallen worden gecontroleerd door andere AI-modellen. Komt er een beter of goedkoper model uit, dan sluit ons team het snel aan, zonder dat jij iets hoeft te veranderen.",
  },
  {
    question: "Moet mijn team nog zelf modereren met OpenModeration?",
    answer: "Nee. Het team van Logora zet de moderatie samen met jou op, op basis van je regels en je use cases. Daarna draait alles automatisch; twijfelgevallen, meldingen van gebruikers en betwiste beslissingen worden door ons team afgehandeld. Jij ziet elke beslissing in realtime en kunt ingrijpen wanneer je wilt.",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Alternatieven", href: localizePath('/alternatives', locale) }, { label: "Netino" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Vergelijking
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternatief voor Netino: moderatie die gewoon draait, met volledig zicht</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Zoek je een alternatief voor Netino dat jouw regels toepast, dan is OpenModeration daarvoor gemaakt: je koppelt je pagina's, de AI verbergt duidelijke overtredingen, ons team handelt de twijfelgevallen af en elke beslissing komt met een geschreven uitleg die je in realtime ziet. Wil je moderatie, community management en klantenservice liever aan een extern bureau overlaten, dan biedt Netino dat.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={localizePath('/book-a-call', locale)} class="rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-500">Plan een gesprek</a>
        <a href="https://app.openmoderation.com/signup" class="rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 hover:bg-surface-50">Gratis proberen</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Voor wie is Netino?</h2>
      <p class="mt-4 text-surface-600">Netino is een bureau uit Parijs dat zichzelf een „Marketing Process Outsourcer” noemt. Volgens de website modereert het content dag en nacht door AI te combineren met geselecteerde menselijke experts, naast diensten voor community management, social listening, klantenservice via sociale media, contentbeheer en martech.</p>
      <p class="mt-4 text-surface-600">Netino zegt met meer dan 200 bedrijven te werken; tussen de logo's op de website staan L'Oréal, Air France, Castorama, Lagardère, E.Leclerc en Société Générale. Een wetenschappelijke studie uit 2021 noemt ook de Spaanse Unidad Editorial als een van de mediagroepen die met Netino werkten. Het past bij organisaties die hun socialemediawerk als geheel willen uitbesteden.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Netino en OpenModeration naast elkaar</h2>
      <p class="mt-4 text-surface-500">Informatie over Netino afkomstig van de website netino.com, geraadpleegd op 30 oktober 2026. Staat iets daar niet vermeld, dan zeggen we dat.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Netino</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.them}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Kies Netino als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>je wilt dat een extern team moderatie, community management en antwoorden aan klanten verzorgt;</li>
          <li>je community management en klantenservice ook wilt uitbesteden;</li>
          <li>je één leverancier zoekt voor al je socialemediawerk.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Kies OpenModeration als…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>je je eigen regels wilt bepalen en aanpassen zonder via een leverancier te gaan;</li>
          <li>je eerst gratis wilt testen op je eigen reacties, voordat je je vastlegt;</li>
          <li>je een geschreven uitleg bij elke verborgen reactie en bouwstenen voor de DSA nodig hebt;</li>
          <li>je ook reacties op je website of in WordPress modereert;</li>
          <li>je moderatie wilt die profiteert van de vooruitgang van AI-modellen.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Een AI-engine die de markt bijhoudt</h2>
      <p class="mt-4 text-surface-600">OpenModeration werkt met een eigen moderatie-AI, en bij gevoelige gevallen worden de beslissingen gecontroleerd door andere AI-modellen. De engine is niet aan één model gebonden: komt er een beter of goedkoper AI-model uit, dan sluit ons team het snel aan, zonder dat jij iets hoeft te veranderen. Je moderatie profiteert van de vooruitgang van AI-modellen in plaats van vast te zitten aan één eigen algoritme. De website van Netino vermeldt niet welke AI-modellen het gebruikt.</p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Prijzen: Netino en OpenModeration</h2>
      <p class="mt-4 text-surface-600">Netino publiceert zijn prijzen niet; de website nodigt je uit een audit aan te vragen of contact op te nemen met het team. Een uitbestede moderatiedienst wordt meestal per geval geoffreerd.</p>
      <p class="mt-4 text-surface-600">OpenModeration publiceert zijn prijzen: gratis tot 1.000 geanalyseerde reacties per maand, Pro voor € 99 per maand voor 10.000 reacties en Enterprise op aanvraag voor grote volumes. Een on-premise installatie is mogelijk op aanvraag. Je betaalt voor je aantal reacties, niet voor bestede uren.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Overstappen van Netino naar OpenModeration in 3 stappen</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-2 font-semibold text-surface-900">Test in sandboxmodus</h3>
          <p class="mt-2 text-sm text-surface-600">Koppel een Facebook-pagina, een professioneel Instagram-account, een YouTube-kanaal, WordPress of je website via de API. OpenModeration analyseert je echte reacties zonder iets te verbergen, terwijl Netino gewoon doorwerkt.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-2 font-semibold text-surface-900">Stem de moderatie af met ons team</h3>
          <p class="mt-2 text-sm text-surface-600">Het team van Logora gaat uit van je regels en je use cases, vergelijkt de beslissingen van OpenModeration met die van Netino op dezelfde reacties en stelt bij wat moet worden bijgesteld.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-white p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-2 font-semibold text-surface-900">Zet automatische moderatie aan</h3>
          <p class="mt-2 text-sm text-surface-600">Duidelijke overtredingen worden verborgen, twijfelgevallen worden door ons team afgehandeld en elke beslissing houdt haar geschreven uitleg, zichtbaar in je console. Je stopt met Netino wanneer je er klaar voor bent.</p>
        </li>
      </ol>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Veelgestelde vragen" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bronnen: <a href="https://netino.com/fr/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">netino.com</a>, <a href="https://revista.profesionaldelainformacion.com/index.php/EPI/article/download/86568/63065/290349" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Paz-Rebollo et al., El Profesional de la Información (2021)</a> (geraadpleegd op 30 oktober 2026). Netino is een merk van de eigenaar ervan. Zie je een fout? Schrijf ons op <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Meer weten</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/alternatives', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alle vergelijkingen &rarr;</a></li>
        <li><a href={localizePath('/moderation-software', locale)} class="font-medium text-brand-600 hover:text-brand-500">De moderatiesoftware van OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/blog/comment-moderation-guide', locale)} class="font-medium text-brand-600 hover:text-brand-500">Gids: reacties modereren &rarr;</a></li>
        <li><a href={localizePath('/blog/social-media-moderation-guide', locale)} class="font-medium text-brand-600 hover:text-brand-500">Gids: socialemediamoderatie &rarr;</a></li>
        <li><a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">Plan een gesprek met ons team &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Koppel je pagina's, wij doen de rest." subtitle="We stemmen OpenModeration af op je regels en je use cases, daarna test je het in sandboxmodus naast je huidige leverancier." buttonText="Plan een gesprek" buttonHref={localizePath('/book-a-call', locale)} />
</BaseLayout>
