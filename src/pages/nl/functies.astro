---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/nl/functies",
  "url": "https://www.openmoderation.com/nl/functies",
  "name": "Functies voor contentmoderatie: één API en regel-engine",
  "description": "Alle functies van OpenModeration: moderatie-API, beheerdashboard, action engine, kant-en-klare connectoren, batchverwerking en een DSA-proof audittraject.",
  "inLanguage": "nl",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const curlExample = `# Eén aanroep, gestandaardiseerde scores
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "Your text to moderate here",
    "language": "en"
  }'

# Response (elke keer hetzelfde formaat)
{
  "id": "modr_01JXK...",
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const featureCategories = [
  {
    title: 'Eén integratie',
    description: 'Eén API-endpoint, één responseformaat. Sluiten wij een beter AI-model aan, dan verandert er niets aan je code.',
    items: [
      { title: 'Onze eigen moderatie-AI', desc: 'Stuur content één keer in en krijg een duidelijk oordeel (goedgekeurd of afgekeurd) plus scores per categorie terug, ingericht op jouw regels en jouw use cases.' },
      { title: 'Kant-en-klare contentcategorieën', desc: 'Standaardcategorieën voor haat, intimidatie, seksuele content, geweld, zelfbeschadiging, spam, desinformatie, persoonsgegevens en meer.' },
      { title: 'Gecontroleerd door andere AI’s', desc: 'Bij lastige gevallen beoordelen andere AI-modellen de beslissing voordat die wordt toegepast. Minder fouten, minder reacties die onterecht verborgen worden.' },
      { title: 'Slimmere moderatiebeslissingen', desc: 'Beslissingen houden rekening met het gesprek, de geschiedenis van de schrijver, het kanaal en je eigen beleid.' },
      { title: 'Content in bulk beoordelen', desc: 'Stuur tot 10.000 items tegelijk in voor asynchrone verwerking. De resultaten worden naar je systeem gepusht zodra ze klaar zijn.' },
      { title: 'Eigen moderatiebeleid', desc: 'Definieer je eigen categorieën. Geef voorbeelden en laat de AI content op jouw manier classificeren.' },
    ],
  },
  {
    title: 'Moderatiedashboard',
    description: 'Een webinterface om je dagelijkse moderatie te regelen.',
    items: [
      { title: 'Toegangsbeheer', desc: 'Maak toegangssleutels aan en beheer ze. Stel gebruikslimieten per sleutel in.' },
      { title: 'Team- en rollenbeheer', desc: "Geef je collega's toegang, wijs rollen toe en stel rechten in zonder tussenkomst van je IT-afdeling." },
      { title: 'Beheer van meldingen', desc: 'Meldingen van gebruikers worden door ons team afgehandeld. Jij volgt hun status, zodat geen gemelde reactie wordt vergeten.' },
      { title: 'Activiteitengeschiedenis', desc: 'Elk moderatieverzoek wordt vastgelegd met het oordeel, de responstijd en de scores per categorie.' },
      { title: 'Monitoring van de dienst', desc: 'Zie in realtime de status van de dienst: uptime, responstijden en foutpercentages.' },
      { title: 'Prestatierapporten', desc: 'Volg het moderatievolume en het aandeel gemarkeerde content en houd de ontwikkeling van de kosten in de gaten.' },
      { title: 'Beheer van connectoren', desc: 'Koppel je accounts op sociale platforms met je eigen inloggegevens.' },
      { title: 'Regels instellen', desc: 'Leg verboden woorden vast, stel drempels per categorie in en schrijf je regels in gewone taal. Voor deze drie hulpmiddelen is geen code nodig.' },
    ],
  },
  {
    title: 'Geautomatiseerde moderatie',
    description: 'Je legt je moderatieregels vast met drie hulpmiddelen: verboden woorden, drempels per categorie en je eigen regels in gewone taal.',
    items: [
      { title: 'AI-regels die context begrijpen', desc: 'Combineer de betrouwbaarheidsscores van de AI met je eigen regels in plaats van alleen op trefwoordenlijsten te vertrouwen.' },
      { title: 'Automatische acties', desc: 'Wordt een drempel overschreden, dan kan de Action Engine content verbergen, verwijderen, markeren, een melding sturen of als spam aanmerken.' },
      { title: 'Mens in de lus', desc: 'Grensgevallen worden afgehandeld door ons team. Jij kunt op elk moment ingrijpen en zelf de knoop doorhakken.' },
      { title: 'Realtime overzicht', desc: 'Zie elke beslissing op het moment dat ze valt, met de schriftelijke reden, en keur zelf goed of af wat je wilt.' },
      { title: 'Webhookmeldingen', desc: 'Ontvang realtime waarschuwingen bij gemarkeerde content, afgeronde batches, fouten en meer.' },
      { title: 'Volledig audittraject', desc: 'Elke actie wordt vastgelegd met de regel die haar uitlokte, de genomen actie en het resultaat.' },
    ],
  },
  {
    title: 'Platformintegraties',
    description: 'Koppel rechtstreeks met sociale platforms en je blog om content automatisch binnen te halen en te modereren.',
    items: [
      { title: 'Facebook', desc: 'Ontvang reacties en posts. Verberg of verwijder automatisch content die je regels overtreedt.' },
      { title: 'Instagram', desc: 'Modereer Instagram-reacties en -berichten. Houd je profiel vrij van giftige content en spam.' },
      { title: 'YouTube', desc: 'Haal reacties onder video\'s binnen. Markeer ze als spam of houd ze vast voor beoordeling door ons team.' },
      { title: 'WordPress', desc: 'Modereer reacties op je blog. Automatisch goedkeuren, vasthouden voor beoordeling of als spam markeren.' },
      { title: 'Je eigen platformtoegang', desc: 'Gebruik je eigen platformtokens. We slaan ze nooit als platte tekst op.' },
      { title: 'Generieke webhook-ontvanger', desc: 'Haal content binnen van elk platform dat uitgaande webhooks ondersteunt.' },
      { title: 'Generieke webhook-callback', desc: 'Stuur moderatieresultaten naar je eigen webhook voor maatwerkintegraties.' },
    ],
  },
];
---

<BaseLayout title="Functies voor contentmoderatie: één API en regel-engine" description="Alle functies van OpenModeration: moderatie-API, beheerdashboard, action engine, kant-en-klare connectoren, batchverwerking en een DSA-proof audittraject." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Functies" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Functies</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        OpenModeration dekt de hele keten, van het ontvangen van een reactie tot de actie die erop volgt.
      </p>
    </div>
  </section>

  {featureCategories.map((cat) => (
    <section class="scroll-mt-16 border-t border-surface-100 bg-white py-12 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-8 max-w-2xl text-center sm:mb-12">
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{cat.title}</h2>
          <p class="mt-4 text-lg text-surface-500">{cat.description}</p>
        </div>
        <div class={`grid gap-4 sm:gap-6 md:grid-cols-2 ${cat.items.length % 4 === 0 || cat.items.length === 7 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
          {cat.items.map((item) => (
            <div class="om-card relative overflow-hidden bg-white !p-5 sm:!p-6">
              <span class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-brand-500 to-violet-500" aria-hidden="true"></span>
              <h3 class="font-semibold text-surface-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-surface-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- API Reference Snippet -->
  <section class="border-t border-surface-100 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Eén formaat, welk model er ook achter zit</h2>
          <p class="mt-4 text-lg text-surface-500">
            Sluiten wij een beter of goedkoper AI-model aan, dan houden de resultaten hetzelfde formaat. Je integreert dus maar één keer.
          </p>
          <div class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Elke keer hetzelfde formaat</strong>, zonder extra code wanneer de AI beter wordt.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Veilige toegangssleutels</strong> met afgebakende rechten en gebruikslimieten per sleutel.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Interactieve API-documentatie</strong> wordt automatisch gegenereerd, en je kunt verzoeken direct in je browser uitproberen.</p>
            </div>
          </div>
        </div>
        <div>
          <CodeBlock code={curlExample} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
