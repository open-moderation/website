---
import SectorPage from '../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderatiesoftware: een compleet systeem, DSA-proof"
  description="Moderatiesoftware afgestemd op je regels voor reacties op je site en social media: AI-analyse, realtime console, schriftelijke motivering en DSA-log."
  crumb="Moderatiesoftware"
  parent={null}
  eyebrow="Software voor contentmoderatie"
  h1="Moderatiesoftware, geen simpel filter"
  intro="Een echt moderatiesysteem doet meer dan woorden blokkeren. OpenModeration leest elke reactie aan de hand van je regels, verbergt wat ze overtreedt, laat twijfelgevallen door ons team afhandelen en legt elke beslissing schriftelijk vast voor de DSA."
  problem="Trefwoordfilters blokkeren terechte kritiek en laten ironie, verhulde beledigingen en oplichting door. Kale moderatie-API's geven scores terug, maar de interface, de regels, de menselijke beoordeling en het auditlog moet je dan nog zelf bouwen."
  approach="OpenModeration brengt het hele systeem samen: het verzamelen van reacties (je website, Facebook, Instagram, YouTube, API), AI-analyse, regels in gewone taal, een beoordelingsconsole en een auditlog. Samen met jou stemmen we het af op je regels en je use cases."
  result="Moderatie die zelfstandig draait, dag en nacht, met een team dat alleen ingrijpt bij gevallen waar een mens nodig is, en een geschiedenis die klaarligt als een beslissing wordt aangevochten of gecontroleerd."
  featuresTitle="Wat de moderatietool bevat"
  featuresIntro="De bouwstenen van een moderatiesysteem, al in elkaar gezet en klaar om aan je reactieruimtes te koppelen."
  features={[
    { title: "AI-analyse, in context", text: "Elke reactie wordt gelezen samen met het onderwerp van het artikel of de post, in de eigen taal, om ironie, gecodeerde beledigingen en off-topicberichten te herkennen." },
    { title: "Je regels in gewone taal", text: "Je schrijft je regels zoals je ze aan een moderator zou uitleggen. Geen woordenlijsten om bij te houden, geen code." },
    { title: "Een realtime console", text: "Elke beslissing staat in één console, met de betrokken regel en de uitleg van de AI. Grensgevallen handelt ons team af; jij kunt met één klik ingrijpen." },
    { title: "Auditlog en motivering", text: "Elke beslissing, automatisch of menselijk, wordt vastgelegd met een schriftelijke motivering, zoals artikel 17 van de DSA vereist." },
  ]}
  why={[
    { title: "Samen met jou opgezet", text: "We zetten je regels en use cases om in duidelijke instructies en testen ze op je echte reacties voordat we ze inschakelen." },
    { title: "DSA-proof", text: "Meldingen van gebruikers, motiveringen, menselijke beoordeling en cijfers voor het transparantieverslag zitten er vanaf het begin in." },
    { title: "Goedkoper dan een eigen team", text: "Automatische moderatie kost een fractie van handmatige moderatie, intern of uitbesteed." },
  ]}
  faq={[
    { question: "Wat is het verschil tussen moderatiesoftware en een moderatie-API?", answer: "Een API geeft een score terug voor een stuk tekst. Moderatiesoftware regelt de hele keten: verzamelen, regels, beslissing, menselijke beoordeling, uitleg en geschiedenis. OpenModeration biedt allebei: het complete platform, en een API voor technische teams." },
    { question: "Heb ik ontwikkelaars nodig om het op te zetten?", answer: "Niet voor Facebook, Instagram, YouTube of WordPress: de connectoren werken zonder code. Voor een eigen website of app volstaat een API-integratie." },
    { question: "Kan ik het uitproberen voordat ik me vastleg?", answer: "Ja. Je kunt meteen een reactie testen in de online demo, een gratis account aanmaken of een gesprek plannen om de moderatie op je eigen reacties te zien werken." },
    { question: "Voldoet de software aan de AVG?", answer: "Ja. OpenModeration wordt ontwikkeld en gehost in de Europese Unie, en jij bepaalt hoe lang gegevens worden bewaard." },
  ]}
  related={[
    { eyebrow: "Demo", title: "Probeer de moderatie", text: "Plak een reactie en zie binnen enkele seconden de beslissing en de uitleg.", href: localizePath('/demo', locale) },
    { eyebrow: "Platform", title: "De moderatieconsole", text: "Eén overzicht voor al je platforms.", href: localizePath('/dashboard', locale) },
    { eyebrow: "Regelgeving", title: "DSA-naleving", text: "Wat de DSA vraagt van websites met reacties.", href: localizePath('/dsa-compliance', locale) },
  ]}
  ctaTitle="Zie het systeem werken op je eigen reacties."
  ctaSubtitle="Plan een gesprek: we gaan uit van je regels en je use cases en laten je de beslissingen op je echte reacties zien."
/>
