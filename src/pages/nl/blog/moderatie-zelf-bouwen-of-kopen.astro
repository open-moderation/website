    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Lees verder</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/build-vs-buy', locale)} class="font-medium text-brand-600 hover:text-brand-500">Zelf bouwen of kopen? De keuzehulp &rarr;</a></li>
        <li><a href={localizePath('/pricing', locale)} class="font-medium text-brand-600 hover:text-brand-500">Eenvoudige, transparante prijzen &rarr;</a></li>
        <li><a href={localizePath('/features', locale)} class="font-medium text-brand-600 hover:text-brand-500">Alles wat het platform voor je doet &rarr;</a></li>
      </ul>
    </div>
  </section>

  <GuideComparisons />

