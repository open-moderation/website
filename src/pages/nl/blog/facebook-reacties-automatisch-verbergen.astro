import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Facebook-reacties automatisch verbergen (2026)";
const description = "Reacties op een Facebook-pagina modereren en automatisch verbergen: verbergen, verwijderen of verbannen, de filters van Facebook en hoe je een tool kiest.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Facebook-reacties automatisch verbergen: een gids voor reactiemoderatie op Facebook",
  "description": description,
  "inLanguage": "nl",
  "datePublished": "2026-10-30",
  "dateModified": "2026-10-30",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/nl/blog/facebook-reacties-automatisch-verbergen" }
