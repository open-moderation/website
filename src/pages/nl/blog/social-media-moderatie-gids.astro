const responses = [
  { type: "Klacht of kritiek, ook als die hard is", action: "Antwoord in het openbaar en ga naar privéberichten als er persoonsgegevens nodig zijn" },
  { type: "Vraag over een product, een dienst of een artikel", action: "Antwoord, tijdens een campagne het liefst binnen het uur" },
  { type: "Buiten het onderwerp maar onschuldig", action: "Laat staan, of verberg als je regels dat zeggen" },
