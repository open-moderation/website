  { name: "TikTok", tools: "Filter voor spam en beledigende reacties, trefwoordfilter, alle reacties goedkeuren, wie mag reageren", action: "Gefilterd voor goedkeuring of verwijderd", om: "Op verzoek, snel toegevoegd" },
  { name: "LinkedIn", tools: "Verwijderen, rapporteren, beperken wie mag reageren, reacties op een post uitzetten", action: "Verwijderd", om: "Op verzoek, snel toegevoegd" },
  { name: "X", tools: "Instellingen voor antwoorden, antwoorden verbergen, negeren, blokkeren, rapporteren", action: "Antwoord verborgen achter een klik, of het account genegeerd of geblokkeerd", om: "Op verzoek, snel toegevoegd" },
