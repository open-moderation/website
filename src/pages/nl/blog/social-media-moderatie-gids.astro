  { type: "Persoonsgegevens openbaar geplaatst", action: "Verwijder en neem daarna privé contact op met de persoon" },
  { type: "Bedreiging, illegale content, signaal van zelfbeschadiging", action: "Schaal direct op: bewaar bewijs, meld het bij het platform, waarschuw de juiste persoon of instantie" },
