---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.openmoderation.com/nl/blog",
  "url": "https://www.openmoderation.com/nl/blog",
  "name": "Blog over contentmoderatie: DSA, AI-veiligheid en gidsen",
  "description": "Artikelen over contentmoderatie, DSA-compliance, AI-veiligheid en moderatie-infrastructuur.",
  "inLanguage": "nl",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const posts = [
  {
    title: "TikTok-reacties modereren: filters, regels en tips",
    description: "Zo modereer je TikTok-reacties: reactiefilters, gefilterde trefwoorden, handmatige goedkeuring, LIVE-moderators, hun beperkingen voor merken en een crisisdraaiboek.",
    slug: "tiktok-comment-moderation",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["gids"],
  },
  {
    title: "Social media modereren: de complete gids (2026)",
    description: "Zo modereer je social media: methoden, regels, de eigenaardigheden van Facebook, Instagram, YouTube, TikTok, LinkedIn en X, je team, crises, cijfers en tools.",
    slug: "social-media-moderation-guide",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["gids"],
  },
  {
    title: "YouTube-reacties modereren: de tools van Studio en hun grenzen",
    description: "Zo modereer je YouTube-reacties: ter beoordeling vastgehouden, geblokkeerde woorden en links, goedgekeurde en verborgen gebruikers, moderators, livechat en wanneer je automatiseert.",
    slug: "youtube-comment-moderation",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["gids"],
  },
  {
    title: "Omgaan met negatieve reacties en trolls (gids 2026)",
    description: "Zo ga je om met negatieve reacties en trolls: kritiek of scheldpartij, wanneer je reageert, verbergt, verwijdert of blokkeert, antwoordsjablonen, raids, crises en het welzijn van je team.",
    slug: "handle-negative-comments-trolls",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["gids"],
  },
  {
    title: "Wat is contentmoderatie? Definitie en soorten",
    description: "Wat contentmoderatie betekent: wat er gemodereerd wordt, de 6 soorten, het werk van contentmoderator, hoe AI-moderatie werkt, de DSA en hoe je een aanpak kiest.",
    slug: "what-is-content-moderation",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["gids"],
  },
  {
    title: "Reacties modereren: de complete gids",
    description: "Zo modereer je reacties: de methoden vergeleken, wat je regels moeten afdekken, grijze zones, de DSA, een tool kiezen en 10 best practices.",
    slug: "comment-moderation-guide",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["gids", "reacties", "DSA"],
  },
  {
    title: "Facebook-reacties automatisch verbergen",
    description: "Verbergen, verwijderen of blokkeren, de ingebouwde filters van Facebook en hun grenzen, en hoe je een tool kiest om Facebook-reacties te modereren.",
    slug: "hide-facebook-comments-automatically",
    date: "2026-10-30",
    readTime: "8 min",
    tags: ["facebook", "gids"],
  },
  {
    title: "Instagram-reacties modereren: gids voor automoderatie",
    description: "Verborgen woorden, Limieten en Beperken, wat ze missen, wat je nodig hebt om een tool te koppelen en hoe je automoderatie instelt.",
    slug: "instagram-comment-moderation",
    date: "2026-10-30",
    readTime: "8 min",
    tags: ["instagram", "gids"],
  },
  {
    title: "OpenAI Moderation API: omni-moderation-latest, categorieën, prijzen en grenzen",
    description: "Wat de OpenAI Moderation API detecteert, de 13 categorieën, het antwoordformaat, of hij gratis is en wat je zelf nog moet bouwen.",
    slug: "openai-moderation-api-guide",
    date: "2026-10-20",
    readTime: "6 min",
    tags: ["openai", "API", "gids"],
  },
  {
    title: "DSA-compliance voor kleine en middelgrote platforms: een praktische gids",
    description: "Een praktische gids voor kleinere platforms om te voldoen aan de Europese Digital Services Act: geautomatiseerde moderatie, audittrails en concrete stappen.",
    slug: "dsa-compliance-sme-guide",
    date: "2026-06-16",
    readTime: "8 min",
    tags: ["DSA", "compliance", "gids"],
  },
  {
    title: "Wat het kost om zelf contentmoderatie te bouwen: het overzicht voor 2026",
    description: "Post voor post: wat een eigen moderatiesysteem over drie jaar kost, van ontwikkeling en onderhoud tot AI-modellen, infrastructuur en DSA-compliance.",
    slug: "build-vs-buy-moderation",
    date: "2026-06-14",
    readTime: "9 min",
    tags: ["vergelijking", "zelf bouwen of kopen"],
  },
  {
    title: "Google Perspective API stopt: migratiegids voor forums",
    description: "Google stopt eind 2026 met de Perspective API. Zo migreer je je forum of community voor de deadline.",
    slug: "perspective-api-migration-guide",
    date: "2026-06-12",
    readTime: "7 min",
    tags: ["perspective", "migratie", "gids"],
  },
  {
    title: "OpenAI Moderation vs Azure vs Llama Guard: vergelijking 2026",
    description: "Een eerlijke vergelijking van de belangrijkste AI-moderatieproviders: prestaties, prijzen, taaldekking en wanneer je welke gebruikt.",
    slug: "openai-vs-azure-vs-llama-guard-comparison",
    date: "2026-06-10",
    readTime: "8 min",
    tags: ["vergelijking", "providers"],
  },
  {
    title: "DSA-compliance eenvoudig gemaakt voor reactiemoderatie",
    description: "Zo voldoe je aan de Europese Digital Services Act bij het modereren van reacties: schriftelijke redenen, volledige audittrail, transparantieverslagen en hosting in de EU.",
    slug: "dsa-compliance-open-source-moderation",
    date: "2026-06-08",
    readTime: "6 min",
    tags: ["DSA", "compliance", "transparantie"],
  },
  {
    title: "Contentmoderatie voor AI-toepassingen: een gids voor developers",
    description: "Zo filter je input en output van toepassingen op basis van LLM's. Best practices tegen prompt injection en voor veilige content.",
    slug: "ai-content-moderation-developer-guide",
    date: "2026-06-05",
    readTime: "10 min",
    tags: ["AI", "LLM", "gids"],
  },
  {
    title: "Maak kennis met OpenModeration, het centrale moderatieplatform",
    description: "We bouwen een moderatieplatform: onze eigen AI, gecontroleerd door andere modellen, met een schriftelijke reden bij elke beslissing.",
    slug: "introducing-open-moderation",
    date: "2026-06-01",
    readTime: "5 min",
    tags: ["aankondiging"],
  },
];
---

<BaseLayout title="Blog over contentmoderatie: DSA, AI-veiligheid en gidsen" description="Artikelen over contentmoderatie, DSA-compliance, AI-veiligheid en moderatie-infrastructuur: praktische gidsen voor communitymanagers en developers." jsonLd={blogJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Blog" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Over contentmoderatie, AI-veiligheid, DSA-compliance en het bouwen van moderatie-infrastructuur.
      </p>
    </div>
  </section>

  <section class="bg-white pb-16 pt-4 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a href={localizePath(`/blog/${post.slug}`, locale)} class="group lift om-card flex min-w-0 flex-col bg-white md:first:col-span-2 lg:first:col-span-3 first:bg-gradient-to-br first:from-violet-50 first:via-white first:to-brand-50">
            <div class="flex items-center gap-3 text-xs text-surface-400">
              <time datetime={post.date}>{new Date(post.date + "T00:00:00").toLocaleDateString("nl-NL", { year: "numeric", month: "long", day: "numeric" })}</time>
              <span>&middot;</span>
              <span>{post.readTime} lezen</span>
              <span>&middot;</span>
              {post.tags.map((tag) => (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-500">{tag}</span>
              ))}
            </div>
            <h2 class="mt-3 text-lg font-bold leading-snug text-surface-900 group-hover:text-brand-600 sm:text-xl">{post.title}</h2>
            <p class="mt-2 text-sm text-surface-500">{post.description}</p>
            <div class="mt-auto flex items-center gap-1 pt-4 text-sm font-medium text-brand-600">
              Lees meer
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
