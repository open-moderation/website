---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocale, localizePath } from '../../i18n/routes';
import { bookingUrl } from '../../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const BOOKING_URL = bookingUrl(locale);

const pricingJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "OpenModeration",
  "description": "Platform voor contentmoderatie met een gratis cloudabonnement, een Pro-abonnement voor € 99 per maand en Enterprise-abonnementen. On-premise installatie op aanvraag.",
  "inLanguage": "nl",
  "offers": [
    { "@type": "Offer", "name": "Gratis", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" },
    { "@type": "Offer", "name": "Pro", "price": "99", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" },
    { "@type": "Offer", "name": "Enterprise", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
  ]
};
---

<BaseLayout title="Prijzen: gratis, Pro € 99 per maand, Enterprise" description="Begin gratis met 1.000 geanalyseerde reacties per maand, Pro voor € 99 per maand met 10.000 reacties, of Enterprise op maat van je volumes." jsonLd={pricingJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: "Prijzen" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="flex items-center gap-1.5">
          
          Gemaakt en gehost in de EU
        </span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Eenvoudige, transparante prijzen</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Test gratis op je eigen reacties. Voor jouw volumes berekenen we samen een vast tarief: inrichting en moderatie van twijfelgevallen door ons team inbegrepen. Geen verborgen kosten.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={bookingUrl('nl')} target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">Plan een gesprek</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Gratis testen</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Free -->
        <div class="rounded-2xl border border-surface-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-surface-900">Gratis</h2>
              <p class="mt-1 text-xs text-surface-500">Beheerde cloud</p>
            </div>
            <span class="rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-700">Gratis</span>
          </div>
          <p class="mt-4 text-3xl font-bold text-surface-900">&euro; 0</p>
          <p class="mt-1 text-xs text-surface-500">Tot 1.000 geanalyseerde reacties per maand · ≈ 30 per dag</p>
          <ul class="mt-6 space-y-2 text-sm text-surface-600">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Alle functies inbegrepen</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Lastige gevallen gecontroleerd door andere AI’s</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Infrastructuur gehost in de EU</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Communitysupport</li>
          </ul>
          <a href="https://app.openmoderation.com/signup" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-surface-300 px-4 py-2.5 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Gratis beginnen
          </a>
          <p class="mt-3 text-center text-xs text-surface-400">Geen creditcard nodig · Altijd opzegbaar</p>
        </div>

        <!-- Pro -->
        <div class="relative rounded-2xl border-2 border-brand-500 bg-white p-6 shadow-md lg:col-span-1">
          <div class="absolute -top-3 right-4 rounded-full bg-brand-600 px-2.5 py-0.5 text-[10px] font-semibold text-white">Populair</div>
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-surface-900">Pro</h2>
              <p class="mt-1 text-xs text-surface-500">Volledig beheerde cloud</p>
            </div>
          </div>
          <p class="mt-4">
            <span class="text-3xl font-bold text-surface-900">&euro; 99</span>
            <span class="text-sm text-surface-400">/maand</span>
          </p>
          <p class="mt-1">
            <span class="text-sm text-surface-400">&euro; 990</span>
            <span class="text-sm text-surface-400">/jaar (bespaar ~17%)</span>
          </p>
          <ul class="mt-6 space-y-2 text-sm text-surface-600">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Beheerde hosting en infrastructuur</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> 10.000 geanalyseerde reacties per maand · ≈ 300 per dag</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Infrastructuur gehost in de EU</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> AI-modellen inbegrepen en up-to-date gehouden</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Prioriteitssupport en SLA</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Teambeheer en analyses</li>
          </ul>
          <a href="https://app.openmoderation.com/signup" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-brand-500 px-4 py-2.5 text-sm font-semibold text-brand-700 transition hover:bg-brand-50">
            Probeer Pro
          </a>
          <p class="mt-3 text-center text-xs text-surface-400">Geen creditcard nodig · Altijd opzegbaar</p>
        </div>

        <!-- Enterprise -->
        <div class="rounded-2xl border border-surface-200 bg-ink-900 p-6 text-white shadow-sm lg:col-span-1">
          <h2 class="text-lg font-bold text-white">Enterprise</h2>
          <p class="mt-1 text-xs text-surface-400">Op maat</p>
          <p class="mt-4 text-3xl font-bold">Op maat</p>
          <ul class="mt-6 space-y-2 text-sm text-surface-300">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Toegewijde infrastructuur</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> SLA op maat</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Volumes afgestemd op je publiek</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Inrichting en twijfelgevallen door ons team</li>
          </ul>
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-surface-900 shadow-sm transition hover:bg-surface-100">
            Plan een gesprek
          </a>
        </div>
      </div>

      <!-- On-premise banner -->
      <div class="mx-auto mt-12 max-w-3xl rounded-xl border border-surface-200 bg-surface-50 p-6">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          </div>
          <div class="flex-1">
            <h3 class="text-base font-semibold text-surface-900">On-premise installatie: op aanvraag</h3>
            <p class="mt-2 text-sm text-surface-500">
              Een on-premise installatie is mogelijk op aanvraag. Laten we het bespreken.
            </p>
            <a href={BOOKING_URL} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-brand-600 transition hover:text-brand-500">
              Laten we praten
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- EU badge -->
      <div class="mx-auto mt-8 max-w-lg rounded-xl border border-surface-200 bg-surface-50 p-5 text-center">
        <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-surface-100 px-3 py-1 text-xs font-medium text-surface-600">
          <span class="flex items-center gap-1.5">
            
            Gemaakt en gehost in de EU
          </span>
        </div>
        <p class="text-sm text-surface-500">Alle SaaS-abonnementen draaien op infrastructuur in Europese handen. Je gegevens verlaten de EU nooit, en de dienst voldoet aan de AVG.</p>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
