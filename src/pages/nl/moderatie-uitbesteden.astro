---
import SectorPage from '../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderatie uitbesteden: het alternatief voor een bureau"
  description="Op zoek naar een moderatiebureau of uitbestede moderatie? Vergelijk met AI-moderatie plus een vast team: je regels 24/7 toegepast, voor veel minder geld."
  crumb="Moderatie uitbesteden"
  parent={null}
  eyebrow="Moderatiediensten"
  h1="Besteed je moderatie uit, zonder bureaukosten"
  intro="Je reacties overlaten aan een moderatiebureau is duur en leunt op mensen die je redactionele lijn niet kennen. OpenModeration combineert AI die je regels dag en nacht toepast met een team dat je ondersteunt: het gemak van een uitbestede dienst, voor een fractie van de prijs."
  problem="Menselijke moderatiediensten rekenen af per volume of per bestede tijd, met vertraging 's nachts en in het weekend. Externe moderatoren inwerken in je regels kost tijd, en de kwaliteit verschilt per persoon."
  approach="We stemmen de moderatie af op je regels en je use cases. De AI behandelt elke reactie binnen enkele seconden, altijd op dezelfde manier. Grensgevallen worden afgehandeld door ons team, dat ook de regels met je bijstelt."
  result="Moderatie die sneller en consistenter is dan een extern team, 24/7 beschikbaar, met een schriftelijk verslag van elke beslissing en voorspelbare kosten."
  featuresTitle="Wat we voor je doen"
  featuresIntro="Je koopt geen tool die je zelf moet configureren: we zetten de moderatie samen met jou op, en we blijven betrokken."
  features={[
    { title: "Je regels omzetten in instructies", text: "We vertalen je regels naar duidelijke instructies en testen ze op je echte reacties voordat we ze inschakelen." },
    { title: "Opvolging en bijsturing", text: "We bekijken twijfelgevallen samen met jou en passen de regels aan als je publiek of de actualiteit verandert." },
    { title: "Moderatie 24/7", text: "'s Nachts, in het weekend en tijdens verkeerspieken worden reacties binnen enkele seconden afgehandeld." },
    { title: "Jij houdt het overzicht", text: "Gevoelige beslissingen blijven menselijk: ons team handelt de grensgevallen af, en jij ziet elke beslissing in realtime en kunt op elk moment ingrijpen." },
  ]}
  why={[
    { title: "Veel goedkoper", text: "Begeleide automatische moderatie kost een fractie van uitbestede menselijke moderatie." },
    { title: "Consistent en uitlegbaar", text: "Dezelfde regel geeft dezelfde beslissing, elke keer met een schriftelijke uitleg." },
    { title: "DSA-proof", text: "Motiveringen, meldingen van gebruikers en een volledige geschiedenis, zonder afhankelijk te zijn van de processen van een leverancier." },
  ]}
  faq={[
    { question: "Kan het een moderatiebureau volledig vervangen?", answer: "Voor de meeste reactieruimtes wel: de AI verwerkt het grootste deel van het volume en ons team handelt de grensgevallen af. Jij hoeft niets te doen. Bij zeer grote volumes of zeer gevoelige onderwerpen kan OpenModeration ook naast een bestaand menselijk team werken." },
    { question: "Wie regelt de configuratie?", answer: "Dat doen we samen met jou. In een eerste gesprek leren we je regels, je use cases en je gevoelige gevallen kennen, daarna testen we de regels op je reacties." },
    { question: "Hoe vergelijk ik de kosten?", answer: "Plan een gesprek en vertel ons je maandelijkse aantal reacties: we sturen je een offerte met prijzen om te vergelijken met je huidige leverancier." },
    { question: "Blijven de gegevens in Europa?", answer: "Ja. OpenModeration wordt ontwikkeld en gehost in de Europese Unie en voldoet aan de AVG." },
  ]}
  related={[
    { eyebrow: "Vergelijking", title: "Vergelijk moderatie-alternatieven", text: "Hoe OpenModeration zich verhoudt tot bureaus en andere moderatietools.", href: localizePath('/alternatives', locale) },
    { eyebrow: "Analyse", title: "Zelf bouwen of kopen?", text: "De echte kosten van moderatie zelf bouwen.", href: localizePath('/build-vs-buy', locale) },
    { eyebrow: "Use case", title: "Nieuwsuitgevers", text: "Hoe redacties hun reacties modereren.", href: localizePath('/use-cases/news-publishers', locale) },
  ]}
  ctaTitle="Vergelijk met je huidige leverancier."
  ctaSubtitle="Plan een gesprek en noem je aantal reacties: we laten je de moderatie zien en sturen je een offerte met prijzen."
/>
