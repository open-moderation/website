---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Logora",
  "description": "Creator of OpenModeration, the transparent content moderation platform.",
  "url": "https://www.openmoderation.com",
};
---

<BaseLayout title="About | OpenModeration" description="OpenModeration is built by Logora. Our mission is to make content moderation a transparent, standardized infrastructure layer." jsonLd={aboutJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "About" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">About</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        We're building the standardized infrastructure layer for content moderation.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="prose prose-surface mx-auto">
        <h2 class="text-2xl font-bold text-surface-900">Our mission</h2>
        <p class="mt-4 text-lg text-surface-500">
          Every online platform, from a small forum to a social network with millions of users,
          should be able to moderate comments with a single API call, using the best AI models available,
          without proprietary lock-in.
        </p>
        <p class="mt-4 text-lg text-surface-500">
          We believe content moderation is becoming as essential as authentication or payments.
          It should be a standardized infrastructure layer, not a custom build for every company.
        </p>

        <h2 class="mt-12 text-2xl font-bold text-surface-900">Why transparency?</h2>
        <p class="mt-4 text-lg text-surface-500">
          Moderation depends on trust, and nobody can trust a black box. That is why every OpenModeration
          decision comes with a written reason, and every AI and human action is kept in a full audit trail.
        </p>
        <p class="mt-4 text-lg text-surface-500">
          The moderation follows your own rules and use cases, and our team sets it up with you.
          Your data is hosted in the European Union, and you can export it at any time.
        </p>

        <h2 class="mt-12 text-2xl font-bold text-surface-900">Our approach</h2>
        <div class="mt-6 space-y-6">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">Developer-first design</h3>
            <p class="mt-2 text-sm text-surface-500">The APIs are clean, the responses are typed and the documentation is thorough. Developers built it for other developers.</p>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">Provider agnostic</h3>
            <p class="mt-2 text-sm text-surface-500">We don't favor any provider. Our routing engine picks the best option for each request, and users can always bring their own keys.</p>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">DSA-first compliance</h3>
            <p class="mt-2 text-sm text-surface-500">Built from the ground up with regulatory compliance in mind. Audit trails, data sovereignty, and transparency reporting are core features.</p>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">Hosted in the EU</h3>
            <p class="mt-2 text-sm text-surface-500">The platform is hosted in the European Union and you can export your data at any time. On-premise deployment is possible on request: <a href="https://calendly.com/jesuslogora/1h" class="text-brand-600 hover:text-brand-500" target="_blank" rel="noopener">let's talk</a>.</p>
          </div>
        </div>

        <h2 class="mt-12 text-2xl font-bold text-surface-900">The team</h2>
        <p class="mt-4 text-lg text-surface-500">
          OpenModeration is built by <a href="https://logora.com" class="font-bold text-surface-900 hover:text-brand-600" target="_blank" rel="noopener noreferrer">Logora</a>. We're a small team
          with long experience building APIs, content platforms and developer tools.
          We think moderation infrastructure should be transparent, standardized and
          available to every platform.
        </p>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>