---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TeamSection from '../components/TeamSection.astro';
import ClientLogos from '../components/ClientLogos.astro';
import { localizePath, type Locale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const locale: Locale = 'en';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "About OpenModeration: the Logora team, Paris since 2019",
  "description": "OpenModeration is built by Logora, an employee-owned company founded in Paris in 2019 that moderates comments for 23 publishers in Europe and Latin America.",
  "orgDescription": "AI comment moderation for news sites, brands, public bodies and platforms, adapted to each client’s rules. Built by Logora (Paris, 2019).",
  "crumb": "About",
  "h1": "The team that moderates your comments with you",
  "lead": "OpenModeration is built by Logora, an independent company founded in Paris in 2019 and owned by its employees. Eight people in Paris, Madrid and Berlin set up and run comment moderation for 23 publishers in Europe and Latin America.",
  "whoTitle": "Who we are",
  "who": [
    "Since 2019, we have been moderating reader comments for news publishers. Doing it every day taught us what media, brands and public bodies need: reliable decisions, a clear reason for each one, and people to turn to when a case is delicate.",
    "Our references include L’Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier and Egora. Logora is owned by the people who work there: we are accountable to our clients, not to investors."
  ],
  "whatTitle": "What OpenModeration is",
  "what": "AI comment moderation for news sites, brands, public bodies and platforms, adapted to your rules and use cases. You connect your pages; our AI, built in-house and trained on millions of messages over seven years, handles clear cases. Our team handles doubtful cases, user reports and contested decisions. You see every decision and its written reason in real time, and you can step in whenever you want.",
  "whatPoints": [
    "Your website, Facebook, Instagram, YouTube and WordPress; other networks added on request.",
    "Multilingual: each comment is analysed in its own language, including the languages of your audiences.",
    "Setup and moderation of doubtful cases by our team are included.",
    "Hosted in the European Union, in line with the GDPR."
  ],
  "disambiguation": "OpenModeration (openmoderation.com) is a Logora service. It is not related to OpenModerator, a separate project with a similar name.",
  "whyTitle": "Why we built it",
  "why": [
    {
      "title": "Because the DSA asks for explanations",
      "text": "Under the Digital Services Act, platforms that host comments must explain their moderation decisions, handle user reports and follow up appeals. OpenModeration is built for that: a written reason for every decision, a traceable history and exportable figures."
    },
    {
      "title": "Because good debate is worth protecting",
      "text": "Insults and spam drive away the readers who have something to say. Careful moderation protects your brand and keeps room for real discussion, without over-censoring the comments that make it lively."
    }
  ],
  "ctaTitle": "Meet the team",
  "ctaSubtitle": "Book a call: we look at your comments together and show you how the moderation would work on your pages."
};

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": "https://www.openmoderation.com/about",
  "url": "https://www.openmoderation.com/about",
  "name": "About OpenModeration: the Logora team, Paris since 2019",
  "description": "OpenModeration is built by Logora, an employee-owned company founded in Paris in 2019 that moderates comments for 23 publishers in Europe and Latin America.",
  "inLanguage": "en",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  },
  "mainEntity": {
    "@type": "Organization",
    "@id": "https://www.openmoderation.com/#organization",
    "name": "OpenModeration",
    "url": "https://www.openmoderation.com",
    "description": "AI comment moderation for news sites, brands, public bodies and platforms, adapted to each client’s rules. Built by Logora (Paris, 2019).",
    "parentOrganization": {
      "@type": "Organization",
      "name": "Logora",
      "url": "https://logora.com"
    },
    "founder": [
      {
        "@type": "Person",
        "name": "Pierre Laburthe-Tolra"
      },
      {
        "@type": "Person",
        "name": "Henry Boisgibault"
      }
    ],
    "sameAs": [
      "https://logora.com",
      "https://www.linkedin.com/company/logora"
    ]
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={aboutJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-3xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ClientLogos />
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.whoTitle}</h2>
      {c.who.map((p) => <p class="mt-4 text-lg text-surface-500">{p}</p>)}

      <h2 class="mt-12 text-2xl font-bold text-surface-900">{c.whatTitle}</h2>
      <p class="mt-4 text-lg text-surface-500">{c.what}</p>
      <ul class="mt-6 space-y-3">
        {c.whatPoints.map((p) => (
          <li class="flex items-start gap-3 text-surface-600"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-surface-400">{c.disambiguation}</p>

      <h2 class="mt-12 text-2xl font-bold text-surface-900">{c.whyTitle}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {c.why.map((w) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{w.title}</h3>
            <p class="mt-2 text-sm text-surface-500">{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TeamSection />

  <CTASection title={c.ctaTitle} subtitle={c.ctaSubtitle} />
</BaseLayout>
