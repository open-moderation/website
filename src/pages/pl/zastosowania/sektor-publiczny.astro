---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderacja dla samorządów i instytucji publicznych"
  description="Moderuj konsultacje społeczne, platformy partycypacji obywatelskiej i profile instytucji według publicznych zasad, z pisemnym uzasadnieniem każdej decyzji."
  crumb="Sektor publiczny"
  h1="Moderacja dla samorządów i instytucji publicznych"
  intro="Konsultacje społeczne, platformy partycypacyjne, profil miasta na Facebooku: debata publiczna potrzebuje przestrzeni otwartych, a zarazem bezpiecznych. OpenModeration stosuje Twoje zasady udziału do każdej wypowiedzi i uzasadnia każdą decyzję na piśmie, więc nikt nie może nazwać jej arbitralną cenzurą."
  problem="Konsultacje lokalnej inwestycji mogą w kilka dni przynieść setki wypowiedzi, a wśród nich obelgi wobec radnych lub urzędników, mowę nienawiści i wpisy nie na temat. Ręczna moderacja pochłania czas pracowników, a każde usunięcie można zakwestionować."
  approach="Dopasowujemy moderację do Twoich zasad udziału i przypadków użycia. Każda wypowiedź jest czytana w kontekście: obelgi i hejt są ukrywane, krytyka, nawet ostra, pozostaje opublikowana, a przypadkami granicznymi zajmuje się nasz zespół, z pisemnym uzasadnieniem, które Twoi pracownicy widzą w czasie rzeczywistym."
  result="Debata pozostaje otwarta i kulturalna, zespoły oszczędzają czas, a Ty w każdej chwili możesz pokazać, dlaczego dana wypowiedź została ukryta. Każda decyzja jest przechowywana w pełnej historii."
  featuresTitle="Stworzone dla debaty publicznej"
  featuresIntro="W przestrzeni publicznej sposób moderowania jest równie ważny jak jej wynik. Budujemy zasady razem z Tobą."
  features={[
    { title: "Publiczne zasady, stosowane tak, jak je zapisano", text: "Zasady, które publikujesz dla mieszkańców, to te same zasady, które stosuje AI. Żadnych ukrytych reguł." },
    { title: "Krytyka pozostaje możliwa", text: "Sprzeciw wobec inwestycji czy decyzji pozostaje widoczny. Ukrywane są tylko treści obraźliwe, nienawistne lub łamiące zasady." },
    { title: "Uzasadnienie każdej decyzji", text: "Każda ukryta wypowiedź ma przypisaną zasadę i pisemne uzasadnienie, które możesz przekazać jej autorowi." },
    { title: "Platforma i profile społecznościowe razem", text: "Twoje narzędzie partycypacyjne przez API oraz strony na Facebooku, Instagramie i YouTube w jednej konsoli." },
  ]}
  why={[
    { title: "Przejrzystość", text: "Każda decyzja jest uzasadniona i zapisana: przydaje się w odpowiedzi mieszkańcowi, radnemu lub podczas audytu." },
    { title: "Wsparcie ludzi", text: "Nasz zespół pomaga ustalić zasady i obsłużyć wrażliwe przypadki we współpracy z Twoimi wydziałami." },
    { title: "Hosting w UE", text: "Tworzone i hostowane w Unii Europejskiej, zgodne z RODO." },
  ]}
  faq={[
    { question: "Czy automatyczna moderacja to nie forma cenzury?", answer: "Stosuje wyłącznie zasady, które opublikowałeś, i uzasadnia każdą decyzję na piśmie. Wątpliwych przypadków nie rozstrzyga sama AI: zajmuje się nimi nasz zespół, a Twoi pracownicy mogą interweniować w każdej chwili." },
    { question: "Czy można moderować istniejącą platformę partycypacyjną?", answer: "Tak. Wypowiedzi mogą być przesyłane do OpenModeration przez API z Twojego narzędzia, obok profili w mediach społecznościowych." },
    { question: "Czy dane mieszkańców zostają w Europie?", answer: "Tak. OpenModeration jest tworzone i hostowane w Unii Europejskiej i jest zgodne z RODO." },
    { question: "Jak zacząć?", answer: "Umów rozmowę: wychodzimy od Twoich zasad udziału i przypadków użycia i testujemy je na prawdziwych wypowiedziach, zanim je włączymy." },
  ]}
  related={[
    { eyebrow: "Poradnik", title: "Jak spisać zasady moderacji", text: "Zasady, które warto ustalić przed automatyzacją, z przykładami.", href: localizePath('/content-moderation-policy', locale) },
    { eyebrow: "Platforma", title: "Każda decyzja uzasadniona", text: "Jak OpenModeration pisze uzasadnienie każdej decyzji moderacyjnej.", href: localizePath('/product/transparency', locale) },
    { eyebrow: "Integracja", title: "Moderacja komentarzy na Facebooku", text: "Komentarze pod postami Twojej instytucji.", href: localizePath('/integrations/facebook', locale) },
  ]}
  ctaTitle="Otwarta debata bez hejtu."
  ctaSubtitle="Umów rozmowę: wyjdziemy od Twoich zasad udziału i pokażemy moderację na Twoich prawdziwych wypowiedziach."
/>
