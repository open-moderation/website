---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderacja komentarzy dla marek luksusowych i modowych"
  description="Chroń wizerunek domu mody na Instagramie, Facebooku i YouTube: podróbki, oszustwa i hejt ukrywane według Twoich zasad, w każdym języku Twoich klientów."
  crumb="Luksus i moda"
  h1="Moderacja komentarzy dla branży luksusowej i modowej"
  intro="Dom mody ocenia się także po komentarzach pod jego postami. OpenModeration ukrywa podróbki, fałszywe konta, oszustwa i hejt według Twoich zasad, w każdym języku, którym mówią Twoi klienci, i zostawia rozmowy, które ożywiają społeczność."
  problem="Konta marek luksusowych przyciągają sprzedawców podróbek, fałszywe konta podszywające się pod markę, oszustwa z fikcyjnymi konkursami i fale hejtu przy okazji pokazów czy ogłoszeń ambasadorów. Wszystko to w kilkunastu językach, przez całą dobę."
  approach="Dopasowujemy moderację do Twoich zasad, Twoich przypadków użycia i tonu Twojej marki. AI czyta każdy komentarz w kontekście i w jego własnym języku: podróbki, linki do oszustw i ataki znikają od razu, a delikatne przypadki trafiają do zespołu z pisemnym uzasadnieniem."
  result="Twoje posty pozostają godne marki na całym świecie, bez zespołu pilnującego wątków dzień i noc. Każda decyzja jest zapisywana, co ułatwia współpracę z działem prawnym i zespołem komunikacji."
  featuresTitle="Stworzone dla międzynarodowych domów mody"
  featuresIntro="Wizerunku marki nie da się chronić listą zakazanych słów. Budujemy moderację razem z Tobą."
  features={[
    { title: "Podróbki i fałszywe konta", text: "Wiadomości prowadzące do replik, fałszywych sklepów lub kont podszywających się pod markę są wychwytywane i ukrywane." },
    { title: "Każdy język Twoich klientów", text: "Jeden zestaw zasad dla komentarzy po polsku, angielsku, francusku, chińsku, arabsku, włosku czy japońsku." },
    { title: "Wrażliwe momenty pod kontrolą", text: "Pokaz, premiera, ambasador w ogniu krytyki: zaostrz zasady na jakiś czas, a potem wróć do normalnych ustawień." },
    { title: "Jedna konsola dla wszystkich regionów", text: "Zespół w każdym kraju widzi przypadki, które go dotyczą, wraz z zastosowaną zasadą i pisemnym uzasadnieniem." },
  ]}
  why={[
    { title: "Twój ton, Twoje zasady", text: "Moderacja podąża za Twoimi zasadami i wizerunkiem, a nie za ogólnym szablonem. Dostrajamy ją razem z Tobą." },
    { title: "Dedykowane wsparcie", text: "Nasz zespół współpracuje z Twoimi zespołami social media przy rozstrzyganiu przypadków granicznych i śledzeniu wyników." },
    { title: "Hosting w UE", text: "Tworzone i hostowane w Unii Europejskiej, zgodne z RODO, z pełną historią każdej decyzji." },
  ]}
  faq={[
    { question: "Czy moderacja działa w każdym języku?", answer: "Tak. AI czyta komentarze w oryginalnym języku i stosuje te same zasady, więc nie trzeba pisać reguł osobno dla każdego języka." },
    { question: "Czy różne rynki mogą mieć różne zasady?", answer: "Tak. Każde konto lub strona może mieć własne zasady, na przykład ostrzejsze na wrażliwym rynku albo w czasie premiery." },
    { question: "Co dzieje się z wątpliwym komentarzem?", answer: "Nie jest ani ukrywany, ani publikowany automatycznie: weryfikuje go nasz zespół, mając przed sobą uzasadnienie AI. Ty widzisz decyzję w czasie rzeczywistym i możesz ją zmienić jednym kliknięciem." },
    { question: "Jak wygląda wdrożenie?", answer: "Zaczynamy od rozmowy, aby poznać Twoje zasady, przypadki użycia i sytuacje wrażliwe, a następnie testujemy zasady na Twoich prawdziwych komentarzach, zanim je włączymy." },
  ]}
  related={[
    { eyebrow: "Integracja", title: "Moderacja komentarzy na Instagramie", text: "Komentarze pod postami i Rolkami moderowane według Twoich zasad.", href: localizePath('/integrations/instagram', locale) },
    { eyebrow: "Integracja", title: "Moderacja komentarzy na YouTube", text: "Komentarze pod filmami z pokazów i kampanii.", href: localizePath('/integrations/youtube', locale) },
    { eyebrow: "Platforma", title: "Każda decyzja uzasadniona", text: "Jak OpenModeration pisze uzasadnienie każdej decyzji moderacyjnej.", href: localizePath('/product/transparency', locale) },
  ]}
  ctaTitle="Komentarze godne Twojej marki."
  ctaSubtitle="Umów rozmowę: razem przejrzymy komentarze pod Twoimi ostatnimi postami i pokażemy, co zrobiłaby moderacja."
/>
