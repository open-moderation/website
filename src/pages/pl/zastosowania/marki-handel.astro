---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Moderacja komentarzy dla marek i handlu"
  description="Moderuj komentarze pod postami marki na Facebooku, Instagramie i YouTube według własnych zasad. Spam, oszustwa i obelgi ukryte, a krytyka klientów widoczna."
  crumb="Marki i handel"
  h1="Moderacja komentarzy dla marek i handlu"
  intro="Pod każdym postem marki prawdziwi klienci sąsiadują ze spamem, fałszywymi kontami, oszustwami i obelgami. OpenModeration ukrywa według Twoich zasad to, co szkodzi wizerunkowi, zostawia widoczną uczciwą krytykę i wskazuje wiadomości, na które zespół powinien odpowiedzieć."
  problem="Udana kampania przyciąga setki komentarzy w kilka godzin, często wieczorem i w weekendy. Natywne filtry Meta i YouTube blokują słowa, a nie intencje: fałszywe konkursy i linki do oszustw przechodzą, a klienci z prawdziwym problemem bywają ukrywani."
  approach="AI rozumiejąca kontekst czyta każdy komentarz w świetle zasad Twojej marki. Spam, oszustwa, hejt i ataki osobiste znikają od razu. Reklamacje, pytania o zamówienia i krytyka pozostają widoczne i trafiają do zespołu."
  result="Community manager nie spędza już wieczorów na sprzątaniu wątków. Klienci widzą markę, która odpowiada, a nie stronę zalaną spamem, a każdy ukryty komentarz ma pisemne uzasadnienie, gdyby ktoś zapytał."
  featuresTitle="Stworzone dla zespołów social media"
  featuresIntro="Konfigurujemy moderację razem z Tobą, na podstawie Twoich zasad i sytuacji, z którymi Twoja marka naprawdę się mierzy."
  features={[
    { title: "Krytyka to nie obelga", text: "Niezadowolony klient pozostaje widoczny i może dostać odpowiedź. Ukrywane są tylko komentarze obraźliwe, nienawistne lub oszukańcze." },
    { title: "Fałszywe konkursy i linki do oszustw", text: "Konta podszywające się pod markę, by obiecywać nagrody lub kierować na fałszywe strony, są wychwytywane i ukrywane automatycznie." },
    { title: "Wszystkie strony w jednym miejscu", text: "Facebook, Instagram, YouTube i Twoja strona na WordPressie trafiają do tej samej konsoli z tymi samymi zasadami, niezależnie od tego, czy prowadzisz jedną stronę, czy pięćdziesiąt." },
    { title: "Zasady dla każdej kampanii", text: "Premiera, kryzys czy współpraca mogą wymagać ostrzejszych zasad. Zmieniasz je zwykłym językiem, bez kodu." },
  ]}
  why={[
    { title: "Twoje zasady, stosowane tak, jak je zapisano", text: "Bez ogólnej listy słów kluczowych: moderacja podąża za tym, co napisałeś, a my dostrajamy ją z Tobą kampania po kampanii." },
    { title: "Ludzie za narzędziem", text: "Nasz zespół pomaga spisać zasady i rozstrzygać przypadki graniczne. Nigdy nie zostajesz sam z narzędziem." },
    { title: "Dużo taniej niż agencja", text: "Moderacja działa automatycznie dzień i noc, za ułamek kosztu moderacji zleconej na zewnątrz." },
  ]}
  faq={[
    { question: "Czy negatywne komentarze są usuwane?", answer: "Nie. Krytyka, nawet ostra, pozostaje widoczna, jeśli jest zgodna z Twoimi zasadami. Ukrywane są obelgi, hejt, spam i oszustwa. To Ty decydujesz, gdzie przebiega granica." },
    { question: "Komentarze są usuwane czy ukrywane?", answer: "Na Facebooku i Instagramie komentarze są ukrywane: autor i jego znajomi nadal je widzą, reszta odbiorców już nie. Możesz je przywrócić jednym kliknięciem w konsoli." },
    { question: "Ile trwa uruchomienie?", answer: "Podłączenie strony zajmuje kilka minut. Następnie umawiamy rozmowę, aby dopasować moderację do Twoich zasad i przypadków użycia oraz przetestować ją na prawdziwych komentarzach." },
    { question: "Gdzie są przechowywane dane?", answer: "OpenModeration jest tworzone i hostowane w Unii Europejskiej i jest zgodne z RODO." },
  ]}
  related={[
    { eyebrow: "Integracja", title: "Moderacja komentarzy na Facebooku", text: "Podłącz strony na Facebooku i automatycznie ukrywaj komentarze łamiące Twoje zasady.", href: localizePath('/integrations/facebook', locale) },
    { eyebrow: "Integracja", title: "Moderacja komentarzy na Instagramie", text: "Komentarze pod postami i Rolkami moderowane według tych samych zasad.", href: localizePath('/integrations/instagram', locale) },
    { eyebrow: "Poradnik", title: "Jak spisać zasady moderacji", text: "Zasady, które warto ustalić przed automatyzacją, z przykładami.", href: localizePath('/content-moderation-policy', locale) },
  ]}
  ctaTitle="Czysta strona marki bez poświęcania wieczorów."
  ctaSubtitle="Umów rozmowę: razem przejrzymy Twoje komentarze i pokażemy, co zrobiłaby moderacja."
/>
