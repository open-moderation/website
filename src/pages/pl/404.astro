---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<BaseLayout
  title="Nie znaleziono strony | OpenModeration"
  description="Strona, której szukasz, nie istnieje lub została przeniesiona."
  robots="noindex, nofollow"
>
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Nie znaleziono strony</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-surface-500">
        Strona, której szukasz, nie istnieje lub została przeniesiona.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={localizePath('/', locale)} class="rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">
          Wróć na stronę główną
        </a>
        <a href={localizePath('/features', locale)} class="rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">
          Zobacz funkcje
        </a>
        <a href={localizePath('/pricing', locale)} class="rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">
          Zobacz cennik
        </a>
      </div>
      <div class="mx-auto mt-10 max-w-md text-sm text-surface-500">
        <p class="font-semibold text-surface-700">Popularne strony</p>
        <p class="mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
          <a href={localizePath('/how-it-works', locale)} class="text-brand-600 hover:text-brand-500">Jak to działa</a>
          <a href={localizePath('/product/transparency', locale)} class="text-brand-600 hover:text-brand-500">Przejrzystość</a>
          <a href={localizePath('/dsa-compliance', locale)} class="text-brand-600 hover:text-brand-500">Zgodność z DSA</a>
          <a href={localizePath('/faq', locale)} class="text-brand-600 hover:text-brand-500">FAQ</a>
          <a href={localizePath('/blog', locale)} class="text-brand-600 hover:text-brand-500">Blog</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
