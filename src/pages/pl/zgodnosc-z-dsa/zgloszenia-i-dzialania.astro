---
import SectorPage from '../../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Art. 16 DSA: mechanizm zgłaszania i działania"
  description="Art. 16 DSA w praktyce: co musi zapewniać mechanizm zgłaszania i działania, co zawiera prawidłowe zgłoszenie i jak obsłużyć oraz zapisać każde zgłoszenie."
  crumb="Zgłaszanie i działanie (art. 16)"
  parent={{ label: "Zgodność z DSA", href: localizePath('/dsa-compliance', locale) }}
  eyebrow="DSA, art. 16"
  h1="Mechanizm zgłaszania i działania w DSA: obsługa zgłoszeń użytkowników"
  intro="Art. 16 aktu o usługach cyfrowych (rozporządzenie (UE) 2022/2065) zobowiązuje każdego dostawcę usług hostingu, w tym serwis publikujący komentarze, do umożliwienia każdemu zgłoszenia nielegalnych treści, a następnie do starannego rozpatrzenia zgłoszenia i poinformowania osoby, która je przesłała, o podjętej decyzji."
  problem="Wiele serwisów ma przycisk „zgłoś”, za którym nic nie stoi: brak kolejki do rozpatrywania, brak potwierdzenia otrzymania, brak zapisu decyzji. Gdy regulator przeprowadza kontrolę lub decyzja zostaje zakwestionowana, nie da się wykazać, że zgłoszenia zostały obsłużone."
  approach="W OpenModeration każde zgłoszenie trafia do tej samej konsoli co moderacja automatyczna. Jest oceniane pod kątem Twoich zasad, rozstrzygane automatycznie lub przez nasz zespół, widoczne dla Ciebie w czasie rzeczywistym, a decyzja trafia do rejestru audytowego wraz z pisemnym uzasadnieniem."
  result="Dla każdego zgłoszenia możesz wykazać, kiedy wpłynęło, kto lub co je obsłużyło, co postanowiono i dlaczego. Te same dane zasilają też Twój raport przejrzystości."
  featuresTitle="Czego wymaga art. 16"
  featuresIntro="Najważniejsze elementy obowiązku i to, jak OpenModeration pomaga je spełnić. To podsumowanie nie stanowi porady prawnej."
  features={[
    { title: "Łatwo dostępny mechanizm elektroniczny", text: "Każdy musi mieć możliwość prostego zgłoszenia treści, które uważa za nielegalne, z poziomu Twojej strony lub aplikacji." },
    { title: "Wystarczająco precyzyjne zgłoszenie", text: "Zgłoszenie musi wskazywać treść (jej dokładny adres URL), wyjaśniać, dlaczego jest ona rzekomo nielegalna, i co do zasady zawierać imię i nazwisko oraz adres e-mail zgłaszającego, a także oświadczenie o działaniu w dobrej wierze." },
    { title: "Terminowe, staranne, niearbitralne i obiektywne rozpatrzenie", text: "Zgłoszenia muszą być rozpatrywane w odpowiednim czasie. Jeśli wykorzystywane są środki zautomatyzowane, osoba zgłaszająca musi zostać o tym poinformowana." },
    { title: "Potwierdzenie otrzymania i powiadomienie o decyzji", text: "Zgłaszający otrzymuje potwierdzenie, a następnie informację o podjętej decyzji i dostępnych środkach odwoławczych. Autor treści otrzymuje uzasadnienie (art. 17)." },
  ]}
  why={[
    { title: "Jedno miejsce", text: "Zgłoszenia użytkowników i moderacja automatyczna są obsługiwane w jednym miejscu, według tych samych zasad. Zgłoszenia rozpatruje nasz zespół." },
    { title: "Wszystko jest zapisywane", text: "Otrzymanie, decyzja, uzasadnienie i osoba obsługująca trafiają do rejestru audytowego." },
    { title: "Praktyczne wsparcie", text: "Pomagamy podłączyć Twój przycisk zgłaszania do OpenModeration i napisać politykę moderacji." },
  ]}
  faq={[
    { question: "Czy art. 16 dotyczy serwisu informacyjnego?", answer: "Tak, gdy tylko publikuje on treści zamieszczane przez użytkowników, na przykład komentarze. Działa wówczas jako usługa hostingu w rozumieniu DSA." },
    { question: "Czy trzeba odpowiadać na każde zgłoszenie?", answer: "Tak. DSA wymaga potwierdzenia otrzymania, jeśli zgłaszający podał dane kontaktowe, a następnie informacji o podjętej decyzji i możliwych środkach odwoławczych." },
    { question: "Czy zgłoszenia można rozpatrywać automatycznie?", answer: "Tak, pod warunkiem że zgłaszający zostanie o tym poinformowany, a decyzja pozostaje obiektywna i uzasadniona. W OpenModeration o wątpliwych przypadkach decyduje nasz zespół, a Ty możesz w każdej chwili interweniować." },
    { question: "Jak ma się to do uzasadnienia decyzji?", answer: "Gdy zgłoszenie prowadzi do usunięcia lub ukrycia treści, art. 17 wymaga przedstawienia jej autorowi uzasadnienia. OpenModeration przygotowuje takie uzasadnienie dla każdej decyzji." },
  ]}
  related={[
    { eyebrow: "DSA", title: "Uzasadnienie decyzji (art. 17)", text: "Co musi zawierać, wraz z przykładem.", href: localizePath('/dsa-compliance/statement-of-reasons', locale) },
    { eyebrow: "DSA", title: "Zgodność z DSA", text: "Przegląd obowiązków i tego, co obejmuje OpenModeration.", href: localizePath('/dsa-compliance', locale) },
    { eyebrow: "Poradnik", title: "DSA dla MŚP", text: "Praktyczny poradnik dla małych i średnich platform.", href: localizePath('/blog/dsa-compliance-sme-guide', locale) },
  ]}
  ctaTitle="Zgłoszenia obsłużone i udokumentowane, bez kłopotu."
  ctaSubtitle="Umów rozmowę: przeanalizujemy Twoje obecne rozwiązanie i wskażemy, czego brakuje do zgodności."
/>
