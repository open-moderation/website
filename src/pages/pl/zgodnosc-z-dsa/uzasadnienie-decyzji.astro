---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Uzasadnienie decyzji (art. 17 DSA): kto musi je przekazać i co musi zawierać",
  "description": "Czego art. 17 aktu o usługach cyfrowych (DSA) wymaga przy każdym usunięciu treści: kto musi przekazać uzasadnienie, kiedy, z jakimi informacjami, wraz z przykładem.",
  "inLanguage": "pl",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/pl/zgodnosc-z-dsa/uzasadnienie-decyzji" }
};

const contents = [
  { letter: "a", title: "Podjęty środek", text: "Usunięcie, uniemożliwienie dostępu, obniżenie pozycji lub ograniczenie widoczności, zawieszenie płatności pieniężnych albo inny środek, a w stosownych przypadkach jego zasięg terytorialny i okres obowiązywania." },
  { letter: "b", title: "Fakty i okoliczności", text: "Na czym opiera się decyzja, w tym czy wynika ze zgłoszenia (art. 16), czy z dobrowolnego postępowania wyjaśniającego z własnej inicjatywy. Tożsamość zgłaszającego podaje się tylko wtedy, gdy jest to bezwzględnie konieczne." },
  { letter: "c", title: "Użycie zautomatyzowanych środków", text: "W stosownych przypadkach informacja, że decyzję podjęto przy użyciu zautomatyzowanych środków albo że dotyczy treści wykrytych lub zidentyfikowanych za pomocą takich środków." },
  { letter: "d", title: "Podstawa prawna", text: "Jeśli treść uznano za nielegalną: przywołana podstawa prawna oraz wyjaśnienie, dlaczego na tej podstawie treść uznano za nielegalną." },
  { letter: "e", title: "Postanowienie warunków korzystania z usług", text: "Jeśli treść uznano za niezgodną z Twoimi warunkami korzystania z usług: przywołana podstawa umowna oraz wyjaśnienie, dlaczego treść jest z nią niezgodna." },
  { letter: "f", title: "Dostępne środki odwoławcze", text: "Jasne i przyjazne dla użytkownika informacje o dostępnych środkach: wewnętrzny system rozpatrywania skarg, pozasądowe rozstrzyganie sporów, droga sądowa." },
];

const faqItems = [
  {
    question: "Czym jest uzasadnienie w rozumieniu DSA?",
    answer: "To wyjaśnienie, które zgodnie z art. 17 rozporządzenia (UE) 2022/2065, czyli aktu o usługach cyfrowych, należy przekazać użytkownikowi, którego treść usunięto, do której uniemożliwiono dostęp, której pozycję obniżono lub której widoczność ograniczono, a także w razie zawieszenia konta, usługi lub płatności pieniężnych.",
  },
  {
    question: "Czy serwis informacyjny moderujący komentarze musi spełniać ten obowiązek?",
    answer: "Tak. Gdy tylko przechowuje komentarze publikowane przez czytelników, działa jako dostawca usług hostingu tych treści. Art. 17 dotyczy wszystkich dostawców usług hostingu, w tym małych firm.",
  },
  {
    question: "Czy uzasadnienie jest potrzebne przy każdym usuniętym komentarzu?",
    answer: "Tak, przy każdym ograniczeniu nałożonym dlatego, że treść jest nielegalna lub niezgodna z Twoimi warunkami korzystania z usług, o ile znasz elektroniczne dane kontaktowe autora. Obowiązek nie dotyczy wprowadzających w błąd treści komercyjnych o dużej objętości ani nakazów organów wydanych na podstawie art. 9.",
  },
  {
    question: "Czy uzasadnienia trzeba przesyłać do Komisji Europejskiej?",
    answer: "Dostawcy platform internetowych muszą bez zbędnej zwłoki przekazywać swoje decyzje i uzasadnienia Komisji w celu umieszczenia ich w publicznie dostępnej bazie danych, bez żadnych danych osobowych (art. 24 ust. 5). Mikroprzedsiębiorstwa i małe przedsiębiorstwa są z tego zwolnione na mocy art. 19, chyba że zostały wyznaczone jako bardzo duże platformy internetowe.",
  },
  {
    question: "Jakie kary grożą za brak zgodności?",
    answer: "DSA pozostawia ustalanie kar państwom członkowskim, ale ogranicza maksymalną karę za niewywiązanie się z obowiązku do 6% rocznego światowego obrotu dostawcy (art. 52).",
  },
];
---

<BaseLayout title="Uzasadnienie decyzji w DSA (art. 17): zasady i przykład" description="Czego art. 17 DSA wymaga przy każdym usunięciu treści lub komentarza: kogo dotyczy, kiedy poinformować autora, sześć wymaganych elementów i przykład." ogType="article" jsonLd={articleJsonLd}>
  <Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "Zgodność z DSA", href: localizePath('/dsa-compliance', locale) }, { label: "Uzasadnienie decyzji" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">20 października 2026</time>
        <span>&middot;</span>
        <span>7 min czytania</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Uzasadnienie w DSA: czego art. 17 wymaga przy każdym usunięciu treści</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        Odkąd stosuje się akt o usługach cyfrowych (DSA), samo usunięcie komentarza nie wystarcza:
        trzeba poinformować autora, dlaczego to zrobiono. Art. 17 nazywa to wyjaśnienie „uzasadnieniem” i określa jego minimalną
        treść. Poniżej: kogo dotyczy ten obowiązek, kiedy ma zastosowanie, co musi zawierać uzasadnienie i jak może wyglądać.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Kto musi przekazać uzasadnienie?</h2>
      <p>
        Obowiązek spoczywa na <strong>dostawcach usług hostingu</strong>, czyli każdej usłudze, która przechowuje
        informacje przekazane przez użytkowników: sieciach społecznościowych, forach, platformach handlowych, ale także serwisach
        informacyjnych i blogach z komentarzami czytelników. W przeciwieństwie do niektórych innych obowiązków z DSA art. 17
        nie przewiduje zwolnienia dla mikroprzedsiębiorstw i małych przedsiębiorstw.
      </p>

      <h2 class="text-xl font-bold text-surface-900">W jakich przypadkach?</h2>
      <p>
        Uzasadnienie należy się każdemu użytkownikowi dotkniętemu ograniczeniem nałożonym dlatego, że jego treść jest nielegalna
        lub niezgodna z Twoimi warunkami korzystania z usług. Przepis obejmuje cztery rodzaje ograniczeń:
      </p>
      <ul>
        <li>każde ograniczenie widoczności treści: usunięcie, uniemożliwienie dostępu lub obniżenie pozycji;</li>
        <li>zawieszenie, zakończenie lub inne ograniczenie płatności pieniężnych;</li>
        <li>całkowite lub częściowe zawieszenie albo zakończenie świadczenia usługi;</li>
        <li>zawieszenie lub usunięcie konta użytkownika.</li>
      </ul>
      <p>
        Obowiązek ma zastosowanie, gdy znasz elektroniczne dane kontaktowe użytkownika, najpóźniej od chwili
        nałożenia ograniczenia. Nie obejmuje wprowadzających w błąd treści komercyjnych o dużej objętości ani
        nakazów organów wydanych na podstawie art. 9.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Sześć wymaganych elementów</h2>
      <p>Art. 17 ust. 3 wymienia informacje, które uzasadnienie musi zawierać co najmniej:</p>
    </div>

    <div class="mt-6 space-y-3">
      {contents.map((c) => (
        <div class="flex items-start gap-4 rounded-lg border border-surface-200 bg-surface-50 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-mono text-sm font-semibold text-brand-700">{c.letter}</span>
          <div>
            <p class="text-sm font-medium text-surface-900">{c.title}</p>
            <p class="mt-1 text-sm text-surface-500">{c.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <p>
        Informacje te muszą być „jasne i łatwo zrozumiałe”, możliwie precyzyjne i konkretne oraz
        pozwalać użytkownikowi skutecznie skorzystać ze środków odwoławczych (ust. 4).
      </p>

      <h2 class="text-xl font-bold text-surface-900">A platformy internetowe?</h2>
      <p>
        Dostawcy platform internetowych mają jeszcze jeden obowiązek: bez zbędnej zwłoki przekazywać swoje decyzje i uzasadnienia
        Komisji Europejskiej w celu umieszczenia ich w publicznie dostępnej bazie danych. Przekazywane informacje
        nie mogą zawierać danych osobowych (art. 24 ust. 5). Mikroprzedsiębiorstwa i małe przedsiębiorstwa są
        z tego zwolnione na mocy art. 19, chyba że zostały wyznaczone jako bardzo duże platformy internetowe.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Przykładowe uzasadnienie usunięcia komentarza</h2>
      <p>Fikcyjny przykład do dostosowania do Twojej usługi i Twoich warunków korzystania z usług:</p>
    </div>

    <div class="mt-6 rounded-xl border border-surface-200 bg-white p-6 text-sm leading-relaxed text-surface-700 shadow-sm">
      <p>Dzień dobry,</p>
      <p class="mt-3"><strong>Podjęty środek:</strong> Twój komentarz opublikowany 14 października 2026 r. pod artykułem „…” został usunięty. Nie dotyczy to Twojego konta.</p>
      <p class="mt-3"><strong>Powód:</strong> komentarz zawiera obelgę wymierzoną w innego czytelnika, co narusza pkt 4 naszych zasad społeczności („Szacunek dla innych uczestników”).</p>
      <p class="mt-3"><strong>Sposób podjęcia decyzji:</strong> komentarz został wykryty przez narzędzie do automatycznej analizy, a decyzję potwierdził następnie moderator.</p>
      <p class="mt-3"><strong>Środki odwoławcze:</strong> jeśli uważasz, że decyzja jest nieuzasadniona, możesz ją zakwestionować, odpowiadając na tę wiadomość w ciągu sześciu miesięcy. Możesz też zwrócić się do certyfikowanego organu pozasądowego rozstrzygania sporów lub wystąpić na drogę sądową.</p>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Jak OpenModeration pomaga przygotowywać uzasadnienia</h2>
      <ul>
        <li><strong>Pisemny powód każdej decyzji.</strong> Każdy odrzucony komentarz otrzymuje pisemne wyjaśnienie w wybranym przez Ciebie języku, które stanowi podstawę uzasadnienia (lit. e lub d).</li>
        <li><strong>Rola automatyzacji, udokumentowana.</strong> Dziennik aktywności pokazuje, czy decyzja pochodzi od AI, czy od moderatora, i od którego (lit. b i c).</li>
        <li><strong>Dane gotowe do wysłania.</strong> API i webhooki zwracają werdykt, kategorię i powód dla każdej treści: możesz umieścić je w wiadomości do autora.</li>
        <li><strong>Pełna historia.</strong> Każda decyzja, automatyczna lub ludzka, pozostaje w rejestrze audytowym na potrzeby raportów i audytów.</li>
      </ul>
      <p>
        Informacje o środkach odwoławczych i dokładna podstawa prawna pozostają po Twojej stronie: zależą od Twojej
        usługi, Twoich warunków korzystania z usług i obowiązującego prawa.
      </p>
      <p class="text-sm text-surface-400">
        Źródło: <a href="https://eur-lex.europa.eu/legal-content/PL/TXT/?uri=CELEX:32022R2065" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Rozporządzenie Parlamentu Europejskiego i Rady (UE) 2022/2065 z dnia 19 października 2022 r. w sprawie jednolitego rynku usług cyfrowych</a>, Dz.U. UE L 277 z 27.10.2022, art. 17, 19, 24 i 52. Ta strona ma charakter wyłącznie informacyjny i nie stanowi porady prawnej.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="Najczęściej zadawane pytania" items={faqItems} />
    </div>
  </article>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Dowiedz się więcej</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/content-moderation-policy', locale)} class="font-medium text-brand-600 hover:text-brand-500">Polityka moderacji treści: przewodnik i szablon &rarr;</a></li>
        <li><a href={localizePath('/dsa-compliance', locale)} class="font-medium text-brand-600 hover:text-brand-500">Zgodność z DSA dzięki OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/product/transparency', locale)} class="font-medium text-brand-600 hover:text-brand-500">Każda decyzja wyjaśniona na piśmie &rarr;</a></li>
        <li><a href={localizePath('/use-cases/news-publishers', locale)} class="font-medium text-brand-600 hover:text-brand-500">Moderacja komentarzy dla wydawców i mediów &rarr;</a></li>
        <li><a href={localizePath('/blog/dsa-compliance-sme-guide', locale)} class="font-medium text-brand-600 hover:text-brand-500">DSA dla MŚP: praktyczny przewodnik &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Uzasadnienie dla każdego usuniętego komentarza." subtitle="OpenModeration zapisuje powód każdej decyzji i informację, kto ją podjął. Start za darmo." />
</BaseLayout>
