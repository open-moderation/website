---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pl/integracje/moderacja-youtube",
  "url": "https://www.openmoderation.com/pl/integracje/moderacja-youtube",
  "name": "Platforma do moderacji komentarzy na YouTube | OpenModeration",
  "description": "Moderacja komentarzy na YouTube na dużą skalę z AI. Każdy komentarz jest automatycznie publikowany, wstrzymywany do przeglądu lub odrzucany zgodnie z Twoimi regułami.",
  "inLanguage": "pl"
};

const faqItems = [
  {
    question: "Jak działa moderacja komentarzy na YouTube?",
    answer: "Kanał na YouTube łączy się przez YouTube Data API. Komentarze są pobierane i analizowane przez AI. Zgodnie z Twoimi regułami każdy komentarz jest publikowany, wstrzymywany do przeglądu lub odrzucany."
  },
  {
    question: "Czy konfiguracja jest prosta?",
    answer: "Tak. Cała konfiguracja odbywa się w konsoli. Wystarczy połączyć kanał na YouTube i ustawić reguły przełącznikami lub zwykłym językiem, a moderacja od razu obejmuje Twoje filmy."
  },
  {
    question: "Co wykrywa moderacja YouTube?",
    answer: "Mowę nienawiści, nękanie, spam, treści NSFW, dane osobowe, oszustwa, phishing, wulgaryzmy, treści o samookaleczeniach, wydźwięk, tematy drażliwe i ryzykowne linki, a każdy komentarz jest analizowany w swoim języku."
  },
  {
    question: "Czy potrzebna jest wiedza techniczna?",
    answer: "Nie. OpenModeration jest zaprojektowane z myślą o twórcach i community managerach. Reguły zapisuje się w konsoli zwykłym językiem, bez żadnego kodu."
  },
  {
    question: "Czy można przejrzeć oznaczone komentarze przed ich usunięciem?",
    answer: "Tak. Przypadki graniczne weryfikuje nasz zespół, a Ty widzisz każdą decyzję i możesz ją zmienić. Każde działanie jest rejestrowane."
  },
];
---

<BaseLayout title="Moderacja komentarzy na YouTube z AI | OpenModeration" description="Moderuj komentarze na YouTube z AI: odrzucaj toksyczne, wstrzymuj graniczne do przeglądu, wielojęzyczność. Moderacja YouTube dla twórców i marek, bez kodu." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "Integracje", href: localizePath('/connectors', locale) }, { label: "Moderacja YouTube" }]} />
  <section class="bg-gradient-to-b from-red-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-red-100 text-red-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderacja komentarzy na YouTube</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Moderuj komentarze na YouTube na dużą skalę z pomocą AI. Konfiguracja nie wymaga kodu i zajmuje kilka minut.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={localizePath('/book-a-call', locale)} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Umów rozmowę</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Wypróbuj za darmo</a>
        <a href={localizePath('/how-it-works', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Jak to działa</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Zacznij moderować w 3 krokach</h2>
        <p class="mt-4 text-lg text-surface-500">Start w kilka minut, bez żadnych prac programistycznych.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Załóż konto</h3>
          <p class="mt-2 text-sm text-surface-500">Zarejestruj się za darmo, bez karty kredytowej. Dane są przechowywane w UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Połącz YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Połącz kanał na YouTube za pomocą własnych danych dostępowych do Data API. Konektor automatycznie pobiera komentarze.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Wspólnie ustalamy reguły</h3>
          <p class="mt-2 text-sm text-surface-500">Ustalamy z Tobą reguły moderacji. Nasza AI zajmuje się jasnymi przypadkami, nasz zespół wątpliwymi, a Ty widzisz każdą decyzję i jej uzasadnienie w czasie rzeczywistym.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Co AI wykrywa w komentarzach</h2>
        <p class="mt-4 text-lg text-surface-500">Ponad 20 gotowych modeli wytrenowanych na miliardach etykiet treści.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toksyczność</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Mowa nienawiści</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Nękanie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Oszustwa i phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dane osobowe</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Samookaleczenia</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Wulgaryzmy</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Wydźwięk</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Tematy drażliwe</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Ryzykowne linki</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Dlaczego moderacja YouTube z OpenModeration jest prosta</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Bez kodu</h3>
          <p class="mt-2 text-sm text-surface-500">Wszystko konfiguruje się w konsoli. Nie trzeba niczego budować na API ani angażować programistów.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Natywne działania YouTube</h3>
          <p class="mt-2 text-sm text-surface-500">Komentarze są publikowane, wstrzymywane do przeglądu lub odrzucane bezpośrednio przez YouTube Data API. Działa to jak YouTube Studio, tylko automatycznie.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Dowolna skala</h3>
          <p class="mt-2 text-sm text-surface-500">OpenModeration nadąża za kanałem, niezależnie od tego, czy dostaje 100 komentarzy dziennie, czy 100 000.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Wielojęzyczność</h3>
          <p class="mt-2 text-sm text-surface-500">Każdy komentarz jest analizowany w swoim języku, także w językach Twoich odbiorców. Te same reguły obowiązują w każdym języku, a trudne przypadki weryfikują inne modele AI.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Własne reguły zwykłym językiem</h3>
          <p class="mt-2 text-sm text-surface-500">Opisz zasady moderacji zwykłym językiem. AI odczytuje nie tylko słowa komentarza, ale i jego intencję.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Audytowalność i przejrzystość</h3>
          <p class="mt-2 text-sm text-surface-500">Każda decyzja moderacyjna jest rejestrowana wraz z kontekstem. Dane są przechowywane w Unii Europejskiej i można je w każdej chwili wyeksportować.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Najczęstsze pytania o moderację YouTube" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
