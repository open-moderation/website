---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pl/integracje/moderacja-facebook",
  "url": "https://www.openmoderation.com/pl/integracje/moderacja-facebook",
  "name": "Moderacja komentarzy na Facebooku: automatyczne ukrywanie toksycznych komentarzy bez kodu",
  "description": "Automatycznie ukrywaj toksyczne komentarze na stronie na Facebooku dzięki AI. Reguły bez kodu, ponad 120 języków, natychmiastowe ukrywanie lub usuwanie przez Graph API. Darmowy start, ścieżka audytu DSA w zestawie.",
  "inLanguage": "pl"
};

const faqItems = [
  {
    question: "Jak działa moderacja komentarzy na Facebooku?",
    answer: "Stronę na Facebooku łączy się przez Graph API. Komentarze są pobierane i analizowane przez AI na bieżąco, w miarę jak się pojawiają. Zgodnie z Twoimi regułami toksyczne komentarze są ukrywane lub usuwane, bez konieczności ręcznego przeglądania."
  },
  {
    question: "Czy do konfiguracji potrzebny jest kod?",
    answer: "Nie. Wszystko konfiguruje się w konsoli. Wystarczy połączyć stronę na Facebooku i ustawić reguły moderacji zwykłym językiem lub przełącznikami, a moderacja rusza w ciągu kilku minut."
  },
  {
    question: "Jakie treści na Facebooku można moderować?",
    answer: "Komentarze, odpowiedzi i posty na Twojej stronie na Facebooku. Platforma wykrywa mowę nienawiści, nękanie, spam, treści NSFW, dane osobowe, oszustwa i wiele więcej w ponad 120 językach."
  },
  {
    question: "Ile kosztuje moderacja komentarzy na Facebooku?",
    answer: "Zarządzana chmura oferuje darmowy plan do 1000 zapytań miesięcznie oraz plan Pro za 99 € miesięcznie, bez ukrytych opłat."
  },
  {
    question: "Ile trwa konfiguracja?",
    answer: "Kilka minut. Wystarczy połączyć stronę na Facebooku i zapisać reguły zwykłym językiem. Automatyczna moderacja działa jeszcze tego samego dnia, bez kodu i bez programisty."
  },
  {
    question: "Czy każda decyzja moderacyjna jest rejestrowana na potrzeby audytów DSA?",
    answer: "Tak. Każdy ukryty, usunięty lub oznaczony komentarz zachowuje w pełnej ścieżce audytu zastosowaną regułę, oceny AI i pisemne uzasadnienie. Eksport do raportów przejrzystości DSA zajmuje jedno kliknięcie."
  },
];
---

<BaseLayout title="Moderacja komentarzy na Facebooku z AI, bez kodu" description="Automatycznie ukrywaj toksyczne komentarze na Facebooku. Reguły bez kodu, ponad 120 języków, natychmiastowe działanie przez Graph API i wyjaśniona decyzja." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "Integracje", href: localizePath('/connectors', locale) }, { label: "Moderacja Facebooka" }]} />
  <section class="bg-gradient-to-b from-blue-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-blue-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderacja komentarzy na Facebooku</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Moderuj komentarze na swojej stronie na Facebooku z pomocą AI. Konfiguracja zajmuje kilka minut i nie wymaga kodu.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Wypróbuj za darmo</a>
        <a href={localizePath('/how-it-works', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Jak to działa</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Prosta moderacja w 3 krokach</h2>
        <p class="mt-4 text-lg text-surface-500">Start w kilka minut, bez zespołu programistów.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Załóż konto</h3>
          <p class="mt-2 text-sm text-surface-500">Zarejestruj się za darmo w OpenModeration, bez karty kredytowej i bez zobowiązań. Dane są przechowywane w UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Połącz stronę na Facebooku</h3>
          <p class="mt-2 text-sm text-surface-500">Połącz stronę na Facebooku za pomocą własnych danych dostępowych. Konektor automatycznie pobiera komentarze i posty.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Ustal reguły</h3>
          <p class="mt-2 text-sm text-surface-500">Zapisz reguły moderacji zwykłym językiem. AI stosuje je automatycznie i ukrywa, usuwa lub oznacza komentarze.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Co można wykrywać</h2>
        <p class="mt-4 text-lg text-surface-500">Ponad 20 gotowych modeli wykrywania, wytrenowanych na miliardach etykiet.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toksyczność</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Mowa nienawiści</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Nękanie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Oszustwa i phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dane osobowe</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Samookaleczenia</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Wulgaryzmy</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Wydźwięk</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Tematy drażliwe</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Ryzykowne linki</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Dlaczego moderacja Facebooka z OpenModeration jest prosta</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Bez kodu</h3>
          <p class="mt-2 text-sm text-surface-500">Wszystko ustawia się w konsoli. Połącz stronę, zapisz reguły zwykłym językiem, a AI je zastosuje.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Twoje dane dostępowe, Twoja kontrola</h3>
          <p class="mt-2 text-sm text-surface-500">Korzystasz z własnego tokenu dostępu do strony na Facebooku. Nigdy nie przechowujemy danych dostępowych otwartym tekstem, a pełna kontrola pozostaje po Twojej stronie.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Automatyczne egzekwowanie reguł na Facebooku</h3>
          <p class="mt-2 text-sm text-surface-500">Komentarze łamiące reguły są ukrywane lub usuwane bezpośrednio przez Facebook Graph API. Bez ręcznej kolejki moderacji.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Ponad 120 języków</h3>
          <p class="mt-2 text-sm text-surface-500">Moderuj komentarze w językach, którymi posługuje się Twoja społeczność. Nasza AI obsługuje główne języki, a trudne przypadki weryfikują inne modele AI.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Własne reguły zwykłym językiem</h3>
          <p class="mt-2 text-sm text-surface-500">Opisz zasady moderacji tak, jak tłumaczy się je współpracownikowi. Bez inżynierii promptów i wyrażeń regularnych.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Wyjaśnione decyzje, hosting w UE</h3>
          <p class="mt-2 text-sm text-surface-500">Każdej decyzji towarzyszy pisemne uzasadnienie. Dane są przechowywane w Unii Europejskiej i można je w każdej chwili wyeksportować.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Najczęstsze pytania o moderację Facebooka" />
    <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-violet-100 bg-violet-50 p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Poradnik</p>
      <a href={localizePath('/blog/hide-facebook-comments-automatically', locale)} class="mt-1 block text-lg font-bold text-surface-900 hover:text-violet-700">Jak automatycznie ukrywać komentarze na Facebooku &rarr;</a>
    </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
