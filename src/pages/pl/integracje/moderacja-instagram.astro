---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pl/integracje/moderacja-instagram",
  "url": "https://www.openmoderation.com/pl/integracje/moderacja-instagram",
  "name": "Automatyczna moderacja Instagrama: ukrywanie toksycznych komentarzy bez kodu",
  "description": "Automatyczna moderacja komentarzy na Instagramie z AI. Reguły bez kodu, automatyczne ukrywanie toksycznych treści, ponad 120 języków, ścieżka audytu DSA. Darmowy start, działa w kilka minut.",
  "inLanguage": "pl"
};

const faqItems = [
  {
    question: "Jak działa moderacja komentarzy na Instagramie?",
    answer: "Konto na Instagramie łączy się z OpenModeration. Komentarze i odpowiedzi są automatycznie analizowane przez AI. Toksyczne komentarze są ukrywane lub usuwane zgodnie z Twoimi regułami, bez żadnej ręcznej pracy."
  },
  {
    question: "Czy konfiguracja jest skomplikowana?",
    answer: "Nie. Wszystko ustawia się w konsoli, bez pisania kodu. Wystarczy połączyć konto na Instagramie i wybrać reguły moderacji, a resztą zajmie się platforma. Trwa to kilka minut."
  },
  {
    question: "Co wykrywa moderacja Instagrama?",
    answer: "Platforma wykrywa mowę nienawiści, nękanie, spam, treści NSFW, dane osobowe, oszustwa, phishing, wulgaryzmy, treści o samookaleczeniach i wiele więcej. Ponad 20 gotowych modeli wykrywania obejmuje ponad 120 języków."
  },
  {
    question: "Czy do korzystania z OpenModeration na Instagramie trzeba umieć programować?",
    answer: "Nie. Platforma jest zaprojektowana dla osób bez wiedzy technicznej. Reguły ustawia się zwykłym językiem i przełącznikami. Konsola jest prosta w obsłudze i nie wymaga prac programistycznych."
  },
  {
    question: "Czy to lepsze niż wbudowana moderacja Instagrama?",
    answer: "Tak. Wbudowane filtry Instagrama ograniczają się do blokowania słów kluczowych. OpenModeration korzysta z AI, która uwzględnia kontekst i rozumie niuanse, sarkazm oraz przebieg rozmowy. Do tego dochodzą własne reguły, weryfikacja wątpliwych przypadków przez nasz zespół i pełne ścieżki audytu."
  },
  {
    question: "Ile kosztuje automatyczna moderacja Instagrama?",
    answer: "Darmowy plan obejmuje do 1000 zapytań miesięcznie. Plan Pro kosztuje od 99 € miesięcznie za 10 tys. zapytań, z modelami AI w cenie. Nie ma opłat za stanowisko, a zrezygnować można w każdej chwili."
  },
  {
    question: "Czy każda decyzja jest rejestrowana na potrzeby audytów?",
    answer: "Tak. Każdy automatycznie ukryty lub oznaczony komentarz zachowuje zastosowaną regułę, oceny AI i pisemne uzasadnienie. Pełną ścieżkę audytu można wyeksportować jednym kliknięciem na potrzeby przeglądów brand safety lub DSA."
  },
];
---

<BaseLayout title="Moderacja komentarzy na Instagramie z AI, bez kodu" description="Automatyczna moderacja komentarzy na Instagramie z AI. Reguły bez kodu, ukrywanie toksycznych treści, ponad 120 języków. Darmowy start, działa w kilka minut." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "Integracje", href: localizePath('/connectors', locale) }, { label: "Moderacja Instagrama" }]} />
  <section class="bg-gradient-to-b from-pink-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-pink-100 text-pink-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderacja treści na Instagramie</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Chroń swój profil na Instagramie przed toksycznymi komentarzami. Moderację AI konfiguruje się w kilka minut i bez kodu.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Wypróbuj za darmo</a>
        <a href={localizePath('/how-it-works', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Jak to działa</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderacja prosta w obsłudze</h2>
        <p class="mt-4 text-lg text-surface-500">Trzy kroki do bezpieczniejszego profilu na Instagramie.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Zarejestruj się</h3>
          <p class="mt-2 text-sm text-surface-500">Załóż darmowe konto w OpenModeration. Dane są przechowywane w UE.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Połącz Instagram</h3>
          <p class="mt-2 text-sm text-surface-500">Połącz konto na Instagramie z platformą w kilku kliknięciach, za pomocą własnych danych dostępowych.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Start w kilka minut</h3>
          <p class="mt-2 text-sm text-surface-500">Ustal reguły moderacji i pozwól AI chronić profil. Treści są automatycznie ukrywane, usuwane lub oznaczane.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Wykrywanie, które wykracza poza słowa kluczowe</h2>
        <p class="mt-4 text-lg text-surface-500">AI czyta kontekst, dlatego wychwytuje niuanse, sarkazm i intencje.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Toksyczność</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Mowa nienawiści</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Nękanie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Oszustwa i phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dane osobowe</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Samookaleczenia</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Wulgaryzmy</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Wydźwięk</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Tematy drażliwe</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Ryzykowne linki</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Dlaczego to najprostsze narzędzie do moderacji Instagrama</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Konfiguracja w minutę, zero kodu</h3>
          <p class="mt-2 text-sm text-surface-500">Konto na Instagramie łączy się z poziomu konsoli. Nie trzeba znać API ani angażować programisty.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">AI rozumiejąca kontekst</h3>
          <p class="mt-2 text-sm text-surface-500">AI śledzi rozmowę. Podobnie jak moderator, ocenia to samo zdanie różnie w zależności od tego, co padło wcześniej.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Automatyczne egzekwowanie reguł</h3>
          <p class="mt-2 text-sm text-surface-500">Komentarze łamiące reguły są automatycznie ukrywane lub usuwane. Profil na Instagramie pozostaje czysty bez Twojej interwencji.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Ponad 120 języków</h3>
          <p class="mt-2 text-sm text-surface-500">Odbiorcy piszą w wielu językach, a jedna platforma moderuje je wszystkie z tą samą dokładnością.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Własne reguły zwykłym językiem</h3>
          <p class="mt-2 text-sm text-surface-500">Zapisz reguły tak, jak tłumaczy się je drugiej osobie. Nasza AI rozumie Twoje reguły i stosuje je konsekwentnie.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Wyjaśnione decyzje i prywatność</h3>
          <p class="mt-2 text-sm text-surface-500">Każdej decyzji towarzyszy pisemne uzasadnienie i pełna ścieżka audytu. Dane są przechowywane w Unii Europejskiej i można je w każdej chwili wyeksportować.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Najczęstsze pytania o moderację Instagrama" />
    <div class="mx-auto mt-10 max-w-3xl rounded-2xl border border-violet-100 bg-violet-50 p-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Poradnik</p>
      <a href={localizePath('/blog/instagram-comment-moderation', locale)} class="mt-1 block text-lg font-bold text-surface-900 hover:text-violet-700">Moderacja komentarzy na Instagramie: poradnik automatycznej moderacji &rarr;</a>
    </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
