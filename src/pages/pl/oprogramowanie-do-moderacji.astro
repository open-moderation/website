---
import SectorPage from '../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Oprogramowanie do moderacji treści zgodne z DSA"
  description="Oprogramowanie do moderacji komentarzy na stronie i w social mediach, dopasowane do Twoich zasad: analiza AI, weryfikacja przez nasz zespół i rejestr DSA."
  crumb="Oprogramowanie do moderacji"
  parent={null}
  eyebrow="Oprogramowanie do moderacji treści"
  h1="Oprogramowanie do moderacji treści, a nie tylko filtr"
  intro="Prawdziwy system moderacji robi więcej niż blokowanie słów. OpenModeration analizuje każdy komentarz pod kątem Twoich zasad, ukrywa to, co je łamie, wątpliwymi przypadkami zajmuje się nasz zespół, a pisemne uzasadnienie każdej decyzji jest zapisywane na potrzeby DSA."
  problem="Filtry słów kluczowych blokują uzasadnioną krytykę, a przepuszczają ironię, zakamuflowane obelgi i oszustwa. Surowe API do moderacji zwracają wyniki punktowe, ale interfejs, zasady, weryfikację przez ludzi i rejestr audytowy trzeba zbudować samodzielnie."
  approach="OpenModeration łączy cały system: zbieranie komentarzy (strona, Facebook, Instagram, YouTube, API), analizę AI, zasady zapisane zwykłym językiem, weryfikację wątpliwych przypadków przez nasz zespół, konsolę w czasie rzeczywistym i rejestr audytowy. Dopasowujemy go razem z Tobą do Twoich zasad i przypadków użycia."
  result="Moderacja, która działa sama, dzień i noc: wystarczy podłączyć Twoje strony, a resztą zajmujemy się my. Widzisz każdą decyzję w czasie rzeczywistym i możesz interweniować, oraz z historią gotową do pokazania, gdy decyzja zostanie zakwestionowana lub skontrolowana."
  featuresTitle="Co zawiera narzędzie do moderacji"
  featuresIntro="Elementy systemu moderacji, już złożone i gotowe do podłączenia do Twoich przestrzeni komentarzy."
  features={[
    { title: "Analiza AI w kontekście", text: "Każdy komentarz jest czytany w kontekście tematu artykułu lub posta, w swoim języku, aby wychwycić ironię, zakodowane obelgi i wpisy nie na temat." },
    { title: "Twoje zasady zwykłym językiem", text: "Zasady zapisujesz tak, jak wyjaśnił(a)byś je moderatorowi. Bez list słów do utrzymywania i bez kodu." },
    { title: "Konsola w czasie rzeczywistym", text: "Przypadkami granicznymi zajmuje się nasz zespół. W konsoli widzisz każdą decyzję, regułę, której dotyczy, i wyjaśnienie AI, a jeśli chcesz, zmieniasz ją jednym kliknięciem." },
    { title: "Rejestr audytowy i uzasadnienia", text: "Każda decyzja, automatyczna lub ludzka, jest zapisywana wraz z pisemnym uzasadnieniem, zgodnie z wymogiem art. 17 DSA." },
  ]}
  why={[
    { title: "Wdrożenie razem z Tobą", text: "Przekładamy Twoje zasady i przypadki użycia na jasne instrukcje i testujemy je na prawdziwych komentarzach przed włączeniem." },
    { title: "Zgodność z DSA", text: "Zgłoszenia użytkowników, uzasadnienia decyzji, weryfikacja przez ludzi i dane do raportu przejrzystości są wbudowane od początku." },
    { title: "Taniej niż dedykowany zespół", text: "Moderacja automatyczna kosztuje ułamek moderacji ręcznej, zarówno wewnętrznej, jak i zleconej na zewnątrz." },
  ]}
  faq={[
    { question: "Czym różni się oprogramowanie do moderacji od API do moderacji?", answer: "API zwraca wynik punktowy dla fragmentu tekstu. Oprogramowanie do moderacji obsługuje cały łańcuch: zbieranie, zasady, decyzję, weryfikację przez ludzi, wyjaśnienie i historię. OpenModeration oferuje jedno i drugie: kompletną platformę oraz API dla zespołów technicznych." },
    { question: "Czy do wdrożenia potrzebni są programiści?", answer: "Nie w przypadku Facebooka, Instagrama, YouTube’a ani WordPressa: konektory działają bez kodu. Dla własnej strony lub aplikacji wystarczy integracja przez API." },
    { question: "Czy można przetestować narzędzie przed podjęciem decyzji?", answer: "Tak. Możesz od razu sprawdzić komentarz w demo online, założyć darmowe konto albo umówić rozmowę, aby zobaczyć moderację na własnych komentarzach." },
    { question: "Czy oprogramowanie jest zgodne z RODO?", answer: "Tak. OpenModeration jest tworzone i hostowane w Unii Europejskiej, a Ty decydujesz, jak długo dane są przechowywane." },
  ]}
  related={[
    { eyebrow: "Demo", title: "Przetestuj moderację", text: "Wklej komentarz i w kilka sekund zobacz decyzję oraz jej wyjaśnienie.", href: localizePath('/demo', locale) },
    { eyebrow: "Platforma", title: "Konsola moderacji", text: "Wszystkie decyzje z Twoich platform w jednym miejscu.", href: localizePath('/dashboard', locale) },
    { eyebrow: "Regulacje", title: "Zgodność z DSA", text: "Czego DSA wymaga od serwisów, które publikują komentarze.", href: localizePath('/dsa-compliance', locale) },
  ]}
  ctaTitle="Zobacz system w działaniu na Twoich komentarzach."
  ctaSubtitle="Umów rozmowę: zaczynamy od Twoich zasad i przypadków użycia i pokazujemy decyzje na Twoich prawdziwych komentarzach."
/>
