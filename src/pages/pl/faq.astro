---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { bookingUrl } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
const BOOKING_URL = bookingUrl(locale);

const faqItems = [
  {
    question: "Czy do skonfigurowania zasad moderacji trzeba umieć programować?",
    answer: "Nie. OpenModeration korzysta z trzech prostych narzędzi: zakazanych słów do natychmiastowego blokowania, progów dla kategorii do automatycznych decyzji oraz własnych zasad zapisanych zwykłym językiem. Silnik akcji (Action Engine) stosuje je następnie automatycznie, bez pisania kodu.",
  },
  {
    question: "Czy można ręcznie zmienić decyzję AI?",
    answer: "Tak. Nie muszą Państwo nic robić: wątpliwymi przypadkami zajmuje się nasz zespół. W konsoli moderacji widzą Państwo jednak każdą decyzję i jej uzasadnienie w czasie rzeczywistym i mogą w każdej chwili zatwierdzić, odrzucić lub zmienić decyzję. Każde działanie jest zapisywane na potrzeby audytu.",
  },
  {
    question: "Czy jest dostępny plan darmowy?",
    answer: "Tak. OpenModeration oferuje plan darmowy do 1000 zapytań miesięcznie, bez karty kredytowej. Plan Pro kosztuje 99 € miesięcznie za 10 000 zapytań. Szczegóły znajdują się na stronie cennika.",
  },
  {
    question: "Czym OpenModeration różni się od OpenAI Moderation API?",
    answer: "OpenAI Moderation API to pojedynczy klasyfikator, który niewiele pokazuje z tego, jak działa moderacja. OpenModeration korzysta z własnej AI do moderacji, skonfigurowanej według Państwa reguł i przypadków użycia, a trudne przypadki weryfikują inne modele AI. Każda decyzja ma pisemne uzasadnienie, a platforma obejmuje konsolę w czasie rzeczywistym i silnik akcji do automatyzacji procesów.",
  },
  {
    question: "Czym OpenModeration różni się od Nima (Tremau)?",
    answer: "OpenModeration wyjaśnia każdą decyzję na piśmie, prowadzi pełny dziennik audytowy, weryfikuje trudne przypadki innymi modelami AI i hostuje dane w Unii Europejskiej. Wdrożenie on-premise jest możliwe na życzenie.",
  },
  {
    question: "Czym OpenModeration różni się od Checkstep?",
    answer: "OpenModeration jest projektowane przede wszystkim wokół API i korzysta z własnej AI do moderacji, weryfikowanej w trudnych przypadkach przez inne modele AI. Każda decyzja ma pisemne uzasadnienie, dane są hostowane w UE, a nasz zespół konfiguruje moderację według Państwa reguł i zajmuje się wątpliwymi przypadkami.",
  },
  {
    question: "Co oznacza zgodność z DSA?",
    answer: "OpenModeration prowadzi pełny dziennik audytowy każdej decyzji moderacyjnej, z konfigurowalnym okresem przechowywania danych i raportami do eksportu. Pomaga to platformom spełnić wymogi przejrzystości i rozliczalności unijnego aktu o usługach cyfrowych (DSA).",
  },
  {
    question: "Z jakiej AI korzysta OpenModeration?",
    answer: "OpenModeration korzysta z własnej AI do moderacji, wytrenowanej do moderacji komentarzy i skonfigurowanej według Państwa reguł i przypadków użycia. W trudnych przypadkach inne modele AI rozstrzygają decyzję, zanim zostanie zastosowana: mniej błędów i mniej niesłusznie ukrytych komentarzy.",
  },
  {
    question: "Czy można wdrożyć OpenModeration na własnej infrastrukturze?",
    answer: "Wdrożenie on-premise jest możliwe na życzenie: porozmawiajmy o Państwa potrzebach. Domyślnie OpenModeration działa w naszej zarządzanej chmurze, hostowanej w Unii Europejskiej.",
  },
  {
    question: "Czy oferujecie zarządzaną chmurę?",
    answer: "Tak, nasza zarządzana chmura SaaS kosztuje od 99 €/mies. W cenie: 10 000 zapytań miesięcznie, brak infrastruktury do utrzymania, modele AI w cenie, infrastruktura hostowana w UE, priorytetowe wsparcie i SLA. Szczegóły znajdują się na stronie cennika.",
  },
  {
    question: "Jak szybko można zacząć z tego realnie korzystać?",
    answer: "Kilka minut w przypadku podstawowej moderacji przez REST API. Kilka godzin na wdrożenie pełnej platformy z konsolą, silnikiem akcji i konektorami według przewodnika szybkiego startu. Od tego momentu moderacja działa sama, a Państwo widzą każdą decyzję w czasie rzeczywistym.",
  },
  {
    question: "Co się dzieje, gdy pojawia się lepszy model AI?",
    answer: "Nasz silnik nie jest przywiązany do jednego modelu. Gdy pojawia się lepszy lub tańszy model AI, nasz zespół szybko go podłącza, a po Państwa stronie nic się nie zmienia. Modele AI co roku są lepsze i tańsze, a Państwo korzystają z tego postępu, zamiast utknąć na wczorajszym modelu.",
  },
  {
    question: "Czy mogę dodać własne kategorie?",
    answer: "Tak. W przeciwieństwie do tradycyjnych klasyfikatorów opartych na kategoriach dowolne kategorie moderacji definiuje się promptami w języku naturalnym, dopasowując moderację do własnych zasad publikowania treści.",
  },
  {
    question: "A co z obrazami i wideo?",
    answer: "Obecna wersja koncentruje się na moderacji tekstu. Moderacja obrazów i wideo jest w planach rozwoju i będzie korzystać z multimodalnych modeli AI, gdy tylko staną się dostępne.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/pl/faq",
      "url": "https://www.openmoderation.com/pl/faq",
      "name": "FAQ o moderacji treści: cennik, hosting i DSA",
      "inLanguage": "pl",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.openmoderation.com/pl/faq#faq",
      "inLanguage": "pl",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer.replace(/&mdash;/g, '—')
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="FAQ o moderacji treści: cennik, hosting i DSA"
  description="Odpowiedzi na najczęstsze pytania o OpenModeration: cennik, hosting w UE, zgodność z DSA, nasza AI do moderacji i integracje."
  jsonLd={faqJsonLd}
>
<Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "FAQ" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Najczęściej zadawane pytania</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Odpowiedzi na pytania, które najczęściej słyszymy o OpenModeration. Jeśli nie ma tu Twojego, <a href={BOOKING_URL} class="text-brand-600 hover:text-brand-500" target="_blank" rel="noopener">porozmawiajmy</a>.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Wypróbuj za darmo
        </a>
        <a href={localizePath('/pricing', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          Zobacz cennik
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Bez karty kredytowej</p>
    </div>
  </section>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} disableJsonLd />
    </div>
  </section>
</BaseLayout>