---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pl/jak-to-dziala",
  "url": "https://www.openmoderation.com/pl/jak-to-dziala",
  "name": "Jak działa moderacja treści z AI: cały proces",
  "description": "Poznaj proces moderacji: pobieranie komentarzy, moderację AI weryfikowaną przez inne modele, reguły i akcje automatyczne oraz weryfikację przez nasz zespół.",
  "inLanguage": "pl",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const facebookWebhookExample = `// Facebook wysyła komentarz przez webhook
{
  "source": "facebook",
  "content_id": "comment_123",
  "author_id": "user_456",
  "text": "Comment text here...",
  "metadata": {"post_url": "..."}
}`;

const moderationResponseExample = `{
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const ruleConfigExample = `// Skonfiguruj progi moderacji
PUT /v1/settings

{
  "thresholds": {
    "hate":       { "accepted": 0.3, "rejected": 0.7 },
    "harassment": { "accepted": 0.3, "rejected": 0.7 },
    "sexual":     { "accepted": 0.2, "rejected": 0.8 },
    "violence":   { "accepted": 0.3, "rejected": 0.7 },
    "self-harm":  { "accepted": 0.2, "rejected": 0.8 },
    "spam":       { "accepted": 0.4, "rejected": 0.8 }
  },
  "actions": {
    "on_reject": ["hide", "flag_for_review"]
  }
}`;

const auditTrailExample = `// Pełny dziennik audytowy dla każdej treści
{
  "content_id": "...",
  "source": "webhook",
  "platform": "facebook",
  "status": "actioned",
  "moderation": {
    "flagged": true,
    "results": [...]
  },
  "actions": [{
    "rule": "Hide hate speech",
    "type": "hide",
    "status": "executed"
  }]
}`;
---

<BaseLayout title="Jak działa moderacja treści z AI: cały proces" description="Poznaj proces moderacji: pobieranie komentarzy, moderację AI weryfikowaną przez inne modele, reguły i akcje automatyczne oraz weryfikację przez nasz zespół." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "Jak to działa" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Jak to działa</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Jeden proces prowadzi każdy komentarz od pobrania aż po automatyczne działanie.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Pipeline Overview -->
      <div class="mb-20">
        <div class="relative rounded-2xl border border-surface-200 bg-surface-50 p-8">
          <div class="grid gap-6 grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-brand-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">1. Pobieranie</h3>
              <p class="mt-2 text-sm text-surface-500">Treści trafiają przez API, webhook lub konektor mediów społecznościowych.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">POST /v1/moderation</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Webhooks</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Facebook</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Instagram</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">YouTube</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-brand-400 bg-white p-6 text-center shadow-md">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 text-white">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">2. Moderacja AI</h3>
              <p class="mt-2 text-sm text-surface-500">Nasza AI analizuje treść, inne modele weryfikują trudne przypadki, a wynik wraca w ustandaryzowanym formacie.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">AI OpenModeration</span>
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs text-brand-700">Weryfikacja przez inne AI</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-surface-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">3. Reguły i akcje</h3>
              <p class="mt-2 text-sm text-surface-500">Silnik reguł ocenia wyniki, a akcje wykonują się automatycznie.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Ukryj</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Wstrzymaj</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Opublikuj</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Webhook</span>
              </div>
            </div>
            <div class="hidden lg:flex lg:items-center lg:justify-center">
              <svg class="h-6 w-6 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
            <div class="rounded-xl border border-surface-200 bg-white p-6 text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </div>
              <h3 class="text-lg font-semibold text-surface-900">4. Ręczna weryfikacja</h3>
              <p class="mt-2 text-sm text-surface-500">Wątpliwymi przypadkami zajmuje się nasz zespół. Widzisz każdą decyzję i możesz interweniować.</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Nasz zespół</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Zatwierdź</span>
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-xs text-surface-600">Odrzuć</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Detailed Steps -->
      <div class="space-y-16">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Krok 1</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Treści napływają z dowolnego miejsca</h2>
            <p class="mt-4 text-surface-500">
              Treści mogą trafiać kilkoma kanałami. Wywołaj API bezpośrednio,
              skonfiguruj webhooki do odbierania treści z zewnętrznych platform lub włącz natywne
              konektory mediów społecznościowych, które automatycznie pobierają komentarze i posty.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>API:</strong> POST /v1/moderation do moderacji pojedynczej lub wsadowej</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Webhooki:</strong> uniwersalny endpoint odbiera i normalizuje zewnętrzne dane</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Konektory:</strong> natywna integracja z Facebookiem, Instagramem, YouTube i WordPressem</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Przykład: komentarz z Facebooka</h4>
            <CodeBlock code={facebookWebhookExample} lang="json" />
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div class="lg:order-2">
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Krok 2</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">AI moderuje treść</h2>
            <p class="mt-4 text-surface-500">
              Każdy element analizuje nasza własna AI do moderacji, skonfigurowana według Twoich zasad i przypadków użycia.
              W trudnych przypadkach inne modele AI rozstrzygają decyzję, zanim zostanie zastosowana. Wyniki są ustandaryzowane,
               z ocenami od 0,0 do 1,0 w 10 kategoriach treści.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Weryfikacja:</strong> inne modele AI rozstrzygają trudne przypadki</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Niezależność od modelu:</strong> lepsze lub tańsze modele podłączamy, gdy się pojawiają</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Ustandaryzowany wynik:</strong> ten sam format niezależnie od modelu w tle</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 lg:order-1">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Ustandaryzowana odpowiedź</h4>
            <CodeBlock code={moderationResponseExample} lang="json" />
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Krok 3</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Moderacja dopasowana do Twoich zasad</h2>
            <p class="mt-4 text-surface-500">
              Zasady moderacji definiuje się trzema prostymi narzędziami: <strong>zakazanymi słowami</strong> do natychmiastowego blokowania, <strong>progami dla kategorii</strong> do automatycznych decyzji oraz <strong>własnymi zasadami</strong> zapisanymi zwykłym językiem, które pozwalają AI moderować z uwzględnieniem kontekstu.
            </p>
            <div class="mt-6 space-y-3">
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Zakazane słowa</strong> blokują treść natychmiast, jeszcze przed wywołaniem AI, więc nic nie kosztują</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Progi dla kategorii</strong> uruchamiają automatyczne akcje, gdy wyniki przekroczą ustalone limity</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-4">
                <p class="text-sm text-surface-700"><strong>Twoje zasady zapisane zwykłym językiem</strong> kierują decyzjami AI z uwzględnieniem kontekstu i nadają ton Twojej platformie</p>
              </div>
            </div>
          </div>
          <div>
            <BrowserFrame
              src="/images/rules.png"
              video="om-rules"
              alt="Ustawienia zasad w OpenModeration: zakazane słowa, progi dla kategorii i zasady zapisane zwykłym językiem"
              caption="Ustaw progi raz, a będą obowiązywać wszędzie."
              eager={false}
            />
            <details class="mt-4 rounded-xl border border-surface-200 bg-surface-50 p-4">
              <summary class="cursor-pointer text-sm font-semibold text-surface-700">Dla deweloperów: konfiguracja przez API</summary>
              <div class="mt-3">
                <CodeBlock code={ruleConfigExample} lang="json" />
              </div>
            </details>
          </div>
        </div>

        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div class="lg:order-2">
            <span class="mb-2 inline-flex items-center rounded-full bg-brand-100 px-3 py-0.5 text-sm font-medium text-brand-700">Krok 4</span>
            <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Przypadki graniczne obsługuje nasz zespół</h2>
            <p class="mt-4 text-surface-500">
              Nie musisz nic robić: oznaczone treści, zgłoszenia użytkowników i zakwestionowane decyzje rozpatruje nasz zespół.
              Ty widzisz każdą decyzję i jej uzasadnienie w czasie rzeczywistym i możesz w każdej chwili interweniować, a każdy krok pozostaje możliwy do skontrolowania.
            </p>
            <ul class="mt-6 space-y-2 text-sm text-surface-600">
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <strong>Zatwierdzanie lub odrzucanie jednym kliknięciem.</strong> Każda zmiana decyzji jest zapisywana wraz z informacją, kto ją podjął i dlaczego.</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Wszystkie decyzje widoczne na bieżąco w konsoli moderacji</li>
              <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Powiadomienia przez webhook o oznaczonych elementach</li>
            </ul>
          </div>
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 lg:order-1">
            <h4 class="mb-3 text-sm font-semibold text-surface-900">Wszystko jest zapisywane</h4>
            <CodeBlock code={auditTrailExample} lang="json" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Action Engine -->
  <section id="action-engine" class="scroll-mt-24 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Silnik akcji</h2>
        <p class="mt-4 text-lg text-surface-500">Gdy Twoje zasady zostaną uruchomione, silnik akcji (Action Engine) automatycznie wykonuje decyzję bezpośrednio na platformie. Każde działanie jest zapisywane.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-100 text-red-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Automatyczne ukrywanie</h3>
          <p class="mt-1 text-sm text-surface-500">Odrzucone treści są ukrywane na Facebooku i Instagramie oraz odrzucane na YouTube. Społeczność nigdy ich nie zobaczy.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Wstrzymanie do weryfikacji</h3>
          <p class="mt-1 text-sm text-surface-500">Treści graniczne są wstrzymywane, dopóki nie zweryfikuje ich nasz zespół. Nic nie zostaje opublikowane i nic nie ginie.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-green-100 text-green-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Publikacja i przywracanie</h3>
          <p class="mt-1 text-sm text-surface-500">Treści bez zastrzeżeń publikują się normalnie. Gdy wstrzymany komentarz zostanie zatwierdzony, zostaje opublikowany.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Powiadamianie Twoich narzędzi</h3>
