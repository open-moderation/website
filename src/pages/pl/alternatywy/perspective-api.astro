---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Alternatywa dla Perspective API przed wyłączeniem w 2026";
const description = "Google wyłącza Perspective API pod koniec 2026 roku. Przejdź na OpenModeration: moderacja AI, weryfikacja przez człowieka, dziennik pod DSA, hosting w UE.";

const migrationCode = `# Przed: Perspective API
const result = await fetch('https://commentanalyzer.googleapis.com/v1alpha1/comments:analyze', ...)

# Po: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
})`;

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pl/alternatywy/perspective-api",
  "name": title,
  "description": description,
  "inLanguage": "pl",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  { feature: "Czym jest", competitor: "API Google, które ocenia toksyczność komentarzy", openmod: "Gotowa usługa moderacji: API, konektory, weryfikacja wątpliwych przypadków przez nasz zespół, konsola i dziennik aktywności" },
  { feature: "Status", competitor: "Wyłączenie zapowiedziane na koniec 2026 roku", openmod: "Aktywnie rozwijane przez zespół Logora" },
  { feature: "Kategorie", competitor: "9 stałych kategorii", openmod: "Moderacja dopasowana do Twoich zasad i przypadków użycia" },
  { feature: "Decyzja", competitor: "Ocena liczbowa; akcję trzeba zaprogramować samodzielnie", openmod: "Oczywiste naruszenia ukrywane automatycznie, wątpliwe przypadki do weryfikacji, pisemne uzasadnienie każdej decyzji" },
  { feature: "Integracje", competitor: "Wywołania API", openmod: "Strony internetowe (API), strony na Facebooku, profesjonalne konta na Instagramie, kanały YouTube, WordPress" },
  { feature: "DSA", competitor: "Brak dziennika audytu", openmod: "Zgłoszenia i działania, uzasadnienia decyzji, weryfikacja zakwestionowanych decyzji przez człowieka, eksportowalne dane, pełny dziennik aktywności" },
  { feature: "Modele AI", competitor: "Własne modele Google", openmod: "Własna AI do moderacji, weryfikowana przez inne modele AI; nowe modele podłączane na bieżąco, gdy się pojawiają" },
  { feature: "Cena", competitor: "Bezpłatne, z limitami zapytań", openmod: "Za darmo do 1000 zapytań miesięcznie, Pro za 99 € miesięcznie (10 000 zapytań), Enterprise – wycena indywidualna" },
];

const faqItems = [
  {
    question: "Jaka jest najlepsza alternatywa dla Perspective API?",
    answer: "Najlepsza alternatywa to taka, która zastąpi ocenę toksyczności przed wyłączeniem usługi i nie zostawi Cię z samym wynikiem liczbowym. OpenModeration przyjmuje komentarz przez API (lub z WordPressa, Facebooka, Instagrama i YouTube), ukrywa oczywiste naruszenia, przekazuje wątpliwe przypadki do weryfikacji naszemu zespołowi i uzasadnia na piśmie każdą decyzję."
  },
  {
    question: "Kiedy Perspective API przestanie działać?",
    answer: "Google zapowiedziało zakończenie działania Perspective API pod koniec 2026 roku. Po tym terminie wywołania API przestaną odpowiadać, a moderacja oparta na nich przestanie działać, jeśli nie zostanie zastąpiona."
  },
  {
    question: "Ile kosztuje Perspective API w porównaniu z OpenModeration?",
    answer: "Perspective API jest bezpłatne, z limitami zapytań, i zwraca same oceny. OpenModeration jest bezpłatne do 1000 zapytań miesięcznie, Pro kosztuje 99 € miesięcznie za 10 000 zapytań, a Enterprise jest wyceniany indywidualnie. W cenie są weryfikacja wątpliwych przypadków przez nasz zespół, konsola, pisemne uzasadnienia decyzji i dziennik aktywności."
  },
  {
    question: "Perspective API czy OpenModeration: na czym polega różnica?",
    answer: "Perspective API ocenia toksyczność w 9 stałych kategoriach; co zrobić z oceną, decydujesz sam. OpenModeration moderuje według Twoich zasad i przypadków użycia: ukrywa oczywiste naruszenia, zostawia widoczną uzasadnioną krytykę, wątpliwe przypadki przekazuje naszemu zespołowi i zapisuje każdą decyzję na potrzeby DSA."
  },
  {
    question: "Jak przebiega migracja z Perspective API?",
    answer: "Po stronie kodu zastępujesz wywołanie commentanalyzer.googleapis.com jednym wywołaniem POST /v1/moderation. Przed włączeniem automatycznej moderacji testujesz ją w trybie sandbox na prawdziwych komentarzach, niczego nie ukrywając, a zespół Logora dopasowuje ją do Twoich zasad."
  },
  {
    question: "Z jakich modeli AI korzysta OpenModeration?",
    answer: "OpenModeration działa na własnej AI do moderacji, a w trudnych przypadkach jej decyzje weryfikują inne modele AI. Gdy pojawia się lepszy lub tańszy model, zespół szybko go podłącza, bez żadnych zmian po Twojej stronie: moderacja korzysta z postępu modeli AI, zamiast zależeć od jednego dostawcy, który może wyłączyć usługę."
  }
];
---

<BaseLayout title={title} description={description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "Alternatywy", href: localizePath('/alternatives', locale) }, { label: "Perspective API" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-4 py-1.5 text-sm font-medium text-red-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Perspective API kończy działanie pod koniec 2026 roku
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Google wyłącza Perspective API. Oto alternatywa.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Google zapowiedziało koniec Perspective API pod koniec 2026 roku, więc tysiące forów, społeczności i sekcji komentarzy potrzebują zastępstwa. Najprostszą alternatywą jest OpenModeration: podłącza się szybko, moderuje według Twoich zasad i uzasadnia na piśmie każdą decyzję.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={localizePath('/book-a-call', locale)} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Umów rozmowę</a>
        <a href="#porownanie" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Zobacz pełne porównanie</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-surface-900 sm:text-3xl">Dla kogo było Perspective API?</h2>
      <p class="mt-4 text-surface-600">Perspective API, rozwijane przez Google, ocenia toksyczność komentarzy dla tysięcy wydawców, forów i sekcji komentarzy w mediach. Jest bezpłatne, z limitami zapytań, obsługuje około 20 języków z nierówną dokładnością i 9 stałych kategorii. Zwraca ocenę liczbową: akcję, weryfikację i dziennik trzeba zbudować samodzielnie. Po zapowiedzianym wyłączeniu pod koniec 2026 roku wywołania przestaną odpowiadać.</p>
      <p class="mt-4 text-surface-600">OpenModeration moderuje z użyciem AI komentarze mediów, marek i instytucji publicznych – na ich stronach oraz na Facebooku, Instagramie i YouTube. Automatycznie ukrywa oczywiste naruszenia, zostawia widoczną uzasadnioną krytykę i przekazuje wątpliwe przypadki do weryfikacji naszemu zespołowi w jednej konsoli. Zespół Logora, działający w Paryżu od 2019 roku, konfiguruje ją razem z Tobą zgodnie z Twoimi zasadami i przypadkami użycia.</p>
      <p class="mt-4 text-surface-600">Do tego dochodzi DSA: unijny Akt o usługach cyfrowych wymaga uzasadnienia decyzji moderacyjnych i obsługi odwołań. Czekanie do ostatnich miesięcy 2026 roku to ryzyko.</p>
    </div>
  </section>

  <section id="porownanie" class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perspective API a OpenModeration: porównanie punkt po punkcie</h2>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Kryterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Perspective API</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Wybierz OpenModeration, jeśli…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>Twoja moderacja opiera się dziś na Perspective API i musi działać po 2026 roku;</li>
          <li>chcesz gotowych akcji i weryfikacji przez nasz zespół zamiast samej oceny;</li>
          <li>moderujesz też komentarze w WordPressie, na Facebooku, Instagramie lub YouTube;</li>
          <li>potrzebujesz pisemnego uzasadnienia każdej decyzji, dziennika pod DSA i hostingu w UE.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Perspective API może jeszcze wystarczyć, jeśli…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>potrzebujesz tylko bezpłatnej oceny toksyczności do końca 2026 roku;</li>
          <li>Twój zespół sam buduje akcje, weryfikację i dziennik;</li>
          <li>planujesz migrację później i akceptujesz to ryzyko.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h2 class="text-xl font-bold text-brand-700">Silnik AI, który nadąża za postępem modeli</h2>
          <p class="mt-4 text-surface-700">OpenModeration korzysta z własnej AI do moderacji, a w trudnych przypadkach jej decyzje weryfikują inne modele AI. Silnik nie jest przywiązany do jednego modelu: gdy pojawia się lepszy lub tańszy, zespół szybko go podłącza, bez żadnych zmian po Twojej stronie. Moderacja podąża za postępem rynku AI, zamiast zależeć od jednego algorytmu, który można wyłączyć.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-8">
          <h2 class="text-xl font-bold text-surface-900">Cena: Perspective API a OpenModeration</h2>
          <p class="mt-4 text-surface-600">Perspective API jest bezpłatne, z limitami zapytań, ale zwraca same oceny, a wszystko wokół nich trzeba zbudować samodzielnie. Cennik OpenModeration jest publiczny: za darmo do 1000 zapytań miesięcznie, Pro za 99 € miesięcznie (10 000 zapytań), Enterprise – wycena indywidualna; wdrożenie on-premise na życzenie. <a href={localizePath('/pricing', locale)} class="font-medium text-brand-600 hover:text-brand-500">Cennik OpenModeration &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Przejście z Perspective API na OpenModeration w 3 krokach</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-1 font-semibold text-surface-900">Zastąp wywołanie API</h3>
          <p class="mt-2 text-sm text-surface-600">Zamień wywołanie Perspective na jedno wywołanie API OpenModeration albo podłącz WordPressa, strony na Facebooku, konta na Instagramie i kanały YouTube.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-1 font-semibold text-surface-900">Testuj w trybie sandbox</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration analizuje prawdziwe komentarze, niczego nie ukrywając. Zespół Logora dopasowuje moderację do Twoich zasad i przypadków użycia.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-1 font-semibold text-surface-900">Włącz automatyczną moderację</h3>
          <p class="mt-2 text-sm text-surface-600">Oczywiste naruszenia są ukrywane automatycznie, wątpliwe przypadki trafiają do konsoli, a dziennik aktywności i dane są gotowe na potrzeby DSA.</p>
        </li>
      </ol>
      <div class="mt-8 rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h3 class="mb-2 text-sm font-semibold text-surface-900">Migracja po stronie kodu: przed i po</h3>
        <CodeBlock code={migrationCode} lang="bash" />
      </div>
      <p class="mt-8 text-surface-600">Chcesz zobaczyć to na swoich komentarzach? <a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">Umów rozmowę z naszym zespołem &rarr;</a></p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Alternatywa dla Perspective API: najczęstsze pytania" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Perspective API i Google są znakami towarowymi Google LLC. Źródła: <a href="https://perspectiveapi.com" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">perspectiveapi.com</a>. Zauważyłeś błąd? Napisz do nas: <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Porównaj inne rozwiązania</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={localizePath('/alternatives/openai-moderation', locale)} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href={localizePath('/alternatives/azure-content-safety', locale)} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href={localizePath('/alternatives/mistral-moderation', locale)} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href={localizePath('/alternatives/hive-moderation', locale)} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href={localizePath('/text-moderation-api', locale)} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">API do moderacji tekstu</a>
        <a href={localizePath('/moderation-software', locale)} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Oprogramowanie do moderacji</a>
        <a href={localizePath('/blog/comment-moderation-guide', locale)} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Poradnik moderacji komentarzy</a>
        <a href={localizePath('/alternatives', locale)} class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Wszystkie porównania</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Nie czekaj na wyłączenie." subtitle="Przetestuj OpenModeration w trybie sandbox na własnych komentarzach, niczego nie ukrywając. Za darmo do 1000 zapytań miesięcznie." buttonText="Umów rozmowę" buttonHref={localizePath('/book-a-call', locale)} />
</BaseLayout>
