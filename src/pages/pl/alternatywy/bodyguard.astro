---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const pageTitle = "Alternatywa dla Bodyguard: porównanie z OpenModeration";
const pageDescription = "Bodyguard czy OpenModeration? Porównanie ze źródłami: obsługiwane sieci, ceny, hosting danych w UE i pisemne uzasadnienie każdej decyzji moderacyjnej.";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/pl/alternatywy/bodyguard",
  "name": pageTitle,
  "description": pageDescription,
  "inLanguage": "pl",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Oferta", bodyguard: "API do moderacji dla platform oraz moderacja mediów społecznościowych dla marek, agencji i instytucji publicznych", openmod: "Jedna platforma: konektory do mediów społecznościowych i WordPressa, REST API i webhooki do całej reszty" },
  { feature: "Obsługiwane media społecznościowe", bodyguard: "Facebook, Instagram, TikTok, X, LinkedIn, YouTube, Twitch, Discord", openmod: "Natywnie Facebook, Instagram, YouTube i WordPress; strona internetowa przez API" },
  { feature: "Cena", bodyguard: "Guardian od 1000 € miesięcznie, Sentinel od 3000 € miesięcznie, Commander na wycenę; cena zależy od wielkości widowni", openmod: "Publiczna: za darmo do 1000 zapytań miesięcznie, Pro za 99 € miesięcznie (10 000 zapytań), Enterprise – wycena indywidualna" },
  { feature: "Hosting danych", bodyguard: "Nie określono na stronie głównej", openmod: "Zaprojektowane i hostowane w Unii Europejskiej" },
  { feature: "Modele AI", bodyguard: "Technologia opracowana przez Bodyguard", openmod: "Własna AI do moderacji, weryfikowana przez inne modele AI; nowe modele podłączane na bieżąco, gdy się pojawiają" },
  { feature: "Pisemne uzasadnienie każdej decyzji", bodyguard: "Brak wzmianki", openmod: "Tak, dla każdej decyzji, w wybranym języku" },
  { feature: "DSA", bodyguard: "Brak wzmianki na stronie głównej", openmod: "Dziennik audytowy wszystkich decyzji, automatycznych i ludzkich" },
  { feature: "Deklarowana zgodność", bodyguard: "RODO, SOC 2 Type 2", openmod: "RODO; pełny dziennik audytowy i rejestr na potrzeby DSA" },
  { feature: "Języki", bodyguard: "46 języków według firmy", openmod: "Ustalane z Tobą podczas konfiguracji" },
];

const faqItems = [
  {
    question: "Jaka jest najlepsza alternatywa dla Bodyguard?",
    answer: "To zależy od potrzeb. Jeśli chcesz zacząć od darmowego planu, mieć dane hostowane w UE i pisemne uzasadnienie każdego ukrytego komentarza, OpenModeration spełnia te kryteria. Jeśli musisz natywnie moderować TikToka, X, LinkedIna, Twitcha lub Discorda, Bodyguard obsługuje te sieci, a OpenModeration nie.",
  },
  {
    question: "Ile kosztuje Bodyguard w porównaniu z OpenModeration?",
    answer: "Według strony z cennikiem Bodyguard oferuje plan Guardian od 1000 € miesięcznie i plan Sentinel od 3000 € miesięcznie, a cena zależy od wielkości widowni. OpenModeration ma darmowy plan do 1000 zapytań miesięcznie i plan Pro za 99 € miesięcznie za 10 000 zapytań; Enterprise jest wyceniany indywidualnie.",
  },
  {
    question: "Bodyguard vs OpenModeration: czym się różnią?",
    answer: "Bodyguard to francuska firma z technologią moderacji AI opracowaną we własnym zakresie i szerokim zasięgiem w mediach społecznościowych. OpenModeration łączy własną AI do moderacji z weryfikacją przez inne modele AI, publikuje ceny, hostuje dane w UE i uzasadnia każdą decyzję na piśmie.",
  },
  {
    question: "Czy OpenModeration spełnia wymogi DSA?",
    answer: "OpenModeration przygotowuje pisemne uzasadnienie każdej decyzji i przechowuje dziennik audytowy wszystkich decyzji, niezależnie od tego, czy podjęła je AI, czy moderator. Oba elementy służą bezpośrednio do uzasadnienia decyzji wymaganego przez art. 17 DSA.",
  },
  {
    question: "Czy można przejść z Bodyguard na OpenModeration bez zaczynania od zera?",
    answer: "Na Facebooku, Instagramie, YouTube i w WordPressie wystarczy podłączyć konta, a zespół Logora dopasuje moderację do Twoich zasad i przypadków użycia. W przypadku własnej platformy REST API OpenModeration zastępuje wywołanie dotychczasowego API. W trybie sandbox można najpierw porównać decyzje na prawdziwych komentarzach, niczego nie ukrywając.",
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "Alternatywy", href: localizePath('/alternatives', locale) }, { label: "Bodyguard" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Porównanie
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternatywa dla Bodyguard: OpenModeration w bezpośrednim porównaniu</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bodyguard to uznana francuska firma w dziedzinie moderacji z AI. OpenModeration stawia na inne rozwiązania: darmowy plan, potem Pro za 99 € miesięcznie, dane hostowane w UE i pisemne uzasadnienie każdej decyzji. Oto różnice, ze źródłami, aby wybór był świadomy.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Wybierz OpenModeration, jeśli…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>chcesz zacząć za darmo, a potem płacić mniej niż 100 € miesięcznie;</li>
          <li>zależy Ci na pełnym dzienniku audytowym i możliwości eksportu danych;</li>
          <li>Twoje dane muszą pozostać w Unii Europejskiej;</li>
          <li>musisz uzasadniać każde usunięcie komentarza, jak wymaga DSA;</li>
          <li>chcesz moderacji, która korzysta z postępu modeli AI, zamiast opierać się na jednym algorytmie.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Bodyguard może lepiej pasować, jeśli…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>musisz natywnie moderować TikToka, X, LinkedIna, Twitcha lub Discorda;</li>
          <li>Twój dział zakupów wymaga certyfikatu SOC 2 Type 2;</li>
          <li>wolisz rozwiązanie w całości zarządzane przez jednego dostawcę.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Bodyguard i OpenModeration punkt po punkcie</h2>
      <p class="mt-4 text-surface-500">Informacje o Bodyguard pochodzą z jego strony, bodyguard.ai, dostęp: 20 października 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Kryterium</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Bodyguard</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.bodyguard}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Co naprawdę zmienia się w codziennej pracy</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Wiesz, dlaczego komentarz został ukryty</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration dołącza do każdej decyzji pisemne uzasadnienie, widoczne dla zespołu i zwracane przez API. Możesz odpowiedzieć czytelnikowi, który ją kwestionuje, a DSA wymaga właśnie uzasadniania każdego usunięcia.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Twoje zasady i Twoje przypadki użycia</h3>
          <p class="mt-2 text-sm text-surface-600">Zespół Logora konfiguruje moderację razem z Tobą: oczywiste naruszenia są ukrywane automatycznie, uzasadniona krytyka pozostaje widoczna, a przypadki graniczne trafiają do zespołu, który rozstrzyga je jednym kliknięciem w konsoli.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Znacznie niższy próg wejścia</h3>
          <p class="mt-2 text-sm text-surface-600">Bodyguard zaczyna się od 1000 € miesięcznie. OpenModeration jest darmowe do 1000 zapytań miesięcznie, a plan Pro kosztuje 99 € miesięcznie. Wdrożenie on-premise jest możliwe na życzenie: <a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">porozmawiajmy</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">AI, która podąża za postępem modeli</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration działa na własnej AI do moderacji, a w delikatnych przypadkach jej decyzje weryfikują inne modele AI. Gdy pojawia się lepszy lub tańszy model, zespół szybko go podłącza, bez żadnych zmian po Twojej stronie. Moderacja korzysta więc z postępu rynku AI, zamiast tkwić w jednym wewnętrznym algorytmie.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Przejście z Bodyguard na OpenModeration w 3 krokach</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">1. Przetestuj w trybie sandbox</h3>
          <p class="mt-2 text-sm text-surface-600">Podłącz stronę internetową, WordPress lub strony na Facebooku, Instagramie i YouTube. OpenModeration analizuje prawdziwe komentarze, niczego nie ukrywając, a Bodyguard działa dalej.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">2. Dostrój z zespołem Logora</h3>
          <p class="mt-2 text-sm text-surface-600">Porównujemy decyzje z decyzjami obecnego narzędzia i dopasowujemy moderację do Twoich zasad i przypadków użycia, z pisemnym uzasadnieniem każdej decyzji.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">3. Włączaj kanał po kanale</h3>
          <p class="mt-2 text-sm text-surface-600">Włącz moderację w jednym kanale, potem w kolejnych. Wątpliwymi przypadkami zajmuje się nasz zespół, a każda decyzja zostaje zapisana w dzienniku aktywności.</p>
        </div>
      </div>
      <p class="mt-8 text-center text-surface-600">Chcesz zobaczyć to na własnych komentarzach? <a href={localizePath('/book-a-call', locale)} class="font-medium text-brand-600 hover:text-brand-500">Umów rozmowę z zespołem</a>.</p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Najczęstsze pytania" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bodyguard jest znakiem towarowym swojego właściciela. Informacje o nim pochodzą z <a href="https://bodyguard.ai/fr" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">bodyguard.ai</a> i jego <a href="https://www.bodyguard.ai/en/social-media/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">strony z cennikiem</a> (dostęp: 20 października 2026). Widzisz błąd? Napisz do nas: <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Dowiedz się więcej</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={localizePath('/social-media-moderation', locale)} class="font-medium text-brand-600 hover:text-brand-500">Moderacja mediów społecznościowych z OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/dsa-compliance/statement-of-reasons', locale)} class="font-medium text-brand-600 hover:text-brand-500">Uzasadnienie decyzji wymagane przez DSA &rarr;</a></li>
        <li><a href={localizePath('/moderation-software', locale)} class="font-medium text-brand-600 hover:text-brand-500">Oprogramowanie do moderacji OpenModeration &rarr;</a></li>
        <li><a href={localizePath('/alternatives', locale)} class="font-medium text-brand-600 hover:text-brand-500">Wszystkie porównania &rarr;</a></li>
        <li><a href={localizePath('/pricing', locale)} class="font-medium text-brand-600 hover:text-brand-500">Cennik OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Przetestuj alternatywę dla Bodyguard." subtitle="Podłącz swoje strony, przetestuj sandbox na prawdziwych komentarzach i czytaj pisemne uzasadnienie każdego ukrytego komentarza. Na start za darmo." buttonText="Umów rozmowę" buttonHref={localizePath('/book-a-call', locale)} />
</BaseLayout>
