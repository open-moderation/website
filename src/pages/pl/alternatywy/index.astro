const tableRows = [
  { feature: "Modele AI", them: "Jeden model, często nieokreślony", openmod: "Własna AI do moderacji, weryfikowana przez inne modele AI; nowe modele podłączane na bieżąco, gdy się pojawiają" },
  { feature: "Wdrożenie", them: "Często wyłącznie chmura SaaS", openmod: "Chmura zarządzana w UE; on-premise na życzenie" },
  { feature: "Automatyczne działania", them: "Same wyniki, logikę budujesz sam", openmod: "Ukrywa oczywiste naruszenia, zostawia uprawnioną krytykę, wątpliwe przypadki kieruje do ludzi" },
  { feature: "Weryfikacja przez człowieka", them: "Własną kolejkę trzeba zbudować", openmod: "Wątpliwe przypadki obsługuje nasz zespół" },
  { feature: "Rejestr pod DSA", them: "Ograniczony lub brak", openmod: "Każda decyzja z pisemnym uzasadnieniem, zapisana i gotowa do eksportu" },
];
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={alternativesJsonLd}>
  <Breadcrumb items={[{ label: "Strona główna", href: localizePath('/', locale) }, { label: "Alternatywy" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Porównania alternatyw</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Porównaj OpenModeration z alternatywami</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Większość narzędzi do moderacji oferuje API albo konsolę. OpenModeration łączy jedno i drugie: własną AI do moderacji weryfikowaną przez inne modele AI, automatyczne reguły, weryfikację przez człowieka i rejestr decyzji gotowy na DSA.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {comparisons.map((comparison) => (
          <a href={localizePath(`/alternatives/${comparison.slug}`, locale)} class="group rounded-xl border border-surface-200 bg-surface-50 p-8 transition hover:border-brand-300 hover:shadow-md">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={comparison.iconPath}/></svg>
            </div>
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">{comparison.title}</h2>
            <p class="mt-1 text-xs font-medium uppercase tracking-wide text-surface-400">{comparison.tagline}</p>
            <p class="mt-3 text-sm text-surface-500">{comparison.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Przeczytaj porównanie
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-4xl">
        <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Dlaczego zespoły przechodzą na OpenModeration</h2>
        <p class="mt-3 text-lg text-surface-500">We wszystkich porównaniach powtarza się ten sam schemat: przy samym API warstwę operacyjną trzeba zbudować samodzielnie.</p>
        <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="bg-white">
                <th class="px-6 py-4 font-semibold text-surface-900">Funkcja</th>
                <th class="px-6 py-4 font-semibold text-surface-500">Typowe API do moderacji</th>
                <th class="px-6 py-4 font-semibold text-brand-700">OpenModeration</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200 bg-white">
              {tableRows.map((row) => (
                <tr>
                  <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                  <td class="px-6 py-4 text-surface-600">{row.them}</td>
                  <td class="px-6 py-4 font-medium text-accent-600">{row.openmod}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-surface-600">OpenModeration działa na własnej AI do moderacji, a w delikatnych przypadkach jej decyzje weryfikują inne modele AI. Gdy pojawia się lepszy lub tańszy model, zespół szybko go podłącza, bez żadnych zmian po Twojej stronie. Moderacja korzysta z postępu na rynku AI, zamiast tkwić przy jednym algorytmie.</p>
      </div>
    </div>
  </section>

  <CTASection
    title="Nie buduj własnych narzędzi do moderacji."
    subtitle="Przetestuj OpenModeration w trybie sandbox na swoich komentarzach, bez ukrywania czegokolwiek. Za darmo do 1000 zapytań miesięcznie."
    buttonText="Umów rozmowę"
    buttonHref={localizePath('/book-a-call', locale)}
  />

  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Dowiedz się więcej</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={localizePath('/moderation-software', locale)} class="rounded-full border border-surface-200 bg-surface-50 px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Oprogramowanie do moderacji</a>
        <a href={localizePath('/features', locale)} class="rounded-full border border-surface-200 bg-surface-50 px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Funkcje</a>
        <a href={localizePath('/how-it-works', locale)} class="rounded-full border border-surface-200 bg-surface-50 px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Jak to działa</a>
        <a href={localizePath('/pricing', locale)} class="rounded-full border border-surface-200 bg-surface-50 px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Cennik</a>
        <a href={localizePath('/blog/comment-moderation-guide', locale)} class="rounded-full border border-surface-200 bg-surface-50 px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Poradnik moderacji komentarzy</a>
      </div>
    </div>
  </section>
</BaseLayout>
