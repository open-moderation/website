  "@type": "CollectionPage",
  "@id": "https://www.openmoderation.com/pl/alternatywy",
  "url": "https://www.openmoderation.com/pl/alternatywy",
  "name": pageTitle,
  "description": pageDescription,
  "inLanguage": "pl"
};

const icon = "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4";

