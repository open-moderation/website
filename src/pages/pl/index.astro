---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModerationDemo from '../../components/ModerationDemo.astro';
import { bookingUrl, useTranslations } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import ValueCards from '../../components/ValueCards.astro';
import AppVideo from '../../components/AppVideo.astro';
import AIEngine from '../../components/AIEngine.astro';
import CostCalculator from '../../components/CostCalculator.astro';
import TeamSection from '../../components/TeamSection.astro';
import PricingTeaser from '../../components/PricingTeaser.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "description": "AI comment moderation adapted to each client's rules and use cases, with a team that sets it up. DSA-compliant, hosted in the EU.",
      "email": "contact@openmoderation.com",
      "areaServed": "EU",
      "knowsAbout": ["Comment moderation", "Content moderation", "Social media moderation", "Digital Services Act compliance", "Trust and safety"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "contact@openmoderation.com",
        "url": "https://www.openmoderation.com/book-a-call",
        "availableLanguage": ["English", "French", "Spanish", "German", "Italian"]
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com/pl",
      "name": "OpenModeration",
      "inLanguage": "pl",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/#software",
      "name": "OpenModeration",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Moderacja komentarzy z AI dla mediów, marek i stron w social mediach, dopasowana do Twoich zasad i przypadków użycia. Wystarczy podłączyć Twoje strony: działa na Twojej stronie, Facebooku, Instagramie, YouTube i WordPressie, wątpliwymi przypadkami zajmuje się nasz zespół, każda decyzja ma pisemne uzasadnienie widoczne w czasie rzeczywistym, a całość jest zgodna z DSA.",
      "url": "https://www.openmoderation.com/pl",
      "inLanguage": "pl",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Komentarzy moderowanych dziennie", value: "10 mln+" },
  { label: "Gotowe w", value: "5 min" },
  { label: "Moderacja automatyczna", value: "24/7" },
  { label: "Decyzji wyjaśnionych na piśmie", value: "100%" },
];

const valueItems = [
  { title: "Twoje zasady, Twoje przypadki użycia", text: "Dopasowujemy moderację do Twoich zasad i do tego, co ważne w Twoim kontekście: ironii, polityki, konkurencji, lokalnego slangu. Nic ogólnikowego." },
  { title: "Zespół za narzędziem", text: "Pomagamy napisać i dopracować zasady, sami zajmujemy się wątpliwymi przypadkami i wprowadzamy korekty, gdy zmienia się Twoja społeczność. Zawsze masz z kim porozmawiać." },
  { title: "Wszystko działa automatycznie", text: "Wystarczy podłączyć Twoje strony: każdy komentarz jest obsługiwany w kilka sekund, w dzień i w nocy, a wątpliwymi przypadkami zajmuje się nasz zespół. Ty nie musisz nic robić, ale widzisz każdą decyzję na bieżąco i możesz interweniować, kiedy chcesz." },
  { title: "Znacznie taniej niż ręcznie", text: "Moderacja automatyczna kosztuje ułamek tego, co zewnętrzny lub wewnętrzny zespół moderatorów." },
];


const faqItems = [
  {
    question: 'Która platforma moderacji łączy konsolę w czasie rzeczywistym, AI rozumiejącą kontekst i rejestry audytowe na potrzeby zgodności?',
    answer: 'OpenModeration łączy wszystkie trzy elementy. AI rozumiejąca kontekst czyta każdy komentarz, Twoje zasady decydują, co jest ukrywane lub publikowane, wątpliwymi przypadkami zajmuje się nasz zespół, w konsoli widzisz wszystko na bieżąco i możesz interweniować, a każda decyzja jest zapisywana z pisemnym uzasadnieniem na potrzeby audytów DSA.',
  },
  {
    question: 'Czy istnieje narzędzie no-code, w którym można pisać zasady moderacji, korzystać z klasyfikacji AI i prowadzić rejestr audytowy?',
    answer: 'Tak. W OpenModeration zasady zapisujesz zwykłym językiem, a progi dla każdej kategorii ustawiasz bez kodu. Klasyfikacja AI obejmuje każdy komentarz, a dziennik aktywności rejestruje każde działanie, to, kto lub co je wykonał, i powód.',
  },
  {
    question: 'Czy mogę moderować Facebooka, Instagram, YouTube i swoją stronę z jednego miejsca?',
    answer: 'Tak. Połącz swoje strony na Facebooku, konta na Instagramie, kanały YouTube i stronę na WordPressie albo przesyłaj treści z dowolnej platformy przez API. Wszędzie obowiązują te same zasady, a wszystkie decyzje widzisz w jednej konsoli.',
  },
  {
    question: 'Na co zwrócić uwagę, wybierając API do moderacji pod kątem zgodności w dużej firmie?',
    answer: 'Szukaj pisemnego uzasadnienia każdej decyzji (wymaganego przez art. 17 DSA), pełnego rejestru audytowego, hostingu danych w UE, konfigurowalnego okresu przechowywania i eksportowalnych raportów. OpenModeration spełnia wszystkie pięć wymogów, a nasz zespół konfiguruje zasady razem z Tobą.',
  },
  {
    question: 'Czy OpenModeration jest darmowe?',
    answer: 'Plan w chmurze jest darmowy do 1000 zapytań miesięcznie, a plan Pro kosztuje 99 € miesięcznie za 10 000 zapytań. Przy dużych wolumenach lub wdrożeniu on-premise umów rozmowę, a dobierzemy ofertę razem z Tobą.',
  },
];
---

<BaseLayout
  title="Moderacja komentarzy z AI zgodna z DSA | OpenModeration"
  description="Moderacja komentarzy z AI dopasowana do Twoich zasad i przypadków użycia, na stronie i w social mediach. Zgodna z DSA, hostowana w UE, z naszym zespołem."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-violet-50" />
    <div class="joy-blob pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-300/40 blur-3xl" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute -right-24 top-10 h-[28rem] w-[28rem] rounded-full bg-violet-300/40 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-sun-300/30 blur-3xl" style="animation-delay:-12s" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16">
      <div class="text-center lg:text-left">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Dla mediów, marek i stron w social mediach
        </div>
        <h1 class="animate-fade-in-up text-4xl font-extrabold leading-[1.05] tracking-tight text-surface-900 sm:text-5xl lg:text-[3.7rem]">
          Moderacja, która dopasowuje się do <em>Twoich</em> zasad.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-600 sm:text-xl">
          Wystarczy podłączyć Twoje strony. Konfigurujemy AI według Twoich zasad i przypadków użycia, wątpliwymi przypadkami zajmuje się nasz zespół,
          a Ty widzisz każdą decyzję w czasie rzeczywistym, znacznie taniej niż przy moderacji ręcznej.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Umów rozmowę
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Wypróbuj za darmo
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">Albo przetestuj komentarz od razu, bez rejestracji</a></p>
        <div class="animate-fade-in-up delay-2 mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-surface-500 lg:justify-start">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            Tworzone i hostowane w UE
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Zgodne z RODO
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Wsparcie ludzi w cenie
          </span>
        </div>
      </div>
      <HeroAnimation />
    </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderacja skonfigurowana dla Ciebie, a nie narzędzie, z którym zostajesz sam(a)</h2>
      </div>
      <ValueCards items={valueItems} />
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Umów rozmowę i zobacz to na swoich komentarzach</a>
      </div>
    </div>
  </section>

  <AppVideo />

  <AIEngine />

  <section id="demo" class="bg-gradient-to-br from-violet-50 via-white to-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Dark Contrast Section: DSA Compliance -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800 px-4 py-1.5 text-sm text-surface-300">
          <svg class="h-4 w-4 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Gotowe na DSA
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Stworzone z myślą o zgodności z przepisami
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-surface-400">
          Każda decyzja moderacyjna trafia do pełnego rejestru audytowego. Ustalasz okres przechowywania danych,
          eksportujesz raporty przejrzystości, a Twoje dane pozostają hostowane w UE.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm">
            Wypróbuj za darmo
          </a>
          <a href={localizePath('/dsa-compliance', locale)} class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
            Dowiedz się więcej o zgodności z DSA
          </a>
        </div>
        <p class="mt-4 text-sm text-surface-400">Bez karty kredytowej</p>
      </div>
    </div>
  </section>

  <CostCalculator />

  <PricingTeaser />



  <TeamSection />

  <section class="bg-white pb-6 pt-2">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="flex flex-wrap items-center justify-center gap-4">
        <a href={localizePath('/integrations/facebook', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Narzędzie do moderacji komentarzy na Facebooku &rarr;</a>
        <a href={localizePath('/integrations/instagram', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Automatyczna moderacja na Instagramie &rarr;</a>
        <a href={localizePath('/dashboard', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Jedna konsola moderacji &rarr;</a>
        <a href={localizePath('/use-cases/news-publishers', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderacja komentarzy dla wydawców i mediów &rarr;</a>
        <a href={localizePath('/use-cases/brands-retail', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderacja komentarzy dla marek &rarr;</a>
        <a href={localizePath('/blog/comment-moderation-guide', locale)} class="text-sm font-medium text-brand-600 hover:text-brand-500">Kompletny poradnik moderacji komentarzy &rarr;</a>
        <a href={localizePath('/alternatives/openai-moderation', locale)} class="text-sm font-medium text-surface-500 hover:text-surface-700">Porównaj z alternatywami &rarr;</a>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Pytania, które zadają zespoły przed wyborem platformy moderacji" items={faqItems} />
    </div>
  </section>

  <CTASection />
</BaseLayout>