---
import SectorPage from '../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Automatyczna moderacja komentarzy z AI"
  description="Automatyczna moderacja komentarzy na stronie i w social mediach, dopasowana do Twoich zasad i przypadków użycia, całą dobę, z uzasadnieniem każdej decyzji."
  crumb="Automatyczna moderacja"
  parent={null}
  eyebrow="Moderacja komentarzy z AI"
  h1="Automatyczna moderacja komentarzy na Twoich zasadach"
  intro="Komentarze napływają przez całą dobę, najczęściej wtedy, gdy Twój zespół jest offline. OpenModeration moderuje je automatycznie dzięki AI, która w kilka sekund stosuje Twoje zasady. Przypadkami wymagającymi ludzkiej oceny zajmuje się nasz zespół."
  problem="Moderacja ręczna nie nadąża: szczyty przychodzą wieczorem, w weekendy albo gdy wybucha ważny temat. Tradycyjne narzędzia automatyczne opierają się na listach słów i ukrywają albo za dużo, albo za mało."
  approach="AI czyta każdy komentarz w kontekście i sprawdza go pod kątem Twoich zasad. Dwa progi dla każdej kategorii oddzielają to, co jest ukrywane automatycznie, to, co jest publikowane, i to, co trafia do weryfikacji przez człowieka. Każda decyzja ma pisemne wyjaśnienie."
  result="Obelgi, mowa nienawiści, spam i oszustwa znikają w kilka sekund, bez czekania, aż ktoś się zaloguje. Twój zespół nie musi nic robić, a każdą decyzję widzi w czasie rzeczywistym."
  featuresTitle="Automatyczna moderacja pod pełną kontrolą"
  featuresIntro="Automatycznie nie znaczy „czarna skrzynka”. To Ty decydujesz o zasadach i o wątpliwych przypadkach."
  features={[
    { title: "Ty ustalasz poziom automatyzacji", text: "Surowiej, łagodniej, więcej lub mniej przypadków do weryfikacji: progi dostosowujesz kategoria po kategorii." },
    { title: "Uzasadnienie każdej decyzji", text: "Każdy ukryty komentarz ma pisemne uzasadnienie, które można pokazać jego autorowi lub regulatorowi." },
    { title: "Każdy język", text: "Jedna polityka stosowana do komentarzy niezależnie od języka, w którym zostały napisane." },
    { title: "Na wszystkich Twoich platformach", text: "Twoja strona przez API lub WordPress oraz Twoje strony na Facebooku, Instagramie i YouTube, z tymi samymi zasadami." },
  ]}
  why={[
    { title: "Twoje zasady, a nie ogólny schemat", text: "Moderacja opiera się na Twoich zasadach i przypadkach użycia. Dopracowujemy ją razem z Tobą." },
    { title: "Przetestuj na żywo", text: "Wklej komentarz do demo i zobacz decyzję wraz z wyjaśnieniem, bez rejestracji." },
    { title: "Zgodność z DSA", text: "Uzasadnienia decyzji, zgłoszenia użytkowników, weryfikacja przez ludzi i pełna historia w standardzie." },
  ]}
  faq={[
    { question: "Czy automatyczna moderacja popełnia błędy?", answer: "Żaden system nie jest doskonały. Dlatego o wątpliwych przypadkach nie decyduje sama AI: zajmuje się nimi nasz zespół, a Ty możesz cofnąć każdą decyzję jednym kliknięciem." },
    { question: "Jak szybko komentarz zostaje zmoderowany?", answer: "W ciągu kilku sekund od opublikowania lub otrzymania." },
    { question: "Czy komentarze na Facebooku można moderować automatycznie?", answer: "Tak. Połącz swoje strony na Facebooku i konta na Instagramie: komentarze łamiące Twoje zasady są ukrywane automatycznie." },
    { question: "Ile to kosztuje?", answer: "Na start jest darmowy plan, a także plan Pro. Przy dużych wolumenach umów rozmowę, a dobierzemy plan razem z Tobą." },
  ]}
  related={[
    { eyebrow: "Demo", title: "Przetestuj moderację", text: "Wklej komentarz i w kilka sekund zobacz decyzję.", href: localizePath('/demo', locale) },
    { eyebrow: "Integracja", title: "Moderacja komentarzy na Facebooku", text: "Automatycznie ukrywaj komentarze pod postami na Facebooku.", href: localizePath('/integrations/facebook', locale) },
    { eyebrow: "Poradnik", title: "Jak napisać politykę moderacji", text: "Zasady, które warto ustalić przed automatyzacją.", href: localizePath('/content-moderation-policy', locale) },
  ]}
  ctaTitle="Zautomatyzuj moderację jeszcze w tym tygodniu."
  ctaSubtitle="Umów rozmowę: razem ustalimy Twoje zasady i przetestujemy je na Twoich prawdziwych komentarzach."
/>
