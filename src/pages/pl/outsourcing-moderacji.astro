---
import SectorPage from '../../components/SectorPage.astro';
import { getLocale, localizePath } from '../../i18n/routes';

const locale = getLocale(Astro.url.pathname);
---

<SectorPage
  title="Outsourcing moderacji treści: alternatywa dla agencji"
  description="Szukasz agencji moderacji lub outsourcingu moderacji? Porównaj z moderacją AI i dedykowanym zespołem: Twoje zasady stosowane 24/7, za ułamek ceny agencji."
  crumb="Outsourcing moderacji"
  parent={null}
  eyebrow="Usługi moderacji"
  h1="Outsourcing moderacji bez kosztów agencji"
  intro="Powierzenie komentarzy agencji moderacji jest drogie i zależy od osób, które nie znają Twojej linii redakcyjnej. OpenModeration łączy AI, która dzień i noc stosuje Twoje zasady, z zespołem, który Cię wspiera: wygoda usługi zewnętrznej za ułamek ceny."
  problem="Usługi moderacji prowadzonej przez ludzi są rozliczane według wolumenu lub czasu pracy, z opóźnieniami w nocy i w weekendy. Szkolenie zewnętrznych moderatorów z Twoich zasad wymaga czasu, a jakość różni się w zależności od osoby."
  approach="Dopasowujemy moderację do Twoich zasad i przypadków użycia. AI obsługuje każdy komentarz w kilka sekund, zawsze w ten sam sposób. Przypadkami granicznymi, zgłoszeniami i odwołaniami zajmuje się nasz zespół. Ty widzisz każdą decyzję w czasie rzeczywistym i możesz interweniować, kiedy chcesz."
  result="Moderacja szybsza i bardziej spójna niż zewnętrzny zespół, dostępna 24/7, z pisemnym zapisem każdej decyzji i przewidywalnym kosztem."
  featuresTitle="Co robimy dla Ciebie"
  featuresIntro="Nie kupujesz narzędzia do samodzielnej konfiguracji: wdrażamy moderację razem z Tobą i zostajemy na dłużej."
  features={[
    { title: "Przełożenie zasad na instrukcje", text: "Przekładamy Twoje zasady na jasne instrukcje i testujemy je na Twoich prawdziwych komentarzach przed włączeniem." },
    { title: "Monitorowanie i korekty", text: "Razem przeglądamy wątpliwe przypadki i dostosowujemy zasady, gdy zmienia się Twoja publiczność lub cykl informacyjny." },
    { title: "Moderacja 24/7", text: "W nocy, w weekendy i podczas szczytów ruchu komentarze są obsługiwane w kilka sekund." },
    { title: "Pełna kontrola, zero pracy", text: "Wrażliwe decyzje pozostają w rękach ludzi: przypadki graniczne rozstrzyga nasz zespół, a Ty widzisz wszystko w jednej konsoli i możesz zmienić każdą decyzję." },
  ]}
  why={[
    { title: "Znacznie taniej", text: "Automatyczna moderacja ze wsparciem kosztuje ułamek zewnętrznej moderacji prowadzonej przez ludzi." },
    { title: "Spójnie i z wyjaśnieniem", text: "Ta sama zasada daje tę samą decyzję, za każdym razem z pisemnym wyjaśnieniem." },
    { title: "Zgodność z DSA", text: "Uzasadnienia decyzji, zgłoszenia użytkowników i pełna historia, bez uzależnienia od procesów dostawcy." },
  ]}
  faq={[
    { question: "Czy to może w pełni zastąpić agencję moderacji?", answer: "W większości przestrzeni komentarzy tak: AI obsługuje większość wolumenu, a przypadki graniczne rozstrzyga nasz zespół. Jeśli masz już zespół moderatorów, może w każdej chwili interweniować w konsoli." },
    { question: "Kto zajmuje się konfiguracją?", answer: "Robimy to razem z Tobą. Pierwsza rozmowa pozwala nam poznać Twoje zasady, przypadki użycia i drażliwe sytuacje, a następnie testujemy zasady na Twoich komentarzach." },
    { question: "Jak porównać koszty?", answer: "Umów rozmowę, podając miesięczny wolumen komentarzy: prześlemy wycenioną ofertę do porównania z obecnym dostawcą." },
    { question: "Czy dane pozostają w Europie?", answer: "Tak. OpenModeration jest tworzone i hostowane w Unii Europejskiej i jest zgodne z RODO." },
  ]}
  related={[
    { eyebrow: "Porównanie", title: "Porównaj alternatywy w moderacji", text: "Jak OpenModeration wypada na tle agencji i innych narzędzi do moderacji.", href: localizePath('/alternatives', locale) },
    { eyebrow: "Analiza", title: "Budować czy kupić?", text: "Rzeczywisty koszt budowy moderacji we własnym zakresie.", href: localizePath('/build-vs-buy', locale) },
    { eyebrow: "Przypadek użycia", title: "Wydawcy i media", text: "Jak redakcje moderują komentarze.", href: localizePath('/use-cases/news-publishers', locale) },
  ]}
  ctaTitle="Porównaj z obecnym dostawcą."
  ctaSubtitle="Umów rozmowę, podając wolumen komentarzy: pokażemy moderację w działaniu i prześlemy wycenioną ofertę."
/>
