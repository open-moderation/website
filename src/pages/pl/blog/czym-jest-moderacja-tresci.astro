const glossary = [
  { term: "Treści generowane przez użytkowników (UGC)", def: "Wszystko, co publikują użytkownicy, a nie sam serwis: komentarze, opinie, posty, zdjęcia, filmy, wiadomości." },
  { term: "Zasady społeczności", def: "Publiczne reguły określające, co jest dozwolone w serwisie. Nazywane też polityką moderacji lub regulaminem." },
  { term: "Fałszywie pozytywny wynik", def: "Dopuszczalna treść błędnie usunięta lub ukryta." },
  { term: "Fałszywie negatywny wynik", def: "Szkodliwa treść błędnie pozostawiona w sieci." },
  { term: "Człowiek w pętli (human in the loop)", def: "Układ, w którym ludzie weryfikują decyzje, co do których automat nie ma pewności." },
  { term: "Kolejka weryfikacji", def: "Lista oznaczonych lub wątpliwych treści czekających na decyzję człowieka." },
  { term: "Zgłoszenie i działanie (notice and action)", def: "Mechanizm DSA, który pozwala każdemu zgłosić nielegalną treść usłudze hostingu, a ta musi zgłoszenie rozpatrzyć." },
  { term: "Uzasadnienie (statement of reasons)", def: "Wyjaśnienie, które serwis musi przekazać użytkownikowi, gdy ogranicza jego treść na podstawie DSA." },
