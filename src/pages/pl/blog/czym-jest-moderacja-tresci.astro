  { type: "Moderacja automatyczna", how: "O każdej treści decydują filtry lub modele AI.", pros: "Natychmiastowa, 24/7, radzi sobie z dużymi wolumenami.", cons: "Błędy w ocenie kontekstu, wymaga nadzoru." },
  { type: "Moderacja hybrydowa", how: "Automat obsługuje jasne przypadki, ludzie wątpliwe.", pros: "Szybkość i ludzki osąd.", cons: "Wymaga jasnych zasad i dobrego narzędzia do weryfikacji." },
