import Breadcrumb from '../../../components/Breadcrumb.astro';
import FAQ from '../../../components/FAQ.astro';
import { getLocale, localizePath } from '../../../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const title = "Moderacja komentarzy na YouTube: narzędzia i limity";
const description = "Jak moderować komentarze na YouTube: wstrzymywanie do sprawdzenia, blokowane słowa i linki, zatwierdzeni i ukryci użytkownicy, czat na żywo i automatyzacja.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Moderacja komentarzy na YouTube: jak korzystać z narzędzi YouTube Studio i kiedy automatyzować",
  "description": description,
  "inLanguage": "pl",
  "datePublished": "2026-10-30",
  "dateModified": "2026-10-30",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/pl/blog/moderacja-komentarzy-youtube" }
};

const levels = [
  { level: "Nie wstrzymuj żadnych komentarzy", effect: "Wszystko jest publikowane. Reagujesz dopiero po fakcie.", fit: "Małe kanały ze spokojną, znaną widownią" },
  { level: "Wstrzymuj potencjalnie nieodpowiednie komentarze", effect: "Automatyczny system YouTube wstrzymuje komentarze, które uzna za ryzykowne; pozostałe trafiają od razu na kanał.", fit: "Rozsądne ustawienie domyślne dla większości kanałów" },
  { level: "Bardziej rygorystyczne wstrzymywanie", effect: "Wstrzymywany jest szerszy zakres komentarzy: wyłapuje się więcej spamu i nadużyć, ale też więcej niewinnych wpisów.", fit: "Kanały przyciągające trolli lub będące celem nalotu" },
  { level: "Wstrzymuj wszystkie komentarze", effect: "Nic nie zostaje opublikowane, dopóki ktoś tego nie zatwierdzi.", fit: "Drażliwe filmy, krótkie okresy, niewielkie ilości komentarzy" },
];

const comparison = [
  { need: "Zatrzymać znaną obelgę lub zakazane słowo", builtin: "Tak, przez blokowane słowa, jeśli pisownia jest wystarczająco zbliżona", tool: "Tak, łącznie z wariantami i obejściami" },
  { need: "Rozumieć sarkazm, kontekst i zakodowany język", builtin: "Częściowo: filtr YouTube jest ogólny i nie da się go dostosować", tool: "Tak, każdy komentarz jest czytany w kontekście" },
  { need: "Stosować zasady właściwe dla kanału", builtin: "Nie, tylko słowa, linki i poziom rygoru", tool: "Tak, Twoje zasady i przypadki użycia opisane zwykłym językiem" },
  { need: "Rozładować zaległości wstrzymanych komentarzy", builtin: "Nie, ktoś musi otworzyć kolejkę i zdecydować", tool: "Tak, jednoznaczne przypadki są rozstrzygane, do człowieka trafiają tylko wątpliwe" },
  { need: "Pisemne uzasadnienie każdej decyzji", builtin: "Nie", tool: "Tak, dla każdego wstrzymanego lub odrzuconego komentarza" },
  { need: "Ścieżka audytu decyzji", builtin: "Brak historii do wyeksportowania", tool: "Tak, każda decyzja jest zapisywana" },
  { need: "Kilka kanałów i inne sieci w jednym miejscu", builtin: "Nie, kanał po kanale", tool: "Tak, YouTube, Facebook, Instagram, WordPress i Twoja strona internetowa" },
];

const faqItems = [
  {
    question: "Co oznacza „wstrzymany do sprawdzenia” na YouTube?",
    answer: "Komentarz nie został opublikowany. Czeka w sekcji „Wstrzymane do sprawdzenia” w YouTube Studio, gdzie właściciel kanału lub moderator może go zatwierdzić, usunąć albo pozostawić. YouTube wstrzymuje komentarze z powodu blokowanych słów lub linków, ponieważ automatyczny filtr uznał je za potencjalnie nieodpowiednie, albo dlatego, że wybrano wstrzymywanie wszystkiego. Wstrzymane komentarze są przechowywane przez ograniczony czas (centrum pomocy YouTube podaje obecnie do 60 dni), a potem znikają, jeśli nikt się nimi nie zajmie.",
  },
  {
    question: "Czy autor wie, że jego komentarz na YouTube został wstrzymany?",
    answer: "Nie. YouTube nie powiadamia autora o wstrzymaniu komentarza ani nie informuje ukrytego użytkownika, że został ukryty. Ta dyskrecja oszczędza wielu odpowiedzi w stylu „ocenzurowaliście mnie”, ale oznacza też, że jeśli autor zapyta, należy mu się wyjaśnienie.",
  },
  {
    question: "Jak działają blokowane słowa na YouTube?",
    answer: "W ustawieniach społeczności lub komentarzy kanału dodaje się listę słów i wyrażeń. Komentarze, które je zawierają lub są do nich bardzo podobne, są wstrzymywane do sprawdzenia zamiast publikowane, a ta sama lista działa na czacie na żywo. Zatwierdzeni użytkownicy omijają listę, a filtr nie rozumie znaczenia, więc zamaskowana lub sarkastyczna obelga i tak przechodzi.",
  },
  {
    question: "Czym różni się zatwierdzony użytkownik od ukrytego?",
    answer: "Komentarze zatwierdzonego użytkownika są publikowane bez przechodzenia przez filtry, co sprawdza się w przypadku stałych fanów lub partnerów. Komentarze i wiadomości na czacie ukrytego użytkownika są niewidoczne dla wszystkich pozostałych osób na kanale, a on sam o tym nie wie. Ukrywanie warto stosować wobec uporczywych trolli i kont spamowych.",
  },
  {
    question: "Czy można dać komuś uprawnienia moderatora bez udostępniania konta?",
    answer: "Tak. Do kanału można dodać moderatorów. Moderatorzy standardowi sprawdzają wstrzymane komentarze i działają na czacie na żywo; moderatorzy zarządzający mogą też zarządzać listami, takimi jak inni moderatorzy standardowi i zatwierdzeni użytkownicy. Do pełnego zarządzania kanałem służą uprawnienia kanału YouTube, które pozwalają zaprosić osoby z przypisaną rolą zamiast udostępniać hasło.",
  },
  {
    question: "Czy komentarze na YouTube można moderować automatycznie?",
    answer: "Własny filtr YouTube automatycznie wstrzymuje część komentarzy, ale nie stosuje Twoich zasad i zostawia kolejkę Tobie. Narzędzie połączone przez oficjalne YouTube Data API może opublikować, wstrzymać do sprawdzenia lub odrzucić każdy komentarz zgodnie z Twoimi zasadami. Tak działa OpenModeration, z pisemnym uzasadnieniem każdej decyzji.",
  },
  {
    question: "Czy dotyczy to także YouTube Shorts?",
    answer: "Komentarze pod Shorts należą do komentarzy kanału i podlegają tym samym ustawieniom: blokowane słowa, blokowane linki, ukryci użytkownicy i poziom wstrzymywania działają tak samo. Czat na żywo podczas transmisji to osobny strumień, z własnymi narzędziami, takimi jak tryb powolny i przerwy czasowe.",
  },
