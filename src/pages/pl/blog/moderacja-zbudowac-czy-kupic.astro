        <li><a href={localizePath('/pricing', locale)} class="font-medium text-brand-600 hover:text-brand-500">Proste, przejrzyste ceny &rarr;</a></li>
        <li><a href={localizePath('/features', locale)} class="font-medium text-brand-600 hover:text-brand-500">Wszystko, co platforma robi za Ciebie &rarr;</a></li>
      </ul>
    </div>
  </section>

  <GuideComparisons />

  <CTASection />
</BaseLayout>
