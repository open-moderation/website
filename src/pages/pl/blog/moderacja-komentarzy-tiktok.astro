  { tool: "Filtrowanie spamu i obraźliwych komentarzy", does: "TikTok ukrywa komentarze, które jego własne systemy uznają za spam lub obraźliwe", limit: "Nie widać ani nie da się dostroić tego, co TikTok uważa za obraźliwe, a filtr nie zna Twoich zasad" },
  { tool: "Filtrowanie słów kluczowych", does: "Komentarze zawierające słowa z Twojej listy są wstrzymywane do czasu zatwierdzenia", limit: "Tylko dokładne ciągi znaków: literówki, emoji, slang i inne języki przechodzą" },
  { tool: "Filtrowanie wszystkich komentarzy", does: "Każdy komentarz czeka na ręczne zatwierdzenie, zanim się pojawi", limit: "Bezpieczne, ale ktoś musi zatwierdzać każdy komentarz, co przy viralu się nie skaluje" },
  { tool: "Masowe usuwanie, zgłaszanie, blokowanie", does: "Zaznaczenie kilku komentarzy lub autorów i działanie na wszystkich naraz", limit: "Ręcznie, po fakcie i bez zapisu, dlaczego podjęto każde działanie" },
  { tool: "Ograniczanie i blokowanie", does: "Ogranicza lub wstrzymuje to, co konto może robić przy Twoich treściach", limit: "Działa konto po koncie; nowe konta pojawiają się szybciej, niż da się je blokować" },
  { tool: "Przypinanie komentarza", does: "Utrzymuje wybrany komentarz na górze wątku", limit: "Przydatne do wyjaśnień, ale niczego nie usuwa" },
  { tool: "Moderatorzy LIVE i filtr słów na LIVE", does: "Zaufane osoby mogą wyciszać lub usuwać widzów i komentarze podczas transmisji LIVE", limit: "Wymaga ludzi śledzących transmisję na bieżąco przez cały czas jej trwania" },
