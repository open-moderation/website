---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedComparisons from '../../components/RelatedComparisons.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FAQ from '../../components/FAQ.astro';

const migrationCode = `# Before: Mistral Moderation (direct)
import { Mistral } from '@mistralai/mistralai';
const mistral = new Mistral({ apiKey: '...' });
const result = await mistral.moderations.create({ input: text });

# After: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// Plus: pre-filter, double threshold, auto-actions, audit trail, cross-checked AI`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Mistral Moderation Alternative | OpenModeration",
  "description": "Mistral Moderation is a strong multilingual API, but it's a single model. OpenModeration runs its own moderation AI, cross-checked by other AI models, with pre-filtering, automated rules, and DSA-ready audit trails.",
};

const comparisonPoints = [
  { feature: "AI engine", mistral: "Mistral's moderation model only", openmod: "Our own moderation AI, cross-checked by other AI models on delicate cases" },
  { feature: "Categories", mistral: "11 fixed categories in the current model, including PII and jailbreaking", openmod: "10 standardized categories, plus your own categories described in plain language" },
  { feature: "Languages", mistral: "Strong multilingual (French, German, Spanish, Italian, Portuguese, etc.)", openmod: "Main EU languages and English, with delicate cases cross-checked by other AI models" },
  { feature: "Pre-filtering", mistral: "Not available", openmod: "Built-in word filter blocks obvious content before any API call" },
  { feature: "Decision engine", mistral: "Raw scores only", openmod: "Dual threshold: auto-approve / grey zone → reviewed by our team / auto-reject" },
  { feature: "Max input", mistral: "32,000 characters", openmod: "Up to 32,000 chars + batch processing for larger volumes" },
  { feature: "Dashboard", mistral: "API only. No review UI.", openmod: "Console where you see every decision in real time, analytics, team roles" },
  { feature: "Vendor lock-in", mistral: "Locked to Mistral", openmod: "Low. Model-agnostic engine: better models plugged in as they come out" },
  { feature: "Hosting", mistral: "Cloud API only", openmod: "EU-managed cloud; on-premise deployment possible on request" },
  { feature: "Compliance", mistral: "Basic API logs", openmod: "Full DSA audit trail with exportable reports" },
  { feature: "Pricing", mistral: "Set by Mistral on its API", openmod: "Free up to 1,000 requests/mo. Managed cloud from €99/mo (10K req included)." },
];

const reasons = [
  {
    title: "One model, frozen between two updates",
    description: "Mistral's moderation API excels at French, German, Spanish, and Italian content. But a single model stays the same between two updates. OpenModeration runs its own moderation AI, cross-checks delicate cases with other AI models, and plugs in better models as they come out."
  },
  {
    title: "Fixed categories vs configurable categories",
    description: "Mistral covers a fixed set of categories. Your community may also need to catch misinformation, grooming or breaches of its own rules. OpenModeration adds configurable categories: you describe them in plain language and our AI does the classification."
  },
  {
    title: "An API needs an operational layer",
    description: "Mistral gives you scores. A moderation service still needs human review, an action engine (hide/delete/flag), role-based access, DSA audit trails and analytics. OpenModeration ships all of this, and our team handles the doubtful cases."
  },
  {
    title: "No pre-filter means paying for obvious spam",
    description: "Every comment you send to Mistral's moderation endpoint counts towards your API usage. With OpenModeration's pre-filter, obvious spam, forbidden words, and regex patterns are blocked before any AI model sees them."
  },
];

const faqItems = [
  {
    question: "How much does Mistral Moderation cost vs OpenModeration?",
    answer: "Mistral sets the price of its moderation model on its own API. OpenModeration is free up to 1,000 requests per month. Managed cloud starts at €99/month for 10K requests."
  },
  {
    question: "Which AI does OpenModeration use?",
    answer: "Its own moderation AI, set up on your rules and your use cases, with delicate cases cross-checked by other AI models. When a better or cheaper model comes out, we plug it in quickly, with no code rewrite on your side."
  },
  {
    question: "How long does migration take?",
    answer: "Under an hour for the API swap: one POST /v1/moderation call replaces the Mistral client. Dashboard, rules and audit trails work immediately after."
  },
  {
    question: "Does it support French and other EU languages?",
    answer: "Yes. Our moderation AI handles French, German, Spanish, Italian and the other main EU languages, and delicate cases are cross-checked by other AI models."
  },
  {
    question: "Is every decision logged for DSA audits?",
    answer: "Yes. Every AI and human decision keeps its scores, thresholds, reviewer and timestamp. Export the full audit trail in one click for DSA transparency reports."
  },
];
---

<BaseLayout 
  title="Mistral Moderation Alternative: Pricing, Comparison & Migration" 
  description="Mistral Moderation is a single model. OpenModeration runs its own AI, cross-checked by other models, with rules, human review and DSA audit trails."
  canonical="https://www.openmoderation.com/alternatives/mistral-moderation"
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "Mistral Moderation Alternative" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-sm font-medium text-blue-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Mistral Moderation Alternative
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Mistral is excellent for EU moderation.<br/>A moderation service needs more than a model.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Mistral's moderation API handles European languages very well, but it is still a single model.
        OpenModeration runs its own moderation AI, <strong>cross-checked</strong> by other AI models, through one
        API call, with automated rules, human review by our team and DSA-compliant audit trails.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Try OpenModeration free</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">See comparison</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Why go beyond Mistral alone</h2>
        <p class="mt-4 text-lg text-surface-500">Mistral is one of the best EU-focused moderation APIs. Moderation, though, is a workflow, and the API is only one part of it.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            One call, the full platform
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Replace the Mistral client. Get the full platform.</h2>
          <p class="mt-4 text-lg text-surface-500">
            One POST /v1/moderation call replaces the Mistral client. OpenModeration adds pre-filtering, 
            double thresholds, automated actions and a complete audit trail, all through the same API call.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Cross-checked AI:</strong> other AI models arbitrate delicate cases before a decision is applied.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Model-agnostic:</strong> when a better or cheaper model comes out, we plug it in. Nothing changes on your side.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Built in Europe:</strong> European teams make both Mistral and OpenModeration, with developers in mind.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Mistral Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Mistral's API is excellent. OpenModeration is a complete platform.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Feature</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Mistral Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.mistral}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Mistral Moderation alternative: FAQ" />
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Compare other alternatives</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/alternatives/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/alternatives/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/alternatives/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/alternatives/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/alternatives/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection 
    title="More than a moderation model."
    subtitle="Our own cross-checked AI, automated rules and human review by our team, hosted in the EU. You see every decision in real time."
    buttonText="Try OpenModeration free"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>