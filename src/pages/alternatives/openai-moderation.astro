---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedComparisons from '../../components/RelatedComparisons.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FAQ from '../../components/FAQ.astro';

const migrationCode = `# OpenAI Moderation API (direct)
const openai = new OpenAI({ apiKey: 'sk-...' });
const mod = await openai.moderations.create({ input: text });
// Result: OpenAI-specific format, 13 categories, no thresholds

# OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({
    input: text,
    categories: ['hate', 'harassment', 'sexual', 'violence', 'self-harm', 'spam'],
    threshold: 0.5
  })
});
// Plus: pre-filter, double threshold, auto-actions, audit trail, real-time dashboard`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "OpenAI Moderation API Pricing & Alternatives",
  "description": "OpenModeration is an OpenAI Moderation API alternative that runs its own moderation AI, cross-checked by other AI models, with automated rules, human review by our team and DSA audit trails for enterprise compliance.",
};

const comparisonPoints = [
  { feature: "AI engine", openai: "One OpenAI model", openmod: "Our own moderation AI, cross-checked by other AI models on delicate cases" },
  { feature: "API format", openai: "Proprietary OpenAI format", openmod: "Standardized format. When we plug in a better AI model, nothing changes in your code." },
  { feature: "Pre-filtering", openai: "Not available. Every request hits the API", openmod: "Built-in word filter blocks obvious content before any AI call" },
  { feature: "Decision logic", openai: "Binary flagged/not flagged per category", openmod: "Dual threshold: auto-approve, grey zone reviewed by our team, or auto-reject" },
  { feature: "Moderation Console", openai: "API only. No dashboard, no review UI.", openmod: "Full dashboard: every decision in real time, team roles, analytics" },
  { feature: "Automated rules", openai: "Must build your own integration", openmod: "Included. Define rules once and the Action Engine enforces them automatically" },
  { feature: "Human review", openai: "Must build your own review UI", openmod: "Doubtful cases handled by our team; you can step in or override at any moment" },
  { feature: "Audit trail", openai: "Limited to API logs", openmod: "Full audit trail: every AI and human decision logged, exportable for DSA" },
  { feature: "Vendor lock-in", openai: "Full lock-in to OpenAI ecosystem", openmod: "None. Model-agnostic engine, and you can export your data at any time" },
  { feature: "Data sovereignty", openai: "Data processed on OpenAI servers", openmod: "Hosted in the EU. On-premise deployment possible on request." },
  { feature: "Pricing", openai: "Free endpoint (scores only)", openmod: "Free up to 1,000 requests/mo. Managed cloud from €99/mo (10K req included)." },
  { feature: "Max input length", openai: "32,000 characters", openmod: "Long texts supported + batch processing for larger volumes" },
];

const reasons = [
  {
    title: "You're locked into one model's accuracy",
    icon: "lock",
    description: "OpenAI Moderation works very well on English, less so on other languages or niche categories, and it gives you no second opinion. OpenModeration runs its own moderation AI and has delicate cases cross-checked by other AI models. When a better model comes out, we plug it in."
  },
  {
    title: "An API call is not a moderation workflow",
    icon: "api",
    description: "A toxicity score from OpenAI is only the start. You still have to decide which score triggers which action, review grey-area cases, log every decision for audits and manage your team's access. OpenModeration handles all of this, and our team reviews the doubtful cases."
  },
  {
    title: "Every comment goes to the API without pre-filtering",
    icon: "cost",
    description: "The OpenAI endpoint is free, but every comment still makes a round trip to it, even obvious spam or forbidden words. OpenModeration's pre-filter blocks these before they reach any AI model."
  },
  {
    title: "DSA compliance requires more than an API",
    icon: "compliance",
    description: "The EU Digital Services Act requires documented moderation decisions, appeal mechanisms, and transparency reports. A raw API response is not enough. OpenModeration gives you audit logs, review trails and exportable reports."
  },
];

const verticals = [
  { name: "Social Platforms", desc: "Moderate user comments and posts with context-aware AI and community-specific policies." },
  { name: "AI Applications", desc: "Filter both user inputs and LLM outputs. Define your own categories as they evolve." },
  { name: "Gaming", desc: "Real-time chat moderation across multiple languages with sub-250ms latency and automated actions." },
  { name: "Marketplaces", desc: "Flag spam listings, hate speech in reviews, and PII leaks before they go live." },
];

const faqItems = [
  {
    question: "Is the OpenAI Moderation API free?",
    answer: "Yes. OpenAI states that its moderation endpoint is free to use. It returns a flagged boolean and a score per category. Deciding what to hide, reviewing borderline cases and keeping an audit trail are left to you."
  },
  {
    question: "What does omni-moderation-latest detect?",
    answer: "omni-moderation-latest is OpenAI's current moderation model. It accepts text and images and scores 13 categories: harassment, harassment/threatening, hate, hate/threatening, illicit, illicit/violent, self-harm, self-harm/intent, self-harm/instructions, sexual, sexual/minors, violence and violence/graphic."
  },
  {
    question: "How much does OpenAI Moderation API cost vs OpenModeration?",
    answer: "OpenAI's moderation endpoint is free, but it only returns scores: no dashboard, no rules, no human review and no audit trail. OpenModeration has a free plan up to 1,000 requests a month; the managed cloud starts at €99/month for 10K requests."
  },
  {
    question: "Which AI does OpenModeration use?",
    answer: "Its own moderation AI, set up on your rules and your use cases. On delicate cases, other AI models arbitrate the decision before it is applied. The engine is model-agnostic: when a better or cheaper model comes out, we plug it in, with no code to rewrite on your side."
  },
  {
    question: "How long does migration take?",
    answer: "Under an hour. One POST /v1/moderation call replaces openai.moderations.create. Scores map to a standardized format, and thresholds and rules apply immediately."
  },
  {
    question: "What do I gain beyond raw scores?",
    answer: "You get the rest of the workflow: a pre-filter, dual thresholds (auto-approve, review by our team, auto-reject), a dashboard where you see every decision in real time, team roles and a DSA-ready audit trail with exportable reports."
  },
  {
    question: "Which moderation API is best for enterprise compliance?",
    answer: "For enterprise compliance, you need more than raw scores: documented decisions, role-based access, audit trails and exportable reports. OpenModeration covers all of it. Every AI and human decision is logged, rules are enforced automatically, and the audit trail exports in one click for DSA transparency reports. EU hosting keeps data under your control, and on-premise deployment is possible on request."
  },
  {
    question: "Do I have to change my code when OpenModeration changes AI models?",
    answer: "No. Responses keep the same standardized format. When a better or cheaper AI model comes out, our team plugs it in quickly, and nothing changes on your side."
  },
];
---

<BaseLayout 
  title="OpenAI Moderation API Pricing & Alternatives (2026)" 
  description="Is the OpenAI Moderation API free? Yes, but it only returns scores. Compare it with OpenModeration: your rules, human review and a DSA audit trail on top."
  canonical="https://www.openmoderation.com/alternatives/openai-moderation"
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "OpenAI Moderation Alternative" }]} />
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-50 px-4 py-1.5 text-sm font-medium text-green-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        OpenAI Moderation API Alternative
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        OpenAI Moderation is one model.<br/>OpenModeration is the platform.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        OpenAI's Moderation API gives you toxicity scores. OpenModeration gives you its own moderation AI, 
        cross-checked by other models, pre-filtering, automated rules, human review by our team and DSA-compliant 
        audit trails. It is hosted in the EU, and you can export your data and leave whenever you want.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Try OpenModeration free</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">See full comparison</a>
      </div>
      <div class="mx-auto mt-10 max-w-3xl rounded-xl border border-surface-200 bg-white p-6 text-left shadow-sm">
        <h2 class="text-base font-semibold text-surface-900">The OpenAI Moderation API in 30 seconds</h2>
        <ul class="mt-3 space-y-2 text-sm text-surface-600">
          <li><strong class="text-surface-900">Price:</strong> free. OpenAI states that the moderation endpoint is free to use.</li>
          <li><strong class="text-surface-900">Model:</strong> <code>omni-moderation-latest</code>, for text and images.</li>
          <li><strong class="text-surface-900">Categories:</strong> 13, from harassment and hate to self-harm, sexual content and violence.</li>
          <li><strong class="text-surface-900">What it leaves to you:</strong> rules, human review, explaining decisions to users and the DSA audit trail.</li>
        </ul>
        <a href="/blog/openai-moderation-api-guide" class="mt-4 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700">Read the full guide: categories, response format and limits &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Why switch section -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Why teams switch from OpenAI Moderation</h2>
        <p class="mt-4 text-lg text-surface-500">OpenAI's API is a good moderation engine. A moderation service needs everything that goes around it.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
              {r.icon === 'lock' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>}
              {r.icon === 'api' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>}
              {r.icon === 'cost' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
              {r.icon === 'compliance' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>}
            </div>
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            One integration, an AI that keeps improving
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            Same text moderation, more control
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            With OpenAI's API, you get scores. With OpenModeration, you get scores 
            <strong>plus</strong> pre-filtering, configurable thresholds, automated actions, 
            and a complete audit trail, all through the same API call.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Our own moderation AI</strong>, set up on your rules and your use cases.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>A second opinion</strong>: other AI models cross-check delicate cases before a decision is applied.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>No frozen model</strong>: better or cheaper models are plugged in as they come out, with nothing to change on your side.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">OpenAI Moderation API vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">A side-by-side look at the features you need to moderate in production.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Feature</th>
              <th class="px-6 py-4 font-semibold text-surface-500">OpenAI Moderation API</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.openai}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Hidden cost vs advantage -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Using OpenAI Moderation API alone
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Every comment goes to the API, even obvious spam or forbidden words</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Binary flagged/not flagged, with no grey zone for nuanced comments</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Build your own dashboard for human moderators to review edge cases</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Build your own rule engine to translate scores into actions</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Build your own audit logging system for DSA compliance</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> No second opinion on delicate cases</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Vendor lock-in to OpenAI ecosystem</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            OpenModeration
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Obvious spam and forbidden words are blocked before any AI call</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Two configurable thresholds decide what is approved, rejected or reviewed by our team</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Nothing to do on your side: you see every decision in real time and can step in whenever you want</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Rules set with three tools (forbidden words, category thresholds and your own rules in plain language), with no code</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> A full audit trail, exportable reports and configurable data retention</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Delicate cases cross-checked by other AI models</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> No frozen model: better models plugged in as they come out, and you can export your data</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Built for every content moderation use case</h2>
        <p class="mt-4 text-lg text-surface-500">You can replace OpenAI's API with OpenModeration in under an hour.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{v.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- omni-moderation-latest compatibility -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moving from omni-moderation-latest to OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Keep your integration simple and get the whole workflow around the score.</p>
        <p class="mt-2 text-sm"><a href="/blog/openai-moderation-api-guide" class="font-medium text-brand-600 hover:text-brand-500">How the OpenAI Moderation API works: categories, pricing and limits &rarr;</a></p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Replace one call</h3>
          <p class="mt-2 text-sm text-surface-500">One POST /v1/moderation call replaces openai.moderations.create, with a standardized response format.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Cross-checked decisions</h3>
          <p class="mt-2 text-sm text-surface-500">On delicate cases, other AI models arbitrate the decision, and doubtful cases are handled by our team.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">An AI that keeps improving</h3>
          <p class="mt-2 text-sm text-surface-500">When a better or cheaper AI model comes out, we plug it in quickly. Nothing changes on your side.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="OpenAI Moderation alternative: FAQ" />
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Compare other alternatives</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/alternatives/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/alternatives/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/alternatives/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/alternatives/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/alternatives/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

