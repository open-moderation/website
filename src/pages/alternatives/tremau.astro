---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedComparisons from '../../components/RelatedComparisons.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/alternatives/tremau",
  "name": "Tremau alternative: how OpenModeration compares",
  "description": "Tremau (Nima) or OpenModeration? A sourced comparison for news sites, brands and public bodies: offer, connectors, AI models, DSA, pricing and hosting.",
  "inLanguage": "en",
  "about": {
    "@id": "https://www.openmoderation.com/#software"
  }
};

const rows = [
  {
    "feature": "Offering",
    "competitor": "Nima trust and safety platform (workflow, rule engine, queues, reporting) plus advisory services",
    "openmod": "AI comment moderation adapted to your rules and use cases, set up with you by the Logora team"
  },
  {
    "feature": "Built for",
    "competitor": "Online platforms and services: marketplaces, games, social and creator platforms",
    "openmod": "News sites, brands and public bodies"
  },
  {
    "feature": "Integrations",
    "competitor": "A single API endpoint, described as an extension of your backend; integrations with the DSA Transparency Database and NCMEC. No Facebook, Instagram, YouTube or WordPress connector mentioned",
    "openmod": "Website, Facebook, Instagram, YouTube and WordPress natively; TikTok, X, LinkedIn and other networks added on request, quickly"
  },
  {
    "feature": "Automation and human review",
    "competitor": "Automated and manual processing, specialised moderator queues, strike system, flags management and a real-time dashboard",
    "openmod": "Clear violations hidden automatically, legitimate criticism kept visible, doubtful cases handled by our team, every decision visible in real time; a written reason for every decision and a full activity log"
  },
  {
    "feature": "DSA",
    "competitor": "User reporting, appeals, customisable statements for the DSA and the UK Online Safety Act, trusted flagger reporting, transparency reporting, EU Transparency Database",
    "openmod": "Building blocks for notice and action, statement of reasons, human review of contested decisions and exportable figures"
  },
  {
    "feature": "AI models",
    "competitor": "Gives access to third-party detection tools (its site lists Bodyguard, Utopia Analytics, Sightengine and Amazon Rekognition, among others); an own model is not specified",
    "openmod": "Own moderation AI, cross-checked by other AI models; new models plugged in as they come out"
  },
  {
    "feature": "Pricing",
    "competitor": "Not published",
    "openmod": "Public: free up to 1,000 requests/month, Pro €99/month for 10,000 requests, Enterprise on request"
  },
  {
    "feature": "Hosting and security",
    "competitor": "Can be deployed in your own cloud (Bring Your Own Cloud); SOC 2, audit logs",
    "openmod": "Hosted in the EU, GDPR; on-premise deployment on request"
  },
  {
    "feature": "References",
    "competitor": "Logos include Eventbrite, Ko-fi, Pinterest, Bluesky and AliExpress",
    "openmod": "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora"
  }
];

const faqItems = [
  {
    "question": "What is the best Tremau alternative?",
    "answer": "For the comments of a news site, a brand or a public body, OpenModeration is a direct alternative: its own moderation AI, connectors for your website (API), Facebook Pages, Instagram, YouTube and WordPress, a written reason for every decision, DSA building blocks and public pricing. For a platform that wants to orchestrate several detection vendors in its own cloud, Tremau's Nima is designed for that."
  },
  {
    "question": "How much does Tremau cost?",
    "answer": "Tremau does not publish the price of Nima on its website; you have to contact the company. OpenModeration is free up to 1,000 requests per month, Pro costs €99 per month for 10,000 requests, and Enterprise is on request."
  },
  {
    "question": "Tremau vs OpenModeration: what is the main difference?",
    "answer": "Tremau's Nima is a trust and safety workflow platform that connects detection tools from other vendors. OpenModeration is a comment moderation service with its own AI: it hides clear violations, keeps legitimate criticism visible and sends doubtful cases to human review in one console, set up with you by our team."
  },
  {
    "question": "Does OpenModeration cover the DSA like Tremau?",
    "answer": "OpenModeration provides building blocks for notice and action, a statement of reasons for each decision, human review of contested decisions, a full activity log and exportable figures. Data is hosted in the EU and processed in line with the GDPR."
  },
  {
    "question": "Can I test OpenModeration without switching off my current tool?",
    "answer": "Yes. In sandbox mode, OpenModeration analyses your real comments without hiding anything. Your current tool keeps running and you compare the decisions comment by comment."
  },
  {
    "question": "Can OpenModeration run on our own infrastructure?",
    "answer": "On-premise deployment is available on request. By default, OpenModeration is hosted in the European Union."
  }
];
---

<BaseLayout title="Tremau Alternative: Comparison with OpenModeration" description="Tremau (Nima) or OpenModeration? A sourced comparison for news sites, brands and public bodies: offer, connectors, AI models, DSA, pricing and hosting." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "Tremau" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparison
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Tremau alternative: how OpenModeration compares</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        The best Tremau alternative for a news site, a brand or a public body that moderates comments is a tool that brings its own AI and connects directly to your website and social pages: that is what OpenModeration does, with public prices. Tremau's Nima is built for online platforms that want to orchestrate several detection tools in one trust and safety workflow.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900">Who Tremau is for</h2>
      <p class="mt-4 text-surface-600">Tremau launched in 2021, according to its website, and is headquartered in Paris, according to its investor G+D Ventures. It sells Nima, which its site describes as "the AI-driven Trust & Safety platform to protect users with efficient automated and human moderation", along with advisory services in trust and safety, tech policy and risk management.</p>
      <p class="mt-4 text-surface-600">Nima centralises signals and detection sources, with a rule engine, specialised moderator queues, a strike system, user reporting, appeals, trusted flagger reporting, transparency reporting and an integration with the EU DSA Transparency Database. It gives access to third-party detection tools and can be deployed in the client's own cloud. Logos shown include Eventbrite, Ko-fi, Pinterest, Bluesky and AliExpress.</p>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Tremau and OpenModeration, side by side</h2>
      <p class="mt-4 text-surface-500">Information about Tremau taken from its website (tremau.com), consulted on October 30, 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Tremau</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.competitor}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Choose OpenModeration if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>you moderate comments and want the AI included, rather than a workflow to connect to separate detection vendors;</li>
          <li>you want ready connectors for your website (API), Facebook Pages, Instagram, YouTube and WordPress;</li>
          <li>you want a team that sets the moderation up with you, on your rules and your use cases;</li>
          <li>you want public prices, starting free;</li>
          <li>you need a written reason for every decision, a full activity log and DSA building blocks without a large trust and safety team.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Tremau may suit you better if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>you run a platform with a dedicated trust and safety team and want to orchestrate several detection vendors in one workflow;</li>
          <li>you need trusted flagger handling, a strike system and transparency reports at platform scale;</li>
          <li>you want the tool deployed in your own cloud, or advisory on DSA and Online Safety Act compliance.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900">The AI engine: following the progress of AI models</h2>
      <p class="mt-4 text-surface-600">Tremau's Nima orchestrates detection tools from other vendors that you select and connect. OpenModeration runs its own moderation AI, and its decisions on delicate cases are cross-checked by other AI models. The engine is model-agnostic: when a better or cheaper AI model comes out, our team plugs it in quickly, with nothing to change on your side. Your moderation follows the progress of the AI market instead of staying frozen on one in-house algorithm.</p>
      <h2 class="mt-16 text-3xl font-bold tracking-tight text-surface-900">Pricing: Tremau vs OpenModeration</h2>
      <p class="mt-4 text-surface-600">Tremau does not publish its prices on its website. OpenModeration's prices are public: free up to 1,000 requests per month, Pro at €99 per month for 10,000 requests, Enterprise on request, with on-premise deployment available on request. <a href="/pricing" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration pricing &rarr;</a></p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Switching from Tremau to OpenModeration in 3 steps</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">1</span>
          <h3 class="mt-1 font-semibold text-surface-900">Connect your sources and share your rules</h3>
          <p class="mt-2 text-sm text-surface-600">Connect your website through the API, your Facebook Pages, Instagram professional accounts, YouTube channels or WordPress. Our team adapts the moderation with you to your rules and your use cases.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">2</span>
          <h3 class="mt-1 font-semibold text-surface-900">Test in sandbox mode on real comments</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration analyses your real comments without hiding anything. Tremau keeps running while you compare the decisions, each with its written reason.</p>
        </li>
        <li class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <span class="text-sm font-semibold text-brand-600">3</span>
          <h3 class="mt-1 font-semibold text-surface-900">Switch on automatic moderation</h3>
          <p class="mt-2 text-sm text-surface-600">Clear violations are hidden automatically, doubtful cases are handled by our team, you see every decision in real time in the console, and the activity log and exportable figures are ready for the DSA.</p>
        </li>
      </ol>
      <p class="mt-8 text-surface-600">Want to see it on your own comments first? <a href="/book-a-call" class="font-medium text-brand-600 hover:text-brand-500">Book a call with our team &rarr;</a></p>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Frequently asked questions" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Tremau is a trademark of its owner. Information about it comes from its own website (consulted on October 30, 2026); unknown points are marked as not specified. Spotted a mistake? Write to us at <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-surface-400">
        Sources: <a href="https://tremau.com/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">tremau.com</a> · <a href="https://tremau.com/platform/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">tremau.com/platform</a> · <a href="https://tremau.com/about-us/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">tremau.com/about-us</a> · <a href="https://www.gi-de.com/en/ventures/tremau" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">www.gi-de.com/en/ventures/tremau</a>
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Further reading</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/book-a-call" class="font-medium text-brand-600 hover:text-brand-500">Book a call with the OpenModeration team &rarr;</a></li>
        <li><a href="/moderation-software" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration moderation software &rarr;</a></li>
        <li><a href="/blog/comment-moderation-guide" class="font-medium text-brand-600 hover:text-brand-500">Comment moderation: the complete guide &rarr;</a></li>
        <li><a href="/blog/dsa-compliance-sme-guide" class="font-medium text-brand-600 hover:text-brand-500">DSA compliance guide for SMEs &rarr;</a></li>
        <li><a href="/alternatives" class="font-medium text-brand-600 hover:text-brand-500">All comparisons &rarr;</a></li>
        <li><a href="/pricing" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration pricing &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Comment moderation with the AI included." subtitle="Connect your website and social pages, run the sandbox on real comments and read the reason behind every decision. Free to start." />
</BaseLayout>
