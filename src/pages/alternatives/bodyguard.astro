---
import { bookingUrl } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedComparisons from '../../components/RelatedComparisons.astro';
import SwitchProvider from '../../components/SwitchProvider.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/alternatives/bodyguard",
  "name": "Bodyguard alternative: how OpenModeration compares",
  "description": "Bodyguard or OpenModeration? A sourced comparison of the two moderation tools: networks covered, pricing, data hosting, DSA compliance and a written reason for every decision.",
  "inLanguage": "en",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Offering", bodyguard: "A moderation API for platforms and a social media moderation offering for brands, agencies and public organisations", openmod: "A single platform: social media and WordPress connectors, plus a REST API and webhooks for everything else" },
  { feature: "Social networks covered", bodyguard: "Facebook, Instagram, TikTok, X, LinkedIn, YouTube, Twitch, Discord", openmod: "Website, Facebook, Instagram, YouTube and WordPress natively; TikTok, X, LinkedIn and other networks added on request, quickly; everything else through the API" },
  { feature: "Pricing", bodyguard: "Guardian from €1,000 per month, Sentinel from €3,000 per month, Commander on quote; price depends on audience size", openmod: "Free up to 1,000 comments analysed per month, Pro at €99 per month for 10,000 comments, or a plan sized to your volumes (setup and our team included)" },
  { feature: "Data hosting", bodyguard: "Not specified on the homepage", openmod: "Built and hosted in the European Union" },
  { feature: "AI models", bodyguard: "Technology developed by Bodyguard", openmod: "Its own moderation AI, cross-checked by other AI models on delicate cases; new models plugged in as they come out" },
  { feature: "Written reason for every decision", bodyguard: "Not mentioned", openmod: "Yes, for every decision, in the language of your choice" },
  { feature: "DSA", bodyguard: "Not mentioned on the homepage", openmod: "Audit trail of every decision, automated or human" },
  { feature: "Stated compliance", bodyguard: "GDPR, SOC 2 Type 2", openmod: "GDPR; full audit trail of every decision" },
  { feature: "Languages", bodyguard: "46 languages claimed", openmod: "Comments are analysed in their own language, with no list to maintain per language" },
];

const faqItems = [
  {
    question: "What is the best alternative to Bodyguard?",
    answer: "It depends on what you need. If you want a free plan to start, data hosted in the EU and a written reason for every hidden comment, OpenModeration meets those criteria. If you need SOC 2 Type 2 certification or native Twitch and Discord moderation today, Bodyguard is an option.",
  },
  {
    question: "How much does Bodyguard cost compared with OpenModeration?",
    answer: "On its pricing page, Bodyguard lists a Guardian plan from €1,000 per month and a Sentinel plan from €3,000 per month, priced by audience size. OpenModeration offers a free plan up to 1,000 comments analysed per month, a Pro plan at €99 per month for 10,000 comments, or a plan sized to your volumes, with setup and our team included.",
  },
  {
    question: "Is OpenModeration DSA compliant?",
    answer: "OpenModeration writes a reason for every decision and keeps an audit trail of all decisions, whether they are made by the AI or by a moderator. Both feed directly into the statement of reasons required by Article 17 of the DSA.",
  },
  {
    question: "Can I switch from Bodyguard to OpenModeration without starting over?",
    answer: "On Facebook, Instagram, YouTube and WordPress, you simply connect your accounts and write your rules in plain language, with no code. For an in-house platform, the OpenModeration REST API replaces the call to your previous API.",
  },
];
---

<BaseLayout title="Bodyguard Alternative: OpenModeration Compared (2026)" description="Bodyguard or OpenModeration? A sourced comparison: networks covered, pricing, EU hosting, DSA and a written reason for every decision." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "Bodyguard" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparison
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Bodyguard alternative: how OpenModeration compares</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bodyguard is a well-known French AI moderation company. OpenModeration makes different choices: a free plan then Pro at €99 per month, data hosted in the EU and a written reason for every decision. Here are the differences, with sources, so you can choose with full knowledge.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/book-a-call" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Book a call</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Try it free</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Choose OpenModeration if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>you want to start for free, then pay less than €100 a month;</li>
          <li>you want a full audit trail of every moderation decision;</li>
          <li>your data has to stay in the European Union;</li>
          <li>you need to explain every comment removal, as the DSA requires;</li>
          <li>you want to choose, or switch, the AI models that judge your content.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Bodyguard may suit you better if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>your procurement team requires SOC 2 Type 2 certification;</li>
          <li>you need native Twitch or Discord moderation today.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Bodyguard and OpenModeration, side by side</h2>
      <p class="mt-4 text-surface-500">Information about Bodyguard taken from its website, bodyguard.ai, consulted on October 20, 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Bodyguard</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.bodyguard}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">What actually changes day to day</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">You know why a comment was hidden</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration attaches a written reason to every decision, visible to your team and returned by the API. You can answer a reader who disagrees, and the DSA requires you to explain every removal anyway.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Your rules, written the way you think</h3>
          <p class="mt-2 text-sm text-surface-600">You write your moderation policy in plain language, add banned words and set a threshold for each category. Borderline cases land in a grey zone that our team settles, and you see every decision in real time and can override it.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">A much lower entry price</h3>
          <p class="mt-2 text-sm text-surface-600">Bodyguard starts at €1,000 per month. OpenModeration is free up to 1,000 comments analysed a month and Pro costs €99 a month. On-premise deployment is possible on request: <a href={bookingUrl('en')} class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">let's talk</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">No lock-in to a single model</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration runs its own moderation AI, and delicate cases are cross-checked by other AI models. When a better or cheaper model comes out, we plug it in quickly: nothing changes on your side.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Frequently asked questions" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bodyguard is a trademark of its owner. Information about it comes from <a href="https://bodyguard.ai/fr" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">bodyguard.ai</a> and its <a href="https://www.bodyguard.ai/en/social-media/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">pricing page</a> (consulted on October 20, 2026). Spotted a mistake? Write to us at <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Further reading</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/social-media-moderation" class="font-medium text-brand-600 hover:text-brand-500">Social media moderation with OpenModeration &rarr;</a></li>
        <li><a href="/dsa-compliance/statement-of-reasons" class="font-medium text-brand-600 hover:text-brand-500">The statement of reasons required by the DSA &rarr;</a></li>
        <li><a href="/alternatives" class="font-medium text-brand-600 hover:text-brand-500">All comparisons &rarr;</a></li>
        <li><a href="/pricing" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration pricing &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Try the transparent alternative to Bodyguard." subtitle="Connect your pages, write your rules and see the written reason behind every hidden comment. Free to start." />
</BaseLayout>
