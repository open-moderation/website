---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FAQ from '../../components/FAQ.astro';

const migrationCode = `# Azure Content Safety (direct)
const endpoint = "https://<resource>.cognitiveservices.azure.com/";
const res = await fetch(endpoint + "/contentsafety/text:analyze?api-version=2024-02-01", {
  method: 'POST',
  headers: { 'Ocp-Apim-Subscription-Key': '...' },
  body: JSON.stringify({ text, categories: ['Hate','SelfHarm','Sexual','Violence'] })
});
// Result: Azure-specific format, 4 categories, per-region deployment

# OpenModeration (unified)
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({
    input: text,
    categories: ['hate', 'harassment', 'sexual', 'violence', 'self-harm', 'spam'],
    threshold: 0.5
  })
});
// Plus: pre-filter, dual threshold, auto-actions, audit trail, team dashboard`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Azure Moderation API Alternative | OpenModeration",
  "description": "Compare OpenModeration and Azure Content Safety for AI moderation. Azure gives you an API tied to Microsoft. OpenModeration lets you use Azure alongside 9 other providers through one API, with a review dashboard, no-code rules and on-premise deployment for data sovereignty."
};

const faqItems = [
  {
    question: "How much does Azure Content Safety cost vs OpenModeration?",
    answer: "Azure AI Content Safety bills per 1,000 text records (one record is up to 1,000 characters) after a free tier of 5,000 records a month, at a rate that depends on your Azure region. OpenModeration is free up to 1,000 requests per month. Managed cloud starts at €99/month for 10K requests, and pre-filtering cuts 10-30% of billable calls before they reach Azure."
  },
  {
    question: "Can I keep using Azure Content Safety with OpenModeration?",
    answer: "Yes. Bring your own Azure key (BYOK) and route requests to Azure Content Safety as your primary provider. Adding OpenAI or Mistral as a fallback is a config change. You don't rewrite code or retrain anything."
  },
  {
    question: "Does OpenModeration support Azure OpenAI moderation models?",
    answer: "Yes. Both the Azure AI Content Safety endpoint and Azure OpenAI moderation models are supported as providers. Responses are standardized into one format across all 10 providers."
  },
  {
    question: "What do I gain beyond Azure's raw scores?",
    answer: "You get the rest of the workflow: a pre-filter, dual thresholds (auto-approve, human review, auto-reject), no-code rules, a moderation dashboard with team roles, and a DSA-ready audit trail with exportable reports."
  },
  {
    question: "Can my data stay in the EU instead of Microsoft's cloud?",
    answer: "Yes. OpenModeration is built and hosted in the European Union, and on-premise deployment is possible on request. Azure can stay as one of your providers."
  },
];

const comparisonPoints = [
  { feature: "Moderation Scope", azure: "Single provider (Azure only)", openmod: "Multi-provider (Azure, OpenAI, Mistral, LLMs) + unified dashboard" },
  { feature: "Operational Interface", azure: "API only. Requires building your own review UI", openmod: "Complete Trust & Safety dashboard with manual review queue included" },
  { feature: "Rule Engine", azure: "Custom logic must be built and maintained in-house", openmod: "Three built-in layers: word filters, score thresholds, and your own rules in plain language" },
  { feature: "Vendor Lock-in", azure: "High (tied to Microsoft ecosystem)", openmod: "Zero (Bring Your Own Keys, switch providers instantly)" },
  { feature: "Data Sovereignty", azure: "Data processed on Microsoft infrastructure", openmod: "Built and hosted in the EU for GDPR/DSA compliance; on-premise deployment possible on request" },
  { feature: "Pricing Model", azure: "Per-request API billing", openmod: "Public pricing: free up to 1,000 requests per month, Pro at €99 per month" }
];
---

<BaseLayout 
  title="Azure Moderation API Alternative: Pricing & Comparison"
  description="Azure Content Safety is tied to Microsoft. OpenModeration puts Azure and 9 other providers behind one API, with rules, human review and DSA audit trails."
  canonical="https://www.openmoderation.com/alternatives/azure-content-safety" 
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "Azure Content Safety Alternative" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Azure Moderation API Alternative</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Azure Content Safety is one API.<br/>OpenModeration is the platform.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Azure Content Safety gives you good moderation APIs, but turning them into a working moderation workflow takes real engineering time. OpenModeration gives you the API <strong>and</strong> the review queue, rules and logs around it.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Try OpenModeration free</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">See full comparison</a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Migrate from Azure in under an hour</h2>
          <p class="mt-4 text-lg text-surface-500">
            Keep your Azure key (BYOK) as the primary provider. One standardized call replaces the
            Content Safety endpoint. Scores come back in one format, with thresholds you control.
          </p>
          <ul class="mt-6 space-y-3">
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Keep Azure</strong> as primary provider, add OpenAI or Mistral as fallback when Azure is slow or down.</p>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Pre-filter</strong> blocks obvious spam before any billable Azure call, which saves 10-30% on API costs.</p>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>EU hosting</strong> by default, with on-premise deployment possible on request: <a href="https://calendly.com/jesuslogora/1h" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">let's talk</a>. Azure stays available as one provider.</p>
            </li>
          </ul>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-4xl">
        <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Head-to-Head Comparison</h2>
        <div class="mt-8 overflow-hidden rounded-xl border border-surface-200">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="bg-surface-50">
                <th class="px-6 py-4 font-semibold text-surface-900">Feature</th>
                <th class="px-6 py-4 font-semibold text-surface-500">Azure Content Safety</th>
                <th class="px-6 py-4 font-semibold text-brand-700">OpenModeration</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200 bg-white">
              {comparisonPoints.map((row) => (
                <tr>
                  <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                  <td class="px-6 py-4 text-surface-600">{row.azure}</td>
                  <td class="px-6 py-4 font-medium text-accent-600">{row.openmod}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8">
          <h3 class="text-xl font-bold text-surface-900">The hidden cost of "API-only" moderation</h3>
          <p class="mt-4 text-surface-600">
            Calling Azure Content Safety is the easy part. Before moderators can use it, your engineers still have to build:
          </p>
          <ul class="mt-4 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> A dashboard for human moderators to review edge cases</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> A rule engine to translate AI scores into automated actions (hide, delete, flag)</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Audit logging systems to prove DSA compliance to regulators</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Fallback logic in case Azure APIs experience downtime</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="text-xl font-bold text-brand-700">The OpenModeration advantage</h3>
          <p class="mt-4 text-surface-700">
            OpenModeration can use Azure Content Safety as one of its providers and adds what your team needs around it:
          </p>
          <ul class="mt-4 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> A dashboard where your Trust & Safety team can start reviewing comments on day one.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> Rules set with three tools (forbidden words, category thresholds and your own rules in plain language), with no code.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> Automatic fallback to OpenAI or Mistral when Azure is slow or fails.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> An audit trail that logs every AI and human decision.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Azure Content Safety alternative: FAQ" />
    </div>
  </section>

  <CTASection 
    title="Stop building internal moderation tools."
    subtitle="Use Azure inside a moderation platform that already has automated rules and a human review dashboard."
    buttonText="Try it for free"
    buttonHref="https://app.openmoderation.com/signup"
  />

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Compare other providers</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/alternatives/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/alternatives/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/text-moderation-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Text Moderation API</a>
        <a href="/alternatives/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/alternatives/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/alternatives/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>
</BaseLayout>
