---
import { bookingUrl } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedComparisons from '../../components/RelatedComparisons.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/alternatives/arwen",
  "name": "Arwen alternative: how OpenModeration compares",
  "description": "Arwen or OpenModeration? A sourced comparison of the two social comment moderation tools: networks covered, public pricing, website comments, EU hosting and a written reason for every decision.",
  "inLanguage": "en",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Offering", them: "AI social comment moderation for brands, sports and media (Signals, Engage, Moderate, Protect), plus a Managed Service and a Community Management package", openmod: "Automated AI comment moderation, adapted by our team to your rules and use cases, with doubtful cases handled by our team" },
  { feature: "Social networks covered", them: "Facebook, Instagram, X, TikTok, YouTube; Reddit \"coming soon\"; Meta and TikTok ads", openmod: "Website, Facebook, Instagram, YouTube and WordPress natively; TikTok, X, LinkedIn and other networks added on request, quickly" },
  { feature: "Website comments", them: "Not stated on its site", openmod: "WordPress connector, plus a REST API and webhooks" },
  { feature: "Pricing", them: "Not shown; based on followers, profiles and ads, demo required", openmod: "Free up to 1,000 comments analysed per month, Pro at €99 per month for 10,000 comments, or a plan sized to your volumes (setup and our team included)" },
  { feature: "Human involvement", them: "\"Human-in-the-loop\"; optional managed service", openmod: "Grey zone, user reports and contested decisions handled by our team; you see everything in real time and can step in" },
  { feature: "Written reason for every decision", them: "Not stated on its site", openmod: "Yes, in the language of your choice, returned by the API" },
  { feature: "DSA", them: "Not stated on its site", openmod: "Activity log showing whether each decision was automatic or which moderator made it" },
  { feature: "Certifications", them: "Cyber Essentials and ISO 27001", openmod: "No ISO 27001; GDPR, with a full audit trail of every decision" },
  { feature: "Data hosting", them: "Not stated on its homepage (company based in the United Kingdom)", openmod: "Built and hosted in the European Union" },
];

const faqItems = [
  {
    question: "What is the best alternative to Arwen?",
    answer: "It depends on your channels. If you need ads moderation or a community management package, Arwen offers them and OpenModeration does not. If you moderate Facebook, Instagram, YouTube and your own website, want public prices and need a written reason for every decision, OpenModeration fits.",
  },
  {
    question: "How much does Arwen cost?",
    answer: "Arwen does not publish its prices. Its site says pricing depends on followers, profiles and ads, and asks for a demo. OpenModeration is free up to 1,000 comments analysed per month, then €99 per month for 10,000 comments on Pro, or a plan sized to your volumes (setup and our team included).",
  },
  {
    question: "Can I test OpenModeration without stopping Arwen?",
    answer: "Yes. Sandbox mode analyses your real comments without hiding anything, so you can run both tools on the same Pages and compare their decisions.",
  },
  {
    question: "Does OpenModeration work for sports clubs and media brands?",
    answer: "Yes. The AI reads each comment with the post title and the thread, which matters on match days and breaking news. Sports and news publishers such as L'Équipe use it on their comments.",
  },
];
---

<BaseLayout title="Arwen Alternative: OpenModeration Compared (2026)" description="Arwen or OpenModeration? Sourced comparison: networks covered, public pricing, website comments, EU hosting and a written reason for every decision." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "Arwen" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparison
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Arwen alternative: how OpenModeration compares</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Arwen, a UK company, moderates social media comments for brands, sports organisations and media, and offers a managed service on top. OpenModeration includes setup with you and the handling of doubtful cases by our team, with public prices, data hosted in the EU and a written reason for every decision. Here are the differences, with sources.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/book-a-call" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Book a call</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Try it free</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Choose OpenModeration if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>you want to test for free on your own comments before committing;</li>
          <li>you also moderate comments on your website or WordPress;</li>
          <li>you need a written reason for every hidden comment, as the DSA requires;</li>
          <li>your data has to stay in the European Union.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Arwen may suit you better if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>you need comments on paid ads moderated;</li>
          <li>you want a community management package on top of moderation;</li>
          <li>your procurement team requires ISO 27001 or Cyber Essentials.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Arwen and OpenModeration, side by side</h2>
      <p class="mt-4 text-surface-500">Information about Arwen taken from its website, arwen.ai, consulted on October 20, 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Arwen</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.them}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">What actually changes day to day</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">A budget you can plan</h3>
          <p class="mt-2 text-sm text-surface-600">Prices are on the website and do not depend on your follower count. You start free with 1,000 comments analysed a month; Pro costs €99 a month for 10,000.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">You know why a comment was hidden</h3>
          <p class="mt-2 text-sm text-surface-600">Every decision comes with a written reason, visible to your team and returned by the API. The activity log shows whether the AI or a named moderator made the call, which is the record the DSA asks for.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Your website alongside your Pages</h3>
          <p class="mt-2 text-sm text-surface-600">WordPress comments sit next to Facebook, Instagram and YouTube in one dashboard, under the same rules. Other comment systems connect through the REST API.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Your data stays in the EU</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration is built and hosted in the European Union, and you can export your data at any time. On-premise deployment is possible on request: <a href={bookingUrl('en')} class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">let's talk</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Frequently asked questions" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Arwen is a trademark of its owner. Information about it comes from <a href="https://arwen.ai" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">arwen.ai</a> (consulted on October 20, 2026). Spotted a mistake? Write to us at <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Further reading</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/social-media-moderation" class="font-medium text-brand-600 hover:text-brand-500">Social media moderation with OpenModeration &rarr;</a></li>
        <li><a href="/integrations/facebook" class="font-medium text-brand-600 hover:text-brand-500">Facebook comment moderation &rarr;</a></li>
        <li><a href="/dsa-compliance/statement-of-reasons" class="font-medium text-brand-600 hover:text-brand-500">The statement of reasons required by the DSA &rarr;</a></li>
        <li><a href="/pricing" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration pricing &rarr;</a></li>
        <li><a href="/alternatives" class="font-medium text-brand-600 hover:text-brand-500">All comparisons &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Moderate your social comments with prices on the page." subtitle="Connect Facebook, Instagram, YouTube and WordPress, write your rules in plain language and start on the free plan." />
</BaseLayout>
