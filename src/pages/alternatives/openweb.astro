---
import { bookingUrl } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedComparisons from '../../components/RelatedComparisons.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/alternatives/openweb",
  "name": "OpenWeb alternative: how OpenModeration compares",
  "description": "OpenWeb or OpenModeration? A sourced comparison: business model, pricing, data hosting, social networks and a written reason for every moderation decision.",
  "inLanguage": "en",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "What it is", openweb: "A hosted community platform for publishers: comments, plus forums", openmod: "A moderation layer: it decides on comments where they already live and does not display them" },
  { feature: "Business model", openweb: "A monetization and advertising business alongside the community tools", openmod: "A software subscription. No advertising attached to your readers' comments" },
  { feature: "Where it moderates", openweb: "The publisher's own site. Social networks: not stated", openmod: "Website, Facebook, Instagram, YouTube and WordPress natively; TikTok, X, LinkedIn and other networks added on request, quickly; REST API and webhooks for the rest" },
  { feature: "Pricing", openweb: "Not stated (\"Let's Talk\")", openmod: "Public: free up to 1,000 requests per month, Pro at €99 per month for 10,000, custom plans for large volumes" },
  { feature: "Data hosting and GDPR", openweb: "Not stated on its site", openmod: "Built and hosted in the European Union, GDPR" },
  { feature: "Moderation", openweb: "AI moderation branded \"Aida\". Human moderation: not stated", openmod: "Rules written in plain language, a threshold per category, a grey zone handled by our team" },
  { feature: "Written reason for every decision", openweb: "Not stated", openmod: "Yes, in the language of your choice, returned by the API" },
  { feature: "DSA", openweb: "Not stated", openmod: "Activity log showing whether each decision was automatic or by which moderator" },
  { feature: "References", openweb: "Logo bar includes CNN, Yahoo!, Forbes, WSJ, The Times, HuffPost. Claims 5,000+ publishers", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier" },
];

const faqItems = [
  {
    question: "What is the best alternative to OpenWeb?",
    answer: "It depends on what you need. If you want a hosted comments and forums product whose cost is covered by an advertising model, OpenWeb is built that way. If you want to keep your own comment system, moderate your social pages with the same rules, pay a public subscription and get a written reason for every decision, OpenModeration fits that brief.",
  },
  {
    question: "How much does OpenWeb cost compared with OpenModeration?",
    answer: "OpenWeb does not publish prices on its site and invites publishers to get in touch. OpenModeration publishes its prices: free up to 1,000 requests per month, Pro at €99 per month for 10,000 requests, and custom plans for large volumes.",
  },
  {
    question: "Can I test OpenModeration without removing OpenWeb?",
    answer: "Yes. In sandbox mode, OpenModeration analyses real comments without applying any action. You send a sample of your comments to the API and compare its decisions with your current moderation, comment by comment, before changing anything.",
  },
  {
    question: "Where is OpenWeb data hosted?",
    answer: "OpenWeb's site does not state where data is hosted, and we found no GDPR statement on it. Ask the vendor directly if this matters to your legal team. OpenModeration is built and hosted in the European Union, and on-premise deployment is possible on request.",
  },
  {
    question: "Does OpenModeration help with the DSA?",
    answer: "OpenModeration writes a reason for every decision and keeps an activity log showing whether each decision was automatic or made by a named moderator. Both feed the statement of reasons required by Article 17 of the DSA for publishers operating in the EU.",
  },
];
---

<BaseLayout title="OpenWeb Alternative: OpenModeration Compared (2026)" description="OpenWeb or OpenModeration? A sourced comparison: business model, public pricing, EU hosting, social networks and DSA." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "OpenWeb" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparison
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">OpenWeb alternative: how OpenModeration compares</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        OpenWeb runs comments and forums for large publishers, with AI moderation and an advertising business attached. OpenModeration does one job: it moderates comments on your site and on your social pages, for a public subscription price. Here are the differences, with sources.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Choose OpenModeration if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>you want to keep your own comment system and add moderation to it;</li>
          <li>you prefer a subscription with a public price to a model tied to advertising;</li>
          <li>your data has to stay in the European Union;</li>
          <li>you also moderate Facebook, Instagram or YouTube comments;</li>
          <li>you need a written reason for every hidden comment, as the DSA requires.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">OpenWeb may suit you better if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>you want a complete hosted comments and forums product on your site;</li>
          <li>you want the tool to generate advertising revenue rather than cost a subscription;</li>
          <li>you want a vendor whose logo bar includes large US publishers such as CNN and Yahoo!.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">OpenWeb and OpenModeration, side by side</h2>
      <p class="mt-4 text-surface-500">Information about OpenWeb taken from its website, openweb.com, consulted on October 20, 2026. Forums launch reported by Axios on September 30, 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">OpenWeb</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.openweb}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">What actually changes day to day</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">A price you know in advance</h3>
          <p class="mt-2 text-sm text-surface-600">Pricing is public and you can start for free. You pay for moderation, and your readers' comments are not tied to an advertising product.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Data in the EU, a full audit trail</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration is built and hosted in the European Union. Every decision is logged with its reason, and you can export your data at any time. On-premise deployment is possible on request: <a href={bookingUrl('en')} class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">let's talk</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">A reason for every hidden comment</h3>
          <p class="mt-2 text-sm text-surface-600">The AI reads each comment with the article title and the thread, then decides according to your rules. Every decision carries a written reason, and the activity log shows who decided: the AI or a named moderator.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">A side-by-side test before any switch</h3>
          <p class="mt-2 text-sm text-surface-600">Sandbox mode analyses real comments without hiding anything. You compare its decisions with your current moderation, then decide.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Frequently asked questions" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        OpenWeb is a trademark of its owner. Information about it comes from <a href="https://www.openweb.com" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">openweb.com</a> (consulted on October 20, 2026) and, for forums, from <a href="https://axios.com/2026/09/30/openweb-forums-publishers-reddit" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">Axios</a>. Spotted a mistake? Write to us at <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Further reading</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/use-cases/news-publishers" class="font-medium text-brand-600 hover:text-brand-500">Comment moderation for news publishers &rarr;</a></li>
        <li><a href="/social-media-moderation" class="font-medium text-brand-600 hover:text-brand-500">Social media moderation with OpenModeration &rarr;</a></li>
        <li><a href="/dsa-compliance/statement-of-reasons" class="font-medium text-brand-600 hover:text-brand-500">The statement of reasons required by the DSA &rarr;</a></li>
        <li><a href="/alternatives" class="font-medium text-brand-600 hover:text-brand-500">All comparisons &rarr;</a></li>
        <li><a href="/pricing" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration pricing &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Moderate your readers' comments for a public price." subtitle="Connect your site and your social pages, write your rules in plain language and read the reason behind every decision. Free to start." />
</BaseLayout>
