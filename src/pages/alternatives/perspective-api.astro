---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedComparisons from '../../components/RelatedComparisons.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const migrationCode = `# Before: Perspective API
const result = await fetch('https://commentanalyzer.googleapis.com/v1alpha1/comments:analyze', ...)

# After: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
})`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Perspective API Alternative: Sunset 2026 Migration | OpenModeration",
  "description": "Google Perspective API is sunsetting in late 2026. Migrate to OpenModeration, the moderation platform whose AI keeps up with the market.",
  "about": {
    "@type": "SoftwareApplication",
    "name": "OpenModeration",
    "applicationCategory": "ContentModeration",
    "operatingSystem": "Cross-platform"
  }
};
---

<BaseLayout title="Perspective API Alternatives: Migrate Before the 2026 Shutdown" description="Google's Perspective API shuts down in 2026. Move your toxicity scoring to OpenModeration and add your own rules, human review and a DSA audit trail." {jsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "Perspective API Alternative" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-4 py-1.5 text-sm font-medium text-red-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Perspective API sunsetting late 2026
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Google Perspective API shuts down in 2026. OpenModeration is the alternative.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Google has announced the end of Perspective API for late 2026, and thousands of forums and communities need a replacement.
        OpenModeration is an alternative you can plug in without tying yourself to one vendor.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">What the shutdown means</h2>
          <p class="mt-4 text-lg text-surface-500">
            Perspective API scored toxicity for thousands of publishers, forums and news comment sections.
            Google ends it in late 2026, so every platform that uses it has to find a replacement.
          </p>
          <div class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">Forums relying on Perspective need to migrate</h3>
                <p class="mt-1 text-sm text-surface-500">Perspective API calls stop working after 2026. If nothing replaces them, your moderation pipeline stops too.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-surface-900">DSA compliance adds urgency</h3>
                <p class="mt-1 text-sm text-surface-500">The EU Digital Services Act requires you to explain every moderation decision and handle complaints. Waiting until the last months of 2026 is a risk.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h4 class="mb-2 text-sm font-semibold text-surface-900">Quick migration: before & after</h4>
          <CodeBlock code={migrationCode} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">How OpenModeration can replace Perspective API</h2>
        <p class="mt-4 text-lg text-surface-500">One API, backed by our own moderation AI, cross-checked by other models. Nothing changes in your integration when the AI improves.</p>
      </div>
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Our own moderation AI</h3>
          <p class="mt-2 text-sm text-surface-500">Trained for comment moderation and set up on your rules and your use cases: hate, harassment, self-harm, sexual content, violence, spam.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-100 text-accent-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Cross-checked by other AIs</h3>
          <p class="mt-2 text-sm text-surface-500">On delicate cases, other AI models arbitrate the decision before it is applied. Doubtful cases are handled by our team.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-100 text-purple-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">Your own categories</h3>
          <p class="mt-2 text-sm text-surface-500">Describe your own moderation categories in plain language and set the thresholds you want.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-100 text-cyan-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          </div>
          <h3 class="mt-4 font-semibold text-surface-900">An AI that keeps improving</h3>
          <p class="mt-2 text-sm text-surface-500">You call the same POST /v1/moderation endpoint. When a better or cheaper model comes out, we plug it in, with no code change on your side.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perspective API vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">How the two compare on the features teams ask about most.</p>
      </div>
      <div class="overflow-hidden rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Feature</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Perspective API</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Pricing</td>
              <td class="px-6 py-4 text-surface-500">Free, with request quotas</td>
              <td class="px-6 py-4 text-surface-900">Free up to 1,000 requests a month, then paid plans</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Languages</td>
              <td class="px-6 py-4 text-surface-500">~20 languages with varying accuracy</td>
              <td class="px-6 py-4 text-surface-900">Main European languages and English</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Moderation categories</td>
              <td class="px-6 py-4 text-surface-500">9 fixed categories</td>
              <td class="px-6 py-4 text-surface-900">10 categories, fully customizable</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Vendor lock-in</td>
              <td class="px-6 py-4 text-surface-500">High (depends on Google)</td>
              <td class="px-6 py-4 text-surface-900">Low (model-agnostic engine, data export at any time)</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">DSA audit trail</td>
              <td class="px-6 py-4 text-surface-500">Not available</td>
              <td class="px-6 py-4 text-surface-900">Built-in logging and export</td>
            </tr>
            <tr class="even:bg-surface-50">
              <td class="px-6 py-4 font-medium text-surface-900">Status</td>
              <td class="px-6 py-4 text-surface-500">Sunsetting late 2026</td>
              <td class="px-6 py-4 text-surface-900">Actively maintained</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Migrate before the shutdown" subtitle="Move off Perspective API now and start on the free plan." buttonText="Try it for free" buttonHref="https://app.openmoderation.com/signup" />

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Compare other alternatives</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/alternatives/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/alternatives/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/alternatives/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/alternatives/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/alternatives/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>
</BaseLayout>