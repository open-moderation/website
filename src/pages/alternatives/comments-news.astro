---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/alternatives/comments-news",
  "name": "Comments News alternative: how OpenModeration compares",
  "description": "Comments News or OpenModeration? A comment system with built-in moderation compared with software that moderates your existing comments and social media, with a written reason for every decision.",
  "inLanguage": "en",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Type of product", commentsnews: "A comment and debate platform for news media, with built-in AI moderation", openmod: "Moderation software that works on top of your existing comment system and social media; no comment widget included" },
  { feature: "Installation", commentsnews: "One script on the website, using the publisher's own login", openmod: "Native connectors for Facebook, Instagram, YouTube and WordPress; REST API and webhooks for the rest" },
  { feature: "Social networks", commentsnews: "Not mentioned", openmod: "Facebook, Instagram and YouTube" },
  { feature: "Pricing", commentsnews: "Cabecera $49 per month (list price $99), Redacción $149 (list $299), Grupo $299 (list $599)", openmod: "Free up to 1,000 requests per month, Pro at €99 per month for 10,000, custom plans for large volumes" },
  { feature: "AI moderation", commentsnews: "Basic on the Cabecera plan; \"moderación PRO con IA\" on the Redacción and Grupo plans", openmod: "Your policy in plain language, a threshold per category and a grey zone your team reviews" },
  { feature: "Context", commentsnews: "The Redacción plan \"understands the editorial context\"; the basic plan does not", openmod: "The AI reads each comment with the headline and the discussion thread" },
  { feature: "Reason for each decision", commentsnews: "Not mentioned", openmod: "A written reason for every decision, in the language of your choice, returned by the API" },
  { feature: "DSA audit trail", commentsnews: "Not mentioned", openmod: "Activity log showing whether each decision was automatic or which moderator made it" },
  { feature: "Hosting and code", commentsnews: "Not specified", openmod: "Built and hosted in the EU; open source under AGPL v3 with self-hosting through Docker" },
  { feature: "References", commentsnews: "El Destape, El Día, El Tribuno, Tiempo de San Juan, El Deber, El Chubut, La Nueva and other media in Argentina and Bolivia", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "What is the best alternative to Comments News?",
    answer: "It depends on what you are missing. If you need a full comment system with debates and analytics, Comments News offers one and OpenModeration does not. If you already have comments (on WordPress, an in-house platform or social media) and want to moderate them with your own rules and a written reason for every decision, OpenModeration is built for that.",
  },
  {
    question: "How much does Comments News cost?",
    answer: "According to its website, the Cabecera plan costs $49 per month, Redacción $149 and Grupo $299, presented as 50% off the list price. OpenModeration is free up to 1,000 requests per month and costs €99 per month on the Pro plan, for 10,000 requests.",
  },
  {
    question: "Can I test OpenModeration without leaving Comments News?",
    answer: "OpenModeration does not replace a comment system. You can test it in sandbox mode on your Facebook, Instagram or YouTube pages, or on a WordPress site: it analyses real comments and shows what it would have decided, without hiding or deleting anything.",
  },
  {
    question: "Does OpenModeration work for publishers outside Europe?",
    answer: "Yes. OpenModeration runs as an online service from any country, understands comments in Spanish and Portuguese among other languages, and writes its reasons in the language you choose. Estadão, in Brazil, is one of our customers. Prices are billed in euros.",
  },
];
---

<BaseLayout title="Comments News Alternative: OpenModeration Compared (2026)" description="Comments News or OpenModeration? A comment system compared with software that moderates your comments and social media, with a written reason for each decision." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "Comments News" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparison
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Comments News alternative: moderate the comments you already have</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Comments News is a comment system for news media, used in Argentina and Bolivia, with AI moderation included. OpenModeration does not replace your comment system: it moderates the comments you already have, on your website and your social media, and gives a written reason for every decision. Here are the differences, with sources.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Choose OpenModeration if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>you want to keep your current comment system;</li>
          <li>you also moderate comments on Facebook, Instagram or YouTube;</li>
          <li>you want a written reason for every hidden comment;</li>
          <li>you publish in Europe and must comply with the DSA;</li>
          <li>you prefer open code that you can host yourself.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Comments News may suit you better if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>you are looking for a complete comment system, with debates and moderation included;</li>
          <li>you want to send comment events to GA4 or Marfeel;</li>
          <li>your newsroom is in Latin America and you prefer a vendor with references in the region;</li>
          <li>you prefer a flat fee per domain, paid in US dollars.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Comments News and OpenModeration, side by side</h2>
      <p class="mt-4 text-surface-500">Information about Comments News taken from its website, comments.news, consulted on October 20, 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Comments News</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.commentsnews}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">What actually changes day to day</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Your comments stay where they are</h3>
          <p class="mt-2 text-sm text-surface-600">You keep your widget and your user base. OpenModeration connects to WordPress, to your platform through the API and to your Facebook, Instagram and YouTube pages, and moderates all of them with the same rules.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Context on every plan</h3>
          <p class="mt-2 text-sm text-surface-600">The AI reads each comment with the headline and the discussion thread. That is how it tells irony from an insult, and harsh criticism from a personal attack.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">You know why each comment was hidden</h3>
          <p class="mt-2 text-sm text-surface-600">Every decision comes with a written reason, and the activity log shows whether the AI or a named moderator made it. You can answer a reader who complains, and in Europe the DSA requires you to explain every removal.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Open code</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration's code is published under the AGPL v3 licence. You can audit it, and host it on your own servers with Docker without paying for a licence.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Frequently asked questions" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Comments News is a trademark of its owner. Information about it comes from <a href="https://comments.news/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">comments.news</a> (consulted on October 20, 2026). Spotted a mistake? Write to us at <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Further reading</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/use-cases/news-publishers" class="font-medium text-brand-600 hover:text-brand-500">Comment moderation for news publishers &rarr;</a></li>
        <li><a href="/integrations/wordpress" class="font-medium text-brand-600 hover:text-brand-500">Moderating WordPress comments &rarr;</a></li>
        <li><a href="/pricing" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration pricing &rarr;</a></li>
        <li><a href="/alternatives" class="font-medium text-brand-600 hover:text-brand-500">All comparisons &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Moderate your comments without changing systems." subtitle="Connect WordPress or your social media pages, write your rules and read the reason behind every decision. Free up to 1,000 requests per month." />
</BaseLayout>
