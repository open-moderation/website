---
import { bookingUrl } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import RelatedComparisons from '../../components/RelatedComparisons.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/alternatives/digitaller",
  "name": "Digitaller alternative: how OpenModeration compares",
  "description": "Digitaller or OpenModeration? A managed moderation service compared with automated moderation backed by our team: public pricing, named connectors, a written reason for every decision and a DSA audit trail.",
  "inLanguage": "en",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Type of offering", digitaller: "Managed moderation service plus community management (an agency of Grupo Raíz Digital)", openmod: "Automated moderation: AI applies your rules, our team handles doubtful cases, you see everything in real time" },
  { feature: "How decisions are made", digitaller: "An AI semantic filter, then Digitaller's human team when needed", openmod: "The AI applies your rules with a threshold per category; the grey zone is handled by our team" },
  { feature: "Rules", digitaller: "Adapted to each client, in pre-moderation or post-moderation", openmod: "Your rules in plain language, editable at any time, with adjustments suggested from moderation decisions" },
  { feature: "Where it moderates", digitaller: "News sites, blogs, corporate websites, classifieds and \"social networks\" (not named)", openmod: "Website, Facebook, Instagram, YouTube and WordPress natively; TikTok, X, LinkedIn and other networks added on request, quickly; REST API and webhooks for the rest" },
  { feature: "Pricing", digitaller: "No pricing published", openmod: "Free up to 1,000 comments analysed per month, Pro at €99 per month for 10,000 comments, or a plan sized to your volumes (setup and our team included)" },
  { feature: "Context", digitaller: "Not specified", openmod: "The AI reads each comment with the headline and the discussion thread" },
  { feature: "Reason for each decision", digitaller: "Not mentioned", openmod: "A written reason for every decision, in the language of your choice, returned by the API" },
  { feature: "DSA audit trail", digitaller: "Not mentioned", openmod: "Activity log showing whether each decision was automatic or which moderator made it" },
  { feature: "Hosting", digitaller: "Not specified (its cookie notice cites GDPR and the Spanish LOPD)", openmod: "Built and hosted in the EU" },
  { feature: "References", digitaller: "Prensa Ibérica's regional dailies (La Nueva España, Levante, Faro de Vigo, Diario de Mallorca and others), El Español and Schibsted classifieds", openmod: "L'Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier, Egora" },
];

const faqItems = [
  {
    question: "What is the best alternative to Digitaller?",
    answer: "It depends on who you want to do the moderating. If you want human moderators reading every comment, plus community management, Digitaller offers that. If you want moderation set up with you and run on your newsroom's rules, doubtful cases handled by our team, the reason for each decision and a published price, OpenModeration is built for that.",
  },
  {
    question: "How much does Digitaller cost?",
    answer: "Digitaller does not publish prices on its website. OpenModeration publishes its own: free up to 1,000 comments analysed per month, a Pro plan at €99 per month for 10,000 comments, or a plan sized to your volumes, with setup and our team included.",
  },
  {
    question: "Can I test OpenModeration without leaving Digitaller?",
    answer: "Yes. In sandbox mode, OpenModeration analyses real comments from your website or social media pages and shows what it would have decided, without hiding or deleting anything. You compare it with your current service side by side and decide afterwards.",
  },
  {
    question: "How do regional newspapers in Spain moderate reader comments?",
    answer: "Many outsource it. Digitaller says it has moderated the leading local digital dailies in Spain for 20 years, including the Prensa Ibérica titles. The other route is AI moderation such as OpenModeration, where the AI applies the paper's policy, our team handles the doubtful cases and the newsroom sees every decision in real time.",
  },
  {
    question: "Does OpenModeration provide human moderators?",
    answer: "Our team handles what automation cannot settle: doubtful cases, user reports and contested decisions. It does not do community management. It also writes the moderation policy with you, based on your rules and real comments, and fine-tunes it over the first weeks. After that, the system learns from moderation decisions and suggests adjustments that an admin applies in one click.",
  },
];
---

<BaseLayout title="Digitaller Alternative: OpenModeration Compared (2026)" description="Digitaller or OpenModeration? A managed service compared with automated moderation backed by our team: public pricing and a written reason for every decision." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Alternatives", href: "/alternatives" }, { label: "Digitaller" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Comparison
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Digitaller alternative: comment moderation on your newsroom's rules</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Digitaller, an agency of Grupo Raíz Digital, moderates comments for many Spanish regional dailies with an AI filter and a human team. With OpenModeration, your newsroom sets the rules, the AI applies them with the context of each article, our team handles the doubtful cases and every decision comes with a written reason, visible in real time.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/book-a-call" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Book a call</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Try it free</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Choose OpenModeration if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>you want your newsroom to control the rules and change them without going through a vendor;</li>
          <li>you want to test for free on your own comments before committing;</li>
          <li>you need to explain every comment removal, as the DSA requires;</li>
          <li>you want to know which networks are covered: Facebook, Instagram, YouTube and WordPress;</li>
          <li>you want your data hosted in the European Union.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Digitaller may suit you better if…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>you want human moderators reading every single comment, rather than AI on clear cases;</li>
          <li>you are also looking for a community management service;</li>
          <li>you want a vendor that already works with many Spanish regional dailies.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Digitaller and OpenModeration, side by side</h2>
      <p class="mt-4 text-surface-500">Information about Digitaller taken from its website, raiz.es, consulted on October 20, 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterion</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Digitaller</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.digitaller}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">What actually changes day to day</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">The article's context counts</h3>
          <p class="mt-2 text-sm text-surface-600">The same comment does not weigh the same under a match report and under a crime story. OpenModeration gives the AI the headline and the discussion thread, so it catches irony and veiled attacks.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">You know why each comment was hidden</h3>
          <p class="mt-2 text-sm text-surface-600">Every decision comes with a written reason, and the activity log shows whether the AI or a named moderator made it. That is the basis of the statement of reasons the Digital Services Act asks for.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">A published price</h3>
          <p class="mt-2 text-sm text-surface-600">You start for free and know what you will pay as volume grows. If you need an on-premise deployment, it is possible on request: <a href={bookingUrl('en')} class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">let's talk</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">A test with no risk</h3>
          <p class="mt-2 text-sm text-surface-600">In sandbox mode, OpenModeration analyses your real comments without applying any action. You compare its decisions with your current service before changing anything.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Frequently asked questions" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Digitaller is a trademark of its owner. Information about it comes from <a href="https://raiz.es/es/servicios/moderacion-de-los-contenidos/" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">raiz.es</a> (consulted on October 20, 2026). Spotted a mistake? Write to us at <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Further reading</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/use-cases/news-publishers" class="font-medium text-brand-600 hover:text-brand-500">Comment moderation for news publishers &rarr;</a></li>
        <li><a href="/alternatives/interactora" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration or Interactora: the comparison &rarr;</a></li>
        <li><a href="/integrations/wordpress" class="font-medium text-brand-600 hover:text-brand-500">Moderating WordPress comments &rarr;</a></li>
        <li><a href="/alternatives" class="font-medium text-brand-600 hover:text-brand-500">All comparisons &rarr;</a></li>
      </ul>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection title="Test OpenModeration next to your current moderation service." subtitle="Connect your website or pages in sandbox mode and compare decisions for a few weeks, without touching your moderation." />
</BaseLayout>
