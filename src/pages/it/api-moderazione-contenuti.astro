---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.openmoderation.com/it/api-moderazione-contenuti",
      "url": "https://www.openmoderation.com/it/api-moderazione-contenuti",
      "name": "API di moderazione dei contenuti: un'integrazione, 10 fornitori (2026)",
      "description": "Un'unica API di moderazione dei contenuti per tutti i fornitori: OpenAI, Mistral, Azure, Llama Guard e altri. Endpoint di moderazione standardizzati, prefiltraggio, regole personalizzate e registri di audit DSA.",
      "inLanguage": "it",
      "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/it/api-moderazione-contenuti#software",
      "name": "OpenModeration API",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Qualsiasi (API REST)",
      "description": "API di moderazione dei contenuti unificata: un endpoint, 10 fornitori, regole di moderazione personalizzate, endpoint batch e registri di audit.",
      "inLanguage": "it",
      "url": "https://www.openmoderation.com/it/api-moderazione-contenuti",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
    }
  ]
};

const quickstart = `# Modera testo con qualsiasi fornitore: stessa richiesta, stessa risposta
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "Your text to moderate here",
    "model": "openai/omni-moderation-latest",
    "categories": ["hate", "harassment", "sexual", "violence", "self-harm", "spam"],
    "threshold": 0.5
  }'

# Risposta (standardizzata per tutti i fornitori)
{
  "flagged": false,
  "results": [{ "category": "hate", "score": 0.02, "flagged": false }],
  "usage": { "provider": "openai", "latency_ms": 243 }
}`;

const faqItems = [
  {
    question: "Che cos'è un'API di moderazione dei contenuti?",
    answer: "Un'API di moderazione dei contenuti assegna un punteggio ai contenuti degli utenti (odio, molestie, contenuti sessuali, violenza, spam, dati personali…) così la tua app può approvarli, segnalarli o respingerli in automatico. OpenModeration riunisce 10 fornitori dietro un unico endpoint con un formato di risposta standardizzato."
  },
  {
    question: "Qual è l'API di moderazione migliore per la conformità aziendale?",
    answer: "Per le piattaforme regolamentate conviene un'architettura multi-fornitore: OpenAI per la precisione in inglese, Mistral o Azure per le lingue europee e la conformità, più un registro di audit completo. OpenModeration instrada ogni richiesta e registra ogni decisione per i report DSA."
  },
  {
    question: "Quanto costa un'API di moderazione?",
    answer: "L'endpoint di moderazione di OpenAI è gratuito, Mistral fissa il prezzo del proprio modello di moderazione e Azure AI Content Safety fattura per 1.000 record di testo oltre una soglia gratuita di 5.000 record al mese. OpenModeration ha un piano gratuito fino a 1.000 richieste al mese; il piano Pro parte da 99 € al mese per 10.000 richieste e il prefiltraggio elimina dal 10 al 30% delle chiamate a pagamento."
  },
  {
    question: "Posso migrare da OpenAI text-moderation-latest?",
    answer: "Sì. Sostituisci openai.moderations.create con una sola chiamata POST /v1/moderation con il modello openai/omni-moderation-latest. Mantieni la tua chiave OpenAI (BYOK) e aggiungi fornitori di riserva senza riscrivere il codice."
  },
  {
    question: "Posso definire regole di moderazione personalizzate?",
    answer: "Sì, con tre strumenti: parole vietate (blocco immediato), soglie per categoria (approvazione automatica, revisione o rifiuto) e una carta della community in linguaggio naturale, applicata dagli LLM per le categorie personalizzate."
  },
  {
    question: "Dove trovo la documentazione completa dell'API?",
    answer: "La documentazione interattiva si trova su api.openmoderation.com/docs (OpenAPI). Parti da questa pagina per i concetti e i confronti, poi copia l'esempio curl nel tuo stack."
  },
];
---

<BaseLayout
  title="API di moderazione dei contenuti: 10 fornitori, 1 integrazione"
  description="Un'API di moderazione per OpenAI, Mistral, Azure, Llama Guard e altri. Endpoint standard, prefiltraggio, regole personalizzate, batch e audit DSA. Gratis."
  jsonLd={pageJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "API di moderazione dei contenuti" }]} />

  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Per sviluppatori: API REST e console
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Un'unica API di moderazione dei contenuti.<br />Tutti i fornitori.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Basta riscrivere integrazioni. Un solo <strong>endpoint di moderazione</strong> instrada verso OpenAI,
        Mistral, Azure, Llama Guard e altri, con prefiltraggio, regole personalizzate,
        endpoint batch e un registro di audit pronto per il DSA.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
          Ottieni una chiave API gratis
        </a>
        <a href="https://api.openmoderation.com/docs" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
          Leggi la documentazione API &rarr;
        </a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Piano gratuito · Nessuna carta di credito · Documentazione OpenAPI</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Stessa richiesta, qualsiasi fornitore</h2>
          <p class="mt-4 text-lg text-surface-500">
            Passi da <code class="text-sm">openai/omni-moderation-latest</code> a
            <code class="text-sm">mistral/mistral-moderation-2411</code> cambiando un solo campo.
            I punteggi tornano in un formato standardizzato, con soglie che controlli tu.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Endpoint di moderazione standardizzati:</strong> testo singolo o batch (fino a 10.000 elementi), con lo stesso schema ovunque.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Prefiltraggio:</strong> blocca lo spam evidente e le parole vietate prima di qualsiasi chiamata a pagamento ai fornitori.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>Doppia soglia:</strong> approvazione automatica, zona grigia → revisione umana, rifiuto automatico.</span></li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span><span><strong>BYOK e fallback:</strong> le tue chiavi, con instradamento automatico se un fornitore è lento.</span></li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3 text-sm">
            <a href="/it/api-moderazione-testo" class="font-medium text-brand-600 hover:text-brand-500">API di moderazione del testo &rarr;</a>
            <a href="/it/alternative/openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">Alternativa a OpenAI Moderation &rarr;</a>
            <a href="/it/alternative/mistral-moderation" class="font-medium text-brand-600 hover:text-brand-500">Alternativa a Mistral Moderation &rarr;</a>
            <a href="/it/funzionalita" class="font-medium text-brand-600 hover:text-brand-500">Tutte le funzionalità dell'API &rarr;</a>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={quickstart} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché i team scelgono un'API unificata</h2>
        <p class="mt-4 text-lg text-surface-500">Il punteggio grezzo di un fornitore non è un sistema di moderazione.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Funzionalità</th>
              <th class="px-6 py-4 font-semibold text-surface-500">API di un solo fornitore</th>
              <th class="px-6 py-4 font-semibold text-brand-600">API OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            <tr><td class="px-6 py-4 font-medium text-surface-900">Fornitori</td><td class="px-6 py-4 text-surface-500">1 (lock-in)</td><td class="px-6 py-4">10: OpenAI, Mistral, Azure, Llama Guard, Perspective, Hive…</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Formato di risposta</td><td class="px-6 py-4 text-surface-500">Proprietario, diverso per ogni fornitore</td><td class="px-6 py-4">Punteggi standardizzati e verdetto flagged</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Prefiltraggio</td><td class="px-6 py-4 text-surface-500">No</td><td class="px-6 py-4">Sì, risparmi dal 10 al 30% sui costi dei fornitori</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Regole personalizzate</td><td class="px-6 py-4 text-surface-500">Fai da te</td><td class="px-6 py-4">Parole vietate, soglie, carta applicata da LLM</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Revisione e audit</td><td class="px-6 py-4 text-surface-500">Fai da te</td><td class="px-6 py-4">Console, ruoli del team, esportazione DSA</td></tr>
            <tr><td class="px-6 py-4 font-medium text-surface-900">Documentazione</td><td class="px-6 py-4 text-surface-500">Documentazione del fornitore</td><td class="px-6 py-4"><a class="text-brand-600 hover:text-brand-500" href="https://api.openmoderation.com/docs">Documentazione OpenAPI &rarr;</a></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Parti dal tuo stack</h2>
        <p class="mt-4 text-lg text-surface-500">Migra in meno di un'ora, oppure modera i commenti sui social senza codice.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/it/alternative/openai-moderation" class="rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <h3 class="font-semibold text-surface-900">Migra da OpenAI</h3>
          <p class="mt-2 text-sm text-surface-500">Sostituisci le chiamate text-moderation / omni-moderation, mantieni la tua chiave e aggiungi fornitori di riserva.</p>
        </a>
        <a href="/it/alternative/mistral-moderation" class="rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <h3 class="font-semibold text-surface-900">Tieni Mistral e aggiungi 9 fornitori</h3>
          <p class="mt-2 text-sm text-surface-500">Indirizza automaticamente le lingue europee a Mistral e l'inglese a OpenAI.</p>
        </a>
        <a href="/it/casi-d-uso/piattaforme-social" class="rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <h3 class="font-semibold text-surface-900">Piattaforma di moderazione senza codice</h3>
          <p class="mt-2 text-sm text-surface-500">Preferisci un'interfaccia? Gestisci tutto dalla console di moderazione unificata.</p>
        </a>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-4">
        <a href="/it/integrazioni/moderazione-facebook" class="text-sm font-medium text-brand-600 hover:text-brand-500">Strumento di moderazione dei commenti Facebook &rarr;</a>
        <a href="/it/integrazioni/moderazione-instagram" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderazione automatica su Instagram &rarr;</a>
        <a href="/it/integrazioni/moderazione-wordpress" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderazione dei commenti WordPress &rarr;</a>
        <a href="https://api.openmoderation.com/docs" class="text-sm font-medium text-surface-500 hover:text-surface-700">Documentazione API completa (api.openmoderation.com/docs) &rarr;</a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="API di moderazione dei contenuti: domande frequenti" />
    </div>
  </section>

  <CTASection
    title="Un'integrazione. Tutti i fornitori di moderazione."
    subtitle="Ottieni una chiave API, copia l'esempio curl e modera il tuo primo testo in pochi minuti, con registri di audit fin dal primo giorno."
    buttonText="Prova l'API gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
