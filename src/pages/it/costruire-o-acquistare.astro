---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/it/costruire-o-acquistare",
  "url": "https://www.openmoderation.com/it/costruire-o-acquistare",
  "name": "Moderazione dei contenuti: costruire o acquistare? Il confronto dei costi reali",
  "description": "Confronta il costo reale di costruire internamente un'infrastruttura di moderazione rispetto a usare OpenModeration: tempo di sviluppo, manutenzione e copertura funzionale.",
  "inLanguage": "it",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const costs = [
  { item: 'Tempo per essere operativi', build: '6-12 mesi', buy: 'Pochi minuti' },
  { item: 'Impegno di sviluppo', build: 'Più sviluppatori a costruire strumenti interni', buy: 'Nessuno (piattaforma pronta all\'uso)' },
  { item: 'Manutenzione e aggiornamenti continui', build: 'Serve un team dedicato', buy: 'Gestiti dalla piattaforma' },
  { item: 'Infrastruttura (server, DB, Redis)', build: 'Da 500 € a 5.000 €/mese', buy: 'La tua infrastruttura esistente' },
  { item: 'Conformità e registro di audit', build: 'Da 30.000 € a 100.000 € di sviluppo su misura', buy: '0 € (integrati)' },
  { item: 'Gestione del team e interfaccia di revisione', build: 'Mesi di sviluppo UX/UI interno', buy: 'Inclusi e pronti all\'uso' },
];
---

<BaseLayout
  title="Moderazione dei contenuti: costruire o acquistare? I costi reali"
  description="Confronta il costo reale di un'infrastruttura di moderazione costruita in casa con OpenModeration: tempo di sviluppo, manutenzione e funzionalità."
  jsonLd={pageJsonLd}
>
<Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Costruire o acquistare" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Costruire o acquistare
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Costruire o acquistare: il costo reale di un'infrastruttura di moderazione</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Prima di decidere di costruire la tua pipeline di moderazione, scopri quanto costa davvero.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rounded-xl border-2 border-surface-200 bg-surface-50 p-8">
          <h2 class="text-xl font-bold text-surface-900">Costruire strumenti interni</h2>
          <div class="mt-6 space-y-4">
            <div class="border-b border-surface-200 pb-4">
              <p class="text-sm text-surface-500">Tempo per essere operativi</p>
              <p class="text-2xl font-bold text-surface-900">6-12 mesi</p>
            </div>
            <div class="border-b border-surface-200 pb-4">
              <p class="text-sm text-surface-500">Impegno di sviluppo</p>
              <p class="text-2xl font-bold text-surface-900">Elevato</p>
              <p class="text-xs text-surface-400">Più sviluppatori impegnati a costruire console, regole e integrazioni</p>
            </div>
            <div class="border-b border-surface-200 pb-4">
              <p class="text-sm text-surface-500">Manutenzione</p>
              <p class="text-2xl font-bold text-surface-900">Continua, per sempre</p>
              <p class="text-xs text-surface-400">Aggiornamenti costanti per seguire le modifiche alle API dei fornitori e alla normativa</p>
            </div>
            <div>
              <p class="text-sm text-surface-500">Interfaccia di revisione per il team</p>
              <p class="text-2xl font-bold text-surface-900">Da sviluppare su misura</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border-2 border-brand-500 bg-brand-50 p-8">
          <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">Consigliato</div>
          <h2 class="text-xl font-bold text-surface-900">OpenModeration</h2>
          <div class="mt-6 space-y-4">
            <div class="border-b border-brand-200 pb-4">
              <p class="text-sm text-surface-500">Tempo per essere operativi</p>
              <p class="text-2xl font-bold text-surface-900">Pochi minuti</p>
              <p class="text-xs text-surface-400">Piattaforma pronta all'uso</p>
            </div>
            <div class="border-b border-brand-200 pb-4">
              <p class="text-sm text-surface-500">Impegno di sviluppo</p>
              <p class="text-2xl font-bold text-accent-600">Nessuno</p>
              <p class="text-xs text-surface-400">I tuoi sviluppatori restano concentrati sul prodotto principale</p>
            </div>
            <div class="border-b border-brand-200 pb-4">
              <p class="text-sm text-surface-500">Manutenzione</p>
              <p class="text-2xl font-bold text-surface-900">Minima</p>
              <p class="text-xs text-surface-400">La piattaforma gestisce gli aggiornamenti dei fornitori e la conformità</p>
            </div>
            <div>
              <p class="text-sm text-surface-500">Interfaccia di revisione per il team</p>
              <p class="text-2xl font-bold text-surface-900">Inclusa e pronta all'uso</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Ripartizione dei costi del primo anno</h2>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Voce di costo</th>
              <th class="px-6 py-4 font-semibold text-red-600">Costruire</th>
              <th class="px-6 py-4 font-semibold text-accent-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {costs.map((c) => (
              <tr>
                <td class="px-6 py-4 text-surface-600">{c.item}</td>
                <td class="px-6 py-4 text-surface-900">{c.build}</td>
                <td class="px-6 py-4 font-medium text-accent-600">{c.buy}</td>
              </tr>
            ))}
            <tr><td class="px-6 py-4 text-surface-600">Impegno totale del primo anno</td>
              <td class="px-6 py-4 font-bold text-red-600">Elevato (più persone a tempo pieno)</td>
              <td class="px-6 py-4 font-bold text-accent-600">Minimo (pronto all'uso)</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-surface-400">Stime basate sui cicli tipici di sviluppo di strumenti interni. I tuoi risultati possono variare.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Cosa ottieni e cosa dovresti costruire</h2>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Funzionalità</th>
              <th class="px-6 py-4 font-semibold text-red-600">Sviluppo interno</th>
              <th class="px-6 py-4 font-semibold text-accent-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            <tr><td class="px-6 py-4 text-surface-600">Supporto multi-fornitore</td><td class="px-6 py-4 text-surface-500">3-6 mesi per integrare 2 fornitori</td><td class="px-6 py-4 text-accent-600">Oltre 9 fornitori inclusi</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Formato di risposta unificato</td><td class="px-6 py-4 text-surface-500">Normalizzazione su misura per ogni fornitore</td><td class="px-6 py-4 text-accent-600">Standardizzato fin da subito</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Instradamento intelligente</td><td class="px-6 py-4 text-surface-500">Logica di instradamento da costruire da zero</td><td class="px-6 py-4 text-accent-600">Instradamento basato sulla configurazione</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Console di amministrazione</td><td class="px-6 py-4 text-surface-500">Console React/Vue da sviluppare</td><td class="px-6 py-4 text-accent-600">Inclusa, pronta all'uso</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Interfaccia di revisione umana e gestione del team</td><td class="px-6 py-4 text-surface-500">Mesi di sviluppo di strumenti interni</td><td class="px-6 py-4 text-accent-600">Console pronta all'uso per i tuoi team</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Regole IA intelligenti e attente al contesto</td><td class="px-6 py-4 text-surface-500">Logica su misura complessa e fragile</td><td class="px-6 py-4 text-accent-600">Tre strumenti semplici: filtri di parole, soglie, regolamento della community</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Motore di azioni</td><td class="px-6 py-4 text-surface-500">Motore di regole + webhook da costruire</td><td class="px-6 py-4 text-accent-600">Motore di azioni integrato</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Connettori social</td><td class="px-6 py-4 text-surface-500">Integrazione di ogni piattaforma una per una</td><td class="px-6 py-4 text-accent-600">Facebook, Instagram, YouTube, WordPress inclusi</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Registro di audit</td><td class="px-6 py-4 text-surface-500">Sistema di log da progettare da zero</td><td class="px-6 py-4 text-accent-600">Log di audit conformi al DSA</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Moderazione in batch</td><td class="px-6 py-4 text-surface-500">Elaborazione asincrona + webhook da costruire</td><td class="px-6 py-4 text-accent-600">API batch nativa</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Gestione delle chiavi API</td><td class="px-6 py-4 text-surface-500">Autenticazione + limiti di utilizzo da implementare</td><td class="px-6 py-4 text-accent-600">Gestione delle chiavi integrata</td></tr>
            <tr><td class="px-6 py-4 text-surface-600">Installazione con Docker</td><td class="px-6 py-4 text-surface-500">Containerizzazione e orchestrazione</td><td class="px-6 py-4 text-accent-600">docker-compose up</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-ink-900 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-2xl font-bold text-white sm:text-3xl">I costi nascosti dello sviluppo interno</h2>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-ink-700 bg-ink-800 p-6">
          <h3 class="font-semibold text-white">Modifiche alle API dei fornitori</h3>
          <p class="mt-2 text-sm text-surface-400">I fornitori cambiano gli schemi, dismettono modelli e aggiornano le tassonomie senza preavviso. Per un sistema interno ogni modifica è un'emergenza. OpenModeration assorbe questi aggiornamenti in automatico.</p>
        </div>
        <div class="rounded-xl border border-ink-700 bg-ink-800 p-6">
          <h3 class="font-semibold text-white">Deriva della conformità</h3>
          <p class="mt-2 text-sm text-surface-400">Il DSA e le altre normative evolvono. I team interni devono seguire la legislazione e adeguare il registro di audit. OpenModeration è conforme al DSA fin dal primo giorno.</p>
        </div>
        <div class="rounded-xl border border-ink-700 bg-ink-800 p-6">
          <h3 class="font-semibold text-white">Carico operativo</h3>
          <p class="mt-2 text-sm text-surface-400">Costruire l'API è solo il 20% del lavoro. L'altro 80% consiste nel costruire la console, il motore di regole, la gestione del team e l'interfaccia di revisione di cui il tuo team operativo ha davvero bisogno per lavorare.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Quando costruire e quando acquistare</h2>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="flex items-center gap-2 text-lg font-semibold text-red-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Costruisci se...
          </h3>
          <ul class="mt-4 space-y-2 text-sm text-surface-600">
            <li>Gli strumenti di moderazione sono il principale elemento distintivo del tuo prodotto</li>
            <li>Hai un team di sviluppo dedicato per costruirli e mantenerli</li>
            <li>Ti servono algoritmi di moderazione su misura e fortemente proprietari</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6">
          <h3 class="flex items-center gap-2 text-lg font-semibold text-accent-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Scegli OpenModeration se...
          </h3>
          <ul class="mt-4 space-y-2 text-sm text-surface-600">
            <li>Vuoi una piattaforma di moderazione completa operativa oggi, non tra 6 mesi</li>
            <li>Il tuo team di sviluppo deve concentrarsi sul prodotto principale, non sugli strumenti interni</li>
            <li>Il tuo team operativo ha bisogno di una console e di un'interfaccia di revisione pronte all'uso</li>
            <li>Vuoi la flessibilità di più fornitori senza vincoli</li>
            <li>Ti serve la conformità al DSA senza assumere esperti di compliance dedicati</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Per approfondire</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/it/blog/moderazione-costruire-o-acquistare" class="font-medium text-brand-600 hover:text-brand-500">Approfondimento: i costi di un'infrastruttura di moderazione nel 2026 &rarr;</a></li>
        <li><a href="/it/prezzi" class="font-medium text-brand-600 hover:text-brand-500">Prezzi semplici e trasparenti &rarr;</a></li>
        <li><a href="/it/conformita-dsa" class="font-medium text-brand-600 hover:text-brand-500">La conformità al DSA senza un team di compliance &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection
    title="Smetti di costruire strumenti interni. Inizia a proteggere la tua community."
    subtitle="Collega le tue pagine, scrivi le tue regole in linguaggio naturale e ogni commento nascosto avrà la sua spiegazione. Operativo in 5 minuti."
    buttonText="Provalo gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
