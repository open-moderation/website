const title = "Come gestire i commenti negativi e i troll: guida";
const description = "Come gestire i commenti negativi e i troll: critica o abuso, quando rispondere, nascondere, eliminare o bannare, modelli di risposta, raid, crisi e team.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
