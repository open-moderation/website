const decisions = [
  { situation: "Un cliente si lamenta di un ordine in ritardo, di un bug o di una brutta esperienza", action: "Rispondere", why: "Rispondi in pubblico, poi sposta i dettagli in messaggio privato. Chi legge ti giudica da come rispondi." },
  { situation: "Un'opinione dura ma pertinente sul tuo prodotto, sul tuo articolo, su una tua decisione", action: "Lasciare (e rispondere se serve)", why: "La critica fa parte della conversazione. Toglierla costa più fiducia di quanta ne faccia risparmiare." },
  { situation: "Un'informazione falsa o una voce che si diffonde", action: "Rispondere con i fatti", why: "Una correzione pacata, con una fonte, aiuta chiunque leggerà il thread in seguito." },
  { situation: "Un insulto, un attacco personale, un messaggio d'odio, una provocazione senza contenuto", action: "Nascondere", why: "Il commento non inquina più la discussione e l'autore di solito non se ne accorge." },
  { situation: "Spam, link truffa, dati personali di altre persone", action: "Eliminare", why: "Questi contenuti non devono restare online in nessuna forma, nemmeno per chi li ha scritti." },
