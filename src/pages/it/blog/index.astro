---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.openmoderation.com/it/blog",
  "url": "https://www.openmoderation.com/it/blog",
  "name": "Blog sulla moderazione dei contenuti: DSA, sicurezza dell'IA e guide per sviluppatori",
  "description": "Articoli sulla moderazione dei contenuti, la conformità DSA, la sicurezza dell'IA e l'infrastruttura open source.",
  "inLanguage": "it",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const posts = [
  {
    title: "Moderazione dei commenti: la guida completa (2026)",
    description: "Come moderare i commenti: metodi a confronto, regole da scrivere, zone grigie, obblighi del DSA, come scegliere uno strumento e una checklist pratica.",
    href: "/it/blog/moderazione-commenti-guida",
    date: "2026-10-30",
    readTime: "14 min",
    tags: ["guide"],
  },
  {
    title: "Nascondere commenti Facebook automaticamente: guida",
    description: "Come nascondere in automatico i commenti di una Pagina Facebook: nascondere, eliminare o bannare, strumenti integrati, i loro limiti e come scegliere un tool.",
    href: "/it/blog/nascondere-commenti-facebook-automaticamente",
    date: "2026-10-30",
    readTime: "11 min",
    tags: ["guide"],
  },
  {
    title: "Moderazione commenti Instagram: la guida completa",
    description: "Come moderare i commenti su Instagram: parole nascoste, limiti, funzione Limita, cosa serve per collegare uno strumento e attivare la moderazione automatica.",
    href: "/it/blog/moderazione-commenti-instagram",
    date: "2026-10-30",
    readTime: "10 min",
    tags: ["guide"],
  },
  {
    title: "Moderazione commenti TikTok: filtri, regole e consigli",
    description: "Come moderare i commenti su TikTok: filtri, parole chiave filtrate, approvazione manuale, moderatori LIVE, i loro limiti per i brand e cosa fare in una crisi.",
    href: "/it/blog/moderazione-commenti-tiktok",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guide"],
  },
  {
    title: "Moderazione social media: la guida completa (2026)",
    description: "Come moderare i social: metodi, regole, specificità di Facebook, Instagram, YouTube, TikTok, LinkedIn e X, team, gestione delle crisi, metriche e strumenti.",
    href: "/it/blog/moderazione-social-media-guida",
    date: "2026-10-30",
    readTime: "14 min",
    tags: ["guide"],
  },
  {
    title: "Moderazione commenti YouTube: guida pratica",
    description: "Come moderare i commenti su YouTube: commenti in attesa di revisione, parole e link bloccati, utenti approvati e nascosti, chat dal vivo e automazione.",
    href: "/it/blog/moderazione-commenti-youtube",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guide"],
  },
  {
    title: "Come gestire i commenti negativi e i troll: guida",
    description: "Come gestire i commenti negativi e i troll: critica o abuso, quando rispondere, nascondere, eliminare o bannare, modelli di risposta, raid, crisi e team.",
    href: "/it/blog/gestire-commenti-negativi-troll",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guide"],
  },
  {
    title: "Cos'è la moderazione dei contenuti: definizione e tipi",
    description: "Cos'è la moderazione dei contenuti: cosa si modera, i 6 tipi, il lavoro del moderatore di contenuti, come funziona l'IA, il DSA e come scegliere l'approccio.",
    href: "/it/blog/cos-e-moderazione-contenuti",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guide"],
  },
  {
    title: "API OpenAI Moderation: omni-moderation-latest, categorie, prezzi e limiti",
    description: "Cosa rileva l'API OpenAI Moderation, le 13 categorie, il formato della risposta, se è gratuita e cosa ti lascia da costruire.",
    href: "/it/blog/guida-api-openai-moderation",
    date: "2026-10-20",
    readTime: "6 min",
    tags: ["openai", "API", "guida"],
  },
  {
    title: "Conformità DSA per piattaforme piccole e medie: una guida pratica",
    description: "Come le piattaforme piccole e medie possono rispettare gli obblighi del DSA con strumenti open source. I passi concreti per mettersi in regola.",
    href: "/it/blog/guida-dsa-pmi",
    date: "2026-06-16",
    readTime: "8 min",
    tags: ["DSA", "conformità", "guida"],
  },
  {
    title: "Costruire o acquistare: i costi di un'infrastruttura di moderazione nel 2026",
    description: "Il costo reale di una moderazione sviluppata in casa rispetto a OpenModeration. Tempo di sviluppo, manutenzione e costi nascosti analizzati nel dettaglio.",
    href: "/it/blog/moderazione-costruire-o-acquistare",
    date: "2026-06-14",
    readTime: "9 min",
    tags: ["confronto", "costruire-o-acquistare"],
  },
  {
    title: "Addio a Google Perspective API: guida alla migrazione per i forum",
    description: "Google dismetterà Perspective API a fine 2026. Come migrare il tuo forum o la tua community verso un'alternativa open source.",
    href: "/it/blog/migrazione-perspective-api",
    date: "2026-06-12",
    readTime: "7 min",
    tags: ["perspective", "migrazione", "guida"],
  },
  {
    title: "OpenAI Moderation, Azure e Llama Guard a confronto (2026)",
    description: "Un confronto oggettivo tra i principali fornitori di moderazione con IA: prestazioni, prezzi, copertura linguistica e quando conviene usare ciascuno.",
    href: "/it/blog/confronto-openai-azure-llama-guard",
    date: "2026-06-10",
    readTime: "8 min",
    tags: ["confronto", "fornitori"],
  },
  {
    title: "Conformità DSA semplice con la moderazione open source",
    description: "Come rispettare il Digital Services Act dell'UE con strumenti open source: registro di audit, relazioni di trasparenza e sovranità dei dati.",
    href: "/it/blog/conformita-dsa-moderazione-open-source",
    date: "2026-06-08",
    readTime: "6 min",
    tags: ["DSA", "conformità", "open source"],
  },
  {
    title: "Moderazione dei contenuti per applicazioni di IA: guida per sviluppatori",
    description: "Come filtrare input e output nelle applicazioni basate su LLM. Le buone pratiche per prevenire la prompt injection e garantire la sicurezza dei contenuti.",
    href: "/it/blog/guida-moderazione-contenuti-ia-sviluppatori",
    date: "2026-06-05",
    readTime: "10 min",
    tags: ["IA", "LLM", "guida"],
  },
  {
    title: "Presentiamo OpenModeration, la piattaforma di moderazione unificata",
    description: "Stiamo costruendo il livello infrastrutturale open source per la moderazione dei contenuti. Un'unica API, tutti i fornitori, il pieno controllo.",
    href: "/it/blog/presentiamo-openmoderation",
    date: "2026-06-01",
    readTime: "5 min",
    tags: ["annuncio", "open source"],
  },
];
---

<BaseLayout title="Blog sulla moderazione dei contenuti | DSA, IA e guide" description="Articoli sulla moderazione dei contenuti, la conformità DSA, la sicurezza dell'IA e l'infrastruttura open source." jsonLd={blogJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Blog" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Riflessioni sulla moderazione dei contenuti, la sicurezza dell'IA, la conformità DSA e la costruzione di un'infrastruttura open source.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8">
        {posts.map((post) => (
          <a href={post.href} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
            <div class="flex items-center gap-3 text-xs text-surface-400">
              <time datetime={post.date}>{new Date(post.date + "T00:00:00").toLocaleDateString("it-IT", { year: "numeric", month: "long", day: "numeric" })}</time>
              <span>&middot;</span>
              <span>{post.readTime} di lettura</span>
              <span>&middot;</span>
              {post.tags.map((tag) => (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-500">{tag}</span>
              ))}
            </div>
            <h2 class="mt-3 text-xl font-bold text-surface-900 group-hover:text-brand-600">{post.title}</h2>
            <p class="mt-2 text-sm text-surface-500">{post.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-medium text-brand-600">
              Leggi l'articolo
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
