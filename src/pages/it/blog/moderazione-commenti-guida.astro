const methods = [
  { name: "Pre-moderazione", how: "Ogni commento viene letto prima di essere pubblicato.", speed: "Lenta: la pubblicazione aspetta un moderatore", cost: "Alto", risk: "Basso per i contenuti illeciti, alto per la conversazione", scale: "Scarsa" },
  { name: "Post-moderazione", how: "Il commento esce subito e viene letto in un secondo momento.", speed: "Immediata", cost: "Alto", risk: "Medio: un contenuto illecito resta visibile fino al controllo", scale: "Media" },
  { name: "Moderazione reattiva", how: "Si interviene solo sulle segnalazioni degli utenti.", speed: "Immediata", cost: "Basso", risk: "Alto: nessuno vede nulla finché qualcuno non segnala", scale: "Buona, ma subita" },
  { name: "Filtri automatici", how: "Elenchi di parole vietate, blocco dei link, regole fisse.", speed: "Immediata", cost: "Basso", risk: "Alto: blocca critiche legittime e lascia passare ironia e insulti camuffati", scale: "Buona" },
  { name: "Ibrida IA + persone", how: "Un'IA applica le tue regole, i casi dubbi li gestisce il nostro team.", speed: "Pochi secondi", cost: "Moderato", risk: "Basso, se regole e soglie sono ben tarate", scale: "Ottima" },
