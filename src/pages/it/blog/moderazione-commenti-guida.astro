const actions = [
  { action: "Nascondere", what: "Il commento non è più visibile al pubblico. Su Facebook l'autore e i suoi amici possono ancora vederlo.", when: "Insulti, spam, fuori tema aggressivo: il caso più frequente, ed è reversibile." },
  { action: "Eliminare o rifiutare", what: "Il commento viene rimosso in modo definitivo, o respinto prima della pubblicazione.", when: "Contenuti chiaramente illeciti, truffe, dati personali di terzi." },
  { action: "Bannare o limitare", what: "L'autore non può più commentare, per un periodo o per sempre.", when: "Recidiva, molestie mirate, account di spam, attacchi coordinati." },
];

const faqItems = [
