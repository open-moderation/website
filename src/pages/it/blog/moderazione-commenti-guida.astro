const pageTitle = "Moderazione dei commenti: la guida completa (2026)";
const pageDescription = "Come moderare i commenti: metodi a confronto, regole da scrivere, zone grigie, obblighi del DSA, come scegliere uno strumento e una checklist pratica.";

const articleJsonLd = {
