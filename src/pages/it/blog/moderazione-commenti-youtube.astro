const title = "Moderazione commenti YouTube: guida pratica";
const description = "Come moderare i commenti su YouTube: commenti in attesa di revisione, parole e link bloccati, utenti approvati e nascosti, chat dal vivo e automazione.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Moderazione dei commenti YouTube: gli strumenti di YouTube Studio, i loro limiti e quando automatizzare",
  "description": description,
  "inLanguage": "it",
  "datePublished": "2026-10-30",
  "dateModified": "2026-10-30",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
