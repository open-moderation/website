const types = [
  { type: "Pre-moderazione", how: "Ogni contenuto viene controllato prima della pubblicazione.", pros: "Nulla di dannoso va mai online.", cons: "Lenta, costosa, spegne la conversazione in diretta." },
  { type: "Post-moderazione", how: "Il contenuto va online subito e viene controllato dopo.", pros: "Veloce e fluida per gli utenti.", cons: "Ciò che è dannoso resta visibile finché qualcuno non lo controlla." },
