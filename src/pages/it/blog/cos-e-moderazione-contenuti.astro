  { type: "Moderazione ibrida", how: "L'automazione gestisce i casi chiari, le persone quelli dubbi.", pros: "Velocità e giudizio.", cons: "Servono regole chiare e un buon strumento di revisione." },
];

const glossary = [
  { term: "Contenuti generati dagli utenti (UGC)", def: "Tutto ciò che pubblicano gli utenti e non il servizio stesso: commenti, recensioni, post, foto, video, messaggi." },
  { term: "Regole della community", def: "Le regole pubbliche che dicono cosa è permesso su un servizio. Si parla anche di policy di moderazione o netiquette." },
  { term: "Falso positivo", def: "Un contenuto accettabile nascosto o rimosso per errore." },
  { term: "Falso negativo", def: "Un contenuto dannoso lasciato online per errore." },
  { term: "Human in the loop", def: "Un sistema in cui le persone rivedono le decisioni su cui l'automazione è incerta." },
  { term: "Coda di revisione", def: "L'elenco dei contenuti segnalati o dubbi in attesa di una decisione umana." },
  { term: "Meccanismo di segnalazione", def: "Il dispositivo previsto dal DSA che consente a chiunque di segnalare un contenuto illegale a un servizio di hosting, che deve gestire la segnalazione." },
  { term: "Motivazione", def: "La spiegazione che un servizio deve dare all'utente di cui limita il contenuto, secondo il DSA." },
  { term: "Audit trail", def: "Il registro di ogni decisione: cosa, quando, chi o quale sistema e perché." },
  { term: "Trust & safety", def: "La funzione più ampia che si occupa della sicurezza degli utenti, di cui la moderazione dei contenuti è una parte." },
];

const faqItems = [
