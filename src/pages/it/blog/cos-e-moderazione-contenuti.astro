const title = "Cos'è la moderazione dei contenuti: definizione e tipi";
const description = "Cos'è la moderazione dei contenuti: cosa si modera, i 6 tipi, il lavoro del moderatore di contenuti, come funziona l'IA, il DSA e come scegliere l'approccio.";
const linkClass = "text-brand-600 hover:text-brand-500";

const articleJsonLd = {
  "@context": "https://schema.org",
