<BaseLayout title="Conformità DSA semplice per la moderazione dei commenti" description="Come rispettare il Digital Services Act dell'UE: decisioni motivate per iscritto, registro di audit completo, relazioni di trasparenza e hosting in UE." jsonLd={articleJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Blog", href: "/it/blog" }, { label: "Conformità DSA semplice" }]} />
  <GlossaryAutoLink>
