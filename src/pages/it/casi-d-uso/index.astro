---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import KpiBand from '../../../components/KpiBand.astro';

const useCasesJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Casi d'uso della moderazione dei contenuti | OpenModeration",
  "description": "Come piattaforme di ogni tipo usano OpenModeration: piattaforme social, applicazioni di IA, marketplace, videogiochi e SaaS aziendali.",
  "inLanguage": "it"
};

const kpis = [
  { value: "10", label: "Fornitori di IA dietro un'unica API" },
  { value: "300ms", prefix: "<", label: "Latenza mediana P50" },
  { value: "10.000", label: "Elementi per richiesta batch" },
  { value: "100%", label: "Open source (AGPL v3)" },
];

const useCases = [
  {
    title: "Editori e media",
    tagline: "Commenti agli articoli, redazioni",
    description: "Applica la tua linea editoriale a ogni commento dei lettori, motiva per iscritto ogni rimozione e lascia alla redazione i casi al limite.",
    href: "/it/casi-d-uso/media",
    iconPath: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
  },
  {
    title: "Piattaforme social",
    tagline: "Forum, community, UGC",
    description: "Proteggi la tua community da incitamento all'odio, spam e truffe. Automatizza l'applicazione delle regole e lascia ai moderatori solo i casi davvero dubbi.",
    href: "/it/casi-d-uso/piattaforme-social",
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Applicazioni di IA",
    tagline: "Filtraggio di input e output degli LLM",
    description: "Filtra prompt e risposte del modello in un unico sistema di protezione. Combina più fornitori per una difesa a più livelli contro injection e output dannosi.",
    href: "/it/casi-d-uso/applicazioni-ia",
    iconPath: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Marketplace",
    tagline: "Annunci, recensioni, inserzioni",
    description: "Modera annunci, recensioni e messaggi dei venditori su larga scala. Intercetta truffe e articoli vietati prima che vengano pubblicati.",
    href: "/it/casi-d-uso/marketplace",
    iconPath: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z",
  },
  {
    title: "Videogiochi",
    tagline: "Chat, MMO, live ops",
    description: "Moderazione della chat in tempo reale e in più lingue, in meno di 500 ms. Elimina automaticamente le violazioni prima che gli altri giocatori le vedano.",
    href: "/it/casi-d-uso/videogiochi",
    iconPath: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "SaaS aziendale",
    tagline: "Conformità, SOC 2, audit",
    description: "Ospita la piattaforma sulla tua infrastruttura con registri di audit completi, controllo sulla conservazione dei dati e una preparazione a DSA e SOC 2 dimostrabile.",
    href: "/it/casi-d-uso/saas-aziendale",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
];
---

<BaseLayout title="Casi d'uso della moderazione: social, IA, gaming e altro" description="Scopri come piattaforme social, app di IA, marketplace, videogiochi e aziende usano OpenModeration per una moderazione open source e conforme al DSA." jsonLd={useCasesJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Casi d'uso" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
        <span class="flex h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        Casi d'uso
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Un'unica piattaforma di moderazione per ogni tipo di piattaforma</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Forum, app basata su LLM, marketplace o videogioco: OpenModeration si adatta ai tuoi contenuti, alle tue regole e alla tua infrastruttura.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <KpiBand items={kpis} />
  </section>

  <section class="bg-white pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {useCases.map((useCase) => (
          <a href={useCase.href} class="group rounded-xl border border-surface-200 bg-surface-50 p-8 transition hover:border-brand-300 hover:shadow-md">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={useCase.iconPath}/></svg>
            </div>
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">{useCase.title}</h2>
            <p class="mt-1 text-xs font-medium uppercase tracking-wide text-surface-400">{useCase.tagline}</p>
            <p class="mt-3 text-sm text-surface-500">{useCase.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Scopri di più
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
        <a href="/it/funzionalita" class="group rounded-xl border-2 border-dashed border-surface-300 bg-white p-8 transition hover:border-brand-400">
          <div class="flex h-full flex-col items-start justify-center">
            <h2 class="text-xl font-semibold text-surface-900 group-hover:text-brand-600">Esplora tutte le funzionalità</h2>
            <p class="mt-3 text-sm text-surface-500">API unificata, motore di azioni, console di revisione, connettori e registri di audit DSA.</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-600 group-hover:text-brand-700">
              Scopri la piattaforma
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Stessa piattaforma, regole diverse</h2>
        <p class="mt-4 text-lg text-surface-500">Ogni caso d'uso si basa sugli stessi componenti: cambiano solo le regole.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">1. Acquisisci i contenuti</h3>
          <p class="mt-2 text-sm text-surface-500">API REST, endpoint batch per gli arretrati, webhook o connettori nativi per Facebook, Instagram, YouTube e WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">2. Modera con l'IA</h3>
          <p class="mt-2 text-sm text-surface-500">Indirizza ogni richiesta al fornitore più adatto per lingua, tipo di contenuto e budget. Lo schema di risposta è sempre lo stesso.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">3. Applica le regole in automatico</h3>
          <p class="mt-2 text-sm text-surface-500">Parole vietate, soglie per categoria e il regolamento della tua community determinano se nascondere, eliminare, segnalare o mettere in revisione.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Risorse correlate</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/it/blog/guida-dsa-pmi" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guida</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Conformità DSA per piattaforme piccole e medie</h3>
          <p class="mt-2 text-sm text-surface-500">I passi concreti per rispettare i requisiti DSA del 2026 con strumenti open source.</p>
        </a>
        <a href="/it/blog/guida-moderazione-contenuti-ia-sviluppatori" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guida</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Moderazione dei contenuti per applicazioni di IA</h3>
          <p class="mt-2 text-sm text-surface-500">Buone pratiche per filtrare input e output nelle app basate su LLM.</p>
        </a>
        <a href="/it/console-di-moderazione" class="group rounded-xl border border-surface-200 bg-surface-50 p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Prodotto</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">La console di moderazione</h3>
          <p class="mt-2 text-sm text-surface-500">Code di revisione, registri di audit, stato dei fornitori e statistiche di utilizzo.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Scegli il tuo caso d'uso e parti in pochi minuti."
    subtitle="Scegli un caso d'uso, distribuisci con Docker o usa il cloud gestito e modera i tuoi primi contenuti già oggi."
    buttonText="Provalo gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
