---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import BrowserFrame from '../../../components/BrowserFrame.astro';
import ClientLogos from '../../../components/ClientLogos.astro';
import FAQ from '../../../components/FAQ.astro';

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Moderazione dei commenti per editori e siti di informazione",
  "description": "Moderazione dei commenti con IA per siti di notizie e redazioni: la tua linea editoriale applicata a ogni articolo, una motivazione scritta per ogni commento rimosso, una coda di revisione per i giornalisti e un registro di audit DSA.",
  "inLanguage": "it",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const faqItems = [
  {
    question: "I siti di informazione devono rispettare il DSA per i loro spazi commenti?",
    answer: "Gli spazi commenti ospitano contenuti pubblicati dai lettori, quindi un sito di notizie che li gestisce agisce come servizio di hosting ai sensi del Digital Services Act. L'articolo 17 impone una motivazione chiara e specifica ogni volta che un commento viene rimosso o limitato, indicando anche se sono stati usati strumenti automatizzati. OpenModeration redige questa motivazione per ogni decisione e la conserva nel registro di audit.",
  },
  {
    question: "Possiamo moderare secondo la nostra linea editoriale?",
    answer: "Sì. Scrivi le tue regole in linguaggio naturale e OpenModeration le applica a ogni commento, adattandosi ai tuoi casi d'uso. La redazione sportiva e quella politica possono avere regole diverse, e puoi rendere una regola più severa o più permissiva in qualsiasi momento, senza codice.",
  },
  {
    question: "Cosa succede con i commenti al limite?",
    answer: "Ogni categoria ha due soglie. Le violazioni evidenti vengono nascoste automaticamente, i commenti chiaramente accettabili vengono pubblicati e tutto ciò che sta nel mezzo va in una coda di revisione, dove i tuoi moderatori o i giornalisti decidono con un clic.",
  },
  {
    question: "I giornalisti possono continuare a moderare dalla pagina dell'articolo?",
    answer: "Sì. Le decisioni prese dalla redazione vengono registrate nella stessa cronologia delle decisioni automatiche, così hai un unico registro completo di chi ha deciso cosa e perché.",
  },
  {
    question: "Dove sono ospitati i dati?",
    answer: "OpenModeration è sviluppato e ospitato nell'Unione europea ed è conforme al GDPR. Un'installazione on-premise è possibile su richiesta: parliamone.",
  },
];
---

<BaseLayout title="Moderazione dei commenti per editori e media | OpenModeration" description="Modera i commenti dei lettori con un'IA che segue la tua linea editoriale. Motivazione scritta per ogni rimozione, coda di revisione e registro di audit DSA." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Casi d'uso", href: "/it/casi-d-uso" }, { label: "Editori e media" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Caso d'uso
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderazione dei commenti per editori e testate giornalistiche</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        I commenti dei lettori danno vita a un articolo, finché insulti e spam non prendono il sopravvento sulla discussione. OpenModeration applica la tua linea editoriale a ogni commento, motiva per iscritto ogni rimozione e lascia alla redazione i casi difficili.
      </p>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">La sfida</h3>
          <p class="mt-2 text-sm text-surface-600">Un sito di notizie molto seguito riceve commenti a tutte le ore, con picchi a ogni notizia dell'ultima ora. I giornalisti non riescono a leggerli tutti e i filtri per parole chiave non colgono sarcasmo, insulti in codice e attacchi fuori tema, mentre bloccano le critiche legittime.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">L'approccio OpenModeration</h3>
          <p class="mt-2 text-sm text-surface-700">Un'IA attenta al contesto valuta ogni commento rispetto alle tue regole. Le violazioni evidenti vengono nascoste subito, i commenti accettabili vengono pubblicati e quelli al limite finiscono in una coda di revisione, con la regola in questione e una motivazione scritta.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">Il risultato</h3>
          <p class="mt-2 text-sm text-surface-600">I tuoi moderatori dedicano il loro tempo ai commenti che richiedono davvero un giudizio umano. Ogni decisione, automatica o editoriale, viene registrata con la sua motivazione, pronta per il ricorso di un lettore o per un'autorità di controllo.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pensato per il modo in cui lavorano le redazioni</h2>
          <p class="mt-4 text-lg text-surface-500">
            Moderare uno spazio commenti è una decisione editoriale. OpenModeration lascia il controllo alla tua squadra e si fa carico della parte ripetitiva.
          </p>
          <div class="mt-8 space-y-3">
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Le tue regole, in linguaggio naturale</p>
              <p class="mt-1 text-xs text-surface-500">Scrivi le regole che i tuoi lettori già conoscono. Non c'è un elenco di parole chiave da aggiornare né codice da modificare quando il confine si sposta.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Una zona grigia per il giudizio umano</p>
              <p class="mt-1 text-xs text-surface-500">Due soglie per categoria separano ciò che viene nascosto automaticamente da ciò che rivede il tuo team. Sei tu a decidere quanto è ampia la zona grigia.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Un'unica cronologia per le decisioni dell'IA e della redazione</p>
              <p class="mt-1 text-xs text-surface-500">Le rimozioni fatte dai giornalisti compaiono accanto a quelle automatiche nel registro delle attività, con il moderatore che le ha decise e la motivazione.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Commenti agli articoli e pagine social insieme</p>
              <p class="mt-1 text-xs text-surface-500">Modera il tuo sito tramite l'API o il connettore WordPress, e i commenti sotto i tuoi post Facebook, Instagram e YouTube dalla stessa console.</p>
            </div>
          </div>
        </div>
        <BrowserFrame
          src="/images/dashboard.png"
          video="om-triage"
          alt="Coda di moderazione di OpenModeration con i commenti dei lettori, il loro stato e l'azione eseguita"
          caption="La coda di revisione: ogni commento con il suo stato, la regola coinvolta e la motivazione scritta."
        />
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché gli editori scelgono OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Una motivazione per ogni rimozione</h3>
          <p class="mt-2 text-sm text-surface-500">Il DSA impone ai servizi di hosting di motivare ogni rimozione. OpenModeration redige questa spiegazione automaticamente, così i lettori sanno quale regola hanno violato.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Sviluppato e ospitato nell'UE</h3>
          <p class="mt-2 text-sm text-surface-500">I dati dei lettori restano in Europa e la piattaforma è conforme al GDPR. Se il tuo ufficio legale lo richiede, un'installazione on-premise è possibile su richiesta.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Nessuna scatola nera</h3>
          <p class="mt-2 text-sm text-surface-500">Ogni decisione ha una motivazione scritta e un registro di audit completo. Puoi cambiare fornitore di IA senza riscrivere la tua integrazione.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Domande frequenti" items={faqItems} />
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Risorse correlate</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/it/conformita-dsa" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Normativa</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Conformità DSA</h3>
          <p class="mt-2 text-sm text-surface-500">Cosa richiede il Digital Services Act ai siti che ospitano commenti e come rispettarlo.</p>
        </a>
        <a href="/it/prodotto/trasparenza" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Piattaforma</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Ogni decisione spiegata</h3>
          <p class="mt-2 text-sm text-surface-500">Come OpenModeration redige una motivazione per ogni decisione di moderazione.</p>
        </a>
        <a href="/it/integrazioni/moderazione-wordpress" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Integrazione</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Moderazione dei commenti su WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Modera i commenti di un sito di notizie WordPress senza scrivere codice.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection title="Restituisci lo spazio commenti ai tuoi lettori." subtitle="Scrivi le tue regole, collega il tuo sito e lascia che la redazione si concentri sui commenti che richiedono una decisione umana." />
</BaseLayout>
