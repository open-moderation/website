---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Strumento di moderazione dei commenti Facebook: nascondi in automatico i commenti tossici (2026, senza codice)",
  "description": "Nascondi automaticamente con l'IA i commenti tossici sulla tua pagina Facebook. Regole senza codice, oltre 120 lingue, occultamento o eliminazione immediati tramite Graph API. Gratis per iniziare, registro di audit DSA incluso.",
  "inLanguage": "it"
};

const faqItems = [
  {
    question: "Come funziona la moderazione dei commenti su Facebook?",
    answer: "Colleghi la tua pagina Facebook tramite la Graph API. I commenti vengono acquisiti e analizzati automaticamente dal nostro motore di IA. In base alle tue regole, i commenti tossici vengono nascosti o eliminati, senza bisogno di revisione manuale."
  },
  {
    question: "Devo scrivere codice per configurarlo?",
    answer: "No. La configurazione avviene interamente tramite impostazioni. Colleghi la tua pagina Facebook dalla console, definisci le regole di moderazione in linguaggio naturale o con dei semplici interruttori e sei operativo in pochi minuti."
  },
  {
    question: "Quali tipi di contenuti posso moderare su Facebook?",
    answer: "Commenti, risposte e post della tua pagina Facebook. La piattaforma rileva incitamento all'odio, molestie, spam, contenuti NSFW, dati personali (PII), truffe e altro ancora in oltre 120 lingue."
  },
  {
    question: "Quanto costa la moderazione dei commenti su Facebook?",
    answer: "Il cloud gestito di OpenModeration ha un piano gratuito fino a 1.000 richieste al mese e un piano Pro a 99 € al mese, senza costi nascosti."
  },
  {
    question: "Quanto tempo richiede la configurazione?",
    answer: "Pochi minuti. Colleghi la tua pagina Facebook, scegli le regole in linguaggio naturale e la moderazione automatica è attiva in giornata, senza codice e senza sviluppatori."
  },
  {
    question: "Ogni decisione di moderazione viene registrata per gli audit DSA?",
    answer: "Sì. Ogni commento nascosto, eliminato o segnalato conserva la regola applicata, i punteggi dell'IA e la motivazione scritta in un registro di audit completo, che esporti in un clic per i report di trasparenza DSA."
  },
];
---

<BaseLayout title="Moderazione dei commenti Facebook con IA, senza codice" description="Nascondi in automatico i commenti tossici su Facebook. Regole senza codice, oltre 120 lingue, azioni immediate via Graph API. Gratis, ogni decisione motivata." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Integrazioni", href: "/it/integrazioni" }, { label: "Moderazione Facebook" }]} />
  <section class="bg-gradient-to-b from-blue-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-100 text-blue-600">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderazione dei commenti Facebook</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Proteggi la tua pagina Facebook con la moderazione basata sull'IA. Si configura in pochi minuti, senza codice.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Provalo gratis</a>
        <a href="/it/come-funziona" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Come funziona</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Una moderazione semplice in 3 passaggi</h2>
        <p class="mt-4 text-lg text-surface-500">Bastano pochi minuti e non ti serve un team tecnico.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Crea il tuo account</h3>
          <p class="mt-2 text-sm text-surface-500">Registrati gratis su OpenModeration, senza carta di credito e senza impegno.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Collega la tua pagina Facebook</h3>
          <p class="mt-2 text-sm text-surface-500">Collega la tua pagina Facebook con le tue credenziali. Il connettore acquisisce automaticamente commenti e post.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Imposta le tue regole</h3>
          <p class="mt-2 text-sm text-surface-500">Definisci le regole di moderazione in linguaggio naturale. La nostra IA le applica automaticamente: nasconde, elimina o segnala i contenuti.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Cosa puoi rilevare</h2>
        <p class="mt-4 text-lg text-surface-500">Oltre 20 modelli di rilevamento pronti all'uso, addestrati su miliardi di etichette.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Tossicità</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Incitamento all'odio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Molestie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Truffe e phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dati personali (PII)</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Autolesionismo</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Volgarità</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temi sensibili</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Link a rischio</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché è il modo più semplice di moderare Facebook</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Nessun codice richiesto</h3>
          <p class="mt-2 text-sm text-surface-500">Configuri tutto dalla console. Colleghi la pagina, scrivi le regole in linguaggio naturale e lasci che l'IA si occupi del resto.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Le tue credenziali, sotto il tuo controllo</h3>
          <p class="mt-2 text-sm text-surface-500">Usi il token di accesso della tua pagina Facebook. Non conserviamo mai le credenziali in chiaro e ne mantieni la piena titolarità.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Applicazione automatica su Facebook</h3>
          <p class="mt-2 text-sm text-surface-500">Nascondi o elimina i commenti non conformi direttamente tramite la Facebook Graph API, senza bisogno di una coda di moderazione manuale.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Oltre 120 lingue</h3>
          <p class="mt-2 text-sm text-surface-500">Modera i commenti in qualsiasi lingua parli la tua community. L'instradamento intelligente sceglie il fornitore di IA migliore per ogni lingua.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Regole personalizzate in linguaggio naturale</h3>
          <p class="mt-2 text-sm text-surface-500">Scrivi le tue regole di moderazione come la spiegheresti a un collega, senza prompt engineering né espressioni regolari.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Trasparente e ospitato nell'UE</h3>
          <p class="mt-2 text-sm text-surface-500">Ogni decisione ha una motivazione scritta e un registro di audit completo. I dati restano in Europa e puoi esportarli.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Domande frequenti sulla moderazione su Facebook" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
