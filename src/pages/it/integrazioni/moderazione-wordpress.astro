---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Moderazione dei commenti WordPress: approva, trattieni o marca come spam con l'IA (2026, senza codice)",
  "description": "Modera automaticamente con l'IA i commenti WordPress. Colleghi il sito con una password per le applicazioni, senza sviluppare plugin e senza codice. Approva, trattieni o marca come spam i commenti non conformi, registro di audit DSA incluso.",
  "inLanguage": "it"
};

const faqItems = [
  {
    question: "Come funziona la moderazione dei commenti su WordPress?",
    answer: "Colleghi il tuo sito WordPress con una password per le applicazioni. I commenti vengono acquisiti automaticamente tramite la WordPress REST API e analizzati dal nostro motore di IA. In base alle tue regole, i commenti vengono approvati, trattenuti per la revisione o marcati come spam, senza bisogno di una coda manuale."
  },
  {
    question: "Devo scrivere codice per configurarlo?",
    answer: "No. Crea una password per le applicazioni nella bacheca di WordPress (Utenti → Profilo), poi inserisci l'URL del sito, il nome utente e la password nella console di OpenModeration. Il sito viene verificato in pochi secondi e la moderazione si attiva."
  },
  {
    question: "Quali tipi di contenuti posso moderare su WordPress?",
    answer: "Gli articoli e i commenti del tuo sito WordPress. La piattaforma rileva incitamento all'odio, molestie, spam, contenuti NSFW, dati personali (PII), truffe e altro ancora in oltre 120 lingue."
  },
  {
    question: "Cosa succede a un commento non conforme sul mio sito WordPress?",
    answer: "In base alle tue regole di moderazione, il commento viene approvato, messo in attesa di moderazione o marcato come spam direttamente tramite la WordPress REST API. Ogni azione viene registrata con la regola applicata, i punteggi dell'IA e una motivazione scritta."
  },
  {
    question: "Quali permessi deve avere il mio utente WordPress?",
    answer: "Il tuo utente WordPress deve poter moderare i commenti, quindi avere il ruolo di amministratore o di editore. Il connettore lo verifica quando colleghi il sito."
  },
  {
    question: "Ogni decisione di moderazione viene registrata per gli audit DSA?",
    answer: "Sì. Ogni commento approvato, trattenuto o marcato come spam conserva la regola applicata, i punteggi dell'IA e la motivazione scritta in un registro di audit completo, che esporti in un clic per i report di trasparenza DSA."
  },
];
---

<BaseLayout title="Moderazione dei commenti WordPress con IA, senza codice" description="Modera in automatico con l'IA i commenti WordPress: approva, trattieni o marca come spam. Colleghi il sito con una password per le applicazioni. Audit DSA incluso." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Integrazioni", href: "/it/integrazioni" }, { label: "Moderazione WordPress" }]} />
  <section class="bg-gradient-to-b from-sky-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M21.469 6.825c.84 1.537 1.318 3.3 1.318 5.175 0 3.979-2.156 7.456-5.363 9.325l3.295-9.527c.615-1.54.82-2.771.82-3.864 0-.405-.026-.78-.07-1.11m-7.981.105c.647-.03 1.232-.105 1.232-.105.582-.075.514-.93-.067-.899 0 0-1.755.135-2.88.135-1.064 0-2.85-.15-2.85-.15-.585-.03-.661.855-.075.885 0 0 .54.061 1.125.09l1.68 4.605-2.37 7.08L5.354 6.9c.649-.03 1.234-.1 1.234-.1.585-.075.516-.93-.065-.896 0 0-1.746.138-2.874.138-.2 0-.438-.008-.69-.015C4.911 3.15 8.235 1.215 12 1.215c2.809 0 5.365 1.072 7.286 2.833-.046-.003-.091-.009-.141-.009-1.06 0-1.812.923-1.812 1.914 0 .89.513 1.643 1.06 2.531.411.72.89 1.643.89 2.977 0 .915-.354 1.994-.821 3.479l-1.075 3.585-3.9-11.61.001.014zM12 22.784c-1.059 0-2.081-.153-3.048-.437l3.237-9.406 3.315 9.087c.024.053.05.101.078.149-1.12.393-2.325.609-3.582.609M1.211 12c0-1.564.336-3.05.935-4.39L7.29 21.709C3.694 19.96 1.212 16.271 1.211 12M12 0C5.385 0 0 5.385 0 12s5.385 12 12 12 12-5.385 12-12S18.615 0 12 0"/></svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Moderazione dei commenti WordPress</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Proteggi il tuo sito WordPress con la moderazione basata sull'IA. Ti colleghi con una password per le applicazioni e configuri tutto in pochi minuti, senza codice.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-medium text-white shadow-sm hover:bg-brand-800">Provalo gratis</a>
        <a href="/it/come-funziona" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-6 py-3 text-sm font-medium text-surface-700 hover:border-surface-900">Come funziona</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Una moderazione semplice in 3 passaggi</h2>
        <p class="mt-4 text-lg text-surface-500">Bastano pochi minuti e non ti serve un team tecnico.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Crea il tuo account</h3>
          <p class="mt-2 text-sm text-surface-500">Registrati gratis su OpenModeration, senza carta di credito e senza impegno.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Collega il tuo sito WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">Crea una password per le applicazioni nella bacheca di WordPress, poi inserisci URL del sito, nome utente e password. Il sito viene verificato automaticamente; ti serve il ruolo di amministratore o di editore.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8 text-center">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-600">
            <span class="text-xl font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">Imposta le tue regole</h3>
          <p class="mt-2 text-sm text-surface-500">Definisci le regole di moderazione in linguaggio naturale. La nostra IA le applica automaticamente: approva, trattiene o marca i commenti come spam.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Cosa puoi rilevare</h2>
        <p class="mt-4 text-lg text-surface-500">Oltre 20 modelli di rilevamento pronti all'uso, addestrati su miliardi di etichette.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Tossicità</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Incitamento all'odio</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Molestie</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Spam</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">NSFW</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Truffe e phishing</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Dati personali (PII)</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Autolesionismo</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Volgarità</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Sentiment</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Temi sensibili</span></div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 text-center"><span class="text-sm font-medium text-surface-900">Link a rischio</span></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché è il modo più semplice di moderare WordPress</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Nessun codice richiesto</h3>
          <p class="mt-2 text-sm text-surface-500">Configuri tutto dalla console. Generi una password per le applicazioni, colleghi il sito, scrivi le regole in linguaggio naturale e lasci che l'IA si occupi del resto.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Le tue credenziali, sotto il tuo controllo</h3>
          <p class="mt-2 text-sm text-surface-500">Ti colleghi con la tua password per le applicazioni. Le credenziali sono cifrate, mai conservate in chiaro, e puoi revocare l'accesso in qualsiasi momento dalla bacheca di WordPress.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Applicazione automatica su WordPress</h3>
          <p class="mt-2 text-sm text-surface-500">I commenti vengono approvati, trattenuti per la revisione o marcati come spam direttamente tramite la WordPress REST API, senza bisogno di una coda di moderazione manuale.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Oltre 120 lingue</h3>
          <p class="mt-2 text-sm text-surface-500">Modera i commenti in qualsiasi lingua scrivano i tuoi lettori. La nostra IA applica le stesse regole in ogni lingua, e altri modelli verificano i casi delicati.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Regole personalizzate in linguaggio naturale</h3>
          <p class="mt-2 text-sm text-surface-500">Scrivi le tue regole di moderazione come la spiegheresti a un collega, senza prompt engineering né espressioni regolari.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Trasparente e ospitato nell'UE</h3>
          <p class="mt-2 text-sm text-surface-500">Ogni decisione ha una motivazione scritta e un registro di audit completo. I dati restano in Europa e puoi esportarli.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Domande frequenti sulla moderazione su WordPress" />
    </div>
  </section>

  <CTASection />
</BaseLayout>
