---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# Prima: Mistral Moderation (diretto)
import { Mistral } from '@mistralai/mistralai';
const mistral = new Mistral({ apiKey: '...' });
const result = await mistral.moderations.create({ input: text });

# Dopo: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// In più: pre-filtro, doppia soglia, azioni automatiche, registro di audit, IA verificata`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa a Mistral Moderation | OpenModeration",
  "description": "Mistral Moderation è un'ottima API multilingue, ma è un solo modello. OpenModeration usa la propria IA di moderazione, verificata da altri modelli di IA, con pre-filtro, regole automatiche e registri di audit pronti per il DSA.",
  "inLanguage": "it",
};

const comparisonPoints = [
  { feature: "Motore di IA", mistral: "Solo il modello di moderazione di Mistral", openmod: "La nostra IA di moderazione, verificata da altri modelli di IA sui casi delicati" },
  { feature: "Categorie", mistral: "11 categorie fisse nel modello attuale, tra cui dati personali e jailbreak", openmod: "10 categorie standardizzate, più le tue categorie descritte in linguaggio naturale" },
  { feature: "Lingue", mistral: "Ottimo supporto multilingue (francese, tedesco, spagnolo, italiano, portoghese, ecc.)", openmod: "Multilingue: ogni commento è analizzato nella sua lingua, comprese le lingue del tuo pubblico, con i casi delicati verificati da altri modelli di IA" },
  { feature: "Pre-filtro", mistral: "Non disponibile", openmod: "Filtro di parole integrato che blocca i contenuti evidenti prima di qualsiasi chiamata API" },
  { feature: "Motore decisionale", mistral: "Solo punteggi grezzi", openmod: "Doppia soglia: approvazione automatica / zona grigia → revisione da parte del nostro team / rifiuto automatico" },
  { feature: "Input massimo", mistral: "32.000 caratteri", openmod: "Fino a 32.000 caratteri + elaborazione batch per volumi maggiori" },
  { feature: "Console", mistral: "Solo API. Nessuna interfaccia di revisione.", openmod: "Console in cui vedi ogni decisione in tempo reale, statistiche, ruoli del team" },
  { feature: "Dipendenza", mistral: "Vincolato a Mistral", openmod: "Bassa. Motore indipendente dai modelli: i modelli migliori collegati appena escono" },
  { feature: "Conformità", mistral: "Log API di base", openmod: "Registro di audit DSA completo con report esportabili" },
  { feature: "Prezzi", mistral: "Fissato da Mistral sulla sua API", openmod: "Gratis fino a 1.000 commenti analizzati al mese. Cloud gestito da 99 €/mese (10.000 commenti incluse)." },
];

const reasons = [
  {
    title: "Un solo modello, fermo tra un aggiornamento e l'altro",
    description: "L'API di moderazione di Mistral eccelle sui contenuti in francese, tedesco, spagnolo e italiano. Ma un solo modello resta uguale tra un aggiornamento e l'altro. OpenModeration usa la propria IA di moderazione, fa verificare i casi delicati da altri modelli di IA e collega i modelli migliori appena escono."
  },
  {
    title: "Categorie fisse o categorie configurabili",
    description: "Mistral copre un insieme fisso di categorie. E se la tua community deve individuare disinformazione, adescamento di minori o violazioni di regole specifiche? OpenModeration aggiunge categorie configurabili: le descrivi in linguaggio naturale e la nostra IA fa la classificazione."
  },
  {
    title: "Un'API ha bisogno di un livello operativo",
    description: "Mistral ti dà dei punteggi. Un servizio di moderazione ha comunque bisogno di una revisione umana, di un motore di azioni (nascondere/eliminare/segnalare), di accessi basati sui ruoli, di registri di audit per il DSA e di statistiche. OpenModeration include tutto questo, e i casi dubbi li gestisce il nostro team."
  },
  {
    title: "Senza pre-filtro paghi anche lo spam evidente",
    description: "Ogni commento che invii all'endpoint di moderazione di Mistral rientra nel tuo consumo dell'API. Con il pre-filtro di OpenModeration, spam evidente, parole vietate e pattern regex vengono bloccati prima che un modello di IA li veda."
  },
];

const faqItems = [
  {
    question: "Quanto costa Mistral Moderation rispetto a OpenModeration?",
    answer: "Mistral fissa il prezzo del suo modello di moderazione sulla propria API. OpenModeration è gratuito fino a 1.000 commenti analizzati al mese e il cloud gestito parte da 99 €/mese per 10.000 commenti."
  },
  {
    question: "Quale IA usa OpenModeration?",
    answer: "La propria IA di moderazione, configurata sulle tue regole e sui tuoi casi d'uso, con i casi delicati verificati da altri modelli di IA. Quando esce un modello migliore o più economico, lo colleghiamo rapidamente, senza codice da riscrivere da parte tua."
  },
  {
    question: "Quanto tempo richiede la migrazione?",
    answer: "Meno di un'ora per sostituire l'API: una sola chiamata POST /v1/moderation prende il posto del client Mistral. Console, regole e registri di audit funzionano subito dopo."
  },
  {
    question: "Supporta il francese e le altre lingue europee?",
    answer: "Sì. La nostra IA di moderazione gestisce il francese, il tedesco, lo spagnolo, l'italiano e le altre principali lingue dell'UE, e i casi delicati vengono verificati da altri modelli di IA."
  },
  {
    question: "Ogni decisione viene registrata per gli audit DSA?",
    answer: "Sì. Ogni decisione, dell'IA o umana, conserva i punteggi, le soglie, il revisore e la data e l'ora. Esporti con un clic l'intero registro di audit per le relazioni di trasparenza DSA."
  },
];
---

<BaseLayout
  title="Alternativa a Mistral Moderation: prezzi, confronto e migrazione"
  description="Mistral Moderation è un solo modello. OpenModeration usa la propria IA, verificata da altri modelli, con regole, revisione umana e audit DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Alternative", href: "/it/alternative" }, { label: "Alternativa a Mistral Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-1.5 text-sm font-medium text-blue-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Alternativa a Mistral Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Mistral è eccellente per la moderazione in Europa.<br/>Un servizio di moderazione richiede più di un modello.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        L'API di moderazione di Mistral gestisce benissimo le lingue europee. Resta però un solo modello.
        OpenModeration usa la propria IA di moderazione, <strong>verificata</strong> da altri modelli di IA, con una sola
        chiamata API, con regole automatiche, revisione umana da parte del nostro team e registri di audit conformi al DSA.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="/it/prenota-una-call" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Prenota una call</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Prova gratis</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché andare oltre il solo Mistral</h2>
        <p class="mt-4 text-lg text-surface-500">Mistral è una delle migliori API di moderazione pensate per l'Europa. Però moderare significa gestire un flusso di lavoro, e un'API ne copre solo una parte.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Una chiamata, tutta la piattaforma
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Sostituisci il client Mistral. Ottieni la piattaforma completa.</h2>
          <p class="mt-4 text-lg text-surface-500">
            Una sola chiamata POST /v1/moderation sostituisce il client Mistral. OpenModeration aggiunge pre-filtro,
            doppia soglia, azioni automatiche e un registro di audit completo, sempre con la stessa chiamata API.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>IA verificata:</strong> altri modelli di IA arbitrano i casi delicati prima che una decisione venga applicata.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Indipendente dai modelli:</strong> quando esce un modello migliore o più economico, lo colleghiamo. Per te non cambia nulla.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Un'esperienza da sviluppatori di prim'ordine:</strong> sia Mistral sia OpenModeration sono costruiti da team europei, per gli sviluppatori.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Mistral Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">L'API di Mistral è eccellente. OpenModeration è una piattaforma completa.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funzionalità</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Mistral Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.mistral}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Alternativa a Mistral Moderation: domande frequenti" />
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Confronta altre alternative</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/it/alternative/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/it/alternative/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/it/alternative/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/it/alternative/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/it/alternative/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection
    title="Più di un modello di moderazione."
    subtitle="La nostra IA verificata, regole automatiche e la revisione umana del nostro team, tutto ospitato nell'UE. Vedi ogni decisione in tempo reale."
    buttonText="Prova OpenModeration gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
