---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# OpenAI Moderation API (diretto)
const openai = new OpenAI({ apiKey: 'sk-...' });
const mod = await openai.moderations.create({ input: text });
// Risultato: formato specifico di OpenAI, 11 categorie, nessuna soglia

# OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({
    input: text,
    categories: ['hate', 'harassment', 'sexual', 'violence', 'self-harm', 'spam'],
    threshold: 0.5
  })
});
// In più: pre-filtro, doppia soglia, azioni automatiche, registro di audit, console in tempo reale`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa all'API OpenAI Moderation: prezzi e confronto",
  "description": "Cerchi un'alternativa all'API OpenAI Moderation? OpenModeration usa la propria IA di moderazione, verificata da altri modelli di IA, con regole automatiche, revisione umana da parte del nostro team e registri di audit DSA per la conformità aziendale.",
  "inLanguage": "it",
};

const comparisonPoints = [
  { feature: "Motore di IA", openai: "Un solo modello OpenAI", openmod: "La nostra IA di moderazione, verificata da altri modelli di IA sui casi delicati" },
  { feature: "Formato API", openai: "Formato proprietario di OpenAI", openmod: "Formato standardizzato. Quando colleghiamo un modello di IA migliore, nel tuo codice non cambia nulla." },
  { feature: "Pre-filtro", openai: "Non disponibile: ogni richiesta arriva all'API", openmod: "Filtro di parole integrato che blocca i contenuti evidenti prima di qualsiasi chiamata all'IA" },
  { feature: "Logica decisionale", openai: "Binaria per categoria: segnalato / non segnalato", openmod: "Doppia soglia: approvazione automatica, zona grigia rivista dal nostro team o rifiuto automatico" },
  { feature: "Console di moderazione", openai: "Solo API. Nessuna console, nessuna interfaccia di revisione.", openmod: "Console completa: ogni decisione in tempo reale, ruoli del team, statistiche" },
  { feature: "Regole automatiche", openai: "Integrazione da costruire da zero", openmod: "Pronte all'uso: definisci le regole una volta e il motore di azioni le applica in automatico" },
  { feature: "Revisione umana", openai: "Interfaccia di revisione da costruire da zero", openmod: "Casi dubbi gestiti dal nostro team; puoi intervenire o ribaltare una decisione in qualsiasi momento" },
  { feature: "Registro di audit", openai: "Limitato ai log API", openmod: "Registro di audit completo: ogni decisione dell'IA e umana registrata, esportabile per il DSA" },
  { feature: "Dipendenza", openai: "Vincolo totale all'ecosistema OpenAI", openmod: "Nessuna. Motore indipendente dai modelli, ed esporti i tuoi dati quando vuoi" },
  { feature: "Sovranità dei dati", openai: "Dati elaborati sui server di OpenAI", openmod: "Cloud ospitato nell'UE; on-premise su richiesta." },
  { feature: "Prezzi", openai: "Endpoint gratuito (solo punteggi)", openmod: "Gratis fino a 1.000 richieste al mese. Cloud gestito da 99 €/mese (10.000 richieste incluse)." },
  { feature: "Lunghezza massima dell'input", openai: "32.000 caratteri", openmod: "Testi lunghi supportati + elaborazione batch per volumi maggiori" },
];

const reasons = [
  {
    title: "Sei vincolato alla precisione di un solo modello",
    icon: "lock",
    description: "OpenAI Moderation funziona molto bene in inglese, meno nelle altre lingue o sulle categorie di nicchia, e non ti dà un secondo parere. OpenModeration usa la propria IA di moderazione e fa verificare i casi delicati da altri modelli di IA. Quando esce un modello migliore, lo colleghiamo."
  },
  {
    title: "Una chiamata API non è un flusso di moderazione",
    icon: "api",
    description: "Ricevere un punteggio di tossicità da OpenAI è solo l'inizio. Devi ancora decidere quale punteggio fa scattare quale azione, rivedere i casi in zona grigia, registrare ogni decisione per gli audit e gestire gli accessi del team. OpenModeration si occupa di tutto questo, e i casi dubbi li rivede il nostro team."
  },
  {
    title: "Senza pre-filtro ogni commento arriva all'API",
    icon: "cost",
    description: "L'endpoint di OpenAI è gratuito, ma ogni commento deve comunque fare andata e ritorno verso l'API, anche lo spam evidente o le parole vietate. Il pre-filtro di OpenModeration li blocca prima che raggiungano qualsiasi modello di IA."
  },
  {
    title: "La conformità al DSA richiede più di un'API",
    icon: "compliance",
    description: "Il Digital Services Act europeo richiede decisioni di moderazione documentate, meccanismi di ricorso e relazioni di trasparenza. Una risposta API grezza non basta. OpenModeration ti dà log di audit, tracciabilità delle revisioni e report esportabili."
  },
];

const verticals = [
  { name: "Piattaforme social", desc: "Modera commenti e post degli utenti con un'IA attenta al contesto e regole specifiche per la tua community." },
  { name: "Applicazioni di IA", desc: "Filtra sia gli input degli utenti sia gli output degli LLM. Definisci le tue categorie, man mano che evolvono." },
  { name: "Videogiochi", desc: "Moderazione della chat in tempo reale in più lingue, con latenza sotto i 250 ms e azioni automatiche." },
  { name: "Marketplace", desc: "Segnala annunci spam, incitamento all'odio nelle recensioni e fughe di dati personali prima che vengano pubblicati." },
];

const faqItems = [
  {
    question: "Quanto costa l'API OpenAI Moderation rispetto a OpenModeration?",
    answer: "L'endpoint di moderazione di OpenAI è gratuito, ma restituisce solo punteggi: niente console, niente regole, niente revisione umana e niente registro di audit. OpenModeration è gratuito fino a 1.000 richieste al mese; il cloud gestito parte da 99 €/mese per 10.000 richieste."
  },
  {
    question: "Quale IA usa OpenModeration?",
    answer: "La propria IA di moderazione, configurata sulle tue regole e sui tuoi casi d'uso. Sui casi delicati, altri modelli di IA arbitrano la decisione prima che venga applicata. Il motore non dipende da un solo modello: quando esce un modello migliore o più economico, lo colleghiamo, senza codice da riscrivere da parte tua."
  },
  {
    question: "Quanto tempo richiede la migrazione?",
    answer: "Meno di un'ora: una sola chiamata POST /v1/moderation sostituisce openai.moderations.create. I punteggi vengono convertiti in un formato standard e soglie e regole si applicano subito."
  },
  {
    question: "Cosa ottengo in più rispetto ai semplici punteggi?",
    answer: "Una piattaforma completa: pre-filtro, doppie soglie (approvazione automatica, revisione da parte del nostro team, rifiuto automatico), una console in cui vedi ogni decisione in tempo reale, ruoli del team e un registro di audit pronto per il DSA, con report esportabili."
  },
  {
    question: "Qual è la migliore API di moderazione per la conformità aziendale?",
    answer: "Per la conformità aziendale servono più dei semplici punteggi: decisioni documentate, accessi basati sui ruoli, registri di audit e report esportabili. OpenModeration offre tutto questo: ogni decisione dell'IA e umana viene registrata, le regole vengono applicate in automatico e l'intero registro di audit si esporta con un clic per le relazioni di trasparenza DSA. Il cloud ospitato nell'UE mantiene i dati sotto il tuo controllo, e li esporti quando vuoi."
  },
  {
    question: "Devo cambiare il mio codice quando OpenModeration cambia modello di IA?",
    answer: "No. Le risposte mantengono lo stesso formato standardizzato. Quando esce un modello di IA migliore o più economico, il nostro team lo collega rapidamente e per te non cambia nulla."
  },
];
---

<BaseLayout
  title="Alternativa all'API OpenAI Moderation: prezzi e confronto"
  description="L'endpoint gratuito di OpenAI dà solo punteggi. OpenModeration aggiunge un'IA verificata, pre-filtro, regole, revisione umana del nostro team e audit DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Alternative", href: "/it/alternative" }, { label: "Alternativa a OpenAI Moderation" }]} />
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-50 px-4 py-1.5 text-sm font-medium text-green-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Alternativa all'API OpenAI Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        OpenAI Moderation è un modello.<br/>OpenModeration è la piattaforma.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        L'API Moderation di OpenAI ti dà punteggi di tossicità. OpenModeration ti dà la propria IA di moderazione,
        verificata da altri modelli, pre-filtro, regole automatiche, revisione umana da parte del nostro team
        e registri di audit conformi al DSA. I dati sono ospitati nell'UE.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Prova OpenModeration gratis</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Vedi il confronto completo</a>
      </div>
    </div>
  </section>

  <!-- Why switch section -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché i team lasciano OpenAI Moderation</h2>
        <p class="mt-4 text-lg text-surface-500">L'API di OpenAI è un ottimo motore di moderazione. Da solo, però, restituisce punteggi e non decisioni.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
              {r.icon === 'lock' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>}
              {r.icon === 'api' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>}
              {r.icon === 'cost' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
              {r.icon === 'compliance' && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>}
            </div>
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Un'integrazione, un'IA che continua a migliorare
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
            La stessa moderazione del testo, con più controllo
          </h2>
          <p class="mt-4 text-lg text-surface-500">
            Con l'API di OpenAI ottieni punteggi. Con OpenModeration ottieni i punteggi
            <strong>più</strong> pre-filtro, soglie configurabili, azioni automatiche
            e un registro di audit completo, sempre con la stessa, unica chiamata API.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>La nostra IA di moderazione</strong>, configurata sulle tue regole e sui tuoi casi d'uso.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Un secondo parere</strong>: altri modelli di IA verificano i casi delicati prima che una decisione venga applicata.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Nessun modello fermo</strong>: i modelli migliori o più economici vengono collegati appena escono, senza nulla da cambiare da parte tua.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">API OpenAI Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Un confronto diretto sulle funzionalità che contano per la moderazione in produzione.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funzionalità</th>
              <th class="px-6 py-4 font-semibold text-surface-500">API OpenAI Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.openai}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Hidden cost vs advantage -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            Usare solo l'API OpenAI Moderation
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Ogni commento arriva all'API, anche lo spam evidente o le parole vietate</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Esito binario segnalato/non segnalato, senza zona grigia per i contenuti sfumati</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Devi costruire da solo la console in cui i moderatori rivedono i casi dubbi</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Devi costruire da solo il motore di regole che traduce i punteggi in azioni</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Devi costruire da solo il sistema di log di audit per la conformità DSA</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Nessun secondo parere sui casi delicati</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Vincolo all'ecosistema OpenAI</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            OpenModeration
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> <strong>Pre-filtro:</strong> blocca spam evidente e parole vietate prima di qualsiasi chiamata all'IA</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> <strong>Doppia soglia:</strong> approvazione automatica, rifiuto automatico o revisione da parte del nostro team in base a soglie configurabili</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> <strong>Niente da fare da parte tua:</strong> vedi ogni decisione in tempo reale e puoi intervenire quando vuoi</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> <strong>Configurazione semplice delle regole:</strong> tre strumenti, cioè parole vietate, soglie per categoria e le tue regole in linguaggio naturale. Nessun codice necessario.</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> <strong>Conformità integrata:</strong> registro di audit completo, report esportabili, conservazione dei dati configurabile</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> <strong>IA verificata:</strong> i casi delicati vengono verificati da altri modelli di IA</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> <strong>Nessun modello fermo:</strong> i modelli migliori vengono collegati appena escono, ed esporti i tuoi dati quando vuoi.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Pensato per ogni caso d'uso della moderazione dei contenuti</h2>
        <p class="mt-4 text-lg text-surface-500">Puoi sostituire l'API di OpenAI con OpenModeration in meno di un'ora.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{v.name}</h3>
            <p class="mt-2 text-sm text-surface-500">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- omni-moderation-latest compatibility -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Da omni-moderation-latest a OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Mantieni un'integrazione semplice e ottieni tutto il flusso di lavoro attorno al punteggio.</p>
        <p class="mt-2 text-sm"><a href="/it/blog/guida-api-openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">Come funziona l'API OpenAI Moderation: categorie, prezzi e limiti &rarr;</a></p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sostituisci una sola chiamata</h3>
          <p class="mt-2 text-sm text-surface-500">Una sola chiamata POST /v1/moderation sostituisce openai.moderations.create, con un formato di risposta standardizzato.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Decisioni verificate</h3>
          <p class="mt-2 text-sm text-surface-500">Sui casi delicati, altri modelli di IA arbitrano la decisione, e i casi dubbi li gestisce il nostro team.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Un'IA che continua a migliorare</h3>
