---
import { bookingUrl } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CharterSupport from '../../../components/CharterSupport.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import SwitchProvider from '../../../components/SwitchProvider.astro';
import FAQ from '../../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/it/alternative/bodyguard",
  "name": "Alternativa a Bodyguard: il confronto con OpenModeration",
  "description": "Bodyguard o OpenModeration? Confronto documentato tra i due strumenti di moderazione: social coperti, prezzi, hosting dei dati e motivazione scritta delle decisioni.",
  "inLanguage": "it",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const rows = [
  { feature: "Offerta", bodyguard: "Un'API di moderazione per le piattaforme e un servizio di moderazione dei social per brand, agenzie ed enti pubblici", openmod: "Un'unica piattaforma: connettori per i social e WordPress, API REST e webhook per tutto il resto" },
  { feature: "Social coperti", bodyguard: "Facebook, Instagram, TikTok, X, LinkedIn, YouTube, Twitch, Discord", openmod: "Sito web, Facebook, Instagram, YouTube e WordPress in modo nativo; TikTok, X, LinkedIn e altri social aggiunti su richiesta, rapidamente" },
  { feature: "Prezzi", bodyguard: "Guardian da 1.000 € al mese, Sentinel da 3.000 € al mese, Commander su preventivo; prezzo in base alla dimensione del pubblico", openmod: "Pubblici: gratis fino a 1.000 commenti analizzati al mese, Pro a 99 € al mese" },
  { feature: "Hosting dei dati", bodyguard: "Non specificato nella home page", openmod: "Progettato e ospitato nell'Unione europea" },
  { feature: "Modelli di IA", bodyguard: "Tecnologia sviluppata da Bodyguard", openmod: "Una propria IA di moderazione, verificata da altri modelli di IA sui casi delicati; i nuovi modelli collegati appena escono" },
  { feature: "Motivazione scritta di ogni decisione", bodyguard: "Non menzionata", openmod: "Sì, per ogni decisione, nella lingua che preferisci" },
  { feature: "DSA", bodyguard: "Non menzionato nella home page", openmod: "Registro di audit di tutte le decisioni, automatiche o umane" },
  { feature: "Conformità dichiarata", bodyguard: "GDPR, SOC 2 Type 2", openmod: "GDPR; ogni decisione motivata per iscritto e registrata" },
  { feature: "Lingue", bodyguard: "46 lingue dichiarate", openmod: "Multilingue: ogni commento è analizzato nella sua lingua, comprese le lingue del tuo pubblico" },
];

const faqItems = [
  {
    question: "Qual è la migliore alternativa a Bodyguard?",
    answer: "Dipende da cosa cerchi. Se vuoi un piano gratuito per iniziare, dati ospitati nell'UE e una motivazione scritta per ogni commento nascosto, OpenModeration risponde a questi criteri. OpenModeration modera anche TikTok, X, LinkedIn e altri social su richiesta. Se ti serve una certificazione SOC 2 Type 2 o la moderazione nativa di TikTok o Twitch già oggi, Bodyguard può fare più al caso tuo.",
  },
  {
    question: "Quanto costa Bodyguard rispetto a OpenModeration?",
    answer: "Nella sua pagina prezzi, Bodyguard indica un piano Guardian da 1.000 € al mese e un piano Sentinel da 3.000 € al mese, con un prezzo legato alla dimensione del pubblico. OpenModeration offre un piano gratuito fino a 1.000 commenti analizzati al mese e un piano Pro a 99 € al mese per 10.000 commenti.",
  },
  {
    question: "OpenModeration è conforme al DSA?",
    answer: "OpenModeration scrive una motivazione per ogni decisione e conserva un registro di audit di tutte le decisioni, che siano prese dall'IA o da un moderatore. Questi due elementi servono direttamente alla motivazione chiara e specifica richiesta dall'articolo 17 del DSA.",
  },
  {
    question: "Si può passare da Bodyguard a OpenModeration senza rifare tutto?",
    answer: "Su Facebook, Instagram, YouTube e WordPress basta collegare i tuoi account e scrivere le tue regole in linguaggio naturale, senza codice. Per una piattaforma proprietaria, l'API REST di OpenModeration sostituisce la chiamata all'API precedente.",
  },
];
---

<BaseLayout title="Alternativa a Bodyguard: confronto con OpenModeration (2026)" description="Bodyguard o OpenModeration? Confronto documentato: social coperti, prezzi, hosting UE e motivazione scritta di ogni decisione." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Alternative", href: "/it/alternative" }, { label: "Bodyguard" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Confronto
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Alternativa a Bodyguard: OpenModeration a confronto</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Bodyguard è un'affermata azienda francese di moderazione con IA. OpenModeration fa scelte diverse: un piano gratuito e poi Pro a 99 € al mese, dati ospitati nell'UE e una motivazione scritta per ogni decisione. Ecco le differenze, fonti alla mano, per scegliere con cognizione di causa.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/it/prenota-una-call" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Prenota una call</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Prova gratis</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
      <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-brand-700">Scegli OpenModeration se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-700">
          <li>vuoi iniziare gratis e poi pagare meno di 100 € al mese;</li>
          <li>vuoi un registro di audit completo di ogni decisione;</li>
          <li>i tuoi dati devono restare nell'Unione europea;</li>
          <li>devi motivare ogni rimozione di commento, come richiede il DSA;</li>
          <li>vuoi un'IA che approfitta dei progressi dei modelli, invece di restare ferma a un algoritmo che invecchia.</li>
        </ul>
      </div>
      <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
        <h2 class="text-lg font-semibold text-surface-900">Bodyguard può fare più al caso tuo se…</h2>
        <ul class="mt-4 space-y-2 text-sm text-surface-600">
          <li>il tuo ufficio acquisti richiede una certificazione SOC 2 Type 2;</li>
          <li>ti serve già oggi la moderazione nativa di TikTok o Twitch.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Bodyguard e OpenModeration, punto per punto</h2>
      <p class="mt-4 text-surface-500">Informazioni su Bodyguard tratte dal suo sito, bodyguard.ai, consultato il 20 ottobre 2026.</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th class="px-6 py-4 font-semibold text-surface-900">Criterio</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Bodyguard</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {rows.map((r) => (
              <tr>
                <td class="px-6 py-4 font-medium text-surface-900">{r.feature}</td>
                <td class="px-6 py-4 text-surface-500">{r.bodyguard}</td>
                <td class="px-6 py-4 text-surface-700">{r.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Cosa cambia davvero ogni giorno</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Sai perché un commento è stato nascosto</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration accompagna ogni decisione con una motivazione scritta, visibile al tuo team e restituita dall'API. Puoi rispondere a un lettore che contesta, ed è proprio il DSA a imporre di motivare ogni rimozione.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Le tue regole, scritte come le pensi</h3>
          <p class="mt-2 text-sm text-surface-600">Scrivi le tue regole di moderazione in linguaggio naturale, aggiungi parole vietate e imposti una soglia per categoria. I casi limite finiscono in una zona grigia che gestisce il nostro team; tu puoi intervenire con un clic, quando vuoi.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Un costo d'ingresso molto più basso</h3>
          <p class="mt-2 text-sm text-surface-600">Bodyguard parte da 1.000 € al mese. OpenModeration è gratuito fino a 1.000 commenti analizzati al mese e il piano Pro costa 99 € al mese. Se ti serve un'installazione on-premise, è possibile su richiesta: <a href={bookingUrl('it')} class="text-brand-600 underline">parliamone</a>.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Nessuna dipendenza da un unico modello</h3>
          <p class="mt-2 text-sm text-surface-600">OpenModeration usa la propria IA di moderazione e i casi delicati vengono verificati da altri modelli di IA. Quando esce un modello migliore o più economico, lo colleghiamo rapidamente: per te non cambia nulla.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Domande frequenti" items={faqItems} />
      <p class="mx-auto mt-10 max-w-3xl text-center text-sm text-surface-400">
        Bodyguard è un marchio del rispettivo titolare. Le informazioni che lo riguardano provengono da <a href="https://bodyguard.ai/fr" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">bodyguard.ai</a> e dalla sua <a href="https://www.bodyguard.ai/en/social-media/pricing" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">pagina prezzi</a> (consultato il 20 ottobre 2026). Hai trovato un errore? Scrivici a <a href="mailto:contact@openmoderation.com" class="text-brand-600 hover:text-brand-500">contact@openmoderation.com</a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Per approfondire</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/it/moderazione-social" class="font-medium text-brand-600 hover:text-brand-500">Moderazione dei social con OpenModeration &rarr;</a></li>
        <li><a href="/it/conformita-dsa/motivazione" class="font-medium text-brand-600 hover:text-brand-500">La motivazione richiesta dal DSA &rarr;</a></li>
        <li><a href="/it/alternative" class="font-medium text-brand-600 hover:text-brand-500">Tutti i confronti &rarr;</a></li>
        <li><a href="/it/prezzi" class="font-medium text-brand-600 hover:text-brand-500">I prezzi di OpenModeration &rarr;</a></li>
      </ul>
    </div>
  </section>

  <SwitchProvider />

  <RelatedComparisons />

  <CTASection title="Prova l'alternativa a Bodyguard." subtitle="Collega le tue pagine, scrivi le tue regole e leggi la motivazione scritta di ogni commento nascosto. Gratis per iniziare." />
</BaseLayout>
