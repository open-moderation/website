---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import FAQ from '../../../components/FAQ.astro';

const migrationCode = `# Azure Content Safety (diretto)
const endpoint = "https://<resource>.cognitiveservices.azure.com/";
const res = await fetch(endpoint + "/contentsafety/text:analyze?api-version=2024-02-01", {
  method: 'POST',
  headers: { 'Ocp-Apim-Subscription-Key': '...' },
  body: JSON.stringify({ text, categories: ['Hate','SelfHarm','Sexual','Violence'] })
});
// Risultato: formato specifico di Azure, 4 categorie, installazione per regione

# OpenModeration (unificato)
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({
    input: text,
    categories: ['hate', 'harassment', 'sexual', 'violence', 'self-harm', 'spam'],
    threshold: 0.5
  })
});
// In più: pre-filtro, doppia soglia, azioni automatiche, registro di audit, console per il team`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa all'API di moderazione di Azure | OpenModeration",
  "description": "Confronta OpenModeration e Azure Content Safety per la moderazione con IA. Azure ti vincola all'ecosistema Microsoft con una moderazione solo via API. OpenModeration ti permette di usare Azure insieme ad altri 9 fornitori con un'unica API, con console di revisione integrata, regole senza codice e dati ospitati nell'UE.",
  "inLanguage": "it"
};

const faqItems = [
  {
    question: "Quanto costa Azure Content Safety rispetto a OpenModeration?",
    answer: "Azure AI Content Safety fattura per blocchi di 1.000 record di testo (un record arriva a 1.000 caratteri) dopo una soglia gratuita di 5.000 record al mese, a una tariffa che dipende dalla tua regione Azure. OpenModeration è gratuito fino a 1.000 richieste al mese e il cloud gestito parte da 99 €/mese per 10.000 richieste, e il pre-filtro elimina dal 10 al 30% delle chiamate fatturabili prima che arrivino ad Azure."
  },
  {
    question: "Posso continuare a usare Azure Content Safety con OpenModeration?",
    answer: "Sì. Usa la tua chiave Azure (BYOK) e indirizza le richieste ad Azure Content Safety come fornitore principale. Aggiungi OpenAI o Mistral come fallback modificando la configurazione: nessun codice da riscrivere, nessun riaddestramento."
  },
  {
    question: "OpenModeration supporta i modelli di moderazione di Azure OpenAI?",
    answer: "Sì. Sono supportati come fornitori sia l'endpoint Azure AI Content Safety sia i modelli di moderazione di Azure OpenAI. Le risposte vengono uniformate in un unico formato per tutti i 10 fornitori."
  },
  {
    question: "Cosa ottengo in più rispetto ai semplici punteggi di Azure?",
    answer: "Una piattaforma completa: pre-filtro, doppie soglie (approvazione automatica / revisione umana / rifiuto automatico), regole senza codice, una console di moderazione con ruoli per il team e un registro di audit pronto per il DSA, con report esportabili."
  },
  {
    question: "I miei dati possono restare in Europa invece che nel cloud di Microsoft?",
    answer: "Sì. Il cloud di OpenModeration è ospitato nell'UE, ai fini di GDPR e DSA, con Azure sempre disponibile come uno dei fornitori. Un'installazione on-premise è possibile su richiesta: parliamone."
  },
];

const comparisonPoints = [
  { feature: "Ambito della moderazione", azure: "Fornitore singolo (solo Azure)", openmod: "Multi-fornitore (Azure, OpenAI, Mistral, LLM) + console unificata" },
  { feature: "Interfaccia operativa", azure: "Solo API. La UI di revisione devi costruirla tu", openmod: "Console Trust & Safety completa, con coda di revisione manuale inclusa" },
  { feature: "Motore di regole", azure: "La logica personalizzata va costruita e mantenuta internamente", openmod: "Tre livelli integrati: filtri di parole, soglie di punteggio e un regolamento della community in linguaggio naturale" },
  { feature: "Dipendenza dal fornitore", azure: "Alta (legata all'ecosistema Microsoft)", openmod: "Nessuna (le tue chiavi, cambi fornitore all'istante)" },
  { feature: "Sovranità dei dati", azure: "Dati elaborati sull'infrastruttura Microsoft", openmod: "Hosting nell'UE per la conformità a GDPR e DSA; on-premise su richiesta" },
  { feature: "Modello di prezzo", azure: "Fatturazione API a richiesta", openmod: "Prezzi pubblici: gratis fino a 1.000 richieste al mese, poi Pro a 99 €/mese." }
];
---

<BaseLayout
  title="Alternativa all'API di moderazione di Azure: prezzi e confronto"
  description="Azure Content Safety è solo un'API e ti lega a Microsoft. OpenModeration unisce Azure e altri 9 fornitori, regole senza codice, revisione umana e audit DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Alternative", href: "/it/alternative" }, { label: "Alternativa ad Azure Content Safety" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Alternativa all'API di moderazione di Azure</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Azure Content Safety è un'API.<br/>OpenModeration è la piattaforma.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Azure Content Safety offre API di moderazione con IA molto potenti, ma costruire un flusso di moderazione completo richiede un notevole lavoro di sviluppo. OpenModeration ti dà l'API <strong>e</strong> tutto il sistema operativo che ci sta intorno.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Prova OpenModeration gratis</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Vedi il confronto completo</a>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Migra da Azure in meno di un'ora</h2>
          <p class="mt-4 text-lg text-surface-500">
            Tieni la tua chiave Azure (BYOK) come fornitore principale. Un'unica chiamata standardizzata sostituisce
            l'endpoint Content Safety: i punteggi arrivano in un solo formato, con soglie che controlli tu.
          </p>
          <ul class="mt-6 space-y-3">
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Tieni Azure</strong> come fornitore principale e aggiungi OpenAI o Mistral come fallback quando Azure è lento o non disponibile.</p>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Il pre-filtro</strong> blocca lo spam evidente prima di qualsiasi chiamata Azure fatturabile: risparmi dal 10 al 30% sui costi API.</p>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Dati ospitati nell'UE</strong> con il cloud gestito, on-premise possibile su richiesta (<a href="https://calendly.com/pierre-logora/60min" class="text-brand-600 underline">parliamone</a>): Azure resta disponibile come uno dei fornitori.</p>
            </li>
          </ul>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-4xl">
        <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">Confronto diretto</h2>
        <div class="mt-8 overflow-hidden rounded-xl border border-surface-200">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="bg-surface-50">
                <th class="px-6 py-4 font-semibold text-surface-900">Funzionalità</th>
                <th class="px-6 py-4 font-semibold text-surface-500">Azure Content Safety</th>
                <th class="px-6 py-4 font-semibold text-brand-700">OpenModeration</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-surface-200 bg-white">
              {comparisonPoints.map((row) => (
                <tr>
                  <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                  <td class="px-6 py-4 text-surface-600">{row.azure}</td>
                  <td class="px-6 py-4 font-medium text-accent-600">{row.openmod}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8">
          <h3 class="text-xl font-bold text-surface-900">Il costo nascosto della moderazione "solo API"</h3>
          <p class="mt-4 text-surface-600">
            Integrare Azure Content Safety è solo il primo passo. Per renderla operativa, il tuo team di sviluppo deve ancora costruire:
          </p>
          <ul class="mt-4 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Una console in cui i moderatori possano rivedere i casi dubbi</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Un motore di regole che traduca i punteggi dell'IA in azioni automatiche (nascondere, eliminare, segnalare)</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Sistemi di log di audit per dimostrare ai regolatori la conformità al DSA</li>
            <li class="flex items-start gap-2"><span class="text-red-500">✕</span> Una logica di fallback per quando le API di Azure non sono disponibili</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="text-xl font-bold text-brand-700">Il vantaggio di OpenModeration</h3>
          <p class="mt-4 text-surface-700">
            OpenModeration può usare Azure Content Safety come uno dei suoi fornitori di backend, ma lo inserisce in un livello operativo completo:
          </p>
          <ul class="mt-4 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> <strong>Console pronta all'uso:</strong> il tuo team Trust &amp; Safety può iniziare subito a rivedere i contenuti.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> <strong>Configurazione semplice delle regole:</strong> tre strumenti, cioè parole vietate, soglie per categoria e il regolamento della tua community. Nessun codice necessario.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> <strong>Fallback multi-fornitore:</strong> se Azure è lento o va in errore, le richieste passano in automatico a OpenAI o Mistral.</li>
            <li class="flex items-start gap-2"><span class="text-accent-500">✓</span> <strong>Conformità integrata:</strong> ogni decisione, dell'IA o umana, viene registrata con un registro di audit completo.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Alternativa ad Azure Content Safety: domande frequenti" />
    </div>
  </section>

  <CTASection
    title="Smetti di costruire strumenti di moderazione interni."
    subtitle="Ottieni una piattaforma di moderazione con IA completa, con integrazione Azure, regole automatiche e una console di revisione umana. Provala oggi."
    buttonText="Provalo gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />

  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Confronta altri fornitori</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/it/alternative/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/it/alternative/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/it/api-moderazione-testo" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">API di moderazione del testo</a>
        <a href="/it/alternative/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/it/alternative/hive-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Hive Moderation</a>
        <a href="/it/alternative/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>
</BaseLayout>
