---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CTASection from '../../../components/CTASection.astro';
import RelatedComparisons from '../../../components/RelatedComparisons.astro';
import CodeBlock from '../../../components/CodeBlock.astro';

const migrationCode = `# Prima: Hive Moderation (diretto)
const response = await fetch('https://api.thehive.ai/api/v2/task/sync', {
  method: 'POST',
  headers: { 'Authorization': 'Token YOUR_HIVE_KEY' },
  body: JSON.stringify({ url: '...', text: { text: content } })
});

# Dopo: OpenModeration
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text })
});
// In più: pre-filtro, doppia soglia, azioni automatiche, registro di audit, IA verificata`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa a Hive Moderation | OpenModeration",
  "description": "Hive Moderation offre un'ottima moderazione di immagini e testo, ma ti vincola ai suoi modelli proprietari. OpenModeration usa la propria IA di moderazione, verificata da altri modelli di IA, con flussi automatizzati e conformità DSA integrata.",
  "inLanguage": "it",
};

const comparisonPoints = [
  { feature: "Motore di IA", hive: "Solo Hive (modelli proprietari)", openmod: "La nostra IA di moderazione, verificata da altri modelli di IA sui casi delicati" },
  { feature: "Tipi di contenuto", hive: "Testo, immagini, video (forte nella moderazione visiva)", openmod: "Moderazione del testo con 10 categorie, più le tue categorie in linguaggio naturale." },
  { feature: "Pre-filtro", hive: "Non disponibile", openmod: "Filtro di parole integrato che blocca spam evidente e parole vietate prima di qualsiasi chiamata API" },
  { feature: "Motore decisionale", hive: "Punteggi di classificazione grezzi", openmod: "Doppia soglia, con la zona grigia rivista dal nostro team" },
  { feature: "Azioni automatiche", hive: "Integrazione da costruire da zero", openmod: "Il motore di azioni integrato nasconde, elimina, segnala o notifica quando le soglie vengono superate." },
  { feature: "Console", hive: "Console API di base", openmod: "Console completa: ogni decisione in tempo reale, ruoli del team, statistiche" },
  { feature: "Formato API", hive: "Formato proprietario di Hive", openmod: "Formato standardizzato. Quando colleghiamo un modello migliore, nel tuo codice non cambia nulla." },
  { feature: "Dipendenza", hive: "Vincolato ai modelli proprietari di Hive", openmod: "Bassa. Motore indipendente dai modelli: i modelli migliori collegati appena escono." },
  { feature: "Registro di audit", hive: "Log delle richieste API", openmod: "Registro di audit DSA completo: ogni decisione dell'IA e umana registrata, report esportabili" },
  { feature: "Prezzi", hive: "In base all'utilizzo, prezzo su richiesta", openmod: "Gratis fino a 1.000 richieste al mese. Cloud gestito da 99 €/mese (10.000 richieste incluse)." },
];

const reasons = [
  {
    title: "Hive eccelle nella moderazione visiva, ma il volume di testo cresce più in fretta",
    description: "Hive è noto per la moderazione di immagini e video. Oggi però LLM e chatbot generano enormi quantità di testo, e il testo merita la stessa attenzione delle immagini. OpenModeration si concentra sul testo, con la propria IA di moderazione verificata da altri modelli di IA sui casi delicati."
  },
  {
    title: "Un solo modello fermo significa nessun secondo parere",
    description: "Con un solo modello proprietario, ogni decisione dipende da un unico classificatore, fermo tra un aggiornamento e l'altro. OpenModeration fa arbitrare i casi delicati da altri modelli di IA e collega i modelli migliori o più economici appena escono, senza nulla da cambiare da parte tua."
  },
  {
    title: "Modelli proprietari significa zero trasparenza",
    description: "I modelli di Hive sono scatole nere. Non puoi verificarli, affinarli né ispezionare i dati di addestramento. OpenModeration spiega ogni decisione per iscritto, così vedi perché ogni commento è stato mantenuto o nascosto."
  },
  {
    title: "La conformità al DSA richiede più dei punteggi di un'API",
    description: "Il Digital Services Act europeo richiede decisioni di moderazione documentate, meccanismi di revisione umana e relazioni di trasparenza. OpenModeration ti dà registri di audit, revisione umana da parte del nostro team e report esportabili, mentre un'API si ferma ai log delle chiamate."
  },
];
---

<BaseLayout
  title="Alternativa a Hive Moderation per commenti e pagine social"
  description="Hive è forte nella moderazione visiva. OpenModeration usa la propria IA per i commenti, verificata da altri modelli, con regole, revisione umana e audit DSA."
  jsonLd={comparisonJsonLd}
>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Alternative", href: "/it/alternative" }, { label: "Alternativa a Hive Moderation" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1.5 text-sm font-medium text-amber-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Alternativa a Hive Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Hive è forte sui contenuti visivi.<br/>Per moderare il testo ti serve una piattaforma.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Hive Moderation eccelle nella classificazione di immagini e video. Il testo però arriva da ogni parte:
        LLM, chatbot, forum, commenti. OpenModeration ti dà la propria IA di moderazione, verificata da altri
        modelli di IA, con regole automatiche, revisione umana da parte del nostro team e conformità DSA integrate.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Prova OpenModeration gratis</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Vedi il confronto</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché i team guardano oltre Hive</h2>
        <p class="mt-4 text-lg text-surface-500">Hive è un buon motore di moderazione. Per moderare testo in produzione, però, servono più di un modello e più dei punteggi grezzi.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Un'API, un'IA che continua a migliorare
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Un solo formato API invece di tanti</h2>
          <p class="mt-4 text-lg text-surface-500">
            Usare Hive per la moderazione visiva e un'altra API per il testo ti lascia due integrazioni da mantenere.
            Per il testo, OpenModeration ti dà un unico formato API standardizzato, basato sulla propria
            IA di moderazione.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>IA verificata:</strong> i casi delicati vengono verificati da altri modelli di IA prima che una decisione venga applicata.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Nessun modello fermo:</strong> quando esce un modello migliore o più economico, lo colleghiamo. Per te non cambia nulla.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Nessuna scatola nera:</strong> ogni decisione è motivata per iscritto, e la vedi in tempo reale.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Hive Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Hive è un ottimo fornitore di moderazione. OpenModeration è una piattaforma completa per la moderazione dei commenti.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funzionalità</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Hive Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.hive}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Confronta altre alternative</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/it/alternative/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/it/alternative/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/it/alternative/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/it/alternative/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/it/alternative/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <RelatedComparisons />

  <CTASection
    title="Moderazione dei commenti con un'IA che continua a migliorare."
    subtitle="La nostra IA verificata e la revisione umana del nostro team, tramite un'unica API standardizzata. Ospitato nell'UE, spiega ogni decisione ed è pronto per il DSA."
    buttonText="Prova OpenModeration gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
