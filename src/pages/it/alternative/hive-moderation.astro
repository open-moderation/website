---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import CodeBlock from '../../../components/CodeBlock.astro';

const migrationCode = `# Prima: Hive Moderation (diretto)
const response = await fetch('https://api.thehive.ai/api/v2/task/sync', {
  method: 'POST',
  headers: { 'Authorization': 'Token YOUR_HIVE_KEY' },
  body: JSON.stringify({ url: '...', text: { text: content } })
});

# Dopo: OpenModeration con Hive
const result = await fetch('https://api.openmoderation.com/v1/moderation', {
  method: 'POST',
  headers: { 'Authorization': 'Bearer om_key_...' },
  body: JSON.stringify({ input: text, model: 'hive/moderation' })
});
// Aggiungi OpenAI, Azure o Mistral come fallback, con la stessa chiamata API`;

const comparisonJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Alternativa a Hive Moderation | OpenModeration",
  "description": "Hive Moderation offre un'ottima moderazione di immagini e testo, ma ti vincola a un solo fornitore. OpenModeration combina Hive con OpenAI, Azure, Mistral e altri tramite un'unica API, con flussi automatizzati e conformità DSA integrata.",
  "inLanguage": "it",
};

const comparisonPoints = [
  { feature: "Fornitori", hive: "Solo Hive (modelli proprietari)", openmod: "10 fornitori: Hive, OpenAI, Azure, Mistral, HuggingFace, LLM (GPT-4o, Claude), Cohere e altri" },
  { feature: "Tipi di contenuto", hive: "Testo, immagini, video (forte nella moderazione visiva)", openmod: "Moderazione del testo con 10 categorie. Instradamento multi-fornitore per lingua e categoria." },
  { feature: "Pre-filtro", hive: "Non disponibile", openmod: "Filtro di parole integrato che blocca spam evidente e parole vietate prima di qualsiasi chiamata API" },
  { feature: "Motore decisionale", hive: "Punteggi di classificazione grezzi", openmod: "Doppia soglia, con la zona grigia indirizzata alla revisione umana" },
  { feature: "Azioni automatiche", hive: "Integrazione da costruire da zero", openmod: "Il motore di azioni integrato nasconde, elimina, segnala o notifica quando le soglie vengono superate." },
  { feature: "Console", hive: "Console API di base", openmod: "Console di moderazione completa: coda di revisione, ruoli del team, statistiche, stato dei fornitori" },
  { feature: "Formato API", hive: "Formato proprietario di Hive", openmod: "Standardizzato su tutti i 10 fornitori. Cambi fornitore modificando la configurazione." },
  { feature: "Dipendenza dal fornitore", hive: "Vincolato ai modelli proprietari di Hive", openmod: "Nessuna. BYOK supportato per tutti i fornitori. Self-hosting possibile." },
  { feature: "Self-hosting", hive: "Solo API in cloud", openmod: "Self-hosting con Docker (gratuito, AGPL v3) o cloud gestito in UE" },
  { feature: "Registro di audit", hive: "Log delle richieste API", openmod: "Registro di audit DSA completo: ogni decisione dell'IA e umana registrata, report esportabili" },
  { feature: "Prezzi", hive: "In base all'utilizzo, prezzo su richiesta", openmod: "Gratuito in self-hosting. Cloud gestito da 99 €/mese (10.000 richieste incluse)." },
];

const reasons = [
  {
    title: "Hive eccelle nella moderazione visiva, ma il volume di testo cresce più in fretta",
    description: "Hive è noto per la moderazione di immagini e video. Oggi però LLM e chatbot generano enormi quantità di testo, e ti serve una piattaforma che gestisca testo e contenuti visivi con la stessa efficacia. OpenModeration indirizza il testo al miglior fornitore NLP e può integrare Hive per i casi d'uso visivi."
  },
  {
    title: "Un solo fornitore significa un solo punto di guasto",
    description: "Se l'API di Hive subisce un'interruzione, un picco di latenza o un cambio di prezzo, tutta la tua pipeline di moderazione ne risente. OpenModeration ti offre un fallback automatico su 10 fornitori: se Hive è lento, le tue richieste passano in automatico a OpenAI, Azure o Mistral."
  },
  {
    title: "Modelli proprietari significa zero trasparenza",
    description: "I modelli di Hive sono scatole nere. Non puoi verificarli, affinarli né ispezionare i dati di addestramento. OpenModeration ti dà accesso a modelli open source (HuggingFace Llama Guard) accanto a quelli proprietari, e la piattaforma stessa è interamente open source con licenza AGPL v3."
  },
  {
    title: "La conformità al DSA richiede più dei punteggi di un'API",
    description: "Il Digital Services Act europeo richiede decisioni di moderazione documentate, meccanismi di revisione umana e relazioni di trasparenza. OpenModeration fornisce l'intero corredo per la conformità (registri di audit, flussi di revisione e report esportabili), mentre un'API si ferma ai log delle chiamate."
  },
];
---

<BaseLayout
  title="Alternativa a Hive Moderation: un'API, 10 fornitori"
  description="Hive è forte nella moderazione visiva. OpenModeration combina Hive con altri 9 fornitori per il testo, più regole automatiche, revisione umana e registro di audit DSA."
  jsonLd={comparisonJsonLd}
>
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1.5 text-sm font-medium text-amber-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Alternativa a Hive Moderation
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
        Hive è forte sui contenuti visivi.<br/>Per moderare il testo ti serve una piattaforma.
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Hive Moderation eccelle nella classificazione di immagini e video. Il testo però arriva da ogni parte:
        LLM, chatbot, forum, commenti. OpenModeration ti dà 10 fornitori di moderazione
        del testo tramite un'unica API, con regole automatiche, revisione umana e conformità DSA integrate.
      </p>
      <div class="mt-8 flex items-center justify-center gap-4">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">Prova OpenModeration gratis</a>
        <a href="#comparison" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">Vedi il confronto</a>
      </div>
    </div>
  </section>

  <!-- Why switch -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché i team guardano oltre Hive</h2>
        <p class="mt-4 text-lg text-surface-500">Hive è un buon motore di moderazione. Per moderare testo in produzione su larga scala, però, servono più modelli e qualcosa che trasformi i punteggi in decisioni.</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {reasons.map((r) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{r.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code comparison -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
            <span class="flex h-1.5 w-1.5 animate-pulse-dot rounded-full bg-brand-500" />
            Un'API, qualsiasi fornitore
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Standardizza, non frammentare.</h2>
          <p class="mt-4 text-lg text-surface-500">
            Integrare Hive per la moderazione visiva e un'altra API per il testo frammenta il tuo stack.
            OpenModeration unifica tutto in un unico formato API standard: usa Hive, OpenAI, Azure,
            Mistral, HuggingFace o qualsiasi combinazione.
          </p>
          <div class="mt-6 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Aggiungi ridondanza:</strong> fallback automatico su OpenAI o Mistral se Hive non è disponibile.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Confronta in modo oggettivo:</strong> scopri quale fornitore è il più veloce, il più preciso e il più economico per ogni lingua.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Nessuna scatola nera:</strong> usa modelli open source (Llama Guard) accanto a Hive. Trasparenza totale.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-4 shadow-sm">
          <CodeBlock code={migrationCode} lang="javascript" />
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="comparison" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Hive Moderation vs OpenModeration</h2>
        <p class="mt-4 text-lg text-surface-500">Hive è un ottimo fornitore di moderazione. OpenModeration è la piattaforma che orchestra Hive e altri 9 fornitori.</p>
      </div>
      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-50">
              <th class="px-6 py-4 font-semibold text-surface-900">Funzionalità</th>
              <th class="px-6 py-4 font-semibold text-surface-500">Hive Moderation</th>
              <th class="px-6 py-4 font-semibold text-brand-600">OpenModeration</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200">
            {comparisonPoints.map((row) => (
              <tr class="even:bg-surface-50">
                <td class="px-6 py-4 font-medium text-surface-900">{row.feature}</td>
                <td class="px-6 py-4 text-surface-500">{row.hive}</td>
                <td class="px-6 py-4 text-surface-900">{row.openmod}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Other alternatives -->
  <section class="border-t border-surface-100 bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">Confronta altri fornitori</h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/it/alternative/openai-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">OpenAI Moderation</a>
        <a href="/it/alternative/azure-content-safety" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Azure Content Safety</a>
        <a href="/it/alternative/mistral-moderation" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Mistral Moderation</a>
        <a href="/it/alternative/perspective-api" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Perspective API</a>
        <a href="/it/alternative/checkstep" class="rounded-full border border-surface-200 bg-white px-4 py-2 text-sm text-surface-600 transition hover:border-brand-300 hover:text-brand-600">Checkstep</a>
      </div>
    </div>
  </section>

  <CTASection
    title="Unisci Hive e altri 9 fornitori in un'unica chiamata API."
    subtitle="Combina la moderazione visiva di Hive con OpenAI, Azure e Mistral per il testo, tutto tramite un'unica API standard. Open source, ospitabile in proprio, pronto per il DSA."
    buttonText="Prova OpenModeration gratis"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>
