---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'it';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Console di moderazione: ogni decisione e il suo motivo, live",
  "description": "Vedi ogni commento, la sua decisione e il motivo scritto in tempo reale, sul sito e sui social. Il nostro team gestisce i casi dubbi; tu correggi quando vuoi.",
  "crumb": "Console di moderazione",
  "badge": "Cosa vedi in tempo reale",
  "h1": "Ogni decisione e il suo motivo, in tempo reale",
  "lead": "La console non è uno strumento che devi gestire. La nostra IA e il nostro team moderano; tu vedi ogni commento, la decisione, il motivo scritto e chi l’ha presa, e puoi correggere quando vuoi.",
  "feedTitle": "La tua moderazione, in diretta",
  "feedLead": "I commenti del tuo sito e delle tue pagine, uno accanto all’altro, ciascuno con la sua decisione e il motivo che la giustifica.",
  "quote": [
    "«",
    "»"
  ],
  "reasonLabel": "Motivo:",
  "overrideLabel": "Correggi",
  "feed": [
    {
      "platform": "Sito",
      "kind": "published",
      "decision": "Pubblicato",
      "by": "La nostra IA",
      "text": "Bell’articolo, ma i dati del secondo paragrafo sembrano vecchi.",
      "reason": "Critica costruttiva, nessuna regola violata."
    },
    {
      "platform": "Facebook",
      "kind": "refused",
      "decision": "Nascosto",
      "by": "La nostra IA, verificata",
      "text": "Siete tutti corrotti, bisognerebbe farvi tacere per sempre.",
      "reason": "Minaccia e attacco personale."
    },
    {
      "platform": "Instagram",
      "kind": "refused",
      "decision": "Nascosto",
      "by": "La nostra IA",
      "text": "Follower a poco prezzo qui, guardate il mio profilo!!!",
      "reason": "Spam."
    },
    {
      "platform": "YouTube",
      "kind": "team",
      "decision": "Rifiutato dopo revisione",
      "by": "Il nostro team",
      "text": "Tipico di quella gente, non cambieranno mai.",
      "reason": "Generalizzazione contro un gruppo, contraria al tuo regolamento."
    }
  ],
  "shotAlt": "Console OpenModeration: commenti, decisioni e motivi scritti, piattaforma per piattaforma",
  "shotCaption": "La console: commenti, decisioni e motivi, piattaforma per piattaforma.",
  "illustrative": "Esempi e dati illustrativi, da uno spazio dimostrativo.",
  "kpis": [
    {
      "label": "Commenti analizzati oggi",
      "value": "84.200"
    },
    {
      "label": "Nascosti, ciascuno con un motivo scritto",
      "value": "4,7%"
    },
    {
      "label": "Casi dubbi gestiti dal nostro team",
      "value": "2%"
    }
  ],
  "cardsTitle": "Cosa vedi e cosa puoi fare",
  "cardsLead": "Trasparenza totale, niente da gestire. Intervieni solo se vuoi.",
  "cards": [
    {
      "title": "Ogni decisione, con il suo motivo",
      "text": "Ogni commento, la decisione presa e il motivo scritto, sul tuo sito e su ogni pagina collegata."
    },
    {
      "title": "I casi dubbi li gestisce il nostro team",
      "text": "Quando l’IA è in dubbio, il nostro team decide secondo le tue regole. Vedi cosa ha gestito e perché."
    },
    {
      "title": "Correggi in ogni momento",
      "text": "Pubblica, nascondi o ripristina un commento con un clic. Ogni modifica è registrata con il suo autore."
    },
    {
      "title": "Segnalazioni e reclami seguiti",
      "text": "Le segnalazioni degli utenti e le decisioni contestate sono seguite fino alla risposta, come richiede il DSA."
    },
    {
      "title": "Dati esportabili",
      "text": "Volumi e decisioni per categoria, piattaforma per piattaforma. Esportali per i report DSA e i bilanci interni."
    },
    {
      "title": "Le tue regole, sotto gli occhi",
      "text": "Vedi le regole applicate ai tuoi spazi. Per cambiarle, diccelo o modificale tu: il nostro team ti aiuta."
    }
  ],
  "devTitle": "Per i team tecnici",
  "devLead": "La console offre anche ai tuoi sviluppatori il necessario per integrare e monitorare OpenModeration.",
  "devPoints": [
    "Chiavi di accesso, con limiti di utilizzo e permessi per chiave",
    "Storico delle attività consultabile per commento: punteggi, regola applicata e risultato",
    "Stato dei servizi, con latenza e tassi di errore",
    "Conservazione dei dati, origini autorizzate e webhook"
  ]
};

const decisionStyles: Record<string, string> = {
  published: 'bg-green-100 text-green-700',
  refused: 'bg-red-100 text-red-700',
  team: 'bg-amber-100 text-amber-700',
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/it/console-di-moderazione",
  "url": "https://www.openmoderation.com/it/console-di-moderazione",
  "name": "Console di moderazione: ogni decisione e il suo motivo, live",
  "description": "Vedi ogni commento, la sua decisione e il motivo scritto in tempo reale, sul sito e sui social. Il nostro team gestisce i casi dubbi; tu correggi quando vuoi.",
  "inLanguage": "it",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-accent-500"></span> {c.badge}
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <!-- What you see: live feed -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.feedTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.feedLead}</p>
      </div>
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <ul class="divide-y divide-surface-100 overflow-hidden rounded-2xl border border-surface-200 bg-white shadow-sm">
          {c.feed.map((f) => (
            <li class="p-5">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="rounded-full bg-surface-100 px-2.5 py-0.5 text-surface-600">{f.platform}</span>
                <span class={`rounded-full px-2.5 py-0.5 font-semibold ${decisionStyles[f.kind]}`}>{f.decision}</span>
                <span class="text-surface-400">{f.by}</span>
              </div>
              <p class="mt-3 text-surface-800">{c.quote[0]}{f.text}{c.quote[1]}</p>
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
                <p class="text-surface-500"><span class="font-medium text-surface-700">{c.reasonLabel}</span> {f.reason}</p>
                <span class="rounded-md border border-surface-300 px-3 py-1 text-xs font-semibold text-surface-700">{c.overrideLabel}</span>
              </div>
            </li>
          ))}
        </ul>
        <div>
          <BrowserFrame src="/images/dashboard.png" video="om-triage" alt={c.shotAlt} caption={c.shotCaption} eager={false} />
          <p class="mt-6 text-center text-xs text-surface-400">{c.illustrative}</p>
        </div>
      </div>
      <dl class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {c.kpis.map((k) => (
          <div class="flex flex-col-reverse rounded-xl border border-surface-200 bg-surface-50 p-6">
            <dt class="mt-1 text-sm text-surface-500">{k.label}</dt>
            <dd class="text-3xl font-bold text-surface-900">{k.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- What you see and what you can do -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{c.cardsTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{c.cardsLead}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {c.cards.map((card) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6">
            <h3 class="font-semibold text-surface-900">{card.title}</h3>
            <p class="mt-1 text-sm text-surface-500">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For technical teams -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.devTitle}</h2>
      <p class="mt-3 text-surface-500">{c.devLead}</p>
      <ul class="mt-6 space-y-2 text-sm text-surface-600">
        {c.devPoints.map((p) => (
          <li class="flex items-start gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
