---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/it/console-di-moderazione",
  "url": "https://www.openmoderation.com/it/console-di-moderazione",
  "name": "Console di moderazione dei contenuti | OpenModeration",
  "description": "Vedi ogni decisione di moderazione in tempo reale, con la sua motivazione scritta. I casi dubbi li gestisce il nostro team; tu puoi intervenire quando vuoi.",
  "inLanguage": "it",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};
---

<BaseLayout title="Console di moderazione: una coda per tutte le piattaforme" description="Una console unica per sito, Facebook, Instagram e YouTube: vedi ogni decisione in tempo reale con la sua motivazione e intervieni quando vuoi." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Console di moderazione" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        Spazio di lavoro dimostrativo
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">La console di moderazione dei contenuti per tutto il tuo team</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Vedi ogni decisione in tempo reale: l'automazione modera, il nostro team gestisce i casi dubbi e tu puoi intervenire o annullare una decisione in un clic, quando vuoi. Ogni decisione è accompagnata da una motivazione scritta, difendibile davanti a chiunque.
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-sm text-surface-400">
        Dati illustrativi provenienti da uno spazio di lavoro dimostrativo.
      </p>
    </div>
  </section>

  <!-- Dashboard Preview -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-4 grid-cols-2 md:grid-cols-4">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <p class="text-sm text-surface-500">Richieste di oggi</p>
          <p class="mt-1 text-3xl font-bold text-surface-900">84.200</p>
          <p class="mt-1 text-xs text-accent-600">+12% rispetto a ieri</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <p class="text-sm text-surface-500">Tasso di segnalazione</p>
          <p class="mt-1 text-3xl font-bold text-surface-900">4,7%</p>
          <p class="mt-1 text-xs text-surface-500">3.957 elementi segnalati</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <p class="text-sm text-surface-500">Latenza media</p>
          <p class="mt-1 text-3xl font-bold text-surface-900">267 ms</p>
          <p class="mt-1 text-xs text-accent-600">P99: 890 ms</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <p class="text-sm text-surface-500">Stato del servizio</p>
          <p class="mt-1 text-3xl font-bold text-surface-900">Attivo</p>
          <p class="mt-1 text-xs text-surface-500">Tutti operativi</p>
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="mb-4 font-semibold text-surface-900">Utilizzo nel tempo</h3>
          <div class="flex items-end gap-2" style="height: 160px;">
            <div class="flex-1 rounded-t bg-brand-200" style="height: 60%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 45%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 75%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 55%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 80%"></div>
            <div class="flex-1 rounded-t bg-brand-300" style="height: 70%"></div>
            <div class="flex-1 rounded-t bg-brand-400" style="height: 90%"></div>
            <div class="flex-1 rounded-t bg-brand-300" style="height: 65%"></div>
            <div class="flex-1 rounded-t bg-brand-200" style="height: 85%"></div>
            <div class="flex-1 rounded-t bg-brand-300" style="height: 95%"></div>
            <div class="flex-1 rounded-t bg-brand-400" style="height: 78%"></div>
            <div class="flex-1 rounded-t bg-brand-500" style="height: 88%"></div>
            <div class="flex-1 rounded-t bg-brand-400" style="height: 72%"></div>
            <div class="flex-1 rounded-t bg-brand-300" style="height: 82%"></div>
          </div>
          <div class="mt-2 flex justify-between text-xs text-surface-400">
            <span>1 giu</span>
            <span>15 giu</span>
            <span>30 giu</span>
          </div>
        </div>

        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="mb-4 font-semibold text-surface-900">Volume per canale</h3>
          <div class="space-y-4">
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="text-surface-600">Sito web</span><span class="text-surface-500">12.400 &middot; 3,1% segnalati</span></div>
              <div class="h-2 rounded-full bg-surface-200"><div class="h-2 w-4/5 rounded-full bg-brand-500"></div></div>
            </div>
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="text-surface-600">Facebook</span><span class="text-surface-500">8.700 &middot; 5,4% segnalati</span></div>
              <div class="h-2 rounded-full bg-surface-200"><div class="h-2 w-3/5 rounded-full bg-brand-400"></div></div>
            </div>
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="text-surface-600">Instagram</span><span class="text-surface-500">5.200 &middot; 4,2% segnalati</span></div>
              <div class="h-2 rounded-full bg-surface-200"><div class="h-2 w-2/5 rounded-full bg-brand-300"></div></div>
            </div>
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="text-surface-600">YouTube</span><span class="text-surface-500">2.900 &middot; 6,8% segnalati</span></div>
              <div class="h-2 rounded-full bg-surface-200"><div class="h-2 w-1/3 rounded-full bg-brand-300"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dashboard Features -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Tutto a portata di mano</h2>
        <p class="mt-4 text-lg text-surface-500">Gestisci tutte le tue attività di moderazione da un unico posto.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7h3a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h3m0-4h6v4H9V3z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Gestione degli accessi</h3>
          <p class="mt-1 text-sm text-surface-500">Decidi chi può fare cosa. Crea e revoca chiavi di accesso e imposta limiti di frequenza.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Cronologia delle attività</h3>
          <p class="mt-1 text-sm text-surface-500">Segui ogni decisione di moderazione. Cerca ed esamina tutte le richieste con punteggio ed esito.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Stato dei servizi</h3>
          <p class="mt-1 text-sm text-surface-500">Vedi quali servizi sono operativi, con il monitoraggio in tempo reale di latenza e tassi di errore.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Report sulle prestazioni</h3>
          <p class="mt-1 text-sm text-surface-500">Capisci volumi e tendenze della moderazione. Segui i tassi di segnalazione, le azioni intraprese e i costi, con report esportabili per gli audit.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Policy e integrazioni</h3>
          <p class="mt-1 text-sm text-surface-500">Gestisci le impostazioni di moderazione e i collegamenti con le piattaforme. Configura azioni automatiche e soglie direttamente dalla console.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="font-semibold text-surface-900">Configurazione</h3>
          <p class="mt-1 text-sm text-surface-500">Impostazioni dell'istanza per limiti di frequenza, conservazione dei dati, origini consentite.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
