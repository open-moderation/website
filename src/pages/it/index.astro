---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModerationDemo from '../../components/ModerationDemo.astro';
import { bookingUrl, useTranslations } from '../../i18n/ui';
import { getLocale, localizePath } from '../../i18n/routes';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import KpiBand from '../../components/KpiBand.astro';
import HeroAnimation from '../../components/HeroAnimation.astro';
import ValueCards from '../../components/ValueCards.astro';
import AppVideo from '../../components/AppVideo.astro';
import AIEngine from '../../components/AIEngine.astro';
import SwitchProvider from '../../components/SwitchProvider.astro';
import CostCalculator from '../../components/CostCalculator.astro';
import TeamSection from '../../components/TeamSection.astro';
import PricingTeaser from '../../components/PricingTeaser.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.openmoderation.com/#organization",
      "name": "OpenModeration",
      "url": "https://www.openmoderation.com",
      "logo": "https://www.openmoderation.com/logo.svg",
      "description": "AI comment moderation adapted to each client's rules and use cases, with a team that sets it up. DSA-compliant, hosted in the EU.",
      "email": "contact@openmoderation.com",
      "areaServed": "EU",
      "knowsAbout": ["Comment moderation", "Content moderation", "Social media moderation", "Digital Services Act compliance", "Trust and safety"],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "contact@openmoderation.com",
        "url": "https://www.openmoderation.com/book-a-call",
        "availableLanguage": ["English", "French", "Spanish", "German", "Italian"]
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Logora",
        "url": "https://logora.com"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.openmoderation.com/#website",
      "url": "https://www.openmoderation.com",
      "name": "OpenModeration",
      "publisher": { "@id": "https://www.openmoderation.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://www.openmoderation.com/#software",
      "name": "OpenModeration",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Moderazione dei commenti con IA per testate, brand e pagine social, adattata alle tue regole e ai tuoi casi d'uso. Funziona sul tuo sito, Facebook, Instagram, YouTube e WordPress, affida i casi dubbi al nostro team, motiva ogni decisione per iscritto e te la mostra in tempo reale, ed è conforme al DSA. Tu colleghi le tue pagine, al resto pensiamo noi.",
      "inLanguage": "it",
      "url": "https://www.openmoderation.com/it",
      "offers": {
        "@type": "Offer", "price": "0", "priceCurrency": "EUR",
        "priceValidUntil": "2027-12-31", "availability": "https://schema.org/InStock"
      },
      "author": { "@id": "https://www.openmoderation.com/#organization" }
    }
  ]
};

const kpiItems = [
  { label: "Commenti moderati ogni giorno", value: "10 M+" },
  { label: "Pronto in", value: "5 min" },
  { label: "Moderazione automatica", value: "24/7" },
  { label: "Decisioni motivate per iscritto", value: "100%" },
];

const valueItems = [
  { title: "Le tue regole, i tuoi casi d'uso", text: "Non una lista di parole: le tue regole, lette nel loro contesto. Adattiamo la moderazione a ciò che conta per te: ironia, politica, concorrenti, gergo locale. Niente di generico." },
  { title: "Un team dietro lo strumento", text: "Ti aiutiamo a scrivere e affinare le tue regole, gestiamo noi i casi dubbi e adattiamo tutto man mano che la tua community cambia. Hai sempre qualcuno con cui parlare." },
  { title: "Tutto funziona in automatico", text: "Basta collegare le tue pagine: ogni commento viene gestito in pochi secondi, giorno e notte, e il nostro team si occupa dei casi dubbi. Non devi fare nulla, ma vedi ogni decisione in tempo reale e puoi intervenire quando vuoi." },
  { title: "Molto più economico che a mano", text: "La moderazione automatica costa una frazione di un team di moderazione esterno o interno." },
];


const faqItems = [
  {
    question: "L'IA modera da sola?",
    answer: "No. La nostra IA è configurata sulle tue regole. Decide da sola quando è sicura, e ogni decisione viene verificata da altri modelli di IA. Quando c'è un dubbio, il commento passa al nostro team, che decide e ti riferisce cosa ha gestito.",
  },
  {
    question: "Come conosce l'IA la nostra linea editoriale?",
    answer: "Partiamo dalla tua policy e dai tuoi casi d'uso: cosa accetti, cosa rifiuti, i casi limite. Quando correggi una decisione, aggiustiamo le regole insieme a te. Non è una lista di parole vietate: l'IA legge ogni commento nel suo contesto.",
  },
  {
    question: "Posso provarlo prima di impegnarmi?",
    answer: "Sì. In modalità sandbox, OpenModeration analizza i tuoi commenti reali senza pubblicare né nascondere nulla. Vedi cosa avremmo accettato o rifiutato, con la motivazione, e lo confronti con la tua moderazione attuale.",
  },
  {
    question: "Posso provarlo senza lasciare il mio fornitore attuale?",
    answer: "Sì. La sandbox gira in parallelo, senza toccare la tua produzione. Confronti decisione per decisione e poi scegli con cognizione di causa, nel momento che ti conviene.",
  },
  {
    question: "Cosa vedo dal mio lato?",
    answer: "Tutto, in tempo reale: ogni commento, la decisione presa, la motivazione scritta e lo storico. Non devi fare nulla, ma puoi correggere una decisione o intervenire in qualsiasi momento.",
  },
  {
    question: "Perché un commento è stato rifiutato?",
    answer: "Ogni decisione ha una motivazione scritta (insulto, attacco personale, spam…) che puoi inoltrare all'autore. È più chiaro per i tuoi lettori e più semplice da giustificare in caso di contestazione.",
  },
  {
    question: "OpenModeration aiuta a rispettare il DSA?",
    answer: "È pensato per il DSA: una motivazione scritta per ogni decisione, uno storico tracciabile, le segnalazioni seguite e i reclami gestiti. Resti tu l'editore responsabile, e hai gli elementi per giustificare ogni decisione.",
  },
  {
    question: "Cosa succede quando l'IA è in dubbio?",
    answer: "Il commento viene messo da parte e il nostro team lo gestisce secondo le tue regole. Ricevi un resoconto dei casi gestiti e dei punti da chiarire nella tua policy.",
  },
  {
    question: "Su quali piattaforme funziona OpenModeration?",
    answer: "Il tuo sito, Facebook, Instagram, YouTube e WordPress in modo nativo, con connettori pronti che colleghi in pochi minuti. TikTok, X, LinkedIn e gli altri social si aggiungono facilmente su richiesta.",
  },
  {
    question: "Dove sono ospitati i nostri dati?",
    answer: "Nell'Unione europea. I commenti servono solo a moderare i tuoi spazi.",
  },
  {
    question: "Serve coinvolgere il nostro team tecnico?",
    answer: "Pochissimo. Per i social e WordPress basta collegare i tuoi account. Per un sito o uno strumento interno, un'API ti permette di inviare i commenti e ricevere ogni decisione con la sua motivazione.",
  },
  {
    question: "Quanto costa?",
    answer: "Il prezzo dipende dal volume di commenti da moderare. Ti proponiamo un pacchetto prevedibile dopo un test sui tuoi commenti, così valuti la qualità prima di parlare di budget.",
  },
];
---

<BaseLayout
  title="Moderazione dei commenti con IA, conforme al DSA | OpenModeration"
  description="Moderazione dei commenti con IA adattata alle tue regole e ai tuoi casi d'uso, sul tuo sito e sui social. Conforme al DSA, ospitata nell'UE, con il nostro team."
  jsonLd={homeJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-violet-50" />
    <div class="joy-blob pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-brand-300/40 blur-3xl" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute -right-24 top-10 h-[28rem] w-[28rem] rounded-full bg-violet-300/40 blur-3xl" style="animation-delay:-7s" aria-hidden="true"></div>
    <div class="joy-blob pointer-events-none absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-sun-300/30 blur-3xl" style="animation-delay:-12s" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-16 pt-10 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:px-8 lg:pt-16">
      <div class="text-center lg:text-left">
        <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Per testate, brand e pagine social
        </div>
        <h1 class="animate-fade-in-up text-4xl font-extrabold leading-[1.05] tracking-tight text-surface-900 sm:text-5xl lg:text-[3.7rem]">
          Una moderazione che si adatta alle <em>tue</em> regole.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-600 sm:text-xl">
          Tu colleghi le tue pagine, al resto pensiamo noi: configuriamo l'IA in base alle tue regole e ai tuoi casi d'uso, il nostro team gestisce i casi dubbi
          e tu vedi ogni decisione in tempo reale, per molto meno della moderazione manuale.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
          <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Prenota una call
          </a>
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Provalo gratis
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400"><a href="#demo" class="underline transition hover:text-surface-600">Oppure prova subito un commento, senza registrazione</a></p>
        <div class="animate-fade-in-up delay-2 mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-surface-500 lg:justify-start">
          <a href={localizePath('/dsa-compliance', locale)} class="flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-600">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t('footer.dsa')}
          </a>
          <span class="flex items-center gap-1.5">
            
            Sviluppato e ospitato nell'UE
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            Conforme al GDPR
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
            Supporto umano incluso
          </span>
        </div>
      </div>
      <HeroAnimation />
    </div>
    </div>
    <div class="animate-fade-in-up delay-3 relative pb-10">
      <ClientLogos />
    </div>
    <!-- KPI Band -->
    <div class="animate-fade-in-up delay-3 pb-12">
      <KpiBand items={kpiItems} />
      <p class="mx-auto mt-6 max-w-2xl px-4 text-center text-sm text-surface-500">{t('kpi.reassure')}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Una moderazione configurata per te, non uno strumento da capire da soli</h2>
      </div>
      <ValueCards items={valueItems} />
      <div class="mt-10 text-center">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Prenota una call per vederlo sui tuoi commenti</a>
      </div>
    </div>
  </section>

  <AppVideo />

  <AIEngine />

  <SwitchProvider />

  <section id="demo" class="bg-gradient-to-br from-violet-50 via-white to-brand-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('demo.title')}</h2>
        <p class="mt-4 text-lg text-surface-500">{t('demo.text')}</p>
      </div>
      <ModerationDemo />
    </div>
  </section>

  <!-- Dark Contrast Section: DSA Compliance -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-800 px-4 py-1.5 text-sm text-surface-300">
          <svg class="h-4 w-4 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Pronto per il DSA
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Pensato per la conformità normativa
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-surface-400">
          Ogni decisione di moderazione finisce in un registro di audit completo. Scegli tu quanto a lungo conservare i dati,
          esporti i report di trasparenza e i tuoi dati restano ospitati nell'UE.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm">
            Provalo gratis
          </a>
          <a href="/it/conformita-dsa" class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
            Scopri la conformità DSA
          </a>
        </div>
        <p class="mt-4 text-sm text-surface-400">Nessuna carta di credito richiesta</p>
      </div>
    </div>
  </section>

  <CostCalculator />

  <PricingTeaser />



  <TeamSection />

  <section class="bg-white pb-6 pt-2">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/it/integrazioni/moderazione-facebook" class="text-sm font-medium text-brand-600 hover:text-brand-500">Strumento di moderazione dei commenti Facebook &rarr;</a>
        <a href="/it/integrazioni/moderazione-instagram" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderazione automatica su Instagram &rarr;</a>
        <a href="/it/console-di-moderazione" class="text-sm font-medium text-brand-600 hover:text-brand-500">Console di moderazione unificata &rarr;</a>
        <a href="/it/casi-d-uso/media" class="text-sm font-medium text-brand-600 hover:text-brand-500">Moderazione dei commenti per gli editori di news &rarr;</a>
        <a href="/it/alternative/openai-moderation" class="text-sm font-medium text-surface-500 hover:text-surface-700">Confronta con le alternative &rarr;</a>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Le domande che i team si pongono prima di scegliere una piattaforma di moderazione" items={faqItems} />
    </div>
  </section>

  <CTASection />
</BaseLayout>
