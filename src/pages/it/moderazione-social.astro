---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ModerationVerdict from '../../components/ModerationVerdict.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/it/moderazione-social",
  "name": "Moderazione dei social con IA: Facebook, Instagram, YouTube",
  "description": "Uno strumento di moderazione dei social che nasconde automaticamente commenti d'odio, spam e truffe su Facebook, Instagram e YouTube, secondo le tue regole, con una motivazione scritta per ogni decisione.",
  "inLanguage": "it",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const platforms = [
  { name: "Facebook", href: "/it/integrazioni/moderazione-facebook", text: "I commenti sotto i post delle tue Pagine vengono analizzati appena arrivano. Quelli che violano le tue regole vengono nascosti automaticamente." },
  { name: "Instagram", href: "/it/integrazioni/moderazione-instagram", text: "I commenti sotto i tuoi post Instagram vengono analizzati allo stesso modo e nascosti quando violano le tue regole." },
  { name: "YouTube", href: "/it/integrazioni/moderazione-youtube", text: "Ogni commento sotto i tuoi video viene pubblicato, trattenuto per la revisione o rifiutato, direttamente tramite l'API di YouTube." },
  { name: "WordPress", href: "/it/integrazioni/moderazione-wordpress", text: "I commenti del tuo sito vengono approvati, messi in attesa o segnati come spam, senza plugin da sviluppare." },
];

const steps = [
  { title: "Collega i tuoi account", text: "Facebook, Instagram, YouTube o WordPress si collegano in pochi clic, senza sviluppatori." },
  { title: "Scrivi le tue regole", text: "Descrivi la tua policy in linguaggio naturale, poi aggiungi le parole vietate e una soglia per categoria. Un'impostazione predefinita equilibrata ti permette di partire subito." },
  { title: "L'IA applica le tue regole", text: "Ciò che viola chiaramente le tue regole viene nascosto, ciò che è accettabile resta online, i casi limite finiscono nella coda del tuo team." },
  { title: "Ogni decisione è motivata", text: "Una motivazione scritta accompagna ogni decisione, automatica o umana, e resta nel registro di audit." },
];

const faqItems = [
  {
    question: "Quali social può moderare OpenModeration?",
    answer: "Facebook, Instagram e YouTube, oltre ai siti WordPress, grazie a connettori nativi. Per le altre fonti puoi inviare i contenuti tramite l'API REST o i webhook. TikTok, X e LinkedIn oggi non hanno un connettore nativo.",
  },
  {
    question: "Serve saper programmare per moderare i social con OpenModeration?",
    answer: "No. Colleghi i tuoi account, scrivi le tue regole in linguaggio naturale e risolvi i casi limite con un clic nella console. L'API serve solo se vuoi collegare una piattaforma proprietaria.",
  },
  {
    question: "I commenti vengono eliminati o nascosti?",
    answer: "Su Facebook e Instagram i commenti che violano le tue regole vengono nascosti. Su YouTube vengono rifiutati o trattenuti per la revisione. Su WordPress vengono messi in attesa o segnati come spam. In ogni caso la decisione e la sua motivazione restano nel registro di audit.",
  },
  {
    question: "Quanto costa uno strumento di moderazione dei social come OpenModeration?",
    answer: "Il piano gratuito copre fino a 1.000 richieste al mese, cioè circa 30 commenti al giorno. Il piano Pro costa 99 € al mese per 10.000 richieste. Puoi anche ospitare OpenModeration in proprio gratuitamente, dato che il codice è open source.",
  },
  {
    question: "Dove sono ospitati i dati?",
    answer: "OpenModeration è progettato e ospitato nell'Unione europea e rispetta il GDPR. Puoi anche installarlo sulla tua infrastruttura.",
  },
];
---

<BaseLayout title="Moderazione dei social con IA, senza codice | OpenModeration" description="Nascondi in automatico commenti d'odio, spam e truffe su Facebook, Instagram e YouTube, secondo le tue regole. Ogni decisione è motivata. Gratis per iniziare." jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Moderazione dei social" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Facebook • Instagram • YouTube • WordPress
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">La moderazione dei social, automatica e motivata</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Insulti, spam e truffe si accumulano sotto i tuoi post, a qualsiasi ora. OpenModeration li nasconde automaticamente secondo le tue regole, su tutti i tuoi account insieme, e spiega per iscritto perché ogni commento è stato scartato.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">Provalo gratis</a>
        <a href="/it/come-funziona" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Scopri come funziona</a>
      </div>
      <p class="mt-4 text-sm text-surface-400">Senza carta di credito</p>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Cosa fa OpenModeration su ogni social</h2>
        <p class="mt-4 text-lg text-surface-500">Un'unica console e le stesse regole per tutti i tuoi account. L'azione applicata dipende da ciò che ogni piattaforma consente.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {platforms.map((p) => (
          <a href={p.href} class="block rounded-xl border border-surface-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-lg font-semibold text-surface-900">{p.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{p.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Quattro passaggi, senza scrivere codice</h2>
          <ol class="mt-8 space-y-4">
            {steps.map((s, i) => (
              <li class="flex items-start gap-4 rounded-lg border border-surface-200 bg-white p-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700">{i + 1}</span>
                <div>
                  <p class="text-sm font-medium text-surface-900">{s.title}</p>
                  <p class="mt-1 text-sm text-surface-500">{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <BrowserFrame caption="Un commento nascosto, la regola violata e la motivazione scritta, visibili a tutto il tuo team.">
          <ModerationVerdict slot="content" />
        </BrowserFrame>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Perché uno strumento dedicato invece dei filtri nativi</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">L'IA legge il contesto</h3>
          <p class="mt-2 text-sm text-surface-500">Un elenco di parole bloccate non coglie il sarcasmo, gli insulti camuffati e le truffe ben confezionate. I modelli di IA leggono l'intera frase e la valutano alla luce della tua policy di moderazione.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Un'unica console per tutti i tuoi account</h3>
          <p class="mt-2 text-sm text-surface-500">Non devi più saltare da un social all'altro: i casi limite di Facebook, Instagram, YouTube e del tuo sito arrivano nella stessa coda di revisione.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="font-semibold text-surface-900">Decisioni che puoi giustificare</h3>
          <p class="mt-2 text-sm text-surface-500">Ogni commento scartato conserva la sua regola e la sua motivazione scritta. Se un follower contesta, sai cosa rispondergli, e il registro di audit è pronto per il DSA.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Domande frequenti sulla moderazione dei social" items={faqItems} />
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Per approfondire</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/it/policy-di-moderazione" class="font-medium text-brand-600 hover:text-brand-500">Policy di moderazione: guida e modello &rarr;</a></li>
        <li><a href="/it/casi-d-uso/media" class="font-medium text-brand-600 hover:text-brand-500">La moderazione dei commenti per i media &rarr;</a></li>
        <li><a href="/it/alternative/bodyguard" class="font-medium text-brand-600 hover:text-brand-500">OpenModeration o Bodyguard: il confronto &rarr;</a></li>
        <li><a href="/it/conformita-dsa/motivazione" class="font-medium text-brand-600 hover:text-brand-500">La motivazione richiesta dal DSA &rarr;</a></li>
        <li><a href="/it/prezzi" class="font-medium text-brand-600 hover:text-brand-500">I prezzi &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Proteggi i tuoi social in 5 minuti." subtitle="Collega i tuoi account e scrivi le tue regole in linguaggio naturale: ogni commento nascosto è accompagnato da una motivazione scritta." />
</BaseLayout>
