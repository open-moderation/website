---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TeamSection from '../../components/TeamSection.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'it';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "Chi siamo: il team Logora dietro OpenModeration, dal 2019",
  "description": "OpenModeration è di Logora, fondata a Parigi nel 2019 e di proprietà dei dipendenti: modera i commenti di 23 media in Europa e America Latina.",
  "orgDescription": "Moderazione dei commenti con IA per media, brand, enti pubblici e piattaforme, adattata alle regole di ogni cliente. Di Logora (Parigi, 2019).",
  "crumb": "Chi siamo",
  "h1": "Il team che modera i tuoi commenti insieme a te",
  "lead": "OpenModeration è sviluppato da Logora, un’azienda indipendente fondata a Parigi nel 2019 e di proprietà dei suoi dipendenti. Otto persone tra Parigi, Madrid e Berlino avviano e gestiscono la moderazione dei commenti di 23 media in Europa e America Latina.",
  "whoTitle": "Chi siamo",
  "who": [
    "Dal 2019 moderiamo i commenti dei lettori per i media. Farlo ogni giorno ci ha insegnato di cosa hanno bisogno media, brand ed enti pubblici: decisioni affidabili, un motivo chiaro per ciascuna e persone a cui rivolgersi quando un caso è delicato.",
    "Tra le nostre referenze: L’Équipe, Challenges, Sud Ouest, actu.fr, Estadão, Südkurier ed Egora. Logora appartiene a chi ci lavora: rispondiamo ai nostri clienti, non a degli investitori."
  ],
  "whatTitle": "Cos’è OpenModeration",
  "what": "La moderazione dei commenti con IA per media, brand, enti pubblici e piattaforme, adattata alle tue regole e ai tuoi casi d’uso. Tu colleghi le tue pagine; la nostra IA, sviluppata internamente e addestrata su milioni di messaggi in sette anni, gestisce i casi chiari. Il nostro team gestisce i casi dubbi, le segnalazioni e i reclami. Vedi ogni decisione e il suo motivo scritto in tempo reale, e puoi intervenire quando vuoi.",
  "whatPoints": [
    "Il tuo sito, Facebook, Instagram, YouTube e WordPress; altri social su richiesta.",
    "Multilingue: ogni commento è analizzato nella sua lingua, comprese le lingue del tuo pubblico.",
    "L’avvio e la moderazione dei casi dubbi da parte del nostro team sono inclusi.",
    "Ospitato nell’Unione europea, nel rispetto del GDPR."
  ],
  "disambiguation": "OpenModeration (openmoderation.com) è un servizio di Logora. Non ha alcun legame con OpenModerator, un altro progetto dal nome simile.",
  "whyTitle": "Perché l’abbiamo creato",
  "why": [
    {
      "title": "Perché il DSA chiede spiegazioni",
      "text": "Con il Digital Services Act, le piattaforme che ospitano commenti devono motivare le decisioni di moderazione, gestire le segnalazioni e seguire i reclami. OpenModeration è pensato per questo: un motivo scritto per ogni decisione, uno storico tracciabile e dati esportabili."
    },
    {
      "title": "Perché un buon dibattito va protetto",
      "text": "Insulti e spam allontanano i lettori che hanno qualcosa da dire. Una moderazione attenta protegge il tuo brand e lascia spazio a un confronto vero, senza censurare troppo i commenti che rendono viva la discussione."
    }
  ],
  "ctaTitle": "Conosci il team",
  "ctaSubtitle": "Prenota una call: guardiamo insieme i tuoi commenti e ti mostriamo come funzionerebbe la moderazione sulle tue pagine."
};

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": "https://www.openmoderation.com/it/chi-siamo",
  "url": "https://www.openmoderation.com/it/chi-siamo",
  "name": "Chi siamo: il team Logora dietro OpenModeration, dal 2019",
  "description": "OpenModeration è di Logora, fondata a Parigi nel 2019 e di proprietà dei dipendenti: modera i commenti di 23 media in Europa e America Latina.",
  "inLanguage": "it",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  },
  "mainEntity": {
    "@type": "Organization",
    "@id": "https://www.openmoderation.com/#organization",
    "name": "OpenModeration",
    "url": "https://www.openmoderation.com",
    "description": "Moderazione dei commenti con IA per media, brand, enti pubblici e piattaforme, adattata alle regole di ogni cliente. Di Logora (Parigi, 2019).",
    "parentOrganization": {
      "@type": "Organization",
      "name": "Logora",
      "url": "https://logora.com"
    },
    "founder": [
      {
        "@type": "Person",
        "name": "Pierre Laburthe-Tolra"
      },
      {
        "@type": "Person",
        "name": "Henry Boisgibault"
      }
    ],
    "sameAs": [
      "https://logora.com",
      "https://www.linkedin.com/company/logora"
    ]
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={aboutJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-3xl text-lg text-surface-500">{c.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ClientLogos />
    </div>
  </section>

  <section class="bg-white pb-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900">{c.whoTitle}</h2>
      {c.who.map((p) => <p class="mt-4 text-lg text-surface-500">{p}</p>)}

      <h2 class="mt-12 text-2xl font-bold text-surface-900">{c.whatTitle}</h2>
      <p class="mt-4 text-lg text-surface-500">{c.what}</p>
      <ul class="mt-6 space-y-3">
        {c.whatPoints.map((p) => (
          <li class="flex items-start gap-3 text-surface-600"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{p}</span></li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-surface-400">{c.disambiguation}</p>

      <h2 class="mt-12 text-2xl font-bold text-surface-900">{c.whyTitle}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {c.why.map((w) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="font-semibold text-surface-900">{w.title}</h3>
            <p class="mt-2 text-sm text-surface-500">{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TeamSection />

  <CTASection title={c.ctaTitle} subtitle={c.ctaSubtitle} />
</BaseLayout>
