---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { localizePath, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

const locale: Locale = 'it';
const t = useTranslations(locale);
const booking = localizePath('/book-a-call', locale);
const signup = 'https://app.openmoderation.com/signup';

const c = {
  "title": "FAQ moderazione dei commenti: IA, team, DSA e prezzi",
  "description": "Chi modera, come l’IA segue le tue regole, test sui tuoi commenti, DSA, piattaforme, dati e prezzi: le risposte per media, brand ed enti pubblici.",
  "crumb": "FAQ",
  "h1": "Le tue domande sulla moderazione dei commenti",
  "intro": "Le domande che media, brand ed enti pubblici ci fanno più spesso prima di scegliere. Non trovi la tua? Prenota una call e chiedicelo.",
  "buyerTitle": "Prima di scegliere",
  "techTitle": "Per i team tecnici",
  "techIntro": "Dettagli più tecnici per i tuoi sviluppatori e il reparto IT.",
  "ctaTitle": "Hai ancora una domanda?",
  "ctaSubtitle": "Prenota una call: rispondiamo alle tue domande e ti mostriamo cosa farebbe la nostra moderazione sui tuoi commenti.",
  "buyer": [
    {
      "question": "L’IA modera da sola?",
      "answer": "No. La nostra IA è configurata sulle tue regole e decide da sola solo quando è sicura. I casi delicati vengono verificati da altri modelli di IA, quelli dubbi passano al nostro team, che decide secondo le tue regole e ti tiene informato. Non devi fare nulla, a meno che tu non voglia intervenire."
    },
    {
      "question": "Come conosce l’IA la nostra linea editoriale?",
      "answer": "Partiamo dal tuo regolamento e dai tuoi casi d’uso: cosa accetti, cosa rifiuti, i casi limite. Quando correggi una decisione, adattiamo le regole insieme a te. Non è un elenco di parole vietate: l’IA legge ogni commento nel suo contesto."
    },
    {
      "question": "Possiamo provare prima di impegnarci?",
      "answer": "Sì. In modalità sandbox, OpenModeration analizza i tuoi commenti reali senza pubblicare né nascondere nulla. Vedi cosa avremmo accettato o rifiutato, con il motivo, e lo confronti con la tua moderazione attuale. Niente ti viene nascosto."
    },
    {
      "question": "Possiamo provare senza lasciare il fornitore attuale?",
      "answer": "Sì. Il test gira in silenzio, in parallelo alla tua moderazione attuale, senza toccare la produzione. Confronti decisione per decisione e scegli con cognizione di causa, quando ti va bene."
    },
    {
      "question": "Cosa vediamo dalla nostra parte?",
      "answer": "Tutto, in tempo reale: ogni commento, la decisione presa, il motivo scritto e lo storico. Puoi correggere qualsiasi decisione in ogni momento dalla console."
    },
    {
      "question": "Perché un commento è stato rifiutato?",
      "answer": "Ogni decisione ha un motivo scritto (insulto, attacco personale, spam…), che puoi inoltrare all’autore. È più chiaro per i tuoi lettori e più facile da giustificare in caso di contestazione."
    },
    {
      "question": "OpenModeration aiuta a rispettare il DSA?",
      "answer": "È pensato per il DSA: un motivo scritto per ogni decisione, uno storico tracciabile, la gestione di segnalazioni e reclami, dati esportabili. Resti tu l’editore responsabile, e hai gli elementi per giustificare ogni decisione."
    },
    {
      "question": "Cosa succede quando l’IA è in dubbio?",
      "answer": "Il commento viene messo da parte e il nostro team lo gestisce secondo le tue regole. Ricevi un resoconto dei casi trattati e dei punti del regolamento da chiarire."
    },
    {
      "question": "E di notte, nel weekend o durante i picchi?",
      "answer": "L’IA modera giorno e notte con le stesse regole, qualunque sia il volume, anche durante una partita o una serata elettorale. I commenti dubbi restano da parte invece di essere pubblicati, finché il nostro team non li ha gestiti."
    },
    {
      "question": "Su quali piattaforme funziona OpenModeration?",
      "answer": "Il tuo sito (tramite la nostra API o WordPress), Facebook, Instagram e YouTube, con connettori pronti all’uso. TikTok, X, LinkedIn e altri social si aggiungono su richiesta, rapidamente. Il nostro team collega le tue pagine insieme a te."
    },
    {
      "question": "Quali lingue vengono moderate?",
      "answer": "OpenModeration è multilingue: ogni commento è analizzato nella sua lingua, comprese le lingue del tuo pubblico. Dicci quali ti interessano e ti mostreremo i risultati sui tuoi commenti."
    },
    {
      "question": "Dove sono ospitati i nostri dati?",
      "answer": "Nell’Unione europea, nel rispetto del GDPR. I tuoi commenti servono solo a moderare i tuoi spazi."
    },
    {
      "question": "Serve coinvolgere il nostro team tecnico?",
      "answer": "Pochissimo. Per i social e WordPress basta collegare i tuoi account. Per un sito o uno strumento interno, un’API ci invia i commenti e restituisce ogni decisione con il suo motivo. Il nostro team si occupa dell’avvio insieme a te."
    },
    {
      "question": "Quanto costa?",
      "answer": "Il prezzo dipende dal volume di commenti da moderare. Un piano gratuito ti permette di provare; poi ti proponiamo un forfait prevedibile, dimensionato sui tuoi volumi, dopo un test sui tuoi commenti: giudichi la qualità prima di parlare di budget."
    }
  ],
  "tech": [
    {
      "question": "C’è un’API?",
      "answer": "Sì. Un’API REST riceve ogni commento e restituisce la decisione, la categoria e il motivo scritto. I webhook avvisano i tuoi strumenti a ogni decisione, e le chiavi di accesso si gestiscono dalla console."
    },
    {
      "question": "Su quale IA si basa OpenModeration?",
      "answer": "Sulla nostra IA di moderazione, sviluppata internamente e addestrata su milioni di messaggi in sette anni. Nei casi delicati, altri modelli di IA verificano la decisione prima che venga applicata. Quando esce un modello migliore lo colleghiamo, senza cambiamenti per te."
    },
    {
      "question": "Possiamo aggiungere categorie su misura?",
      "answer": "Sì. Oltre alle categorie standard (odio, molestie, spam…), le tue regole sono scritte in linguaggio comune: si può aggiungere qualsiasi categoria propria della tua policy. L’IA le applica tenendo conto del contesto."
    },
    {
      "question": "E immagini o video?",
      "answer": "La versione attuale si concentra sul testo. La moderazione di immagini e video è nella roadmap e sfrutterà i modelli di IA multimodali man mano che migliorano."
    },
    {
      "question": "Si può installare sui nostri server?",
      "answer": "Di default, OpenModeration è ospitato nell’Unione europea e i tuoi dati restano esportabili. Un’installazione on-premise è possibile su richiesta: parliamone."
    }
  ]
};

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/it/faq",
  "url": "https://www.openmoderation.com/it/faq",
  "name": "FAQ moderazione dei commenti: IA, team, DSA e prezzi",
  "description": "Chi modera, come l’IA segue le tue regole, test sui tuoi commenti, DSA, piattaforme, dati e prezzi: le risposte per media, brand ed enti pubblici.",
  "inLanguage": "it",
  "isPartOf": {
    "@id": "https://www.openmoderation.com/#website"
  }
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: localizePath('/', locale) }, { label: c.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.intro}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={booking} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">📅 {t('cta.book')}</a>
        <a href={signup} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{t('cta.button')}</a>
      </div>
    </div>
  </section>
  <section class="bg-white py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={c.buyer} title={c.buyerTitle} />
    </div>
  </section>
  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mx-auto mb-6 max-w-3xl text-center text-sm text-surface-500">{c.techIntro}</p>
      <FAQ items={c.tech} title={c.techTitle} disableJsonLd />
    </div>
  </section>

  <CTASection title={c.ctaTitle} subtitle={c.ctaSubtitle} />
</BaseLayout>
