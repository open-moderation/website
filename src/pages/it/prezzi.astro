---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const pricingJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "OpenModeration",
  "description": "Piattaforma di moderazione con piano cloud gratuito, piano Pro a 99 € al mese e piani Enterprise. Installazione on-premise su richiesta.",
  "inLanguage": "it",
  "offers": [
    { "@type": "Offer", "name": "Gratuito", "price": "0", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" },
    { "@type": "Offer", "name": "Pro", "price": "99", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" },
    { "@type": "Offer", "name": "Enterprise", "priceCurrency": "EUR", "availability": "https://schema.org/InStock" }
  ]
};
---

<BaseLayout title="Prezzi: piano gratuito, Pro a 99 €/mese ed Enterprise" description="Parti gratis con 1.000 richieste al mese, passa a Pro a 99 €/mese per 10.000 richieste o scegli Enterprise. Prezzi chiari, senza costi nascosti." jsonLd={pricingJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Prezzi" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
        <span class="flex items-center gap-1.5">
          
          Sviluppato e ospitato nell'UE
        </span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Prezzi semplici e trasparenti</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Parti gratis con 1.000 richieste al mese, oppure passa a Pro per un servizio completamente gestito.
        Non devi parlare con un commerciale e non ci sono costi nascosti.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Free -->
        <div class="rounded-2xl border border-surface-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-surface-900">Gratuito</h2>
              <p class="mt-1 text-xs text-surface-500">Cloud gestito</p>
            </div>
            <span class="rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-700">Gratis</span>
          </div>
          <p class="mt-4 text-3xl font-bold text-surface-900">0 &euro;</p>
          <p class="mt-1 text-xs text-surface-500">Fino a 1.000 richieste al mese · ≈ 30 commenti al giorno</p>
          <ul class="mt-6 space-y-2 text-sm text-surface-600">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Tutte le funzionalità incluse</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Usi le tue chiavi (BYOK)</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Infrastruttura ospitata nell'UE</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Supporto della community</li>
          </ul>
          <a href="https://app.openmoderation.com/signup" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-surface-300 px-4 py-2.5 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            Inizia gratis
          </a>
          <p class="mt-3 text-center text-xs text-surface-400">Nessuna carta di credito richiesta · Disdici quando vuoi</p>
        </div>

        <!-- Pro -->
        <div class="relative rounded-2xl border-2 border-brand-500 bg-white p-6 shadow-md lg:col-span-1">
          <div class="absolute -top-3 right-4 rounded-full bg-brand-600 px-2.5 py-0.5 text-[10px] font-semibold text-white">Il più scelto</div>
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-surface-900">Pro</h2>
              <p class="mt-1 text-xs text-surface-500">Cloud completamente gestito</p>
            </div>
          </div>
          <p class="mt-4">
            <span class="text-3xl font-bold text-surface-900">99 &euro;</span>
            <span class="text-sm text-surface-400">/mese</span>
          </p>
          <p class="mt-1">
            <span class="text-sm text-surface-400">990 &euro;</span>
            <span class="text-sm text-surface-400">/anno, risparmi circa il 17%</span>
          </p>
          <ul class="mt-6 space-y-2 text-sm text-surface-600">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Hosting e infrastruttura gestiti</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> 10.000 richieste al mese incluse · ≈ 300 commenti al giorno</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Infrastruttura ospitata nell'UE</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Chiavi dei fornitori gestite dalla piattaforma</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Supporto prioritario e SLA</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Gestione del team e statistiche</li>
          </ul>
          <a href="https://app.openmoderation.com/signup" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
            Prova Pro
          </a>
          <p class="mt-3 text-center text-xs text-surface-400">Nessuna carta di credito richiesta · Disdici quando vuoi</p>
        </div>

        <!-- Enterprise -->
        <div class="rounded-2xl border border-surface-200 bg-ink-900 p-6 text-white shadow-sm lg:col-span-1">
          <h2 class="text-lg font-bold">Enterprise</h2>
          <p class="mt-1 text-xs text-surface-400">Su misura</p>
          <p class="mt-4 text-3xl font-bold">Su misura</p>
          <ul class="mt-6 space-y-2 text-sm text-surface-300">
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Infrastruttura dedicata</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> SLA personalizzato</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Richieste illimitate</li>
            <li class="flex items-center gap-2"><svg class="h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Ingegnere di supporto dedicato</li>
          </ul>
          <a href="https://calendly.com/jesuslogora/1h" target="_blank" rel="noopener" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-surface-900 shadow-sm transition hover:bg-surface-100">
            Prenota una call
          </a>
        </div>
      </div>

      <!-- On-premise banner -->
      <div class="mx-auto mt-12 max-w-3xl rounded-xl border border-surface-200 bg-surface-50 p-6">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          </div>
          <div class="flex-1">
            <h3 class="text-base font-semibold text-surface-900">Installazione on-premise: su richiesta</h3>
            <p class="mt-2 text-sm text-surface-500">
              Hai bisogno di installare OpenModeration sulla tua infrastruttura? È possibile su richiesta: parliamone.
            </p>
            <a href="https://calendly.com/jesuslogora/1h" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-brand-600 transition hover:text-brand-500">
              Parliamone
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- EU badge -->
      <div class="mx-auto mt-8 max-w-lg rounded-xl border border-surface-200 bg-surface-50 p-5 text-center">
        <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-surface-100 px-3 py-1 text-xs font-medium text-surface-600">
          <span class="flex items-center gap-1.5">
            
            Sviluppato e ospitato nell'UE
          </span>
        </div>
        <p class="text-sm text-surface-500">Tutti i piani SaaS girano su infrastrutture di proprietà europea e i tuoi dati non lasciano mai l'UE. La piattaforma è conforme al GDPR.</p>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
