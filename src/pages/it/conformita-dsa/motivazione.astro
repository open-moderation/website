const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Motivazione (articolo 17 del DSA): chi è obbligato e cosa deve contenere?",
  "description": "Cosa impone l'articolo 17 del regolamento sui servizi digitali (DSA) per ogni rimozione di contenuti: chi deve fornire una motivazione, quando, con quali informazioni, e un esempio.",
  "inLanguage": "it",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/it/conformita-dsa/motivazione" }
};

const contents = [
  { letter: "a", title: "La misura adottata", text: "Rimozione, disabilitazione dell'accesso, retrocessione o limitazione della visibilità, sospensione dei pagamenti in denaro o altra misura, con, ove opportuno, la sua portata territoriale e la sua durata." },
  { letter: "b", title: "I fatti e le circostanze", text: "Ciò su cui si basa la decisione, compreso se fa seguito a una segnalazione (articolo 16) o a indagini volontarie di tua iniziativa. L'identità del notificante viene indicata solo se strettamente necessario." },
  { letter: "c", title: "L'uso di strumenti automatizzati", text: "Ove opportuno, il fatto che la decisione sia stata adottata con strumenti automatizzati o riguardi contenuti individuati per mezzo di tali strumenti." },
  { letter: "d", title: "La base giuridica", text: "Se il contenuto è ritenuto illegale: la base giuridica invocata e le ragioni per cui il contenuto è considerato illegale in applicazione di tale base giuridica." },
  { letter: "e", title: "La clausola delle condizioni generali", text: "Se il contenuto è ritenuto incompatibile con le tue condizioni generali: la clausola contrattuale invocata e le ragioni di tale incompatibilità." },
  { letter: "f", title: "I mezzi di ricorso", text: "Informazioni chiare sui ricorsi possibili: meccanismi interni di gestione dei reclami, risoluzione extragiudiziale delle controversie, ricorso per via giudiziaria." },
];

const faqItems = [
  {
    question: "Che cos'è la motivazione prevista dal DSA?",
    answer: "È la spiegazione che l'articolo 17 del regolamento (UE) 2022/2065 sui servizi digitali impone di fornire all'utente il cui contenuto viene rimosso, reso inaccessibile, retrocesso o la cui visibilità viene limitata, nonché in caso di sospensione dell'account, del servizio o dei pagamenti.",
  },
  {
    question: "Un sito di informazione che modera i commenti è obbligato?",
    answer: "Sì: dal momento che memorizza i commenti pubblicati dai suoi lettori, agisce come prestatore di servizi di memorizzazione di informazioni (hosting) per quei contenuti. L'articolo 17 si applica a tutti i prestatori di servizi di hosting, comprese le piccole imprese.",
  },
  {
    question: "Serve una motivazione per ogni commento eliminato?",
    answer: "Sì, per ogni restrizione imposta perché il contenuto è illegale o contrario alle tue condizioni generali, a condizione che tu conosca le coordinate elettroniche dell'autore. L'obbligo non si applica ai contenuti commerciali ingannevoli ad ampia diffusione, né agli ordini delle autorità previsti all'articolo 9.",
  },
  {
    question: "Le motivazioni vanno trasmesse alla Commissione europea?",
    answer: "I fornitori di piattaforme online devono presentare le loro decisioni e motivazioni alla Commissione, senza indebito ritardo, per l'inserimento in una banca dati pubblica, senza dati personali (articolo 24, paragrafo 5). Le microimprese e le piccole imprese ne sono escluse dall'articolo 19, salvo che siano designate piattaforme online di dimensioni molto grandi.",
  },
  {
    question: "Quali sanzioni in caso di inadempimento?",
    answer: "Il DSA lascia agli Stati membri il compito di stabilire le sanzioni, ma fissa il tetto delle sanzioni pecuniarie per l'inosservanza di un obbligo al 6 % del fatturato annuo mondiale del fornitore (articolo 52).",
  },
];
---

<BaseLayout title="Motivazione (articolo 17 del DSA): obblighi ed esempio" description="Cosa impone l'articolo 17 del DSA per ogni rimozione di commenti: chi è obbligato, quando informare l'autore, le sei informazioni minime e un esempio." ogType="article" jsonLd={articleJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/it" }, { label: "Conformità DSA", href: "/it/conformita-dsa" }, { label: "Motivazione" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">20 ottobre 2026</time>
        <span>&middot;</span>
        <span>7 min di lettura</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">La motivazione del DSA: cosa impone l'articolo 17 per ogni rimozione di contenuti</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        Da quando il regolamento sui servizi digitali (DSA) è applicabile, rimuovere un commento non basta più:
        bisogna spiegarne il motivo all'autore. L'articolo 17 chiama questa spiegazione «motivazione» e ne fissa il contenuto
        minimo. Ecco chi è obbligato, in quale momento, cosa deve contenere la motivazione e come può presentarsi.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Chi deve fornire una motivazione?</h2>
      <p>
        L'obbligo ricade sui <strong>prestatori di servizi di memorizzazione di informazioni</strong> (hosting), cioè qualsiasi
        servizio che memorizza informazioni fornite dai suoi utenti: social network, forum, marketplace, ma anche siti di
        informazione o blog che ospitano i commenti dei lettori. A differenza di altri obblighi del DSA, l'articolo 17 non
        prevede alcuna esclusione per le microimprese e le piccole imprese.
      </p>

      <h2 class="text-xl font-bold text-surface-900">In quali casi?</h2>
      <p>
        La motivazione è dovuta a ogni utente interessato da una restrizione imposta perché il suo contenuto è illegale
        o incompatibile con le tue condizioni generali. Il testo indica quattro tipi di restrizioni:
      </p>
      <ul>
        <li>qualsiasi restrizione alla visibilità di un contenuto: rimozione, disabilitazione dell'accesso o retrocessione;</li>
        <li>la sospensione, la cessazione o altra limitazione dei pagamenti in denaro;</li>
        <li>la sospensione o la cessazione, totale o parziale, della prestazione del servizio;</li>
        <li>la sospensione o la chiusura dell'account dell'utente.</li>
      </ul>
      <p>
        L'obbligo si applica quando conosci le coordinate elettroniche dell'utente, al più tardi dal momento in cui la
        restrizione è imposta. Non riguarda i contenuti commerciali ingannevoli ad ampia diffusione, né gli ordini delle
        autorità previsti all'articolo 9.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Le sei informazioni obbligatorie</h2>
      <p>Il paragrafo 3 dell'articolo 17 elenca le informazioni che la motivazione deve contenere come minimo:</p>
    </div>

    <div class="mt-6 space-y-3">
      {contents.map((c) => (
        <div class="flex items-start gap-4 rounded-lg border border-surface-200 bg-surface-50 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-mono text-sm font-semibold text-brand-700">{c.letter}</span>
          <div>
            <p class="text-sm font-medium text-surface-900">{c.title}</p>
            <p class="mt-1 text-sm text-surface-500">{c.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <p>
        Queste informazioni devono essere «chiare e facilmente comprensibili», il più possibile precise e specifiche, e
        consentire all'utente di sfruttare in modo effettivo le possibilità di ricorso (paragrafo 4).
      </p>

      <h2 class="text-xl font-bold text-surface-900">E per le piattaforme online?</h2>
      <p>
        I fornitori di piattaforme online hanno un obbligo in più: presentare le loro decisioni e le loro motivazioni alla
        Commissione europea, senza indebito ritardo, per alimentare una banca dati pubblica. Questi invii non devono
        contenere dati personali (articolo 24, paragrafo 5). Le microimprese e le piccole imprese ne sono escluse
        dall'articolo 19, salvo che siano designate piattaforme online di dimensioni molto grandi.
      </p>

      <h2 class="text-xl font-bold text-surface-900">Esempio di motivazione per un commento rimosso</h2>
      <p>Esempio fittizio, da adattare al tuo servizio e alle tue condizioni generali:</p>
    </div>

    <div class="mt-6 rounded-xl border border-surface-200 bg-white p-6 text-sm leading-relaxed text-surface-700 shadow-sm">
      <p>Gentile utente,</p>
      <p class="mt-3"><strong>Misura:</strong> il commento che hai pubblicato il 14 ottobre 2026 sotto l'articolo «…» è stato rimosso. Il tuo account non è interessato.</p>
      <p class="mt-3"><strong>Motivo:</strong> il commento contiene un insulto rivolto a un altro lettore, in violazione dell'articolo 4 delle nostre regole di partecipazione («Rispetto degli altri partecipanti»).</p>
      <p class="mt-3"><strong>Come è stata presa la decisione:</strong> il commento è stato individuato da uno strumento di analisi automatica e la decisione è stata poi confermata da un moderatore.</p>
      <p class="mt-3"><strong>I tuoi mezzi di ricorso:</strong> se ritieni che questa decisione sia ingiustificata, puoi contestarla rispondendo a questo messaggio entro sei mesi. Puoi anche rivolgerti a un organismo certificato di risoluzione extragiudiziale delle controversie o adire l'autorità giudiziaria.</p>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Come OpenModeration ti aiuta a redigere le motivazioni</h2>
      <ul>
        <li><strong>Una motivazione scritta per ogni decisione.</strong> Ogni commento rifiutato riceve una spiegazione redatta, nella lingua che preferisci, che fa da base al motivo (lettera e o d).</li>
        <li><strong>Il ruolo dell'automazione, tracciato.</strong> Il registro delle attività indica se la decisione viene dall'IA o da un moderatore, e da quale (lettere b e c).</li>
        <li><strong>Dati pronti da inviare.</strong> L'API e i webhook restituiscono per ogni contenuto il verdetto, la categoria e la spiegazione: puoi inserirli nel messaggio inviato all'autore.</li>
        <li><strong>Uno storico completo.</strong> Tutte le decisioni, automatiche o umane, restano nel registro di audit per i tuoi report e i tuoi controlli.</li>
      </ul>
      <p>
        L'indicazione dei mezzi di ricorso e la base giuridica precisa restano di tua competenza: dipendono dal tuo
        servizio, dalle tue condizioni generali e dal diritto applicabile.
      </p>
      <p class="text-sm text-surface-400">
        Fonte: <a href="https://eur-lex.europa.eu/legal-content/IT/TXT/?uri=CELEX:32022R2065" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">regolamento (UE) 2022/2065 del 19 ottobre 2022 relativo a un mercato unico dei servizi digitali</a>, GU L 277 del 27 ottobre 2022, articoli 17, 19, 24 e 52. Questa pagina ha scopo informativo e non costituisce una consulenza legale.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="Domande frequenti" items={faqItems} />
    </div>
  </article>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Per approfondire</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/it/policy-di-moderazione" class="font-medium text-brand-600 hover:text-brand-500">Policy di moderazione: guida e modello &rarr;</a></li>
        <li><a href="/it/conformita-dsa" class="font-medium text-brand-600 hover:text-brand-500">La conformità DSA con OpenModeration &rarr;</a></li>
        <li><a href="/it/prodotto/trasparenza" class="font-medium text-brand-600 hover:text-brand-500">Ogni decisione motivata per iscritto &rarr;</a></li>
        <li><a href="/it/casi-d-uso/media" class="font-medium text-brand-600 hover:text-brand-500">La moderazione dei commenti per i media &rarr;</a></li>
        <li><a href="/it/blog/guida-dsa-pmi" class="font-medium text-brand-600 hover:text-brand-500">Il DSA per le PMI: guida pratica &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection title="Una motivazione per ogni commento rimosso." subtitle="OpenModeration scrive la spiegazione di ogni decisione e tiene traccia di chi ha deciso cosa. Gratis per iniziare." />
</BaseLayout>
