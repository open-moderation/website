---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import FAQ from '../../components/FAQ.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import WaveDecoration from '../../components/WaveDecoration.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Transparency — See exactly why every comment was hidden",
  "url": "https://www.openmoderation.com/product/transparency",
  "description": "Every moderation decision comes with a written reason, a complete AI and human audit log, open-source code and EU hosting. No black boxes.",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const faqItems = [
  {
    question: "Why was my comment hidden?",
    answer: "Because it broke one of your rules. The console shows the exact reason in plain language — for example \"This comment contains an insult\" or \"This comment promotes a scam\" — together with the full activity history of the decision.",
  },
  {
    question: "Can I see the AI's reasoning for each decision?",
    answer: "Yes. Every automated decision carries a written justification. Comments in the grey zone go to human review with their full context, and your moderators' decisions are logged exactly the same way — who decided, when, and why.",
  },
  {
    question: "Is the code really open source?",
    answer: "Yes, under AGPL v3. The rules engine, the AI pipeline and the audit log are public on GitHub. You can read them, audit them, and self-host the whole platform to verify every claim on this page.",
  },
  {
    question: "Where is my data stored?",
    answer: "In the European Union, under GDPR rules. No tracking cookies on this site, no data resale. If you self-host, your data never leaves your own infrastructure.",
  },
];

const steps = [
  {
    title: "The AI hides a comment",
    description: "It breaks one of your rules: insults, spam, scams, or anything else your charter forbids.",
  },
  {
    title: "A written reason is attached",
    description: "In plain language: what the comment did, and which rule it broke. No scores to decode.",
  },
  {
    title: "It all goes in the log",
    description: "Every AI and human decision is timestamped and searchable — who decided, when, and why.",
  },
];

const proofs = [
  {
    title: "Written reasons",
    description: "Every hidden comment explains itself, in plain language, directly in the console.",
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
    href: null,
    hrefLabel: null,
  },
  {
    title: "Complete audit log",
    description: "AI and human decisions in one place, with timestamps and full context. Built for DSA audits.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    href: "/dsa-compliance",
    hrefLabel: "See DSA audit trails",
  },
  {
    title: "Open source, auditable",
    description: "The code is public under AGPL v3. Read it, audit it, run it yourself.",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    href: "https://github.com/open-moderation/open-moderation",
    hrefLabel: "View the source on GitHub",
  },
  {
    title: "EU-hosted & GDPR",
    description: "Your data stays in the European Union. Self-host to keep it entirely on your own servers.",
    icon: "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    href: "/faq",
    hrefLabel: "Data questions in the FAQ",
  },
];
---

<BaseLayout
  title="Transparency — See exactly why every comment was hidden | OpenModeration"
  description="Every moderation decision comes with a written reason, a complete AI and human audit log, open-source code and EU hosting. No black boxes, ever."
  canonical="/product/transparency"
  jsonLd={pageJsonLd}
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Product' }, { label: 'Transparency' }]} />

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-surface-50" />
    <WaveDecoration variant="flow" />
    <div class="relative mx-auto max-w-7xl px-4 pb-12 pt-10 sm:px-6 lg:px-8 lg:pt-14">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600 shadow-sm">
          <span class="flex h-2 w-2 animate-pulse-dot rounded-full bg-accent-500" />
          Our promise · Transparency
        </div>
        <h1 class="animate-fade-in-up text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">
          Every hidden comment comes with a written <em class="italic text-brand-800">reason</em>.
        </h1>
        <p class="animate-fade-in-up delay-1 mt-6 text-lg leading-relaxed text-surface-500 sm:text-xl">
          Moderation you can't explain is moderation you can't defend. open-moderation shows you
          exactly why each comment was hidden — in plain language, every time. No black boxes.
        </p>
        <div class="animate-fade-in-up delay-2 mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">
            Try it for free
          </a>
          <a href="/how-it-works" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">
            See how it works
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <p class="animate-fade-in-up delay-2 mt-4 text-sm text-surface-400">No credit card required</p>
      </div>
    </div>
  </section>

  <!-- Proof capture -->
  <section class="bg-white pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-xl">
        <BrowserFrame
          src="/images/reason.png"
          alt="open-moderation console: a spam comment rejected with the written reason &quot;The comment promotes a scam contest and contains an external phishing or promo link&quot;"
          caption="Demo workspace — a rejected scam comment, its written reason and the full activity history."
        >
          <div slot="annotation" class="absolute bottom-3 right-3 rounded-full border border-brand-200 bg-white/95 px-3 py-1 text-xs font-semibold text-brand-800 shadow-sm">
            &#x270D; The written reason
          </div>
        </BrowserFrame>
      </div>
    </div>
  </section>

  <!-- Black box vs open -->
  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">
          A hidden comment you can't explain is a liability
        </h2>
        <p class="mt-4 text-lg text-surface-500">
          The day a client, your boss or a regulator asks &ldquo;why was this hidden?&rdquo;,
          &ldquo;the algorithm decided&rdquo; is not an answer.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-red-100 bg-red-50/50 p-8">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-red-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            Black-box moderation
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-600">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Raw scores without context or explanation</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> No written justification for hidden comments</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> Nothing to show in an audit or a dispute</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-red-500">✕</span> You discover mistakes when it's too late</li>
          </ul>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-8 shadow-sm">
          <h3 class="flex items-center gap-2 text-xl font-semibold text-brand-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            With open-moderation
          </h3>
          <ul class="mt-6 space-y-3 text-sm text-surface-700">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> A written reason for every hidden comment</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> AI and human actions in a single log</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Explainable to clients, bosses and regulators</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-accent-500">✓</span> Open-source code you can inspect line by line</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-t border-surface-100 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        title="How transparency works"
        subtitle="Three steps, zero mystery — from the flagged comment to the reason you can show anyone."
      />
      <div class="grid gap-6 md:grid-cols-3">
        {steps.map((step, i) => (
          <div class="relative rounded-xl border border-surface-200 bg-white p-8">
            <span class="text-4xl font-bold text-brand-100">0{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-surface-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-500">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proofs -->
  <section class="border-t border-surface-100 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle
        title="Transparency, proven"
        subtitle="Four verifiable proofs — not claims. Click, read, audit."
      />
      <div class="stagger-fade-in grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {proofs.map((p) => (
          <div class="flex flex-col rounded-xl border border-surface-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={p.icon}/></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-surface-900">{p.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-surface-500">{p.description}</p>
            {p.href && (
              <a href={p.href} class="mt-4 text-sm font-medium text-brand-600 hover:text-brand-500">
                {p.hrefLabel} &rarr;
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stat -->
  <section class="border-t border-surface-100 bg-white py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-5xl font-bold tracking-tight text-brand-900 sm:text-6xl">68%</p>
      <p class="mt-4 text-lg text-surface-600 sm:text-xl">
        of consumers read your comments before they buy.
      </p>
      <p class="mt-2 text-sm text-surface-400">Source: consumer research cited by Respondology</p>
      <p class="mx-auto mt-6 max-w-2xl text-surface-500">
        What they find there decides whether they trust you. That's why every moderation
        decision should come with the reason, in writing.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-surface-100 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionTitle title="Frequently asked questions" />
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="relative overflow-hidden bg-ink-900 py-20">
    <WaveDecoration variant="corner" />
    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Moderation you can defend. Every decision, explained.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-300">
        Connect your page in a few clicks and see the written reason behind every hidden comment.
      </p>
      <div class="mt-8">
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm transition hover:bg-surface-100">
          Try it for free
        </a>
        <p class="mt-4 text-sm text-surface-400">No credit card required</p>
      </div>
      <p class="mt-12 text-xs text-surface-500">No tracking cookies. EU-hosted. Open source.</p>
    </div>
  </section>
</BaseLayout>
