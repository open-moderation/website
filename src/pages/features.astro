---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.openmoderation.com/features",
  "url": "https://www.openmoderation.com/features",
  "name": "Content Moderation Features: Unified API & Rule Engine",
  "description": "All the features of OpenModeration: moderation API, dashboard, action engine, native connectors, batch processing and DSA-compliant audit trails.",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const curlExample = `# One call, standardized scores
curl -X POST https://api.openmoderation.com/v1/moderation \\
  -H "Authorization: Bearer om_key_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "input": "Your text to moderate here",
    "language": "en"
  }'

# Response (same format, every time)
{
  "id": "modr_01JXK...",
  "results": [{
    "category": "hate",
    "score": 0.02,
    "flagged": false
  }],
  "flagged": false,
  "usage": {
    "latency_ms": 243
  }
}`;

const featureCategories = [
  {
    title: 'Single Integration',
    description: 'One API endpoint, one response format. When we plug in a better AI model, nothing changes in your code.',
    items: [
      { title: 'Our own moderation AI', desc: 'Submit content once and get back a clear pass/fail verdict and category scores, set up on your rules and your use cases.' },
      { title: 'Pre-built content categories', desc: 'Ready-made categories covering hate, harassment, sexual content, violence, self-harm, spam, misinformation, PII, and more.' },
      { title: 'Cross-checked by other AIs', desc: 'On delicate cases, other AI models arbitrate the decision before it is applied. Fewer mistakes, fewer wrongly hidden comments.' },
      { title: 'Smarter Moderation Decisions', desc: 'Decisions take into account the conversation, the history of the author, the channel and your own policies.' },
      { title: 'Bulk Content Review', desc: 'Submit up to 10,000 items at once for async processing. Results are pushed to your system when they are ready.' },
      { title: 'Custom Moderation Policies', desc: 'Define your own categories. Provide examples and let the AI classify content your way.' },
    ],
  },
  {
    title: 'Moderation Dashboard',
    description: 'A web interface to run your day-to-day moderation.',
    items: [
      { title: 'Access Management', desc: 'Create and manage access keys. Set usage limits per key.' },
      { title: 'Team & Role Management', desc: 'Give your colleagues access, assign roles and set permissions without going through your IT department.' },
      { title: 'Report Management', desc: 'One queue to process user reports and track their status, so no flagged comment gets forgotten.' },
      { title: 'Activity History', desc: 'Every moderation request is logged with its verdict, response time and category scores.' },
      { title: 'Service Health Monitoring', desc: 'See the real-time status of the service: uptime, response times, and error rates.' },
      { title: 'Performance Reports', desc: 'Follow moderation volume and flag rates and watch how costs evolve.' },
      { title: 'Connector Management', desc: 'Connect your social platform accounts with your own credentials.' },
      { title: 'Rule Configuration', desc: 'Define forbidden words, set category thresholds and write your rules in plain language. These three tools need no code.' },
    ],
  },
  {
    title: 'Automated Moderation',
    description: 'You define your moderation rules with three tools: forbidden words, category thresholds and your own rules written in plain language.',
    items: [
      { title: 'Context-Aware AI Rules', desc: 'Combine AI confidence scores with your own rules instead of relying on keyword lists alone.' },
      { title: 'Auto-Actions', desc: 'When a threshold is crossed, the Action Engine can hide, delete, flag, notify or mark as spam.' },
      { title: 'Human-in-the-Loop', desc: 'Borderline cases are handled by our team. You can step in and make the final call whenever you want.' },
      { title: 'Real-Time View', desc: 'See every decision as it happens, with its written reason, and approve or reject any item yourself.' },
      { title: 'Webhook Notifications', desc: 'Get real-time alerts for flagged content, finished batches, errors and more.' },
      { title: 'Full Audit Trail', desc: 'Every action is logged with the rule that triggered it, the action taken and the outcome.' },
    ],
  },
  {
    title: 'Platform Integrations',
    description: 'Connect directly to social platforms and your blog to automatically ingest and moderate content.',
    items: [
      { title: 'Facebook', desc: 'Receive comments and posts. Automatically hide or remove content that breaks your rules.' },
      { title: 'Instagram', desc: 'Moderate Instagram comments and messages. Keep your profile safe from toxic or spammy content.' },
      { title: 'YouTube', desc: 'Ingest video comments. Mark as spam or hold for review by our team.' },
      { title: 'WordPress', desc: 'Moderate comments on your blog. Approve, hold for review, or mark as spam automatically.' },
      { title: 'Use Your Own Platform Access', desc: 'Connect with your own platform accounts. Access tokens are never stored in plaintext.' },
      { title: 'Generic Webhook Receiver', desc: 'Ingest content from any platform that supports outgoing webhooks.' },
      { title: 'Generic Webhook Callback', desc: 'Send moderation results to your own webhook for custom integrations.' },
    ],
  },
];
---

<BaseLayout title="Content Moderation Features: Unified API & Rule Engine" description="All the features of OpenModeration: moderation API, dashboard, action engine, native connectors, batch processing and DSA-compliant audit trails." jsonLd={pageJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Features" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Features</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        OpenModeration covers the whole pipeline, from receiving a comment to acting on it.
      </p>
    </div>
  </section>

  {featureCategories.map((cat) => (
    <section class="scroll-mt-16 border-t border-surface-100 bg-white py-12 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-8 max-w-2xl text-center sm:mb-12">
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{cat.title}</h2>
          <p class="mt-4 text-lg text-surface-500">{cat.description}</p>
        </div>
        <div class={`grid gap-4 sm:gap-6 md:grid-cols-2 ${cat.items.length % 4 === 0 || cat.items.length === 7 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
          {cat.items.map((item) => (
            <div class="om-card relative overflow-hidden bg-white !p-5 sm:!p-6">
              <span class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-brand-500 to-violet-500" aria-hidden="true"></span>
              <h3 class="font-semibold text-surface-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-surface-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- API Reference Snippet -->
  <section class="border-t border-surface-100 bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">One format, whatever the model behind it</h2>
          <p class="mt-4 text-lg text-surface-500">
            When we plug in a better or cheaper AI model, results keep the same format, so you only integrate once.
          </p>
          <div class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>The same format</strong> every time, with no extra code to write when the AI improves.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Secure access keys</strong> with scoped permissions and usage limits per key.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Interactive API docs</strong> are generated automatically, and you can try requests from your browser.</p>
            </div>
          </div>
        </div>
        <div>
          <CodeBlock code={curlExample} lang="bash" />
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>