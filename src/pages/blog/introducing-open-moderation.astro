---
import { bookingUrl } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlossaryAutoLink from '../../components/GlossaryAutoLink.astro';
import BlogArticleExtras from '../../components/BlogArticleExtras.astro';
import CTASection from '../../components/CTASection.astro';
import GuideComparisons from '../../components/GuideComparisons.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Introducing OpenModeration: The Unified Moderation Platform",
  "description": "We're building a moderation platform: our own AI, cross-checked by other models, with a written reason and an audit trail for every decision.",
  "datePublished": "2026-06-01",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/blog/introducing-open-moderation" },
  "dateModified": "2026-06-01"
};
---

<BaseLayout title="Introducing OpenModeration: The Unified Moderation Platform" description="We're building a moderation platform: our own AI, cross-checked by other models, with a written reason and an audit trail for every decision." jsonLd={articleJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog" }, { label: "Introducing OpenModeration" }]} />
  <GlossaryAutoLink>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-06-01">June 1, 2026</time>
        <span>&middot;</span>
        <span>5 min read</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Introducing OpenModeration: The Unified Moderation Platform</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        Today we're announcing OpenModeration, a content moderation platform built on its own
        moderation AI, with delicate cases cross-checked by other AI models.
      </p>

      <h2 class="text-xl font-bold text-surface-900">The problem we're solving</h2>
      <p>
        Many moderation tools rely on a single in-house algorithm, frozen between two updates.
        Meanwhile, AI models get better and cheaper every year, and platforms stuck on yesterday's
        model miss out on that progress.
      </p>
      <p>
        Meanwhile, the volume of user-generated content is growing 30-40% annually. The DSA
        legally requires platforms to moderate. And the EU enforces it:
        fines can reach 6% of global revenue.
      </p>
      <p>
        The market needs a standard layer, the way payments have Stripe and communications have Twilio.
      </p>

      <h2 class="text-xl font-bold text-surface-900">What we're building</h2>
      <p>
        OpenModeration is a full moderation platform. Beyond the API, it includes:
      </p>
      <ul>
        <li><strong>Our own moderation AI.</strong> POST /v1/moderation returns standardized scores per category, and other AI models cross-check delicate cases.</li>
        <li><strong>Model-agnostic engine.</strong> When a better or cheaper AI model comes out, we plug it in quickly. Nothing changes on your side.</li>
        <li><strong>Action Engine.</strong> Define rules with three tools: forbidden words, category thresholds, and your own rules written in plain language.</li>
        <li><strong>Native connectors.</strong> Facebook, Instagram, YouTube and WordPress, connected with your own platform accounts.</li>
        <li><strong>Admin dashboard.</strong> A React Admin interface for managing keys, viewing logs, and analyzing usage.</li>
        <li><strong>DSA-compliant audit trail.</strong> Every moderation is logged in full and can be exported for compliance.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">Why transparency</h2>
      <p>
        Moderation depends on trust. A moderation tool that only returns "removed" or "kept" is a black box:
        you can't verify what it does, how it makes decisions, or where your data goes.
      </p>
      <p>
        With OpenModeration, every decision is explained in writing and recorded in a full audit trail.
        Data is hosted in the EU, and you can export it whenever you need.
      </p>

      <h2 class="text-xl font-bold text-surface-900">What's next</h2>
      <p>
        We're launching with Block 1 (the core moderation API and dashboard) and will ship
        Blocks 2 and 3 (ingestion, action engine, connectors) in the coming months.
        Our hosted SaaS will follow later this year.
      </p>
      <p>
        If you're building a platform that needs moderation, we'd love your feedback.
        <a href={bookingUrl('en')} class="text-brand-600 hover:text-brand-500">Book a call</a> and let us know what you think.
      </p>
    </div>
  </article>
  </GlossaryAutoLink>

  <BlogArticleExtras />

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Keep exploring</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/how-it-works" class="font-medium text-brand-600 hover:text-brand-500">How the moderation pipeline works &rarr;</a></li>
        <li><a href="/features" class="font-medium text-brand-600 hover:text-brand-500">Everything the platform does for you &rarr;</a></li>
        <li><a href="/pricing" class="font-medium text-brand-600 hover:text-brand-500">Start free, upgrade when you grow &rarr;</a></li>
      </ul>
    </div>
  </section>

  <GuideComparisons />

  <CTASection />
</BaseLayout>