---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.openmoderation.com/blog",
  "url": "https://www.openmoderation.com/blog",
  "name": "Content Moderation Blog: DSA, AI Safety & Dev Guides",
  "description": "Articles about content moderation, DSA compliance, AI safety and moderation infrastructure.",
  "isPartOf": { "@id": "https://www.openmoderation.com/#website" }
};

const posts = [
  {
    title: "TikTok Comment Moderation: Filters, Rules and Tips",
    description: "How to moderate TikTok comments: comment filters, filtered keywords, manual approval, LIVE moderators, their limits for brands, and a crisis playbook.",
    slug: "tiktok-comment-moderation",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guide"],
  },
  {
    title: "Social Media Moderation: The Complete Guide (2026)",
    description: "How to moderate social media: methods, rules, Facebook, Instagram, YouTube, TikTok, LinkedIn and X specifics, team setup, crises, metrics and tools.",
    slug: "social-media-moderation-guide",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guide"],
  },
  {
    title: "YouTube Comment Moderation: Studio Tools and Limits",
    description: "How to moderate YouTube comments: held for review, blocked words and links, approved and hidden users, moderators, live chat, and when to automate.",
    slug: "youtube-comment-moderation",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guide"],
  },
  {
    title: "How to Handle Negative Comments and Trolls (2026 Guide)",
    description: "How to handle negative comments and trolls: criticism vs abuse, when to respond, hide, delete or ban, reply templates, raids, crises and team wellbeing.",
    slug: "handle-negative-comments-trolls",
    date: "2026-10-30",
    readTime: "13 min",
    tags: ["guide"],
  },
  {
    title: "What Is Content Moderation? Definition and Types",
    description: "What content moderation means: what gets moderated, the 6 types, the content moderator job, how AI moderation works, the DSA, and how to choose an approach.",
    slug: "what-is-content-moderation",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guide"],
  },
  {
    title: "Comment Moderation: The Complete Guide",
    description: "How to moderate comments: the methods compared, what your rules should cover, grey areas, the DSA, choosing a tool and 10 best practices.",
    slug: "comment-moderation-guide",
    date: "2026-10-30",
    readTime: "12 min",
    tags: ["guide", "comments", "DSA"],
  },
  {
    title: "How to Hide Facebook Comments Automatically",
    description: "Hide vs delete vs ban, Facebook's built-in filters and their limits, and how to choose a Facebook comment moderation tool.",
    slug: "hide-facebook-comments-automatically",
    date: "2026-10-30",
    readTime: "8 min",
    tags: ["facebook", "guide"],
  },
  {
    title: "Instagram Comment Moderation: Automoderation Guide",
    description: "Hidden Words, Limits and Restrict, what they miss, what you need to connect a tool and how to set up automoderation.",
    slug: "instagram-comment-moderation",
    date: "2026-10-30",
    readTime: "8 min",
    tags: ["instagram", "guide"],
  },
  {
    title: "OpenAI Moderation API: omni-moderation-latest, Categories, Pricing and Limits",
    description: "What the OpenAI Moderation API detects, the 13 categories, the response format, whether it is free, and what it leaves for you to build.",
    slug: "openai-moderation-api-guide",
    date: "2026-10-20",
    readTime: "6 min",
    tags: ["openai", "API", "guide"],
  },
  {
    title: "DSA Compliance for Small and Medium Platforms: A Practical Guide",
    description: "A practical guide to EU Digital Services Act compliance for smaller platforms: automated moderation, audit trails and actionable steps.",
    slug: "dsa-compliance-sme-guide",
    date: "2026-06-16",
    readTime: "8 min",
    tags: ["DSA", "compliance", "guide"],
  },
  {
    title: "Build vs Buy: Content Moderation Infrastructure Costs in 2026",
    description: "The true cost of building in-house moderation vs using OpenModeration. Engineering time, maintenance, and hidden costs analyzed.",
    slug: "build-vs-buy-moderation",
    date: "2026-06-14",
    readTime: "9 min",
    tags: ["comparison", "build-vs-buy"],
  },
  {
    title: "Google Perspective API Sunset: Migration Guide for Forums",
    description: "Google's Perspective API is sunsetting in late 2026. How to migrate your forum or community before the deadline.",
    slug: "perspective-api-migration-guide",
    date: "2026-06-12",
    readTime: "7 min",
    tags: ["perspective", "migration", "guide"],
  },
  {
    title: "OpenAI Moderation vs Azure vs Llama Guard: A 2026 Comparison",
    description: "A fair comparison of the main AI moderation providers: performance, pricing, language coverage and when to use each one.",
    slug: "openai-vs-azure-vs-llama-guard-comparison",
    date: "2026-06-10",
    readTime: "8 min",
    tags: ["comparison", "providers"],
  },
  {
    title: "DSA Compliance Made Simple for Comment Moderation",
    description: "How to meet EU Digital Services Act requirements for comment moderation: written reasons, full audit trail, transparency reporting and EU hosting.",
    slug: "dsa-compliance-open-source-moderation",
    date: "2026-06-08",
    readTime: "6 min",
    tags: ["DSA", "compliance", "transparency"],
  },
  {
    title: "Content Moderation for AI Applications: A Developer's Guide",
    description: "How to implement input and output filtering for LLM-powered applications. Best practices for prompt injection prevention and content safety.",
    slug: "ai-content-moderation-developer-guide",
    date: "2026-06-05",
    readTime: "10 min",
    tags: ["AI", "LLM", "guide"],
  },
  {
    title: "Introducing OpenModeration: The Unified Moderation Platform",
    description: "We're building a moderation platform: our own AI, cross-checked by other models, with a written reason for every decision.",
    slug: "introducing-open-moderation",
    date: "2026-06-01",
    readTime: "5 min",
    tags: ["announcement"],
  },
];
---

<BaseLayout title="Content Moderation Blog: DSA, AI Safety & Dev Guides" description="Articles about content moderation, DSA compliance, AI safety and moderation infrastructure." jsonLd={blogJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Blog" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Notes on content moderation, AI safety, DSA compliance and building moderation infrastructure.
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
            <div class="flex items-center gap-3 text-xs text-surface-400">
              <time datetime={post.date}>{new Date(post.date + "T00:00:00").toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
              <span>&middot;</span>
              <span>{post.readTime} read</span>
              <span>&middot;</span>
              {post.tags.map((tag) => (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-500">{tag}</span>
              ))}
            </div>
            <h2 class="mt-3 text-xl font-bold text-surface-900 group-hover:text-brand-600">{post.title}</h2>
            <p class="mt-2 text-sm text-surface-500">{post.description}</p>
            <div class="mt-4 flex items-center gap-1 text-sm font-medium text-brand-600">
              Read more
              <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>