---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQ from '../../components/FAQ.astro';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "OpenAI Moderation API: omni-moderation-latest, Categories, Pricing and Limits",
  "description": "A practical guide to the OpenAI Moderation API: what omni-moderation-latest detects, the 13 categories, the response format, whether it is free, and what it leaves to you.",
  "inLanguage": "en",
  "datePublished": "2026-10-20",
  "dateModified": "2026-10-20",
  "author": { "@type": "Organization", "name": "OpenModeration", "url": "https://www.openmoderation.com" },
  "publisher": {
    "@type": "Organization",
    "name": "OpenModeration",
    "logo": { "@type": "ImageObject", "url": "https://www.openmoderation.com/logo.svg" }
  },
  "image": "https://www.openmoderation.com/og-image.jpg",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.openmoderation.com/blog/openai-moderation-api-guide" }
};

const categories = [
  { id: "harassment", desc: "Harassing language towards any target.", inputs: "Text" },
  { id: "harassment/threatening", desc: "Harassment that also includes violence or serious harm towards any target.", inputs: "Text" },
  { id: "hate", desc: "Hate based on race, gender, ethnicity, religion, nationality, sexual orientation, disability or caste. Hateful content aimed at non-protected groups counts as harassment.", inputs: "Text" },
  { id: "hate/threatening", desc: "Hateful content that also includes violence or serious harm towards the targeted group.", inputs: "Text" },
  { id: "illicit", desc: "Advice or instructions on how to commit illicit acts.", inputs: "Text" },
  { id: "illicit/violent", desc: "Illicit content that also references violence or procuring a weapon.", inputs: "Text" },
  { id: "self-harm", desc: "Content that promotes, encourages or depicts acts of self-harm.", inputs: "Text and images" },
  { id: "self-harm/intent", desc: "The speaker expresses that they are engaging, or intend to engage, in self-harm.", inputs: "Text and images" },
  { id: "self-harm/instructions", desc: "Content that encourages self-harm or gives instructions on how to do it.", inputs: "Text and images" },
  { id: "sexual", desc: "Content meant to arouse sexual excitement, or that promotes sexual services (sex education and wellness excluded).", inputs: "Text and images" },
  { id: "sexual/minors", desc: "Sexual content that includes an individual under 18.", inputs: "Text" },
  { id: "violence", desc: "Content that depicts death, violence or physical injury.", inputs: "Text and images" },
  { id: "violence/graphic", desc: "Content that depicts death, violence or physical injury in graphic detail.", inputs: "Text and images" },
];

const curlExample = `curl https://api.openai.com/v1/moderations \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer \$OPENAI_API_KEY" \
  -d '{
    "model": "omni-moderation-latest",
    "input": "The comment you want to check"
  }'`;

const faqItems = [
  {
    question: "Is the OpenAI Moderation API free?",
    answer: "Yes. OpenAI states that the moderation endpoint is free to use. Image inputs can be up to 20 MB.",
  },
  {
    question: "What is omni-moderation-latest?",
    answer: "omni-moderation-latest is OpenAI's current moderation model. It accepts text and image inputs, but it does not classify audio.",
  },
  {
    question: "Which categories does the OpenAI Moderation API detect?",
    answer: "Thirteen: harassment, harassment/threatening, hate, hate/threatening, illicit, illicit/violent, self-harm, self-harm/intent, self-harm/instructions, sexual, sexual/minors, violence and violence/graphic. Six of them also apply to images.",
  },
  {
    question: "What does the OpenAI Moderation API not do?",
    answer: "It returns scores and flags, nothing more. Deciding what to hide, writing your community rules, reviewing borderline cases, explaining each decision to the author and keeping an audit trail for the DSA are left to you. OpenModeration adds that layer on top of omni-moderation-latest and other models.",
  },
];
---

<BaseLayout title="OpenAI Moderation API (omni-moderation): Categories, Pricing" description="How the OpenAI Moderation API works: what omni-moderation-latest detects, the 13 categories, the response format, whether it is free, and what it leaves to you." ogType="article" jsonLd={articleJsonLd}>
<Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog" }, { label: "OpenAI Moderation API guide" }]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="flex items-center gap-3 text-sm text-surface-400">
        <time datetime="2026-10-20">October 20, 2026</time>
        <span>&middot;</span>
        <span>6 min read</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">OpenAI Moderation API: omni-moderation-latest, categories, pricing and limits</h1>
    </div>

    <div class="prose prose-surface max-w-none text-surface-600">
      <p class="text-lg leading-relaxed">
        The OpenAI Moderation API tells you whether a piece of text or an image is potentially harmful,
        and in which category. It is free, quick to call and a common first step for teams that need
        to moderate user content. This guide sums up what it detects, what it returns, and what it
        leaves for you to build.
      </p>

      <h2 class="text-xl font-bold text-surface-900">The short answer</h2>
      <ul>
        <li><strong>Model:</strong> <code>omni-moderation-latest</code>, which accepts text and image inputs. It does not classify audio.</li>
        <li><strong>Price:</strong> free. OpenAI states that "the moderation endpoint is free to use", and image files can be up to 20 MB.</li>
        <li><strong>Output:</strong> a <code>flagged</code> boolean plus, for each category, a boolean and a confidence score between 0 and 1.</li>
        <li><strong>Categories:</strong> 13, six of which also apply to images.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">How to call it</h2>
      <p>
        Send a POST request to the <code>/v1/moderations</code> endpoint with the model name and your input.
      </p>
      <pre class="overflow-x-auto rounded-lg bg-ink-900 p-4 text-sm text-surface-100"><code set:text={curlExample} /></pre>
      <p>
        You can also turn on inline moderation through the <code>moderation</code> parameter of the
        Responses API. In that case the result contains separate <code>input</code> and
        <code>output</code> sections, and either one can be an error object instead of scores.
      </p>

      <h2 class="text-xl font-bold text-surface-900">What the response contains</h2>
      <ul>
        <li><code>flagged</code>: <code>true</code> if the model classifies the content as potentially harmful, <code>false</code> otherwise.</li>
        <li><code>categories</code>: one boolean per category, telling you whether that category is violated.</li>
        <li><code>category_scores</code>: one confidence score per category, from 0 to 1. Higher means more confident.</li>
        <li><code>category_applied_input_types</code>: for each category, which input types (text, image) the score applies to.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">The 13 categories</h2>
      <p>
        When you send only an image, text-only categories return a score of 0.
      </p>
    </div>

    <div class="mt-6 overflow-x-auto rounded-xl border border-surface-200">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="bg-surface-100">
            <th class="px-4 py-3 font-semibold text-surface-900">Category</th>
            <th class="px-4 py-3 font-semibold text-surface-900">What it covers</th>
            <th class="px-4 py-3 font-semibold text-surface-900">Inputs</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-200 bg-white">
          {categories.map((c) => (
            <tr>
              <td class="px-4 py-3 font-mono text-xs text-surface-900">{c.id}</td>
              <td class="px-4 py-3 text-surface-600">{c.desc}</td>
              <td class="px-4 py-3 text-surface-500">{c.inputs}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="prose prose-surface mt-10 max-w-none text-surface-600">
      <h2 class="text-xl font-bold text-surface-900">Points to keep in mind</h2>
      <ul>
        <li>OpenAI warns that custom policies relying on <code>category_scores</code> may need recalibration over time, as the model evolves.</li>
        <li>Scores are not included in partial streamed output deltas when you use inline moderation.</li>
        <li>With tool calls, arguments and tool outputs are moderated, but tool names, descriptions and schemas are not.</li>
        <li>Do not send known or suspected child sexual abuse material to the Moderation API.</li>
      </ul>

      <h2 class="text-xl font-bold text-surface-900">What the Moderation API leaves to you</h2>
      <p>
        A score is not a moderation decision. Once you have it, you still need to decide where to set
        the threshold for each category, what to do with the comments in between, how to apply rules
        that are specific to your community, and how to explain each removal to its author. Under the
        Digital Services Act, hosting services must give a statement of reasons for every removal and
        say whether automated means were used.
      </p>
      <p>
        OpenModeration keeps <code>omni-moderation-latest</code> as one of its models and adds that missing
        layer: rules written in plain language, two thresholds per category with a grey zone for human
        review, a moderation console for your team, a written reason for every decision and a complete
        audit log. If you later want to add or switch to Mistral, Azure or another provider, you do it
        without rewriting your integration.
      </p>
      <p class="text-sm text-surface-400">
        Source: <a href="https://developers.openai.com/api/docs/guides/moderation" class="text-brand-600 hover:text-brand-500" rel="noopener noreferrer" target="_blank">OpenAI Moderation guide</a>, consulted on October 20, 2026.
      </p>
    </div>

    <div class="mt-12">
      <FAQ title="FAQ" items={faqItems} />
    </div>
  </article>

  <section class="border-t border-surface-100 bg-surface-50 py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg font-bold text-surface-900">Keep exploring</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/alternatives/openai-moderation" class="font-medium text-brand-600 hover:text-brand-500">OpenAI Moderation API vs OpenModeration &rarr;</a></li>
        <li><a href="/blog/openai-vs-azure-vs-llama-guard-comparison" class="font-medium text-brand-600 hover:text-brand-500">OpenAI vs Azure vs Llama Guard compared &rarr;</a></li>
        <li><a href="/content-moderation-api" class="font-medium text-brand-600 hover:text-brand-500">One content moderation API for every provider &rarr;</a></li>
        <li><a href="/dsa-compliance" class="font-medium text-brand-600 hover:text-brand-500">What the DSA requires for moderation decisions &rarr;</a></li>
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
