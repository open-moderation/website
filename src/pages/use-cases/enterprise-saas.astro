---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Enterprise SaaS Content Moderation | OpenModeration",
  "description": "Meet enterprise compliance requirements with transparent, EU-hosted content moderation. Ready for the DSA and SOC 2, with full audit trails and team management dashboards."
};

---

<BaseLayout title="Enterprise Content Moderation: EU-Hosted & DSA-Ready" description="Enterprise content moderation for B2B SaaS platforms. EU-hosted, DSA-compliant and SOC 2-ready, with full audit trails and decisions explained in writing." canonical="https://www.openmoderation.com/use-cases/enterprise-saas" jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Use Cases", href: "/use-cases" }, { label: "Enterprise SaaS" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Use Case</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Enterprise SaaS Content Moderation</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">Meet strict enterprise compliance requirements with an AI moderation platform that explains every decision in writing and keeps a full audit trail.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">The Challenge</h3>
          <p class="mt-2 text-sm text-surface-600">B2B SaaS platforms that host user-generated content answer to regulators and to demanding enterprise clients. Manual moderation is hard to audit, and cloud-only SaaS tools don't meet data sovereignty requirements.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">The OpenModeration Solution</h3>
          <p class="mt-2 text-sm text-surface-700">A moderation platform hosted in the EU and set up with our team. Enforce your own compliance rules, get a written reason for every decision and give your Trust & Safety team a dashboard with a full audit trail.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">The Result</h3>
          <p class="mt-2 text-sm text-surface-600">Go into enterprise deals with the evidence ready. Immutable logs show DSA and SOC 2 readiness, your data stays entirely under your control, and moderation grows without weakening security.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Enterprise compliance is non-negotiable</h2>
          <p class="mt-4 text-lg text-surface-500">Enterprise customers expect moderation they can audit, and regulators require it. OpenModeration was designed from the start to meet these standards.</p>
          <div class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">EU</p>
              <p class="text-xs text-surface-500">Data hosted in the European Union</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">100%</p>
              <p class="text-xs text-surface-500">Decisions explained in writing</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">&lt;300ms</p>
              <p class="text-xs text-surface-500">P50 latency per request</p>
            </div>
            <div class="rounded-lg border border-surface-200 p-4 text-center">
              <p class="text-2xl font-bold text-surface-900">10K</p>
              <p class="text-xs text-surface-500">Items per batch request</p>
            </div>
          </div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6 shadow-sm">
            <div class="mb-4 flex items-center justify-between">
              <h3 class="font-semibold text-surface-900">Moderation console</h3>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-700"><span class="flex h-1.5 w-1.5 rounded-full bg-accent-500"></span> All providers operational</span>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Requests today</p>
                <p class="mt-1 text-xl font-bold text-surface-900">84.2K</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Flagged rate</p>
                <p class="mt-1 text-xl font-bold text-surface-900">4.7%</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">P50 latency</p>
                <p class="mt-1 text-xl font-bold text-surface-900">267ms</p>
              </div>
              <div class="rounded-lg border border-surface-200 bg-white p-3">
                <p class="text-xs text-surface-500">Audit exports</p>
                <p class="mt-1 text-xl font-bold text-surface-900">12</p>
              </div>
            </div>
            <div class="mt-4 rounded-lg border border-surface-200 bg-white">
              <div class="flex items-center justify-between border-b border-surface-200 px-4 py-2 text-xs font-semibold text-surface-500">
                <span>AUDIT TRAIL</span>
                <span class="text-accent-600">DSA export ready</span>
              </div>
              <ul class="divide-y divide-surface-100 text-xs">
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXK4&hellip;</span>
                  <span class="text-surface-600">hate <strong class="text-surface-900">0.91</strong> &rarr; deleted</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">openai</span>
                </li>
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXJ9&hellip;</span>
                  <span class="text-surface-600">harassment <strong class="text-surface-900">0.58</strong> &rarr; review</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">azure</span>
                </li>
                <li class="flex items-center justify-between px-4 py-2.5">
                  <span class="font-mono text-surface-400">modr_01JXH2&hellip;</span>
                  <span class="text-surface-600">flagged: false</span>
                  <span class="rounded-full bg-surface-100 px-2 py-0.5 text-surface-500">mistral</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
              <h3 class="font-semibold text-surface-900">Data retention controls</h3>
              <p class="mt-2 text-sm text-surface-500">Set retention to 0, 7, 30 or 90 days. Sensitive content is stored encrypted and fully deleted on request.</p>
            </div>
            <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
              <h3 class="font-semibold text-surface-900">SOC 2 ready</h3>
              <p class="mt-2 text-sm text-surface-500">Audit logs, access controls, and encryption at rest and in transit, designed to fit SOC 2 certification work.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 text-center">Enterprise moderation FAQs</h2>
        <div class="mt-8 divide-y divide-surface-200">
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              Can we run OpenModeration entirely on-premise, including AI?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Yes. On-premise deployment of the platform is possible on request: <a href="https://calendly.com/pierre-logora/60min" class="text-brand-600 hover:text-brand-500" target="_blank" rel="noopener">let's talk</a>. For AI, bring your own keys to cloud providers, or connect any OpenAI-compatible model running inside your own network. Nothing has to leave your perimeter.</p>
          </details>
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              How does OpenModeration help with SOC 2 and DSA audits?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Every moderation decision, AI or human, is logged with provider, scores, matched rule, action and timestamp. Analytics endpoints provide the aggregates for DSA transparency reports, and retention policies are configurable per requirement.</p>
          </details>
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between text-base font-medium text-surface-900">
              How do we manage access across teams and clients?
              <svg class="h-5 w-5 shrink-0 text-surface-400 transition duration-200 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            </summary>
            <p class="mt-3 text-sm text-surface-500">Workspaces isolate content and configuration per team or tenant. Admins issue scoped API keys with rate limits, and the dashboard handles roles and permissions for your human moderators.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Related Resources</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/blog/dsa-compliance-sme-guide" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guide</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA Compliance for Small and Medium Platforms</h3>
          <p class="mt-2 text-sm text-surface-500">Practical steps for SaaS platforms to meet 2026 DSA requirements.</p>
        </a>
        <a href="/alternatives/azure-content-safety" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Comparison</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">OpenModeration vs Azure Content Safety</h3>
          <p class="mt-2 text-sm text-surface-500">Why a full moderation platform with audit trails suits enterprise compliance better than a bare API.</p>
        </a>
        <a href="/features" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Platform</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Explore All Features</h3>
          <p class="mt-2 text-sm text-surface-500">See the Action Engine, team management and automated workflows.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Win enterprise deals with provable moderation."
    subtitle="Keep your data in the EU, export it at any time and walk into audits with immutable logs. Talk to us to set it up."
    buttonText="Try it for free"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>