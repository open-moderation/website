---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import FAQ from '../../components/FAQ.astro';

const faqItems = [
  {
    question: "Can one tool moderate listings, reviews and buyer messages in one place?",
    answer: "Yes. Listings, reviews and buyer-seller messages go through the same API, the same rules and the same review queue, so your Trust & Safety team works from a single dashboard."
  },
  {
    question: "Can it catch off-platform payment requests and scam links in marketplace chats?",
    answer: "Yes. Describe the pattern in plain language as a custom category (\"asks to pay outside the platform\", \"shares an external payment link\") and the AI flags it even when scammers rephrase. Known domains and phrases can also be blocked by the word pre-filter before any AI call."
  },
  {
    question: "How do you avoid wrongly removing legitimate seller listings?",
    answer: "Each rule has two thresholds. Only clear-cut cases are hidden automatically; everything in between goes to human review. Moderators see the reason behind each AI decision, can override it, and every override is logged."
  },
  {
    question: "Can we start with reviews before moderating messages?",
    answer: "Yes. You choose what you send to OpenModeration. Many teams start with one surface such as reviews, check the results in the dashboard, then add listings and messages with the same rules."
  },
  {
    question: "Can I moderate my entire existing catalog?",
    answer: "Yes. The batch endpoint processes up to 10,000 items asynchronously, which works well for a first pass over existing listings, reviews and messages. Results are pushed to your webhook when ready."
  },
  {
    question: "What happens to borderline listings?",
    answer: "You decide per rule: above a threshold, auto-hide or delete; below it, queue for human review in the moderation console. Moderators see the AI's reasoning and can override it, and every override is logged."
  },
];

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "AI Content Moderation for Marketplaces & E-Commerce | OpenModeration",
  "description": "Moderate product listings, reviews, and seller messages on e-commerce and classifieds platforms with AI. DSA-compliant, EU-hosted moderation platform."
};
---

<BaseLayout title="Marketplace Content Moderation: Listings, Reviews & Messages" description="Moderate listings, reviews and buyer-seller messages in one place: catch scams and off-platform payment requests, review edge cases, keep a DSA audit trail." canonical="https://www.openmoderation.com/use-cases/marketplaces" jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Use Cases", href: "/use-cases" }, { label: "Marketplaces" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">Use Case</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">AI Content Moderation for Marketplaces</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">Keep your e-commerce platform safe and compliant by moderating product listings, user reviews and seller messages automatically, at any volume.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">The Challenge</h3>
          <p class="mt-2 text-sm text-surface-600">A single scam listing, fake review or fraudulent message can undo months of trust. Manual moderation can't keep up as the marketplace grows, and rigid keyword filters produce too many false positives.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">The OpenModeration Solution</h3>
          <p class="mt-2 text-sm text-surface-700">AI reads listings and messages in context, and the Action Engine hides high-risk ones automatically. Edge cases go to a review dashboard for your Trust & Safety team.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">The Result</h3>
          <p class="mt-2 text-sm text-surface-600">Your team spends far less time on manual reviews. Full audit trails keep you DSA-compliant, and problems are caught before buyers see them.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Moderate every surface of your platform</h2>
          <p class="mt-4 text-lg text-surface-500">Buyers and sellers talk in listings, reviews and messages, and each needs moderating. OpenModeration covers them all from a single integration.</p>
          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Product listings:</strong> Block prohibited items, detect scam patterns, and flag misleading descriptions before they go live.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Reviews & ratings:</strong> Detect fake reviews, hate speech and spam in user feedback so buyers can trust what they read.</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <p class="text-sm text-surface-600"><strong>Seller messages:</strong> Watch buyer-seller messages for harassment, attempts to move the sale off the platform, and fraud.</p>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-8">
          <h4 class="mb-3 text-sm font-semibold text-surface-900">Batch back-moderation for existing content</h4>
          <p class="text-sm text-surface-500">Cleaning up months of history doesn't have to be a manual project. Submit up to 10,000 existing items in one batch (listings, reviews, messages, descriptions) and OpenModeration flags scams, prohibited items and fake reviews. Results land directly in your review dashboard.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3 py-1 text-xs font-medium text-red-700">
            <span class="flex h-1.5 w-1.5 rounded-full bg-red-500"></span>
            What's at stake
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">One bad listing costs more than a thousand good ones</h2>
          <p class="mt-4 text-lg text-surface-500">
            Buyers who run into a scam or a flood of fake reviews don't come back. Regulators now also watch how fast you remove them.
          </p>
          <ul class="mt-8 space-y-3">
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <p class="text-sm text-surface-600"><strong>Fake reviews:</strong> industry estimates put 30-40% of online reviews as fake or incentivized, eroding buyer trust across your whole catalog.</p>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <p class="text-sm text-surface-600"><strong>Scam listings:</strong> prohibited items, counterfeit goods, and payment-diversion schemes slip past rigid keyword filters.</p>
            </li>
            <li class="flex items-start gap-3">
              <svg class="mt-1 h-5 w-5 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              <p class="text-sm text-surface-600"><strong>DSA pressure:</strong> marketplaces operating in the EU must act on illegal content and report on it. Fines can reach 6% of global turnover.</p>
            </li>
          </ul>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-surface-900">Auto-enforce your marketplace policy</h3>
          <BrowserFrame
            src="/images/rules.png"
            video="om-rules"
            alt="open-moderation dashboard: rules configuration with category thresholds and automated actions"
          />
          <p class="mt-4 text-sm text-surface-500">Clear scams are hidden instantly, and borderline cases land in the review queue for your Trust &amp; Safety team. Every decision is logged for DSA compliance.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ items={faqItems} title="Marketplace moderation FAQs" />
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Related Resources</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/blog/dsa-compliance-sme-guide" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Guide</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA Compliance for Small and Medium Platforms</h3>
          <p class="mt-2 text-sm text-surface-500">Practical steps for marketplaces to meet 2026 DSA requirements.</p>
        </a>
        <a href="/alternatives/azure-content-safety" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Comparison</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">OpenModeration vs Azure Content Safety</h3>
          <p class="mt-2 text-sm text-surface-500">Why e-commerce platforms need a full moderation platform rather than a standalone API.</p>
        </a>
        <a href="/features" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Platform</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Explore All Features</h3>
          <p class="mt-2 text-sm text-surface-500">See the Action Engine, team management and automated workflows.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection
    title="Keep your marketplace trustworthy."
    subtitle="Screen listings, reviews and messages automatically. Your data stays in the managed EU cloud."
    buttonText="Try it for free"
    buttonHref="https://app.openmoderation.com/signup"
  />
</BaseLayout>