---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharterSupport from '../../components/CharterSupport.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import FAQ from '../../components/FAQ.astro';

const useCaseJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Comment Moderation for News Publishers and Media Websites",
  "description": "AI comment moderation for news sites and newsrooms: moderation adapted to your editorial rules on every article, a written reason for each removed comment, doubtful cases handled by our team and a DSA audit trail.",
  "about": { "@id": "https://www.openmoderation.com/#software" }
};

const faqItems = [
  {
    question: "Do news websites have to comply with the DSA for their comment sections?",
    answer: "Comment sections host content posted by readers, so a news site that runs them acts as a hosting service under the Digital Services Act. Article 17 requires a clear statement of reasons whenever a comment is removed or restricted, including whether automated means were used. OpenModeration writes that statement for every decision and keeps it in the audit trail.",
  },
  {
    question: "Can moderation follow our own editorial rules?",
    answer: "Yes. We adapt the moderation to your editorial rules and use cases, written in plain language, and OpenModeration applies them to every comment. A sports desk and a politics desk can have different rules, and you can tighten or loosen a rule at any time without code.",
  },
  {
    question: "What happens with borderline comments?",
    answer: "Each category has two thresholds. Clear violations are hidden automatically, clearly acceptable comments are published, and everything in between is reviewed by our team. Your journalists see every decision in real time and can step in with one click.",
  },
  {
    question: "Can journalists keep moderating from the article page?",
    answer: "Yes. Decisions taken by our team or by your newsroom are recorded in the same activity history as automatic decisions, so you keep a single, complete record of who decided what and why.",
  },
  {
    question: "Where is the data hosted?",
    answer: "OpenModeration is built and hosted in the European Union and is GDPR-compliant. On-premise deployment is possible on request.",
  },
];
---

<BaseLayout title="Comment Moderation for News Publishers & Media Websites" description="Moderate reader comments with AI adapted to your editorial rules. A written reason for each removal, doubtful cases handled by our team, a DSA audit trail." jsonLd={useCaseJsonLd}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Use Cases", href: "/use-cases" }, { label: "News Publishers" }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">
        Use Case
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Comment moderation for news publishers</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">
        Reader comments make an article live, until insults and spam take over the thread. OpenModeration applies your editorial rules to every comment, explains each removal in writing, and our team handles the hard cases.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/book-a-call" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-500">Book a call</a>
        <a href="https://app.openmoderation.com/signup" class="inline-flex items-center justify-center rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">Try it free</a>
      </div>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">The challenge</h3>
          <p class="mt-2 text-sm text-surface-600">A busy news site receives comments around the clock, with peaks on every breaking story. Journalists cannot read them all, and keyword filters miss sarcasm, coded insults and off-topic attacks while blocking legitimate criticism.</p>
        </div>
        <div class="rounded-xl border border-brand-200 bg-brand-50 p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-brand-700">The OpenModeration approach</h3>
          <p class="mt-2 text-sm text-surface-700">Context-aware AI reads each comment against your rules. Clear violations are hidden at once, acceptable comments go live, and borderline ones are reviewed by our team, with the rule at stake and a written reason.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
          <h3 class="text-lg font-semibold text-surface-900">The result</h3>
          <p class="mt-2 text-sm text-surface-600">Your newsroom has nothing to do: our team handles the comments that need a human judgement, and you see every decision in real time. Every decision, automatic or editorial, is logged with its reason, ready for a reader appeal or a regulator.</p>
        </div>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Built for the way newsrooms work</h2>
          <p class="mt-4 text-lg text-surface-500">
            Moderating a comment section is an editorial decision. OpenModeration keeps your rules in charge: our AI and our team do the moderating, and your newsroom can step in at any moment.
          </p>
          <div class="mt-8 space-y-3">
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Your rules, in plain language</p>
              <p class="mt-1 text-xs text-surface-500">Write the rules your readers already know. No keyword lists to maintain, no code to change when the line moves.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">A grey zone for human judgement</p>
              <p class="mt-1 text-xs text-surface-500">Two thresholds per category separate what is hidden automatically from what our team reviews. You decide how wide the grey zone is.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">One history for AI and newsroom decisions</p>
              <p class="mt-1 text-xs text-surface-500">Removals made by journalists sit next to automatic ones in the activity log, with the moderator who took them and the reason.</p>
            </div>
            <div class="rounded-lg border border-surface-200 bg-surface-50 p-4">
              <p class="text-sm font-medium text-surface-900">Article comments and social pages together</p>
              <p class="mt-1 text-xs text-surface-500">Moderate your website through the API or the WordPress connector, and the comments under your Facebook, Instagram and YouTube posts from the same console.</p>
            </div>
          </div>
        </div>
        <BrowserFrame
          src="/images/dashboard.png"
          video="om-triage"
          alt="OpenModeration moderation queue with reader comments, their status and the action taken"
          caption="The console: each comment with its status, the rule involved and the written reason."
        />
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">Why publishers choose OpenModeration</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">A statement of reasons for every removal</h3>
          <p class="mt-2 text-sm text-surface-500">The DSA requires hosting services to explain each removal. OpenModeration writes that explanation automatically, so readers know which rule they broke.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">Built and hosted in the EU</h3>
          <p class="mt-2 text-sm text-surface-500">Reader data stays in Europe and the platform is GDPR-compliant. On-premise deployment is possible on request if your legal team requires it.</p>
        </div>
        <div class="rounded-xl border border-surface-200 bg-white p-6">
          <h3 class="font-semibold text-surface-900">No black box</h3>
          <p class="mt-2 text-sm text-surface-500">Every decision comes with a written reason and a full audit trail. When a better AI model comes out, we plug it in: nothing changes in your integration.</p>
        </div>
      </div>
    </div>
  </section>

  <CharterSupport />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title="Frequently asked questions" items={faqItems} />
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">Related resources</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/dsa-compliance" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Regulation</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">DSA compliance</h3>
          <p class="mt-2 text-sm text-surface-500">What the Digital Services Act requires from sites that host comments, and how to meet it.</p>
        </a>
        <a href="/product/transparency" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Platform</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">Every decision explained</h3>
          <p class="mt-2 text-sm text-surface-500">How OpenModeration writes a reason for each moderation decision.</p>
        </a>
        <a href="/integrations/wordpress" class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
          <div class="mb-2 text-xs font-medium text-brand-600">Integration</div>
          <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">WordPress comment moderation</h3>
          <p class="mt-2 text-sm text-surface-500">Moderate the comments on a WordPress news site without writing code.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection title="Give your comment section back to your readers." subtitle="Tell us your rules and connect your site: we take care of the rest, and you see every decision in real time." />
</BaseLayout>
