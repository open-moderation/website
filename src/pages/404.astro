---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — OpenModeration"
  description="The page you're looking for doesn't exist or has been moved. Back to protecting your community."
  robots="noindex, nofollow"
>
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">Page not found</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-surface-500">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/" class="rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm">
          Back to home
        </a>
        <a href="/features" class="rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">
          See features
        </a>
        <a href="/pricing" class="rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700">
          See pricing
        </a>
      </div>
      <div class="mx-auto mt-10 max-w-md text-sm text-surface-500">
        <p class="font-semibold text-surface-700">Popular pages</p>
        <p class="mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
          <a href="/how-it-works" class="text-brand-600 hover:text-brand-500">How it works</a>
          <a href="/product/transparency" class="text-brand-600 hover:text-brand-500">Transparency</a>
          <a href="/dsa-compliance" class="text-brand-600 hover:text-brand-500">DSA compliance</a>
          <a href="/faq" class="text-brand-600 hover:text-brand-500">FAQ</a>
          <a href="/blog" class="text-brand-600 hover:text-brand-500">Blog</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>