---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLocale } from '../i18n/routes';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, any>;
  robots?: string;
}

const { title, description, canonical, ogImage, ogType, jsonLd, robots } = Astro.props;
const locale = getLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={locale}>
  <head>
    <SEOHead {title} {description} {canonical} {ogImage} {ogType} {jsonLd} {robots} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Fait apparaître titres et cartes au défilement ; sans JS, tout reste visible.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const targets = document.querySelectorAll('main section:not(:first-child) h2, main section:not(:first-child) .grid > *');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach((el, i) => {
          if (el.getBoundingClientRect().top < innerHeight) return;
          el.classList.add('reveal');
          (el as HTMLElement).style.transitionDelay = `${(i % 4) * 70}ms`;
          io.observe(el);
        });
      }
    </script>
  </body>
</html>