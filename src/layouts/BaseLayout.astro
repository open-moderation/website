---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLocale, localizePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, any>;
  robots?: string;
}

const { title, description, canonical, ogImage, ogType, jsonLd, robots } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const bookPath = localizePath('/book-a-call', locale);
const onBookPage = Astro.url.pathname.replace(/\/$/, '') === bookPath;
---

<!doctype html>
<html lang={locale}>
  <head>
    <SEOHead {title} {description} {canonical} {ogImage} {ogType} {jsonLd} {robots} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {!onBookPage && (
      <a href={bookPath} class="om-sticky-book fixed left-4 right-4 z-40 flex items-center justify-center gap-3 rounded-2xl bg-gradient-to-r from-brand-600 via-violet-600 to-rose-500 px-5 py-3 text-white shadow-[0_18px_40px_-12px_rgba(124,58,237,0.6)] transition sm:left-auto sm:right-6 sm:bottom-6 sm:rounded-full" aria-label={t('cta.book')}>
        <span class="text-lg" aria-hidden="true">📅</span>
        <span class="flex flex-col leading-tight">
          <span class="text-sm font-bold">{t('cta.book')}</span>
          <span class="text-xs font-medium text-white/85">{t('cta.bookHint')}</span>
        </span>
      </a>
    )}
    <script>
      // Le bouton de rendez-vous flottant apparaît après un peu de lecture. Il s'efface dès qu'un autre appel à
      // prendre rendez-vous, le résultat de la démo, un formulaire ou le pied de page est à l'écran, et pendant la saisie.
      const sticky = document.querySelector<HTMLElement>('.om-sticky-book');
      if (sticky) {
        const bookHref = sticky.getAttribute('href') || '';
        const visible = new Set<Element>();
        let typing = false;
        const update = () => sticky.classList.toggle('is-shown', scrollY > 700 && visible.size === 0 && !typing);
        const watched = Array.from(document.querySelectorAll<HTMLElement>(
          'footer, form, .om-demo-result, [data-cta-section], a[href*="calendly.com"], iframe[src*="calendly.com"]'
        )).concat(Array.from(document.querySelectorAll<HTMLAnchorElement>('main a[href]')).filter((a) => {
          const href = (a.getAttribute('href') || '').replace(/\/$/, '');
          return href !== '' && href === bookHref.replace(/\/$/, '');
        }));
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
            update();
          });
          watched.filter((el) => !el.closest('nav, header') && el !== sticky).forEach((el) => io.observe(el));
        }
        document.addEventListener('focusin', (e) => { typing = (e.target as HTMLElement).matches('input, textarea, select'); update(); });
        document.addEventListener('focusout', () => { typing = false; update(); });
        addEventListener('scroll', update, { passive: true });
        update();
      }

      // Mesure des conversions dans Umami : ouverture de l'agenda, réservation confirmée, clics vers la page de rendez-vous.
      // Langue et type de page joints à chaque événement, pour lire le parcours par langue et par type de page.
      const seg = location.pathname.split('/').filter(Boolean);
      const lang = ['fr', 'es', 'de', 'it', 'pt', 'pl', 'nl'].includes(seg[0]) ? seg[0] : 'en';
      const rest = (lang === 'en' ? seg : seg.slice(1)).join('/');
      const pageType =
        rest === '' ? 'home'
        : /^(alternatives|alternativas|alternativen|alternative|alternatywy|alternatieven)(\/|$)/.test(rest) ? 'comparison'
        : /^blog(\/|$)/.test(rest) ? 'guide'
        : /^(glossary|lexique|glosario|glossar|glossario|slownik|woordenlijst)(\/|$)/.test(rest) ? 'glossary'
        : /^(use-cases|cas-usage|casos-de-uso|anwendungsfaelle|casi-d-uso|zastosowania|toepassingen)(\/|$)/.test(rest) ? 'sector'
        : /^(pricing|tarifs|precios|preise|prezzi|precos|cennik|prijzen)$/.test(rest) ? 'pricing'
        : /(book-a-call|rendez-vous|reservar-llamada|termin-vereinbaren|prenota-una-call|agendar|umow|afspraak)/.test(rest) ? 'booking'
        : 'product';
      const track = (name: string, data?: Record<string, string>) => (window as any).umami?.track(name, { lang, pageType, ...data });
      addEventListener('message', (e) => {
        if (e.origin === 'https://calendly.com' && e.data?.event === 'calendly.event_scheduled') track('booking_scheduled', { page: location.pathname });
      });
      document.addEventListener('click', (event) => {
        const a = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        if (/\/(book-a-call|rendez-vous|reservar-llamada|termin-vereinbaren|prenota-una-call|agendar-reuniao|umow-rozmowe|afspraak-maken)$/.test(href)) track('booking_page_click', { page: location.pathname, from: a.classList.contains('om-sticky-book') ? 'sticky' : 'link' });
        if (href.startsWith('https://app.openmoderation.com/signup')) track('signup_click', { page: location.pathname });
      });

      // Les liens Calendly s'ouvrent par-dessus le site ; si le widget ne charge pas, on ouvre un nouvel onglet.
      let calendly: Promise<void> | null = null;
      const loadCalendly = () => calendly ??= new Promise<void>((resolve, reject) => {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://assets.calendly.com/assets/external/widget.css';
        document.head.append(css);
        const js = document.createElement('script');
        js.src = 'https://assets.calendly.com/assets/external/widget.js';
        js.onload = () => resolve();
        js.onerror = () => reject();
        document.head.append(js);
      });
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="https://calendly.com/"]');
        if (!link) return;
        track('booking_open', { page: location.pathname });
        if (link.hasAttribute('data-no-popup') || event.metaKey || event.ctrlKey) return;
        event.preventDefault();
        loadCalendly()
          .then(() => (window as any).Calendly.initPopupWidget({ url: `${link.href}?hide_gdpr_banner=1&primary_color=7c3aed` }))
          .catch(() => window.open(link.href, '_blank', 'noopener'));
      });
    </script>
    <script>
      // Les vidéos ne se téléchargent et ne démarrent qu'une fois visibles, puis se mettent en pause hors de l'écran.
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const vo = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else { v.pause(); }
          });
        }, { rootMargin: '200px 0px' });
        videos.forEach((v) => vo.observe(v));
      } else {
        videos.forEach((v) => v.setAttribute('controls', ''));
      }
    </script>
    <script>
      // Fait apparaître titres et cartes au défilement ; sans JS, tout reste visible.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const targets = document.querySelectorAll('main section:not(:first-child) h2, main section:not(:first-child) .grid > *');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach((el, i) => {
          if (el.getBoundingClientRect().top < innerHeight) return;
          el.classList.add('reveal');
          (el as HTMLElement).style.transitionDelay = `${(i % 4) * 70}ms`;
          io.observe(el);
        });
      }
    </script>
  </body>
</html>