---
import { getLocale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(getLocale(Astro.url.pathname));

const clients = [
  { name: "L'Équipe", src: '/images/clients/lequipe.svg', width: 136, height: 24 },
  { name: 'Challenges', src: '/images/clients/challenges.svg', width: 95, height: 24 },
  { name: 'Sud Ouest', src: '/images/clients/sudouest.svg', width: 91, height: 24 },
  { name: 'actu.fr', src: '/images/clients/actu.svg', width: 84, height: 24 },
  { name: 'Estadão', src: '/images/clients/estadao.svg', width: 96, height: 24 },
  { name: 'Südkurier', src: '/images/clients/suedkurier.svg', width: 122, height: 20 },
  { name: 'Egora', src: '/images/clients/egora.svg', width: 94, height: 32 },
];
---

<div class="flex flex-col items-center gap-5">
  <p class="text-xs font-medium uppercase tracking-wider text-surface-400">{t('trust.title')}</p>
  <ul class="flex max-w-5xl flex-wrap items-center justify-center gap-x-10 gap-y-5">
    {clients.map((client) => (
      <li>
        <img src={client.src} alt={client.name} width={client.width} height={client.height} loading="lazy" decoding="async" class="w-auto" style={`height: ${client.height}px`} />
      </li>
    ))}
  </ul>
</div>
