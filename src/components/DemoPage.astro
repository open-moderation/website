---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import ModerationDemo from './ModerationDemo.astro';
import CharterSupport from './CharterSupport.astro';
import ClientLogos from './ClientLogos.astro';
import CTASection from './CTASection.astro';
import { getLocale, localizePath } from '../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const copy = {
  en: {
    title: 'Test AI Comment Moderation Live | OpenModeration',
    description: 'Paste a comment, adjust the moderation rules and see the decision with its written reason in seconds. Free live demo, no sign-up.',
    home: 'Home',
    crumb: 'Live demo',
    eyebrow: 'Live demo, no sign-up',
    h1: 'Test the moderation on your own comments',
    intro: 'Paste a comment from your site or your Facebook page, change the rules if you like, and see what OpenModeration decides and why.',
    pointsTitle: 'What the demo shows',
    points: [
      { title: 'Your rules, in plain words', text: 'Edit the rules and run the same comment again: the decision follows what you wrote.' },
      { title: 'The context of the post', text: 'Add the title of the article or post. The same sentence does not weigh the same under every story.' },
      { title: 'A reason for every decision', text: 'Each rejected comment comes with a written explanation you could show its author.' },
    ],
  },
  fr: {
    title: 'Tester la modération des commentaires par IA en direct',
    description: "Collez un commentaire, ajustez les règles et voyez la décision et son explication écrite en quelques secondes. Démo gratuite, sans inscription.",
    home: 'Accueil',
    crumb: 'Démo en direct',
    eyebrow: 'Démo en direct, sans inscription',
    h1: 'Testez la modération sur vos propres commentaires',
    intro: "Collez un commentaire de votre site ou de votre page Facebook, modifiez les règles si vous le souhaitez, et voyez ce qu'OpenModeration décide et pourquoi.",
    pointsTitle: 'Ce que montre la démo',
    points: [
      { title: 'Vos règles, en langage courant', text: 'Modifiez les règles et relancez le même commentaire : la décision suit ce que vous avez écrit.' },
      { title: 'Le contexte de la publication', text: "Ajoutez le titre de l'article ou de la publication. Une même phrase ne pèse pas pareil sous chaque sujet." },
      { title: 'Une explication pour chaque décision', text: 'Chaque commentaire rejeté reçoit une explication écrite que vous pourriez montrer à son auteur.' },
    ],
  },
  es: {
    title: 'Prueba en directo la moderación de comentarios con IA',
    description: 'Pega un comentario, ajusta las reglas y ve la decisión con su explicación por escrito en segundos. Demo gratuita, sin registro.',
    home: 'Inicio',
    crumb: 'Demo en directo',
    eyebrow: 'Demo en directo, sin registro',
    h1: 'Prueba la moderación con tus propios comentarios',
    intro: 'Pega un comentario de tu web o de tu página de Facebook, cambia las reglas si quieres y comprueba qué decide OpenModeration y por qué.',
    pointsTitle: 'Qué muestra la demo',
    points: [
      { title: 'Tus reglas, en lenguaje natural', text: 'Edita las reglas y vuelve a probar el mismo comentario: la decisión sigue lo que has escrito.' },
      { title: 'El contexto de la publicación', text: 'Añade el título del artículo o de la publicación. Una misma frase no pesa igual en todas las noticias.' },
      { title: 'Una explicación para cada decisión', text: 'Cada comentario rechazado llega con una explicación por escrito que podrías enseñar a su autor.' },
    ],
  },
  de: {
    title: 'KI-Kommentarmoderation live testen | OpenModeration',
    description: 'Kommentar einfügen, Regeln anpassen und in Sekunden die Entscheidung mit schriftlicher Begründung sehen. Kostenlose Live-Demo ohne Anmeldung.',
    home: 'Startseite',
    crumb: 'Live-Demo',
    eyebrow: 'Live-Demo ohne Anmeldung',
    h1: 'Testen Sie die Moderation mit Ihren eigenen Kommentaren',
    intro: 'Fügen Sie einen Kommentar von Ihrer Website oder Ihrer Facebook-Seite ein, passen Sie bei Bedarf die Regeln an und sehen Sie, was OpenModeration entscheidet und warum.',
    pointsTitle: 'Was die Demo zeigt',
    points: [
      { title: 'Ihre Regeln, in Alltagssprache', text: 'Ändern Sie die Regeln und prüfen Sie denselben Kommentar erneut: Die Entscheidung folgt dem, was Sie geschrieben haben.' },
      { title: 'Der Kontext des Beitrags', text: 'Geben Sie den Titel des Artikels oder Beitrags an. Derselbe Satz wiegt nicht unter jedem Thema gleich.' },
      { title: 'Eine Begründung für jede Entscheidung', text: 'Jeder abgelehnte Kommentar erhält eine schriftliche Begründung, die Sie dem Verfasser zeigen könnten.' },
    ],
  },
  it: {
    title: 'Prova dal vivo la moderazione dei commenti con IA',
    description: 'Incolla un commento, modifica le regole e vedi in pochi secondi la decisione con la motivazione scritta. Demo gratuita, senza registrazione.',
    home: 'Home',
    crumb: 'Demo dal vivo',
    eyebrow: 'Demo dal vivo, senza registrazione',
    h1: 'Prova la moderazione sui tuoi commenti',
    intro: 'Incolla un commento dal tuo sito o dalla tua pagina Facebook, modifica le regole se vuoi e scopri cosa decide OpenModeration e perché.',
    pointsTitle: 'Cosa mostra la demo',
    points: [
      { title: 'Le tue regole, in linguaggio naturale', text: 'Modifica le regole e riprova lo stesso commento: la decisione segue quello che hai scritto.' },
      { title: 'Il contesto del post', text: "Aggiungi il titolo dell'articolo o del post. La stessa frase non pesa allo stesso modo sotto ogni notizia." },
      { title: 'Una motivazione per ogni decisione', text: 'Ogni commento rifiutato riceve una motivazione scritta che potresti mostrare al suo autore.' },
    ],
  },
}[locale];

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.title,
  description: copy.description,
  inLanguage: locale,
  about: { '@id': 'https://www.openmoderation.com/#software' },
};
---

<BaseLayout title={copy.title} description={copy.description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: copy.home, href: localizePath('/', locale) }, { label: copy.crumb }]} />
  <section class="bg-surface-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-brand-700">{copy.eyebrow}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{copy.h1}</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{copy.intro}</p>
      </div>
      <ModerationDemo />
      <div class="mt-12">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">{copy.pointsTitle}</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {copy.points.map((p) => (
          <div class="rounded-xl border border-surface-200 bg-surface-50 p-6">
            <h3 class="text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-surface-600">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CharterSupport />
  <CTASection />
</BaseLayout>
