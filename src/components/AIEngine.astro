---
import { getLocale } from '../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const copyAll = {
  en: {
    eyebrow: 'Our AI engine',
    title: 'An AI that keeps up with the market instead of ageing',
    text: 'Many moderation tools rely on a single in-house algorithm, frozen between two updates. OpenModeration works differently.',
    points: [
      { title: 'Our own moderation AI', text: 'Trained for comment moderation and set up on your rules and your use cases.' },
      { title: 'Cross-checked by other AIs', text: 'On delicate cases, other AI models arbitrate the decision before it is applied. Fewer mistakes, fewer wrongly hidden comments.' },
      { title: 'Plugged into the best of the market', text: 'When a better or cheaper AI model comes out, we plug it in quickly. Nothing changes on your side.' },
      { title: 'You benefit from AI progress', text: 'AI models get better and cheaper every year. Our architecture lets you benefit from it, instead of staying stuck on yesterday’s model.' },
    ],
    flow: { comment: 'Comment', ours: 'OpenModeration AI', judges: 'Arbitration by other AIs', decision: 'Decision + written reason', newModel: 'New model on the market', plugged: 'plugged in' },
  },
  fr: {
    eyebrow: 'Notre moteur d’IA',
    title: 'Une IA qui suit le marché, au lieu de vieillir',
    text: 'Beaucoup d’outils de modération reposent sur un seul algorithme maison, figé entre deux mises à jour. OpenModeration fonctionne autrement.',
    points: [
      { title: 'Notre propre IA de modération', text: 'Entraînée pour la modération des commentaires et paramétrée selon vos règles et vos cas d’usage.' },
      { title: 'Arbitrée par d’autres IA', text: 'Sur les cas délicats, d’autres modèles d’IA arbitrent la décision avant qu’elle soit appliquée. Moins d’erreurs, moins de commentaires masqués à tort.' },
      { title: 'Branchée sur le meilleur du marché', text: 'Quand un nouveau modèle d’IA plus performant ou moins cher sort, on le branche rapidement. Rien ne change de votre côté.' },
      { title: 'Vous profitez des progrès de l’IA', text: 'Les modèles d’IA deviennent chaque année meilleurs et moins chers. Notre architecture vous en fait profiter, au lieu de rester bloqué sur le modèle d’hier.' },
    ],
    flow: { comment: 'Commentaire', ours: 'IA OpenModeration', judges: 'Arbitrage par d’autres IA', decision: 'Décision + explication écrite', newModel: 'Nouveau modèle sur le marché', plugged: 'branché' },
  },
  es: {
    eyebrow: 'Nuestro motor de IA',
    title: 'Una IA que sigue al mercado en lugar de envejecer',
    text: 'Muchas herramientas de moderación dependen de un único algoritmo propio, congelado entre dos actualizaciones. OpenModeration funciona de otra manera.',
    points: [
      { title: 'Nuestra propia IA de moderación', text: 'Entrenada para moderar comentarios y configurada según tus reglas y tus casos de uso.' },
      { title: 'Arbitrada por otras IA', text: 'En los casos delicados, otros modelos de IA arbitran la decisión antes de aplicarla. Menos errores, menos comentarios ocultados por error.' },
      { title: 'Conectada a lo mejor del mercado', text: 'Cuando sale un modelo de IA mejor o más barato, lo conectamos rápido. No cambia nada por tu parte.' },
      { title: 'Aprovechas el progreso de la IA', text: 'Los modelos de IA mejoran y se abaratan cada año. Nuestra arquitectura te permite aprovecharlo, en lugar de quedarte con el modelo de ayer.' },
    ],
    flow: { comment: 'Comentario', ours: 'IA de OpenModeration', judges: 'Arbitraje por otras IA', decision: 'Decisión + explicación escrita', newModel: 'Nuevo modelo en el mercado', plugged: 'conectado' },
  },
  de: {
    eyebrow: 'Unsere KI-Engine',
    title: 'Eine KI, die mit dem Markt geht, statt zu veralten',
    text: 'Viele Moderationstools beruhen auf einem einzigen hauseigenen Algorithmus, der zwischen zwei Updates stillsteht. OpenModeration arbeitet anders.',
    points: [
      { title: 'Unsere eigene Moderations-KI', text: 'Für die Kommentarmoderation trainiert und nach Ihren Regeln und Anwendungsfällen eingerichtet.' },
      { title: 'Von anderen KIs überprüft', text: 'Bei heiklen Fällen prüfen weitere KI-Modelle die Entscheidung, bevor sie angewendet wird. Weniger Fehler, weniger zu Unrecht ausgeblendete Kommentare.' },
      { title: 'Mit dem Besten des Marktes verbunden', text: 'Kommt ein besseres oder günstigeres KI-Modell heraus, binden wir es schnell an. Für Sie ändert sich nichts.' },
      { title: 'Sie profitieren vom KI-Fortschritt', text: 'KI-Modelle werden jedes Jahr besser und günstiger. Unsere Architektur lässt Sie davon profitieren, statt auf dem Modell von gestern stehen zu bleiben.' },
    ],
    flow: { comment: 'Kommentar', ours: 'OpenModeration-KI', judges: 'Prüfung durch andere KIs', decision: 'Entscheidung + Begründung', newModel: 'Neues Modell auf dem Markt', plugged: 'angebunden' },
  },
  it: {
    eyebrow: 'Il nostro motore di IA',
    title: 'Un’IA che segue il mercato invece di invecchiare',
    text: 'Molti strumenti di moderazione si basano su un unico algoritmo proprietario, fermo tra un aggiornamento e l’altro. OpenModeration funziona diversamente.',
    points: [
      { title: 'La nostra IA di moderazione', text: 'Addestrata per moderare i commenti e configurata sulle tue regole e sui tuoi casi d’uso.' },
      { title: 'Arbitrata da altre IA', text: 'Sui casi delicati, altri modelli di IA arbitrano la decisione prima che venga applicata. Meno errori, meno commenti nascosti per sbaglio.' },
      { title: 'Collegata al meglio del mercato', text: 'Quando esce un modello di IA migliore o più economico, lo colleghiamo rapidamente. Per te non cambia nulla.' },
      { title: 'Approfitti dei progressi dell’IA', text: 'I modelli di IA migliorano e costano meno ogni anno. La nostra architettura te ne fa approfittare, invece di restare fermo al modello di ieri.' },
    ],
    flow: { comment: 'Commento', ours: 'IA OpenModeration', judges: 'Arbitraggio di altre IA', decision: 'Decisione + motivazione scritta', newModel: 'Nuovo modello sul mercato', plugged: 'collegato' },
  },
  pt: {
    eyebrow: 'Nosso motor de IA',
    title: 'Uma IA que acompanha o mercado em vez de envelhecer',
    text: 'Muitas ferramentas de moderação dependem de um único algoritmo próprio, parado entre uma atualização e outra. A OpenModeration funciona de outro jeito.',
    points: [
      { title: 'Nossa própria IA de moderação', text: 'Treinada para moderar comentários e configurada de acordo com as suas regras e os seus casos de uso.' },
      { title: 'Validada por outras IAs', text: 'Nos casos delicados, outros modelos de IA arbitram a decisão antes de ela ser aplicada. Menos erros, menos comentários ocultados por engano.' },
      { title: 'Conectada ao melhor do mercado', text: 'Quando surge um modelo de IA melhor ou mais barato, nós o conectamos rapidamente. Nada muda do seu lado.' },
      { title: 'Você aproveita a evolução da IA', text: 'Os modelos de IA ficam melhores e mais baratos a cada ano. Nossa arquitetura permite que você aproveite isso, em vez de ficar preso ao modelo de ontem.' },
    ],
    flow: { comment: 'Comentário', ours: 'IA da OpenModeration', judges: 'Arbitragem por outras IAs', decision: 'Decisão + justificativa por escrito', newModel: 'Novo modelo no mercado', plugged: 'conectado' },
  },
  pl: {
    eyebrow: 'Nasz silnik AI',
    title: 'AI, która nadąża za rynkiem, zamiast się starzeć',
    text: 'Wiele narzędzi do moderacji opiera się na jednym własnym algorytmie, który stoi w miejscu między kolejnymi aktualizacjami. OpenModeration działa inaczej.',
    points: [
      { title: 'Własna AI do moderacji', text: 'Wytrenowana do moderacji komentarzy i skonfigurowana według Państwa reguł i przypadków użycia.' },
      { title: 'Weryfikowana przez inne modele AI', text: 'W trudnych przypadkach inne modele AI rozstrzygają decyzję, zanim zostanie zastosowana. Mniej błędów, mniej niesłusznie ukrytych komentarzy.' },
      { title: 'Połączona z najlepszymi modelami na rynku', text: 'Gdy pojawia się lepszy lub tańszy model AI, szybko go podłączamy. Po Państwa stronie nic się nie zmienia.' },
      { title: 'Korzyści z postępu AI', text: 'Modele AI co roku są lepsze i tańsze. Nasza architektura pozwala z tego korzystać, zamiast utknąć na wczorajszym modelu.' },
    ],
    flow: { comment: 'Komentarz', ours: 'AI OpenModeration', judges: 'Weryfikacja przez inne modele AI', decision: 'Decyzja + pisemne uzasadnienie', newModel: 'Nowy model na rynku', plugged: 'podłączony' },
  },
  nl: {
    eyebrow: 'Onze AI-engine',
    title: 'Een AI die met de markt meegaat in plaats van te verouderen',
    text: 'Veel moderatietools draaien op één eigen algoritme dat tussen twee updates stilstaat. OpenModeration werkt anders.',
    points: [
      { title: 'Onze eigen moderatie-AI', text: 'Getraind op het modereren van reacties en ingericht op jouw regels en jouw use cases.' },
      { title: 'Gecontroleerd door andere AI’s', text: 'Bij lastige gevallen beoordelen andere AI-modellen de beslissing voordat die wordt toegepast. Minder fouten, minder reacties die onterecht verborgen worden.' },
      { title: 'Aangesloten op het beste van de markt', text: 'Komt er een beter of goedkoper AI-model uit, dan sluiten we het snel aan. Voor jou verandert er niets.' },
      { title: 'Jij profiteert van de vooruitgang in AI', text: 'AI-modellen worden elk jaar beter en goedkoper. Dankzij onze architectuur profiteer jij daarvan, in plaats van vast te zitten aan het model van gisteren.' },
    ],
    flow: { comment: 'Reactie', ours: 'OpenModeration-AI', judges: 'Controle door andere AI’s', decision: 'Beslissing + schriftelijke toelichting', newModel: 'Nieuw model op de markt', plugged: 'aangesloten' },
  },
};
const copy = copyAll[locale as keyof typeof copyAll] ?? copyAll.en;

const tiles = ['bg-violet-500', 'bg-rose-500', 'bg-sun-400', 'bg-mint-500'];
const emojis = ['🧠', '⚖️', '🔌', '📉'];
---

<section class="bg-ink-900 py-14 sm:py-20">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div>
      <p class="mb-4 inline-flex rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white ring-1 ring-white/20">⚡ {copy.eyebrow}</p>
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{copy.title}</h2>
      <p class="mt-4 text-base text-white/80 sm:text-lg">{copy.text}</p>
      <ul class="om-carousel mt-6 grid gap-4 sm:mt-8 sm:grid-cols-2">
        {copy.points.map((pt, i) => (
          <li class="om-card border-white/15 bg-white/8 !p-5 shadow-none">
            <span class={`mb-3 flex h-10 w-10 items-center justify-center rounded-xl text-lg ${tiles[i]}`} aria-hidden="true">{emojis[i]}</span>
            <p class="font-semibold text-white">{pt.title}</p>
            <p class="mt-1 text-sm leading-relaxed text-white/75">{pt.text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative hidden rounded-3xl bg-white/5 p-6 ring-1 ring-white/15 sm:block sm:p-8 lg:sticky lg:top-28 lg:self-start" aria-hidden="true">
      <div class="mx-auto flex max-w-sm flex-col items-center gap-3 text-center">
        <span class="rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-surface-800 shadow">💬 {copy.flow.comment}</span>
        <span class="h-6 w-px bg-white/30"></span>
        <span class="w-full rounded-2xl bg-gradient-to-r from-brand-500 to-violet-500 px-4 py-3 font-display text-lg font-bold text-white shadow-lg">🧠 {copy.flow.ours}</span>
        <span class="h-6 w-px bg-white/30"></span>
        <div class="w-full rounded-2xl border border-dashed border-white/30 p-3">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-white/70">⚖️ {copy.flow.judges}</p>
          <div class="flex justify-center gap-2">
            <span class="joy-float rounded-xl bg-white/10 px-3 py-2 text-sm font-bold text-white ring-1 ring-white/25" style="--r:-3deg">🤖 A</span>
            <span class="joy-float rounded-xl bg-white/10 px-3 py-2 text-sm font-bold text-white ring-1 ring-white/25" style="--r:2deg; animation-delay:-2s">🤖 B</span>
            <span class="joy-float rounded-xl bg-white/10 px-3 py-2 text-sm font-bold text-white ring-1 ring-white/25" style="--r:-1deg; animation-delay:-4s">🤖 C</span>
            <span class="joy-float rounded-xl border-2 border-dashed border-sun-300 px-3 py-2 text-sm font-bold text-sun-300" style="--r:3deg; animation-delay:-1s">+ ✨</span>
          </div>
          <p class="mt-2 text-xs text-sun-300">✨ {copy.flow.newModel} → {copy.flow.plugged}</p>
        </div>
        <span class="h-6 w-px bg-white/30"></span>
        <span class="rounded-full bg-mint-500 px-4 py-1.5 text-sm font-bold text-white shadow">✓ {copy.flow.decision}</span>
      </div>
    </div>
  </div>
</section>
