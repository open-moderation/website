---
export interface Props {
  items: Array<{ name: string; subtitle?: string }>;
  speed?: string;
}

const { items, speed = '40s' } = Astro.props;
---

<div class="relative overflow-hidden py-8">
  <style>
    @keyframes marquee-scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .marquee-track {
      animation: marquee-scroll var(--speed, 40s) linear infinite;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee-track { animation: none; }
    }
  </style>
  <div class="marquee-track flex gap-12" style={`width: fit-content; --speed: ${speed};`}>
    {items.concat(items).map((item) => (
      <div class="flex shrink-0 items-baseline gap-2 px-2">
        <p class="font-display text-lg font-semibold text-surface-900">{item.name}</p>
        {item.subtitle && <p class="text-sm text-surface-400">{item.subtitle}</p>}
      </div>
    ))}
  </div>
</div>