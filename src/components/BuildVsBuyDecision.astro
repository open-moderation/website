---
// Page produit « construire ou acheter » : la page de décision commerciale.
// Le détail chiffré des coûts vit dans l'article de blog /blog/build-vs-buy-moderation (lié dans les deux sens).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import CTASection from './CTASection.astro';
import FAQ from './FAQ.astro';
import { getLocale, localizePath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

export interface Copy {
  title: string;
  description: string;
  home: string;
  crumb: string;
  eyebrow: string;
  h1: string;
  intro: string;
  secondaryCta: string;
  tableTitle: string;
  tableIntro: string;
  tableHead: [string, string, string];
  tableRows: Array<[string, string, string]>;
  buildTitle: string;
  buildItems: string[];
  buyTitle: string;
  buyItems: string[];
  hybridTitle: string;
  hybridText: string;
  includedTitle: string;
  included: Array<{ title: string; text: string }>;
  costTitle: string;
  costText: string;
  costLink: string;
  faqTitle: string;
  faq: Array<{ question: string; answer: string }>;
  ctaTitle: string;
  ctaSubtitle: string;
}
export interface Props { copy: Copy }

const { copy: c } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const l = (p: string) => localizePath(p, locale);
const bookHref = l('/book-a-call');
const blogHref = l('/blog/build-vs-buy-moderation');
const url = `https://www.openmoderation.com${l('/build-vs-buy')}`;

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': url,
  url,
  name: c.h1,
  description: c.description,
  inLanguage: locale,
  isPartOf: { '@id': 'https://www.openmoderation.com/#website' },
  about: { '@id': 'https://www.openmoderation.com/#software' },
};
---

<BaseLayout title={c.title} description={c.description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: c.home, href: l('/') }, { label: c.crumb }]} />

  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-surface-200 bg-white px-4 py-1.5 text-sm text-surface-600">{c.eyebrow}</div>
      <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{c.intro}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={bookHref} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">{t('cta.book')}</a>
        <a href={blogHref} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{c.secondaryCta}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">{c.tableTitle}</h2>
      <p class="mt-3 max-w-3xl text-surface-500">{c.tableIntro}</p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-surface-100">
              <th scope="col" class="px-6 py-4 font-semibold text-surface-900">{c.tableHead[0]}</th>
              <th scope="col" class="px-6 py-4 font-semibold text-surface-700">{c.tableHead[1]}</th>
              <th scope="col" class="px-6 py-4 font-semibold text-accent-600">{c.tableHead[2]}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-white">
            {c.tableRows.map((r) => (
              <tr>
                <th scope="row" class="px-6 py-4 font-medium text-surface-900">{r[0]}</th>
                <td class="px-6 py-4 text-surface-600">{r[1]}</td>
                <td class="px-6 py-4 text-surface-800">{r[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-surface-200 bg-white p-7">
          <h2 class="text-xl font-bold text-surface-900">{c.buildTitle}</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-600">
            {c.buildItems.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div class="rounded-xl border-2 border-brand-500 bg-brand-50 p-7">
          <h2 class="text-xl font-bold text-surface-900">{c.buyTitle}</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-700">
            {c.buyItems.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
      <div class="mt-8 rounded-xl border border-violet-200 bg-white p-7">
        <h2 class="text-xl font-bold text-surface-900">{c.hybridTitle}</h2>
        <p class="mt-3 text-sm text-surface-600">{c.hybridText}</p>
      </div>
      <div class="mt-10 text-center">
        <a href={bookHref} class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">{t('cta.book')}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-surface-900 sm:text-3xl">{c.includedTitle}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {c.included.map((i) => (
          <div class="rounded-xl border border-surface-200 bg-white p-6 shadow-sm">
            <h3 class="font-semibold text-surface-900">{i.title}</h3>
            <p class="mt-2 text-sm text-surface-600">{i.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink-900 py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">{c.costTitle}</h2>
      <p class="mt-4 text-surface-300">{c.costText}</p>
      <a href={blogHref} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white underline underline-offset-4 hover:text-surface-200">{c.costLink} &rarr;</a>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title={c.faqTitle} items={c.faq} />
    </div>
  </section>

  <CTASection title={c.ctaTitle} subtitle={c.ctaSubtitle} buttonText={t('cta.book')} buttonHref={bookHref} />
</BaseLayout>
