---
import { getLocale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(getLocale(Astro.url.pathname));
const note = t('video.note');
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-600 via-violet-600 to-rose-500 py-14 sm:py-20">
  <div class="joy-blob pointer-events-none absolute -left-20 top-10 h-80 w-80 rounded-full bg-sun-300/40 blur-3xl" aria-hidden="true"></div>
  <div class="joy-blob pointer-events-none absolute -right-16 bottom-0 h-96 w-96 rounded-full bg-brand-400/50 blur-3xl" style="animation-delay:-9s" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-8 max-w-2xl text-center sm:mb-10">
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{t('video.title')}</h2>
      <p class="mt-4 text-base text-white/85 sm:text-lg">{t('video.text')}</p>
    </div>
    <div class="relative rounded-3xl bg-white/15 p-2 ring-1 ring-white/30 shadow-[0_40px_80px_-30px_rgba(30,27,75,0.7)] sm:p-3">
      <div class="relative overflow-hidden rounded-2xl bg-white">
        <div class="flex items-center gap-1.5 border-b border-surface-100 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-sun-400"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-mint-400"></span>
          <span class="ml-3 rounded-md bg-surface-100 px-3 py-0.5 text-xs text-surface-500">app.openmoderation.com</span>
        </div>
        <video
          src="/videos/om-app.mp4"
          poster="/videos/om-app.jpg"
          width="1440"
          height="810"
          data-lazy-video
          muted
          loop
          playsinline
          preload="none"
          aria-label={t('video.alt')}
          class="om-app-video block aspect-[4/3] h-auto w-full object-cover object-[4%_70%] sm:aspect-video sm:object-center"
        ></video>
        <button type="button" class="om-video-zoom absolute inset-x-0 bottom-0 top-10 flex items-center justify-center sm:hidden" aria-label={t('video.alt')}>
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-violet-600/90 text-white shadow-lg ring-4 ring-white/70">
            <svg class="ml-1 h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </button>
      </div>
      {note && <p class="absolute bottom-4 right-4 rounded-full sm:bottom-6 sm:right-6 bg-sun-400 px-3 py-1 text-xs font-bold text-surface-900 shadow-md">{note}</p>}
    </div>
  </div>
</section>

<script>
  // Sur mobile, l'interface est trop petite pour être lue dans la page : le bouton lance la vidéo en plein écran.
  document.querySelectorAll<HTMLButtonElement>('.om-video-zoom').forEach((btn) => {
    btn.addEventListener('click', () => {
      const v = btn.parentElement?.querySelector<HTMLVideoElement>('video');
      if (!v) return;
      v.preload = 'auto';
      v.play().catch(() => {});
      const anyV = v as any;
      if (v.requestFullscreen) v.requestFullscreen().catch(() => anyV.webkitEnterFullscreen?.());
      else anyV.webkitEnterFullscreen?.();
    });
  });
</script>
