---
import { getLocale, localizePath } from '../i18n/routes';
import { bookingUrl, useTranslations } from '../i18n/ui';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const l = (path: string) => localizePath(path, locale);
---

<footer class="border-t border-surface-200 bg-surface-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-x-8 gap-y-0 md:grid-cols-5 md:gap-8">
      <div class="col-span-2 mb-6 md:col-span-1 md:mb-0">
        <a href={l('/')} class="flex items-center gap-2 text-lg font-semibold text-surface-900">
          <img src="/logo.svg" alt={t('nav.home')} width="179" height="32" loading="lazy" decoding="async" class="h-[2rem] w-auto" />
        </a>
        <p class="mt-3 text-sm text-surface-500">
          {t('footer.tagline')}
        </p>
        <a href="https://logora.com" target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-violet-200 bg-gradient-to-r from-violet-50 to-rose-50 px-3 py-1 text-xs font-medium text-surface-600 transition hover:border-violet-300">
          {t('brand.line')} <span class="font-bold text-violet-700">&rarr;</span>
        </a>
      </div>

      <details class="om-foot col-span-2 md:col-span-1" open>
        <summary><h3 class="text-sm font-semibold text-surface-900">{t('nav.product')}</h3></summary>
        <ul class="mt-1 md:mt-3 md:space-y-2">
          <li><a href={l('/content-moderation-api')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.cmApi')}</a></li>
          <li><a href="https://api.openmoderation.com/docs" class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.apiDocs')}</a></li>
          <li><a href={l('/moderation-software')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.software')}</a></li>
          <li><a href={l('/automatic-comment-moderation')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.auto')}</a></li>
          <li><a href={l('/outsourced-moderation')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.outsource')}</a></li>
          <li><a href={l('/features')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.features')}</a></li>
          <li><a href={l('/how-it-works')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.howItWorks')}</a></li>
          <li><a href={l('/product/transparency')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.transparency')}</a></li>
          <li><a href={l('/dashboard')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.dashboard')}</a></li>
          <li><a href={l('/how-it-works#action-engine')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.actionEngine')}</a></li>
          <li><a href={l('/connectors')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.integrations')}</a></li>
          <li><a href={l('/integrations/facebook')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.facebook')}</a></li>
          <li><a href={l('/integrations/instagram')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.instagram')}</a></li>
          <li><a href={l('/integrations/youtube')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.youtube')}</a></li>
          <li><a href={l('/integrations/wordpress')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.wordpress')}</a></li>
          <li><a href={l('/pricing')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.pricing')}</a></li>
        </ul>
      </details>

      <details class="om-foot col-span-2 md:col-span-1" open>
        <summary><h3 class="text-sm font-semibold text-surface-900">{t('footer.compare')}</h3></summary>
        <ul class="mt-1 md:mt-3 md:space-y-2">
          <li><a href={l('/alternatives')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.allComparisons')}</a></li>
          <li><a href={l('/build-vs-buy')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.buildVsBuy')}</a></li>
          <li><a href={l('/alternatives/openai-moderation')} class="text-sm text-surface-500 transition hover:text-surface-700">OpenAI Moderation</a></li>
          <li><a href={l('/alternatives/mistral-moderation')} class="text-sm text-surface-500 transition hover:text-surface-700">Mistral Moderation</a></li>
          <li><a href={l('/alternatives/perspective-api')} class="text-sm text-surface-500 transition hover:text-surface-700">Perspective API</a></li>
          <li><a href={l('/alternatives/hive-moderation')} class="text-sm text-surface-500 transition hover:text-surface-700">Hive Moderation</a></li>
          <li><a href={l('/alternatives/azure-content-safety')} class="text-sm text-surface-500 transition hover:text-surface-700">Azure Content Safety</a></li>
          <li><a href={l('/alternatives/checkstep')} class="text-sm text-surface-500 transition hover:text-surface-700">Checkstep</a></li>
          <li><a href={l('/faq')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.faq')}</a></li>
        </ul>
      </details>

      <details class="om-foot col-span-2 md:col-span-1" open>
        <summary><h3 class="text-sm font-semibold text-surface-900">{t('nav.useCases')}</h3></summary>
        <ul class="mt-1 md:mt-3 md:space-y-2">
          <li><a href={l('/use-cases')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.allUseCases')}</a></li>
          <li><a href={l('/use-cases/news-publishers')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.newsPublishers')}</a></li>
          <li><a href={l('/use-cases/social-platforms')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.social')}</a></li>
          <li><a href={l('/use-cases/ai-applications')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.ai')}</a></li>
          <li><a href={l('/use-cases/marketplaces')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.marketplaces')}</a></li>
          <li><a href={l('/use-cases/gaming')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.gaming')}</a></li>
          <li><a href={l('/use-cases/enterprise-saas')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.saas')}</a></li>
          <li><a href={l('/use-cases/brands-retail')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.brands')}</a></li>
          <li><a href={l('/use-cases/luxury-fashion')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.luxury')}</a></li>
          <li><a href={l('/use-cases/public-sector')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.public')}</a></li>
        </ul>
      </details>

      <details class="om-foot col-span-2 md:col-span-1" open>
        <summary><h3 class="text-sm font-semibold text-surface-900">{t('nav.company')}</h3></summary>
        <ul class="mt-1 md:mt-3 md:space-y-2">
          <li><a href={l('/about')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.about')}</a></li>
          <li><a href={l('/blog')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.blog')}</a></li>
          <li><a href={l('/dsa-compliance')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('nav.dsa')}</a></li>
          <li><a href={l('/dsa-compliance/notice-and-action')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.notice')}</a></li>
          <li><a href={l('/privacy')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.privacy')}</a></li>
          <li><a href={l('/terms')} class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.terms')}</a></li>
          <li><a href={BOOKING_URL} target="_blank" rel="noopener" class="text-sm text-surface-500 transition hover:text-surface-700">{t('cta.book')}</a></li>
          <li><a href="mailto:contact@openmoderation.com" class="text-sm text-surface-500 transition hover:text-surface-700">{t('footer.contact')}</a></li>
        </ul>
      </details>
    </div>

    <div class="mt-10 border-t border-surface-200 pt-6 text-center text-sm text-surface-400">
      <div class="mb-3 flex items-center justify-center gap-4">
        <span class="flex items-center gap-1.5">
          
          {t('footer.madeInEu')}
        </span>
        <span class="text-surface-300">|</span>
        <span>{t('footer.gdpr')}</span>
        <span class="text-surface-300">|</span>
        <a href={l('/dsa-compliance')} class="transition hover:text-surface-600">{t('footer.dsa')}</a>
      </div>
      <p>&copy; {new Date().getFullYear()} <a href="https://logora.com" class="text-surface-400 transition hover:text-surface-600" target="_blank" rel="noopener noreferrer">Logora</a>. {t('footer.builtWith')}</p>
    </div>
  </div>
</footer>
<style>
  .om-foot > summary { list-style: none; }
  .om-foot > summary::-webkit-details-marker { display: none; }
  @media (max-width: 767px) {
    .om-foot { border-top: 1px solid var(--color-surface-200); }
    .om-foot > summary { display: flex; align-items: center; justify-content: space-between; min-height: 48px; cursor: pointer; }
    .om-foot > summary::after { content: ''; width: 8px; height: 8px; border-right: 2px solid #64748b; border-bottom: 2px solid #64748b; transform: rotate(45deg); transition: transform .2s ease; margin-right: 4px; }
    .om-foot[open] > summary::after { transform: rotate(-135deg); }
    .om-foot ul { padding-bottom: 12px; }
    .om-foot li a { display: block; padding: 10px 0; }
  }
  @media (min-width: 768px) { .om-foot > summary { pointer-events: none; } }
</style>
<script>
  // Sur mobile, les colonnes de liens du pied de page sont repliées (elles restent ouvertes sans JS et sur grand écran).
  if (matchMedia('(max-width: 767px)').matches) document.querySelectorAll('details.om-foot').forEach((d) => d.removeAttribute('open'));
</script>
