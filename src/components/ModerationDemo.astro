    noReason: 'No incumple ninguna regla: el comentario se publicaría.',
    time: 'Respuesta en',
    empty: 'Escribe o elige primero un comentario.',
    emptyTitle: "El veredicto aparecerá aquí",
    emptyHint: "Elige un ejemplo o pega un comentario real de tu sitio.",
    error: 'La demo no ha respondido. Vuelve a intentarlo en un momento.',
    quota: 'Cuota de demo alcanzada: 10 pruebas por hora y por dirección IP. Vuelve a intentarlo más tarde o prueba la moderación con tus propios comentarios.',
    note: 'Demo en directo con el motor de moderación de Logora, la empresa que desarrolla OpenModeration. En OpenModeration se aplican a cada comentario tus normas completas, varios modelos de IA y la revisión de tu equipo.',
    cta: 'Pruébalo con tus propios comentarios en modo sandbox',
    signup: 'https://app.openmoderation.com/signup',
  },
  de: {
    lang: 'de-DE',
    commentLabel: 'Zu moderierender Kommentar',
    batchHint: 'Mehrere Kommentare? Einen pro Zeile (höchstens 10).',
    placeholder: 'Kommentar einfügen oder schreiben…',
    examples: 'Beispiel ausprobieren',
    exampleList: [
      { label: 'Versteckter Hass', text: 'Schon wieder die... wir wissen doch alle, wo die herkommen, die sollte man zurückschicken.' },
      { label: 'Beleidigung', text: 'Nur ein Idiot kann so einen Unsinn schreiben. Geh zurück in die Schule.' },
      { label: 'Betrug', text: 'Glückwunsch, Sie haben ein iPhone gewonnen! Jetzt abholen auf gewinner-geschenk.xyz' },
      { label: 'Harte, aber legitime Kritik', text: 'Völlig einseitiger Artikel. Der Journalist ignoriert alle Zahlen, die der Regierung widersprechen.' },
    ],
    langLabel: "Sprache des Kommentars",
    postLabel: 'Titel des Beitrags oder Artikels (optional)',
    postPlaceholder: 'z. B. Stadtrat beschließt neue Radwege',
    charterLabel: 'Ihre Moderationsrichtlinien (bearbeitbar)',
    charter: "Kommentarrichtlinien einer Nachrichtenseite. Ablehnen: Beleidigungen und persönliche Angriffe gegen andere Leser oder Personen, auch durch Ironie, Sarkasmus oder spöttische Spitznamen; hasserfüllte oder diskriminierende Äußerungen, auch Andeutungen und Verallgemeinerungen gegen eine Gruppe wegen Herkunft, Religion, Geschlecht oder sexueller Orientierung; Drohungen und Einschüchterung; Spam, Werbung, Betrug und verdächtige Links; Veröffentlichung personenbezogener Daten. Zulassen: Widerspruch und auch scharfe Kritik an einer Idee, einem Artikel, einem Journalisten, einer Regierung oder einer Person des öffentlichen Lebens, solange es weder Beleidigung noch Hass gibt; kurze Kommentare, Dank und Fragen. Bei echtem Zweifel an die menschliche Prüfung senden.",
    submit: 'Kommentar moderieren',
    loading: 'Wird analysiert…',
    accepted: 'Freigegeben',
    rejected: 'Abgelehnt',
    pending: 'Zur Prüfung an Ihr Team',
    category: 'Kategorie',
    reason: 'Schriftliche Begründung',
    noReason: 'Keine Regel verletzt: Der Kommentar würde veröffentlicht.',
    time: 'Antwort in',
    empty: 'Schreiben oder wählen Sie zuerst einen Kommentar.',
    emptyTitle: "Hier erscheint das Ergebnis",
    emptyHint: "Wählen Sie ein Beispiel oder fügen Sie einen echten Kommentar Ihrer Website ein.",
    error: 'Die Demo hat nicht geantwortet. Bitte versuchen Sie es gleich noch einmal.',
    quota: 'Demo-Kontingent erreicht: 10 Versuche pro Stunde und IP-Adresse. Versuchen Sie es später erneut oder testen Sie die Moderation mit Ihren eigenen Kommentaren.',
    note: 'Live-Demo mit der Moderations-Engine von Logora, dem Unternehmen hinter OpenModeration. In OpenModeration gelten für jeden Kommentar Ihre vollständigen Richtlinien, mehrere KI-Modelle und die Prüfung durch Ihr Team.',
    cta: 'Mit Ihren eigenen Kommentaren im Sandbox-Modus testen',
    signup: 'https://app.openmoderation.com/signup',
  },
  it: {
    lang: 'it-IT',
    commentLabel: 'Commento da moderare',
    batchHint: 'Più commenti? Uno per riga (massimo 10).',
    placeholder: 'Incolla o scrivi un commento…',
    examples: 'Prova un esempio',
    exampleList: [
      { label: 'Allusione d’odio', text: 'Sempre loro... sappiamo tutti da dove vengono quelli, bisognerebbe rimandarli a casa loro.' },
      { label: 'Insulto', text: 'Bisogna essere proprio idioti per scrivere una cosa del genere. Torna a scuola.' },
      { label: 'Truffa', text: 'Complimenti, hai vinto un iPhone! Ritiralo subito su regalo-vincitore.xyz' },
      { label: 'Critica dura ma legittima', text: "Articolo del tutto di parte. Il giornalista ignora tutti i dati che smentiscono il governo." },
    ],
    langLabel: "Lingua del commento",
    postLabel: "Titolo del post o dell'articolo (facoltativo)",
    postPlaceholder: 'Es.: Il consiglio comunale approva nuove piste ciclabili',
    charterLabel: 'La tua policy di moderazione (modificabile)',
    charter: "Policy dei commenti di un sito di informazione. Rifiutare: insulti e attacchi personali contro un altro lettore o una persona, anche tramite ironia, sarcasmo o soprannomi derisori; contenuti d'odio o discriminatori, anche allusioni e generalizzazioni contro un gruppo per origine, religione, genere o orientamento; minacce e intimidazioni; spam, pubblicità, truffe e link sospetti; diffusione di dati personali. Accettare: il disaccordo e la critica, anche dura, a un'idea, un articolo, un giornalista, un governo o un personaggio pubblico, purché senza insulti né odio; commenti brevi, ringraziamenti e domande. In caso di dubbio reale, inviare alla revisione umana.",
    submit: 'Modera questo commento',
    loading: 'Analisi in corso…',
    accepted: 'Accettato',
    rejected: 'Rifiutato',
    pending: 'Inviato alla revisione umana',
    category: 'Categoria',
    reason: 'Motivazione scritta',
    noReason: 'Nessuna regola violata: il commento verrebbe pubblicato.',
    time: 'Risposta in',
    empty: 'Scrivi o scegli prima un commento.',
    emptyTitle: "Il verdetto apparirà qui",
    emptyHint: "Scegli un esempio o incolla un vero commento del tuo sito.",
    error: 'La demo non ha risposto. Riprova tra un momento.',
    quota: 'Quota demo raggiunto: 10 prove all’ora e per indirizzo IP. Riprova più tardi o prova la moderazione sui tuoi commenti.',
    note: "Demo dal vivo con il motore di moderazione di Logora, l'azienda che sviluppa OpenModeration. In OpenModeration a ogni commento si applicano la tua policy completa, più modelli di IA e la revisione del tuo team.",
    cta: 'Provalo sui tuoi commenti in modalità sandbox',
    signup: 'https://app.openmoderation.com/signup',
  },
}[locale];

const languages = [
  { code: 'fr-FR', name: 'Français' },
  { code: 'en-US', name: 'English' },
  { code: 'es-ES', name: 'Español' },
  { code: 'de-DE', name: 'Deutsch' },
  { code: 'it-IT', name: 'Italiano' },
  { code: 'pt-BR', name: 'Português' },
];

const config = JSON.stringify({
  lang: copy.lang,
  charter: copy.charter,
  labels: { accepted: copy.accepted, rejected: copy.rejected, pending: copy.pending, loading: copy.loading, submit: copy.submit, noReason: copy.noReason, empty: copy.empty, error: copy.error, quota: copy.quota, time: copy.time },
});
---

<div class="om-demo rounded-2xl border border-white bg-white/90 p-6 shadow-[0_30px_60px_-28px_rgba(76,29,149,0.35)] sm:p-8" data-config={config}>
  <div class="grid gap-8 lg:grid-cols-2">
    <form class="om-demo-form space-y-5">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-surface-400">{copy.examples}</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {copy.exampleList.map((ex, i) => (
            <button type="button" class={`om-demo-example inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm font-medium transition hover:-translate-y-0.5 hover:shadow-sm ${['border-violet-200 bg-violet-50 text-violet-700', 'border-rose-200 bg-rose-50 text-rose-700', 'border-sun-300 bg-sun-50 text-sun-600', 'border-mint-100 bg-mint-50 text-mint-600'][i % 4]}`} data-text={ex.text}>{['🫣', '🤬', '🎣', '🧐'][i % 4]} {ex.label}</button>
          ))}
        </div>
      </div>
      <label class="block">
        <span class="text-sm font-semibold text-surface-900">{copy.commentLabel}</span>
        <textarea name="text" rows="4" maxlength="6000" class="mt-2 w-full rounded-lg border border-surface-300 bg-white p-3 text-sm text-surface-900 placeholder-surface-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" placeholder={copy.placeholder}></textarea>
        <span class="mt-1 block text-xs text-surface-400">{copy.batchHint}</span>
      </label>
      <label class="block">
        <span class="text-sm font-semibold text-surface-900">{copy.langLabel}</span>
        <select name="language" class="mt-2 w-full rounded-lg border border-surface-300 bg-white p-3 text-sm text-surface-900 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100 sm:w-auto">
          {languages.map((l) => <option value={l.code} selected={l.code === copy.lang}>{l.name}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="text-sm font-semibold text-surface-900">{copy.postLabel}</span>
        <input name="post" type="text" maxlength="300" class="mt-2 w-full rounded-lg border border-surface-300 bg-white p-3 text-sm text-surface-900 placeholder-surface-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" placeholder={copy.postPlaceholder} />
      </label>
      <details class="group">
        <summary class="cursor-pointer text-sm font-semibold text-surface-900">{copy.charterLabel}</summary>
        <textarea name="policy" rows="4" maxlength="3000" class="mt-2 w-full rounded-lg border border-surface-300 bg-surface-50 p-3 text-sm text-surface-700 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100">{copy.charter}</textarea>
      </details>
      <button type="submit" class="om-demo-submit inline-flex w-full items-center justify-center rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800 disabled:opacity-60 sm:w-auto">{copy.submit}</button>
    </form>

    <div class="flex flex-col">
      <div class="om-demo-result relative flex min-h-[300px] flex-1 flex-col justify-center overflow-hidden rounded-2xl border-2 border-dashed border-violet-200 bg-gradient-to-br from-violet-50 via-white to-rose-50 p-6" aria-live="polite">
        <div class="om-demo-idle flex flex-col items-center text-center">
          <div class="om-demo-art relative mb-6 h-32 w-full max-w-sm" aria-hidden="true">
            <span class="om-demo-chip absolute whitespace-nowrap left-4 top-2 inline-flex items-center gap-1.5 rounded-full bg-mint-100 px-3.5 py-1.5 text-sm font-bold text-mint-600 shadow-md ring-1 ring-mint-200" style="--r:-6deg">✓ {copy.accepted}</span>
            <span class="om-demo-chip absolute whitespace-nowrap right-4 top-0 inline-flex items-center gap-1.5 rounded-full bg-rose-100 px-3.5 py-1.5 text-sm font-bold text-rose-600 shadow-md ring-1 ring-rose-200" style="--r:5deg; animation-delay:-1.5s">✕ {copy.rejected}</span>
            <span class="om-demo-chip absolute whitespace-nowrap bottom-0 left-1/2 inline-flex -translate-x-1/2 items-center gap-1.5 rounded-full bg-sun-100 px-3.5 py-1.5 text-sm font-bold text-sun-600 shadow-md ring-1 ring-sun-200" style="--r:-2deg; animation-delay:-3s">👀 {copy.pending}</span>
          </div>
          <p class="om-demo-idle-title font-display text-xl font-bold text-surface-900">{copy.emptyTitle}</p>
          <p class="om-demo-message mt-2 max-w-xs text-sm text-surface-500" data-hint={copy.emptyHint}>{copy.emptyHint}</p>
          <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-semibold text-violet-600 shadow-sm ring-1 ring-violet-100">✍️ {copy.reason}</p>
        </div>
        <div class="om-demo-output hidden">
          <span class="om-demo-badge inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold"></span>
          <dl class="mt-5 space-y-4 text-sm">
            <div class="om-demo-category-row">
              <dt class="text-xs font-semibold uppercase tracking-wider text-surface-400">{copy.category}</dt>
              <dd class="om-demo-category mt-1 font-medium text-surface-900"></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-surface-400">{copy.reason}</dt>
              <dd class="om-demo-reason mt-2 rounded-xl bg-white p-4 leading-relaxed text-surface-800 shadow-sm ring-1 ring-surface-100"></dd>
            </div>
          </dl>
          <p class="om-demo-time mt-5 text-xs text-surface-400"></p>
        </div>
        <ul class="om-demo-batch hidden w-full space-y-3 text-sm"></ul>
      </div>
      <p class="mt-4 text-xs leading-relaxed text-surface-400">{copy.note}</p>
      <a href={copy.signup} class="mt-3 text-sm font-semibold text-brand-700 hover:text-brand-600">{copy.cta} &rarr;</a>
    </div>
  </div>
</div>

<style>
  .om-demo-chip { animation: joy-float 5s ease-in-out infinite; }
  .om-demo-shake { animation: om-shake .4s ease; }
  .om-demo-result { transition: background .4s ease, border-color .4s ease; }
  .om-demo-result[data-status="rejected"] { border-style: solid; border-color: var(--color-rose-300); background: linear-gradient(135deg, var(--color-rose-50), #fff 70%); }
  .om-demo-result[data-status="accepted"] { border-style: solid; border-color: var(--color-mint-400); background: linear-gradient(135deg, var(--color-mint-50), #fff 70%); }
  .om-demo-result[data-status="pending"] { border-style: solid; border-color: var(--color-sun-300); background: linear-gradient(135deg, var(--color-sun-50), #fff 70%); }
  .om-demo-pop { animation: joy-pop .45s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes om-shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  @media (prefers-reduced-motion: reduce) { .om-demo-chip, .om-demo-shake, .om-demo-pop { animation: none; } }
</style>

<script>
  const API = 'https://api.openmoderation.com/v1/demo/moderation';

  class DemoError extends Error {
    constructor(readonly kind: 'quota' | 'failed') {
      super(kind);
    }
  }

  type DemoResult = {
    status: 'accepted' | 'rejected' | 'pending';
    category: string | null;
    reason: string | null;
  };

  document.querySelectorAll<HTMLElement>('.om-demo').forEach((root) => {
    const config = JSON.parse(root.dataset.config || '{}');
    const form = root.querySelector<HTMLFormElement>('.om-demo-form')!;
    const text = form.querySelector<HTMLTextAreaElement>('textarea[name="text"]')!;
    const post = form.querySelector<HTMLInputElement>('input[name="post"]')!;
    const policy = form.querySelector<HTMLTextAreaElement>('textarea[name="policy"]')!;
    const language = form.querySelector<HTMLSelectElement>('select[name="language"]')!;
    let languageTouched = false;
    language.addEventListener('change', () => { languageTouched = true; });

    const stopwords: Record<string, string[]> = {
      'fr-FR': ['le', 'la', 'les', 'des', 'est', 'et', 'pour', 'pas', 'que', 'qui', 'une', 'un', 'vous', 'dans', 'sur', 'ce', 'avec', 'tout', 'encore', 'cet', 'être', 'faut', 'ça', 'très', 'je', 'tu', 'du', 'au', 'merci', 'mais', 'aussi'],
      'en-US': ['the', 'and', 'is', 'you', 'this', 'that', 'for', 'not', 'with', 'are', 'they', 'of', 'to', 'it', 'your', 'what', 'again', 'only', 'an', 'thanks', 'who', 'my', 'he', 'she'],
      'es-ES': ['el', 'la', 'los', 'las', 'que', 'es', 'por', 'para', 'con', 'una', 'del', 'pero', 'como', 'este', 'muy', 'otra', 'todos', 'hay', 'ser', 'y', 'su', 'está', 'esto', 'eso', 'gracias'],
      'de-DE': ['der', 'die', 'das', 'und', 'ist', 'nicht', 'ein', 'eine', 'mit', 'sie', 'zu', 'den', 'wir', 'auch', 'schon', 'doch', 'man'],
      'it-IT': ['il', 'lo', 'gli', 'che', 'è', 'per', 'non', 'una', 'con', 'del', 'della', 'sono', 'questo', 'loro', 'tutti', 'sempre', 'anche'],
      'pt-BR': ['o', 'os', 'que', 'não', 'uma', 'com', 'para', 'por', 'mais', 'você', 'isso', 'muito', 'são', 'esse', 'eles', 'todos', 'também'],
    };
    const detect = (value: string) => {
      const words = value.toLowerCase().split(/[^a-zà-ÿßœæ']+/).filter(Boolean);
      const scores = Object.entries(stopwords).map(([code, list]) => [code, words.filter((w) => list.includes(w)).length] as const);
      scores.sort((a, b) => b[1] - a[1]);
      const [first, second] = scores;
      return first[1] > 0 && first[1] > second[1] ? first[0] : '';
    };
    const syncLanguage = () => {
      if (languageTouched) return;
      const detected = detect(text.value);
      if (detected) language.value = detected;
    };
    text.addEventListener('input', syncLanguage);
    const submit = form.querySelector<HTMLButtonElement>('.om-demo-submit')!;
    const idle = root.querySelector<HTMLElement>('.om-demo-idle')!;
    const output = root.querySelector<HTMLElement>('.om-demo-output')!;
    const badge = root.querySelector<HTMLElement>('.om-demo-badge')!;
    const categoryRow = root.querySelector<HTMLElement>('.om-demo-category-row')!;
    const category = root.querySelector<HTMLElement>('.om-demo-category')!;
    const reason = root.querySelector<HTMLElement>('.om-demo-reason')!;
    const time = root.querySelector<HTMLElement>('.om-demo-time')!;
    const batch = root.querySelector<HTMLElement>('.om-demo-batch')!;

    const badgeStyles: Record<string, string> = {
      accepted: 'bg-mint-100 text-mint-600 ring-1 ring-mint-200',
      rejected: 'bg-rose-100 text-rose-600 ring-1 ring-rose-200',
      pending: 'bg-sun-100 text-sun-600 ring-1 ring-sun-300',
      failed: 'bg-surface-200 text-surface-600',
    };

    const message = root.querySelector<HTMLElement>('.om-demo-message')!;
    const art = root.querySelector<HTMLElement>('.om-demo-art')!;
    const idleTitle = root.querySelector<HTMLElement>('.om-demo-idle-title')!;
    // Sans texte : l'illustration reste et l'invitation tremble. En cas d'erreur : seul le message s'affiche.
    const resultBox = root.querySelector<HTMLElement>('.om-demo-result')!;
    const showMessage = (text: string, isError = false) => {
      delete resultBox.dataset.status;
      output.classList.add('hidden');
      batch.classList.add('hidden');
      idle.classList.remove('hidden');
      art.classList.toggle('hidden', isError);
      idleTitle.classList.toggle('hidden', isError);
      message.textContent = text;
      message.classList.toggle('text-rose-600', !isError);
      message.classList.toggle('text-surface-500', isError);
      message.classList.remove('om-demo-shake');
      void message.offsetWidth;
      if (!isError) message.classList.add('om-demo-shake');
    };

    root.querySelectorAll<HTMLButtonElement>('.om-demo-example').forEach((button) => {
      button.addEventListener('click', () => {
        text.value = button.dataset.text || '';
        syncLanguage();
        form.requestSubmit();
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const content = text.value.trim();
      if (!content) {
        showMessage(config.labels.empty);
        return;
      }
      submit.disabled = true;
      submit.textContent = config.labels.loading;
      const lines = content.split('\n').map((line) => line.trim()).filter(Boolean).slice(0, 10);
      const postTitle = post.value.trim();
      const moderate = async (comment: string): Promise<DemoResult> => {
        const lang = language.value.split('-')[0];
        const body: Record<string, unknown> = {
          input: comment,
          content: { language: lang },
          moderation: {
            reasonLanguage: lang,
            policy: { llm_prompt: policy.value.trim() || config.charter },
          },
        };
        if (postTitle) body.context = { postTitle };
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 20000);
        let response: Response;
        try {
          response = await fetch(API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            signal: controller.signal,
          });
        } finally {
          clearTimeout(timer);
        }
        if (response.status === 429) throw new DemoError('quota');
        if (!response.ok) throw new DemoError('failed');
        const { decision } = await response.json();
        const status = ['accepted', 'rejected', 'pending'].includes(decision?.status) ? decision.status : 'pending';
        return { status, category: (decision?.category ?? null) as string | null, reason: (decision?.reason ?? null) as string | null };
      };
      const failureLabel = (error: unknown) =>
        error instanceof DemoError && error.kind === 'quota' ? config.labels.quota : config.labels.error;
      const started = performance.now();
      const elapsed = () => {
        const ms = performance.now() - started;
        return `${config.labels.time} ${ms < 1000 ? Math.round(ms) + ' ms' : (ms / 1000).toFixed(1) + ' s'}`;
      };
      try {
        if (lines.length === 1) {
          const result = await moderate(lines[0]);
          badge.className = `om-demo-badge om-demo-pop inline-flex items-center rounded-full px-4 py-1.5 text-base font-bold ${badgeStyles[result.status]}`;
          badge.textContent = config.labels[result.status];
          categoryRow.classList.toggle('hidden', !result.category);
          category.textContent = result.category ? String(result.category).replace(/_/g, ' ').toLowerCase() : '';
          reason.textContent = result.reason || config.labels.noReason;
          time.textContent = elapsed();
          resultBox.dataset.status = result.status;
          idle.classList.add('hidden');
          batch.classList.add('hidden');
          output.classList.remove('hidden');
        } else {
          const results = await Promise.all(
            lines.map(async (line): Promise<DemoResult | Error> => {
              try {
                return await moderate(line);
              } catch (error) {
                return error instanceof Error ? error : new Error(String(error));
              }
            }),
          );
          const failures = results.filter((result) => result instanceof Error);
          if (failures.length === results.length) throw failures[0];
          batch.replaceChildren(
            ...results.map((result, i) => {
              const item = document.createElement('li');
              item.className = 'rounded-xl border border-surface-100 bg-white p-3 shadow-sm';
              const quote = document.createElement('p');
              quote.className = 'text-surface-700';
              quote.textContent = lines[i];
              const verdict = document.createElement('span');
              const failed = result instanceof Error;
              verdict.className = `mt-2 inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold ${badgeStyles[failed ? 'failed' : result.status]}`;
              verdict.textContent = failed ? failureLabel(result) : config.labels[result.status];
              const why = document.createElement('p');
              why.className = 'mt-1 text-xs text-surface-500';
              why.textContent = failed ? '' : result.reason || config.labels.noReason;
              item.append(quote, verdict, why);
              return item;
            }),
          );
          idle.classList.add('hidden');
          output.classList.add('hidden');
          batch.classList.remove('hidden');
          delete resultBox.dataset.status;
        }
      } catch (error) {
        showMessage(failureLabel(error), true);
      } finally {
        submit.disabled = false;
        submit.textContent = config.labels.submit;
      }
    });
  });
</script>
