---
import { getLocale } from '../i18n/routes';

const locale = getLocale(Astro.url.pathname);

const copy = {
  en: {
    lang: 'en-US',
    commentLabel: 'Comment to moderate',
    batchHint: 'Several comments? Put one per line (up to 10).',
    placeholder: 'Paste or write a comment…',
    examples: 'Try an example',
    exampleList: [
      { label: 'Hateful insinuation', text: 'Them again... we all know where those people come from, they should be sent back home.' },
      { label: 'Insult', text: 'Only an idiot could write something this stupid. Go back to school.' },
      { label: 'Scam', text: 'Congratulations, you won an iPhone! Claim it now at free-gift-winner.xyz' },
      { label: 'Harsh but fair', text: 'This article is one-sided. The journalist ignores every figure that contradicts the government.' },
