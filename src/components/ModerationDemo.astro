    submit: 'Moderate this comment',
    loading: 'Analysing…',
    accepted: 'Accepted',
    rejected: 'Rejected',
    pending: 'Sent to human review',
    category: 'Category',
    reason: 'Written reason',
    noReason: 'No rule broken: the comment would be published.',
    time: 'Answered in',
    empty: 'Write or pick a comment first.',
    emptyTitle: "Your verdict will appear here",
    emptyHint: "Pick an example or paste a real comment from your site.",
    error: 'The demo did not answer. Please try again in a moment.',
    quota: 'Demo quota reached: 10 tries per hour and per IP address. Try again later, or test the moderation on your own comments.',
    note: 'Live demo powered by the moderation engine of Logora, the company behind OpenModeration. In OpenModeration, your full charter, several AI models and your team review apply to every comment.',
    cta: 'Test it on your own comments in sandbox mode',
    signup: 'https://app.openmoderation.com/signup',
  },
  fr: {
    lang: 'fr-FR',
    commentLabel: 'Commentaire à modérer',
    batchHint: 'Plusieurs commentaires ? Un par ligne (10 maximum).',
    placeholder: 'Collez ou écrivez un commentaire…',
    examples: 'Essayez un exemple',
    exampleList: [
      { label: 'Sous-entendu haineux', text: "Encore eux... on sait tous d'où ils viennent ceux-là, faudrait les renvoyer chez eux." },
      { label: 'Insulte', text: "Faut vraiment être un abruti pour écrire un truc pareil. Retourne à l'école." },
      { label: 'Arnaque', text: 'Félicitations, vous avez gagné un iPhone ! Réclamez-le vite sur cadeau-gagnant.xyz' },
      { label: 'Critique dure mais légitime', text: "Article complètement partial. Le journaliste oublie tous les chiffres qui contredisent le gouvernement." },
    ],
    langLabel: "Langue du commentaire",
    postLabel: "Titre de la publication ou de l'article (facultatif)",
    postPlaceholder: 'Ex. : Le conseil municipal vote de nouvelles pistes cyclables',
    charterLabel: 'Votre charte de modération (modifiable)',
    charter: "Charte des commentaires d'un site d'information. Refuser : les insultes et attaques personnelles envers un autre lecteur ou une personne, y compris par l'ironie, le sarcasme ou un surnom moqueur ; les propos haineux ou discriminatoires, y compris les sous-entendus et généralisations visant un groupe pour son origine, sa religion, son genre ou son orientation ; les menaces et l'intimidation ; le spam, la publicité, les arnaques et les liens suspects ; la divulgation de données personnelles. Accepter : le désaccord et la critique, même vive, d'une idée, d'un article, d'un journaliste, d'un gouvernement ou d'une personnalité publique, tant qu'il n'y a ni insulte ni haine ; les commentaires courts, les remerciements et les questions. En cas de doute réel, envoyer en relecture humaine.",
    submit: 'Modérer ce commentaire',
    loading: 'Analyse en cours…',
    accepted: 'Accepté',
    rejected: 'Rejeté',
    pending: 'Envoyé en relecture humaine',
    category: 'Catégorie',
    reason: 'Explication écrite',
