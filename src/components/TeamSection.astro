---
import { getLocale } from '../i18n/routes';

const locale = getLocale(Astro.url.pathname);

// L'équipe OpenModeration est celle de Logora (logora.com/equipe).
const copyAll = {
  en: { eyebrow: 'The team', title: 'The people who set up and run your moderation', text: 'OpenModeration is built by the Logora team: 8 people in Paris, Madrid and Berlin who have been moderating reader comments for European publishers since 2019. They also handle your doubtful cases and user reports. The company is owned by its employees.', facts: [['2019', 'founded in Paris'], ['23', 'publishers in Europe and Latin America'], ['100%', 'employee-owned']] },
  fr: { eyebrow: "L'équipe", title: 'Les personnes qui mettent en place et font tourner votre modération', text: "OpenModeration est construit par l'équipe de Logora : 8 personnes à Paris, Madrid et Berlin qui modèrent les commentaires de médias européens depuis 2019. Ce sont aussi elles qui traitent vos cas douteux et vos signalements. L'entreprise appartient à ses salariés.", facts: [['2019', 'création à Paris'], ['23', 'médias en Europe et en Amérique latine'], ['100 %', 'détenue par ses salariés']] },
  es: { eyebrow: 'El equipo', title: 'Las personas que ponen en marcha y gestionan tu moderación', text: 'OpenModeration lo construye el equipo de Logora: 8 personas en París, Madrid y Berlín que moderan los comentarios de medios europeos desde 2019. También son ellas quienes gestionan tus casos dudosos y las denuncias. La empresa pertenece a sus empleados.', facts: [['2019', 'fundada en París'], ['23', 'medios en Europa y América Latina'], ['100 %', 'propiedad de sus empleados']] },
  de: { eyebrow: 'Das Team', title: 'Die Menschen, die Ihre Moderation einrichten und betreiben', text: 'OpenModeration wird vom Team von Logora entwickelt: 8 Personen in Paris, Madrid und Berlin, die seit 2019 Leserkommentare für europäische Medien moderieren. Sie bearbeiten auch Ihre Zweifelsfälle und Meldungen. Das Unternehmen gehört seinen Mitarbeitenden.', facts: [['2019', 'in Paris gegründet'], ['23', 'Medien in Europa und Lateinamerika'], ['100 %', 'im Besitz der Mitarbeitenden']] },
  it: { eyebrow: 'Il team', title: 'Le persone che avviano e gestiscono la tua moderazione', text: 'OpenModeration è sviluppato dal team di Logora: 8 persone tra Parigi, Madrid e Berlino che moderano i commenti dei media europei dal 2019. Sono loro a gestire anche i tuoi casi dubbi e le segnalazioni. L’azienda appartiene ai suoi dipendenti.', facts: [['2019', 'fondata a Parigi'], ['23', 'media in Europa e America Latina'], ['100%', 'di proprietà dei dipendenti']] },
  pt: { eyebrow: 'A equipe', title: 'As pessoas que implantam e cuidam da sua moderação', text: 'A OpenModeration é desenvolvida pela equipe da Logora: 8 pessoas em Paris, Madri e Berlim que moderam comentários de leitores para veículos europeus desde 2019. São elas também que cuidam dos seus casos duvidosos e das denúncias. A empresa pertence aos seus funcionários.', facts: [['2019', 'fundada em Paris'], ['23', 'veículos na Europa e na América Latina'], ['100%', 'controlada pelos funcionários']] },
  pl: { eyebrow: 'Zespół', title: 'Ludzie, którzy wdrażają i prowadzą moderację', text: 'OpenModeration tworzy zespół Logora: 8 osób w Paryżu, Madrycie i Berlinie, które od 2019 roku moderują komentarze czytelników dla europejskich wydawców. To oni zajmują się też przypadkami wątpliwymi i zgłoszeniami. Firma należy do swoich pracowników.', facts: [['2019', 'założona w Paryżu'], ['23', 'wydawców w Europie i Ameryce Łacińskiej'], ['100%', 'własność pracowników']] },
  nl: { eyebrow: 'Het team', title: 'De mensen die je moderatie inrichten en draaien', text: 'OpenModeration wordt gebouwd door het team van Logora: 8 mensen in Parijs, Madrid en Berlijn die sinds 2019 lezersreacties modereren voor Europese media. Zij behandelen ook je twijfelgevallen en meldingen. Het bedrijf is in handen van de medewerkers.', facts: [['2019', 'opgericht in Parijs'], ['23', 'media in Europa en Latijns-Amerika'], ['100%', 'eigendom van de medewerkers']] },
};
const copy = copyAll[locale as keyof typeof copyAll] ?? copyAll.en;
---

<section class="bg-white py-14 sm:py-20">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <p class="om-eyebrow mb-4">{copy.eyebrow}</p>
    <h2 class="text-3xl font-extrabold tracking-tight text-surface-900 sm:text-4xl">{copy.title}</h2>
    <p class="mt-4 text-base leading-relaxed text-surface-600 sm:text-lg">{copy.text}</p>
    <dl class="mt-6 grid grid-cols-3 gap-3 sm:mt-8 sm:gap-4">
      {copy.facts.map(([value, label]) => (
        <div class="flex flex-col-reverse rounded-2xl bg-surface-50 p-3 ring-1 ring-surface-100 sm:p-4">
          <dt class="mt-1 text-xs text-surface-600">{label}</dt>
          <dd class="font-display text-2xl font-extrabold text-surface-900">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
