    eyebrow: '60 minuten · gratis · vrijblijvend',
    h1: 'Zie wat OpenModeration met jouw reacties zou doen',
    intro: "Neem een paar echte reacties mee van je website of je pagina's. We testen de moderatie er live op, zetten samen je regels en use cases op een rij, en je gaat weg met een helder implementatieplan.",
    agendaTitle: 'Wat er in het gesprek gebeurt',
    agenda: [
      { emoji: '🎯', title: 'Jouw situatie', text: 'Je platforms, je volumes, wat er nu misgaat en wat je absoluut niet wilt missen.' },
      { emoji: '🧪', title: 'Een live test op je reacties', text: 'We laten de moderatie los op echte voorbeelden die je meeneemt en bekijken elke beslissing met de schriftelijke toelichting.' },
      { emoji: '✍️', title: 'Je regels en use cases', text: 'Wat verborgen wordt, wat zichtbaar blijft, wat ons team bekijkt: we schetsen het samen met je.' },
      { emoji: '🚀', title: 'Implementatie en budget', text: 'Hoe wij het inrichten en voor je draaien, en een schatting voor jouw volumes.' },
    ],
    forTitle: 'Voor wie',
    forList: ['Nieuwssites en redacties', 'Merken, retailers en luxehuizen', 'Overheden en gemeenten', 'Platforms en community’s met reacties'],
    bring: 'Tip: neem 10 tot 20 reacties mee waar je team moeite mee had. Daar zegt de demo het meest.',
    trust: ['DSA-conform', 'Gehost in de EU', 'AVG', 'Een product van Logora'],
    calTitle: 'Kies een tijdstip',
    calFallback: 'Laadt de agenda niet? Open hem in een nieuw tabblad',
    faqTitle: 'Voordat je boekt',
    faq: [
      { question: 'Is het gesprek gratis?', answer: 'Ja. Het gesprek is gratis en vrijblijvend. Het is bedoeld om te zien of OpenModeration past bij je reacties en je regels.' },
      { question: 'Wat moet ik voorbereiden?', answer: 'Niets is verplicht. Neem als het kan een paar lastige echte reacties mee en vertel ons welke platforms je modereert: je website, Facebook, Instagram, YouTube of WordPress.' },
      { question: 'Met wie spreek ik?', answer: 'Met iemand van het OpenModeration-team bij Logora, die de moderatie samen met klanten inricht en vragen over product, compliance en budget kan beantwoorden.' },
      { question: 'Kunnen we eerst testen?', answer: 'Ja. In sandboxmodus analyseert OpenModeration je echte reacties en laat het zien wat het zou hebben besloten, zonder iets te verbergen of te verwijderen.' },
      { question: 'Regelen jullie ook het DSA-deel?', answer: 'Elke beslissing krijgt een schriftelijke toelichting en wordt vastgelegd, meldingen van gebruikers en bezwaren handelt ons team af en de cijfers voor je transparantieverslag zijn exporteerbaar. We lopen je verplichtingen tijdens het gesprek samen door.' },
    ],
  },
};
const copy = copyAll[locale as keyof typeof copyAll] ?? copyAll.en;

const embed = `${BOOKING_URL}?embed_domain=www.openmoderation.com&embed_type=Inline&hide_gdpr_banner=1&primary_color=7c3aed`;
const tones = ['bg-violet-500', 'bg-rose-500', 'bg-sun-400', 'bg-mint-500'];
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.h1,
  description: copy.description,
  inLanguage: locale,
  potentialAction: { '@type': 'ScheduleAction', target: BOOKING_URL, name: copy.crumb },
  about: { '@id': 'https://www.openmoderation.com/#organization' },
};
---

<BaseLayout title={copy.title} description={copy.description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: copy.home, href: localizePath('/', locale) }, { label: copy.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white pb-16 pt-12">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1.05fr] lg:px-8">
      <div>
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-semibold text-violet-700 shadow-sm">📅 {copy.eyebrow}</p>
        <h1 class="text-4xl font-extrabold leading-[1.08] tracking-tight text-surface-900 sm:text-5xl">{copy.h1}</h1>
        <p class="mt-5 text-lg leading-relaxed text-surface-600">{copy.intro}</p>
        <div class="mt-7 flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-violet-100">
          {copy.contact.photo ? (
            <img src={copy.contact.photo} alt={copy.contact.name} width="64" height="64" class="h-16 w-16 rounded-full object-cover ring-4 ring-violet-100" />
          ) : (
            <span class="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-violet-400 to-rose-400 font-display text-xl font-bold text-white ring-4 ring-violet-100" aria-hidden="true">{copy.contact.name.split(' ').map((w) => w[0]).join('')}</span>
          )}
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">{copy.contact.label}</p>
            <p class="font-display text-lg font-bold text-surface-900">{copy.contact.name}</p>
            <p class="text-sm text-surface-600">{copy.contact.role}{copy.contact.note && <span class="font-semibold text-mint-600"> · {copy.contact.note}</span>}</p>
          </div>
        </div>

        <h2 class="mt-10 text-xl font-bold text-surface-900">{copy.agendaTitle}</h2>
        <ol class="mt-5 space-y-4">
          {copy.agenda.map((step, i) => (
            <li class="flex gap-4">
              <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl text-xl shadow-md ${tones[i]}`} aria-hidden="true">{step.emoji}</span>
              <div>
                <p class="font-semibold text-surface-900">{step.title}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-surface-600">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="mt-8 rounded-2xl border border-sun-300 bg-sun-50 p-4 text-sm font-medium text-surface-800">💡 {copy.bring}</div>

        <h2 class="mt-10 text-xl font-bold text-surface-900">{copy.forTitle}</h2>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {copy.forList.map((item) => (
            <li class="flex items-start gap-2 text-sm text-surface-700"><span class="mt-0.5 text-mint-500">✓</span>{item}</li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-2">
          {copy.trust.map((item) => (
            <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-surface-700 shadow-sm ring-1 ring-surface-200">{item}</span>
          ))}
        </div>
      </div>

      <div class="lg:sticky lg:top-24 lg:self-start">
        <div class="overflow-hidden rounded-3xl bg-white shadow-[0_30px_60px_-24px_rgba(76,29,149,0.35)] ring-1 ring-violet-100">
          <div class="bg-gradient-to-r from-brand-600 via-violet-600 to-rose-500 px-6 py-4 text-white">
            <p class="font-display text-lg font-bold">{copy.calTitle}</p>
          </div>
          <iframe src={embed} title={copy.calTitle} loading="lazy" class="block h-[720px] w-full border-0"></iframe>
        </div>
        <p class="mt-3 text-center text-sm"><a href={BOOKING_URL} target="_blank" rel="noopener" data-no-popup class="font-semibold text-violet-700 underline underline-offset-2">{copy.calFallback} &rarr;</a></p>
      </div>
    </div>
  </section>

  <section class="bg-white py-14">
    <ClientLogos />
  </section>

  <TeamSection />

  <section class="bg-gradient-to-br from-violet-50 via-white to-sun-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title={copy.faqTitle} items={copy.faq} />
    </div>
  </section>
</BaseLayout>
