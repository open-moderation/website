---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import CharterSupport from './CharterSupport.astro';
import ClientLogos from './ClientLogos.astro';
import AppVideo from './AppVideo.astro';
import AIEngine from './AIEngine.astro';
import SwitchProvider from './SwitchProvider.astro';
import CostCalculator from './CostCalculator.astro';
import CTASection from './CTASection.astro';
import FAQ from './FAQ.astro';
import { getLocale, localizePath } from '../i18n/routes';
import { bookingUrl, useTranslations } from '../i18n/ui';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
export interface Props {
  title: string;
  description: string;
  crumb: string;
  parent?: { label: string; href: string } | null;
  eyebrow?: string;
  h1: string;
  intro: string;
  problem: string;
  approach: string;
  result: string;
  featuresTitle: string;
  featuresIntro: string;
  features: Array<{ title: string; text: string }>;
  why: Array<{ title: string; text: string }>;
  faq: Array<{ question: string; answer: string }>;
  related: Array<{ eyebrow: string; title: string; text: string; href: string }>;
  ctaTitle: string;
  ctaSubtitle: string;
}

const p = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const labelsAll = {
  en: { dsaTitle: 'DSA-compliant from day one', dsaText: 'The Digital Services Act applies to every site that hosts comments. OpenModeration covers the moderation side for you.', dsaPoints: ['Art. 16: user reports logged and handled by our team', 'Art. 17: a written statement of reasons for every decision', 'Art. 15: exportable figures for your transparency report', 'Art. 20: human review of contested cases by our team'], dsaLink: 'See how we cover the DSA', home: 'Home', useCases: 'Use cases', problem: 'The problem', approach: 'How OpenModeration handles it', result: 'The result', why: 'Why teams choose OpenModeration', faq: 'Frequently asked questions', related: 'Related resources', demo: 'Test a comment now' },
  fr: { dsaTitle: 'Conforme au DSA dès le premier jour', dsaText: "Le règlement sur les services numériques (DSA) s'applique à tout site qui héberge des commentaires. OpenModeration prend en charge la partie modération.", dsaPoints: ['Art. 16 : signalements des utilisateurs consignés et traités par notre équipe', 'Art. 17 : un exposé des motifs écrit pour chaque décision', 'Art. 15 : des chiffres exportables pour votre rapport de transparence', 'Art. 20 : revue humaine des décisions contestées, par notre équipe'], dsaLink: 'Voir comment nous couvrons le DSA', home: 'Accueil', useCases: "Cas d'usage", problem: 'Le problème', approach: "L'approche d'OpenModeration", result: 'Le résultat', why: 'Pourquoi ils choisissent OpenModeration', faq: 'Questions fréquentes', related: 'Ressources associées', demo: 'Tester un commentaire' },
  es: { dsaTitle: 'Conforme a la DSA desde el primer día', dsaText: 'La Ley de Servicios Digitales (DSA) se aplica a todo sitio que aloja comentarios. OpenModeration se encarga de la parte de moderación.', dsaPoints: ['Art. 16: denuncias de usuarios registradas y tramitadas por nuestro equipo', 'Art. 17: una exposición de motivos por escrito para cada decisión', 'Art. 15: cifras exportables para tu informe de transparencia', 'Art. 20: revisión humana de las decisiones impugnadas, a cargo de nuestro equipo'], dsaLink: 'Ver cómo cubrimos la DSA', home: 'Inicio', useCases: 'Casos de uso', problem: 'El problema', approach: 'El enfoque de OpenModeration', result: 'El resultado', why: 'Por qué eligen OpenModeration', faq: 'Preguntas frecuentes', related: 'Recursos relacionados', demo: 'Probar un comentario' },
  de: { dsaTitle: 'DSA-konform ab dem ersten Tag', dsaText: 'Der Digital Services Act (DSA) gilt für jede Website, die Kommentare hostet. OpenModeration übernimmt den Moderationsteil für Sie.', dsaPoints: ['Art. 16: Nutzermeldungen protokolliert und von unserem Team bearbeitet', 'Art. 17: eine schriftliche Begründung für jede Entscheidung', 'Art. 15: exportierbare Zahlen für Ihren Transparenzbericht', 'Art. 20: menschliche Prüfung angefochtener Entscheidungen durch unser Team'], dsaLink: 'So decken wir den DSA ab', home: 'Startseite', useCases: 'Anwendungsfälle', problem: 'Das Problem', approach: 'Der Ansatz von OpenModeration', result: 'Das Ergebnis', why: 'Warum sie OpenModeration wählen', faq: 'Häufige Fragen', related: 'Weitere Ressourcen', demo: 'Kommentar testen' },
  it: { dsaTitle: 'Conforme al DSA fin dal primo giorno', dsaText: 'Il Digital Services Act (DSA) si applica a ogni sito che ospita commenti. OpenModeration si occupa della parte di moderazione.', dsaPoints: ['Art. 16: segnalazioni degli utenti registrate e gestite dal nostro team', 'Art. 17: una motivazione scritta per ogni decisione', 'Art. 15: dati esportabili per il tuo report di trasparenza', 'Art. 20: revisione umana delle decisioni contestate da parte del nostro team'], dsaLink: 'Scopri come copriamo il DSA', home: 'Home', useCases: "Casi d'uso", problem: 'Il problema', approach: "L'approccio di OpenModeration", result: 'Il risultato', why: 'Perché scelgono OpenModeration', faq: 'Domande frequenti', related: 'Risorse correlate', demo: 'Prova un commento' },
  pt: { dsaTitle: 'Em conformidade com o DSA desde o primeiro dia', dsaText: 'O Digital Services Act (DSA) se aplica a todo site que hospeda comentários. A OpenModeration cuida da parte de moderação para você.', dsaPoints: ['Art. 16: denúncias de usuários registradas e tratadas pela nossa equipe', 'Art. 17: uma justificativa por escrito para cada decisão', 'Art. 15: números exportáveis para o seu relatório de transparência', 'Art. 20: revisão humana das decisões contestadas pela nossa equipe'], dsaLink: 'Veja como cobrimos o DSA', home: 'Início', useCases: 'Casos de uso', problem: 'O problema', approach: 'Como a OpenModeration resolve', result: 'O resultado', why: 'Por que as equipes escolhem a OpenModeration', faq: 'Perguntas frequentes', related: 'Conteúdos relacionados', demo: 'Testar um comentário agora' },
  pl: { dsaTitle: 'Zgodność z DSA od pierwszego dnia', dsaText: 'Akt o usługach cyfrowych (DSA) obejmuje każdą stronę, na której publikowane są komentarze. OpenModeration przejmuje część związaną z moderacją.', dsaPoints: ['Art. 16: zgłoszenia użytkowników rejestrowane i rozpatrywane przez nasz zespół', 'Art. 17: pisemne uzasadnienie każdej decyzji', 'Art. 15: dane do raportu przejrzystości gotowe do eksportu', 'Art. 20: weryfikacja spornych przypadków przez nasz zespół'], dsaLink: 'Zobacz, jak spełniamy wymogi DSA', home: 'Strona główna', useCases: 'Zastosowania', problem: 'Problem', approach: 'Jak rozwiązuje to OpenModeration', result: 'Efekt', why: 'Dlaczego zespoły wybierają OpenModeration', faq: 'Najczęstsze pytania', related: 'Powiązane materiały', demo: 'Przetestuj komentarz' },
  nl: { dsaTitle: 'DSA-conform vanaf dag één', dsaText: 'De Digital Services Act (DSA) geldt voor elke site waar reacties op staan. OpenModeration neemt het moderatiedeel voor je uit handen.', dsaPoints: ['Art. 16: meldingen van gebruikers vastgelegd en door ons team afgehandeld', 'Art. 17: een schriftelijke motivering bij elke beslissing', 'Art. 15: exporteerbare cijfers voor je transparantieverslag', 'Art. 20: menselijke beoordeling van betwiste beslissingen door ons team'], dsaLink: 'Zo dekken we de DSA af', home: 'Home', useCases: 'Toepassingen', problem: 'Het probleem', approach: 'Hoe OpenModeration het aanpakt', result: 'Het resultaat', why: 'Waarom teams kiezen voor OpenModeration', faq: 'Veelgestelde vragen', related: 'Gerelateerde artikelen', demo: 'Test nu een reactie' },
};
const labels = labelsAll[locale as keyof typeof labelsAll] ?? labelsAll.en;

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: p.h1,
  description: p.description,
  inLanguage: locale,
  about: { '@id': 'https://www.openmoderation.com/#software' },
};
const here = Astro.url.pathname.replace(/\/$/, '');
const showCalculator = ['/outsourced-moderation', '/automatic-comment-moderation', '/moderation-software'].some((r) => localizePath(r, locale) === here);
const parent = p.parent === undefined ? { label: labels.useCases, href: localizePath('/use-cases', locale) } : p.parent;
---

<BaseLayout title={p.title} description={p.description} jsonLd={pageJsonLd}>
  <Breadcrumb items={[{ label: labels.home, href: localizePath('/', locale) }, ...(parent ? [parent] : []), { label: p.crumb }]} />
  <section class="bg-gradient-to-b from-brand-50 to-white py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-violet-700 shadow-sm">
        {p.eyebrow ?? labels.useCases}
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight text-surface-900 sm:text-5xl">{p.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-surface-500">{p.intro}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">{t('cta.book')}</a>
        <a href={localizePath('/demo', locale)} class="inline-flex items-center gap-2 rounded-lg border border-surface-300 bg-white px-6 py-3 text-sm font-semibold text-surface-700 transition hover:bg-surface-50">{labels.demo}</a>
      </div>
      <div class="mt-10">
        <ClientLogos />
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 grid gap-8 md:grid-cols-3">
        <div class="lift rounded-2xl border border-rose-100 bg-rose-50 p-7">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-rose-500 text-xl shadow-md" aria-hidden="true">😤</div>
          <h2 class="text-lg font-bold text-surface-900">{labels.problem}</h2>
          <p class="mt-2 text-sm text-surface-700">{p.problem}</p>
        </div>
        <div class="lift rounded-2xl bg-gradient-to-br from-brand-600 to-violet-600 p-7 text-white shadow-lg">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white/20 text-xl" aria-hidden="true">✨</div>
          <h2 class="text-lg font-bold text-white">{labels.approach}</h2>
          <p class="mt-2 text-sm text-white/90">{p.approach}</p>
        </div>
        <div class="lift rounded-2xl border border-mint-100 bg-mint-50 p-7">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-mint-500 text-xl shadow-md" aria-hidden="true">🎉</div>
          <h2 class="text-lg font-bold text-surface-900">{labels.result}</h2>
          <p class="mt-2 text-sm text-surface-700">{p.result}</p>
        </div>
      </div>

      <div class="mx-auto max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{p.featuresTitle}</h2>
        <p class="mt-4 text-lg text-surface-500">{p.featuresIntro}</p>
        <div class="mt-8 space-y-3">
          {p.features.map((f) => (
            <div class="flex items-start gap-4 rounded-xl border border-surface-100 bg-white p-5 shadow-sm">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 to-violet-500 text-white"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span>
              <div><p class="text-sm font-semibold text-surface-900">{f.title}</p>
              <p class="mt-1 text-sm text-surface-600">{f.text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <AppVideo />

  <AIEngine />

  <SwitchProvider />

  <section class="bg-gradient-to-br from-violet-50 via-white to-sun-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{labels.why}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {p.why.map((w, i) => (
          <div class={`lift rounded-2xl border-t-4 bg-white p-7 shadow-sm ${['border-violet-400', 'border-rose-400', 'border-sun-400'][i % 3]}`}>
            <h3 class="font-semibold text-surface-900">{w.title}</h3>
            <p class="mt-2 text-sm text-surface-600">{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink-900 py-16">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-white">{labels.dsaTitle}</h2>
        <p class="mt-4 text-surface-300">{labels.dsaText}</p>
        <a href={localizePath('/dsa-compliance', locale)} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white underline underline-offset-4 hover:text-surface-200">{labels.dsaLink} &rarr;</a>
      </div>
      <ul class="space-y-3">
        {labels.dsaPoints.map((point) => (
          <li class="flex items-start gap-3 rounded-lg border border-ink-700 bg-ink-800 p-4 text-sm text-surface-200">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-turquoise" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            {point}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {showCalculator && <CostCalculator />}

  <CharterSupport />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <FAQ title={labels.faq} items={p.faq} />
    </div>
  </section>

  <section class="bg-surface-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-surface-900 sm:text-3xl">{labels.related}</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {p.related.map((r) => (
          <a href={r.href} class="group rounded-xl border border-surface-200 bg-white p-6 transition hover:shadow-md">
            <div class="mb-2 text-xs font-medium text-brand-600">{r.eyebrow}</div>
            <h3 class="text-lg font-semibold text-surface-900 group-hover:text-brand-600">{r.title}</h3>
            <p class="mt-2 text-sm text-surface-500">{r.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection title={p.ctaTitle} subtitle={p.ctaSubtitle} />
</BaseLayout>
