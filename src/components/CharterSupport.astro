---
import { getLocale } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(getLocale(Astro.url.pathname));

const tones = [
  { card: 'bg-violet-50 border-violet-100', tile: 'bg-violet-500 text-white' },
  { card: 'bg-sun-50 border-sun-100', tile: 'bg-sun-400 text-surface-900' },
  { card: 'bg-mint-50 border-mint-100', tile: 'bg-mint-500 text-white' },
];

const items = [
  { title: t('charter.c1Title'), text: t('charter.c1Text'), iconPath: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { title: t('charter.c2Title'), text: t('charter.c2Text'), iconPath: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
  { title: t('charter.c3Title'), text: t('charter.c3Text'), iconPath: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];
---

<section class="bg-white py-14 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-8 max-w-3xl text-center sm:mb-12">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-violet-500 to-rose-500 px-3 py-1 text-xs font-semibold text-white shadow-sm">
        {t('charter.eyebrow')}
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{t('charter.title')}</h2>
      <p class="mt-4 text-lg text-surface-500">{t('charter.subtitle')}</p>
    </div>
    <div class="om-carousel grid gap-6 md:grid-cols-3">
      {items.map((item, i) => (
        <div class={`lift om-card ${tones[i % tones.length].card}`}>
          <div class={`mb-5 flex h-12 w-12 items-center justify-center rounded-2xl shadow-md ${tones[i % tones.length].tile}`}>
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.iconPath} /></svg>
          </div>
          <h3 class="text-lg font-semibold text-surface-900">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-surface-700">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
