---
import { getLocale } from '../i18n/routes';
import { bookingUrl, useTranslations } from '../i18n/ui';

const BOOKING_URL = bookingUrl(getLocale(Astro.url.pathname));
const t = useTranslations(getLocale(Astro.url.pathname));

export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  dark?: boolean;
}

const {
  title = t('cta.title'),
  subtitle = t('cta.subtitle'),
  buttonText = t('cta.button'),
  buttonHref = 'https://app.openmoderation.com/signup',
  dark = true,
} = Astro.props;
---

<section data-cta-section class="relative overflow-hidden bg-surface-900">
  <div class="relative mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 sm:py-24 lg:px-8">
    <h2 class="text-3xl font-extrabold tracking-tight text-white [text-wrap:balance] sm:text-5xl">{title}</h2>
    <p class={`mx-auto mt-4 max-w-xl text-base text-white/85 sm:text-lg`}>{subtitle}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="lift inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-lg transition hover:bg-surface-50">
        {t('cta.book')}
      </a>
      <a href={buttonHref} class="inline-flex items-center gap-2 rounded-lg border border-white/50 bg-white/10 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
        <span>{buttonText}</span>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
    <p class={`mt-4 text-sm text-white/85`}>
      {t('cta.noCard')} · {t('footer.dsa')} · {t('footer.gdpr')}
    </p>
    <p class={`mt-2 text-sm text-white/75`}>
      {t('cta.questions')} <a href="mailto:contact@openmoderation.com" class={`underline transition hover:text-white`}>contact@openmoderation.com</a>
    </p>
  </div>
</section>