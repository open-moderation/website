---
import { getLocale } from '../i18n/routes';
import { BOOKING_URL, useTranslations } from '../i18n/ui';

const t = useTranslations(getLocale(Astro.url.pathname));

export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  dark?: boolean;
}

const {
  title = t('cta.title'),
  subtitle = t('cta.subtitle'),
  buttonText = t('cta.button'),
  buttonHref = 'https://app.openmoderation.com/signup',
  dark = true,
} = Astro.props;
---

<section class={`relative overflow-hidden ${dark ? 'bg-brand-900' : 'bg-brand-600'}`}>
  <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
    <p class={`mx-auto mt-4 max-w-2xl text-lg ${dark ? 'text-surface-300' : 'text-brand-100'}`}>{subtitle}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href={buttonHref} class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-semibold text-surface-900 shadow-sm transition hover:bg-surface-100">
        <span>{buttonText}</span>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
        {t('cta.book')}
      </a>
    </div>
    <p class={`mt-4 text-sm ${dark ? 'text-surface-300' : 'text-brand-100'}`}>
      {t('cta.noCard')}
    </p>
    <p class={`mt-2 text-sm ${dark ? 'text-surface-400' : 'text-brand-100'}`}>
      {t('cta.questions')} <a href="mailto:contact@openmoderation.com" class={`underline transition ${dark ? 'hover:text-surface-200' : 'hover:text-white'}`}>contact@openmoderation.com</a>
    </p>
  </div>
</section>