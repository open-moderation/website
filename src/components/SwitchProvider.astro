---
import { getLocale } from '../i18n/routes';
import { bookingUrl } from '../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const BOOKING_URL = bookingUrl(locale);

const copyAll = {
  en: {
    eyebrow: 'Already under contract?',
    title: 'Switch moderation provider without risk',
    text: 'You don’t have to cut anything off to find out. Test us on your own comments, then decide with figures in hand.',
    steps: [
      { title: 'A silent test on your real comments', text: 'We moderate your real comments in a sandbox, alongside your current provider. Nothing changes in production.' },
      { title: 'Compare decision by decision', text: 'For each comment, you see what we would have accepted or refused, with the written reason, next to what your provider did.' },
      { title: 'Switch when it suits you', text: 'You reach your renewal with figures. Connectors are ready and our team sets everything up when you decide to switch.' },
    ],
    cta: 'Run the test on my comments',
  },
  fr: {
    eyebrow: 'Déjà engagé avec un prestataire ?',
    title: 'Changer de prestataire sans risque',
    text: 'Pas besoin de tout couper pour savoir. Testez-nous sur vos propres commentaires, puis décidez chiffres en main.',
    steps: [
      { title: 'Un test silencieux sur vos vrais commentaires', text: 'Nous modérons vos vrais commentaires en bac à sable, en parallèle de votre prestataire actuel. Rien ne change en production.' },
      { title: 'Comparez décision par décision', text: 'Pour chaque commentaire, vous voyez ce que nous aurions accepté ou refusé, avec la raison écrite, à côté de ce qu’a fait votre prestataire.' },
      { title: 'Basculez quand cela vous convient', text: 'Vous arrivez au renouvellement avec des chiffres. Les connecteurs sont prêts et notre équipe met tout en place le jour où vous changez.' },
    ],
    cta: 'Lancer le test sur mes commentaires',
  },
  es: {
    eyebrow: '¿Ya tienes contrato con un proveedor?',
    title: 'Cambia de proveedor de moderación sin riesgo',
    text: 'No hace falta cortar nada para saberlo. Pruébanos con tus propios comentarios y decide con datos en la mano.',
    steps: [
      { title: 'Una prueba silenciosa con tus comentarios reales', text: 'Moderamos tus comentarios reales en un entorno de pruebas, en paralelo a tu proveedor actual. No cambia nada en producción.' },
      { title: 'Compara decisión por decisión', text: 'Para cada comentario ves qué habríamos aceptado o rechazado, con el motivo por escrito, junto a lo que hizo tu proveedor.' },
      { title: 'Cambia cuando te venga bien', text: 'Llegas a la renovación con cifras. Los conectores están listos y nuestro equipo lo configura todo cuando decides cambiar.' },
    ],
    cta: 'Lanzar la prueba con mis comentarios',
  },
  de: {
    eyebrow: 'Noch an einen Dienstleister gebunden?',
    title: 'Den Moderationsdienstleister ohne Risiko wechseln',
    text: 'Sie müssen nichts abschalten, um es herauszufinden. Testen Sie uns mit Ihren eigenen Kommentaren und entscheiden Sie anhand von Zahlen.',
    steps: [
      { title: 'Ein stiller Test mit Ihren echten Kommentaren', text: 'Wir moderieren Ihre echten Kommentare in einer Sandbox, parallel zu Ihrem aktuellen Dienstleister. In der Produktion ändert sich nichts.' },
      { title: 'Vergleichen Sie Entscheidung für Entscheidung', text: 'Zu jedem Kommentar sehen Sie, was wir freigegeben oder abgelehnt hätten, mit schriftlicher Begründung, neben der Entscheidung Ihres Dienstleisters.' },
      { title: 'Wechseln Sie, wann es Ihnen passt', text: 'Sie gehen mit Zahlen in die Vertragsverlängerung. Die Konnektoren sind bereit, und unser Team richtet alles ein, sobald Sie wechseln.' },
    ],
    cta: 'Test mit meinen Kommentaren starten',
  },
  it: {
    eyebrow: 'Hai già un contratto con un fornitore?',
    title: 'Cambia fornitore di moderazione senza rischi',
    text: 'Non devi spegnere niente per scoprirlo. Mettici alla prova sui tuoi commenti e decidi con i numeri alla mano.',
    steps: [
      { title: 'Un test silenzioso sui tuoi commenti reali', text: 'Moderiamo i tuoi commenti reali in un ambiente di prova, in parallelo al tuo fornitore attuale. In produzione non cambia nulla.' },
      { title: 'Confronta decisione per decisione', text: 'Per ogni commento vedi cosa avremmo accettato o rifiutato, con la motivazione scritta, accanto a quello che ha fatto il tuo fornitore.' },
      { title: 'Passa a noi quando ti conviene', text: 'Arrivi al rinnovo con i numeri. I connettori sono pronti e il nostro team configura tutto quando decidi di cambiare.' },
    ],
    cta: 'Avvia il test sui miei commenti',
  },
  pt: {
    eyebrow: 'Já tem contrato com um fornecedor?',
    title: 'Troque de fornecedor de moderação sem risco',
    text: 'Você não precisa desligar nada para descobrir. Teste a gente com seus próprios comentários e decida com números na mão.',
    steps: [
      { title: 'Um teste silencioso com seus comentários reais', text: 'Moderamos seus comentários reais em um ambiente de teste, em paralelo ao seu fornecedor atual. Nada muda em produção.' },
      { title: 'Compare decisão por decisão', text: 'Para cada comentário, você vê o que teríamos aceitado ou recusado, com o motivo por escrito, ao lado do que seu fornecedor fez.' },
      { title: 'Troque quando for melhor para você', text: 'Você chega à renovação com números. Os conectores estão prontos e nossa equipe configura tudo quando você decidir trocar.' },
    ],
    cta: 'Iniciar o teste com meus comentários',
  },
  pl: {
    eyebrow: 'Macie już umowę z dostawcą?',
    title: 'Zmiana dostawcy moderacji bez ryzyka',
    text: 'Nie trzeba niczego wyłączać, żeby się przekonać. Przetestuj nas na własnych komentarzach i zdecyduj na podstawie liczb.',
    steps: [
      { title: 'Cichy test na prawdziwych komentarzach', text: 'Moderujemy Twoje prawdziwe komentarze w środowisku testowym, równolegle z obecnym dostawcą. Na produkcji nic się nie zmienia.' },
      { title: 'Porównanie decyzja po decyzji', text: 'Przy każdym komentarzu widzisz, co byśmy zaakceptowali lub odrzucili, wraz z pisemnym uzasadnieniem, obok decyzji obecnego dostawcy.' },
      { title: 'Zmiana w dogodnym momencie', text: 'Do odnowienia umowy podchodzisz z konkretnymi liczbami. Konektory są gotowe, a nasz zespół wszystko konfiguruje, gdy zdecydujesz się na zmianę.' },
    ],
    cta: 'Uruchom test na moich komentarzach',
  },
  nl: {
    eyebrow: 'Zit je nog vast aan een leverancier?',
    title: 'Zonder risico van moderatieleverancier wisselen',
    text: 'Je hoeft niets uit te zetten om het te weten. Test ons op je eigen reacties en beslis met cijfers in de hand.',
    steps: [
      { title: 'Een stille test op je echte reacties', text: 'We modereren je echte reacties in een sandbox, naast je huidige leverancier. In productie verandert er niets.' },
      { title: 'Vergelijk beslissing voor beslissing', text: 'Bij elke reactie zie je wat wij hadden goedgekeurd of geweigerd, met de schriftelijke reden, naast wat je leverancier deed.' },
      { title: 'Stap over wanneer het jou uitkomt', text: 'Je gaat met cijfers je verlenging in. De connectoren staan klaar en ons team regelt alles zodra je overstapt.' },
    ],
    cta: 'Start de test op mijn reacties',
  },
};
const copy = copyAll[locale as keyof typeof copyAll] ?? copyAll.en;

const styles = [
  { card: 'from-violet-50 to-white border-violet-100', tile: 'bg-violet-500' },
  { card: 'from-rose-50 to-white border-rose-100', tile: 'bg-rose-500' },
  { card: 'from-mint-50 to-white border-mint-100', tile: 'bg-mint-500' },
];
---

<section class="border-t border-surface-100 bg-gradient-to-br from-brand-50 via-white to-sun-50 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="mb-4 inline-flex rounded-full border border-violet-200 bg-white/80 px-3 py-1 text-xs font-semibold text-violet-700 shadow-sm">{copy.eyebrow}</p>
      <h2 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl">{copy.title}</h2>
      <p class="mt-4 text-lg text-surface-500">{copy.text}</p>
    </div>
    <ol class="grid gap-6 md:grid-cols-3">
      {copy.steps.map((step, i) => (
        <li class={`lift rounded-2xl border bg-gradient-to-b p-6 ${styles[i].card}`}>
          <span class={`mb-5 flex h-12 w-12 items-center justify-center rounded-2xl font-display text-xl font-bold text-white shadow-md ${styles[i].tile}`} aria-hidden="true">{i + 1}</span>
          <h3 class="text-lg font-bold text-surface-900">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-surface-600">{step.text}</p>
        </li>
      ))}
    </ol>
    <div class="mt-10 text-center">
      <a href={BOOKING_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800">{copy.cta}</a>
    </div>
  </div>
</section>
