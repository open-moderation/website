---
export interface Props {
  items: Array<{ title: string; text: string }>;
}

const { items } = Astro.props;

// Une seule pastille mutualisée (bleu). Icônes SVG sobres, pas d'emojis.
const icons = [
  'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
  'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  'M13 10V3L4 14h7v7l9-11h-7z',
  'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
];
---

<div class="om-carousel grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {items.map((item, i) => {
    return (
      <div class="lift om-card h-full bg-white">
        <div class="om-icon-tile mb-4" aria-hidden="true"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[i % icons.length]} /></svg></div>
        <h3 class="text-lg font-bold text-surface-900">{item.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-surface-600">{item.text}</p>
      </div>
    );
  })}
</div>
